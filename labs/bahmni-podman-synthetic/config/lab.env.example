# Bahmni Podman synthetic lab local overrides.
# Copy to a local-only file if needed, or export variables before running bin/bahmni-lab.
# Do not commit local credential files or generated runtime directories.

# Runtime clone/work directory. Default: /tmp/fm-bahmni-lab-r1 (created mode 0700).
BAHMNI_LAB_HOME=/tmp/fm-bahmni-lab-r1

# Task-owned rootless Podman machine/connection. The script will only create/start this
# task-prefixed machine when no usable task connection exists.
BAHMNI_LAB_MACHINE=fm-bahmni-lab-r1-machine
BAHMNI_LAB_CONNECTION=fm-bahmni-lab-r1-machine

# Unique compose project name. This prefixes task-owned networks/volumes/containers.
BAHMNI_LAB_PROJECT=fm_bahmni_lab_r1

# Loopback-only host ports. Avoid privileged ports and avoid public binds.
BAHMNI_LAB_HTTP_PORT=18080
BAHMNI_LAB_HTTPS_PORT=18443
BAHMNI_LAB_ODOO_PORT=18069
BAHMNI_LAB_DCM4CHEE_HTTP_PORT=18055
BAHMNI_LAB_DCM4CHEE_DICOM_PORT=11112

# Optional JVM tuning for local laptops. Leave blank to use upstream defaults.
BAHMNI_LAB_OPENMRS_JAVA_MEMORY_OPTS=-Xms512m -Xmx1536m

# Optional: set to 1 to include SNOMED/CDSS profiles. Defaults to Standard profile only.
BAHMNI_LAB_ENABLE_SNOMED=0
