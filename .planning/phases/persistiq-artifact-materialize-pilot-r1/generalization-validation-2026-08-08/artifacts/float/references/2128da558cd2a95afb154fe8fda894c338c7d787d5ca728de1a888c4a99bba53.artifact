definitions:
  Holiday:
    type: "object"
    required:
    - "date"
    - "name"
    properties:
      holiday_id:
        type: "integer"
        example: 1
        description: "The ID of this team holiday"
        readOnly: true
      name:
        type: "string"
        example: "Christmas Break"
        description: "The name of the team holiday"
        maxLength: 200
      date:
        type: "string"
        example: "2019-12-24 09:00"
        description: "Date of the team holiday"
      end_date:
        type: "string"
        example: "2020-01-01 17:00"
        description: "End date of the team holiday if more than 1 day"
    title: "Holiday"

holidays:
  get:
    tags:
    - "Team Holidays"
    summary: "List team holidays"
    operationId: "getHolidays"
    parameters:
    - $ref: "../swagger-api-v3.yaml#/parameters/page"
    - $ref: "../swagger-api-v3.yaml#/parameters/per-page"
    responses:
      200:
        description: "List of team holidays that are blocked out across the whole team in the schedule."
        schema:
          type: "array"
          title: "Array of holidays"
          items:
            $ref: "#/definitions/Holiday"
        headers:
          X-Pagination-Total-Count:
            type: "integer"
            description: "Total number of items"
          X-Pagination-Page-Count:
            type: "integer"
            description: "Total number of pages"
          X-Pagination-Current-Page:
            type: "integer"
            description: "Current page number"
          X-Pagination-Per-Page:
            type: "integer"
            description: "Number of items per page"
  post:
    tags:
    - "Team Holidays"
    summary: "Create a team holiday that"
    operationId: "addHoliday"
    parameters:
    - in: "body"
      name: "holiday"
      description: "The holiday to create, read-only fields are ignored"
      required: false
      schema:
        $ref: "#/definitions/Holiday"
    responses:
      201:
        description: "If the holiday was successfully created, the response returns\
          \ the full information about that holiday."
        schema:
          $ref: "#/definitions/Holiday"
      422:
        description: "Data validation failure.\n"

holidays-id:
  get:
    tags:
    - "Team Holidays"
    summary: "Retrieve a single team holiday"
    description: "Returns a single team holiday."
    operationId: "getHoliday"
    parameters:
    - name: "holiday_id"
      in: "path"
      description: "The holiday ID"
      required: true
      type: "integer"
    responses:
      200:
        description: "A holiday"
        schema:
          $ref: "#/definitions/Holiday"
  delete:
    tags:
    - "Team Holidays"
    summary: "Delete a team holiday"
    operationId: "deleteHoliday"
    parameters:
    - name: "holiday_id"
      in: "path"
      description: "holiday ID to delete"
      required: true
      type: "integer"
    responses:
      204:
        description: Delete successful.
      404:
        description: "The holiday does not exist."
  patch:
    tags:
    - "Team Holidays"
    summary: "Update a holiday's details, read-only fields are ignored"
    operationId: "updateHoliday"
    parameters:
    - name: "holiday_id"
      in: "path"
      description: "The holiday ID"
      required: true
      type: "integer"
    responses:
      200:
        description: "On a successful update of a team holiday, the response returns\
          \ the full information about that holiday."
        schema:
          $ref: "#/definitions/Holiday"
      422:
        description: "Data validation failure.\n"
