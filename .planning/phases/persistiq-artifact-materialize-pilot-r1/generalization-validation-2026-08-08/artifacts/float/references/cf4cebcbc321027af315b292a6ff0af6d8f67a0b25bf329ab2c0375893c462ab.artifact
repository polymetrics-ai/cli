definitions:
  Timeoff:
    type: "object"
    required:
    - "start_date"
    - "end_date"
    - "hours"
    - "timeoff_type_id"
    - "people_ids"
    properties:
      timeoff_id:
        type: "integer"
        example: 1
        description: "The ID of this time off"
        readOnly: true
      timeoff_type_id:
        type: "integer"
        example: 1345
        description: "The ID of this time off type"
      start_date:
        type: "string"
        example: "2019-11-16"
        description: "Start date of this time off"
      end_date:
        type: "string"
        example: "2019-12-06"
        description: "End date of this time off"
      start_time:
        type: "string"
        example: "14:00"
        description: "Start time of this time off in 24 hr format"
      hours:
        type: "number"
        example: 6.5
        description: "Number of hours per day for this time off. Not required when\
          \ a full day"
      timeoff_notes:
        type: "string"
        example: ""
        description: "Additional notes about the time off"
      repeat_state:
        type: "integer"
        example: 0
        description: "Frequency that this timeoff repeats. `0` = No repeat, `1` = Weekly,\
          \ `2` = Monthly, `3` = Every two weeks, `4` = Every three weeks, `5` = Every six weeks,\
          \ `6` = Every two months, `7` = Every three months, `8` = Every six months, `9` = Yearly"
      status:
        type: "integer"
        example: 2
        description: "Status of the time off. `1` = Tentative, `2` = Confirmed"
      repeat_end:
        type: "string"
        example: "2019-03-16"
        description: "Date that the repeating time off will cease"
      full_day:
        type: "integer"
        example: 1
        description: "Is this time off for a full day? `1` = Yes, `0` = No"
      people_ids:
        type: "array"
        example:
        - "23442"
        - "22321"
        description: "List of people IDs assigned to this time off"
        items:
          type: "integer"
      created:
        type: "string"
        example: "2019-02-05"
        description: "Date this record was created"
        readOnly: true
      modified:
        type: "string"
        example: "2019-02-15"
        description: "Date this record was modified"
        readOnly: true
      modified_by:
        type: "integer"
        example: 12345
        description: "Account ID of the person who last modified this record"
        readOnly: true
      created_by:
        type: "integer"
        example: 12345
        description: "Account ID of the person who created this record"
        readOnly: true
    title: "Timeoff"

timeoffs:
  get:
    tags:
    - "Time Off"
    summary: "List of time off scheduled."
    operationId: "getTimeoffs"
    parameters:
    - $ref: "../swagger-api-v3.yaml#/parameters/start_date"
    - $ref: "../swagger-api-v3.yaml#/parameters/end_date"
    - name: full_day
      in: "query"
      description: "Filter only on if timeoff is full day: `1` = Yes, `0` = No"
      required: false
      type: "integer"
    - name: status
      in: "query"
      description: "Filter on the Status of the time off: `1` = tentative, `2` = confirmed."
      required: false
      type: integer
    - name: timeoff_type_id
      in: "query"
      description: "Filter on the ID of the timeoff type"
      required: false
      type: integer
    - $ref: "../swagger-api-v3.yaml#/parameters/page"
    - $ref: "../swagger-api-v3.yaml#/parameters/per-page"
    - $ref: "../swagger-api-v3.yaml#/parameters/sort"
    - $ref: "../swagger-api-v3.yaml#/parameters/modified_since"
    - $ref: "../swagger-api-v3.yaml#/parameters/fields"
    responses:
      200:
        description: "List of time off"
        schema:
          type: "array"
          title: "Array of time off"
          items:
            $ref: "#/definitions/Timeoff"
        headers:
          X-Pagination-Total-Count:
            type: "integer"
            description: "Total number of items"
          X-Pagination-Page-Count:
            type: "integer"
            description: "Total number of pages"
          X-Pagination-Current-Page:
            type: "integer"
            description: "Current page number"
          X-Pagination-Per-Page:
            type: "integer"
            description: "Number of items per page"
  post:
    tags:
    - "Time Off"
    summary: "Add a new time off, read-only fields are ignored"
    operationId: "addTimeoff"
    parameters:
    - in: "body"
      name: "Timeoff"
      description: "The time off to create"
      required: false
      schema:
        $ref: "#/definitions/Timeoff"
    responses:
      201:
        description: "If the time off was successfully created, the response returns\
          \ the full information about that time off."
        schema:
          $ref: "#/definitions/Timeoff"
      422:
        description: "Data validation failure if fields are missing or the time\
          \ off already exists.\n"

timeoffs-id:
  get:
    tags:
    - "Time Off"
    summary: "Retrieve a single time off"
    description: "Returns a single time off."
    operationId: "getTimeoff"
    parameters:
    - name: "timeoff_id"
      in: "path"
      description: "The time off's ID"
      required: true
      type: "integer"
    responses:
      200:
        description: "A time off"
        schema:
          $ref: "#/definitions/Timeoff"
  delete:
    tags:
    - "Time Off"
    summary: "Delete a time off record"
    operationId: "deleteTimeoff"
    parameters:
    - name: "timeoff_id"
      in: "path"
      description: "time off id to delete"
      required: true
      type: "integer"
    responses:
      204:
        description: Delete successful.
      404:
        description: "The time off record does not exist."
  patch:
    tags:
    - "Time Off"
    summary: "Update a time off's details, read-only fields are ignored"
    operationId: "updateTimeoff"
    parameters:
    - name: "timeoff_id"
      in: "path"
      description: "The time off's ID"
      required: true
      type: "integer"
    responses:
      200:
        description: "On a successful update of a time off, the response returns\
          \ the full information about that time off."
        schema:
          $ref: "#/definitions/Timeoff"
      422:
        description: "Data validation failure.\n"
