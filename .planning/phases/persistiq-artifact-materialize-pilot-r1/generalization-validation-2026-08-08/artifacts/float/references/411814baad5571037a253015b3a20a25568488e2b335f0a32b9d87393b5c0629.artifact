definitions:
  Task:
    type: "object"
    required:
    - "end_date"
    - "hours"
    - "project_id"
    - "start_date"
    properties:
      task_id:
        type: "integer"
        example: 7654321
        description: "The ID of this allocation as a task"
        readOnly: true
      root_task_id:
        type: "integer"
        example: 1234567
        description: "The ID of the earliest linked allocation in a chain"
      parent_task_id:
        type: "integer"
        example: 7654321
        description: "The ID of the direct parent of a linked allocation"
      project_id:
        type: "integer"
        example: 1345
        description: "The ID of the project for this allocation"
      phase_id:
        type: "integer"
        example: 153
        description: "The ID of the project phase for this allocation"
      start_date:
        type: "string"
        example: "2023-11-16"
        description: "Start date of this allocation"
      end_date:
        type: "string"
        example: "2023-11-22"
        description: "End date of this allocation"
      start_time:
        type: "string"
        example: "14:00"
        description: "Start time in 24 hr format"
      hours:
        type: "number"
        example: 4.5
        description: "Number of hours per day"
      people_id:
        type: "integer"
        example: 11223344
        description: "The ID of the person assigned to the allocation (omit when using `people_ids` field)"
      people_ids:
        type: "array"
        example:
        - "1234"
        - "5678"
        description: "List of one or more people IDs assigned to the allocation (ignored if `people_id` is set)"
        items:
          type: "integer"
      status:
        type: "integer"
        example: 2
        description: "Status; `0` = Draft, `1` = Tentative, `2` = Confirmed, `3` = Complete, `4` = Canceled"
      billable:
        type: "integer"
        example: 1
        description: "`1` = Billable, `0` = Non-billable - Billable status is set by the associated project task (`task_meta_id`), updates using this field are deprecated"
        readOnly: true
      name:
        type: "string"
        example: "Concepting"
        description: "Name of the associated project task"
      task_meta_id:
        type: "integer"
        example: 1234567
        description: "The ID of the associated project task (named for backwards compatibility), takes higher priority over `name`"
      notes:
        type: "string"
        example: "Sketches and wireframes only."
        description: "Additional details about the work required"
      repeat_state:
        type: "integer"
        example: 0
        description: "Frequency that this allocation repeats. `0` = No repeat, `1` = Weekly,\
          \ `2` = Monthly, `3` = Every two weeks, `4` = Every three weeks, `5` = Every six weeks,\
          \ `6` = Every two months, `7` = Every three months, `8` = Every six months, `9` = Yearly"
      repeat_end_date:
        type: "string"
        example: "2023-03-16"
        description: "Date that the repeating allocation will cease"
      created_by:
        type: "integer"
        example: 23332
        description: "Account ID of the creator"
        readOnly: true
      created:
        type: "string"
        example: "2023-02-05 03:48:57.964"
        description: "Date this record was created"
        readOnly: true
      modified_by:
        type: "integer"
        example: 23332
        description: "Account ID who last modified"
        readOnly: true
      modified:
        type: "string"
        example: "2023-06-02 01:04:24.708"
        description: "Date this record was last modified"
        readOnly: true
    title: "Task"

parameters:
  task_id:
    name: "task_id"
    in: "path"
    description: "The allocation as a task ID"
    required: true
    type: "integer"

tasks:
  get:
    tags:
    - "Allocations"
    summary: "List allocations as tasks"
    description: "This version of the API references a `task` object as an allocation.  

                  **Note:** repeating allocations will also be returned if `repeat_end_date` is within the date range specified."
    operationId: "getTasks"
    parameters:
    - $ref: "../swagger-api-v3.yaml#/parameters/client_id"
    - $ref: "../swagger-api-v3.yaml#/parameters/project_id"
    - $ref: "../swagger-api-v3.yaml#/parameters/phase_id"
    - $ref: "../swagger-api-v3.yaml#/parameters/task_meta_id"
    - $ref: "../swagger-api-v3.yaml#/parameters/people_id"
    - $ref: "../swagger-api-v3.yaml#/parameters/start_date"
    - name: end_date
      in: "query"
      description: End of date range in format YYYY-MM-DD. Must be used together with `start_date`. Will be inclusive of `repeat_end_date` date.
      required: false
      type: string
    - name: billable
      in: "query"
      description: Filter response on `0` = non-billable or `1` = billable
      required: false
      type: integer
    - name: status
      in: "query"
      description: Filter response on the Status. `1` = Tentative, `2` = Confirmed, `3` = Complete"
      required: false
      type: integer
    - name: repeat_state
      in: "query"
      description: Filter response on the repeat state. `0` = No repeat, `1` = Weekly,
         `2` = Monthly, `3` = Every two weeks, `4` = Every three weeks, `5` = Every six weeks,
         `6` = Every two months, `7` = Every three months, `8` = Every six months, `9` = Yearly
      required: false
      type: integer
    - $ref: "../swagger-api-v3.yaml#/parameters/page"
    - $ref: "../swagger-api-v3.yaml#/parameters/per-page"
    - $ref: "../swagger-api-v3.yaml#/parameters/sort"
    - $ref: "../swagger-api-v3.yaml#/parameters/modified_since"
    - $ref: "../swagger-api-v3.yaml#/parameters/fields"
    - name: expand
      in: "query"
      description: Use `task_days` to return an additional array of dates `[YYYY-MM-DD]` calculated by
                   taking into account the date range & `repeat_end_date` of each `task_id` plus holidays & availability of all associated people.
                  (e.g. weekends and holidays dates will not be returned).
                  By default, a date is returned if any person is available, the `people_id` filter may be used to limit this.
                  The `start_date` and `end_date` filters must always be provided.
      required: false
      type: string
    responses:
      200:
        description: "List of allocations as tasks."
        schema:
          type: "array"
          title: "Array of tasks"
          items:
            $ref: "#/definitions/Task"
        headers:
          X-Pagination-Total-Count:
            type: "integer"
            description: "Total number of items"
          X-Pagination-Page-Count:
            type: "integer"
            description: "Total number of pages"
          X-Pagination-Current-Page:
            type: "integer"
            description: "Current page number"
          X-Pagination-Per-Page:
            type: "integer"
            description: "Number of items per page"
  post:
    tags:
    - "Allocations"
    summary: "Add a new allocation as a task, read-only fields are ignored"
    operationId: "addTask"
    parameters:
    - in: "body"
      name: "task"
      description: "The allocation to create."
      required: false
      schema:
        $ref: "#/definitions/Task"
    responses:
      201:
        description: "If the allocation was successfully created, the response returns\
          \ the full information."
        schema:
          $ref: "#/definitions/Task"
      422:
        description: "Data validation failure."

tasks-id:
  get:
    tags:
    - "Allocations"
    summary: "Retrieve a single allocation as a task"
    description: "Returns a single allocation."
    operationId: "getTask"
    parameters:
    - $ref: "#/parameters/task_id"
    responses:
      200:
        description: "Details of a single allocation."
        schema:
          $ref: "#/definitions/Task"
      404:
        description: "The allocation does not exist."
  delete:
    tags:
    - "Allocations"
    summary: "Delete an allocation as a task"
    operationId: "deleteTask"
    parameters:
    - $ref: "#/parameters/task_id"
    responses:
      204:
        description: Delete successful.
      404:
        description: "The allocation does not exist."
  patch:
    tags:
    - "Allocations"
    summary: "Update an allocations details as a task, read-only fields are ignored"
    operationId: "updateTask"
    parameters:
    - $ref: "#/parameters/task_id"
    responses:
      200:
        description: "On a successful update of an allocation, the response returns the\
          \ full information."
        schema:
          $ref: "#/definitions/Task"
      422:
        description: "Data validation failure."
