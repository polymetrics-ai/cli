definitions:
  ProjectExpense:
    type: "object"
    title: "Project Expense"
    required:
    - "name"
    - "date"
    - "cost"
    - "project_id"
    properties:
      id:
        type: "integer"
        example: 1234679
        description: "The ID of the project expense"
        readOnly: true
      name:
        type: "string"
        example: "Equipment rental"
        description: "The name of the expense, must be unique for the project"
        maxLength: 200
      date:
        type: "string"
        format: "date"
        example: "2025-08-01"
        description: "The date of the expense"
      cost:
        type: "string"
        example: "1500.0000"
        description: "The cost of the expense as a decimal string"
      project_id:
        type: "integer"
        example: 12345
        description: "The ID of the project this expense belongs to"
      phase_id: 
        type: "integer"
        example: 123
        description: "The ID of the phase this expense belongs to"
      billable:
        type: "integer"
        example: 1
        description: "Whether this expense is billable. Only billable projects can have billable expenses. `1` = Billable, `0` = Non-billable"
      markup:
        type: "string"
        example: "25.0000"
        description: "The markup percentage as a decimal string. Only billable expenses can be marked up"
      markup_type:
        type: "integer"
        example: 0
        description: "The type of markup applied. `0` = Percentage, `1` = Fixed amount"
      quantity:
        type: "integer"
        example: 1
        description: "The quantity of this expense"
        readOnly: true
      created:
        type: "string"
        format: "date-time"
        example: "2025-08-01 10:00:00"
        description: "Date this record was created"
        readOnly: true
      modified:
        type: "string"
        format: "date-time"
        example: "2025-08-01 10:00:00"
        description: "Date this record was last modified"
        readOnly: true
      created_by:
        type: "integer"
        example: 12345
        description: "Account ID of the person who created this record"
        readOnly: true
      modified_by:
        type: "integer"
        example: 12345
        description: "Account ID of the person who last modified this record"
        readOnly: true

parameters:
  project_expense_id:
    name: "project_expense_id"
    in: "path"
    description: "The project expense's ID"
    required: true
    type: "integer"

project-expenses:
    get:
      tags:
      - "Project Expenses"
      summary: "List project expenses"
      description: "Retrieve a list of project expenses"
      operationId: "getProjectExpenses"
      parameters:
      - $ref: "../swagger-api-v3.yaml#/parameters/project_id"
      - $ref: "../swagger-api-v3.yaml#/parameters/page"
      - $ref: "../swagger-api-v3.yaml#/parameters/per-page"
      - $ref: "../swagger-api-v3.yaml#/parameters/sort"
      - $ref: "../swagger-api-v3.yaml#/parameters/fields"
      responses:
        200:
          description: "The list of project expenses"
          schema:
            type: "array"
            title: "Array of project expenses"
            items:
              $ref: "#/definitions/ProjectExpense"
          headers:
            X-Pagination-Total-Count:
              type: "integer"
              description: "Total number of items"
            X-Pagination-Page-Count:
              type: "integer"
              description: "Total number of pages"
            X-Pagination-Current-Page:
              type: "integer"
              description: "The current page number"
            X-Pagination-Per-Page:
              type: "integer"
              description: "Number of items per page"
    post:
      tags:
      - "Project Expenses"
      summary: "Create a project expense"
      description: "Create a new project expense for a project, to view the expenses for a project, use the `expand=expenses` parameter on the `/projects` endpoint"
      parameters:
      - name: "body"
        in: "body"
        required: true
        schema:
          $ref: "#/definitions/ProjectExpense"
      responses:
        201:
          description: "Project expense created successfully"
          schema:
            $ref: "#/definitions/ProjectExpense"
        422:
          description: "Data validation failure."



project-expenses-id:
    get:
      tags:
      - "Project Expenses"
      summary: "Retrieve a single project expense"
      description: "Retrieve details of a single project expense"
      operationId: "getProjectExpense"
      parameters:
      - $ref: "#/parameters/project_expense_id"
      responses:
        200:
          description: "Details of a single project expense"
          schema:
            $ref: "#/definitions/ProjectExpense"
        404:
          description: "Not Found - Project expense not found"
    patch:
      tags:
      - "Project Expenses"
      summary: "Update a project expense"
      description: "Update an existing project expense"
      parameters:
      - $ref: "#/parameters/project_expense_id"
      - name: "body"
        in: "body"
        required: true
        schema:
          $ref: "#/definitions/ProjectExpense"
      responses:
        200:
          description: "Project expense updated successfully"
          schema:
            $ref: "#/definitions/ProjectExpense"
        404:
          description: "Not Found - Project expense not found"
        422:
          description: "Data validation failure."


    delete:
      tags:
      - "Project Expenses"
      summary: "Delete a project expense"
      description: "Delete a project expense"
      parameters:
      - $ref: "#/parameters/project_expense_id"
      responses:
        204:
          description: "Project expense deleted successfully"
        404:
          description: "Not Found - Project expense not found"
