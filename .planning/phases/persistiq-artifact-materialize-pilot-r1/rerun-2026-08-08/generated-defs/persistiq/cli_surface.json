    {
      "path": "add dnc domain apply",
      "summary": "Plan and execute the add dnc domain reverse-ETL action",
      "intent": "reverse_etl",
      "availability": "implemented",
      "write": "add_dnc_domain",
      "source_url": "https://persistiq.com/api-docs/v1/swagger.json",
      "flags": [
        {
          "name": "name",
          "type": "string",
          "summary": "Required name record field.",
          "maps_to": "record.name",
          "required": true
        }
      ],
      "examples": [
        "pm persistiq add dnc domain apply --plan \u003cplan-name\u003e"
      ],
      "api_surface": [
        {
          "method": "POST",
          "path": "/v1/dnc_domains"
        }
      ],
      "risk": "adds a domain to the account's Do-Not-Contact list; blocks future outreach to that domain account-wide; approval required",
      "approval": "requires plan, preview, approval, and execute"
    },
    {
      "path": "add lead to campaign apply",
