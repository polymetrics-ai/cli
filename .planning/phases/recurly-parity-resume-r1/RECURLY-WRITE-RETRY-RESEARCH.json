  "mutation_query_controls": [
    {
      "action": "deactivate_account",
      "operation_id": "deactivate_account",
      "method": "DELETE",
      "path": "/accounts/{account_id}",
      "field": "query.redact",
      "local_source_path": "writes.deactivate_account.query.redact",
      "provider_required": false,
      "local_required": true,
      "source_url": "https://recurly.com/developers/api/v2021-02-25/#operation/deactivate_account",
      "evidence_type": "openapi.parameter",
      "evidence_path": "paths./accounts/{account_id}.delete.parameters.1",
      "schema": {
        "type": "boolean",
        "description": "Permanently removes all personally identifiable information (PII) from this account after it has been deactivated, to fulfill a data subject's right to erasure under GDPR and similar privacy regulations (e.g. CCPA). Cannot be undone."
      }
    },
    {
      "action": "terminate_subscription",
      "operation_id": "terminate_subscription",
      "method": "DELETE",
      "path": "/subscriptions/{subscription_id}",
      "field": "query.refund",
      "local_source_path": "writes.terminate_subscription.query.refund",
      "provider_required": false,
      "local_required": true,
      "source_url": "https://recurly.com/developers/api/v2021-02-25/#operation/terminate_subscription",
      "evidence_type": "openapi.parameter",
      "evidence_path": "paths./subscriptions/{subscription_id}.delete.parameters.1",
      "schema": {
        "type": "string",
        "enum": [
          "full",
          "none",
          "partial"
        ],
        "default": "none",
        "description": "The type of refund to perform:\n\n* `full` - Performs a full refund of the last invoice for the current subscription term.\n* `partial` - Prorates a refund based on the amount of time remaining in the current bill cycle.\n* `none` - Terminates the subscription without a refund.\n\nIn the event that the most recent invoice is a $0 invoice paid entirely by credit, Recurly will apply the credit back to the customer’s account.\n\nYou may also terminate a subscription with no refund and then manually refund specific invoices.\n"
      }
    },
    {
      "action": "terminate_subscription",
      "operation_id": "terminate_subscription",
      "method": "DELETE",
      "path": "/subscriptions/{subscription_id}",
      "field": "query.charge",
      "local_source_path": "writes.terminate_subscription.query.charge",
      "provider_required": false,
      "local_required": true,
      "source_url": "https://recurly.com/developers/api/v2021-02-25/#operation/terminate_subscription",
      "evidence_type": "openapi.parameter",
      "evidence_path": "paths./subscriptions/{subscription_id}.delete.parameters.2",
      "schema": {
        "type": "boolean",
        "default": true,
        "description": "Applicable only if the subscription has usage based add-ons and unbilled usage logged for the current billing cycle. If true, current billing cycle unbilled usage is billed on the final invoice. If false, Recurly will create a negative usage record for current billing cycle usage that will zero out the final invoice line items."
      }
    }
  ]
}
