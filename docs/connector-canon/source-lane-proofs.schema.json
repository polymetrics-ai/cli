{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Batch One source-lane behavioral proof assertions",
  "description": "Authoring-only assertions, never self-authorizing proof. Closed structural schema; caller-anchored limits and independent reviewed catalogs remain mandatory.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "records": {
      "type": "array",
      "maxItems": 30401,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "input_sets": {
      "type": "array",
      "maxItems": 30401,
      "items": {
        "$ref": "#/$defs/input_set"
      }
    }
  },
  "required": [
    "schema_version",
    "records"
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role": {
          "enum": [
            "code",
            "test",
            "dependency"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "role"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "test_path": {
          "type": "string"
        },
        "test_symbol": {
          "type": "string"
        },
        "selected_test": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "receipt_path": {
          "type": "string"
        },
        "observable_contract": {
          "type": "string"
        },
        "key": {
          "$ref": "source-lane-manifest.schema.json#/$defs/key"
        },
        "lane": {
          "enum": [
            "direct_read",
            "direct_write",
            "binary_download",
            "binary_upload",
            "etl",
            "reverse_etl",
            "sync_transport"
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "source-lane-manifest.schema.json#/$defs/target_ref"
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/input"
          }
        },
        "input_set_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "execution_class": {
          "enum": [
            "C1",
            "C2"
          ]
        },
        "scope": {
          "enum": [
            "provider_live",
            "connector_hermetic",
            "hermetic_fixture"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim_current": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "test_path",
        "test_symbol",
        "selected_test",
        "package",
        "receipt_path",
        "observable_contract",
        "key",
        "lane",
        "targets",
        "receipt_sha256",
        "execution_class",
        "scope",
        "limitations",
        "claim_current"
      ],
      "oneOf": [
        {
          "required": [
            "inputs"
          ],
          "not": {
            "required": [
              "input_set_sha256"
            ]
          }
        },
        {
          "required": [
            "input_set_sha256"
          ],
          "not": {
            "required": [
              "inputs"
            ]
          }
        }
      ]
    },
    "input_set": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/input"
          }
        }
      },
      "required": [
        "sha256",
        "inputs"
      ]
    }
  }
}
