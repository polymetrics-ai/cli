{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polymetrics CLI connector foundation catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "catalog_revision",
    "authority",
    "foundations"
  ],
  "properties": {
    "$schema": {
      "const": "./catalog.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "catalog_revision": {
      "type": "integer",
      "minimum": 1
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "foundations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/foundation"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/]"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_only",
        "runtime_input",
        "mapping_admission",
        "certification_admission",
        "provider_fact_authority",
        "connector_specific_selection",
        "shared_runtime_connector_name_branching"
      ],
      "properties": {
        "authoring_only": {
          "const": true
        },
        "runtime_input": {
          "const": false
        },
        "mapping_admission": {
          "const": false
        },
        "certification_admission": {
          "const": false
        },
        "provider_fact_authority": {
          "const": "source_lock"
        },
        "connector_specific_selection": {
          "const": "closed_definition_reference"
        },
        "shared_runtime_connector_name_branching": {
          "const": false
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_package",
        "supporting_packages",
        "files",
        "symbols"
      ],
      "properties": {
        "primary_package": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "supporting_packages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repoPath"
          }
        },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ownerSymbol"
          }
        }
      }
    },
    "ownerSymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "name"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/repoPath"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "supportedContracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lanes",
        "protocols",
        "source_forms",
        "request_response_shapes",
        "sync_modes",
        "guarantees"
      ],
      "properties": {
        "lanes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "etl",
              "reverse_etl",
              "direct_read",
              "direct_write",
              "binary_download",
              "binary_upload"
            ]
          }
        },
        "protocols": {
          "$ref": "#/$defs/stringSet"
        },
        "source_forms": {
          "$ref": "#/$defs/stringSet"
        },
        "request_response_shapes": {
          "$ref": "#/$defs/stringSet"
        },
        "sync_modes": {
          "$ref": "#/$defs/stringSet"
        },
        "guarantees": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanisms",
        "definition_files",
        "selectors",
        "notes"
      ],
      "properties": {
        "mechanisms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "authoring_command",
              "definition_field",
              "interface_registration",
              "application_composition",
              "public_api",
              "verification_command"
            ]
          }
        },
        "definition_files": {
          "$ref": "#/$defs/stringSet"
        },
        "selectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "notes": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "consumerExample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "files",
        "notes"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repoPath"
          }
        },
        "notes": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "proofTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "file",
        "name"
      ],
      "properties": {
        "package": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "file": {
          "$ref": "#/$defs/repoPath"
        },
        "name": {
          "type": "string",
          "pattern": "^Test[A-Za-z0-9_]+$"
        }
      }
    },
    "knownGapRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reference",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reference": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "notes": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layer",
        "status",
        "kind",
        "summary",
        "owner",
        "supported_contracts",
        "selection",
        "constraints",
        "non_goals",
        "consumer_examples",
        "proof_tests",
        "known_gap_refs",
        "update_conditions",
        "supersedes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*\\.v[1-9][0-9]*$"
        },
        "layer": {
          "enum": [
            "source_retention_import",
            "source_projection_admission",
            "declarative_bundle_loading",
            "direct_execution",
            "provider_extensions",
            "sync_contract_transport",
            "warehouse_etl",
            "reverse_etl",
            "flow_schedule",
            "conformance_certification"
          ]
        },
        "status": {
          "enum": [
            "available",
            "partial",
            "planned",
            "retired"
          ]
        },
        "kind": {
          "enum": [
            "generic",
            "extension_seam",
            "connector_specific_reference"
          ]
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "supported_contracts": {
          "$ref": "#/$defs/supportedContracts"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "non_goals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "consumer_examples": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/consumerExample"
          }
        },
        "proof_tests": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/proofTest"
          }
        },
        "known_gap_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/knownGapRef"
          }
        },
        "update_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*\\.v[1-9][0-9]*$"
          }
        }
      }
    }
  }
}
