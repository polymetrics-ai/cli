{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polymetrics CLI connector foundation catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "catalog_revision", "authority", "foundations"],
  "properties": {
    "$schema": {"const": "./catalog.schema.json"},
    "schema_version": {"const": 1},
    "catalog_revision": {"type": "integer", "minimum": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoring_only", "runtime_input", "provider_fact_authority", "connector_specific_selection", "shared_runtime_connector_name_branching"],
      "properties": {
        "authoring_only": {"const": true},
        "runtime_input": {"const": false},
        "provider_fact_authority": {"const": "source_lock_vnext"},
        "connector_specific_selection": {"const": "closed_definition_reference"},
        "shared_runtime_connector_name_branching": {"const": false}
      }
    },
    "foundations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/foundation"}
    }
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "name"],
      "properties": {"file": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}}
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_package", "supporting_packages", "files", "symbols"],
      "properties": {
        "primary_package": {"type": "string", "minLength": 1},
        "supporting_packages": {"$ref": "#/$defs/strings"},
        "files": {"$ref": "#/$defs/strings"},
        "symbols": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/symbol"}}
      }
    },
    "supportedContracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lanes", "protocols", "source_forms", "request_response_shapes", "sync_modes", "guarantees"],
      "properties": {
        "lanes": {"type": "array", "uniqueItems": true, "items": {"enum": ["etl", "reverse_etl", "direct_read", "direct_write", "binary_download", "binary_upload", "sync_transport"]}},
        "protocols": {"$ref": "#/$defs/strings"},
        "source_forms": {"$ref": "#/$defs/strings"},
        "request_response_shapes": {"$ref": "#/$defs/strings"},
        "sync_modes": {"$ref": "#/$defs/strings"},
        "guarantees": {"$ref": "#/$defs/strings"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanisms", "definition_files", "selectors", "notes"],
      "properties": {
        "mechanisms": {"$ref": "#/$defs/strings"},
        "definition_files": {"$ref": "#/$defs/strings"},
        "selectors": {"$ref": "#/$defs/strings"},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "consumerExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "files", "notes"],
      "properties": {"name": {"type": "string", "minLength": 1}, "files": {"$ref": "#/$defs/strings"}, "notes": {"type": "string", "minLength": 1}}
    },
    "proofTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "file", "name"],
      "properties": {"package": {"type": "string", "minLength": 1}, "file": {"type": "string", "minLength": 1}, "name": {"type": "string", "pattern": "^Test[A-Za-z0-9_]+$"}}
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reference", "notes"],
      "properties": {"id": {"type": "string", "minLength": 1}, "reference": {"type": "string", "minLength": 1}, "notes": {"type": "string", "minLength": 1}}
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layer", "status", "kind", "summary", "owner", "supported_contracts", "selection", "constraints", "non_goals", "consumer_examples", "proof_tests", "known_gap_refs", "update_conditions", "supersedes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*\\.v[1-9][0-9]*$"},
        "layer": {"type": "string", "minLength": 1},
        "status": {"enum": ["available", "planned", "retired"]},
        "kind": {"enum": ["generic", "extension_seam", "connector_specific_reference"]},
        "summary": {"type": "string", "minLength": 1},
        "owner": {"$ref": "#/$defs/owner"},
        "supported_contracts": {"$ref": "#/$defs/supportedContracts"},
        "selection": {"$ref": "#/$defs/selection"},
        "constraints": {"$ref": "#/$defs/strings"},
        "non_goals": {"$ref": "#/$defs/strings"},
        "consumer_examples": {"type": "array", "items": {"$ref": "#/$defs/consumerExample"}},
        "proof_tests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/proofTest"}},
        "known_gap_refs": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
        "update_conditions": {"$ref": "#/$defs/strings"},
        "supersedes": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
