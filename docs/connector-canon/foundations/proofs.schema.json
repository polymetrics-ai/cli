{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authoring-only Foundation Atlas assertion proofs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "atlas",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "foundation_contract_proofs"
    },
    "atlas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "atlas_id",
          "contract",
          "owner_symbols",
          "test",
          "assertion",
          "inputs",
          "capture",
          "output",
          "execution_class",
          "scope",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "atlas_id": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pointer",
              "value_sha256"
            ],
            "properties": {
              "pointer": {
                "type": "string",
                "pattern": "^/supported_contracts/.+"
              },
              "value_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "owner_symbols": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "name"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "test": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "symbol",
              "selected",
              "package"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "symbol": {
                "type": "string",
                "pattern": "^Test[A-Za-z0-9_]+$"
              },
              "selected": {
                "type": "string",
                "minLength": 1
              },
              "package": {
                "type": "string",
                "pattern": "^\\./(cmd|internal)/"
              }
            }
          },
          "assertion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statement",
              "start_line",
              "end_line",
              "source_sha256"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "bytes",
                "role"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "role": {
                  "enum": [
                    "code",
                    "test",
                    "dependency",
                    "fixture"
                  ]
                }
              }
            }
          },
          "capture": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "output": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "execution_class": {
            "const": "C2"
          },
          "scope": {
            "const": "foundation_contract"
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
