{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authoring-only source foundation assessments",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "foundation_cell_assessments"
    },
    "atlas": {
      "$ref": "../source-lane-manifest.schema.json#/$defs/pin"
    },
    "assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cell"
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "atlas",
    "assessments"
  ],
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pointer": {
          "type": "string",
          "pattern": "^/supported_contracts/"
        },
        "value_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "pointer",
        "value_sha256"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "atlas_id": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "disposition": {
          "enum": [
            "existing_shared_capability",
            "connector_local_configuration",
            "provider_limitation",
            "absent_shared_foundation",
            "unresolved",
            "no_demand_for_this_cell"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "atlas_id",
        "contract",
        "disposition",
        "rationale"
      ]
    },
    "lookup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "atlas": {
          "$ref": "../source-lane-manifest.schema.json#/$defs/pin"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        }
      },
      "required": [
        "atlas",
        "candidates"
      ]
    },
    "decision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "cli-batch1-vercel-inbound-sync-decision-r1"
            },
            "state": {
              "const": "pending"
            },
            "condition": {
              "const": ""
            }
          },
          "required": [
            "id",
            "state",
            "condition"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "cli-plan-webhook-receiver-foundation-r1-decision-webhook-exposure-product-boundary"
            },
            "state": {
              "const": "conditional"
            },
            "condition": {
              "type": "string",
              "minLength": 1,
              "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
            }
          },
          "required": [
            "id",
            "state",
            "condition"
          ]
        }
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "../source-lane-manifest.schema.json#/$defs/fact_ref"
          }
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "atlas_lookup": {
          "$ref": "#/$defs/lookup"
        },
        "assessment": {
          "enum": [
            "existing_shared_capability",
            "connector_local_configuration",
            "provider_limitation",
            "absent_shared_foundation",
            "unresolved",
            "no_demand_for_this_cell"
          ]
        },
        "proof_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "affected_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "decision_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "fit_bindings": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "../source-lane-manifest.schema.json#/$defs/target_ref"
          }
        },
        "provider_clause": {
          "anyOf": [
            {
              "$ref": "../source-lane-manifest.schema.json#/$defs/fact_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_exclusion": {
          "anyOf": [
            {
              "$ref": "../source-lane-manifest.schema.json#/$defs/fact_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "source_refs",
        "statement",
        "atlas_lookup",
        "assessment",
        "proof_ids",
        "affected_artifacts",
        "evidence_requirements",
        "decision_refs"
      ]
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "../source-lane-manifest.schema.json#/$defs/key"
        },
        "lane": {
          "enum": [
            "direct_read",
            "direct_write",
            "binary_download",
            "binary_upload",
            "etl",
            "reverse_etl",
            "sync_transport"
          ]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "next_owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key",
        "lane",
        "requirements",
        "next_owner"
      ]
    }
  }
}
