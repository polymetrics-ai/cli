  },
  "executor": { "kind": "engine", "id": "polling_watermark" },
  "checkpoint": {
    "kind": "watermark_tuple",
    "keys": ["updated_at", "id"],
    "commit_after": "downstream_ack",
    "on_invalid": "resnapshot_required"
  },
  "delivery": {
    "ordering": "provider_declared_stable_order",
    "duplicates": "at_least_once",
