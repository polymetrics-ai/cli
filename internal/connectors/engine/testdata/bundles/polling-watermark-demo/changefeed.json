    "tie_breaker": { "path": "id" },
    "boundary": "inclusive",
    "safety_lag_seconds": 120,
    "page_size": 2,
    "max_pages": 3,
    "request_budget": 3,
    "soft_delete": { "path": "deleted" }
  }
