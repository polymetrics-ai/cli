{
  "operations": [
    {
      "id": "caller.identifiers.comma",
      "kind": "rest_read",
      "summary": "Look up a caller-supplied coin set",
      "risk": "low",
      "approval": "none",
      "output_policy": "json_redacted",
      "rest": {
        "method": "GET",
        "path": "/lookups/comma",
        "max_bytes": 1024,
        "caller_supplied_identifier_sets": [{
          "name": "coins",
          "element_shape": "opaque_string",
          "wire": "query_comma_separated",
          "min_items": 0,
          "max_items": 2
        }]
      }
    },
    {
      "id": "caller.identifiers.repeated",
      "kind": "rest_read",
      "summary": "Look up structured market identifiers",
      "risk": "low",
      "approval": "none",
      "output_policy": "json_redacted",
      "rest": {
        "method": "GET",
        "path": "/lookups/repeated",
        "max_bytes": 1024,
        "caller_supplied_identifier_sets": [{
          "name": "markets",
          "element_shape": "chain_address",
          "wire": "query_repeated",
          "min_items": 0,
          "max_items": 2
        }]
      }
    },
    {
      "id": "caller.identifiers.body",
      "kind": "rest_read",
      "summary": "Look up identifiers in a JSON body",
      "risk": "low",
      "approval": "none",
      "output_policy": "json_redacted",
      "rest": {
        "method": "POST",
        "path": "/lookups/body",
        "content_type": "application/json",
        "max_bytes": 1024,
        "body_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ids"],
          "properties": {
            "ids": {
              "type": "array",
              "minItems": 0,
              "maxItems": 2,
              "items": { "type": "string" }
            }
          }
        },
        "caller_supplied_identifier_sets": [{
          "name": "ids",
          "element_shape": "opaque_string",
          "wire": "body_json_array",
          "min_items": 0,
          "max_items": 2
        }]
      }
    },
    {
      "id": "caller.identifiers.path",
      "kind": "rest_read",
      "summary": "Look up one caller-supplied identifier",
      "risk": "low",
      "approval": "none",
      "output_policy": "json_redacted",
      "rest": {
        "method": "GET",
        "path": "/lookups/path/{id}",
        "max_bytes": 1024,
        "caller_supplied_identifier_sets": [{
          "name": "id",
          "element_shape": "opaque_string",
          "wire": "path_segment",
          "min_items": 1,
          "max_items": 1
        }]
      }
    }
  ]
}
