{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "declaration_admission_sources.json",
  "type": "object",
  "required": ["schema_version", "cohort", "expected_connectors", "expected_source_operations", "source_operations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "cohort": { "type": "string", "minLength": 1, "maxLength": 128 },
    "expected_connectors": { "type": "integer", "minimum": 1 },
    "expected_source_operations": { "type": "integer", "minimum": 1 },
    "source_operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["connector", "id", "protocol", "source_url", "location", "operation_id", "method", "path", "binding", "destructive_kind"],
        "additionalProperties": false,
        "properties": {
          "connector": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "protocol": { "type": "string", "enum": ["rest", "graphql"] },
          "source_url": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "location": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "operation_id": { "type": "string", "maxLength": 512 },
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"] },
          "base_path": { "type": "string", "maxLength": 8192 },
          "path": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "binding": {
            "type": "object",
            "required": ["kind", "id"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "enum": ["command", "stream", "write", "operation"] },
              "id": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          },
          "destructive_kind": { "type": "string", "enum": ["none", "delete", "destructive"] }
        }
      }
    }
  }
}
