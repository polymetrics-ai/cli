{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "composite_provider_path_identity.json",
  "type": "object",
  "required": ["connector", "source_url", "source_sha256", "placeholder", "config_keys", "bindings"],
  "additionalProperties": false,
  "properties": {
    "connector": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "minLength": 1 },
    "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "placeholder": { "type": "string", "minLength": 1 },
    "config_keys": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "source_id", "provider_operation_id", "source_location", "intent", "binding_kind", "binding_id", "method", "path"],
        "additionalProperties": false,
        "properties": {
          "order": { "type": "integer", "minimum": 0 },
          "source_id": { "type": "string", "minLength": 1 },
          "provider_operation_id": { "type": "string", "minLength": 1 },
          "source_location": { "type": "string", "minLength": 1 },
          "intent": { "type": "string", "minLength": 1 },
          "binding_kind": { "type": "string", "minLength": 1 },
          "binding_id": { "type": "string", "minLength": 1 },
          "method": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
