{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "source_operation_mapping.json",
  "type": "object",
  "required": ["schema_version", "source_locks", "operations", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "source_locks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["connector", "path"],
        "additionalProperties": false,
        "properties": {
          "connector": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[a-z0-9][a-z0-9-]*/sources/[a-zA-Z0-9._/-]+-operation-source-lock\\.json$"
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["connector", "source_operation_id", "canonical_operation_id", "citation", "facts", "cells"],
        "additionalProperties": false,
        "properties": {
          "connector": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "source_operation_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "canonical_operation_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "citation": {
            "type": "object",
            "required": ["source_url", "location"],
            "additionalProperties": false,
            "properties": {
              "source_url": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "location": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          },
          "facts": {
            "type": "object",
            "required": ["pagination", "record_shape", "scope", "path_variables", "media", "event_cursor", "mutation", "applicability"],
            "additionalProperties": false,
            "properties": {
              "pagination": {
                "type": "object",
                "required": ["kind", "citation"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "type": "string", "enum": ["none", "page_number", "offset_limit", "cursor", "next_url", "link_header", "start_index", "other"] },
                  "citation": {
                    "type": "object",
                    "required": ["source_url", "location"],
                    "additionalProperties": false,
                    "properties": {
                      "source_url": { "type": "string", "minLength": 1, "maxLength": 4096 },
                      "location": { "type": "string", "minLength": 1, "maxLength": 4096 }
                    }
                  }
                }
              },
              "record_shape": {
                "type": "object",
                "required": ["kind", "citation"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "type": "string", "enum": ["none", "record", "collection", "binary", "other"] },
                  "citation": {
                    "type": "object",
                    "required": ["source_url", "location"],
                    "additionalProperties": false,
                    "properties": {
                      "source_url": { "type": "string", "minLength": 1, "maxLength": 4096 },
                      "location": { "type": "string", "minLength": 1, "maxLength": 4096 }
                    }
                  }
                }
              },
              "scope": {
                "type": "object",
                "required": ["values", "citation"],
                "additionalProperties": false,
                "properties": {
                  "values": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
                  "citation": {
                    "type": "object",
                    "required": ["source_url", "location"],
                    "additionalProperties": false,
                    "properties": {
                      "source_url": { "type": "string", "minLength": 1, "maxLength": 4096 },
                      "location": { "type": "string", "minLength": 1, "maxLength": 4096 }
                    }
                  }
                }
              },
              "path_variables": {
                "type": "object",
                "required": ["values", "citation"],
                "additionalProperties": false,
                "properties": {
                  "values": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
                  "citation": {
                    "type": "object",
                    "required": ["source_url", "location"],
                    "additionalProperties": false,
                    "properties": {
                      "source_url": { "type": "string", "minLength": 1, "maxLength": 4096 },
                      "location": { "type": "string", "minLength": 1, "maxLength": 4096 }
                    }
                  }
                }
              },
              "media": {
                "type": "object",
                "required": ["request", "response", "citation"],
                "additionalProperties": false,
                "properties": {
                  "request": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
                  "response": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
                  "citation": {
                    "type": "object",
                    "required": ["source_url", "location"],
                    "additionalProperties": false,
                    "properties": {
                      "source_url": { "type": "string", "minLength": 1, "maxLength": 4096 },
                      "location": { "type": "string", "minLength": 1, "maxLength": 4096 }
                    }
                  }
                }
              },
              "event_cursor": {
                "type": "object",
                "required": ["kind", "citation"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "type": "string", "enum": ["none", "event", "cursor", "event_cursor"] },
                  "citation": {
                    "type": "object",
                    "required": ["source_url", "location"],
                    "additionalProperties": false,
                    "properties": {
                      "source_url": { "type": "string", "minLength": 1, "maxLength": 4096 },
                      "location": { "type": "string", "minLength": 1, "maxLength": 4096 }
                    }
                  }
                }
              },
              "mutation": {
                "type": "object",
                "required": ["kind", "citation"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "type": "string", "enum": ["mutation", "not_mutation"] },
                  "citation": {
                    "type": "object",
                    "required": ["source_url", "location"],
                    "additionalProperties": false,
                    "properties": {
                      "source_url": { "type": "string", "minLength": 1, "maxLength": 4096 },
                      "location": { "type": "string", "minLength": 1, "maxLength": 4096 }
                    }
                  }
                }
              },
              "applicability": {
                "type": "object",
                "required": ["etl", "binary_download", "binary_upload", "sync_transport"],
                "additionalProperties": false,
                "properties": {
                  "etl": {
                    "type": "object",
                    "required": ["kind", "citation"],
                    "additionalProperties": false,
                    "properties": {
                      "kind": { "type": "string", "enum": ["applicable", "not_applicable"] },
                      "citation": {
                        "type": "object",
                        "required": ["source_url", "location"],
                        "additionalProperties": false,
                        "properties": {
                          "source_url": { "type": "string", "minLength": 1, "maxLength": 4096 },
                          "location": { "type": "string", "minLength": 1, "maxLength": 4096 }
                        }
                      }
                    }
                  },
                  "binary_download": {
                    "type": "object",
                    "required": ["kind", "citation"],
                    "additionalProperties": false,
                    "properties": {
                      "kind": { "type": "string", "enum": ["applicable", "not_applicable"] },
                      "citation": {
                        "type": "object",
                        "required": ["source_url", "location"],
                        "additionalProperties": false,
                        "properties": {
                          "source_url": { "type": "string", "minLength": 1, "maxLength": 4096 },
                          "location": { "type": "string", "minLength": 1, "maxLength": 4096 }
                        }
                      }
                    }
                  },
                  "binary_upload": {
                    "type": "object",
                    "required": ["kind", "citation"],
                    "additionalProperties": false,
                    "properties": {
                      "kind": { "type": "string", "enum": ["applicable", "not_applicable"] },
                      "citation": {
                        "type": "object",
                        "required": ["source_url", "location"],
                        "additionalProperties": false,
                        "properties": {
                          "source_url": { "type": "string", "minLength": 1, "maxLength": 4096 },
                          "location": { "type": "string", "minLength": 1, "maxLength": 4096 }
                        }
                      }
                    }
                  },
                  "sync_transport": {
                    "type": "object",
                    "required": ["kind", "citation"],
                    "additionalProperties": false,
                    "properties": {
                      "kind": { "type": "string", "enum": ["applicable", "not_applicable"] },
                      "citation": {
                        "type": "object",
                        "required": ["source_url", "location"],
                        "additionalProperties": false,
                        "properties": {
                          "source_url": { "type": "string", "minLength": 1, "maxLength": 4096 },
                          "location": { "type": "string", "minLength": 1, "maxLength": 4096 }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["lane", "state"],
              "additionalProperties": false,
              "properties": {
                "lane": { "type": "string", "enum": ["direct_read", "direct_write", "binary_download", "binary_upload", "etl", "reverse_etl", "sync_transport"] },
                "state": { "type": "string", "enum": ["implemented", "mapped_unproven", "missing_foundation", "not_applicable"] },
                "reason": {
                  "type": "object",
                  "required": ["kind", "id"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": { "type": "string", "enum": ["missing_foundation", "provider_not_applicable"] },
                    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
                    "citation": {
                      "type": "object",
                      "required": ["source_url", "location"],
                      "additionalProperties": false,
                      "properties": {
                        "source_url": { "type": "string", "minLength": 1, "maxLength": 4096 },
                        "location": { "type": "string", "minLength": 1, "maxLength": 4096 }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "cells"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_operation_id", "lane"],
              "additionalProperties": false,
              "properties": {
                "source_operation_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
                "lane": { "type": "string", "enum": ["direct_read", "direct_write", "binary_download", "binary_upload", "etl", "reverse_etl", "sync_transport"] }
              }
            }
          }
        }
      }
    }
  }
}
