{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cli_surface.json",
  "type": "object",
  "required": ["tagline", "usage", "commands"],
  "additionalProperties": false,
  "properties": {
    "tagline": { "type": "string" },
    "usage": { "type": "string" },
    "source_cli": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "docs": { "type": "string" },
        "reference": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "commands"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "commands": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "global_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["boolean", "string", "integer", "number", "enum", "string_array", "json"]
          },
          "summary": { "type": "string" },
          "values": {
            "type": "array",
            "items": { "type": "string" }
          },
          "maps_to": { "type": "string" },
          "format": {
            "type": "string",
            "enum": ["date-time"]
          },
          "allow_empty": { "type": "boolean" },
          "minimum": { "type": "number" },
		  "maximum": { "type": "number" },
          "required": { "type": "boolean" },
          "env_only": { "type": "boolean" },
		  "allow_bare_string": { "type": "boolean" },
          "max_items": { "type": "integer" },
          "min_items": { "type": "integer" },
          "max_bytes": { "type": "integer" }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "summary", "intent", "availability"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "summary": { "type": "string" },
          "intent": {
            "type": "string",
            "enum": [
              "etl",
              "reverse_etl",
              "direct_read",
              "direct_write",
              "binary_download",
              "binary_upload",
              "text_export",
              "status_check",
              "local_workflow",
              "auth",
              "config",
              "raw_api",
              "docs_only"
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "implemented",
              "partial",
              "planned",
              "excluded",
              "unsupported_local",
              "unsupported_api",
              "unsafe_or_disallowed",
              "unknown"
            ]
          },
          "stream": { "type": "string" },
          "write": { "type": "string" },
          "operation": { "type": "string" },
          "source_operation": { "type": "string", "minLength": 1 },
          "source_cli_path": { "type": "string" },
          "source_url": { "type": "string" },
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": ["boolean", "string", "integer", "number", "enum", "string_array", "json"]
                },
                "summary": { "type": "string" },
                "values": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "maps_to": { "type": "string" },
                "format": {
                  "type": "string",
                  "enum": ["date-time"]
                },
                "allow_empty": { "type": "boolean" },
                "minimum": { "type": "number" },
				"maximum": { "type": "number" },
                "required": { "type": "boolean" },
                "repeatable": { "type": "boolean" },
                "env_only": { "type": "boolean" },
				"allow_bare_string": { "type": "boolean" },
                "max_items": { "type": "integer" },
                "min_items": { "type": "integer" },
                "max_bytes": { "type": "integer" }
              }
            }
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["order", "exactly_one"]
                },
                "fields": {
                  "type": "array",
                  "minItems": 2,
                  "items": { "type": "string" }
                },
                "left": { "type": "string" },
                "right": { "type": "string" },
                "op": {
                  "type": "string",
                  "enum": ["lt"]
                },
                "value_type": {
                  "type": "string",
                  "enum": ["date-time"]
                },
                "left_fallback": { "type": "string" },
                "right_fallback": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          },
          "examples": {
            "type": "array",
            "items": { "type": "string" }
          },
          "api_surface": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["method", "path"],
              "additionalProperties": false,
              "properties": {
                "method": { "type": "string" },
                "path": { "type": "string" }
              }
            }
          },
          "output_policy": {
            "type": "string",
            "enum": ["repository_contents_file_metadata", "repository_contents_directory", "json_redacted", "clinical_json_redacted", "text", "binary_file_bounded", "none", "json", "write_result_redacted", "gong_bounded_input_redacted", "secret_stored", "status"]
          },
          "redact_fields": {
            "type": "array",
            "items": { "type": "string" }
          },
          "risk": { "type": "string" },
          "approval": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "help_topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "summary"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
