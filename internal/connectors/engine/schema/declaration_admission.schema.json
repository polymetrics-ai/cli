{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "declaration_admissions.json",
  "type": "object",
  "required": ["schema_version", "cohort", "expected_declarations", "declarations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "cohort": { "type": "string", "minLength": 1, "maxLength": 128 },
    "expected_declarations": { "type": "integer", "minimum": 1 },
    "declarations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["connector", "source_id", "lane", "command", "state", "canonical", "binding"],
        "additionalProperties": false,
        "properties": {
          "connector": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "source_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "lane": { "type": "string", "enum": ["etl", "reverse_etl", "direct_read", "direct_write", "binary_download", "binary_upload"] },
          "command": { "type": "string", "minLength": 1, "maxLength": 512 },
          "state": { "type": "string", "enum": ["implemented", "deferred"] },
          "canonical": {
            "type": "object",
            "required": ["method", "path"],
            "additionalProperties": false,
            "properties": {
              "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "GRAPHQL"] },
              "path": { "type": "string", "minLength": 1, "maxLength": 8192 }
            }
          },
          "binding": {
            "type": "object",
            "required": ["kind", "id"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "enum": ["command", "stream", "write", "operation"] },
              "id": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          },
          "foundation_gap": {
            "type": "object",
            "required": ["id", "reason", "component", "evidence", "target"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 128 },
              "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
              "component": {
                "type": "string",
                "enum": ["typed_write_action", "typed_record_schema", "typed_request_body", "typed_response_descriptor", "binary_transfer_binding", "source_importer", "runtime_executor"]
              },
              "evidence": {
                "type": "string",
                "enum": ["write_action_absent", "record_schema_absent", "request_body_schema_absent", "response_descriptor_absent", "binary_transfer_binding_absent", "source_importer_absent", "runtime_executor_absent"]
              },
              "target": {
                "type": "object",
                "required": ["method", "path"],
                "additionalProperties": false,
                "properties": {
                  "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "GRAPHQL"] },
                  "path": { "type": "string", "minLength": 1, "maxLength": 8192 }
                }
              }
            }
          },
          "destructive": {
            "type": "object",
            "required": ["kind", "reason"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "enum": ["delete", "destructive"] },
              "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          }
        }
      }
    }
  }
}
