{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "enabled_connector_contract.json",
  "type": "object",
  "required": ["schema_version", "connector", "source_lock", "lanes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "connector": {"type": "string", "minLength": 1},
    "source_lock": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "canonical_evidence"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 64, "maxLength": 64},
        "bytes": {"type": "integer", "minimum": 1},
        "canonical_evidence": {"type": "boolean"}
      }
    },
    "supplemental_source_locks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "operations"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "operations": {"type": "integer", "minimum": 1}
        }
      }
    },
    "lanes": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "state", "reason", "citations", "artifacts", "source"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "state": {"type": "string", "enum": ["implemented", "mapped_unproven", "deferred_foundation", "unsupported_with_provider_evidence"]},
          "reason": {"type": "string", "minLength": 1},
          "citations": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["url", "location"],
              "properties": {"url": {"type": "string", "minLength": 1}, "location": {"type": "string", "minLength": 1}}
            }
          },
          "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "source": {
            "type": "object", "additionalProperties": false,
            "required": ["partition", "coverage", "expected", "implemented", "unmapped_mapping", "deferred_foundation", "unsupported_with_provider_evidence"],
            "properties": {
              "source_lock": {"type": "string", "minLength": 1},
              "partition": {"type": "boolean"},
              "methods": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "operation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "coverage": {"type": "string", "enum": ["complete", "partial", "not_applicable"]},
              "expected": {"type": "integer", "minimum": 0},
              "implemented": {"type": "integer", "minimum": 0},
              "mapped_unproven": {"type": "integer", "minimum": 0},
              "unmapped_mapping": {"type": "integer", "minimum": 0},
              "deferred_foundation": {"type": "integer", "minimum": 0},
              "unsupported_with_provider_evidence": {"type": "integer", "minimum": 0}
            }
          },
          "transport": {
            "type": "object", "additionalProperties": false,
            "required": ["modes", "runtime_delivery", "streams"],
            "properties": {
              "modes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "runtime_delivery": {
                "type": "object", "additionalProperties": false,
                "required": ["idempotency", "ordering", "deletes"],
                "properties": {
                  "idempotency": {"type": "string", "enum": ["keyed", "at_least_once", "single_attempt", "none"]},
                  "ordering": {"type": "string", "enum": ["source_ordered", "window_coalesced", "unordered"]},
                  "deletes": {"type": "string", "enum": ["tombstone", "not_available"]}
                }
              },
              "streams": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["stream", "cursor_evidence", "delete_evidence", "order_evidence"],
                  "properties": {
                    "stream": {"type": "string", "minLength": 1},
                    "source_operation": {"type": "string", "minLength": 1},
                    "cursor_evidence": {"type": "string", "enum": ["not_declared", "source_cited"]},
                    "delete_evidence": {"type": "string", "enum": ["not_declared", "source_cited"]},
                    "order_evidence": {"type": "string", "enum": ["not_declared", "source_cited"]}
                  }
                }
              },
              "destination": {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "actions_artifact", "expected_actions", "plan_executor", "preview_executor", "approval_executor"],
                "properties": {
                  "kind": {"type": "string", "enum": ["reverse_plan_preview_approval"]},
                  "actions_artifact": {"type": "string", "minLength": 1},
                  "expected_actions": {"type": "integer", "minimum": 1},
                  "plan_executor": {"type": "string", "minLength": 1},
                  "preview_executor": {"type": "string", "minLength": 1},
                  "approval_executor": {"type": "string", "minLength": 1}
                }
              }
            }
          },
          "warehouse_flows": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["direction", "runtime", "proof"],
              "properties": {
                "direction": {"type": "string", "enum": ["provider_to_duckdb", "duckdb_to_provider"]},
                "runtime": {"type": "string", "minLength": 1},
                "proof": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
