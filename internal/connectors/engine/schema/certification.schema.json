{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "certification.json",
  "type": "object",
  "required": ["schema_version"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_stream": { "type": "string" },
        "source_credential_defaults": {
          "type": "object",
          "additionalProperties": true
        },
        "required_credential_config": {
          "type": "object",
          "additionalProperties": true
        },
        "live_unavailable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["contains"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string" },
              "contains": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "direct_read_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage_name", "command", "args"],
        "additionalProperties": false,
        "properties": {
          "stage_name": { "type": "string" },
          "command": { "type": "string" },
          "args": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "literal": { "type": "string" },
                "config_key": { "type": "string" },
                "default": { "type": "string" },
                "omit_when_empty": { "type": "boolean" },
                "when_config_key": { "type": "string" },
                "connector": { "type": "boolean" },
                "source_credential": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "binary_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage_name", "command", "args"],
        "additionalProperties": false,
        "properties": {
          "stage_name": { "type": "string" },
          "command": { "type": "string" },
          "args": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "literal": { "type": "string" },
                "config_key": { "type": "string" },
                "default": { "type": "string" },
                "omit_when_empty": { "type": "boolean" },
                "when_config_key": { "type": "string" },
                "connector": { "type": "boolean" },
                "source_credential": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "write_pairings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["create", "cleanup", "id_field", "verify_stream", "verify_field"],
        "additionalProperties": false,
        "properties": {
          "create": { "type": "string" },
          "cleanup": { "type": "string" },
          "cleanup_kind": { "type": "string", "enum": ["delete", "close", "archive"] },
          "id_field": { "type": "string" },
          "verify_stream": { "type": "string" },
          "verify_field": { "type": "string" },
          "overrides": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
