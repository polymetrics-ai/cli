{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "certification.json",
  "type": "object",
  "required": ["schema_version"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_stream": { "type": "string" },
        "source_credential_defaults": {
          "type": "object",
          "additionalProperties": true
        },
        "required_credential_config": {
          "type": "object",
          "additionalProperties": true
        },
        "live_unavailable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["contains"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string" },
              "contains": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "direct_read_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage_name", "command", "args"],
        "additionalProperties": false,
        "properties": {
          "stage_name": { "type": "string" },
          "command": { "type": "string" },
          "args": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "literal": { "type": "string" },
                "config_key": { "type": "string" },
                "default": { "type": "string" },
                "omit_when_empty": { "type": "boolean" },
                "when_config_key": { "type": "string" },
                "connector": { "type": "boolean" },
                "source_credential": { "type": "boolean" }
              }
            }
          },
          "output_assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["json_pointer"],
              "additionalProperties": false,
              "properties": {
                "json_pointer": { "type": "string" },
                "equals": {},
                "value_type": {
                  "type": "string",
                  "enum": ["object", "array", "string", "number", "boolean", "null"]
                }
              }
            }
          }
        }
      }
    },
    "binary_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage_name", "command", "args"],
        "additionalProperties": false,
        "properties": {
          "stage_name": { "type": "string" },
          "command": { "type": "string" },
          "args": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "literal": { "type": "string" },
                "config_key": { "type": "string" },
                "default": { "type": "string" },
                "omit_when_empty": { "type": "boolean" },
                "when_config_key": { "type": "string" },
                "connector": { "type": "boolean" },
                "source_credential": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "graphql": {
      "type": "object",
      "required": ["source_lock", "command_prefix", "schema_conformant_reason", "fixture_required_reason", "live_candidates"],
      "additionalProperties": false,
      "properties": {
        "source_lock": { "type": "string" },
        "command_prefix": { "type": "string" },
        "schema_conformant_reason": { "type": "string" },
        "fixture_required_reason": { "type": "string" },
        "live_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["stage_name", "command", "args", "output_assertions"],
            "additionalProperties": false,
            "properties": {
              "stage_name": { "type": "string" },
              "command": { "type": "string" },
              "args": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "literal": { "type": "string" },
                    "config_key": { "type": "string" },
                    "default": { "type": "string" },
                    "omit_when_empty": { "type": "boolean" },
                    "when_config_key": { "type": "string" },
                    "connector": { "type": "boolean" },
                    "source_credential": { "type": "boolean" }
                  }
                }
              },
              "output_assertions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["json_pointer"],
                  "additionalProperties": false,
                  "properties": {
                    "json_pointer": { "type": "string" },
                    "equals": {},
                    "value_type": {
                      "type": "string",
                      "enum": ["object", "array", "string", "number", "boolean", "null"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "write_pairings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["create", "cleanup", "id_field", "verify_stream", "verify_field"],
        "additionalProperties": false,
        "properties": {
          "create": { "type": "string" },
          "cleanup": { "type": "string" },
          "cleanup_kind": { "type": "string", "enum": ["delete", "close", "archive"] },
          "id_field": { "type": "string" },
          "verify_stream": { "type": "string" },
          "verify_field": { "type": "string" },
          "overrides": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "write_inventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["classification", "reason"],
            "additionalProperties": false,
            "properties": {
              "classification": { "type": "string" },
              "reason": { "type": "string" },
              "actions": { "type": "array", "items": { "type": "string" } },
              "paths": { "type": "array", "items": { "type": "string" } },
              "path_prefixes": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "write_wave": {
      "type": "object",
      "required": ["fixture", "actions", "action_bindings", "scenarios", "tag_prefix", "tag_subject_prefix"],
      "additionalProperties": false,
      "properties": {
        "fixture": {
          "type": "object",
          "required": ["config", "description"],
          "additionalProperties": false,
          "properties": {
            "config": { "type": "object", "additionalProperties": true },
            "description": { "type": "string" }
          }
        },
        "actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "action_bindings": { "type": "object", "minProperties": 1, "additionalProperties": true },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "ledger_name", "tag_name", "actions"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "ledger_name": { "type": "string" },
              "tag_name": { "type": "string" },
              "actions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        },
        "blocked_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "actions", "reason"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "reason": { "type": "string" }
            }
          }
        },
        "tag_prefix": { "type": "string" },
        "tag_subject_prefix": { "type": "string" }
      }
    }
  }
}
