{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "operations.json",
  "type": "object",
  "required": ["operations"],
  "additionalProperties": false,
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "summary", "risk", "approval", "output_policy"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "stream_etl",
              "rest_read",
              "rest_write",
              "provider_search",
              "graphql_query",
              "graphql_mutation",
              "xml_export",
              "xml_import",
              "binary_download",
              "file_upload",
              "local_git",
              "local_file",
              "browser_open",
              "composite"
            ]
          },
          "summary": { "type": "string" },
          "description": { "type": "string" },
          "source_url": { "type": "string" },
          "risk": {
            "type": "string",
            "enum": ["none", "low", "medium", "high", "critical"]
          },
          "approval": { "type": "string" },
          "output_policy": { "type": "string" },
          "auth_scopes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "mutation_class": {
            "type": "string",
            "enum": ["none", "create", "update", "delete", "admin", "destructive", "secret"]
          },
          "destructive": { "type": "boolean" },
          "batchable": { "type": "boolean" },
          "confirmation": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "enum": ["destructive"] }
            }
          },
          "secret_sensitive": { "type": "boolean" },
          "sensitive_policy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "input_mode": {
                "type": "string",
                "enum": ["env", "file", "stdin", "env_or_file", "env_or_stdin", "inline"]
              },
              "redact_fields": {
                "type": "array",
                "items": { "type": "string" }
              },
              "preflight": { "type": "string" },
              "transform": {
                "type": "string",
                "enum": ["none", "github_secret_encryption"]
              },
              "approval_mode": {
                "type": "string",
                "enum": ["none", "typed_confirmation"]
              }
            }
          },
          "audit_event": { "type": "string" },
          "rest": {
            "type": "object",
            "required": ["method", "path"],
            "additionalProperties": false,
            "properties": {
              "method": { "type": "string" },
              "path": { "type": "string" },
              "base_url": { "type": "string" },
              "auth": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": { "type": "string" },
                    "token": { "type": "string" },
                    "username": { "type": "string" },
                    "password": { "type": "string" },
                    "header": { "type": "string" },
                    "prefix": { "type": "string" },
                    "param": { "type": "string" },
                    "value": { "type": "string" },
                    "token_url": { "type": "string" },
                    "client_id": { "type": "string" },
                    "client_secret": { "type": "string" },
                    "client_auth": { "type": "string", "enum": ["form", "basic"] },
                    "scopes": { "type": "string" },
                    "extra_params": { "type": "object" },
                    "refresh_token": { "type": "string" },
                    "refresh_token_store_key": { "type": "string" },
                    "hook": { "type": "string" },
                    "when": { "type": "string" }
                  }
                }
              },
              "content_type": { "type": "string" },
              "max_bytes": { "type": "integer" },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "in"],
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "in": { "type": "string", "enum": ["query", "path"] },
                    "type": { "type": "string" },
                    "required": { "type": "boolean" },
                    "values": { "type": "array", "items": { "type": "string" } },
                    "summary": { "type": "string" }
                  }
                }
              },
              "query": {
                "type": "object",
                "additionalProperties": true
              },
              "required_query": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["any_of"],
                  "additionalProperties": false,
                  "properties": {
                    "any_of": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "string" }
                    }
                  }
                }
              },
              "body": {
                "type": "object",
                "additionalProperties": true
              },
              "body_schema": { "type": "object" },
              "multipart": {
                "type": "object",
                "required": ["max_bytes", "parts"],
                "additionalProperties": false,
                "properties": {
                  "max_bytes": { "type": "integer" },
                  "parts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["name", "type", "field"],
                      "additionalProperties": false,
                      "properties": {
                        "name": { "type": "string" },
                        "type": { "type": "string", "enum": ["field", "file"] },
                        "field": { "type": "string" },
                        "content_type": { "type": "string" },
                        "allowed_media_types": {
                          "type": "array",
                          "minItems": 1,
                          "items": { "type": "string" }
                        },
                        "content_validation": { "type": "string", "enum": ["json", "csv"] },
                        "allowed_file_extensions": {
                          "type": "array",
                          "minItems": 1,
                          "items": { "type": "string" }
                        },
                        "required": { "type": "boolean" },
                        "max_bytes": { "type": "integer" }
                      }
                    }
                  }
                }
              },
              "redirect": {
                "type": "object",
                "required": ["allowed_host_suffixes", "max_hops"],
                "additionalProperties": false,
                "properties": {
                  "allowed_host_suffixes": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string" }
                  },
                  "max_hops": { "type": "integer" }
                }
              }
            }
          },
          "graphql": {
            "type": "object",
            "required": ["document", "operation_name"],
            "additionalProperties": false,
            "properties": {
              "document": { "type": "string" },
              "operation_name": { "type": "string" },
              "variables_path": { "type": "string" },
              "pagination": { "type": "object" }
            }
          },
          "xml": {
            "type": "object",
            "required": ["envelope_template"],
            "additionalProperties": false,
            "properties": {
              "envelope_template": { "type": "string" },
              "response_path": { "type": "string" },
              "headers": {
                "type": "object",
                "additionalProperties": true
              }
            }
          },
          "binary": {
            "type": "object",
            "required": ["method", "path"],
            "additionalProperties": false,
            "properties": {
              "method": { "type": "string" },
              "path": { "type": "string" },
              "max_bytes": { "type": "integer" },
              "allow_overwrite": { "type": "boolean" },
              "extract_archives": { "type": "boolean" },
              "allow_cross_host": { "type": "boolean" },
              "allowed_hosts": { "type": "array", "items": { "type": "string" } },
              "content_types": { "type": "array", "items": { "type": "string" } },
              "stall_timeout_seconds": { "type": "integer" }
            }
          },
          "file": {
            "type": "object",
            "required": ["direction"],
            "additionalProperties": false,
            "properties": {
              "direction": {
                "type": "string",
                "enum": ["download", "upload", "read", "write"]
              },
              "path": { "type": "string" },
              "max_bytes": { "type": "integer" }
            }
          },
          "local_git": {
            "type": "object",
            "required": ["action"],
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string",
                "enum": ["clone", "fetch", "checkout", "branch_create", "branch_delete", "remote_inspect", "remote_add", "status"]
              },
              "allowed_args": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "local_file": {
            "type": "object",
            "required": ["action"],
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string",
                "enum": ["read", "write", "mkdir"]
              },
              "path": { "type": "string" },
              "max_bytes": { "type": "integer" }
            }
          },
          "browser": {
            "type": "object",
            "required": ["action"],
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string",
                "enum": ["open"]
              },
              "url": { "type": "string" }
            }
          },
          "composite": {
            "type": "object",
            "required": ["steps"],
            "additionalProperties": false,
            "properties": {
              "steps": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
