{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "declaration_admission_inventory.json",
  "type": "object",
  "required": ["schema_version", "cohort", "operations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "cohort": { "type": "string", "minLength": 1, "maxLength": 128 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["connector", "source_id", "source_lock", "source_operation_id"],
        "additionalProperties": false,
        "properties": {
          "connector": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "source_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "source_lock": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[a-z0-9][a-z0-9-]*/sources/[a-zA-Z0-9._/-]+-operation-source-lock\\.json$"
          },
          "source_operation_id": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  }
}
