{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "source_operation_mapping_cohort.json",
  "type": "object",
  "required": ["schema_version", "cohort", "expected_connectors", "source_operation_count", "source_operations_sha256", "source_locks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "cohort": { "type": "string", "minLength": 1, "maxLength": 256 },
    "expected_connectors": {
      "type": "array",
      "minItems": 10,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "source_operation_count": { "type": "integer", "minimum": 1 },
    "source_operations_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_locks": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["connector", "path", "sha256", "source_operation_count", "source_ids_sha256", "matrix_path"],
        "additionalProperties": false,
        "properties": {
          "connector": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "source_operation_count": { "type": "integer", "minimum": 1 },
          "source_ids_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "matrix_path": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  }
}
