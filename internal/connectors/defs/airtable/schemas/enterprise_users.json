    "email",
    "state"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "isAdmin": {
      "type": "boolean"
    },
    "createdTime": {
      "type": "string",
      "format": "date-time"
    },
    "lastActivityTime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": true,
  "x-primary-key": [
    "id"
  ]
}
