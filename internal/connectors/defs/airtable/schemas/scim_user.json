{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Airtable scim_user record",
  "type": "object",
  "required": [
    "schemas",
    "id",
    "userName"
  ],
  "properties": {
    "schemas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "id": {
      "type": "string"
    },
    "userName": {
      "type": "string"
    },
    "name": {
      "type": "object",
      "properties": {
        "givenName": {
          "type": "string"
        },
        "familyName": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "emails": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "primary": {
            "type": "boolean"
          },
          "type": {
            "type": "string"
          }
        },
        "additionalProperties": true,
        "required": [
          "value"
        ]
      }
    },
    "active": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "x-primary-key": [
    "id"
  ]
}
