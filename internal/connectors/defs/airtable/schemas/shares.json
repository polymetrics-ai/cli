{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Airtable shares record",
  "type": "object",
  "required": [
    "shareTokenPrefix",
    "shareId",
    "state",
    "type",
    "createdByUserId",
    "isPasswordProtected",
    "restrictedToEmailDomains",
    "restrictedToEnterpriseMembers",
    "createdTime"
  ],
  "properties": {
    "blockInstallationId": {
      "type": "string"
    },
    "canBeSynced": {
      "type": "boolean"
    },
    "createdByUserId": {
      "type": "string"
    },
    "createdTime": {
      "type": "string",
      "format": "date-time"
    },
    "effectiveEmailDomainAllowList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "isPasswordProtected": {
      "type": "boolean"
    },
    "restrictedToEmailDomains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "restrictedToEnterpriseMembers": {
      "type": "boolean"
    },
    "shareId": {
      "type": "string"
    },
    "shareTokenPrefix": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "viewId": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "x-primary-key": [
    "shareId"
  ]
}
