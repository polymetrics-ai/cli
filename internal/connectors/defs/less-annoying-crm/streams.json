{
  "base": {
    "auth": [
      {
        "header": "Authorization",
        "mode": "api_key_header",
        "prefix": "",
        "value": "{{ secrets.api_key }}"
      }
    ],
    "check": {
      "body": {
        "Function": "GetUsers"
      },
      "method": "POST",
      "path": "/"
    },
    "error_map": [],
    "pagination": {
      "page_param": "Page",
      "page_size": 500,
      "size_param": "MaxNumberOfResults",
      "start_page": 1,
      "type": "page_number"
    },
    "url": "https://api.lessannoyingcrm.com/v2",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "body": {
        "Function": "GetUsers"
      },
      "method": "POST",
      "name": "users",
      "path": "/",
      "records": {
        "path": "."
      },
      "schema": "schemas/users.json"
    },
    {
      "body": {
        "Function": "GetContacts"
      },
      "method": "POST",
      "name": "contacts",
      "path": "/",
      "records": {
        "path": "Results"
      },
      "schema": "schemas/contacts.json"
    },
    {
      "body": {
        "Function": "GetTasks"
      },
      "incremental": {
        "client_filtered": true,
        "cursor_field": "DateCreated"
      },
      "method": "POST",
      "name": "tasks",
      "path": "/",
      "records": {
        "path": "Results"
      },
      "schema": "schemas/tasks.json"
    },
    {
      "body": {
        "Function": "GetNotes"
      },
      "method": "POST",
      "name": "notes",
      "path": "/",
      "records": {
        "path": "Results"
      },
      "schema": "schemas/notes.json"
    },
    {
      "body": {
        "Function": "GetEvents"
      },
      "incremental": {
        "client_filtered": true,
        "cursor_field": "DateUpdated"
      },
      "method": "POST",
      "name": "events",
      "path": "/",
      "records": {
        "path": "Results"
      },
      "schema": "schemas/events.json"
    }
  ]
}
