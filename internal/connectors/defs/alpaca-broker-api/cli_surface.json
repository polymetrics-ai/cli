      "stream": "account_activities",
      "source_url": "https://raw.githubusercontent.com/alpacahq/alpaca-docs/master/oas/broker/openapi.yaml",
      "examples": [
        "pm alpaca-broker-api account activities list --json"
      ],
      "api_surface": [
        {
          "method": "GET",
          "path": "/v1/accounts/activities"
