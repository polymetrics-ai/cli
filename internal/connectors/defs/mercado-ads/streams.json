{
  "base": {
    "auth": [
      {
        "client_id": "{{ secrets.client_id }}",
        "client_secret": "{{ secrets.client_secret }}",
        "mode": "oauth2_refresh_token",
        "refresh_token": "{{ secrets.client_refresh_token }}",
        "token_url": "https://api.mercadolibre.com/oauth/token"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/advertising/advertisers",
      "query": {
        "product_id": "BADS"
      }
    },
    "error_map": [],
    "headers": {
      "Api-Version": "1"
    },
    "pagination": {
      "limit_param": "limit",
      "max_pages": 100,
      "offset_param": "offset",
      "page_size": 100,
      "type": "offset_limit"
    },
    "url": "https://api.mercadolibre.com",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "method": "GET",
      "name": "brand_advertisers",
      "path": "/advertising/advertisers",
      "query": {
        "product_id": "BADS"
      },
      "records": {
        "path": "advertisers"
      },
      "schema": "schemas/brand_advertisers.json"
    },
    {
      "method": "GET",
      "name": "display_advertisers",
      "path": "/advertising/advertisers",
      "query": {
        "product_id": "DISPLAY"
      },
      "records": {
        "path": "advertisers"
      },
      "schema": "schemas/display_advertisers.json"
    },
    {
      "method": "GET",
      "name": "product_advertisers",
      "path": "/advertising/advertisers",
      "query": {
        "product_id": "PADS"
      },
      "records": {
        "path": "advertisers"
      },
      "schema": "schemas/product_advertisers.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "date",
        "request_param": "date_from"
      },
      "method": "GET",
      "name": "brand_campaigns_metrics",
      "path": "/advertising/advertisers/{{ config.advertiser_id }}/brand_ads/campaigns/{{ config.campaign_id }}/metrics",
      "records": {
        "path": "metrics"
      },
      "schema": "schemas/brand_campaigns_metrics.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "date",
        "request_param": "date_from"
      },
      "method": "GET",
      "name": "display_campaigns_metrics",
      "path": "/advertising/advertisers/{{ config.advertiser_id }}/display_ads/campaigns/{{ config.campaign_id }}/metrics",
      "records": {
        "path": "metrics"
      },
      "schema": "schemas/display_campaigns_metrics.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "date",
        "request_param": "date_from"
      },
      "method": "GET",
      "name": "product_campaigns_metrics",
      "path": "/advertising/advertisers/{{ config.advertiser_id }}/product_ads/campaigns/{{ config.campaign_id }}/metrics",
      "records": {
        "path": "metrics"
      },
      "schema": "schemas/product_campaigns_metrics.json"
    }
  ]
}
