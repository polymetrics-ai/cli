{
  "base": {
    "auth": [
      {
        "mode": "bearer",
        "token": "{{ secrets.api_token }}"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/conversation_export",
      "query": {
        "updated_after": "{{ config.updated_after }}",
        "updated_before": "{{ config.updated_before }}"
      }
    },
    "error_map": [],
    "pagination": {
      "type": "none"
    },
    "url": "https://exports.dixa.io",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "updated_at"
      },
      "method": "GET",
      "name": "conversations",
      "path": "/conversation_export",
      "projection": "passthrough",
      "query": {
        "updated_after": "{{ config.updated_after }}",
        "updated_before": "{{ config.updated_before }}"
      },
      "records": {
        "path": "."
      },
      "schema": "schemas/conversations.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "updated_at"
      },
      "method": "GET",
      "name": "conversation_queue",
      "path": "/conversation_export",
      "projection": "passthrough",
      "query": {
        "updated_after": "{{ config.updated_after }}",
        "updated_before": "{{ config.updated_before }}"
      },
      "records": {
        "path": "."
      },
      "schema": "schemas/conversation_queue.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "updated_at"
      },
      "method": "GET",
      "name": "conversation_rating",
      "path": "/conversation_export",
      "projection": "passthrough",
      "query": {
        "updated_after": "{{ config.updated_after }}",
        "updated_before": "{{ config.updated_before }}"
      },
      "records": {
        "path": "."
      },
      "schema": "schemas/conversation_rating.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "updated_at"
      },
      "method": "GET",
      "name": "conversation_assignment",
      "path": "/conversation_export",
      "projection": "passthrough",
      "query": {
        "updated_after": "{{ config.updated_after }}",
        "updated_before": "{{ config.updated_before }}"
      },
      "records": {
        "path": "."
      },
      "schema": "schemas/conversation_assignment.json"
    }
  ]
}
