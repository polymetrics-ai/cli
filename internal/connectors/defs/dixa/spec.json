{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "api_token": {
      "description": "Dixa API token.",
      "type": "string",
      "x-secret": true
    },
    "updated_after": {
      "default": "0",
      "description": "Inclusive export lower bound in milliseconds.",
      "type": "string"
    },
    "updated_before": {
      "default": "1",
      "description": "Exclusive export upper bound in milliseconds.",
      "type": "string"
    }
  },
  "title": "Dixa Connection Specification",
  "type": "object",
  "x-reject-unknown-config": true
}
