{
  "actions": [
    {
      "name": "create_repository",
      "kind": "create",
      "method": "POST",
      "path": "/namespaces/{{ record.namespace }}/repositories",
      "record_schema": {
        "type": "object",
        "required": [
          "name",
          "namespace"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Repository name (2-255 chars, lowercase alphanumerics/./_/-)."
          },
          "namespace": {
            "type": "string",
            "description": "Namespace to create the repository in."
          },
          "description": {
            "type": "string",
            "description": "Short description (max 100 chars)."
          },
          "full_description": {
            "type": "string",
            "description": "Detailed description (max 25000 chars)."
          },
          "registry": {
            "type": "string",
            "description": "Registry where the repository is hosted."
          },
          "is_private": {
            "type": "boolean",
            "description": "Whether the repository should be private.",
            "default": false
          }
        },
        "additionalProperties": false
      },
      "risk": "medium: mutates Docker Hub account/organization state; requires reverse ETL approval",
      "path_fields": [
        "namespace"
      ]
    },
    {
      "name": "update_repository_immutable_tags",
      "kind": "update",
      "method": "PATCH",
      "path": "/namespaces/{{ record.namespace }}/repositories/{{ record.repository }}/immutabletags",
      "record_schema": {
        "type": "object",
        "required": [
          "namespace",
          "repository",
          "immutable_tags",
          "immutable_tags_rules"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "description": "Path parameter `namespace`."
          },
          "repository": {
            "type": "string",
            "description": "Path parameter `repository`."
          },
          "immutable_tags": {
            "type": "boolean",
            "description": "Whether immutable tags are enabled."
          },
          "immutable_tags_rules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of immutable tag rules (e.g. glob-like patterns)."
          }
        },
        "additionalProperties": false
      },
      "risk": "medium: mutates Docker Hub account/organization state; requires reverse ETL approval",
      "path_fields": [
        "namespace",
        "repository"
      ]
    },
    {
      "name": "assign_repository_group",
      "kind": "create",
      "method": "POST",
      "path": "/repositories/{{ record.namespace }}/{{ record.repository }}/groups",
      "record_schema": {
        "type": "object",
        "required": [
          "namespace",
          "repository",
          "group_id",
          "permission"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "description": "Path parameter `namespace`."
          },
          "repository": {
            "type": "string",
            "description": "Path parameter `repository`."
          },
          "group_id": {
            "type": "integer",
            "description": "The ID of the organization group to grant access to."
          },
          "permission": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "admin"
            ],
            "description": "Permission level to grant."
          }
        },
        "additionalProperties": false
      },
      "risk": "medium: mutates Docker Hub account/organization state; requires reverse ETL approval",
      "path_fields": [
        "namespace",
        "repository"
      ]
    },
    {
      "name": "create_access_token",
      "kind": "create",
      "method": "POST",
      "path": "/access-tokens",
      "record_schema": {
        "type": "object",
        "required": [
          "token_label",
          "scopes"
        ],
        "properties": {
          "token_label": {
            "type": "string",
            "description": "Friendly name to identify the token."
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Valid scopes: \"repo:admin\", \"repo:write\", \"repo:read\", \"repo:public_read\"."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Optional expiration date; omitted means the token never expires."
          }
        },
        "additionalProperties": false
      },
      "risk": "high: creates a live Docker Hub credential; provider response is returned unchanged and can include a raw token; requires reverse ETL approval"
    },
    {
      "name": "update_access_token",
      "kind": "update",
      "method": "PATCH",
      "path": "/access-tokens/{{ record.uuid }}",
      "record_schema": {
        "type": "object",
        "required": [
          "uuid"
        ],
        "properties": {
          "uuid": {
            "type": "string",
            "description": "Path parameter `uuid`."
          },
          "token_label": {
            "type": "string",
            "description": "Friendly name to identify the token."
          },
          "is_active": {
            "type": "boolean",
            "description": "Whether the token is active."
          }
        },
        "additionalProperties": false
      },
      "risk": "medium: mutates Docker Hub account/organization state; requires reverse ETL approval",
      "path_fields": [
        "uuid"
      ]
    },
    {
      "name": "delete_access_token",
      "kind": "delete",
      "method": "DELETE",
      "path": "/access-tokens/{{ record.uuid }}",
      "record_schema": {
        "type": "object",
        "required": [
          "uuid"
        ],
        "properties": {
          "uuid": {
            "type": "string",
            "description": "Path parameter `uuid`."
          }
        },
        "additionalProperties": false
      },
      "risk": "high: revokes a live Docker Hub credential; requires reverse ETL approval and destructive confirmation",
      "path_fields": [
        "uuid"
      ],
      "body_type": "none",
      "confirm": "destructive",
      "delete": {
        "idempotent": true,
        "missing_ok_status": [
          404
        ]
      }
    },
    {
      "name": "create_org_access_token",
      "kind": "create",
      "method": "POST",
      "path": "/orgs/{{ record.name }}/access-tokens",
      "record_schema": {
        "type": "object",
        "required": [
          "name",
          "label"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Path parameter `name` (organization name)."
          },
          "label": {
            "type": "string",
            "description": "Label for the access token."
          },
          "description": {
            "type": "string",
            "description": "Description of the access token."
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Resources (repo/org scopes) this token has access to."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Expiration date for the token."
          }
        },
        "additionalProperties": false
      },
      "risk": "high: creates a live Docker Hub organization credential; provider response is returned unchanged and can include a raw token; requires reverse ETL approval",
      "path_fields": [
        "name"
      ]
    },
    {
      "name": "update_org_access_token",
      "kind": "update",
      "method": "PATCH",
      "path": "/orgs/{{ record.org_name }}/access-tokens/{{ record.access_token_id }}",
      "record_schema": {
        "type": "object",
        "required": [
          "org_name",
          "access_token_id"
