    },
    {
      "name": "update_org_settings",
      "kind": "update",
      "method": "PUT",
      "path": "/orgs/{{ record.name }}/settings",
      "record_schema": {
        "type": "object",
        "required": [
          "name",
          "restricted_images_enabled",
          "restricted_images_allow_official",
          "restricted_images_allow_verified_publishers"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Path parameter `name`."
          },
          "restricted_images_enabled": {
            "type": "boolean",
            "description": "Whether to restrict image usage for users in the organization."
          },
          "restricted_images_allow_official": {
            "type": "boolean",
            "description": "Allow official images if restricted_images_enabled is true."
          },
          "restricted_images_allow_verified_publishers": {
            "type": "boolean",
            "description": "Allow verified-publisher images if restricted_images_enabled is true."
          }
        },
        "additionalProperties": false
      },
      "risk": "medium: mutates Docker Hub account/organization state; requires reverse ETL approval",
      "path_fields": [
        "name"
      ]
    },
