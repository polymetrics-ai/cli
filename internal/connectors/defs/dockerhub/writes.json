{
  "actions": [
    {
      "name": "create_auth_token",
      "kind": "create",
      "method": "POST",
      "path": "/v2/auth/token",
      "record_schema": {
        "type": "object",
        "required": [
          "identifier",
          "secret"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "description": "Username (password/PAT auth) or organization name (organization access token auth)."
          },
          "secret": {
            "type": "string",
            "description": "Password, personal access token, or organization access token."
          }
        },
        "additionalProperties": false
      },
      "risk": "high: exchanges a credential for a live 10-minute access token; the token is redacted from command output; requires reverse ETL approval",
      "redact_fields": [
        "access_token"
      ]
    },
    {
      "name": "create_user_login",
      "kind": "create",
      "method": "POST",
      "path": "/v2/users/login",
      "record_schema": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "description": "Docker Hub account username."
          },
          "password": {
            "type": "string",
            "description": "Docker Hub account password or Personal Access Token."
          }
        },
        "additionalProperties": false
      },
      "risk": "high: exchanges a credential for a live session JWT; the token is redacted from command output; requires reverse ETL approval",
      "redact_fields": [
        "token"
      ]
    },
    {
      "name": "create_2fa_login",
      "kind": "create",
      "method": "POST",
      "path": "/v2/users/2fa-login",
      "record_schema": {
        "type": "object",
        "required": [
          "login_2fa_token",
          "code"
        ],
        "properties": {
          "login_2fa_token": {
            "type": "string",
            "description": "The intermediate 2FA token returned from `auth login create`."
          },
          "code": {
            "type": "string",
            "description": "The Time-based One-Time Password (TOTP) of the Docker Hub account."
          }
        },
        "additionalProperties": false
      },
      "risk": "high: exchanges a 2FA challenge for a live session JWT; the token is redacted from command output; requires reverse ETL approval",
      "redact_fields": [
        "token"
      ]
    },
    {
      "name": "create_repository",
      "kind": "create",
      "method": "POST",
      "path": "/v2/namespaces/{namespace}/repositories",
      "record_schema": {
        "type": "object",
        "required": [
          "name",
          "namespace"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Repository name (2-255 chars, lowercase alphanumerics/./_/-)."
          },
          "namespace": {
            "type": "string",
            "description": "Namespace to create the repository in."
          },
          "description": {
            "type": "string",
            "description": "Short description (max 100 chars)."
          },
          "full_description": {
            "type": "string",
            "description": "Detailed description (max 25000 chars)."
          },
          "registry": {
            "type": "string",
            "description": "Registry where the repository is hosted."
          },
          "is_private": {
            "type": "boolean",
            "description": "Whether the repository should be private.",
            "default": false
          }
        },
        "additionalProperties": false
      },
      "risk": "medium: mutates Docker Hub account/organization state; requires reverse ETL approval"
    },
    {
      "name": "update_repository_immutable_tags",
      "kind": "update",
      "method": "PATCH",
      "path": "/v2/namespaces/{namespace}/repositories/{repository}/immutabletags",
      "record_schema": {
        "type": "object",
        "required": [
          "namespace",
          "repository",
          "immutable_tags",
          "immutable_tags_rules"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "description": "Path parameter `namespace`."
          },
          "repository": {
            "type": "string",
            "description": "Path parameter `repository`."
          },
          "immutable_tags": {
            "type": "boolean",
            "description": "Whether immutable tags are enabled."
          },
          "immutable_tags_rules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of immutable tag rules (e.g. glob-like patterns)."
          }
        },
        "additionalProperties": false
      },
      "risk": "medium: mutates Docker Hub account/organization state; requires reverse ETL approval",
      "path_fields": [
        "namespace",
        "repository"
      ]
    },
    {
      "name": "assign_repository_group",
      "kind": "create",
      "method": "POST",
      "path": "/v2/repositories/{namespace}/{repository}/groups",
      "record_schema": {
        "type": "object",
        "required": [
          "namespace",
          "repository",
          "group_id",
          "permission"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "description": "Path parameter `namespace`."
          },
          "repository": {
            "type": "string",
            "description": "Path parameter `repository`."
          },
          "group_id": {
            "type": "integer",
            "description": "The ID of the organization group to grant access to."
          },
          "permission": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "admin"
            ],
            "description": "Permission level to grant."
          }
        },
        "additionalProperties": false
      },
      "risk": "medium: mutates Docker Hub account/organization state; requires reverse ETL approval",
      "path_fields": [
        "namespace",
        "repository"
      ]
    },
    {
      "name": "create_access_token",
      "kind": "create",
      "method": "POST",
      "path": "/v2/access-tokens",
      "record_schema": {
        "type": "object",
        "required": [
          "token_label",
          "scopes"
        ],
        "properties": {
          "token_label": {
            "type": "string",
            "description": "Friendly name to identify the token."
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Valid scopes: \"repo:admin\", \"repo:write\", \"repo:read\", \"repo:public_read\"."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Optional expiration date; omitted means the token never expires."
          }
        },
        "additionalProperties": false
      },
      "risk": "high: creates a live Docker Hub credential; the raw token is returned once by the provider and redacted from command output; requires reverse ETL approval",
      "redact_fields": [
        "token"
      ]
    },
    {
      "name": "update_access_token",
      "kind": "update",
      "method": "PATCH",
      "path": "/v2/access-tokens/{uuid}",
      "record_schema": {
        "type": "object",
        "required": [
          "uuid"
        ],
        "properties": {
          "uuid": {
            "type": "string",
            "description": "Path parameter `uuid`."
          },
          "token_label": {
            "type": "string",
            "description": "Friendly name to identify the token."
          },
          "is_active": {
            "type": "boolean",
            "description": "Whether the token is active."
          }
        },
        "additionalProperties": false
      },
      "risk": "medium: mutates Docker Hub account/organization state; requires reverse ETL approval",
      "path_fields": [
        "uuid"
      ],
      "redact_fields": [
        "token"
      ]
    },
    {
      "name": "delete_access_token",
      "kind": "delete",
      "method": "DELETE",
      "path": "/v2/access-tokens/{uuid}",
      "record_schema": {
        "type": "object",
        "required": [
          "uuid"
        ],
        "properties": {
          "uuid": {
            "type": "string",
            "description": "Path parameter `uuid`."
          }
        },
        "additionalProperties": false
      },
      "risk": "high: revokes a live Docker Hub credential; requires reverse ETL approval and destructive confirmation",
      "path_fields": [
        "uuid"
      ],
      "body_type": "none",
      "confirm": "destructive",
      "delete": {
        "idempotent": true,
        "missing_ok_status": [
          404
        ]
      }
    },
