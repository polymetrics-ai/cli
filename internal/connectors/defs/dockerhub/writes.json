            "type": "string",
            "description": "Description of the access token."
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Resources (repo/org scopes) this token has access to."
          },
          "is_active": {
            "type": "boolean",
            "description": "Whether the token is active."
