{
  "actions": [
    {
      "name": "update_organization_settings",
      "kind": "update",
      "method": "PUT",
      "path": "/v2/orgs/{{ record.name }}/settings",
      "path_fields": [
        "name"
      ],
      "body_type": "json",
      "record_schema": {
        "required": [
          "restricted_images",
          "name"
        ],
        "properties": {
          "restricted_images": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Whether or not to restrict image usage for users in the organization."
              },
              "allow_official_images": {
                "type": "boolean",
                "description": "Allow usage of official images if \"enabled\" is `true`."
              },
              "allow_verified_publishers": {
                "type": "boolean",
                "description": "Allow usage of verified publisher images if \"enabled\" is `true`."
              }
            },
            "required": [
              "enabled",
              "allow_official_images",
              "allow_verified_publishers"
            ]
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object",
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "risk": "high",
      "body_fields": [
        "restricted_images"
      ],
      "body_required": true
    },
    {
      "name": "update_repository_immutable_tags",
      "kind": "update",
      "method": "PATCH",
      "path": "/v2/namespaces/{{ record.namespace }}/repositories/{{ record.repository }}/immutabletags",
      "path_fields": [
        "namespace",
        "repository"
      ],
      "body_type": "json",
      "record_schema": {
        "type": "object",
        "properties": {
          "immutable_tags": {
            "type": "boolean",
            "description": "Whether immutable tags are enabled"
          },
          "immutable_tags_rules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of immutable tag rules"
          },
          "namespace": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          }
        },
        "required": [
          "immutable_tags",
          "immutable_tags_rules",
          "namespace",
          "repository"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "risk": "high",
      "body_fields": [
        "immutable_tags",
        "immutable_tags_rules"
      ]
    },
    {
      "name": "verify_repository_immutable_tags",
      "kind": "create",
      "method": "POST",
      "path": "/v2/namespaces/{{ record.namespace }}/repositories/{{ record.repository }}/immutabletags/verify",
      "path_fields": [
        "namespace",
        "repository"
      ],
      "body_type": "json",
      "record_schema": {
        "type": "object",
        "properties": {
          "regex": {
            "type": "string",
            "pattern": "^[a-z0-9]+((\\\\.|_|__|-+)[a-z0-9]+)*(\\\\/[a-z0-9]+((\\\\.|_|__|-+)[a-z0-9]+)*)*$",
            "description": "Immutable tags rule regex pattern. Must match format: [a-z0-9]+((\\\\.|_|__|-+)[a-z0-9]+)*(\\\\/[a-z0-9]+((\\\\.|_|__|-+)[a-z0-9]+)*)*"
          },
          "namespace": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          }
        },
        "required": [
          "regex",
          "namespace",
          "repository"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "risk": "high",
      "body_fields": [
        "regex"
      ]
    },
    {
      "name": "create_repository_group",
      "kind": "create",
      "method": "POST",
      "path": "/v2/repositories/{{ record.namespace }}/{{ record.repository }}/groups",
      "path_fields": [
        "namespace",
        "repository"
      ],
      "body_type": "json",
      "record_schema": {
        "type": "object",
        "required": [
          "group_id",
          "permission",
          "namespace",
          "repository"
        ],
        "properties": {
          "group_id": {
            "type": "integer",
            "format": "int64",
            "description": "The ID of the organization group to grant access to"
          },
          "permission": {
            "type": "string",
            "description": "The permission level to grant to the group:\n- read: Can view and pull from the repository\n- write: Can view, pull, and push to the repository\n- admin: Can view, pull, push, and manage repository settings\n",
            "enum": [
              "read",
              "write",
              "admin"
            ]
          },
          "namespace": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "risk": "high",
      "body_fields": [
        "group_id",
        "permission"
      ],
      "body_required": true
    },
    {
      "name": "create_repository",
      "kind": "create",
      "method": "POST",
      "path": "/v2/namespaces/{{ record.namespace }}/repositories",
      "path_fields": [
        "namespace"
      ],
      "body_type": "json",
      "record_schema": {
        "type": "object",
        "required": [
          "name",
          "namespace"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the repository. Must be 2-255 characters long and may only include \nalphanumeric characters, periods (.), underscores (_), or hyphens (-). \nLetters must be lowercase.\n",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "namespace": {
            "type": "string",
            "description": "The namespace where the repository will be created"
          },
          "description": {
            "type": "string",
            "description": "Short description of the repository"
          },
          "full_description": {
            "type": "string",
            "description": "Detailed description of the repository"
          },
          "registry": {
            "type": "string",
            "description": "The registry where the repository will be hosted"
          },
          "is_private": {
            "type": "boolean",
            "description": "Whether the repository should be private",
            "default": false
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "risk": "high",
      "body_fields": [
        "name",
        "namespace",
        "description",
        "full_description",
        "registry",
        "is_private"
      ],
      "body_required": true
    },
    {
      "name": "update_organization_member",
      "kind": "update",
      "method": "PUT",
      "path": "/v2/orgs/{{ record.org_name }}/members/{{ record.username }}",
      "path_fields": [
        "org_name",
        "username"
      ],
      "body_type": "json",
      "record_schema": {
        "required": [
          "role",
          "org_name",
          "username"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "Role of the member",
            "enum": [
              "owner",
              "editor",
              "member"
            ]
          },
          "org_name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "type": "object",
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "risk": "high",
      "body_fields": [
        "role"
      ],
      "body_required": true
    },
    {
      "name": "delete_organization_member",
      "kind": "delete",
      "method": "DELETE",
      "path": "/v2/orgs/{{ record.org_name }}/members/{{ record.username }}",
      "path_fields": [
        "org_name",
        "username"
      ],
      "body_type": "none",
      "record_schema": {
        "type": "object",
        "$schema": "http://json-schema.org/draft-07/schema#",
        "properties": {
          "org_name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "org_name",
          "username"
        ]
      },
      "risk": "high",
      "confirmation": {
        "kind": "destructive"
      }
    },
