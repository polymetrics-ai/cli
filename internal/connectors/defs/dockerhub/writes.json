        "additionalProperties": false
      },
      "risk": "medium: mutates Docker Hub account/organization state; requires reverse ETL approval",
      "path_fields": [
        "org_name",
        "access_token_id"
      ]
    },
    {
      "name": "delete_org_access_token",
      "kind": "delete",
      "method": "DELETE",
      "path": "/orgs/{{ record.org_name }}/access-tokens/{{ record.access_token_id }}",
      "record_schema": {
        "type": "object",
        "required": [
          "org_name",
          "access_token_id"
        ],
        "properties": {
          "org_name": {
            "type": "string",
            "description": "Path parameter `org_name`."
          },
          "access_token_id": {
            "type": "string",
            "description": "Path parameter `access_token_id`."
          }
        },
        "additionalProperties": false
      },
      "risk": "high: revokes a live Docker Hub organization credential; requires reverse ETL approval and destructive confirmation",
      "path_fields": [
        "org_name",
        "access_token_id"
      ],
      "body_type": "none",
      "confirm": "destructive",
      "delete": {
        "idempotent": true,
        "missing_ok_status": [
          404
        ]
      }
    },
    {
      "name": "create_group",
