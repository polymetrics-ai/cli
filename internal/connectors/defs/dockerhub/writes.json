    {
      "name": "create_scim_user",
      "kind": "create",
      "method": "POST",
      "path": "/scim/2.0/Users",
      "content_type": "application/scim+json",
      "record_schema": {
        "type": "object",
        "required": [
          "schemas",
          "userName"
        ],
        "properties": {
          "schemas": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "SCIM schema URNs, e.g. \"urn:ietf:params:scim:schemas:core:2.0:User\"."
          },
          "userName": {
            "type": "string",
            "description": "The user's email address; must be reachable via email."
          },
          "name": {
            "type": "object",
            "properties": {
              "givenName": {
                "type": "string",
                "description": "Given (first) name."
              },
              "familyName": {
                "type": "string",
                "description": "Family (last) name."
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "risk": "high: provisions a new SCIM-managed identity; requires reverse ETL approval"
    },
    {
      "name": "update_scim_user",
      "kind": "update",
      "method": "PUT",
      "path": "/scim/2.0/Users/{{ record.id }}",
      "content_type": "application/scim+json",
      "record_schema": {
        "type": "object",
        "required": [
          "id",
          "schemas",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Path parameter `id`."
          },
          "schemas": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "SCIM schema URNs, e.g. \"urn:ietf:params:scim:schemas:core:2.0:User\"."
          },
          "name": {
            "type": "object",
            "properties": {
              "givenName": {
                "type": "string",
                "description": "Given (first) name."
              },
              "familyName": {
                "type": "string",
                "description": "Family (last) name."
              }
            },
            "additionalProperties": false
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the user is active. The provider defaults a missing value to false (deactivated); this command requires it explicitly to prevent accidental deactivation."
          }
        },
        "additionalProperties": false
      },
      "risk": "high: replaces a SCIM-managed identity's profile and can deactivate it; requires reverse ETL approval",
      "path_fields": [
        "id"
      ]
    }
  ]
}
