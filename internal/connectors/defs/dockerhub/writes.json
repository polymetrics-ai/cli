    {
      "name": "bulk_create_invites",
      "kind": "create",
      "method": "POST",
      "path": "/invites/bulk",
      "record_schema": {
        "type": "object",
        "required": [
          "org",
          "invitees"
        ],
        "properties": {
          "org": {
            "type": "string",
            "description": "Organization name."
          },
          "team": {
            "type": "string",
            "description": "Team name."
          },
          "role": {
            "type": "string",
            "description": "Role for invitees."
          },
          "invitees": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of invitee emails or Docker IDs."
          },
          "dry_run": {
            "type": "boolean",
            "description": "Run through validation without changing data."
          }
        },
        "additionalProperties": false
      },
      "risk": "medium: mutates Docker Hub account/organization state; requires reverse ETL approval"
    },
    {
      "name": "cancel_invite",
      "kind": "delete",
      "method": "DELETE",
      "path": "/invites/{{ record.id }}",
      "record_schema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Path parameter `id`."
          }
        },
        "additionalProperties": false
      },
      "risk": "medium: cancels a pending organization invite; requires reverse ETL approval and destructive confirmation",
      "path_fields": [
        "id"
