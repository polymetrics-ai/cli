    {
      "name": "create_organization_invites",
      "kind": "create",
      "method": "POST",
      "path": "/v2/invites/bulk",
      "path_fields": [],
      "body_type": "json",
      "record_schema": {
        "type": "object",
        "required": [
          "org",
          "invitees"
        ],
        "properties": {
          "org": {
            "type": "string",
            "description": "organization name"
          },
          "team": {
            "type": "string",
            "description": "team name"
          },
          "role": {
            "type": "string",
            "description": "role for invitees"
          },
          "invitees": {
            "type": "array",
            "description": "list of invitees emails or Docker Ids",
            "items": {
              "type": "string",
              "description": "invitee email or Docker ID"
            }
          },
          "dry_run": {
            "type": "boolean",
            "description": "Optional, run through validation but don't actually change data."
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "risk": "high",
      "body_fields": [
        "org",
        "team",
        "role",
        "invitees",
        "dry_run"
      ]
    },
    {
      "name": "update_personal_access_token",
      "kind": "update",
      "method": "PATCH",
      "path": "/v2/access-tokens/{{ record.uuid }}",
      "path_fields": [
        "uuid"
      ],
      "body_type": "json",
      "record_schema": {
        "type": "object",
        "properties": {
          "token_label": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean"
          },
          "uuid": {
            "type": "string"
          }
        },
        "required": [
          "uuid"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "risk": "high",
      "body_fields": [
        "token_label",
        "is_active"
      ],
      "body_required": true
    },
    {
      "name": "delete_personal_access_token",
      "kind": "delete",
      "method": "DELETE",
      "path": "/v2/access-tokens/{{ record.uuid }}",
      "path_fields": [
        "uuid"
      ],
      "body_type": "none",
      "record_schema": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string"
          }
        },
        "required": [
          "uuid"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "risk": "high",
      "confirmation": {
        "kind": "destructive"
      }
    },
    {
      "name": "update_organization_access_token",
      "kind": "update",
      "method": "PATCH",
      "path": "/v2/orgs/{{ record.org_name }}/access-tokens/{{ record.access_token_id }}",
      "path_fields": [
        "org_name",
        "access_token_id"
      ],
      "body_type": "json",
      "record_schema": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Label for the access token"
          },
          "description": {
            "type": "string",
            "description": "Description of the access token"
          },
          "resources": {
            "type": "array",
            "description": "Resources this token has access to",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "TYPE_REPO",
                    "TYPE_ORG"
                  ],
                  "description": "The type of resource"
                },
                "path": {
                  "type": "string",
                  "description": "The path of the resource. The format of this will change depending on the type of resource.\n\nFor TYPE_REPO resources:\n- Must be an existing repository name (e.g., \"myorg/myrepo\")\n- Can use glob patterns (e.g., \"myorg/*\" for all repositories in the organization)\n- Use \"*/*/public\" to reference all public repositories\n"
                },
                "scopes": {
                  "type": "array",
                  "description": "The scopes this token has access to",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "is_active": {
            "type": "boolean",
            "description": "Whether the token is active"
          },
          "org_name": {
            "type": "string",
            "description": "Name of the organization (namespace)."
          },
          "access_token_id": {
            "type": "string",
            "description": "The ID of the access token to retrieve"
          }
        },
        "required": [
          "org_name",
          "access_token_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "risk": "high",
      "body_fields": [
        "label",
        "description",
        "resources",
        "is_active"
      ],
      "body_required": true
    },
    {
      "name": "delete_organization_access_token",
      "kind": "delete",
      "method": "DELETE",
      "path": "/v2/orgs/{{ record.org_name }}/access-tokens/{{ record.access_token_id }}",
