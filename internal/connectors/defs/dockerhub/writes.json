          },
          "username": {
            "type": "string",
            "description": "Path parameter `username`."
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "editor",
              "member"
            ],
            "description": "Role of the member."
          }
        },
        "additionalProperties": false
      },
      "risk": "high: changes a member's organization role/permissions; requires reverse ETL approval",
      "path_fields": [
        "org_name",
        "username"
      ]
    },
