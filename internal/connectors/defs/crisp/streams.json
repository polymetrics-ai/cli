{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "headers": {
      "X-Crisp-Tier": "{{ config.token_tier }}"
    },
    "auth": [
      {
        "mode": "basic",
        "username": "{{ secrets.identifier }}",
        "password": "{{ secrets.key }}"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/v1/website/{{ config.website_id }}/conversations/{{ config.page_number }}",
      "query": {
        "per_page": "20"
      }
    },
    "error_map": [
      {
        "status": 401,
        "hint": "Crisp identifier or key is missing or invalid; update the credential through environment-backed secret input."
      },
      {
        "status": 403,
        "hint": "Crisp token tier or scopes do not permit this website conversation request."
      },
      {
        "status": 404,
        "hint": "Crisp website, conversation session, message, or related identifier was not found."
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "Crisp rate limit exceeded; retry after the provider's backoff period."
      }
    ]
  },
  "streams": [
    {
      "name": "list_conversations",
      "path": "/v1/website/{{ config.website_id }}/conversations/{{ config.page_number }}",
      "query": {
        "per_page": "50"
      },
      "records": {
        "path": "data"
      },
      "pagination": {
        "type": "none"
      },
      "projection": "passthrough",
      "schema": "schemas/conversation_record.json"
    },
    {
      "name": "suggested_conversation_segments",
      "path": "/v1/website/{{ config.website_id }}/conversations/suggest/segments/{{ config.page_number }}",
      "records": {
        "path": "data"
      },
      "pagination": {
        "type": "none"
      },
      "projection": "passthrough",
      "schema": "schemas/conversation_record.json"
    },
    {
      "name": "suggested_conversation_data",
      "path": "/v1/website/{{ config.website_id }}/conversations/suggest/data/{{ config.page_number }}",
      "records": {
        "path": "data"
      },
      "pagination": {
        "type": "none"
      },
      "projection": "passthrough",
      "schema": "schemas/conversation_record.json"
    },
    {
      "name": "spam_conversations",
      "path": "/v1/website/{{ config.website_id }}/conversations/spams/{{ config.page_number }}",
      "records": {
        "path": "data"
      },
      "pagination": {
        "type": "none"
      },
      "projection": "passthrough",
      "schema": "schemas/conversation_record.json"
    },
    {
      "name": "spam_conversation_content",
      "path": "/v1/website/{{ config.website_id }}/conversations/spam/{{ config.spam_id }}/content",
      "records": {
        "path": "data",
        "single_object": true
      },
      "pagination": {
        "type": "none"
      },
      "projection": "passthrough",
      "schema": "schemas/conversation_record.json"
    },
    {
      "name": "conversation",
      "path": "/v1/website/{{ config.website_id }}/conversation/{{ config.session_id }}",
      "records": {
        "path": "data",
        "single_object": true
      },
      "pagination": {
        "type": "none"
      },
      "projection": "passthrough",
      "schema": "schemas/conversation_record.json"
    },
    {
      "name": "conversation_messages",
      "path": "/v1/website/{{ config.website_id }}/conversation/{{ config.session_id }}/messages",
      "records": {
        "path": "data"
      },
      "pagination": {
        "type": "none"
      },
      "projection": "passthrough",
      "schema": "schemas/conversation_record.json"
    },
    {
      "name": "conversation_message",
      "path": "/v1/website/{{ config.website_id }}/conversation/{{ config.session_id }}/message/{{ config.fingerprint }}",
      "records": {
        "path": "data",
        "single_object": true
      },
