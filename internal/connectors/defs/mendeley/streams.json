{
  "base": {
    "auth": [
      {
        "client_id": "{{ secrets.client_id }}",
        "client_secret": "{{ secrets.client_secret }}",
        "mode": "oauth2_refresh_token",
        "refresh_token": "{{ secrets.client_refresh_token }}",
        "token_url": "https://api.mendeley.com/oauth/token"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/documents",
      "query": {
        "limit": "1"
      }
    },
    "error_map": [],
    "pagination": {
      "page_size": 100,
      "size_param": "limit",
      "type": "link_header"
    },
    "url": "https://api.mendeley.com",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "headers": {
        "Accept": "application/vnd.mendeley-document.1+json"
      },
      "incremental": {
        "client_filtered": true,
        "cursor_field": "last_modified",
        "request_param": "modified_since"
      },
      "method": "GET",
      "name": "documents",
      "path": "/documents",
      "query": {
        "order": "asc"
      },
      "records": {
        "path": ""
      },
      "schema": "schemas/documents.json"
    },
    {
      "headers": {
        "Accept": "application/vnd.mendeley-folder.1+json"
      },
      "incremental": {
        "client_filtered": true,
        "cursor_field": "modified",
        "request_param": "modified_since"
      },
      "method": "GET",
      "name": "folders",
      "path": "/folders",
      "query": {
        "order": "asc"
      },
      "records": {
        "path": ""
      },
      "schema": "schemas/folders.json"
    },
    {
      "headers": {
        "Accept": "application/vnd.mendeley-group.1+json"
      },
      "method": "GET",
      "name": "groups",
      "path": "/groups",
      "query": {
        "order": "asc"
      },
      "records": {
        "path": ""
      },
      "schema": "schemas/groups.json"
    },
    {
      "headers": {
        "Accept": "application/vnd.mendeley-annotation.1+json"
      },
      "incremental": {
        "client_filtered": true,
        "cursor_field": "last_modified",
        "request_param": "modified_since"
      },
      "method": "GET",
      "name": "annotations",
      "path": "/annotations",
      "query": {
        "order": "asc"
      },
      "records": {
        "path": ""
      },
      "schema": "schemas/annotations.json"
    }
  ]
}
