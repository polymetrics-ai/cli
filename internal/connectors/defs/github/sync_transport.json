{
  "destination_transport": {
    "acknowledgement": "durable_warehouse",
    "apply_strategies": [
      {
        "action": "set_issue_labels",
        "mode": "full_overwrite",
        "strategy": "replace"
      },
      {
        "action": "add_issue_labels",
        "mode": "full_append",
        "strategy": "append"
      },
      {
        "action": "set_issue_labels",
        "mode": "incremental_upsert",
        "strategy": "merge"
      }
    ],
    "delivery": {
      "deletes": "not_available",
      "idempotency": "keyed",
      "ordering": "source_ordered"
    },
    "eligible_actions": [
      "add_issue_labels",
      "set_issue_labels"
    ],
    "executor": {
      "family": "declarative_api",
      "id": "issue_label_destination"
    },
    "modes": [
      "full_overwrite",
      "full_append",
      "incremental_upsert"
    ],
    "source_bindings": [
      {
        "eligible_streams": [
          "issues"
        ],
        "executor": {
          "family": "declarative_api",
          "id": "declarative_stream_source"
        },
        "record_mapping": {
          "config_key": "transport_source_issue_number",
          "kind": "config_match",
          "record_field": "number"
        }
      },
      {
        "eligible_streams": [
          "*"
        ],
        "executor": {
          "family": "native_database",
          "id": "postgres_polling_watermark"
        },
        "record_mapping": {
          "inputs": [
            {
              "field": "target_issue",
              "input": "target_issue"
            },
            {
              "field": "label",
              "input": "label"
            }
          ],
          "kind": "input_fields"
        }
      }
    ]
  },
  "schema_version": 1,
  "source_transport": {
    "delivery": {
      "deletes": "tombstone",
      "idempotency": "keyed",
      "ordering": "source_ordered"
    },
    "eligible_streams": [
      "repository",
      "issues",
      "pull_requests",
      "branches",
      "commits",
      "tags",
      "releases",
      "labels",
      "milestones",
      "issue_comments",
      "pull_request_review_comments",
      "collaborators",
      "contributors",
      "stargazers",
      "subscribers",
      "workflows",
      "workflow_runs",
      "workflow_artifacts",
      "deployments",
      "commit_comments",
      "deploy_keys",
      "webhooks",
      "environments",
      "forks",
      "invitations",
      "issue_events",
      "code_scanning_alerts",
      "dependabot_alerts",
      "secret_scanning_alerts",
      "security_advisories",
      "repo_rulesets",
      "autolinks",
      "languages",
      "projects",
      "project_items",
      "discussions",
      "discussion"
    ],
    "executor": {
      "family": "declarative_api",
      "id": "declarative_stream_source"
    },
    "modes": [
      "full_overwrite",
      "full_append",
      "incremental_upsert",
      "incremental_dedupe",
      "incremental_dedupe_history"
    ]
  }
