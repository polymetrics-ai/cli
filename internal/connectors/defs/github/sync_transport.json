{
  "schema_version": 1,
  "source_transport": {
    "executor": {
      "family": "declarative_api",
      "id": "declarative_stream_source"
    },
    "eligible_streams": [
      "repository",
      "issues",
      "pull_requests",
      "branches",
      "commits",
      "tags",
      "releases",
      "labels",
      "milestones",
      "issue_comments",
      "pull_request_review_comments",
      "collaborators",
      "contributors",
      "stargazers",
      "subscribers",
      "workflows",
      "workflow_runs",
      "workflow_artifacts",
      "deployments",
      "commit_comments",
      "deploy_keys",
      "webhooks",
      "environments",
      "forks",
      "invitations",
      "issue_events",
      "code_scanning_alerts",
      "dependabot_alerts",
      "secret_scanning_alerts",
      "security_advisories",
      "repo_rulesets",
      "autolinks",
      "languages",
      "projects",
      "project_items",
      "discussions",
      "discussion"
    ],
    "modes": ["full_overwrite", "full_append", "incremental_upsert", "incremental_dedupe", "incremental_dedupe_history"],
    "delivery": {
      "idempotency": "keyed",
      "ordering": "source_ordered",
      "deletes": "tombstone"
    },
    "conformance": {
      "suite": "declarative_stream_transport",
      "run_id": "all_executable_streams_v1"
    }
  },
  "destination_transport": {
    "executor": {
      "family": "declarative_api",
      "id": "issue_label_destination"
    },
    "eligible_actions": ["add_issue_labels", "set_issue_labels"],
    "modes": ["full_overwrite", "full_append", "incremental_upsert"],
    "delivery": {
      "idempotency": "keyed",
      "ordering": "source_ordered",
      "deletes": "not_available"
    },
    "conformance": {
      "suite": "closed_transport_demo",
      "run_id": "accepted_issue_label_destination"
    },
    "acknowledgement": "durable_warehouse",
    "apply_strategies": [
      {"mode": "full_overwrite", "strategy": "replace", "action": "set_issue_labels"},
      {"mode": "full_append", "strategy": "append", "action": "add_issue_labels"},
      {"mode": "incremental_upsert", "strategy": "merge", "action": "set_issue_labels"}
    ],
    "source_bindings": [
      {
        "executor": {
          "family": "declarative_api",
          "id": "declarative_stream_source"
        },
        "eligible_streams": ["issues"],
        "record_mapping": {
          "kind": "config_match",
          "config_key": "transport_source_issue_number",
          "record_field": "number"
        }
      },
      {
        "executor": {
          "family": "native_database",
          "id": "postgres_polling_watermark"
        },
        "eligible_streams": ["*"],
        "record_mapping": {
          "kind": "input_fields",
          "inputs": [
            {"input": "target_issue", "field": "target_issue"},
            {"input": "label", "field": "label"}
          ]
        }
      }
    ]
  }
}
