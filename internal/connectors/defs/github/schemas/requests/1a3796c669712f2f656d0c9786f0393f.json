{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "image_definition_id": {
      "type": "integer"
    },
    "org": {
      "maxLength": 8192,
      "type": "string"
    },
    "version": {
      "maxLength": 8192,
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    }
  },
  "required": [
    "image_definition_id",
    "org",
    "version"
  ],
  "type": "object"
}
