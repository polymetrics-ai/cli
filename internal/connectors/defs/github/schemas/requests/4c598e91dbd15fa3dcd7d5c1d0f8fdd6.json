{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "allows_public_repositories": {
      "type": "boolean"
    },
    "name": {
      "maxLength": 8192,
      "type": "string"
    },
    "network_configuration_id": {
      "maxLength": 8192,
      "type": "string"
    },
    "org": {
      "maxLength": 8192,
      "type": "string"
    },
    "restricted_to_workflows": {
      "type": "boolean"
    },
    "runners": {
      "items": {
        "type": "integer"
      },
      "maxItems": 256,
      "type": "array"
    },
    "selected_repository_ids": {
      "items": {
        "type": "integer"
      },
      "maxItems": 256,
      "type": "array"
    },
    "selected_workflows": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "visibility": {
      "enum": [
        "selected",
        "all",
        "private"
      ],
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "name",
    "org"
  ],
  "type": "object"
}
