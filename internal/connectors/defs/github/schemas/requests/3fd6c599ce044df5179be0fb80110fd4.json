{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "role": {
      "enum": [
        "member",
        "maintainer"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "team_id": {
      "type": "integer"
    },
    "username": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "team_id",
    "username"
  ],
  "type": "object"
}
