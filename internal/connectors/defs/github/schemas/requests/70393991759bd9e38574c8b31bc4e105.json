{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "configuration_id": {
      "type": "integer"
    },
    "org": {
      "maxLength": 8192,
      "type": "string"
    },
    "scope": {
      "enum": [
        "all",
        "all_without_configurations",
        "public",
        "private_or_internal",
        "selected"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "selected_repository_ids": {
      "items": {
        "type": "integer"
      },
      "maxItems": 256,
      "type": "array"
    }
  },
  "required": [
    "configuration_id",
    "org",
    "scope"
  ],
  "type": "object"
}
