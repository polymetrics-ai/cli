{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "issue_number": {
      "type": "integer"
    },
    "lock_reason": {
      "enum": [
        "off-topic",
        "too heated",
        "resolved",
        "spam"
      ],
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "issue_number"
  ],
  "type": "object"
}
