{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "checkout_uri": {
      "maxLength": 8192,
      "type": "string"
    },
    "commit_sha": {
      "maxLength": 64,
      "minLength": 40,
      "pattern": "^([0-9a-fA-F]{40}(?:[0-9a-fA-F]{24})?)$",
      "type": "string"
    },
    "ref": {
      "maxLength": 8192,
      "pattern": "^refs/(heads|tags|pull)/.*$",
      "type": "string"
    },
    "sarif": {
      "maxLength": 8192,
      "type": "string"
    },
    "started_at": {
      "maxLength": 8192,
      "type": "string"
    },
    "tool_name": {
      "maxLength": 8192,
      "type": "string"
    },
    "validate": {
      "type": "boolean"
    }
  },
  "required": [
    "commit_sha",
    "ref",
    "sarif"
  ],
  "type": "object"
}
