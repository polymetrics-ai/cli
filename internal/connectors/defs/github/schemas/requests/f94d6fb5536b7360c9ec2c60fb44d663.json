{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "encrypted_value": {
      "maxLength": 8192,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=|[A-Za-z0-9+/]{4})$",
      "type": "string"
    },
    "environment_name": {
      "maxLength": 8192,
      "type": "string"
    },
    "key_id": {
      "maxLength": 8192,
      "type": "string"
    },
    "secret_name": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "encrypted_value",
    "environment_name",
    "key_id",
    "secret_name"
  ],
  "type": "object"
}
