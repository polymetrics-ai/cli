{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "package_name": {
      "maxLength": 8192,
      "type": "string"
    },
    "package_type": {
      "enum": [
        "npm",
        "maven",
        "rubygems",
        "docker",
        "nuget",
        "container"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "username": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "package_name",
    "package_type",
    "username"
  ],
  "type": "object"
}
