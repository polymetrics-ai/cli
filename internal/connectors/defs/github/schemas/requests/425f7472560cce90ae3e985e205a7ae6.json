{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "approve",
        "deny"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "org": {
      "maxLength": 8192,
      "type": "string"
    },
    "pat_request_ids": {
      "items": {
        "type": "integer"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "reason": {
      "maxLength": 1024,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "action",
    "org"
  ],
  "type": "object"
}
