{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "compute_service": {
      "enum": [
        "none",
        "actions"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "failover_network_enabled": {
      "type": "boolean"
    },
    "failover_network_settings_ids": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 1,
      "minItems": 0,
      "type": "array"
    },
    "name": {
      "maxLength": 8192,
      "type": "string"
    },
    "network_configuration_id": {
      "maxLength": 8192,
      "type": "string"
    },
    "network_settings_ids": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 1,
      "minItems": 0,
      "type": "array"
    },
    "org": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "network_configuration_id",
    "org"
  ],
  "type": "object"
}
