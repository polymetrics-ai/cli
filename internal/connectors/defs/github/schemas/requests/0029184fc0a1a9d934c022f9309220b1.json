{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "agent_assignment": {
      "additionalProperties": false,
      "properties": {
        "custom_agent": {
          "maxLength": 8192,
          "type": "string"
        },
        "custom_instructions": {
          "maxLength": 8192,
          "type": "string"
        },
        "model": {
          "maxLength": 8192,
          "type": "string"
        }
      },
      "type": "object"
    },
    "alert_number": {
      "type": "integer"
    },
    "assignees": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "dismissed_comment": {
      "maxLength": 280,
      "type": "string"
    },
    "dismissed_reason": {
      "enum": [
        "fix_started",
        "inaccurate",
        "no_bandwidth",
        "not_used",
        "tolerable_risk"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "state": {
      "enum": [
        "dismissed",
        "open"
      ],
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "alert_number"
  ],
  "type": "object"
}
