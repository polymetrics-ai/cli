{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "description": {
      "maxLength": 8192,
      "type": "string"
    },
    "due_on": {
      "maxLength": 8192,
      "type": "string"
    },
    "state": {
      "enum": [
        "open",
        "closed"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "title": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "type": "object"
}
