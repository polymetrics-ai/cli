{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "expiry": {
      "enum": [
        "one_day",
        "three_days",
        "one_week",
        "one_month",
        "six_months"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "limit": {
      "enum": [
        "existing_users",
        "contributors_only",
        "collaborators_only"
      ],
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "limit"
  ],
  "type": "object"
}
