{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "cluster": {
      "maxLength": 128,
      "type": "string"
    },
    "deployment_name": {
      "maxLength": 256,
      "type": "string"
    },
    "digest": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "github_repository": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9.\\-_]+$",
      "type": "string"
    },
    "logical_environment": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "org": {
      "maxLength": 8192,
      "type": "string"
    },
    "physical_environment": {
      "maxLength": 128,
      "type": "string"
    },
    "return_records": {
      "type": "boolean"
    },
    "runtime_risks": {
      "items": {
        "enum": [
          "critical-resource",
          "internet-exposed",
          "lateral-movement",
          "sensitive-data"
        ],
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 4,
      "type": "array"
    },
    "status": {
      "enum": [
        "deployed",
        "decommissioned"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "tags": {
      "additionalProperties": true,
      "maxProperties": 5,
      "type": "object"
    },
    "version": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "deployment_name",
    "digest",
    "logical_environment",
    "name",
    "org",
    "status"
  ],
  "type": "object"
}
