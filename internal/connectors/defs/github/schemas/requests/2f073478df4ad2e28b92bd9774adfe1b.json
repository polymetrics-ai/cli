    "contact_link": {
      "maxLength": 8192,
      "type": "string"
    },
    "description": {
      "maxLength": 8192,
      "type": "string"
    },
    "ends_at": {
      "maxLength": 8192,
      "type": "string"
    },
    "generate_issues": {
      "type": "boolean"
