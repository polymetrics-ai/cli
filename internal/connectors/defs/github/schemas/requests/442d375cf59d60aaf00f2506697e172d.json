    "bypass_pull_request_allowances": {
      "additionalProperties": false,
      "properties": {
        "apps": {
          "items": {
            "maxLength": 8192,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "teams": {
          "items": {
            "maxLength": 8192,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "users": {
          "items": {
            "maxLength": 8192,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        }
      },
      "type": "object"
    },
    "dismiss_stale_reviews": {
      "type": "boolean"
    },
    "dismissal_restrictions": {
      "additionalProperties": false,
      "properties": {
        "apps": {
          "items": {
            "maxLength": 8192,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "teams": {
          "items": {
            "maxLength": 8192,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "users": {
          "items": {
            "maxLength": 8192,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        }
      },
      "type": "object"
