{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "approve",
        "deny"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "org": {
      "maxLength": 8192,
      "type": "string"
    },
    "pat_request_id": {
      "type": "integer"
    },
    "reason": {
      "maxLength": 1024,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "action",
    "org",
    "pat_request_id"
  ],
  "type": "object"
}
