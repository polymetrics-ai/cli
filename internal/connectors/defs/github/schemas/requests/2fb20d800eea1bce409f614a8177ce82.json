{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "cluster": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9._-]+$",
      "type": "string"
    },
    "deployments": {
      "items": {},
      "maxItems": 1000,
      "type": "array"
    },
    "logical_environment": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "org": {
      "maxLength": 8192,
      "type": "string"
    },
    "partial_success": {
      "type": "boolean"
    },
    "physical_environment": {
      "maxLength": 128,
      "type": "string"
    },
    "return_records": {
      "type": "boolean"
    }
  },
  "required": [
    "cluster",
    "deployments",
    "logical_environment",
    "org"
  ],
  "type": "object"
}
