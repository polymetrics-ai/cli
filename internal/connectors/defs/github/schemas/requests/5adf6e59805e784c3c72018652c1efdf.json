{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "maxLength": 8192,
      "type": "string"
    },
    "api_host": {
      "maxLength": 8192,
      "type": "string"
    },
    "audience": {
      "maxLength": 8192,
      "type": "string"
    },
    "auth_type": {
      "enum": [
        "token",
        "username_password",
        "oidc_azure",
        "oidc_aws",
        "oidc_jfrog",
        "oidc_cloudsmith",
        "oidc_gcp"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "aws_region": {
      "maxLength": 8192,
      "type": "string"
    },
    "client_id": {
      "maxLength": 8192,
      "type": "string"
    },
    "domain": {
      "maxLength": 8192,
      "type": "string"
    },
    "domain_owner": {
      "maxLength": 8192,
      "type": "string"
    },
    "encrypted_value": {
      "maxLength": 8192,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=|[A-Za-z0-9+/]{4})$",
      "type": "string"
    },
    "identity_mapping_name": {
      "maxLength": 8192,
      "type": "string"
    },
    "jfrog_oidc_provider_name": {
      "maxLength": 8192,
      "type": "string"
    },
    "key_id": {
      "maxLength": 8192,
      "type": "string"
    },
    "namespace": {
      "maxLength": 8192,
      "type": "string"
    },
    "org": {
      "maxLength": 8192,
      "type": "string"
    },
    "registry_type": {
      "enum": [
        "maven_repository",
        "nuget_feed",
        "goproxy_server",
        "npm_registry",
        "rubygems_server",
        "cargo_registry",
        "composer_repository",
        "docker_registry",
        "git_source",
        "helm_registry",
        "hex_organization",
        "hex_repository",
        "pub_repository",
        "python_index",
        "terraform_registry"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "replaces_base": {
      "type": "boolean"
    },
    "role_name": {
      "maxLength": 8192,
      "type": "string"
    },
    "selected_repository_ids": {
      "items": {
        "type": "integer"
      },
      "maxItems": 256,
      "type": "array"
    },
    "service_account": {
      "maxLength": 8192,
      "type": "string"
    },
    "service_slug": {
      "maxLength": 8192,
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 8192,
      "type": "string"
    },
    "url": {
      "maxLength": 8192,
      "type": "string"
    },
    "username": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "visibility": {
      "enum": [
        "all",
        "private",
        "selected"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "workload_identity_provider": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "org",
    "registry_type",
    "url",
    "visibility"
  ],
  "type": "object"
}
