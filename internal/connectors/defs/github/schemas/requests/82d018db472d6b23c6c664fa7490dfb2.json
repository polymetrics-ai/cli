{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "org": {
      "maxLength": 8192,
      "type": "string"
    },
    "secret_name": {
      "maxLength": 8192,
      "type": "string"
    },
    "selected_repository_ids": {
      "items": {
        "type": "integer"
      },
      "maxItems": 256,
      "type": "array"
    }
  },
  "required": [
    "org",
    "secret_name",
    "selected_repository_ids"
  ],
  "type": "object"
}
