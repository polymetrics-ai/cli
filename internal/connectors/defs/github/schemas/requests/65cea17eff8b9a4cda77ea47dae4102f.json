{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "auto_inactive": {
      "type": "boolean"
    },
    "deployment_id": {
      "type": "integer"
    },
    "description": {
      "maxLength": 8192,
      "type": "string"
    },
    "environment": {
      "maxLength": 8192,
      "type": "string"
    },
    "environment_url": {
      "maxLength": 8192,
      "type": "string"
    },
    "log_url": {
      "maxLength": 8192,
      "type": "string"
    },
    "state": {
      "enum": [
        "error",
        "failure",
        "inactive",
        "in_progress",
        "queued",
        "pending",
        "success"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "target_url": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "deployment_id",
    "state"
  ],
  "type": "object"
}
