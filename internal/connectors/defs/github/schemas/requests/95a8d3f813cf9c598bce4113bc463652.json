{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "org": {
      "maxLength": 8192,
      "type": "string"
    },
    "selected_usernames": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 100,
      "type": "array"
    },
    "visibility": {
      "enum": [
        "disabled",
        "selected_members",
        "all_members",
        "all_members_and_outside_collaborators"
      ],
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "org",
    "visibility"
  ],
  "type": "object"
}
