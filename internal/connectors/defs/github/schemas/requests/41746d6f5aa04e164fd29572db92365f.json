{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "comment_id": {
      "type": "integer"
    },
    "content": {
      "enum": [
        "+1",
        "-1",
        "laugh",
        "confused",
        "heart",
        "hooray",
        "rocket",
        "eyes"
      ],
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "comment_id",
    "content"
  ],
  "type": "object"
}
