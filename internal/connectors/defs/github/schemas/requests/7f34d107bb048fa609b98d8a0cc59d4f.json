{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "key": {
      "maxLength": 8192,
      "pattern": "^ssh-(rsa|dss|ed25519) |^ecdsa-sha2-nistp(256|384|521) |^(sk-ssh-ed25519|sk-ecdsa-sha2-nistp256)@openssh.com ",
      "type": "string"
    },
    "title": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "key"
  ],
  "type": "object"
}
