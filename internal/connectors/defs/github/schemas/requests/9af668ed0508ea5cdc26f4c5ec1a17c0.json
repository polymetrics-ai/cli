{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "campaign_number": {
      "type": "integer"
    },
    "contact_link": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "ends_at": {
      "maxLength": 8192,
      "type": "string"
    },
    "managers": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 10,
      "type": "array"
    },
    "name": {
      "maxLength": 50,
      "minLength": 1,
      "type": "string"
    },
    "org": {
      "maxLength": 8192,
      "type": "string"
    },
    "state": {
      "enum": [
        "open",
        "closed"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "team_managers": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 10,
      "type": "array"
    }
  },
  "required": [
    "campaign_number",
    "org"
  ],
  "type": "object"
}
