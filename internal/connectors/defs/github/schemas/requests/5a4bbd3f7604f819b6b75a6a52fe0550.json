{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "enable_static_ip": {
      "type": "boolean"
    },
    "image": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 8192,
          "type": "string"
        },
        "source": {
          "enum": [
            "github",
            "partner",
            "custom"
          ],
          "maxLength": 8192,
          "type": "string"
        },
        "version": {
          "maxLength": 8192,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "image_gen": {
      "type": "boolean"
    },
    "maximum_runners": {
      "type": "integer"
    },
    "name": {
      "maxLength": 8192,
      "type": "string"
    },
    "org": {
      "maxLength": 8192,
      "type": "string"
    },
    "runner_group_id": {
      "type": "integer"
    },
    "size": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "image",
    "name",
    "org",
    "runner_group_id",
    "size"
  ],
  "type": "object"
}
