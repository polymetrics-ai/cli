{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "description": {
      "maxLength": 8192,
      "type": "string"
    },
    "include_all_branches": {
      "type": "boolean"
    },
    "name": {
      "maxLength": 8192,
      "type": "string"
    },
    "owner": {
      "maxLength": 8192,
      "type": "string"
    },
    "private": {
      "type": "boolean"
    },
    "template_owner": {
      "maxLength": 8192,
      "type": "string"
    },
    "template_repo": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "name",
    "template_owner",
    "template_repo"
  ],
  "type": "object"
}
