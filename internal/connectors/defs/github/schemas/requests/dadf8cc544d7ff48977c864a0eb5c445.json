{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer"
    },
    "number": {
      "type": "integer"
    },
    "org": {
      "maxLength": 8192,
      "type": "string"
    },
    "owner": {
      "maxLength": 8192,
      "type": "string"
    },
    "project_number": {
      "type": "integer"
    },
    "repo": {
      "maxLength": 8192,
      "type": "string"
    },
    "type": {
      "enum": [
        "Issue",
        "PullRequest"
      ],
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "number",
    "org",
    "owner",
    "project_number",
    "repo",
    "type"
  ],
  "type": "object"
}
