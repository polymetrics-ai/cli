{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "placeholder_id": {
      "maxLength": 8192,
      "type": "string"
    },
    "reason": {
      "enum": [
        "false_positive",
        "used_in_tests",
