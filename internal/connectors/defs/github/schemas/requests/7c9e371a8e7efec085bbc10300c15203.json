{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "description": {
      "maxLength": 8192,
      "type": "string"
    },
    "name": {
      "maxLength": 8192,
      "type": "string"
    },
    "notification_setting": {
      "enum": [
        "notifications_enabled",
        "notifications_disabled"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "org": {
      "maxLength": 8192,
      "type": "string"
    },
    "parent_team_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "parent_team_slug": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "permission": {
      "enum": [
        "pull",
        "push",
        "admin"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "privacy": {
      "enum": [
        "secret",
        "closed"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "team_slug": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "org",
    "team_slug"
  ],
  "type": "object"
}
