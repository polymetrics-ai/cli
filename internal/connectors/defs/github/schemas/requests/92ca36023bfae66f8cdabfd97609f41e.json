{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "enterprise": {
      "maxLength": 8192,
      "type": "string"
    },
    "enterprise-team": {
      "maxLength": 8192,
      "type": "string"
    },
    "usernames": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    }
  },
  "required": [
    "enterprise",
    "enterprise-team",
    "usernames"
  ],
  "type": "object"
}
