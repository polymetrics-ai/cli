{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "active": {
      "type": "boolean"
    },
    "config": {
      "additionalProperties": true,
      "maxProperties": 256,
      "type": "object"
    },
    "events": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "name": {
      "maxLength": 8192,
      "type": "string"
    },
    "org": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "config",
    "name",
    "org"
  ],
  "type": "object"
}
