{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "assignees": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "base": {
      "maxLength": 8192,
      "type": "string"
    },
    "body": {
      "maxLength": 8192,
      "type": "string"
    },
    "labels": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "maintainer_can_modify": {
      "type": "boolean"
    },
    "milestone": {
      "type": "integer"
    },
    "pull_number": {
      "type": "integer"
    },
    "reviewers": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "state": {
      "enum": [
        "open",
        "closed"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "team_reviewers": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "title": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "pull_number"
  ],
  "type": "object"
}
