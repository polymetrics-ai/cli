{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "name": {
      "maxLength": 8192,
      "type": "string"
    },
    "org": {
      "maxLength": 8192,
      "type": "string"
    },
    "selected_repository_ids": {
      "items": {
        "type": "integer"
      },
      "maxItems": 256,
      "type": "array"
    },
    "value": {
      "maxLength": 8192,
      "type": "string"
    },
    "visibility": {
      "enum": [
        "all",
        "private",
        "selected"
      ],
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "name",
    "org"
  ],
  "type": "object"
}
