{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "body": {
      "maxLength": 8192,
      "type": "string"
    },
    "commit_sha": {
      "maxLength": 8192,
      "type": "string"
    },
    "line": {
      "type": "integer"
    },
    "path": {
      "maxLength": 8192,
      "type": "string"
    },
    "position": {
      "type": "integer"
    }
  },
  "required": [
    "body",
    "commit_sha"
  ],
  "type": "object"
}
