{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "enabled_repositories": {
      "enum": [
        "all",
        "selected",
        "none"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "org": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "enabled_repositories",
    "org"
  ],
  "type": "object"
}
