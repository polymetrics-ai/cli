{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "codespace_name": {
      "maxLength": 8192,
      "type": "string"
    },
    "display_name": {
      "maxLength": 8192,
      "type": "string"
    },
    "machine": {
      "maxLength": 8192,
      "type": "string"
    },
    "recent_folders": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    }
  },
  "required": [
    "codespace_name"
  ],
  "type": "object"
}
