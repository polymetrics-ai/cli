{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "data_type": {
      "enum": [
        "text",
        "date",
        "single_select",
        "multi_select",
        "number"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "description": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "maxLength": 8192,
      "type": "string"
    },
    "options": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "color": {
            "enum": [
              "gray",
              "blue",
              "green",
              "yellow",
              "orange",
              "red",
              "pink",
              "purple"
            ],
            "maxLength": 8192,
            "type": "string"
          },
          "description": {
            "maxLength": 8192,
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "maxLength": 8192,
            "type": "string"
          },
          "priority": {
            "type": "integer"
          }
        },
        "required": [
          "name",
          "color",
          "priority"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": [
        "array",
        "null"
      ]
    },
    "org": {
      "maxLength": 8192,
      "type": "string"
    },
    "visibility": {
      "enum": [
        "organization_members_only",
        "all"
      ],
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "data_type",
    "name",
    "org"
  ],
  "type": "object"
}
