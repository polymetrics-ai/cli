{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "encrypted_value": {
      "maxLength": 8192,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=|[A-Za-z0-9+/]{4})$",
      "type": "string"
    },
    "key_id": {
      "maxLength": 8192,
      "type": "string"
    },
    "org": {
      "maxLength": 8192,
      "type": "string"
    },
    "secret_name": {
      "maxLength": 8192,
      "type": "string"
    },
    "selected_repository_ids": {
      "items": {},
      "maxItems": 256,
      "type": "array"
    },
    "visibility": {
      "enum": [
        "all",
        "private",
        "selected"
      ],
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "org",
    "secret_name",
    "visibility"
  ],
  "type": "object"
}
