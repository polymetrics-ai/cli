{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "active": {
      "type": "boolean"
    },
    "config_url": {
      "description": "Flattened from record.config.url (webhook target URL); the config object also carries content_type/secret/insecure_ssl, not projected here since secret is write-only on GitHub's side.",
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "deliveries_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "events": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "ping_url": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "test_url": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "url": {
      "type": "string"
    }
  },
  "required": [
    "id"
  ],
  "title": "webhooks",
  "type": "object",
  "x-cursor-field": "updated_at",
  "x-primary-key": [
    "id"
  ]
}
