{
  "schema_version": 1,
  "state": "declared",
  "policies": [
    {
      "id": "authenticated-user",
      "source": {
        "url": "https://docs.github.com/en/rest/using-the-rest-api/rate-limits-for-the-rest-api",
        "retrieved_at": "2026-08-08"
      },
      "selector": {
        "auth_types": ["token", "oauth"],
        "exclude_endpoints": [
          {"method": "POST", "path": "/graphql"}
        ]
      },
      "scope": {
        "subject_kind": "account",
        "subject_config": "rate_limit_account"
      },
      "budgets": [
        {
          "model": "fixed_window",
          "dimension": "sustained",
          "unit": "requests",
          "limit": 5000,
          "window_seconds": 3600
        },
        {
          "model": "sliding_window",
          "dimension": "burst",
          "unit": "points",
          "limit": 900,
          "window_seconds": 60,
          "cost": {
            "default_cost": 5
          }
        }
      ]
    },
    {
      "id": "app-installation",
