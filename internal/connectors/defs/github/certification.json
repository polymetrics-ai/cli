      {"name": "issue_comments", "ledger_name": "github_repository_issue_comments", "tag_name": "issue-comment", "actions": ["create_issue", "comment_issue", "update_issue_comment", "delete_issue_comment", "close_issue"]},
      {"name": "issue_lock", "ledger_name": "github_repository_issue_lock", "tag_name": "issue-lock", "actions": ["create_issue", "lock_issue", "unlock_issue", "close_issue"]},
      {"name": "issue_labels", "ledger_name": "github_repository_issue_labels", "tag_name": "issue-labels", "actions": ["create_issue", "set_issue_labels", "add_issue_labels", "remove_issue_label", "close_issue"]},
      {"name": "label_lifecycle", "ledger_name": "github_repository_label_lifecycle", "tag_name": "label", "actions": ["create_label", "update_label", "delete_label"]},
      {"name": "milestone", "ledger_name": "github_repository_milestone", "tag_name": "milestone", "actions": ["create_milestone", "update_milestone", "delete_milestone"]},
      {"name": "release", "ledger_name": "github_repository_release", "tag_name": "release", "actions": ["create_release", "update_release", "delete_release", "delete_ref"]},
      {"name": "commit_comment", "ledger_name": "github_repository_commit_comment", "tag_name": "commit-comment", "actions": ["create_commit_comment", "update_commit_comment", "delete_commit_comment"]},
      {"name": "ref", "ledger_name": "github_repository_ref", "tag_name": "ref", "actions": ["create_ref", "update_ref", "delete_ref"]},
      {"name": "topics", "ledger_name": "github_repository_topics", "tag_name": "topics", "actions": ["replace_repo_topics"]}
    ],
    "blocked_actions": [
      {
        "name": "commit_comment_item_read",
        "actions": ["create_commit_comment", "update_commit_comment", "delete_commit_comment"],
        "reason": "GitHub direct read GET /repos/{owner}/{repo}/comments/{comment_id} is blocked: the disposable fine-grained PAT was refused with \"Resource not accessible by personal access token\". GitHub's picker names the required permission \"Metadata\" repository permissions (read); do not count the mutation as certified until that item read succeeds."
      }
    ],
    "tag_prefix": "pm-cert-github-",
    "tag_subject_prefix": "github"
  }
