{
  "schema_version": 1,
  "source": {
    "default_stream": "issues",
    "source_credential_defaults": {
      "base_url": "https://api.github.com"
    },
    "required_credential_config": {
      "tier": "certification"
    },
    "live_unavailable": [
      {
        "kind": "Error",
        "contains": [
          "http 403",
          "http 404",
          "status 403",
          "status 404",
          "has not been granted the required scopes",
          "requires one of the following scopes",
          "interpolate: unresolved key"
        ]
      }
    ]
  },
  "direct_read_candidates": [
    {
      "stage_name": "direct_read_sweep_repo_read_file",
      "command": "repo read-file",
      "args": [
        { "connector": true },
        { "literal": "repo" },
        { "literal": "read-file" },
        { "literal": "--credential" },
        { "source_credential": true },
        { "literal": "--path" },
        { "config_key": "direct_read_path", "default": "README.md" },
        { "literal": "--ref", "when_config_key": "direct_read_ref" },
        { "config_key": "direct_read_ref", "omit_when_empty": true },
        { "literal": "--max-bytes" },
        { "literal": "1048576" },
        { "literal": "--json" }
      ]
    },
    {
      "stage_name": "direct_read_sweep_repo_read_dir",
      "command": "repo read-dir",
      "args": [
        { "connector": true },
        { "literal": "repo" },
        { "literal": "read-dir" },
        { "literal": "--credential" },
        { "source_credential": true },
        { "literal": "--path" },
        { "config_key": "direct_read_dir_path" },
        { "literal": "--ref", "when_config_key": "direct_read_ref" },
        { "config_key": "direct_read_ref", "omit_when_empty": true },
        { "literal": "--max-bytes" },
        { "literal": "1048576" },
        { "literal": "--json" }
      ]
    }
  ],
  "binary_candidates": [
    {
      "stage_name": "binary_download_sweep_release_download",
      "command": "release download",
      "args": [
        { "connector": true },
        { "literal": "release" },
        { "literal": "download" },
        { "literal": "--credential" },
        { "source_credential": true },
        { "literal": "--json" }
      ]
    }
  ],
  "write_pairings": [
    {
      "create": "create_label",
      "cleanup": "delete_label",
      "cleanup_kind": "delete",
      "id_field": "name",
      "verify_stream": "labels",
      "verify_field": "name",
      "overrides": {
        "color": "ededed"
      }
    },
    {
      "create": "create_issue",
      "cleanup": "close_issue",
      "cleanup_kind": "close",
      "id_field": "number",
      "verify_stream": "issues",
      "verify_field": "title"
    },
    {
      "create": "create_milestone",
      "cleanup": "delete_milestone",
      "cleanup_kind": "delete",
      "id_field": "number",
      "verify_stream": "milestones",
      "verify_field": "title"
    }
  ]
}
