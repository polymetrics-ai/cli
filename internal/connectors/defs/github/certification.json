{
  "schema_version": 1,
  "source": {
    "default_stream": "issues",
    "source_credential_defaults": {
      "base_url": "https://api.github.com"
    },
    "required_credential_config": {
      "tier": "certification"
    },
    "live_unavailable": [
      {
        "kind": "Error",
        "contains": [
          "http 403",
          "http 404",
          "status 403",
          "status 404",
          "has not been granted the required scopes",
          "requires one of the following scopes",
          "interpolate: unresolved key"
        ]
      }
    ]
  },
  "graphql": {
    "source_lock": "sources/github-operation-source-lock.json",
    "command_prefix": "graphql ",
    "schema_conformant_reason": "source-pinned typed GraphQL schema lock confirms the generated root field, argument contract, and return type; no provider-produced values were executed",
    "fixture_required_reason": "owned mutation fixture, plan, preview, approval, execution, independent read-back, and cleanup are required",
    "live_candidates": [
      {
        "stage_name": "graphql_query_viewer",
        "command": "graphql query viewer",
        "args": [
          { "connector": true },
          { "literal": "graphql" },
          { "literal": "query" },
          { "literal": "viewer" },
          { "literal": "--credential" },
          { "source_credential": true },
          { "literal": "--max-bytes" },
          { "literal": "1048576" },
          { "literal": "--json" }
        ],
        "output_assertions": [
          { "json_pointer": "/response/viewer/__typename", "equals": "User" }
        ]
      },
      {
        "stage_name": "graphql_query_rate_limit",
        "command": "graphql query rate-limit",
        "args": [
          { "connector": true },
          { "literal": "graphql" },
          { "literal": "query" },
          { "literal": "rate-limit" },
          { "literal": "--credential" },
          { "source_credential": true },
          { "literal": "--max-bytes" },
          { "literal": "1048576" },
          { "literal": "--json" }
        ],
        "output_assertions": [
          { "json_pointer": "/response/rateLimit/remaining", "value_type": "number" }
        ]
      }
    ]
  },
