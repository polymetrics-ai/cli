  "write_inventory": {
    "rules": [
      {
        "classification": "repository_fixture_pending",
        "path_prefixes": ["/repos/"],
        "reason": "the run-owned repository fixture addressed by this path has not been baseline-captured for this action"
      },
      {
        "classification": "gist_fixture_pending",
        "paths": ["/gists"],
        "path_prefixes": ["/gists/"],
        "reason": "the purpose-made private Gist fixture addressed by this path has not been created"
      },
      {
        "classification": "org_fixture_and_permission_pending",
        "path_prefixes": ["/orgs/", "/organizations/", "/teams/"],
        "reason": "the disposable organisation fixture addressed by this path has not been created; the certification credential also needs the declared organisation-administration permission"
      },
      {
        "classification": "app_or_oauth_pending",
        "path_prefixes": ["/app/", "/applications/", "/app-manifests/", "/installation/", "/agents/"],
        "reason": "the dedicated App or OAuth fixture required by this path has not been browser-provisioned"
      },
      {
        "classification": "enterprise_trial_and_token_pending",
        "path_prefixes": ["/enterprises/"],
        "reason": "the disposable Enterprise Cloud trial, enterprise slug, and certification credential permission required by this path are not ready"
      },
      {
        "classification": "primary_user_fixture_and_permission_pending",
        "paths": ["/user"],
        "path_prefixes": ["/user/"],
        "reason": "the disposable primary-user fixture addressed by this path has not been prepared with its required credential permission"
      },
      {
        "classification": "secondary_user_fixture_and_permission_pending",
        "path_prefixes": ["/users/"],
        "reason": "the second disposable-user fixture and credential addressed by this path have not been created"
      },
      {
        "classification": "notification_token_and_fixture_pending",
        "paths": ["/notifications"],
        "path_prefixes": ["/notifications/"],
        "reason": "the tagged disposable inbox fixture is absent and the certification token lacks the provider's notifications permission"
      },
      {
        "classification": "sacrificial_credential_pending",
        "paths": ["/credentials/revoke"],
        "reason": "a separate sacrificial disposable credential has not been supplied for the final revocation scenario"
      }
    ]
  },
