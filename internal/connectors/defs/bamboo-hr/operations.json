    {
      "id": "bamboo_hr.get_data_from_dataset_v2",
      "kind": "rest_read",
      "summary": "Get Data from Dataset (v2)",
      "description": "Queries the named dataset and returns the matching rows. The response is a JSON object with `data` (an array of row objects, each wrapping its values under a `fields` object whose keys match the requested field names), `links` (pagination navigation URLs; `prev` and/or `next`, omitted at boundaries), and `meta` (with `page`, `pageSize`, `totalPages`, `totalItems`).\n\nUse this for tabular reporting, custom field selection across many employees, and OData-style filtering against the full dataset fi",
      "source_url": "https://openapi.bamboohr.io/main/latest/docs/openapi/public-openapi.yaml",
      "risk": "medium",
      "approval": "none; bounded fixed-target JSON direct read",
      "output_policy": "json_redacted",
      "auth_scopes": [
        "report"
      ],
      "rest": {
        "method": "POST",
        "path": "/api/v2/datasets/{datasetName}/data",
        "content_type": "application/json",
        "max_bytes": 1048576,
        "body_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "filter": {
              "type": [
                "string",
                "number",
                "boolean",
                "object",
                "array",
                "null"
              ]
            },
            "orderBy": {
              "type": [
                "string",
                "number",
                "boolean",
                "object",
                "array",
                "null"
              ]
            },
            "page": {
              "type": "integer"
            },
            "pageSize": {
              "type": "integer"
            }
          },
          "required": [
            "fields"
          ]
        }
      }
    },
    {
      "id": "bamboo_hr.request_custom_report",
      "kind": "rest_read",
      "summary": "Request Custom Report",
      "description": "**Deprecated. Use Datasets > Get Data from Dataset instead.**\n\nGenerates an ad-hoc employee report based on a caller-specified list of fields and optional filters. Returns report data in the requested format (JSON, XML, CSV, XLS, or PDF). The report includes all employees regardless of status (both Active and Inactive), unlike the BambooHR UI which filters to Active employees by default.\n\nThe request body may be submitted as JSON or XML. To submit JSON, set `Content-Type: application/json` exact",
      "source_url": "https://openapi.bamboohr.io/main/latest/docs/openapi/public-openapi.yaml",
      "risk": "medium",
      "approval": "none; bounded fixed-target JSON direct read",
      "output_policy": "json_redacted",
      "auth_scopes": [
        "report"
      ],
      "rest": {
        "method": "POST",
        "path": "/api/v1/reports/custom",
        "content_type": "application/json",
        "max_bytes": 1048576,
        "body_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "filters": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "lastChanged": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "value": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "includeNull": {
                      "type": "string",
                      "enum": [
                        "yes",
                        "no"
                      ]
                    }
                  }
                },
                "employeeIds": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              }
            },
            "filterDuplicates": {
              "type": "string",
              "enum": [
                "yes",
                "no"
              ]
            }
          }
        }
      }
    }
  ]
