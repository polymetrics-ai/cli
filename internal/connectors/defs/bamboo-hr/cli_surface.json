      "intent": "direct_read",
      "availability": "implemented",
      "operation": "bamboo_hr.get_break_policy_suggestions",
      "api_surface": [
        {
          "method": "POST",
          "path": "/api/v1/time-tracking/break-policies/suggestions"
        }
      ],
      "output_policy": "json_redacted",
      "flags": [
        {
          "name": "prompt",
          "type": "string",
          "summary": "prompt body field",
          "maps_to": "body.prompt"
        }
      ],
      "examples": [
        "pm bamboo-hr break policy suggestions get --credential <name> --prompt \"meal break policy for CA employees\" --json"
      ],
      "notes": "Bounded fixed-target JSON POST direct read; schema-gated body flags only."
