{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "aws_key_id": {
      "description": "AWS access key ID.",
      "type": "string",
      "x-secret": true
    },
    "aws_secret_key": {
      "description": "AWS secret access key.",
      "type": "string",
      "x-secret": true
    },
    "aws_session_token": {
      "description": "Optional AWS session token.",
      "type": "string",
      "x-secret": true
    },
    "start_date": {
      "description": "Optional RFC3339 lower bound encoded as numeric Unix seconds in the CloudTrail StartTime JSON body.",
      "type": "string"
    }
  },
  "required": [
    "aws_key_id",
    "aws_secret_key"
  ],
  "title": "AWS CloudTrail Connection Specification",
  "type": "object",
  "x-reject-unknown-config": true
}
