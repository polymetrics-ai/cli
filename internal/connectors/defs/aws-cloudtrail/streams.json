{
  "base": {
    "url": "https://cloudtrail.{{ config.aws_region_name }}.amazonaws.com",
    "user_agent": "polymetrics-go-cli",
    "headers": {
      "Content-Type": "application/x-amz-json-1.1",
      "Accept": "application/x-amz-json-1.1"
    },
    "auth": [
      {
        "mode": "none"
      }
    ],
    "pagination": {
      "type": "none"
    },
    "check": {
      "method": "POST",
      "path": "/"
    },
    "error_map": [
      {
        "status": 400,
        "match_body": "InvalidClientTokenId",
        "class": "auth_failed",
        "hint": "AWS rejected the access key; rotate aws_key_id/aws_secret_key."
      },
      {
        "status": 400,
        "match_body": "AccessDenied",
        "class": "permission_denied",
        "hint": "credential lacks permission for the fixed CloudTrail action."
      },
      {
        "status": 403,
        "class": "permission_denied",
        "hint": "credential lacks permission for CloudTrail."
      }
    ]
  },
  "streams": [
    {
      "name": "describe_trails",
      "method": "POST",
      "path": "/",
      "records": {
        "path": "data"
      },
      "schema": "schemas/describe_trails.json",
      "projection": "passthrough"
    },
    {
      "name": "get_event_configuration",
      "method": "POST",
      "path": "/",
      "records": {
        "path": "data"
      },
      "schema": "schemas/get_event_configuration.json",
      "projection": "passthrough"
    },
    {
      "name": "list_channels",
      "method": "POST",
      "path": "/",
      "records": {
        "path": "data"
      },
      "schema": "schemas/list_channels.json",
      "projection": "passthrough"
    },
    {
      "name": "list_dashboards",
      "method": "POST",
      "path": "/",
      "records": {
        "path": "data"
      },
      "schema": "schemas/list_dashboards.json",
      "projection": "passthrough"
    },
    {
      "name": "list_event_data_stores",
      "method": "POST",
      "path": "/",
      "records": {
        "path": "data"
      },
      "schema": "schemas/list_event_data_stores.json",
      "projection": "passthrough"
    },
    {
      "name": "list_imports",
      "method": "POST",
      "path": "/",
      "records": {
        "path": "data"
      },
      "schema": "schemas/list_imports.json",
      "projection": "passthrough"
    },
    {
      "name": "list_public_keys",
      "method": "POST",
      "path": "/",
      "records": {
        "path": "data"
      },
      "schema": "schemas/list_public_keys.json",
      "projection": "passthrough"
    },
    {
      "name": "list_trails",
      "method": "POST",
      "path": "/",
      "records": {
        "path": "data"
      },
      "schema": "schemas/list_trails.json",
      "projection": "passthrough"
    }
  ]
}
