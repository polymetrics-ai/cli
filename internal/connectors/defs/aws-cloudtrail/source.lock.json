  "metadata": {
    "name": "aws-cloudtrail",
    "display_name": "AWS CloudTrail",
    "description": "Reads CloudTrail management events through fixed, declaration-bound LookupEvents requests signed with AWS Signature Version 4.",
    "integration_type": "api",
    "release_stage": "alpha",
    "capabilities": {
      "check": true,
      "read": true,
      "write": false,
      "query": false,
      "cdc": false,
      "dynamic_schema": false
    },
    "risk": {
      "read": "Bounded CloudTrail LookupEvents requests are signed by the declaration-bound generic SigV4 authenticator against the fixed CloudTrail us-east-1 origin.",
      "write": "unsupported",
      "approval": "none; read-only"
    },
    "docs_url": "https://docs.aws.amazon.com/awscloudtrail/latest/APIReference/API_LookupEvents.html"
  },
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "AWS CloudTrail Connection Specification",
    "type": "object",
    "x-reject-unknown-config": true,
    "required": [
      "aws_key_id",
      "aws_secret_key"
    ],
    "properties": {
      "aws_key_id": {
        "type": "string",
        "x-secret": true,
        "description": "AWS access key ID."
      },
      "aws_secret_key": {
        "type": "string",
        "x-secret": true,
        "description": "AWS secret access key."
      },
      "aws_session_token": {
        "type": "string",
        "x-secret": true,
        "description": "Optional AWS session token."
      },
      "start_date": {
        "type": "string",
        "description": "Optional RFC3339 StartTime lower bound sent in every CloudTrail LookupEvents request."
      }
    }
  },
  "http": {
    "url": "https://cloudtrail.us-east-1.amazonaws.com",
    "user_agent": "polymetrics-go-cli",
    "headers": {
