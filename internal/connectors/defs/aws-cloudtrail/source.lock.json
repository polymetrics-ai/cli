      "body_cursor_field": "NextToken",
      "page_size": 50,
      "max_pages": 100,
      "require_continuation_on_cap": true
    },
    "check": {
      "method": "POST",
      "path": "/",
      "body": {
        "MaxResults": 1
      }
    },
    "error_map": []
