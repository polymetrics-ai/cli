      "X-Amz-Target": "com.amazonaws.cloudtrail.v20131101.CloudTrail_20131101.LookupEvents"
    },
    "auth": [
      {
        "mode": "aws_sigv4",
        "access_key_id": "{{ secrets.aws_key_id }}",
        "secret_access_key": "{{ secrets.aws_secret_key }}",
        "session_token": "{{ secrets.aws_session_token }}",
        "aws_service": "cloudtrail",
        "aws_region": "us-east-1",
        "when": "{{ secrets.aws_session_token }}"
      },
