        "mode": "aws_sigv4",
        "access_key_id": "{{ secrets.aws_key_id }}",
        "secret_access_key": "{{ secrets.aws_secret_key }}",
        "aws_service": "cloudtrail",
        "aws_region": "us-east-1"
      }
    ],
