    {
      "id": "zoom.send_chatbot_message",
      "kind": "rest_write",
      "summary": "Send Chatbot messages",
      "description": "Approval-gated Zoom Chatbot message delivery through the documented client-credentials transport. Message, account, and JID data are redacted from previews, errors, and JSON output.",
      "source_url": "https://developers.zoom.us/docs/api/chatbot.md",
      "risk": "high",
      "approval": "plan-preview-confirm-execute",
      "output_policy": "json_redacted",
      "auth_scopes": [
        "imchat:bot"
      ],
      "mutation_class": "create",
      "batchable": false,
      "sensitive_policy": {
        "redact_fields": [
          "account_id",
          "content",
          "message_id",
          "reply_to",
          "robot_jid",
          "to_jid",
          "user_jid",
          "visible_to_user"
        ]
      },
      "rest": {
        "method": "POST",
        "path": "/v2/im/chat/messages",
        "base_url": "{{ config.base_url }}",
        "auth": [
          {
            "mode": "oauth2_client_credentials",
            "token_url": "{{ config.chatbot_token_url }}",
            "client_id": "{{ secrets.chatbot_client_id }}",
            "client_secret": "{{ secrets.chatbot_client_secret }}",
            "client_auth": "basic"
          }
        ],
        "content_type": "application/json",
        "body_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account_id",
            "content",
            "robot_jid",
            "to_jid",
            "user_jid"
          ],
          "properties": {
            "account_id": {
              "type": "string"
            },
            "content": {
              "type": "object",
              "additionalProperties": true
            },
            "robot_jid": {
              "type": "string"
            },
            "to_jid": {
              "type": "string"
            },
            "user_jid": {
              "type": "string"
            },
            "is_markdown_support": {
              "type": "boolean"
            },
            "reply_to": {
              "type": "string"
            },
            "visible_to_user": {
              "type": "string"
            }
          }
        },
        "max_bytes": 1048576
      }
    },
