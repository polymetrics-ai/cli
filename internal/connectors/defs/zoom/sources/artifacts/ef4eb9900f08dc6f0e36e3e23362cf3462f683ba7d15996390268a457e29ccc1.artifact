riable` is not supported here."},"callback_cancel_message":{"maxLength":500,"type":"string","description":"Voice cancellation notice. Honored when `is_callback_cancel_message=true`."},"callback_cancel_message_custom_audio":{"required":["custom_audio"],"type":"object","properties":{"custom_audio":{"maxItems":1,"minItems":1,"type":"array","description":"Single audio item. `standard` mode disallows multiple items and disallows `audio_variable`.","items":{"required":["audio_asset_id","order"],"type":"object","properties":{"order":{"maximum":1,"minimum":1,"type":"integer","description":"Always `1`."},"audio_asset_id":{"type":"string","description":"ID of the audio asset to play."}}}}},"description":"Pre-recorded audio prompt restricted to `standard` mode — supply exactly one audio item with `audio_asset_id`; dynamic `audio_variable` is not supported here."},"callback_cancel_sms_message":{"maxLength":500,"type":"string","description":"SMS cancellation notice body. Honored when `is_callback_cancel_sms=true`."},"offer_number_message":{"maxLength":500,"type":"string","description":"Prompt asking the consumer for an alternate callback phone number."},"offer_number_message_custom_audio":{"required":["custom_audio","custom_audio_type"],"type":"object","properties":{"custom_audio_type":{"type":"string","description":"Select custom audio type.\n\n-'standard' - Choose an audio file. The audio prompt must include all words, numbers, and keypress digits as part of the message. Variables cannot be used with this option.\n-'advanced' -  With this option, the audio message can be split into multiple reusable audio parts. Variables are needed. Set up the digits library before using numbers with this option.","example":"standard","default":"standard","enum":["advanced","standard"]},"custom_audio":{"maxItems":7,"minItems":1,"type":"array","description":"Custom-audio items array for fields whose allowed dynamic variables are `current_phone_number` (captured callback number) and `keypress` (active keypress).","items":{"required":["order"],"type":"object","properties":{"order":{"maximum":7,"minimum":1,"type":"integer","description":"The order to play audio.","example":1},"audio_asset_id":{"type":"string","description":"ID of the audio asset chosen to play message to consumer\n\n**Note** Provide either `audio_asset_id` or `audio_variable`, but not both.","example":"-6y2_bOWTBixtxmNywboJg"},"audio_variable":{"type":"string","description":"Dynamic variable for advanced mode only. Allowed values: `current_phone_number`, `keypress`.\n\n**Note** Provide either `audio_asset_id` or `audio_variable`, but not both.","example":"current_phone_number","default":"current_phone_number","enum":["current_phone_number","keypress"]}}}}},"description":"Pre-recorded audio prompt. Allowed `audio_variable`: `current_phone_number`, `keypress`. Pairs an audio mode `custom_audio_type` with one to seven audio items `custom_audio[]`. Honored when the surrounding `audio_type` or `callback_audio_type` is `custom_audio`; ignored when it is `text_to_speech`."},"offer_extension_number_message":{"maxLength":500,"type":"string","description":"Prompt asking the consumer to add an extension."},"offer_extension_number_message_custom_audio":{"required":["custom_audio","custom_audio_type"],"type":"object","properties":{"custom_audio_type":{"type":"string","description":"Select custom audio type.\n\n-'standard' - Choose an audio file. The audio prompt must include all words, numbers, and keypress digits as part of the message. Variables cannot be used with this option.\n-'advanced' -  With this option, the audio message can be split into multiple reusable audio parts. Variables are needed. Set up the digits library before using numbers with this option.","example":"standard","default":"standard","enum":["advanced","standard"]},"custom_audio":{"maxItems":7,"minItems":1,"type":"array","description":"Custom-audio items array for fields whose allowed dynamic variables are `current_phone_number` (