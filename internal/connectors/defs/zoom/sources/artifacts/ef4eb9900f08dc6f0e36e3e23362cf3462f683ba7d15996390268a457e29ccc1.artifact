oJg"},"audio_variable":{"type":"string","description":"Dynamic variable for advanced mode only. Allowed value: `current_phone_number`.\n\n**Note** Provide either `audio_asset_id` or `audio_variable`, but not both.","example":"current_phone_number","default":"current_phone_number","enum":["current_phone_number"]}}}}},"description":"Pre-recorded audio prompt. Allowed `audio_variable`: `current_phone_number`. Pairs an audio mode `custom_audio_type` with one to seven audio items `custom_audio[]`. Honored when the surrounding `audio_type` or `callback_audio_type` is `custom_audio`; ignored when it is `text_to_speech`."},"outbound_dial_greeting_message":{"maxLength":500,"type":"string","description":"Greeting played on the returning callback before agent connect. Used when `outbound_dial_option=auto_greeting`."},"outbound_dial_greeting_message_custom_audio":{"required":["custom_audio"],"type":"object","properties":{"custom_audio":{"maxItems":1,"minItems":1,"type":"array","description":"Single audio item. `standard` mode disallows multiple items and disallows `audio_variable`.","items":{"required":["audio_asset_id","order"],"type":"object","properties":{"order":{"maximum":1,"minimum":1,"type":"integer","description":"Always `1`."},"audio_asset_id":{"type":"string","description":"ID of the audio asset to play."}}}}},"description":"Pre-recorded audio prompt restricted to `standard` mode — supply exactly one audio item with `audio_asset_id`; dynamic `audio_variable` is not supported here."},"callback_cancel_message":{"maxLength":500,"type":"string","description":"Voice cancellation notice. Honored when `is_callback_cancel_message=true`."},"callback_cancel_message_custom_audio":{"required":["custom_audio"],"type":"object","properties":{"custom_audio":{"maxItems":1,"minItems":1,"type":"array","description":"Single audio item. `standard` mode disallows multiple items and disallows `audio_variable`.","items":{"required":["audio_asset_id","order"],"type":"object","properties":{"or