me.","example":"2026-12-10T00:00:00Z"},"work_session_end_time":{"type":"string","description":"The work session's end time.","example":"2026-12-12T00:00:00Z"},"user_id":{"type":"string","description":"The ID of the agent set up on the agent profile.","example":"reRAiabVQSqpXxJVDbsy2Q"},"user_name":{"type":"string","description":"The first and last name of the agent set up on the agent profile.","example":"agent_name_example"},"work_session_duration":{"type":"number","description":"The time between the start and end of an agent's unique work session, in milliseconds.","example":123},"work_session_modify_by_id":{"type":"string","description":"The ID of the agent who modified the work session status.","example":"PHPGirW5Rr"},"work_session_modify_by_name":{"type":"string","description":"The name of the agent who modified the work session status.","example":"my_agent"},"agent_regions":{"type":"array","description":"The user's geographic grouping for applying location-specific SIP Zone settings and managing call routing behavior.","items":{"type":"string","description":"The user's geographic grouping for applying location-specific SIP Zone settings and managing call routing behavior.","example":"Main Region"}},"client_types":{"type":"array","description":"The type of client application.","items":{"type":"string","description":"The type of client application.","example":"client"}},"agent_countries":{"type":"array","description":"The country or region where the agent is physically located.","items":{"type":"string","description":"The country or region where the agent is physically located.","example":"US"}},"ip_addresses":{"type":"array","description":"The agent's IP address.","items":{"type":"string","description":"The agent's IP address.","example":"66.172.9.16"}}}}}}}}}},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  **HTTP Status Code:** `400` <br> Bad Request  Input parameter format validation failed. \n\n "},"401":{"description":"**HTTP Status C