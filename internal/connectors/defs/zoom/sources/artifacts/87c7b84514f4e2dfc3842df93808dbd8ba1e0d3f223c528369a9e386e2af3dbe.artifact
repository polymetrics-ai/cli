y type.","example":"number","enum":["number","people","none"]},"allow_commenter_react":{"type":"boolean","description":"Whether a user with only commenter permission is allowed to click. If `true`, the user is allowed to click. If `false`, the user is not allowed to click.","example":false}},"description":"The `reaction` column option."},"currency_option":{"title":"currency_option","required":["decimal","format","symbol"],"type":"object","properties":{"decimal":{"type":"integer","description":"The number of decimal places.","example":1,"enum":[0,1,2,3,4,5]},"symbol":{"type":"string","description":"The currency symbol.","example":"$","enum":["$","¥","€","Ft","Rp","kr","R","CHF","DH","₹","zł","₽","₩","฿","₺","£"]},"format":{"type":"string","description":"The currency format.","example":"accounting","enum":["accounting","currency"]}},"description":"The `currency` column option."},"attachment_option":{"title":"attachment_option","required":["layout"],"type":"object","properties":{"layout":{"type":"string","description":"The attachment layout.","example":"thumbnail","enum":["thumbnail","full_width"]}},"description":"The `attachment` column option."},"url_option":{"title":"url_option","required":["display_type","open_type"],"type":"object","properties":{"display_type":{"type":"string","description":"The URL display type.","example":"title","enum":["title","full","icon"]},"open_type":{"type":"string","description":"The URL open type.","example":"current_page","enum":["current_page","new_page"]}},"description":"The `url` column option."}},"description":"The corresponding relationship between column type and column option is as follows:\n\n`date`|`created_time`|`updated_time`: date_option\n`number`: number_option\n`currency`: currency_option\n`percent`: percent_option\n`url`: url_option\n`attachment`: attachment_option\n`reaction`: reaction_option\n`single_select`|`multiple_select`: select_option\n`people`: people_option\n\nOther column types do not have a column option."}}}