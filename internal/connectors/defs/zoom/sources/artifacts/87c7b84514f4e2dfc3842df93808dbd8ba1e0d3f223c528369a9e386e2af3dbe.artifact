"type":"string","description":"The option ID.","example":"U9QOO6U4s8gBu0Zl"},"option_name":{"type":"string","description":"The option name.","example":"Done"}},"description":"The option information."}}},"description":"The `single_select` and `multiple_select` column option.\nOnly supports adding new options and modifying existing ones; deleting options is not supported."},"percent_option":{"title":"percent_option","required":["decimal","show_progress_bar"],"type":"object","properties":{"decimal":{"type":"integer","description":"The number of decimal places.","example":1,"enum":[0,1,2,3,4,5]},"show_progress_bar":{"type":"boolean","description":"If `true`, display the progress bar. If `false`, do not display the progress bar.","example":false}},"description":"The `percent` column option."},"people_option":{"title":"people_option","required":["is_multiple","is_notify"],"type":"object","properties":{"is_multiple":{"type":"boolean","description":"If `true`, allow selection of multiple people. If `false`, only one person can be selected.","example":false},"is_notify":{"type":"boolean","description":"If `true`, send a notification message after selecting someone. If `false`, do not send a notification message after selecting someone.","example":false}},"description":"The `people` column option."},"reaction_option":{"title":"reaction_option","required":["allow_commenter_react","display_type","icon"],"type":"object","properties":{"icon":{"required":["type","value"],"type":"object","properties":{"type":{"type":"string","description":"The icon display type. Currently only supports emoji.","example":"emoji","enum":["emoji"]},"value":{"type":"string","description":"The icon value.","example":"👍","enum":["👍","👎","🌟"]}},"description":"The icon content."},"display_type":{"type":"string","description":"The reaction icon display type.","example":"number","enum":["number","people","none"]},"allow_commenter_react":{"type":"boolean","description":"Whether a user with only commenter permission is allowed to click. If `true`, the user is allowed to click. If `false`, the user is not allowed to click.","example":false}},"description":"The `reaction` column option."},"currency_option":{"title":"currency_option","required":["decimal","format","symbol"],"type":"object","properties":{"decimal":{"type":"integer","description":"The number of decimal places.","example":1,"enum":[0,1,2,3,4,5]},"symbol":{"type":"string","description":"The currency symbol.","example":"$","enum":["$","¥","€","Ft","Rp","kr","R","CHF","DH","₹","zł","₽","₩","฿","₺","£"]},"format":{"type":"string","description":"The currency format.","example":"accounting","enum":["accounting","currency"]}},"description":"The `currency` column option."},"attachment_option":{"title":"attachment_option","required":["layout"],"type":"object","properties":{"layout":{"type":"string","description":"The attachment layout.","example":"thumbnail","enum":["thumbnail","full_width"]}},"description":"The `attachment` column option."},"url_option":{"title":"url_option","required":["display_type","open_type"],"type":"object","properties":{"display_type":{"type":"string","description":"The URL display type.","example":"title","enum":["title","full","icon"]},"open_type":{"type":"string","description":"The URL open type.","example":"current_page","enum":["current_page","new_page"]}},"description":"The `url` column option."}},"description":"When updating columns, update only the necessary options; there is no need to update all of them.\n\nThe corresponding relationship between column type and column option is as follows:\n\n`date`|`created_time`|`updated_time`: date_option\n`number`: number_option\n`currency`: currency_option\n`percent`: percent_option\n`url`: url_option\n`attachment`: attachment_option\n`reaction`: reaction_option\n`single_select`|`multiple_select`: select_option\n`people`: people_option\n\nOther column types do not have a column option."},"column_type":{"type":"string","description":"If the column type needs to be modified, pass the new column type here. If the target column type requires column options, pass the column options as well.","example":"text","enum":["text","number","percent","single_select","multiple_select","date","people","checkbox","attachment","reaction","created_by","updated_by","created_time","updated_time","currency","page","url"]}}}}}},"responses":{"204":{"description":"Successfully updated the column of the table."},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  Invalid parameters. \n\n **Error Code:** `2012` <br>\n Unsupported column type. <br>\n"},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  No permission. \n\n **Error Code:** `2009` <br>\n Updating column type is not allowed. <br>\n"},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  Data table or column not found. \n\n **Error Code:** `2000` <br>\n Block not found. <br>\n"},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["canvas_data_table:update","canvas:update:data_table"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":[],"x-macro-scopes":["canvas_data_table:update"],"x-granular-scopes":["canvas:update:data_table"]}}},"/docs/files/{fileId}/data_tables/{tableId}/rows":{"post":{"tags":["DataTable Content"],"summary":"Create table rows","description":"Add rows to a table.\nCreate up to 10 rows at a time.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `canvas_data_table:write`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `canvas:write:data_table`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `MEDIUM`\n\n**Not supported in Gov cluster** ","operationId":"Createdatatablerows","parameters":[{"name":"fileId","in":"path","description":"The file ID.","required":true,"schema":{"type":"string","example":"ADuV705lSXW4c6fBgQFarQ"}},{"name":"tableId","in":"path","description":"The table ID.","required":true,"schema":{"type":"string","example":"f537cdc592524388ae6651f9e97fe860"}}],"requestBody":{"content":{"application/json":{"schema":{"required":["rows"],"type":"object","properties":{"rows":{"maxItems":10,"minItems":1,"type":"array","description":"Array of table rows.","items":{"required":["cells"],"type":"object","properties":{"cells":{"type":"array","description":"Array of cell values in a row.","items":{"required":["column_name","value"],"type":"object","properties":{"column_name":{"type":"string","description":"The column name. Each cell value corresponds to a column.","example":"Text"},"value":{"type":"object","properties":{"text":{"title":"text","type":"string","description":"The `text` cell value.","example":"Hello World!"},"number":{"title":"number","type":"number","description":"The `number` cell value.","example":12.14},"percent":{"title":"percent","type":"number","description":"The `percent` cell value.\nThe calculation is based on percentage. For example, 200 represents 200%, and 1 represents 1%.","example":200},"single_select":{"title":"single_select","type":"string","description":"The `single_select` cell value.","example":"Male"},"multiple_select":{"title":"multi_select","type":"array","description":"The `multiple_select` cell value.","items":{"type":"string","example":"Male"}},"date":{"title":"date","type":"string","description":"The `date` cell value. An ISO 8601 formatted date string in UTC.","example":"2025-07-03T05:52:37Z"},"people":{"title":"people","type":"array","description":"The `people` cell value. If the `people` column's `is_multiple` is `true`, multiple people entries can be specified; otherwise, only one is allowed.","items":{"type":"object","properties":{"user_id":{"type":"string","description":"The user ID.","example":"U3OwWitcRAShLhbG4ChXNQ"}},"description":"A people item."}},"checkbox":{"title":"checkbox","type":"boolean","description":"The `checkbox` cell value. Whether the checkbox is checked: `true` or `false`.","example":false},"reaction":{"title":"reaction","type":"string","description":"The `reaction` cell value.","example":"click","enum":["click","unclick"]},"currency":{"title":"currency","type":"number","description":"The `currency` cell value.","example":20000},"url":{"title":"url","type":"string","description":"The `url` cell value.","example":"https://www.google.com"},"attachment":{"title":"attachment","type":"array","description":"The `attachment` cell value.\n\nYou must first call the [Upload file for docs import or attachments](/docs/api-reference/zoom-api/methods#operation/uploadDocsFile) API to upload the attachment, get the **attachment_id**, and then fill it into the cell value. Multiple **attachment_id** values can be specified.\n\nImage attachments are not allowed.","items":{"type":"object","properties":{"attachment_id":{"type":"string","description":"The attachment ID.","example":"ql62c9GzTdywOfRiaj6imQ"}},"description":"An attachment item."}}},"description":"A single `column_name` corresponds to only one `value`, and the relationship between each `value` and its `column_type` is as follows:\n\n`text`: `text` column\n`number`: `number` column\n`currency`: `currency` column\n`percent`: `percent` column\n`date`: `date` column\n`url`: `url` column\n`people`: `people` column\n`reaction`: `reaction` column\n`attachment`: `attachment` column\n`single_select`: `single_select` column\n`multiple_select`: `multiple_select` column\n`checkbox`: `checkbox` column\n\n`page`, `relation`, `formula`, and `rollup` cell values are not supported. The `created_time`, `updated_time`, `created_by`, and `updated_by` values are automatically generated by the system."}},"description":"The cell in the row corresponds to a column in the data table, and its value should match the type of that column."}}},"description":"A row of data to be created."}}}}}}},"responses":{"201":{"description":"**HTTP Status Code:** `201`  Created rows of the data table returned.","content":{"application/json":{"schema":{"type":"object","properties":{"rows":{"type":"array","description":"Array of table rows.","items":{"required":["cells","row_id"],"type":"object","properties":{"cells":{"type":"array","description":"Array of cell values in a row.","items":{"required":["column_name","value"],"type":"object","properties":{"column_name":{"type":"string","description":"The column name. Each cell value corresponds to a column.","example":"Text"},"value":{"type":"object","properties":{"text":{"title":"text","type":"string","description":"The `text` cell value.","example":"Hello World!"},"number":{"title":"number","type":"number","description":"The `number` cell value.","example":12.14},"percent":{"title":"percent","type":"number","description":"The `percent` cell value.\nThe calculation is based on percentage. For example, 200 represents 200%, and 1 represents 1%.","example":200},"single_select":{"title":"single_select","type":"string","description":"The `single_select` cell value.","example":"Male"},"multiple_select":{"title":"multi_select","type":"array","description":"The `multiple_select` cell value.","items":{"type":"string","example":"Male"}},"date":{"title":"date","type":"string","description":"The `date` cell value. An ISO 8601 formatted date string in UTC.","example":"2025-07-03T05:52:37Z"},"people":{"title":"people","type":"array","description":"The `people` cell value. If the `people` column's `is_multiple` is `true`, multiple people entries can be specified; otherwise, only one is allowed.","items":{"type":"object","properties":{"user_id":{"type":"string","description":"The user ID.","example":"U3OwWitcRAShLhbG4ChXNQ"},"user_name":{"type":"string","description":"The user name.","example":"Jack Li"}},"description":"A people item."}},"checkbox":{"title":"checkbox","type":"boolean","description":"The `checkbox` cell value. Whether the checkbox is checked: `true` or `false`.","example":false},"reaction":{"title":"reaction","type":"array","description":"The `reaction` cell value.","items":{"type":"object","properties":{"user_id":{"type":"string","description":"The user ID.","example":"GUZs4XBmSXqP6WLfEl_PSg"},"user_name":{"type":"string","description":"The user name.","example":"Jack Li"}},"description":"A reaction item."}},"currency":{"title":"currency","type":"number","description":"The `currency` cell value.","example":20000},"url":{"title":"url","type":"string","description":"The `url` cell value.","example":"https://www.google.com"},"attachment":{"title":"attachment","type":"array","description":"The `attachment` cell value.\n\nYou must first call the [Upload file for docs import or attachments](/docs/api-reference/zoom-api/methods#operation/uploadDocsFile) API to upload the attachment, get the **attachment_id**, and then fill it into the cell value. Multiple **attachment_id** values can be specified.\n\nImage attachments are not allowed.","items":{"type":"object","properties":{"attachment_id":{"type":"string","description":"The attachment ID.","example":"ql62c9GzTdywOfRiaj6imQ"},"name":{"type":"string","description":"The attachment name.","example":"api.txt"},"type":{"type":"string","description":"The attachment type.","example":"txt"}},"description":"An attachment item."}}},"description":"The column types corresponding to each cell value are as follows:\n\n`text`: `text` column\n`number`: `number` column\n`currency`: `currency` column\n`percent`: `percent` column\n`date`: `date` column\n`url`: `url` column\n`people`: `people` column\n`reaction`: `reaction` column\n`attachment`: `attachment` column\n`single_select`: `single_select` column\n`multiple_select`: `multiple_select` column\n`checkbox`: `checkbox` column\n\n`page`, `relation`, `formula`, and `rollup` cell values are not supported. The `created_time`, `updated_time`, `created_by`, and `updated_by` values are automatically generated by the system."}},"description":"The cell in the row corresponds to a column in the data table, and its value should match the type of that column."}},"row_id":{"type":"string","description":"The row ID.","example":"f537cdc592524388ae6651f9e97fe860"}},"description":"A row of data that was created."}}}}}}},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  Invalid parameters. \n\n **Error Code:** `2105` <br>\n Row count can not be greater than 10. <br>\n**Error Code:** `2026` <br>\n Invalid or inaccessible link URL. <br>\n**Error Code:** `2012` <br>\n Unsupported column type. <br>\n"},"401":{"description":"**HTTP Status Code:** `401` <br>\n Unauthorized  User not found or authentication failed. \n\n "},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  Permission denied. \n\n **Error Code:** `2009` <br>\n No permission to access or modify this resource. <br>\n"},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  File or data table not found. \n\n **Error Code:** `2000` <br>\n Block not found. <br>\n"},"415":{"description":"**HTTP Status Code:** `415` <br>\n Unsupported Media Type  Unsupported image attachment. \n\n "},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["canvas_data_table:write","canvas:write:data_table"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":[],"x-macro-scopes":["canvas_data_table:write"],"x-granular-scopes":["canvas:write:data_table"]}},"delete":{"tags":["DataTable Content"],"summary":"Delete rows","description":"Batch delete rows. Delete up to 10 rows at a time.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `canvas_data_table:delete`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `canvas:delete:data_table`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `MEDIUM`\n\n**Not supported in Gov cluster** ","operationId":"Deleterows","parameters":[{"name":"fileId","in":"path","description":"The file ID of the data table where the rows to be deleted are located.","required":true,"schema":{"type":"string","example":"B6gebVLnRaOEVvVLfHlMSA"}},{"name":"tableId","in":"path","description":"The table ID.","required":true,"schema":{"type":"string","example":"68cdb0c4a3ea494dbcf752e7b1ef12f3"}},{"name":"row_ids","in":"query","description":"List of row IDs, separated by commas.","required":true,"schema":{"type":"string","example":"e4d94cdba16143f3a7a312a6f674006c,70a8142285b44035a9a876202fdd6895"}}],"responses":{"204":{"description":"Rows deleted successfully."},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  Invalid Parameters. \n\n "},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  No Permission. \n\n **Error Code:** `2009` <br>\n No permission to access or modify this resource. <br>\n"},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  Table or Row not found. \n\n **Error Code:** `2000` <br>\n Table row not found. <br>\n"},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["canvas_data_table:delete","canvas:delete:data_table"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":[],"x-macro-scopes":["canvas_data_table:delete"],"x-granular-scopes":["canvas:delete:data_table"]}},"patch":{"tags":["DataTable Content"],"summary":"Update rows","description":"Update rows of the table. A maximum of 10 rows can be updated at one time.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `canvas_data_table:update`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `canvas:update:data_table`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `MEDIUM`\n\n**Not supported in Gov cluster** ","operationId":"Updaterows","parameters":[{"name":"fileId","in":"path","description":"The file ID of the table.","required":true,"schema":{"type":"string","example":"B6gebVLnRaOEVvVLfHlMSA"}},{"name":"tableId","in":"path","description":"The table ID.","required":true,"schema":{"type":"string","example":"f537cdc592524388ae6651f9e97fe860"}}],"requestBody":{"content":{"application/json":{"schema":{"required":["rows"],"type":"object","properties":{"rows":{"maxItems":10,"minItems":1,"type":"array","description":"Array of table rows.","items":{"required":["cells","row_id"],"type":"object","properties":{"cells":{"type":"array","description":"The list of cells to update in this row. Include only the columns whose values need to be changed. Columns that are not included remain unchanged.","items":{"required":["column_name","value"],"type":"object","properties":{"column_name":{"type":"string","description":"The column name. Each cell value corresponds to a column.","example":"Text"},"value":{"type":"object","properties":{"text":{"title":"text","type":"string","description":"The `text` cell value.","example":"Hello World!"},"number":{"title":"number","type":"number","description":"The `number` cell value.","example":12.14},"percent":{"title":"percent","type":"number","description":"The `percent` cell value.\nThe calculation is based on percentage. For example, 200 represents 200%, and 1 represents 1%.","example":200},"single_select":{"title":"single_select","type":"string","description":"The `single_select` cell value.","example":"Male"},"multiple_select":{"title":"multi_select","type":"array","description":"The `multiple_select` cell value.","items":{"type":"string","example":"Male"}},"date":{"title":"date","type":"string","description":"The `date` cell value. The ISO 8601 formatted date string in UTC.","example":"2025-07-03T05:52:37Z"},"people":{"title":"people","type":"array","description":"The `people` cell value. If the `people` column's `is_multiple` is `true`, multiple people entries can be specified; otherwise, only one is allowed.","items":{"type":"object","properties":{"user_id":{"type":"string","description":"The user ID.","example":"U3OwWitcRAShLhbG4ChXNQ"}},"description":"A people item."}},"checkbox":{"title":"checkbox","type":"boolean","description":"The `checkbox` cell value. Whether the checkbox is checked: `true` or `false`.","example":false},"reaction":{"title":"reaction","type":"string","description":"The `reaction` cell value.","example":"click","enum":["click","unclick"]},"currency":{"title":"currency","type":"number","description":"The `currency` cell value.","example":20000},"url":{"title":"url","type":"string","description":"The `url` cell value.","example":"https://www.google.com"},"attachment":{"title":"attachment","type":"array","description":"The `attachment` cell value.\n\nYou must first call the `Upload file for docs import or attachments` API to upload the attachment, get the **attachment_id**, and then fill it into the cell value. Multiple **attachment_id** values can be specified.\n\nImage attachments are not allowed.","items":{"type":"object","properties":{"attachment_id":{"type":"string","description":"The attachment ID.","example":"ql62c9GzTdywOfRiaj6imQ"}},"description":"An attachment item."}}},"description":"A single `column_name` corresponds to only one `value`, and the relationship between each `value` and its `column_type` is as follows:\n\n`text`: `text` column\n`number`: `number` column\n`currency`: `currency` column\n`percent`: `percent` column\n`date`: `date` column\n`url`: `url` column\n`people`: `people` column\n`reaction`: `reaction` column\n`attachment`: `attachment` column\n`single_select`: `single_select` column\n`multiple_select`: `multiple_select` column\n`checkbox`: `checkbox` column\n\n`page`, `relation`, `formula`, and `rollup` cell values are not supported. The `created_time`, `updated_time`, `created_by`, and `updated_by` values are automatically generated by the system."}},"description":"The cell in the row corresponds to a column in the data table, and its value should match the type of that column."}},"row_id":{"type":"string","description":"The row ID.","example":"f537cdc592524388ae6651f9e97fe860"}},"description":"A row of data to be updated."}}}}}}},"responses":{"204":{"description":"Rows updated successfully."},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  Invalid parameters. \n\n **Error Code:** `2000` <br>\n Block not found. <br>\n**Error Code:** `2105` <br>\n Row count cannot be greater than 10. <br>\n**Error Code:** `2026` <br>\n Invalid or inaccessible link URL. <br>\n"},"401":{"description":"**HTTP Status Code:** `401` <br>\n Unauthorized  User not found or authentication failed. \n\n "},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  No permission. \n\n **Error Code:** `2009` <br>\n No permission to access or modify this resource. <br>\n"},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  Data table or rows not found. \n\n **Error Code:** `2000` <br>\n Block not found. <br>\n"},"415":{"description":"**HTTP Status Code:** `415` <br>\n Unsupported Media Type  Unsupported image attachment. \n\n "},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["canvas_data_table:update","canvas:update:data_table"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":[],"x-macro-scopes":["canvas_data_table:update"],"x-granular-scopes":["canvas:update:data_table"]}}},"/docs/files/{fileId}/data_tables/{tableId}/rows/query":{"post":{"tags":["DataTable Content"],"summary":"Search rows","description":"Retrieve rows from a table with pagination, sorting, field selection, and filtering. A maximum of 100 rows are returned at a time.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `canvas_data_table:read`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `canvas:read:data_table`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `MEDIUM`\n\n**Not supported in Gov cluster** ","operationId":"Searchrows","parameters":[{"name":"fileId","in":"path","description":"The file ID of the data table where the rows to be queried are located.","required":true,"schema":{"type":"string","example":"B6gebVLnRaOEVvVLfHlMSA"}},{"name":"tableId","in":"path","description":"The table ID.","required":true,"schema":{"type":"string","example":"6f56440fb19348d1a11ec9c1a5319bce"}},{"name":"next_page_token","in":"query","description":"Use the `next_page_token` to paginate through a large set of results. A `next_page_token` is returned when the set of available results exceeds the current page size.","required":false,"schema":{"type":"string","example":"Tva2CuIdTgsv8wAnhyAdU3m06Y2HuLQtlh3"}},{"name":"page_size","in":"query","description":"The query page size. The default is 10.","required":false,"schema":{"maximum":50,"minimum":10,"type":"integer","example":10}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"filters":{"type":"object","description":"# Filter Structure\n\n## 1. Logical Group (`and` / `or`)\n\n```json\n{\n  \"and\": [\n    { \"column_name\": \"Status\", \"operator\": \"equal\", \"value\": { \"single_select\": \"Done\" } },\n    { \"column_name\": \"Priority\", \"operator\": \"greater_than\", \"value\": { \"number\": 3 } }\n  ]\n}\n```\n\n## 2. Nested Group (max 2 levels)\n\n```json\n{\n  \"and\": [\n    { \"column_name\": \"Status\", \"operator\": \"equal\", \"value\": { \"single_select\": \"Done\" } },\n    {\n      \"or\": [\n        { \"column_name\": \"Priority\", \"operator\": \"equal\", \"value\": { \"number\": 1 } },\n        { \"column_name\": \"Priority\", \"operator\": \"equal\", \"value\": { \"number\": 2 } }\n      ]\n    }\n  ]\n}\n```\n\n---\n\n# Condition Fields\n\n\n| Key        | Type     | Required | Description                                                                                                                                   |\n| ---------- | -------- | -------- | --------------------------------------------------------------------------------------------------------------------------------------------- |\n| `column_name` | `string` | **Yes**  | The column name.                                                                                                                              |\n| `operator` | `string` | **Yes**  | The filter operator (see below).                                                                                                              |\n| `value`    | `object` | No       | The filter value. **Not required** when `operator` is `is_empty` or `is_not_empty`. Only **one key** should be set, matching the column type. |\n\n\n---\n\n# Filter Operators\n\n\n| Operator             | Description                       |\n| -------------------- | --------------------------------- |\n| `equal`              | Equal to                          |\n| `not_equal`          | Not equal to                      |\n| `greater_than`       | Greater than                      |\n| `greater_than_equal` | Greater than or equal to          |\n| `less_than`          | Less than                         |\n| `less_than_equal`    | Less than or equal to             |\n| `contains`           | Contains                          |\n| `not_contains`       | Does not contain                  |\n| `is_empty`           | Is empty (no `value` needed)      |\n| `is_not_empty`       | Is not empty (no `value` needed)  |\n| `starts_with`        | Starts with                       |\n| `ends_with`          | Ends with                         |\n| `contains_any_of`    | Contains any of the given values  |\n| `contains_none_of`   | Contains none of the given values |\n| `contains_all_of`    | Contains all of the given values  |\n\n\n---\n\n# Value Format by Column Type\n\n## `text`\n\n- **Format:** `{ \"text\": \"Hello World!\" }`\n- **Operators:** `is_empty`, `is_not_empty`, `equal`, `not_equal`, `contains`, `not_contains`, `starts_with`, `ends_with`\n\n## `number`\n\n- **Format:** `{ \"number\": 12.14 }`\n- **Operators:** `is_empty`, `is_not_empty`, `equal`, `not_equal`, `greater_than`, `greater_than_equal`, `less_than`, `less_than_equal`\n\n## `percent`\n\n- **Format:** `{ \"percent\": 200 }`\n- **Note:** 200 means 200%, 1 means 1%.\n- **Operators:** Same as `number`.\n\n## `currency`\n\n- **Format:** `{ \"currency\": 20000 }`\n- **Operators:** Same as `number`.\n\n## `single_select`\n\n- **Format:** `{ \"single_select\": \"Male\" }`\n- **Note:** Value is the **option name**.\n- **Operators:** `is_empty`, `is_not_empty`, `equal`, `not_equal`, `contains_any_of`, `contains_none_of`\n\n## `multiple_select`\n\n- **Format:** `{ \"multiple_select\": [\"Tag1\", \"Tag2\"] }`\n- **Note:** Value is an **array of option names**.\n- **Operators:** `is_empty`, `is_not_empty`, `equal`, `contains_any_of`, `contains_all_of`, `contains_none_of`\n\n## `date`\n\n- **Format:** `{ \"date\": { \"mode\": \"<mode>\", \"value\": \"<value>\" } }`\n- **`mode` is required.** The `value` field depends on the mode:\n\n\n| Mode          | `value`                       | Example                                                  |\n| ------------- | ----------------------------- | -------------------------------------------------------- |\n| `exactly`     | ISO 8601 date string          | `{ \"mode\": \"exactly\", \"value\": \"2025-07-03T05:52:37Z\" }` |\n| `past`        | Number of days ago (string)   | `{ \"mode\": \"past\", \"value\": \"3\" }`                       |\n| `next`        | Number of days ahead (string) | `{ \"mode\": \"next\", \"value\": \"7\" }`                       |\n| `today`       | Not required                  | `{ \"mode\": \"today\" }`                                    |\n| `yesterday`   | Not required                  | `{ \"mode\": \"yesterday\" }`                                |\n| `tomorrow`    | Not required                  | `{ \"mode\": \"tomorrow\" }`                                 |\n| `currentweek` | Not required                  | `{ \"mode\": \"currentweek\" }`                              |\n\n\n- **Operators:** `is_empty`, `is_not_empty`, `equal`, `not_equal`, `greater_than`, `greater_than_equal`, `less_than`, `less_than_equal`\n- **Examples:**\n  - Greater than current week: `\"operator\": \"greater_than\"`, `\"value\": { \"date\": { \"mode\": \"currentweek\" } }`\n  - Less than a specific date: `\"operator\": \"less_than\"`, `\"value\": { \"date\": { \"mode\": \"exactly\", \"value\": \"2025-07-03T05:52:37Z\" } }`\n  - Greater than 3 days ago: `\"operator\": \"greater_than\"`, `\"value\": { \"date\": { \"mode\": \"past\", \"value\": \"3\" } }`\n\n## `people`\n\n- **Format:** `{ \"people\": [\"U3OwWitcRAShLhbG4ChXNQ\"] }`\n- **Note:** Value is an **array of user IDs**.\n- **Operators:** `is_empty`, `is_not_empty`, `equal`, `not_equal`, `contains_any_of`, `contains_none_of`\n\n## `checkbox`\n\n- **Format:** `{ \"checkbox\": false }`\n- **Operators:** `equal`\n\n## `reaction`\n\n- **Format:** `{ \"reaction\": 12 }`\n- **Note:** Value is the **click count** (integer).\n- **Operators:** `is_empty`, `is_not_empty`, `equal`, `not_equal`, `greater_than`, `greater_than_equal`, `less_than`, `less_than_equal`\n\n## `url`\n\n- **Format:** `{ \"url\": \"https://www.google.com\" }`\n- **Operators:** `is_empty`, `is_not_empty`, `equal`, `not_equal`, `contains`, `not_contains`, `starts_with`, `ends_with`\n\n## `attachment`\n\n- **Format:** `{ \"attachment\": \"document.txt\" }`\n- **Note:** Filtering is based on the **file name**.\n- **Operators:** `is_empty`, `is_not_empty`, `equal`, `not_equal`, `contains`, `not_contains`, `starts_with`, `ends_with`\n\n"},"fields":{"type":"array","description":"If provided, only the values of the specified fields are returned. If not provided, the values of all fields are returned.","items":{"type":"string","description":"The field name.","example":"Task"}},"sort":{"type":"array","description":"The list of sorting rules.","items":{"required":["column_name","order"],"type":"object","properties":{"column_name":{"type":"string","description":"The column name to sort by.","example":"Priority"},"order":{"type":"string","description":"The sort order.","example":"asc","enum":["desc","asc"]}},"description":"A sorting rule."}}}}}}},"responses":{"200":{"description":"Successfully searched rows.","content":{"application/json":{"schema":{"required":["rows","total_records"],"type":"object","properties":{"next_page_token":{"type":"string","description":"If `next_page_token` is not empty, it indicates that there are more results. Use this token in the next request to retrieve the next page of results.","example":"Tva2CuIdTgsv8wAnhyAdU3m06Y2HuLQtlh3"},"total_records":{"type":"number","description":"The total number of rows matching the query condition.","example":50},"rows":{"type":"array","description":"The array of queried rows.","items":{"required":["cells","row_id"],"type":"object","properties":{"cells":{"type":"array","description":"The array of cell values in the row.","items":{"required":["column_name","value"],"type":"object","properties":{"column_name":{"type":"string","description":"The column name. Each cell value corresponds to a column.","example":"Text"},"value":{"type":"object","properties":{"text":{"title":"text","type":"string","description":"The `text` cell value.","example":"Hello World!"},"number":{"title":"number","type":"number","description":"The `number` cell value.","example":12.14},"percent":{"title":"percent","type":"number","description":"The `percent` cell value.\nThe calculation is based on percentage. For example, 200 represents 200%, and 1 represents 1%.","example":200},"single_select":{"title":"single_select","type":"string","description":"The `single_select` cell value.","example":"Male"},"multiple_select":{"title":"multi_select","type":"array","description":"The `multiple_select` cell value.","items":{"type":"string","example":"Male"}},"date":{"title":"date","type":"string","description":"The `date` cell value. An ISO 8601 formatted date string in UTC.","example":"2025-07-03T05:52:37Z"},"people":{"title":"people","type":"array","description":"The `people` cell value. If the `people` column's `is_multiple` is `true`, multiple people entries can be specified; otherwise, only one is allowed.","items":{"type":"object","properties":{"user_id":{"type":"string","description":"The user ID.","example":"U3OwWitcRAShLhbG4ChXNQ"},"user_name":{"type":"string","description":"The user name.","example":"Jack Li"}},"description":"A people item."}},"checkbox":{"title":"checkbox","type":"boolean","description":"The `checkbox` cell value. Whether the checkbox is checked: `true` or `false`.","example":false},"reaction":{"title":"reaction","type":"array","description":"The `reaction` cell value.","items":{"type":"object","properties":{"user_id":{"type":"string","description":"The user ID.","example":"GUZs4XBmSXqP6WLfEl_PSg"},"user_name":{"type":"string","description":"The user name.","example":"Jack Li"}},"description":"A reaction item."}},"currency":{"title":"currency","type":"number","description":"The `currency` cell value.","example":20000},"url":{"title":"url","type":"string","description":"The `url` cell value.","example":"https://www.google.com"},"attachment":{"title":"attachment","type":"array","description":"The `attachment` cell value.\n\nYou must first call the [Upload file for docs import or attachments](/docs/api-reference/zoom-api/methods#operation/uploadDocsFile) API to upload the attachment, get the **attachment_id**, and then fill it into the cell value. Multiple **attachment_id** values can be specified.\n\nImage attachments are not allowed.","items":{"type":"object","properties":{"attachment_id":{"type":"string","description":"The attachment ID.","example":"ql62c9GzTdywOfRiaj6imQ"},"name":{"type":"string","description":"The attachment name.","example":"api.txt"},"type":{"type":"string","description":"The attachment type.","example":"txt"}},"description":"An attachment item."}}},"description":"The column types corresponding to each cell value are as follows:\n\n`text`: `text` column\n`number`: `number` column\n`currency`: `currency` column\n`percent`: `percent` column\n`date`: `date` column\n`url`: `url` column\n`people`: `people` column\n`reaction`: `reaction` column\n`attachment`: `attachment` column\n`single_select`: `single_select` column\n`multiple_select`: `multiple_select` column\n`checkbox`: `checkbox` column\n\n`page`, `relation`, `formula`, and `rollup` cell values are not supported. The `created_time`, `updated_time`, `created_by`, and `updated_by` values are automatically generated by the system."}},"description":"A cell in the row that corresponds to a column in the table. Its value matches the type of that column."}},"row_id":{"type":"string","description":"The row ID.","example":"f537cdc592524388ae6651f9e97fe860"}},"description":"A row."}}}}}}},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  Invalid parameters. \n\n **Error Code:** `2012` <br>\n Unsupported column type. <br>\n"},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  No permission. \n\n **Error Code:** `2009` <br>\n No permission to access or modify this resource. <br>\n"},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  Table or rows not found. \n\n **Error Code:** `2000` <br>\n Block not found. <br>\n"},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["canvas_data_table:read","canvas:read:data_table"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":[],"x-macro-scopes":["canvas_data_table:read"],"x-granular-scopes":["canvas:read:data_table"]}}},"/docs/files/{fileId}/blocks":{"post":{"tags":["Doc Content"],"summary":"Insert blocks into a document","description":"Insert new blocks at a specific position in a document. Accepts XML-formatted block content and supports positioning above, below, or inside a specific parent block. Use the Get file content endpoint with the query parameter `format=xml` first to fetch the document structure and block IDs.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs_content:write`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:write:content`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `LIGHT`\n\n**Not supported in Gov cluster** ","operationId":"Insertblocksintoadocument","parameters":[{"name":"fileId","in":"path","description":"The document file ID.","required":true,"schema":{"type":"string","example":"p6zmDowpR_2h7isqK9zwBg"}}],"requestBody":{"content":{"application/json":{"schema":{"required":["blocks"],"type":"object","properties":{"positioning":{"type":"object","properties":{"above_block_id":{"type":"string","description":"Block ID to insert above (mutually exclusive with below)","example":"8d0ad8e130e14d44"},"below_block_id":{"type":"string","description":"Block ID to insert below (mutually exclusive with above)","example":"8d0ad8e130e14d44"},"parent_block_id":{"type":"string","description":"Parent block ID. Inserts at the end of this parent's children.","example":"a1b2c3d4e5f6"}},"description":"Block positioning options. At most one of `above_block_id`, `below_block_id`, or `parent_block_id` should be specified. If none are specified, blocks are appended to the end of the document."},"blocks":{"type":"string","description":"XML string containing block content. See the [Zoom Docs XML Format Specification](https://developers.zoom.us/docs/zoom-docs/doc-format-specification) for supported block types and syntax.","example":"<text>New content</text>"}}}}}},"responses":{"201":{"description":"Successfully inserted blocks."},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  \n\n **Error Code:** `2000` <br>\n Block not found. <br>\n"},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  \n\n "},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  \n\n **Error Code:** `4000` <br>\n File not found. <br>\n"},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["docs_content:write","docs:write:content"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":[],"x-macro-scopes":["docs_content:write"],"x-granular-scopes":["docs:write:content"]}}},"/docs/files/{fileId}/blocks/replace_range":{"post":{"tags":["Doc Content"],"summary":"Replace a range of blocks","description":"Replace a contiguous range of sibling blocks with new blocks in a single atomic operation. All blocks between start and end (inclusive) are removed and replaced with the provided XML block content. Important: `start_block_id` and `end_block_id` must be direct children of the same parent block (siblings). If they are not siblings, the operation will fail. Use the Get file content endpoint to verify the document structure before calling this endpoint.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs_content:update`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:update:content`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `LIGHT`\n\n**Not supported in Gov cluster** ","operationId":"Replacearangeofblocks","parameters":[{"name":"fileId","in":"path","description":"The document file ID.","required":true,"schema":{"type":"string","example":"p6zmDowpR_2h7isqK9zwBg"}}],"requestBody":{"content":{"application/json":{"schema":{"required":["blocks","end_block_id","start_block_id"],"type":"object","properties":{"blocks":{"type":"string","description":"XML string containing block content. See the [Zoom Docs XML Format Specification](https://developers.zoom.us/docs/zoom-docs/doc-format-specification) for supported block types and syntax.","example":"<text>New content</text>"},"start_block_id":{"type":"string","description":"Block ID of the first block in the range.","example":"a1b2c"},"end_block_id":{"type":"string","description":"Block ID of the last block in the range.","example":"d4e5f"}}}}}},"responses":{"204":{"description":"Successfully replaced the specified block range with new blocks."},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  \n\n **Error Code:** `2000` <br>\n Block not found. <br>\n"},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  \n\n "},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  \n\n **Error Code:** `4000` <br>\n File not found. <br>\n"},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["docs_content:update","docs:update:content"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":[],"x-macro-scopes":["docs_content:update"],"x-granular-scopes":["docs:update:content"]}}},"/docs/files/{fileId}/blocks/{blockId}":{"delete":{"tags":["Doc Content"],"summary":"Delete a specific block","description":"Deletes a block and all its content from the document.\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:delete:content`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `LIGHT`\n\n**Not supported in Gov cluster** ","operationId":"DeleteBlock","parameters":[{"name":"fileId","in":"path","description":"The doc file ID containing the block to delete.","required":true,"schema":{"type":"string","example":"p6zmDowpR_2h7isqK9zwBg"}},{"name":"blockId","in":"path","description":"The unique identifier of the block to delete.","required":true,"schema":{"type":"string","example":"8d0ad8e130e14d44adae4f78303fc6cc"}}],"responses":{"204":{"description":"Successfully deleted the block."},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  \n\n **Error Code:** `2000` <br>\n Block not found. <br>\n"},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  \n\n "},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  \n\n **Error Code:** `4000` <br>\n File not found. <br>\n"},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["docs:delete:content"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":[],"x-granular-scopes":["docs:delete:content"]}},"patch":{"tags":["Doc Content"],"summary":"Update a specific block","description":"Updates the content of an existing block using XML-formatted content. Keeps the existing block type and replaces the content. To change the block type, use ReplaceBlockRange.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs_content:update`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:update:content`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `LIGHT`\n\n**Not supported in Gov cluster** ","operationId":"UpdateBlock","parameters":[{"name":"fileId","in":"path","description":"The doc file ID.","required":true,"schema":{"type":"string","example":"p6zmDowpR_2h7isqK9zwBg"}},{"name":"blockId","in":"path","description":"The unique identifier of the block to update.","required":true,"schema":{"type":"string","example":"8d0ad8e130e14d44adae4f78303fc6cc"}}],"requestBody":{"content":{"application/json":{"schema":{"required":["block"],"type":"object","properties":{"block":{"type":"string","description":"A single XML block string with the updated content. See the [Zoom Docs XML Format Specification](https://developers.zoom.us/docs/zoom-docs/doc-format-specification) for supported block types and syntax.","example":"<text>New content</text>"}}}}}},"responses":{"204":{"description":"Block updated successfully."},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  \n\n **Error Code:** `2000` <br>\n Block not found. <br>\n"},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  \n\n "},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  \n\n **Error Code:** `4000` <br>\n File not found. <br>\n"},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["docs_content:update","docs:update:content"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":[],"x-macro-scopes":["docs_content:update"],"x-granular-scopes":["docs:update:content"]}}},"/docs/exports":{"post":{"tags":["Export"],"summary":"Create a file export","description":"Creates a export for specified file.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs_export:write`,`docs_export:write:admin`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:write:export`,`docs:write:export:admin`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `HEAVY`\n\n**Not supported in Gov cluster** ","operationId":"Createafileexport","requestBody":{"content":{"application/json":{"schema":{"required":["export_format","file_id"],"type":"object","properties":{"file_id":{"type":"string","description":"The doc file ID.","example":"ADuV705lSXW4c6fBgQFarQ"},"export_format":{"type":"string","description":"The target format for export.\n\nDifferent file types support different export formats:\n\n- `doc` supports export to `docx`, `markdown` or `pdf`\n- `data_table` supports export to `csv`","example":"docx","enum":["docx","markdown","pdf","csv"]}}}}}},"responses":{"201":{"description":"A Docs file is being converted into expected format.","content":{"application/json":{"schema":{"required":["export_id"],"type":"object","properties":{"export_id":{"type":"string","description":"The unique ID for your export. Use this ID to check the export status via the Get file export status endpoint (GET /docs/exports/{exportId}/status).","example":"ccbb4d8f72774741af8b8141f92e6d83"}}}}}},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  \n\n "},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["docs_export:write","docs_export:write:admin","docs:write:export","docs:write:export:admin"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":["DocsContent:Read"],"x-macro-scopes":["docs_export:write","docs_export:write:admin"],"x-granular-scopes":["docs:write:export","docs:write:export:admin"]}}},"/docs/exports/{exportId}/status":{"get":{"tags":["Export"],"summary":"Get file export status","description":"Use this API to query the status of a file export. \n\nBefore using this API, confirm that you have invoked the API Create a file export endpoint and obtained the `export_id`.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs_export:read`,`docs_export:read:admin`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:read:export`,`docs:read:export:admin`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `LIGHT`\n\n**Not supported in Gov cluster** ","operationId":"Getfileexportstatus","parameters":[{"name":"exportId","in":"path","description":"The unique ID for your export.","required":true,"schema":{"type":"string","example":"ccbb4d8f72774741af8b8141f92e6d83"}}],"responses":{"200":{"description":"Retrieves the docs file export result.","content":{"application/json":{"schema":{"required":["status"],"type":"object","properties":{"status":{"type":"string","description":"The status of the file export.\n\nEnum:\n- `processing` - The Docs file is being converted.\n- `succeeded` - The Docs file has been converted successfully.\n- `failed` - The Docs file has failed to convert.","example":"processing","enum":["processing","failed","succeeded"]},"download_link":{"type":"string","description":"The download link for the converted file. This field will be returned when the value of status is `succeeded`.","example":"https://file.zoom.us/file/xxxx?signature=xxxxx&token=xxxxx"},"expires_at":{"type":"string","description":"The expiration date of the `download_link` URL; after this time, the `download_link` will become invalid.\n\nThis field will be returned when the value of status is `succeeded`.","example":"2025-12-11T08:51:54.887212742Z"}}}}}},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  \n\n **Error Code:** `5150` <br>\n Export file size limit exceeded. <br>\n"},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  \n\n **Error Code:** `5003` <br>\n The exportId not exists or expired. <br>\n"}},"security":[{"openapi_oauth":["docs_export:read","docs_export:read:admin","docs:read:export","docs:read:export:admin"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":["DocsContent:Read"],"x-macro-scopes":["docs_export:read","docs_export:read:admin"],"x-granular-scopes":["docs:read:export","docs:read:export:admin"]}}},"/docs/files/{fileId}/content":{"get":{"tags":["Export"],"summary":"Get file content","description":"Retrieves the file name and full file content in Markdown format.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs_export:read`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:read:export`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `HEAVY`\n\n**Not supported in Gov cluster** ","operationId":"Getfilecontent","parameters":[{"name":"fileId","in":"path","description":"The unique identifier of the document file.","required":true,"schema":{"type":"string","example":"ADuV705lSXW4c6fBgQFarQ"}}],"responses":{"200":{"description":"Retrieves the file name and full file content in Markdown format.","content":{"application/json":{"schema":{"type":"object","properties":{"file_name":{"type":"string","description":"The name of the document file.","example":"Q3 Plan"},"file_content":{"type":"string","description":"The document file content in Markdown format.","example":"## Product Development\n\n- Complete beta testing for mobile app by July 15\n- Implement AI-powered recommendation engine"}}}}}},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  \n\n **Error Code:** `5150` <br>\n Export file size limit exceeded. <br>\n"},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  Permission denied. \n\n "},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  File not found or deleted. \n\n "},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["docs_export:read","docs:read:export"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":[],"x-macro-scopes":["docs_export:read"],"x-granular-scopes":["docs:read:export"]}}},"/docs/files":{"post":{"tags":["File Management"],"summary":"Create a new file","description":"Creates a new file for a user.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:write`,`docs:write:admin`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:write:file`,`docs:write:file:admin`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `MEDIUM`\n\n**Not supported in Gov cluster** ","operationId":"CreateDoc","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"file_name":{"type":"string","description":"The file name.","example":"Q3 Plan","default":"Untitled"},"parent_id":{"type":"string","description":"The ID of the parent file. The newly created file will become a child of this parent. If this parameter is omitted, the file will be placed under \"My Docs.\" Use \"root\" to represent the top-level folder of the current user. Folders can only be created under \"My Docs,\" a shared folder, or another folder.","example":"fIdgryoPSZ-Jm34Ag-OX7A"},"file_type":{"type":"string","description":"The type of a file.","example":"doc","default":"doc","enum":["doc","folder","data_table"]},"user_id":{"type":"string","description":"When invoked with the `admin` scope, this operation runs on behalf of the specified user. Permissions are validated against that user. This parameter is required with the `admin` scope and has no effect otherwise.","example":"9BGgfjrQTayGWw_422j1Bw"},"data_table":{"type":"object","properties":{"columns":{"type":"array","description":"The `columns` parameter is ignored when `file_type` is not `data_table`. When `file_type` is `data_table`, users can provide custom columns. If none are provided, three default columns—`text`, `people`, and `single_select`—along with a grid view will be created.","items":{"required":["column_type","name"],"type":"object","properties":{"name":{"type":"string","description":"The column name.","example":"Text"},"column_type":{"type":"string","description":"The type of the column.","example":"text","enum":["text","number","percent","single_select","multiple_select","date","people","checkbox","attachment","reaction","created_by","updated_by","created_time","updated_time","currency","page","url"]},"description":{"type":"string","description":"Column Description","example":"Text Content"},"column_options":{"type":"object","properties":{"date_option":{"title":"date_option","required":["format","is_24_hour_format"],"type":"object","properties":{"format":{"type":"string","description":"The date display format. Examples are as follows:\n2025-10-21 12:00\n2025/10/21 12:00\n2025/10/21 00:00\n25-10-21 00:30\n10/21/2025 00:30\n10/21/25 00:30\n08/10/2025 01:00\n08/10/25 01:00","example":"MM/dd/yyyy","enum":["MM/dd/yyyy","MM/dd/yy","M/d/yyyy","yy-MM-dd","yyyy/MM/dd","yy/MM/dd","yyyy/M/d","yy/M/d","dd/MM/yyyy","dd/MM/yy","MMM d, yyyy","EEE, MMM d","EEE, MMM d, yyyy","EEE"]},"is_24_hour_format":{"type":"boolean","description":"If `true`, display in 24-hour format. If `false`, display in 12-hour format.","example":false}},"description":"The `date`|`created_time`|`updated_time` column option."},"number_option":{"title":"number_option","required":["decimal","show_separator"],"type":"object","properties":{"decimal":{"type":"integer","description":"The number of decimal places.","example":1,"enum":[0,1,2,3,4,5]},"show_separator":{"type":"boolean","description":"If `true`, display thousand separators. If `false`, do not display thousand separators.","example":false}},"description":"The `number` column option."},"select_option":{"title":"select_option","type":"object","properties":{"options":{"type":"array","description":"The option list.","items":{"type":"object","properties":{"name":{"type":"string","description":"The option name.","example":"Blue"}},"description":"A specific option."}}},"description":"The `single_select` and `multiple_select` column option."},"percent_option":{"title":"percent_option","required":["decimal","show_progress_bar"],"type":"object","properties":{"decimal":{"type":"integer","description":"The number of decimal places.","example":1,"enum":[0,1,2,3,4,5]},"show_progress_bar":{"type":"boolean","description":"If `true`, display the progress bar. If `false`, do not display the progress bar.","example":false}},"description":"The `percent` column option."},"people_option":{"title":"people_option","required":["is_multiple","is_notify"],"type":"object","properties":{"is_multiple":{"type":"boolean","description":"If `true`, allow selection of multiple people. If `false`, only one person can be selected.","example":false},"is_notify":{"type":"boolean","description":"If `true`, send a notification message after selecting someone. If `false`, do not send a notification message after selecting someone.","example":false}},"description":"The `people` column option."},"reaction_option":{"title":"reaction_option","required":["allow_commenter_react","display_type","icon"],"type":"object","properties":{"icon":{"required":["type","value"],"type":"object","properties":{"type":{"type":"string","description":"The icon display type. Currently only supports emoji.","example":"emoji","enum":["emoji"]},"value":{"type":"string","description":"The icon value.","example":"👍","enum":["👍","👎","🌟"]}},"description":"The icon content."},"display_type":{"type":"string","description":"The reaction icon display type.","example":"number","enum":["number","people","none"]},"allow_commenter_react":{"type":"boolean","description":"Whether a user with only commenter permission is allowed to click. If `true`, the user is allowed to click. If `false`, the user is not allowed to click.","example":false}},"description":"The `reaction` column option."},"currency_option":{"title":"currency_option","required":["decimal","format","symbol"],"type":"object","properties":{"decimal":{"type":"integer","description":"The number of decimal places.","example":1,"enum":[0,1,2,3,4,5]},"symbol":{"type":"string","description":"The currency symbol.","example":"$","enum":["$","¥","€","Ft","Rp","kr","R","CHF","DH","₹","zł","₽","₩","฿","₺","£"]},"format":{"type":"string","description":"The currency format.","example":"accounting","enum":["accounting","currency"]}},"description":"The `currency` column option."},"attachment_option":{"title":"attachment_option","required":["layout"],"type":"object","properties":{"layout":{"type":"string","description":"The attachment layout.","example":"thumbnail","enum":["thumbnail","full_width"]}},"description":"The `attachment` column option."},"url_option":{"title":"url_option","required":["display_type","open_type"],"type":"object","properties":{"display_type":{"type":"string","description":"The URL display type.","example":"title","enum":["title","full","icon"]},"open_type":{"type":"string","description":"The URL open type.","example":"current_page","enum":["current_page","new_page"]}},"description":"The `url` column option."}},"description":"The corresponding relationship between column type and column option is as follows:\n\n`date`|`created_time`|`updated_time`: date_option\n`number`: number_option\n`currency`: currency_option\n`percent`: percent_option\n`url`: url_option\n`attachment`: attachment_option\n`reaction`: reaction_option\n`single_select`|`multiple_select`: select_option\n`people`: people_option\n\nOther column types do not have a column option."}}}}},"description":"The data table schema information."}},"description":"Create a new file request body."}}}},"responses":{"201":{"description":"Returns the ID of the created file.","content":{"application/json":{"schema":{"type":"object","properties":{"file_id":{"type":"string","description":"The ID of a file in Docs.","example":"ADuV705lSXW4c6fBgQFarQ"}}}}}},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  Invalid request parameters provided. \n\n "},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  Permission required to create files under this parent directory. \n\n "},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  File not found. \n\n "},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["docs:write","docs:write:admin","docs:write:file","docs:write:file:admin"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":["DocsMgt:Edit"],"x-macro-scopes":["docs:write","docs:write:admin"],"x-granular-scopes":["docs:write:file","docs:write:file:admin"]}}},"/docs/files/{fileId}":{"get":{"tags":["File Management"],"summary":"Get metadata of a file","description":"Get metadata of a file.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:read`,`docs:read:admin`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:read:file`,`docs:read:file:admin`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `LIGHT`\n\n**Not supported in Gov cluster** ","operationId":"QueryFileMetadata","parameters":[{"name":"fileId","in":"path","description":"The doc file ID.","required":true,"schema":{"type":"string","example":"ADuV705lSXW4c6fBgQFarQ"}}],"responses":{"200":{"description":"Returns the basic metadata of this file.","content":{"application/json":{"schema":{"required":["created_time","file_id","file_link","file_name","file_type","modified_time"],"type":"object","properties":{"file_id":{"type":"string","description":"The doc file ID.","example":"ADuV705lSXW4c6fBgQFarQ"},"file_name":{"type":"string","description":"The doc file name.","example":"Q3 Plan"},"file_type":{"type":"string","description":"The type of a file","example":"doc","default":"doc","enum":["doc","folder","data_table"]},"file_link":{"type":"string","description":"The URL link of the file.","example":"https://docs.zoom.us/doc/ADuV705lSXW4c6fBgQFarQ"},"created_time":{"type":"string","description":"The time when the file created.","example":"2025-06-30T09:47:40.249Z"},"modified_time":{"type":"string","description":"The time when the file last modified.","example":"2025-06-30T09:47:40.249Z"}}}}}},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  \n\n "},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  Permission Denied. \n\n "},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  File Not Found/Deleted. \n\n "},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["docs:read","docs:read:admin","docs:read:file","docs:read:file:admin"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":["DocsMgt:Read"],"x-macro-scopes":["docs:read","docs:read:admin"],"x-granular-scopes":["docs:read:file","docs:read:file:admin"]}},"delete":{"tags":["File Management"],"summary":"Delete a file","description":"Delete a file.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:delete`,`docs:delete:admin`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:delete:file`,`docs:delete:file:admin`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `MEDIUM`\n\n**Not supported in Gov cluster** ","operationId":"DeleteFile","parameters":[{"name":"fileId","in":"path","description":"The doc file ID.","required":true,"schema":{"type":"string","example":"ADuV705lSXW4c6fBgQFarQ"}}],"responses":{"204":{"description":"**HTTP Status Code**: `204`   \n \nFile deleted successfully."},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  \n\n "},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  Permission Denied. \n\n "},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  File Not Found/Deleted. \n\n "},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["docs:delete","docs:delete:admin","docs:delete:file","docs:delete:file:admin"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":["DocsMgt:Edit"],"x-macro-scopes":["docs:delete","docs:delete:admin"],"x-granular-scopes":["docs:delete:file","docs:delete:file:admin"]}},"patch":{"tags":["File Management"],"summary":"Modify metadata of a file","description":"Modify metadata of a file.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:write`,`docs:write:admin`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:update:file`,`docs:update:file:admin`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `MEDIUM`\n\n**Not supported in Gov cluster** ","operationId":"ModifyMetadata","parameters":[{"name":"fileId","in":"path","description":"The doc file ID.","required":true,"schema":{"type":"string","example":"ADuV705lSXW4c6fBgQFarQ"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"file_name":{"type":"string","description":"File title name.","example":"Q3 plan"}}}}}},"responses":{"204":{"description":"**HTTP Status Code**: `204`   \n \nModify metadata successfully."},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  \n\n "},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  Permission Denied. \n\n "},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  File Not Found/Deleted. \n\n "},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["docs:write","docs:write:admin","docs:update:file","docs:update:file:admin"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":["DocsMgt:Edit"],"x-macro-scopes":["docs:write","docs:write:admin"],"x-granular-scopes":["docs:update:file","docs:update:file:admin"]}}},"/docs/files/{fileId}/children":{"get":{"tags":["File Management"],"summary":"List all children of a file","description":"List all children of a file.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:read`,`docs:read:admin`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:read:list_children`,`docs:read:list_children:admin`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `MEDIUM`","operationId":"ListAllChildren","parameters":[{"name":"fileId","in":"path","description":"The fileId of a file. When querying children of 'My docs', `fileId` should be `root`.","required":true,"schema":{"type":"string","example":"61kkJE-rR52UsywN25E0hQ"}},{"name":"next_page_token","in":"query","description":"The next page token paginates through a large set of results. A next page token returns whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.","required":false,"schema":{"type":"string","example":"eyJ0aW1lQ3Vyc29yIjoiMjAyNS0wNC0yMVQwOTo0NTo1OC45NTJaIiwiaWRDdXJzb3IiOiJzemFsMkpmTlFteTExY1JwdkYxRWhBIn0="}},{"name":"page_size","in":"query","description":"The number of shared folders to query. The maximum size is 50.","required":false,"schema":{"maximum":50,"minimum":1,"type":"integer","example":10,"default":10}}],"responses":{"200":{"description":"Returns all children files.","content":{"application/json":{"schema":{"required":["files","next_page_token"],"type":"object","properties":{"files":{"maxItems":50,"type":"array","description":"children list","items":{"required":["created_time","file_id","file_link","file_name","file_type","modified_time"],"type":"object","properties":{"file_id":{"type":"string","description":"The ID of a file.","example":"61kkJE-rR52UsywN25E0hQ"},"file_name":{"type":"string","description":"The name of a file.","example":"Q3 plan"},"file_type":{"type":"string","description":"The type of a file","example":"doc","default":"doc","enum":["doc","folder","data_table"]},"file_link":{"type":"string","description":"The access link of a file.","example":"https://docs.zoom.us/doc/61kkJE-rR52UsywN25E0hQ"},"created_time":{"type":"string","description":"The time when the file created.","example":"2025-06-30T09:47:40.249Z"},"modified_time":{"type":"string","description":"The time when the file last modified.","example":"2025-06-30T09:47:40.249Z"}},"description":"child item"}},"next_page_token":{"type":"string","description":"The next page token paginates through a large set of results. A next page token returns whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.","example":"eyJ0aW1lQ3Vyc29yIjoiMjAyNS0wNC0yMVQwOTo0NTo1OC45NTJaIiwiaWRDdXJzb3IiOiJzemFsMkpmTlFteTExY1JwdkYxRWhBIn0="}}}}}},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  \n\n "},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  Permission Denied. \n\n "},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  Parent not found. \n\n "},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["docs:read","docs:read:admin","docs:read:list_children","docs:read:list_children:admin"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":["DocsMgt:Read"],"x-macro-scopes":["docs:read","docs:read:admin"],"x-granular-scopes":["docs:read:list_children","docs:read:list_children:admin"]}}},"/docs/files/{fileId}/owner":{"put":{"tags":["File Management"],"summary":"Transfer ownership of a file","description":"Transfer a file’s ownership to another user. \nOnly `doc` or `data table` files are supported. \nOnly the file `owner` has permission to perform an ownership transfer.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs_file_owner:write`,`docs_file_owner:write:admin`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:update:file_owner`,`docs:update:file_owner:admin`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `MEDIUM`\n\n**Not supported in Gov cluster** ","operationId":"TransferOwnershipOfAFile","parameters":[{"name":"fileId","in":"path","description":"The ID of a file in docs.","required":true,"schema":{"type":"string","example":"_4oHCpleRgGumHa60amdKl"}}],"requestBody":{"content":{"application/json":{"schema":{"required":["user_id"],"type":"object","properties":{"user_id":{"type":"string","description":"Zoom user ID of the new owner.","example":"9aSWJV2rTyWwkIDWmPYsfg"}}}}}},"responses":{"204":{"description":"Nothing to return."},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  Permission denied \n\n "},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["docs_file_owner:write","docs_file_owner:write:admin","docs:update:file_owner","docs:update:file_owner:admin"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":["DocsMgt:Edit"],"x-macro-scopes":["docs_file_owner:write","docs_file_owner:write:admin"],"x-granular-scopes":["docs:update:file_owner","docs:update:file_owner:admin"]}}},"/docs/users/{userId}/root":{"get":{"tags":["File Management"],"summary":"Get user My docs info","description":"Get the specified user's My docs info. My docs is the root of a user's documents.\n\n**Example**:\n\nWhen an admin needs to list all children of another user's My docs ([/docs/files/{fileId}/children](https://s.zoom.us/u/bPFf2TRxP)), this API should be called to get the target user's My docs ID as `fileId` in path.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:read:admin`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:read:file:admin`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `LIGHT`\n\n**Not supported in Gov cluster** ","operationId":"GetUserMyDocsID","parameters":[{"name":"userId","in":"path","description":"The ID of the user you want the root directory ID of.","required":true,"schema":{"type":"string","example":"aCdqwwghR16QF4dDe1Ex_A"}}],"responses":{"200":{"description":"Returns user My Docs info.","content":{"application/json":{"schema":{"required":["root_id"],"type":"object","properties":{"root_id":{"type":"string","description":"User My Docs ID.","example":"dAdqGeghRh6QF4dDe1Ex_A"}}}}}},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  \n\n "},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  user id not found \n\n "},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["docs:read:admin","docs:read:file:admin"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":["DocsMgt:Read"],"x-macro-scopes":["docs:read:admin"],"x-granular-scopes":["docs:read:file:admin"]}}},"/docs/file_uploads":{"post":{"tags":["File Uploads"],"summary":"Create file upload for docs import or attachments","description":"Create a file upload for document import or attachments.\n\nNotes:\n- Base URL: https://fileapi.zoom.us/v2.\n- Rate limit: 20 requests per second per user or 2000 requests per second per IP address.\n- The caller must retain the Authorization header when redirected to a different hostname.\n- Unsupported file formats: `.svg`.\n- For an account-level [OAuth](https://developers.zoom.us/docs/integrations/create/) app, this API can only be used on behalf of a user who is assigned with a [role](https://support.zoom.com/hc/en/article?id=zm_kb&sysparm_article=KB0064983#h_80abad9b-86a8-492c-8a3b-5b0141a8c0a9) with Edit permission for Docs Management.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs_file_uploads:write`,`docs_file_uploads:write:admin`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:write:file_uploads`,`docs:write:file_uploads:admin`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `HEAVY`\n\n**Not supported in Gov cluster** ","operationId":"Uploadfilefordocsimportorattachments","requestBody":{"content":{"multipart/form-data":{"schema":{"required":["file"],"type":"object","properties":{"file":{"type":"string","description":"The data file to be uploaded.","example":"<binary data>"}}}}}},"responses":{"201":{"description":"File successfully created.","content":{"application/json":{"schema":{"type":"object","properties":{"file_upload_id":{"type":"string","description":"The unique ID of the file upload.","example":"aBvhhhyjQUal6HacwXlYwe"}}}}}},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  \n\n "},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["docs_file_uploads:write","docs_file_uploads:write:admin","docs:write:file_uploads","docs:write:file_uploads:admin"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":["DocsMgt:Edit"],"x-macro-scopes":["docs_file_uploads:write","docs_file_uploads:write:admin"],"x-granular-scopes":["docs:write:file_uploads","docs:write:file_uploads:admin"]}}},"/docs/files/{fileId}/general_access_setting":{"get":{"tags":["General Access"],"summary":"Get the general access setting of a file","description":"Get the general access settings of a file. Only `doc` or `data table` files are supported.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs_general_access:read`,`docs_general_access:read:admin`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:read:general_access`,`docs:read:general_access:admin`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `MEDIUM`","operationId":"GetFileGeneralAccess","parameters":[{"name":"fileId","in":"path","description":"The ID of a file in Docs.","required":true,"schema":{"type":"string","example":"_4oHCpleRgGumHa60amdKl"}}],"responses":{"200":{"description":"Return the general access setting of a file.","content":{"application/json":{"schema":{"type":"object","properties":{"general_access_setting":{"required":["share_scope"],"type":"object","properties":{"share_scope":{"type":"string","description":"The general access scope of this file.\n`collaborators_only`: only collaborators of this file can access\n`anyone_in_org`: users within the same orgnization as the file owner can access\n`anyone_with_link`: anyone can access this file, including anonymous user.","example":"anyone_in_org","enum":["collaborators_only","anyone_in_org","anyone_with_link"]},"role":{"type":"string","description":"Role to collaborate. This field is empty when `share_scope` is set to `collaborators_only`.","example":"viewer","enum":["viewer","commenter","editor"]}},"description":"The general access setting of this file."}}}}}},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  \n\n "},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  Permission Denied. \n\n "},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["docs_general_access:read","docs_general_access:read:admin","docs:read:general_access","docs:read:general_access:admin"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":["DocsMgt:Read"],"x-macro-scopes":["docs_general_access:read","docs_general_access:read:admin"],"x-granular-scopes":["docs:read:general_access","docs:read:general_access:admin"]}},"patch":{"tags":["General Access"],"summary":"Modify the general access setting of a file","description":"Modify the general access setting for a file. Only `doc` or `data table` files are supported.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs_general_access:write`,`docs_general_access:write:admin`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:update:general_access`,`docs:update:general_access:admin`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `MEDIUM`\n\n**Not supported in Gov cluster** ","operationId":"ModifyFileGeneralAccess","parameters":[{"name":"fileId","in":"path","description":"The ID of a file in Docs.","required":true,"schema":{"type":"string","example":"amgFY09ZSJOrgROOkWG77A"}}],"requestBody":{"content":{"application/json":{"schema":{"required":["general_access_setting"],"type":"object","properties":{"general_access_setting":{"required":["share_scope"],"type":"object","properties":{"share_scope":{"type":"string","description":"The general access scope of this file.\n`collaborators_only`: only collaborators of this file can access\n`anyone_in_org`: users within the same orgnization as the file owner can access\n`anyone_with_link`: anyone can access this file, including anonymous user.","example":"anyone_in_org","enum":["collaborators_only","anyone_in_org","anyone_with_link"]},"role":{"type":"string","description":"Role to collaborate. This field is empty when `share_scope` is set to `collaborators_only`.","example":"viewer","enum":["viewer","commenter","editor"]}},"description":"The general access setting."}}}}}},"responses":{"204":{"description":"Nothing to return."},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  \n\n "},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  Permission Denied. \n\n "},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  File not found. \n\n "},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["docs_general_access:write","docs_general_access:write:admin","docs:update:general_access","docs:update:general_access:admin"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":["DocsMgt:Edit"],"x-macro-scopes":["docs_general_access:write","docs_general_access:write:admin"],"x-granular-scopes":["docs:update:general_access","docs:update:general_access:admin"]}}},"/docs/import_content":{"post":{"tags":["Import"],"summary":"Create a new file from content","description":"Creates a new doc from Markdown content.\n\nThe Markdown content is limited to 100 KB in size.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs_import:write`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:write:import`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `HEAVY`\n\n**Not supported in Gov cluster** ","operationId":"createNewFileWithMarkdown","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"file_name":{"type":"string","description":"The name of the file.","example":"Q3 Plan"},"parent_id":{"type":"string","description":"The ID of the parent file. The newly created file will become a child of this parent. If this parameter is omitted, the file will be placed under **My Docs**. Use `root` to represent the top-level folder of the current user. Folders can only be created under **My Docs**, a shared folder, or another folder.","example":"fIdgryoPSZ-Jm34Ag-OX7A"},"content":{"type":"string","description":"The Markdown-formatted content. If the content is empty, an empty document will be created.","example":"# Project Overview  This document provides a concise outline for a sample project, including goals, milestones, tasks, and open questions.  ## 1. Goals  - Define the project scope clearly. - Deliver a working prototype by the target date. - Ensure documentation is complete and maintainable.  ## 2. Milestones  | Milestone | Description | Target Date | |----------|-------------|--------------| | M1 | Requirement gathering | 2025-01-15 | | M2 | Prototype ready | 2025-02-10 | | M3 | Final review | 2025-03-01 |  ## 3. Tasks  - [ ] Set up development environment   - [ ] Draft technical design   - [ ] Implement core features   - [ ] Write unit tests   - [ ] Prepare demo  ## 4. Architecture Diagram (Mermaid)  ```mermaid flowchart TD     A[Client] --> B[API Gateway]     B --> C[Service A]     B --> D[Service B]     D --> E[Database] ```  ## 5. Open Questions  - Should we adopt a monorepo structure? - Which logging strategy is preferred? - How should we structure integration tests?  ## 6. Notes  Add any additional remarks or context here."}}}}}},"responses":{"201":{"description":"The uploaded file is being converted into a doc file.","content":{"application/json":{"schema":{"required":["file_id","file_link"],"type":"object","properties":{"file_id":{"type":"string","description":"The newly created file ID.","example":"ch4L4KKgQVesEJcqdt1qIw"},"file_link":{"type":"string","description":"The URL of the file.","example":"https://docs.zoom.us/doc/ch4L4KKgQVesEJcqdt1qIw"}}}}}},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  \n\n **Error Code:** `5005` <br>\n Incorrect file format. <br>\n**Error Code:** `5109` <br>\n The size of content exceeds the limit. <br>\n**Error Code:** `5110` <br>\n The number of images exceeds the limit. <br>\n"},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["docs_import:write","docs:write:import"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":[],"x-macro-scopes":["docs_import:write"],"x-granular-scopes":["docs:write:import"]}}},"/docs/imports":{"post":{"tags":["Import"],"summary":"Create a new file by import","description":"Creates a new file from a file upload.\n\n**When importing the uploaded file as a specified type of Docs file:**\n- `doc`\n  - Upload file size limit is 10MB.\n  - The size limit for a single Block's content is 1MB.\n  - Maximum number of Blocks allowed is 20,000.\n- `data_table`\n  - Upload file size limit is 10MB.\n  - Maximum number of columns allowed in a single data table is 200.\n  - The size limit for a single Block's content is 1MB.\n  - Maximum number of Blocks allowed in a single data table is 20,000.\n\n**When importing an HTML compressed package exported from Notion into Docs:**\n  - Maximum allowed size for a single zip archive is 4GB.\n  - Maximum number of files that can be imported into Docs within a single ZIP file is 100,000.\n  - The maximum depth of parent-child relationships between files in the tree structure is 20.\n  - Maximum number of child nodes allowed per node in the tree is 2,000.\n\n\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs_import:write`,`docs_import:write:admin`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:write:import`,`docs:write:import:admin`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `HEAVY`\n\n**Not supported in Gov cluster** ","operationId":"Createanewfilebyimport","requestBody":{"content":{"application/json":{"schema":{"required":["file_upload_id","file_upload_type"],"type":"object","properties":{"file_name":{"type":"string","description":"The name of the file.","example":"Q3 Plan"},"file_type":{"type":"string","description":"The type of the file created after import.","example":"doc","default":"doc","enum":["doc","data_table"]},"parent_id":{"type":"string","description":"The ID of the parent file. The newly created file will become a child of this parent. If this parameter is omitted, the file will be placed under **My Docs**. Use `root` to represent the top-level folder of the current user. Folders can only be created under **My Docs**, a shared folder, or another folder.","example":"fIdgryoPSZ-Jm34Ag-OX7A"},"file_upload_id":{"type":"string","description":"The ID of the file upload. Ensure the file is valid, within the size limit, and in a supported format.","example":"aBvhhhyjQUal6HacwXlYwe"},"file_upload_type":{"type":"string","description":"The supported file format for upload. For file type `doc`, the supported formats are `.docx`, `.txt`, `.html` and `.md`. For file type `data_table`, the supported formats are `.xlsx` and `.csv`. For the zip file in HTML format exported from Notion, use `notion_zip`.","example":"docx","enum":["docx","txt","markdown","csv","xlsx","notion_zip","html"]},"user_id":{"type":"string","description":"When invoked with the `admin` scope, this operation runs on behalf of the specified user. Permissions are validated against that user. This parameter is required with the `admin` scope and has no effect otherwise.","example":"9BGgfjrQTayGWw_422j1Bw"}}}}}},"responses":{"201":{"description":"The uploaded file is being converted into a Docs file.","content":{"application/json":{"schema":{"required":["import_id"],"type":"object","properties":{"import_id":{"type":"string","description":"The unique ID for your import. Use this ID to check the import status via the **Get file import status** endpoint (GET /docs/imports/{importId}/status).","example":"ccbb4d8f72774741af8b8141f92e6d83"}}}}}},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  \n\n **Error Code:** `5004` <br>\n File size limit exceeded. <br>\n**Error Code:** `5005` <br>\n Incorrect file format. <br>\n**Error Code:** `20001` <br>\n Invalid `user_id` for `admin` scope. <br>\n**Error Code:** `20002` <br>\n `parent_id` file not found. <br>\n**Error Code:** `20003` <br>\n Invalid `file_type`. <br>\n"},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  Permission is needed to create children under this file. \n\n "},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  \n\n **Error Code:** `5007` <br>\n File upload does not exist. <br>\n"}},"security":[{"openapi_oauth":["docs_import:write","docs_import:write:admin","docs:write:import","docs:write:import:admin"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":["DocsMgt:Edit"],"x-macro-scopes":["docs_import:write","docs_import:write:admin"],"x-granular-scopes":["docs:write:import","docs:write:import:admin"]}}},"/docs/imports/{importId}/status":{"get":{"tags":["Import"],"summary":"Get file import status","description":"Use this API to query the status of a new file by import. Before using this API, confirm that you have invoked the API **Create a new file by import** endpoint and obtained the `import_id`.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs_import:read`,`docs_import:read:admin`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `docs:read:import`,`docs:read:import:admin`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `LIGHT`\n\n**Not supported in Gov cluster** ","operationId":"Getdocsfileimportstatus","parameters":[{"name":"importId","in":"path","description":"The unique ID for your import.","required":true,"schema":{"type":"string","example":"ccbb4d8f72774741af8b8141f92e6d83"}}],"responses":{"200":{"description":"Retrieves the docs file import result.","content":{"application/json":{"schema":{"required":["file_id","file_type","status"],"type":"object","properties":{"status":{"type":"string","description":"The status of the file created by importing an uploaded file.\n\nEnum:\n`processing` - The uploaded file is being converted.\n`succeeded` - The uploaded file has been converted successfully.\n`failed` - The uploaded file has failed to convert.","example":"processing","enum":["succeeded","processing","failed"]},"file_id":{"type":"string","description":"The file ID is `nullable`. This value is returned only when the status is `succeeded`.\n\nThe zip file in HTML format exported from Notion may contain data for one or more files; importing will only return the root ID of the imported files.","example":"ch4L4KKgQVesEJcqdt1qIw"},"file_type":{"type":"string","description":"The type of the created file.","example":"doc","enum":["doc","data_table"]}}}}}},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  \n\n "},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  \n\n "},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["docs_import:read","docs_import:read:admin","docs:read:import","docs:read:import:admin"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":["DocsMgt:Edit"],"x-macro-scopes":["docs_import:read","docs_import:read:admin"],"x-granular-scopes":["docs:read:import","docs:read:import:admin"]}}},"/docs/file_search":{"post":{"tags":["Search"],"summary":"Search files","description":"Search for files accessible to the current user by query and filters (file_types, ancestor_ids, created_by, owner_id). Pagination uses an opaque next_page_token cursor. The first page should omit next_page_token; subsequent pages must pass it back unchanged along with the same filter parameters as the initial request. Changing any filter while providing next_page_token is invalid and will result in a 400 Bad Request.\n\n**[Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `canvas_file_search:write`\n\n**[Granular Scopes](https://developers.zoom.us/docs/integrations/oauth-scopes-overview/):** `canvas:write:file_search`\n\n**[Rate Limit Label](https://marketplace.zoom.us/docs/api-reference/rate-limits#rate-limits):** `LIGHT`\n\n**Not supported in Gov cluster** ","operationId":"Search","requestBody":{"description":"Search parameters, including the keyword, optional filters, and pagination token.","content":{"application/json":{"schema":{"type":"object","properties":{"query":{"maxLength":100,"minLength":1,"type":"string","description":"Optional. The search keyword. The API matches this keyword against file titles and searchable content.","example":"quarterly review"},"created_by":{"type":"string","description":"The unique ID of the user who created the file. When set, only files created by this user are returned.","example":"WpIVEe2v321Tb90PpjE5ag"},"ancestor_ids":{"maxItems":20,"minItems":1,"type":"array","description":"Ancestor folder or shared folder IDs that limit the search scope. If omitted, the API searches all locations accessible to the current user.","items":{"type":"string","description":"The ID of an ancestor folder or shared folder.","example":"lq59G-liS6Cq213SX5FNtA"}},"file_types":{"maxItems":8,"minItems":1,"uniqueItems":true,"type":"array","description":"File type filters. If omitted, the search covers all supported file types. Supported values: `doc`, `data_table`, `meeting_agenda`, `meeting_summary`, `note`, `paper_doc`, `spreadsheet`, `presentation`.","items":{"type":"string","description":"File types to filter by.\nAllowed values: `doc`, `data_table`, `meeting_agenda`, `meeting_summary`, `note`, `paper_doc`, `spreadsheet`, `presentation`.","example":"doc","enum":["paper_doc","presentation","spreadsheet","doc","data_table","note","meeting_summary","meeting_agenda"]}},"owner_id":{"type":"string","description":"The unique ID of the user who owns the file. When set, only files owned by this user are returned.","example":"WpIVEe2v321Tb90PpjE5ag"},"page_size":{"maximum":50,"minimum":1,"type":"integer","description":"The number of files to return per page. Range: 1 to 50. If omitted, the server default is used.","example":20},"next_page_token":{"type":"string","description":"The next page token is used to paginate through large result sets. A next page token is returned whenever the set of available results exceeds the current page size.","example":"eyJ0aW1lQ3Vyc29yIjoiMjAyNS0wNC0yMVQwOTo0NTo1OC45NTJaIiwiaWRDdXJzb3IiOiJzemFsMkpmTlFteTExY1JwdkYxRWhBIn0="},"created_time_from":{"type":"string","description":"Filter results created on or after this time. Cannot be used together with `modified_time_from` or `modified_time_to`.","format":"date-time","example":"2026-02-13T00:00:00Z"},"created_time_to":{"type":"string","description":"Filter results created on or before this time. Cannot be used together with `modified_time_from` or `modified_time_to`.","format":"date-time","example":"2026-02-20T23:59:59Z"},"modified_time_from":{"type":"string","description":"Filter results modified on or after this time. Cannot be used together with `created_time_from` or `created_time_to`.","format":"date-time","example":"2026-02-13T00:00:00Z"},"modified_time_to":{"type":"string","description":"Filter results modified on or before this time. Cannot be used together with `created_time_from` or `created_time_to`.","format":"date-time","example":"2026-02-20T23:59:59Z"}}}}}},"responses":{"200":{"description":"Returns matching files and a pagination token when more results are available.","content":{"application/json":{"schema":{"required":["files"],"type":"object","properties":{"files":{"maxItems":50,"type":"array","description":"Files that match the search query and filters. An empty array means no matching files were found.","items":{"required":["file_id","file_link","file_name","file_type"],"type":"object","properties":{"file_id":{"type":"string","description":"The file's unique ID.","example":"lq59G-liS6Cq213SX5FNtA"},"file_name":{"type":"string","description":"The display name of the file.","example":"Q2 Product Review"},"file_link":{"type":"string","description":"The direct URL to open the file.","format":"uri","example":"https://docs.zoom.us/doc/eXSiwenmABCBaoH7RcA3B1"},"file_type":{"type":"string","description":"The file's normalized type. Allowed values: `doc`, `data_table`, `meeting_agenda`, `meeting_summary`, `note`, `paper_doc`, `spreadsheet`, `presentation`.","example":"doc","enum":["paper_doc","presentation","spreadsheet","doc","data_table","note","meeting_summary","meeting_agenda"]}},"description":"The file object."}},"next_page_token":{"type":"string","description":"The next page token is used to paginate through large result sets. A next page token is returned whenever the set of available results exceeds the current page size.","example":"eyJ0aW1lQ3Vyc29yIjoiMjAyNS0wNC0yMVQwOTo0NTo1OC45NTJaIiwiaWRDdXJzb3IiOiJzemFsMkpmTlFteTExY1JwdkYxRWhBIn0="}}}}}},"400":{"description":"**HTTP Status Code:** `400` <br>\n Bad Request  Possible causes: `query` is invalid or malformed; `file_types` is empty or contains unsupported types; `page_size` is out of range; `next_page_token` is invalid or expired; time range is invalid (e.g. `_from` is after `_to`); `created_time_*` and `modified_time_*` filters cannot be used simultaneously. \n\n "},"403":{"description":"**HTTP Status Code:** `403` <br>\n Forbidden  You do not have permission to search files. \n\n "},"404":{"description":"**HTTP Status Code:** `404` <br>\n Not Found  The specified ancestor folder or shared folder was not found or is unavailable. \n\n "},"429":{"description":"**HTTP Status Code:** `429` <br>\n Too Many Requests. For more information, see [rate limits](https://developers.zoom.us/docs/api/rate-limits/). \n\n "}},"security":[{"openapi_oauth":["canvas_file_search:write","canvas:write:file_search"],"openapi_authorization":[]}],"x-extensions":{"x-permissions":[],"x-macro-scopes":["canvas_file_search:write"],"x-granular-scopes":["canvas:write:file_search"]}}}},"components":{"securitySchemes":{"openapi_authorization":{"type":"apiKey","name":"Authorization","in":"header"},"openapi_oauth":{"type":"oauth2","flows":{"authorizationCode":{"authorizationUrl":"/","tokenUrl":"","refreshUrl":"","scopes":{"docs_archiving:read:admin":"docs_archiving:read:admin","docs:read:archive:admin":"docs:read:archive:admin","docs_collaborator:write":"docs_collaborator:write","docs_collaborator:write:admin":"docs_collaborator:write:admin","docs:write:collaborator":"docs:write:collaborator","docs:write:collaborator:admin":"docs:write:collaborator:admin","docs_collaborator:read":"docs_collaborator:read","docs_collaborator:read:admin":"docs_collaborator:read:admin","docs:read:list_file_collaborators":"docs:read:list_file_collaborators","docs:read:list_file_collaborators:admin":"docs:read:list_file_collaborators:admin","docs_collaborator:delete":"docs_collaborator:delete","docs_collaborator:delete:admin":"docs_collaborator:delete:admin","docs:delete:collaborator":"docs:delete:collaborator","docs:delete:collaborator:admin":"docs:delete:collaborator:admin","docs:update:collaborator":"docs:update:collaborator","docs:update:collaborator:admin":"docs:update:collaborator:admin","canvas_data_table:write":"canvas_data_table:write","canvas:write:data_table":"canvas:write:data_table","canvas_data_table