ter selecting someone. If `false`, do not send a notification message after selecting someone.","example":false}},"description":"The `people` column option."},"reaction_option":{"title":"reaction_option","required":["allow_commenter_react","display_type","icon"],"type":"object","properties":{"icon":{"required":["type","value"],"type":"object","properties":{"type":{"type":"string","description":"The icon display type. Currently only supports emoji.","example":"emoji","enum":["emoji"]},"value":{"type":"string","description":"The icon value.","example":"👍","enum":["👍","👎","🌟"]}},"description":"The icon content."},"display_type":{"type":"string","description":"The reaction icon display type.","example":"number","enum":["number","people","none"]},"allow_commenter_react":{"type":"boolean","description":"Whether a user with only commenter permission is allowed to click. If `true`, the user is allowed to click. If `false`, the user is not allowed to click.","example":false}},"description":"The `reaction` column option."},"currency_option":{"title":"currency_option","required":["decimal","format","symbol"],"type":"object","properties":{"decimal":{"type":"integer","description":"The number of decimal places.","example":1,"enum":[0,1,2,3,4,5]},"symbol":{"type":"string","description":"The currency symbol.","example":"$","enum":["$","¥","€","Ft","Rp","kr","R","CHF","DH","₹","zł","₽","₩","฿","₺","£"]},"format":{"type":"string","description":"The currency format.","example":"accounting","enum":["accounting","currency"]}},"description":"The `currency` column option."},"attachment_option":{"title":"attachment_option","required":["layout"],"type":"object","properties":{"layout":{"type":"string","description":"The attachment layout.","example":"thumbnail","enum":["thumbnail","full_width"]}},"description":"The `attachment` column option."},"url_option":{"title":"url_option","required":["display_type","open_type"],"type":"object","properties":{"display_type":{"type":"string","descriptio