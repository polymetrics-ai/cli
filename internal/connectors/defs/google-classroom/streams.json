{
  "base": {
    "auth": [
      {
        "client_id": "{{ secrets.client_id }}",
        "client_secret": "{{ secrets.client_secret }}",
        "mode": "oauth2_refresh_token",
        "refresh_token": "{{ secrets.client_refresh_token }}",
        "token_url": "https://oauth2.googleapis.com/token"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/v1/courses",
      "query": {
        "pageSize": "1"
      }
    },
    "error_map": [],
    "pagination": {
      "cursor_param": "pageToken",
      "max_pages": 100,
      "page_size": 100,
      "size_param": "pageSize",
      "token_path": "nextPageToken",
      "type": "cursor"
    },
    "url": "https://classroom.googleapis.com",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "method": "GET",
      "name": "courses",
      "path": "/v1/courses",
      "projection": "passthrough",
      "records": {
        "path": "courses"
      },
      "schema": "schemas/courses.json"
    },
    {
      "computed_fields": {
        "emailAddress": "{{ record.profile.emailAddress }}",
        "fullName": "{{ record.profile.name.fullName }}",
        "photoUrl": "{{ record.profile.photoUrl }}"
      },
      "fan_out": {
        "ids_from": {
          "request": {
            "id_field": "id",
            "path": "/v1/courses",
            "records_path": "courses"
          }
        },
        "into": {
          "path_var": "course_id"
        },
        "stamp_field": "courseId"
      },
      "method": "GET",
      "name": "teachers",
      "path": "/v1/courses/{{ fanout.id }}/teachers",
      "records": {
        "path": "teachers"
      },
      "schema": "schemas/teachers.json"
    },
    {
      "computed_fields": {
        "emailAddress": "{{ record.profile.emailAddress }}",
        "fullName": "{{ record.profile.name.fullName }}",
        "photoUrl": "{{ record.profile.photoUrl }}"
      },
      "fan_out": {
        "ids_from": {
          "request": {
            "id_field": "id",
            "path": "/v1/courses",
            "records_path": "courses"
          }
        },
        "into": {
          "path_var": "course_id"
        },
        "stamp_field": "courseId"
      },
      "method": "GET",
      "name": "students",
      "path": "/v1/courses/{{ fanout.id }}/students",
      "records": {
        "path": "students"
      },
      "schema": "schemas/students.json"
    },
    {
      "fan_out": {
        "ids_from": {
          "request": {
            "id_field": "id",
            "path": "/v1/courses",
            "records_path": "courses"
          }
        },
        "into": {
          "path_var": "course_id"
        },
        "stamp_field": "courseId"
      },
      "method": "GET",
      "name": "course_work",
      "path": "/v1/courses/{{ fanout.id }}/courseWork",
      "records": {
        "path": "courseWork"
      },
      "schema": "schemas/course_work.json"
    },
    {
      "fan_out": {
        "ids_from": {
          "request": {
            "id_field": "id",
            "path": "/v1/courses",
            "records_path": "courses"
          }
        },
        "into": {
          "path_var": "course_id"
        },
        "stamp_field": "courseId"
      },
      "method": "GET",
      "name": "announcements",
      "path": "/v1/courses/{{ fanout.id }}/announcements",
      "records": {
        "path": "announcements"
      },
      "schema": "schemas/announcements.json"
    }
  ]
}
