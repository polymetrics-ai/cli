{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "auth": [
      {
        "mode": "bearer",
        "token": "{{ secrets.api_token }}"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/api/raw-data/export/app/{{ config.app_id }}/installs_report/v5"
    },
    "error_map": [
      {
        "status": 401,
        "hint": "appsflyer api_token is missing or invalid; re-run pm credentials add appsflyer"
      },
      {
        "status": 403,
        "hint": "appsflyer account lacks access for this app_id"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "appsflyer rate limit exceeded; the connector will retry with backoff"
      }
    ]
  },
  "streams": [
    {
      "name": "installs_report",
      "path": "/api/raw-data/export/app/{{ config.app_id }}/installs_report/v5",
      "records": {
        "path": ""
      },
      "projection": "passthrough",
      "schema": "schemas/installs_report.json"
    },
    {
      "name": "in_app_events_report",
      "path": "/api/raw-data/export/app/{{ config.app_id }}/in_app_events_report/v5",
      "records": {
        "path": ""
      },
      "projection": "passthrough",
      "schema": "schemas/in_app_events_report.json"
    }
  ]
}
