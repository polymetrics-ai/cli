{
  "base": {
    "url": "{{ config.base_url }}",
    "auth": [
      {
        "mode": "custom",
        "hook": "mixpanel"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/account"
    },
    "error_map": [
      {
        "status": 401,
        "hint": "mixpanel credentials are missing or invalid; re-run pm credentials add mixpanel"
      },
      {
        "status": 403,
        "hint": "mixpanel service account lacks access for this request"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "mixpanel rate limit exceeded; retry with backoff"
      }
    ],
    "pagination": {
      "type": "none",
      "page_size": 1000
    }
  },
  "streams": [
    {
      "name": "list_lookup_tables",
      "method": "GET",
      "path": "/lookup-tables",
      "query": {
        "project_id": "{{ config.project_id }}"
      },
      "records": {
        "path": "."
      },
      "schema": "schemas/list_lookup_tables.json"
    },
    {
      "name": "activity_stream_query",
      "method": "GET",
      "path": "/stream/query",
      "query": {
        "project_id": "{{ config.project_id }}",
        "workspace_id": {
          "value": "{{ config.workspace_id }}",
          "omit_when_absent": true
        },
        "distinct_ids": "{{ config.distinct_ids }}",
        "from_date": "{{ config.from_date }}",
        "to_date": "{{ config.to_date }}"
      },
      "records": {
        "path": "results.events"
      },
      "schema": "schemas/activity_stream_query.json"
    },
    {
      "name": "list_all_schemas_for_project",
      "method": "GET",
      "path": "/projects/{{ config.projectId }}/schemas",
      "records": {
        "path": "results"
      },
      "schema": "schemas/list_all_schemas_for_project.json"
    },
    {
      "name": "list_schemas_for_entity",
      "method": "GET",
      "path": "/projects/{{ config.projectId }}/schemas/{{ config.entityType }}",
      "query": {
        "entity_name": {
          "value": "{{ config.entity_name }}",
          "omit_when_absent": true
        }
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/list_schemas_for_entity.json"
    },
    {
      "name": "list_schemas_by_entity_and_name",
      "method": "GET",
      "path": "/projects/{{ config.projectId }}/schemas/{{ config.entityType }}/{{ config.name }}",
      "records": {
        "path": "results"
      },
      "schema": "schemas/list_schemas_by_entity_and_name.json"
    },
    {
      "name": "list_warehouse_pipeline_jobs",
      "method": "GET",
      "path": "/nessie/pipeline/jobs",
      "query": {
        "project_id": "{{ config.project_id }}"
      },
      "records": {
        "path": "."
      },
      "schema": "schemas/list_warehouse_pipeline_jobs.json"
    },
    {
      "name": "get_warehouse_pipeline_status",
      "method": "GET",
      "path": "/nessie/pipeline/status",
      "query": {
        "project_id": "{{ config.project_id }}",
        "name": "{{ config.name }}",
        "summary": {
          "value": "{{ config.summary }}",
          "omit_when_absent": true
        },
        "status": {
          "value": "{{ config.status }}",
          "omit_when_absent": true
        }
      },
      "records": {
        "path": "."
      },
      "schema": "schemas/get_warehouse_pipeline_status.json"
    },
    {
      "name": "list_warehouse_pipeline_sync_dates",
      "method": "GET",
      "path": "/nessie/pipeline/timeline",
      "query": {
        "project_id": "{{ config.project_id }}",
        "name": {
          "value": "{{ config.name }}",
          "omit_when_absent": true
        }
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/list_warehouse_pipeline_sync_dates.json"
    },
    {
      "name": "list_service_accounts",
      "method": "GET",
      "path": "/organizations/{{ config.organizationId }}/service-accounts",
      "records": {
        "path": "results"
      },
      "schema": "schemas/list_service_accounts.json"
    },
    {
      "name": "get_service_account",
      "method": "GET",
      "path": "/organizations/{{ config.organizationId }}/service-accounts/{{ config.serviceAccountId }}",
      "records": {
        "path": "results"
      },
      "schema": "schemas/get_service_account.json"
    },
    {
      "name": "list_project_service_accounts",
      "method": "GET",
      "path": "/projects/{{ config.projectId }}/service-accounts",
      "records": {
        "path": "results"
      },
      "schema": "schemas/list_project_service_accounts.json"
    },
    {
      "name": "list_all_annotations_for_project",
      "method": "GET",
      "path": "/projects/{{ config.projectId }}/annotations",
      "query": {
        "fromDate": {
          "value": "{{ config.fromDate }}",
          "omit_when_absent": true
        },
        "toDate": {
          "value": "{{ config.toDate }}",
          "omit_when_absent": true
        }
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/list_all_annotations_for_project.json"
    },
    {
      "name": "get_annotation",
      "method": "GET",
      "path": "/projects/{{ config.projectId }}/annotations/{{ config.annotationId }}",
      "records": {
        "path": "results"
      },
      "schema": "schemas/get_annotation.json"
    },
    {
      "name": "get_annotation_tags",
      "method": "GET",
      "path": "/projects/{{ config.projectId }}/annotations/tags",
      "records": {
        "path": "results"
      },
      "schema": "schemas/get_annotation_tags.json"
    },
    {
      "name": "get_retrieval",
      "method": "GET",
      "path": "/data-retrievals/v3.0/{{ config.tracking_id }}",
      "query": {
        "token": "{{ secrets.project_token }}"
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/get_retrieval.json"
    },
    {
      "name": "get_deletion",
      "method": "GET",
      "path": "/data-deletions/v3.0/{{ config.tracking_id }}",
      "query": {
        "token": "{{ secrets.project_token }}"
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/get_deletion.json"
    },
    {
      "name": "list_warehouse_imports",
      "method": "GET",
      "path": "/projects/{{ config.projectId }}/warehouse-sources/imports",
      "records": {
        "path": "results"
      },
      "schema": "schemas/list_warehouse_imports.json"
    },
    {
      "name": "get_warehouse_import",
      "method": "GET",
      "path": "/projects/{{ config.projectId }}/warehouse-sources/imports/{{ config.importId }}",
      "records": {
        "path": "results"
      },
      "schema": "schemas/get_warehouse_import.json"
    },
    {
      "name": "get_import_history",
      "method": "GET",
      "path": "/projects/{{ config.projectId }}/warehouse-sources/imports/{{ config.importId }}/history",
      "records": {
        "path": "results.runs"
      },
      "schema": "schemas/get_import_history.json"
    },
    {
      "name": "get_variant_assignments",
      "method": "GET",
      "path": "/flags",
      "query": {
        "token": {
          "value": "{{ secrets.project_token }}",
          "omit_when_absent": true
        },
        "project_id": {
          "value": "{{ config.project_id }}",
          "omit_when_absent": true
        },
        "context": "{{ config.context }}"
      },
      "records": {
        "path": "flags",
        "keyed_object": true,
        "key_field": "flag_key"
      },
      "schema": "schemas/get_variant_assignments.json"
    },
    {
      "name": "get_flag_definitions",
      "method": "GET",
      "path": "/flags/definitions",
      "query": {
        "token": {
          "value": "{{ secrets.project_token }}",
          "omit_when_absent": true
        },
        "project_id": {
          "value": "{{ config.project_id }}",
          "omit_when_absent": true
        }
      },
      "records": {
        "path": "flags",
        "keyed_object": true,
        "key_field": "flag_key"
      },
      "schema": "schemas/get_flag_definitions.json"
    },
    {
      "name": "list_feature_flags",
      "method": "GET",
      "path": "/projects/{{ config.project_id }}/workspaces/{{ config.workspace_id }}/feature-flags",
      "query": {
        "include_archived": {
          "value": "{{ config.include_archived }}",
          "omit_when_absent": true
        }
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/list_feature_flags.json"
    },
    {
      "name": "get_feature_flag",
      "method": "GET",
      "path": "/projects/{{ config.project_id }}/workspaces/{{ config.workspace_id }}/feature-flags/{{ config.flag_id }}",
      "records": {
        "path": "results"
      },
      "schema": "schemas/get_feature_flag.json"
    },
    {
      "name": "list_experiments",
      "method": "GET",
      "path": "/workspaces/{{ config.workspace_id }}/experiments",
      "records": {
        "path": "results"
      },
      "schema": "schemas/list_experiments.json"
    },
    {
      "name": "get_experiment",
      "method": "GET",
      "path": "/workspaces/{{ config.workspace_id }}/experiments/{{ config.experiment_id }}",
      "records": {
        "path": "results"
      },
      "schema": "schemas/get_experiment.json"
    }
  ]
}
