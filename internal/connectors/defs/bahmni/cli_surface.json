        "lab_orders",
        "lab_results"
      ]
    },
    {
      "id": "scheduling",
      "title": "Scheduling",
      "commands": [
        "appointments"
      ]
    },
    {
      "id": "direct-reads",
      "title": "Direct reads",
      "commands": [
        "patient",
        "encounter",
        "visit",
        "concept",
        "provider",
        "location",
        "fhir",
