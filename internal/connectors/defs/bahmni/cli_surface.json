  ],
  "global_flags": [
    {
      "name": "credential",
      "type": "string",
      "summary": "Credential name to use for the Bahmni request."
    },
    {
      "name": "connection",
      "type": "string",
      "summary": "Alias for --credential."
    },
    {
      "name": "config",
      "type": "string_array",
      "summary": "Connector config override as key=value."
    },
    {
      "name": "json",
      "type": "boolean",
      "summary": "Emit machine-readable JSON output."
    },
    {
      "name": "limit",
      "type": "integer",
      "summary": "Maximum ETL records to emit for stream commands."
    },
    {
      "name": "max-bytes",
      "type": "integer",
      "summary": "Maximum direct-read response bytes; typed operations declare their own lower cap."
    },
    {
      "name": "plan",
      "type": "string",
      "summary": "Execute an approved reverse-ETL plan by id."
    },
    {
      "name": "preview",
      "type": "boolean",
      "summary": "Preview a reverse-ETL write command without making a network mutation."
    },
    {
      "name": "approval-token-stdin",
      "type": "boolean",
      "summary": "Read the approval token as one bounded line from standard input."
    },
    {
      "name": "confirm",
      "type": "string",
      "summary": "Typed confirmation challenge for destructive reverse-ETL writes."
    }
  ],
