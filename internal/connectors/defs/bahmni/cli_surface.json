    {
      "path": "bahmnicore patient-search",
      "summary": "Search patients with the pinned bahmni-commons GET patient search route.",
      "intent": "direct_read",
      "availability": "implemented",
      "operation": "bahmni.patient_search",
      "risk": "bounded typed GET read-query; the response is size-capped, secret-shaped fields are redacted, and the operation direct-read engine redacts declared patient-search sensitive fields including identifier, addressFieldValue, display, givenName, middleName, familyName, birthDate, and deathDate. Remaining clinical PHI fields should still be treated as clinical data.",
      "approval": "none: read-only GET query with allow-listed query parameters and bounded JSON output.",
      "notes": "Executes through the typed operation direct-read engine; no raw request body or generic HTTP flag is exposed.",
      "output_policy": "clinical_json_redacted",
      "api_surface": [
        {
          "method": "GET",
          "path": "/ws/rest/v1/bahmni/search/patient"
        }
      ],
      "flags": [
        {
          "name": "q",
          "type": "string",
          "summary": "Free-text patient name or identifier search term.",
          "maps_to": "query.q"
        },
        {
          "name": "identifier",
          "type": "string",
          "summary": "Exact patient identifier.",
          "maps_to": "query.identifier"
        },
        {
          "name": "address-field-name",
          "type": "string",
          "summary": "Address field to filter on, e.g. city_village.",
          "maps_to": "query.addressFieldName"
        },
        {
          "name": "address-field-value",
          "type": "string",
          "summary": "Address field value to match.",
          "maps_to": "query.addressFieldValue"
        },
        {
          "name": "login-location-uuid",
          "type": "string",
          "summary": "Login/deployment location UUID scoping the search.",
          "maps_to": "query.loginLocationUuid"
        },
        {
          "name": "start-index",
          "type": "integer",
          "summary": "Zero-based result offset for bounded paging.",
          "maps_to": "query.startIndex"
        }
      ],
      "examples": [
        "pm bahmni bahmnicore patient-search --json --q <name> --max-bytes 1048576"
      ],
      "source_url": "https://github.com/Bahmni/openmrs-module-bahmnicommons/blob/1.1.0/bahmni-commons-omod/src/main/java/org/bahmni/module/bahmnicommons/web/v1_0/controller/search/BahmniPatientSearchController.java#L30-L50",
      "redact_fields": [
        "identifier",
        "addressFieldValue",
        "display",
        "givenName",
        "middleName",
        "familyName",
        "birthDate",
        "deathDate"
      ]
    },
    {
      "path": "patients create",
      "summary": "Create a Bahmni/OpenMRS patient record (clinical PHI).",
      "intent": "reverse_etl",
      "availability": "implemented",
      "write": "create_patient",
      "flags": [
        {
          "name": "identifier",
          "type": "string",
          "summary": "Synthetic patient identifier.",
          "maps_to": "record.identifiers.0.identifier"
        },
        {
          "name": "identifier-type",
          "type": "string",
          "summary": "OpenMRS patient identifier type UUID.",
          "maps_to": "record.identifiers.0.identifierType"
        },
        {
          "name": "identifier-location",
          "type": "string",
          "summary": "OpenMRS location UUID for the identifier.",
          "maps_to": "record.identifiers.0.location"
        },
        {
          "name": "identifier-preferred",
          "type": "boolean",
          "summary": "Whether this identifier is preferred.",
          "maps_to": "record.identifiers.0.preferred"
        },
        {
          "name": "given-name",
          "type": "string",
          "summary": "Patient given name.",
          "maps_to": "record.person.names.0.givenName"
        },
        {
          "name": "family-name",
          "type": "string",
          "summary": "Patient family name.",
          "maps_to": "record.person.names.0.familyName"
        },
        {
          "name": "middle-name",
          "type": "string",
          "summary": "Optional patient middle name.",
          "maps_to": "record.person.names.0.middleName"
        },
        {
          "name": "gender",
          "type": "enum",
          "summary": "OpenMRS gender enum.",
          "maps_to": "record.person.gender",
          "values": [
            "M",
            "F",
            "O"
          ]
        },
        {
          "name": "birthdate",
          "type": "string",
          "summary": "Patient birthdate.",
          "maps_to": "record.person.birthdate"
        },
        {
          "name": "address1",
          "type": "string",
          "summary": "Optional first address line.",
          "maps_to": "record.person.addresses.0.address1"
        },
        {
          "name": "city-village",
          "type": "string",
          "summary": "Optional city/village.",
          "maps_to": "record.person.addresses.0.cityVillage"
        },
        {
          "name": "state-province",
          "type": "string",
          "summary": "Optional state/province.",
          "maps_to": "record.person.addresses.0.stateProvince"
        },
        {
          "name": "country",
          "type": "string",
          "summary": "Optional country code/name.",
          "maps_to": "record.person.addresses.0.country"
        },
        {
          "name": "postal-code",
          "type": "string",
          "summary": "Optional postal code.",
          "maps_to": "record.person.addresses.0.postalCode"
