{
  "tagline": "Inspect, read, and safely plan typed Bahmni clinical operations.",
  "usage": "pm bahmni <command> [flags]",
  "source_cli": {
    "name": "Bahmni / OpenMRS REST + FHIR2",
    "docs": "https://rest.openmrs.org/",
    "reference": "OpenMRS REST v1, Bahmni-core REST, OpenMRS FHIR2 R4",
    "source": "provider_api"
  },
  "groups": [
    {
      "id": "clinical",
      "title": "Clinical data",
      "commands": [
        "patients",
        "encounters",
        "observations",
        "visits",
        "diagnoses"
      ]
    },
    {
      "id": "catalog",
      "title": "Catalog & reference",
