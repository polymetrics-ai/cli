{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "auth": [
      {
        "mode": "basic",
        "username": "{{ config.username }}",
        "password": "{{ secrets.password }}"
      }
    ],
    "pagination": {
      "type": "offset_limit",
      "limit_param": "limit",
      "offset_param": "startIndex",
      "page_size": 50,
      "max_pages": 100
    },
    "check": {
      "method": "GET",
      "path": "/ws/rest/v1/provider",
      "query": {
        "v": "default",
        "limit": "1"
      }
    },
    "error_map": [
      {
        "status": 401,
        "hint": "bahmni username/password are missing or invalid; re-run pm credentials add bahmni"
      },
      {
        "status": 403,
        "hint": "bahmni account lacks privileges for this OpenMRS/Bahmni resource"
      },
      {
        "status": 404,
        "hint": "bahmni resource not found; check the base_url path and the requested uuid"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "bahmni request throttled; the connector will retry with backoff"
      }
    ]
  },
  "streams": [
    {
      "name": "patients",
      "path": "/ws/rest/v1/patient",
      "query": {
        "q": {
          "template": "{{ config.patient_query }}"
        },
        "v": "default"
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/patients.json"
    },
    {
      "name": "encounters",
      "path": "/ws/rest/v1/encounter",
      "query": {
        "patient": {
          "template": "{{ config.patient_uuid }}"
        },
        "v": "default"
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/encounters.json"
    },
    {
      "name": "observations",
      "path": "/ws/rest/v1/obs",
      "query": {
        "patient": {
          "template": "{{ config.patient_uuid }}"
        },
        "v": "default"
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/observations.json"
    },
    {
      "name": "visits",
      "path": "/ws/rest/v1/visit",
      "query": {
        "patient": {
          "template": "{{ config.patient_uuid }}"
        },
        "v": "default"
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/visits.json"
    },
    {
      "name": "concepts",
      "path": "/ws/rest/v1/concept",
      "query": {
        "v": "default"
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/concepts.json"
    },
    {
      "name": "locations",
      "path": "/ws/rest/v1/location",
      "query": {
        "v": "default"
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/locations.json"
    },
    {
      "name": "providers",
      "path": "/ws/rest/v1/provider",
      "query": {
        "v": "default"
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/providers.json"
    },
    {
      "name": "drug_orders",
      "path": "/ws/rest/v1/bahmnicore/drugOrders/active",
      "query": {
        "patientUuid": {
          "template": "{{ config.patient_uuid }}"
        }
      },
      "records": {
        "path": ""
      },
      "schema": "schemas/drug_orders.json",
      "pagination": {
        "type": "none"
      }
    },
    {
      "name": "lab_orders",
      "path": "/ws/rest/v1/order",
      "query": {
        "patient": {
          "template": "{{ config.patient_uuid }}"
        },
        "t": "testorder",
        "v": "full"
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/lab_orders.json"
    },
    {
      "name": "lab_results",
      "path": "/ws/rest/v1/bahmnicore/observations",
      "query": {
        "patientUuid": {
          "template": "{{ config.patient_uuid }}"
        },
        "concept": {
          "template": "{{ config.lab_result_concepts }}"
        },
        "scope": "latest"
      },
      "records": {
        "path": ""
      },
      "schema": "schemas/lab_results.json",
      "pagination": {
        "type": "none"
      }
    },
    {
      "name": "appointments",
      "path": "/ws/rest/v1/appointments",
      "query": {
        "forDate": {
          "template": "{{ config.appointment_date }}"
        }
      },
      "records": {
        "path": ""
      },
      "schema": "schemas/appointments.json",
      "pagination": {
        "type": "none"
      }
    },
    {
      "name": "diagnoses",
      "path": "/ws/rest/v1/bahmnicore/diagnosis/search",
      "query": {
        "patientUuid": {
          "template": "{{ config.patient_uuid }}"
        }
      },
      "records": {
        "path": ""
      },
      "schema": "schemas/diagnoses.json",
      "pagination": {
        "type": "none"
      }
    }
  ]
}
