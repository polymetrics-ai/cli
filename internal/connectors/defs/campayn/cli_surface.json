{
  "tagline": "Run Campayn's declared streams and reverse-ETL actions.",
  "usage": "pm campayn \u003ccommand\u003e [flags]",
  "groups": [
    {
      "id": "read",
      "title": "Read streams",
      "commands": [
        "api get contacts contact-id json",
        "api get lists list-id forms form-id json",
        "contacts list",
        "emails list",
        "forms list",
        "lists list",
        "reports list"
      ]
    },
    {
      "id": "write",
      "title": "Reverse ETL writes",
      "commands": [
        "add contact apply",
        "api post signup",
        "unsubscribe contact apply",
        "update contact apply"
      ]
    }
  ],
  "commands": [
    {
      "path": "add contact apply",
      "summary": "Plan and execute the add contact reverse-ETL action",
      "intent": "reverse_etl",
      "availability": "implemented",
      "write": "add_contact",
      "source_url": "https://github.com/nebojsac/Campayn-API",
      "flags": [
        {
          "name": "email",
          "type": "string",
          "summary": "Required email record field.",
          "maps_to": "record.email",
          "required": true
        },
        {
          "name": "list_id",
          "type": "string",
          "summary": "Required list id record field.",
          "maps_to": "record.list_id",
          "required": true
        }
      ],
      "examples": [
        "pm campayn add contact apply --plan \u003cplan-name\u003e"
      ],
      "api_surface": [
        {
          "method": "POST",
          "path": "/lists/{list_id}/contacts.json"
        }
      ],
      "risk": "adds a new contact to a Campayn subscriber list; low-risk external mutation, no approval required",
      "approval": "requires plan, preview, approval, and execute"
    },
