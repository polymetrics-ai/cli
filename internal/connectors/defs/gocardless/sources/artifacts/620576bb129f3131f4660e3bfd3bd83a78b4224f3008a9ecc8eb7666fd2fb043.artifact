    "/billing_requests/{billing_request_id}/actions/fallback": {
      "post": {
        "operationId": "fallback_billing_request",
        "summary": "Trigger fallback",
        "description": "Triggers a fallback from the open-banking flow to direct debit. Note, the billing request must have fallback enabled.\n\n<p class=\"restricted-notice\"><strong>Restricted</strong>: this endpoint is restricted to [GoCardless Pro](https://gocardless.com/pricing) and [GoCardless Enterprise](https://gocardless.com/pricing) accounts with the [custom payment pages upgrade](https://hub.gocardless.com/s/article/Custom-payment-pages).</p>",
