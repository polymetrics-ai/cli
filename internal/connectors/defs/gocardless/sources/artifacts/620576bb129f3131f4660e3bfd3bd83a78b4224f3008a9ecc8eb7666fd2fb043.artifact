    "/billing_requests/{billing_request_id}/actions/collect_customer_details": {
      "post": {
        "operationId": "collect_customer_details_billing_request",
        "summary": "Collect customer details",
        "description": "If the billing request has a pending <code>collect_customer_details</code>\naction, this endpoint can be used to collect the details in order to\ncomplete it.\n\nThe endpoint takes the same payload as Customers, but checks that the\ncustomer fields are populated correctly for the billing request scheme.\n\nWhatever is provided to this endpoint is used to update the referenced\ncustomer, and will take effect immediately after the request is\nsuccessful.",
        "tags": [
          "Billing Request"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GoCardlessVersionHeader"
          },
          {
            "name": "billing_request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The billing request id"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/billing_request_single_resource_response"
                }
              }
            },
            "description": "Action completed successfully"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "billing_requests": {
                    "type": "object",
                    "properties": {
                      "customer": {
                        "type": "object",
                        "properties": {
                          "email": {
                            "$ref": "#/components/schemas/customer_email"
                          },
                          "given_name": {
                            "$ref": "#/components/schemas/customer_given_name"
                          },
                          "family_name": {
                            "$ref": "#/components/schemas/customer_family_name"
                          },
                          "company_name": {
                            "$ref": "#/components/schemas/customer_company_name"
                          },
                          "language": {
                            "type": "string",
                            "nullable": true,
                            "description": " [ISO 639-1](https://en.wikipedia.org/wiki/List_of_ISO_639-1_codes) code. Used as the language for notification emails sent by GoCardless if your organisation does not send its own (see [compliance requirements](#appendix-compliance-requirements)). Currently only \"en\", \"fr\", \"de\", \"pt\", \"es\", \"it\", \"nl\", \"da\", \"nb\", \"sl\", \"sv\" are supported. If this is not provided and a customer was linked during billing request creation, the linked customer language will be used. Otherwise, the language is default to \"en\".",
                            "example": "en"
                          },
                          "phone_number": {
                            "$ref": "#/components/schemas/customer_phone_number"
                          },
                          "metadata": {
                            "$ref": "#/components/schemas/customer_metadata"
                          }
                        }
                      },
                      "customer_billing_detail": {
                        "type": "object",
                        "properties": {
                          "address_line1": {
                            "$ref": "#/components/schemas/customer_address_line1"
                          },
                          "address_line2": {
                            "$ref": "#/components/schemas/customer_address_line2"
                          },
                          "address_line3": {
                            "$ref": "#/components/schemas/customer_address_line3"
                          },
                          "city": {
                            "$ref": "#/components/schemas/customer_city"
                          },
                          "region": {
                            "$ref": "#/components/schemas/customer_region"
                          },
                          "postal_code": {
                            "$ref": "#/components/schemas/customer_postal_code"
                          },
                          "country_code": {
                            "$ref": "#/components/schemas/customer_country_code"
                          },
                          "swedish_identity_number": {
                            "$ref": "#/components/schemas/customer_swedish_identity_number"
                          },
                          "danish_identity_number": {
                            "$ref": "#/components/schemas/customer_danish_identity_number"
                          },
                          "ip_address": {
                            "$ref": "#/components/schemas/mandate_payer_ip_address"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
