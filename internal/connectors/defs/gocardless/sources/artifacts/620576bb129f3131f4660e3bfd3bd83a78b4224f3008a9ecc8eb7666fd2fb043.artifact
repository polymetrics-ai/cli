            "label": "Go",
            "source": "refundListParams := gocardless.RefundListParams{\n  Mandate: \"MD123\",\n}\nrefundListResult, err := client.Refunds.List(ctx, refundListParams)\nfor _, refund := range refundListResult.Refunds {\n    fmt.Println(refund.Id)\n}"
          },
          {
            "lang": "C#",
            "label": ".NET",
            "source": "var refundRequest = new GoCardless.Services.RefundListRequest()\n{\n    Mandate = \"MD0123\"\n};\n\nvar refundListResponse = client.Refunds.All(refundRequest);\nforeach (GoCardless.Resources.Refund refund in refundListResponse)\n{\n    Console.WriteLine(refund.Id);\n}"
          },
          {
            "lang": "HTTP",
            "label": "HTTP",
            "source": "GET https://api.gocardless.com/refunds HTTP/1.1\n\nHTTP/1.1 200 OK\nContent-Type: application/json\n{\n  \"meta\": {\n    \"cursors\": {\n      \"before\": null,\n      \"after\": null\n    },\n    \"limit\": 50\n  },\n  \"refunds\": [{\n    \"id\": \"RF123\",\n    \"created_at\": \"2014-05-08T17:01:06.000Z\",\n    \"amount\": 100,\n    \"currency\": \"GBP\",\n    \"reference\": \"Acme refund\",\n    \"fx\": {\n      \"fx_currency\": \"EUR\",\n      \"fx_amount\": null,\n      \"exchange_rate\": null,\n      \"estimated_exchange_rate\": \"1.1234567890\"\n    },\n    \"status\": \"created\",\n    \"metadata\": {\n      \"reason\": \"late failure\"\n    },\n    \"links\": {\n      \"payment\": \"PM123\"\n    }\n  }]\n}"
          }
        ]
      }
    },
