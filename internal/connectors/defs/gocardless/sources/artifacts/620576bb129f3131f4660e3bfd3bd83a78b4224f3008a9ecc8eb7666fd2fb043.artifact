        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mandate_imports": {
                    "type": "object",
                    "properties": {
                      "scheme": {
                        "description": "A bank payment scheme. Currently \"ach\", \"autogiro\", \"bacs\", \"becs\", \"becs_nz\", \"betalingsservice\", \"faster_payments\", \"pad\", \"pay_to\" and \"sepa_core\" are supported.",
                        "example": "bacs",
                        "enum": [
                          "ach",
                          "autogiro",
                          "bacs",
                          "becs",
                          "becs_nz",
                          "betalingsservice",
                          "faster_payments",
                          "pad",
                          "pay_to",
                          "sepa_core"
                        ],
                        "type": "string"
                      },
                      "links": {
                        "type": "object",
                        "description": "Related resources",
                        "properties": {
                          "creditor": {
                            "type": "string",
                            "description": "ID of the associated creditor. Only required if your account manages multiple creditors.",
                            "example": "CR123"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
