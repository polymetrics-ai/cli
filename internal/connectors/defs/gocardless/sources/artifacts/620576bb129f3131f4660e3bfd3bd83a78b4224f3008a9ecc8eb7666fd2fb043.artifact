          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/bank_account_detail_single_resource_response"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "Ruby",
            "label": "Ruby",
            "source": "@client.bank_account_details.get(\"BA123\",\n  headers: { 'Gc-Key-Id' => 'PK123' }\n)"
          },
          {
            "lang": "Python",
            "label": "Python",
            "source": "client.bank_account_details.get(\"BA123\",\n  headers={'Gc-Key-Id': 'PK123'}\n)"
          },
          {
            "lang": "JavaScript",
            "label": "JavaScript",
            "source": "const resp = await client.bankAccountDetails.find(\"BA123\", {\n  \"Gc-Key-Id\": \"PK123\",\n});"
          },
          {
            "lang": "PHP",
            "label": "PHP",
            "source": "$client->bankAccountDetails()->get(\"BA123\", [\n  \"headers\" => ['Gc-Key-Id' => 'PK123']\n]);"
          },
          {
            "lang": "Java",
            "label": "Java",
            "source": "client.bankAccountDetails().get(\"BA123\").withHeader(\"Gc-Key-Id\", \"PK123\").execute();"
          },
          {
            "lang": "Go",
            "label": "Go",
            "source": "headers := map[string]string{\n  \"Gc-Key-Id\": \"PK123\",\n}\n\nbankAccountDetails, err := client.BankAccountDetails.Get(\n  ctx,\n  \"BA123\",\n  gocardless.BankAccountDetailGetParams{},\n  gocardless.WithHeaders(headers),\n)"
          },
          {
