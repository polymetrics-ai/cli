            "lang": "Go",
            "label": "Go",
            "source": "mandateImportCreateParams := gocardless.MandateImportCreateParams{\n  Scheme: \"bacs\",\n}\n\nmandateImport, err := client.MandateImports.Create(ctx, mandateImportCreateParams)"
          },
