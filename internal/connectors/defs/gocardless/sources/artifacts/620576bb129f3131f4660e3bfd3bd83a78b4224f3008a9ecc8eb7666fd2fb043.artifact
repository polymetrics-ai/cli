    "/billing_requests/{billing_request_id}/actions/choose_currency": {
      "post": {
        "operationId": "choose_currency_billing_request",
        "summary": "Change currency",
        "description": "This will allow for the updating of the currency and subsequently the scheme if\nneeded for a Billing Request. This will only be available for mandate only flows\nwhich do not have the lock_currency flag set to true on the Billing Request Flow. It\nwill also not support any request which has a payments request.",
