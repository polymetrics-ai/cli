    "/branding/payer_themes": {
      "post": {
        "operationId": "payer_themes_branding",
        "summary": "Create a payer theme associated with a creditor",
        "description": "Creates a new payer theme associated with a creditor. If a creditor already has payer themes, this will update the existing payer theme linked to the creditor.\n\n<p class=\"restricted-notice\"><strong>Restricted</strong>: This endpoint is restricted to GoCardless Embed customers. Please [contact us](https://forms.gocardless.com/l/305971/2023-01-25/535t8n){:target=\"_blank\"} if you are interested in using this product.</p>",
        "tags": [
          "Payer Theme"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GoCardlessVersionHeader"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/payer_theme_single_resource_response"
                }
              }
            },
            "description": "Resource created successfully"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "payer_themes": {
                    "type": "object",
                    "properties": {
                      "header_background_colour": {
                        "type": "string",
                        "description": "Colour for header background (hexcode)",
                        "example": "#FFFFFF"
                      },
                      "link_text_colour": {
                        "type": "string",
                        "description": "Colour for text links (hexcode)",
                        "example": "#3179D9"
                      },
                      "button_background_colour": {
                        "type": "string",
                        "description": "Colour for buttons background (hexcode)",
                        "example": "#00A87E"
                      },
                      "content_box_border_colour": {
                        "type": "string",
                        "description": "Colour for content box border (hexcode)",
                        "example": "#D7D9DE"
                      },
                      "links": {
                        "type": "object",
                        "description": "",
                        "properties": {
                          "creditor": {
                            "type": "string",
                            "nullable": true,
                            "description": "ID of the creditor the payer theme belongs to",
                            "example": "CR1234"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "Ruby",
            "label": "Ruby",
            "source": "@client.payer_themes.create_for_creditor(\n  params: {\n    \"header_background_colour\": \"#BD10E0\",\n    \"link_text_colour\": \"#7ED321\",\n    \"button_background_colour\": \"#128DAA\",\n    \"content_box_border_colour\": \"#BD10E0\",\n    \"links\": {\n      \"creditor\": \"CR123\"\n    }\n  }\n)"
          },
          {
            "lang": "Python",
            "label": "Python",
            "source": "client.payer_themes.create_for_creditor(params={\n  \"header_background_colour\": \"#BD10E0\",\n  \"link_text_colour\": \"#7ED321\",\n  \"button_background_colour\": \"#128DAA\",\n  \"content_box_border_colour\": \"#BD10E0\",\n  \"links\": {\n    \"creditor\": \"CR123\"\n  }\n})"
          },
          {
            "lang": "JavaScript",
            "label": "JavaScript",
            "source": "const payerThemes = await client.payerThemes.createForCreditor({\n  header_background_colour: \"#BD10E0\",\n  link_text_colour: \"#7ED321\",\n  button_background_colour: \"#128DAA\",\n  content_box_border_colour: \"#BD10E0\",\n  links: {\n    creditor: \"CR123\"\n  }\n});"
          },
          {
            "lang": "PHP",
            "label": "PHP",
            "source": "$client->payerThemes()->createForCreditor([\n  \"params\" => [\n    \"header_background_colour\" => \"#BD10E0\",\n    \"link_text_colour\" => \"#7ED321\",\n    \"button_background_colour\" => \"#128DAA\",\n    \"content_box_border_colour\" => \"#BD10E0\",\n    \"links\" => [\n      \"creditor\" => \"CR123\"\n    ]\n  ]\n]);"
          },
          {
            "lang": "Java",
            "label": "Java",
            "source": "PayerTheme payerTheme = client.payerThemes().createForCreditor()\n  .withButtonBackgroundColour(\"#128DAA\")\n  .withContentBoxBorderColour(\"#BD10E0\")\n  .withHeaderBackgroundColour(\"#BD10E0\")\n  .withLinkTextColour(\"#7ED321\")\n  .withLinksCreditor(\"CR123\")\n  .execute();"
          },
          {
            "lang": "Go",
            "label": "Go",
            "source": "payerThemeCreateForCreditorParams := gocardless.PayerThemeCreateForCreditorParams{\n  ButtonBackgroundColour: \"#128DAA\",\n  ContentBoxBorderColour: \"#BD10E0\",\n  HeaderBackgroundColour: \"#BD10E0\",\n  LinkTextColour: \"#7ED321\",\n  Links: &gocardless.PayerThemeCreateForCreditorParamsLinks{\n    Creditor: \"CR123\",\n  },\n}\n\npayerThemes, err := client.PayerThemes.CreateForCreditor(ctx, payerThemeCreateForCreditorParams)"
          },
          {
            "lang": "C#",
            "label": ".NET",
            "source": "var payerThemeCreateForCreditorRequest = new GoCardless.Services.PayerThemeCreateForCreditorRequest()\n{\n    HeaderBackgroundColour = \"#BD10E0\",\n    LinkTextColour = \"#7ED321\",\n    ButtonBackgroundColour = \"#128DAA\",\n    ContentBoxBorderColour = \"#BD10E0\",\n    Links = new GoCardless.Services.PayerThemeCreateForCreditorRequest.PayerThemeLinks()\n    {\n        Creditor = \"CR0123\"\n    }\n};\n\nvar payerThemeCreateForCreditorResponse = await client.PayerThemes.CreateForCreditorAsync(payerThemeCreateForCreditorRequest);\nGoCardless.Resources.PayerTheme creditorPayerTheme = payerThemeCreateForCreditorResponse.PayerTheme;"
          },
          {
            "lang": "HTTP",
            "label": "HTTP",
            "source": "POST https://api.gocardless.com/branding/payer_themes HTTP/1.1\nContent-Type: application/json\n{\n  \"payer_themes\": {\n    \"header_background_colour\": \"#BD10E0\",\n    \"link_text_colour\": \"#7ED321\",\n    \"button_background_colour\": \"#128DAA\",\n    \"content_box_border_colour\": \"#BD10E0\",\n    \"links\": {\n      \"creditor\": \"CR123\"\n    }\n  }\n}\n\nHTTP/1.1 201 OK\nContent-Type: application/json\n{\n  \"payer_themes\": {\n    \"id\": \"PTH123\"\n  }\n}"
          }
        ]
      }
    },
    "/payments": {
      "post": {
        "operationId": "create_payment",
        "summary": "Create a payment",
        "description": "<a name=\"mandate_is_inactive\"></a>Creates a new payment object.\n\nThis fails with a `mandate_is_inactive` error if the linked [mandate](#core-endpoints-mandates) is cancelled or has failed. Payments can be created against mandates with status of: `pending_customer_approval`, `pending_submission`, `submitted`, and `active`.\n\n<p class=\"notice--warning\"><strong>Warning</strong>: in Bacs, you have the option to provide a payment reference up to 10 characters in length. However, if you are providing custom mandate references (which can only be enabled by contacting support), the combined length of the two references separated by a dash character must not exceed 18 characters. Payment references may be up to 140 characters for SEPA, 11 for Autogiro and 30 for Betalingsservice, irrespective of the mandate reference.</p>",
        "tags": [
          "Payment"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GoCardlessVersionHeader"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/payment_single_resource_response"
                }
              }
            },
            "description": "Resource created successfully"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
