    "/mandate_imports": {
      "post": {
        "operationId": "create_mandate_import",
        "summary": "Create a new mandate import",
        "description": "Mandate imports are first created, before mandates are added one-at-a-time, so\nthis endpoint merely signals the start of the import process. Once you've finished\nadding entries to an import, you should\n[submit](#mandate-imports-submit-a-mandate-import) it.",
