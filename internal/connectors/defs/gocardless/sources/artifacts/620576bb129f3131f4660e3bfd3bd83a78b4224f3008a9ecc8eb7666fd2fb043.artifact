      "billing_request_flow_scheme_identifier_data": {
        "type": "object",
        "title": "BillingRequestFlowSchemeIdentifierData",
        "description": "Scheme identifier data",
        "properties": {
          "name": {
            "type": "string"
          },
          "scheme": {
            "description": "A bank payment scheme. Currently \"ach, \"autogiro\", \"bacs\", \"becs\", \"becs_nz\", \"betalingsservice\", \"faster_payments\", \"pad\", \"pay_to\", \"sepa\", \"sepa_credit_transfer\", \"sepa_instant_credit_transfer\" are supported.",
            "example": "bacs",
