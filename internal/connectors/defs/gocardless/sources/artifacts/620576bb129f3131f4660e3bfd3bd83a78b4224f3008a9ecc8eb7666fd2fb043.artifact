        "x-codeSamples": [
          {
            "lang": "Ruby",
            "label": "Ruby",
            "source": "@client.mandate_import_entries.all(\n  params: {\n    \"mandate_import\" => \"IM000010790WX1\"\n  }\n).each { |entry| puts entry.record_identifier }"
          },
          {
            "lang": "Python",
            "label": "Python",
            "source": "for mandate_import_entry in client.mandate_import_entries.all(\n  params= { \"mandate_import\": \"IM000010790WX1\" }\n):\n  print(mandate_import_entry.record_identifier)"
          },
          {
            "lang": "JavaScript",
            "label": "JavaScript",
            "source": "const mandateImportEntries = await client.mandateImportEntries.list();"
          },
          {
            "lang": "PHP",
            "label": "PHP",
            "source": "$client->mandateImportEntries()->all([\n  \"params\" => [\"mandate_import\" => \"IM000010790WX1\"]\n]);"
          },
          {
            "lang": "Java",
            "label": "Java",
            "source": "for (MandateImportEntry entry : client.mandateImportEntries().all().withMandateImport(\"IM000010790WX1\").execute()) {\n  System.out.println(entry.getRecordIdentifier());\n}"
          },
          {
            "lang": "Go",
            "label": "Go",
            "source": "mandateImportEntryListParams := gocardless.MandateImportEntryListParams{\n  MandateImport: \"IM000010790WX1\",\n}\n\nmandateImportEntryListPagingIterator := client.MandateImportEntries.All(ctx, mandateImportEntryListParams)\nfor mandateImportEntryListPagingIterator.Next() {\n    mandateImportEntryListResult, err := mandateImportEntryListPagingIterator.Value(ctx)\n    for _, mandateImportEntry := range mandateImportEntryListResult.MandateImportEntries {\n        fmt.Println(mandateImportEntry.RecordIdentifier)\n    }\n}"
          },
          {
            "lang": "C#",
            "label": ".NET",
            "source": "var request = new GoCardless.Services.MandateImportEntryListRequest()\n{\n    MandateImport = \"IM000010790WX1\"\n};\n\nvar response = client.MandateImportEntries.All(request);\nforeach (GoCardless.Resources.MandateImportEntry entry in response)\n{\n    Console.WriteLine(entry.RecordIdentifier);\n}"
          },
