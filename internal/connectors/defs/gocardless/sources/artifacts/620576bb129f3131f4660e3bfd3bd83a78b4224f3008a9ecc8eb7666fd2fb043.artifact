            "description": "ID of a [customer](#core-endpoints-customers).",
            "example": "CU123"
          },
          "customer_bank_account": {
            "type": "string",
            "description": "ID of a [customer bank account](#core-endpoints-customer-bank-accounts).",
            "example": "BA123"
          },
          "payment": {
            "type": "string",
            "description": "If `resource_type` is `payments`, this is the ID of the [payment](#core-endpoints-payments) which has been updated.",
            "example": "PM123"
          },
          "mandate": {
            "type": "string",
            "description": "If `resource_type` is `mandates`, this is the ID of the [mandate](#core-endpoints-mandates) which has been updated.",
            "example": "MD123"
          },
          "payer_authorisation": {
            "type": "string",
            "description": "ID of a [payer authorisation](#core-endpoints-payer-authorisations).",
            "example": "PAU123"
          },
          "payout": {
            "type": "string",
            "description": "If `resource_type` is `payouts`, this is the ID of the [payout](#core-endpoints-payouts) which has been updated.",
            "example": "PO123"
          },
          "refund": {
            "type": "string",
            "description": "If `resource_type` is `refunds`, this is the ID of the [refund](#core-endpoints-refunds) which has been updated.",
            "example": "RF123"
          },
          "subscription": {
            "type": "string",
            "description": "If `resource_type` is `subscription`, this is the ID of the [subscription](#core-endpoints-subscriptions) which has been updated.",
            "example": "SB123"
          },
          "instalment_schedule": {
            "type": "string",
            "description": "If `resource_type` is `instalment_schedule`, this is the ID of the [instalment schedule](#core-endpoints-instalment-schedules) which has been updated.",
            "example": "IS123"
          },
          "creditor": {
            "type": "string",
            "description": "If `resource_type` is `creditor`, this is the ID of the [creditor](#core-endpoints-creditors) which has been updated.",
            "example": "CR123"
          },
          "parent_event": {
            "type": "string",
            "description": "If this event was caused by another, this is the ID of the cause. For example, if a mandate is cancelled it automatically cancels all pending payments associated with it; in this case, the payment cancellation events would have the ID of the mandate cancellation event in this field.",
            "example": "EV123"
          },
          "previous_customer_bank_account": {
            "type": "string",
            "description": "This is only included for mandate transfer events, when it is the ID of the [customer bank account](#core-endpoints-customer-bank-accounts) which the mandate is being transferred from.",
            "example": "BA123"
          },
          "new_customer_bank_account": {
            "type": "string",
            "description": "This is only included for mandate transfer events, when it is the ID of the [customer bank account](#core-endpoints-customer-bank-accounts) which the mandate is being transferred to.",
            "example": "BA123"
          },
          "new_mandate": {
            "type": "string",
            "description": "This is only included for mandate replaced events, when it is the ID of the new [mandate](#core-endpoints-mandates) that replaces the existing mandate.",
            "example": "MD123"
          },
          "organisation": {
            "type": "string",
            "description": "If the event is included in a [webhook](#webhooks-overview) to an [OAuth app](#appendix-oauth), this is the ID of the account to which it belongs.",
            "example": "OR123"
          },
          "outbound_payment": {
            "type": "string",
            "description": "If `resource_type` is `outbound_payments`, this is the ID of the outbound_payment which has been updated.",
            "example": "OUT123"
          },
          "payment_account_transaction": {
            "type": "string",
            "description": "If `resource_type` is `payment_account_transaction`, this is the ID of a transaction which has been recorded on the payment account.",
            "example": "PATR123"
          },
          "scheme_identifier": {
            "type": "string",
            "description": "If `resource_type` is `scheme_identifiers`, this is the ID of the [scheme_identifier](#core-endpoints-scheme-identifiers) which has been updated.",
            "example": "SU123"
          }
        }
      },
      "event_linked": {
        "type": "object",
        "title": "EventLinked",
        "description": "",
        "properties": {
          "billing_requests": {
            "type": "array",
            "description": "A list of billing requests linked to the events returned in the list of events.",
            "items": {
              "type": "object",
              "description": " Billing Requests help create resources that require input or action from a customer. An example of required input might be additional customer billing details, while an action would be asking a customer to authorise a payment using their mobile banking app.\n\nSee [Billing Requests: Overview](https://developer.gocardless.com/getting-started/billing-requests/overview/) for how-to's, explanations and tutorials. <p class=\"notice\"><strong>Important</strong>: All properties associated with `subscription_request` and `instalment_schedule_request` are only supported for ACH and PAD schemes.</p>",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier, beginning with \"BRQ\".",
                  "example": "BRQ123"
                },
                "purpose_code": {
                  "description": "Specifies the high-level purpose/category of a mandate and/or payment using a set of pre-defined categories. Provides context on the nature and reason for the payment to facilitate processing and compliance.\nSee [Billing Request Purpose Codes](https://developer.gocardless.com/billing-request-purpose-codes/) for the complete list of valid codes.",
                  "enum": [
                    "mortgage",
                    "utility",
                    "loan",
                    "dependant_support",
                    "gambling",
                    "retail",
                    "salary",
                    "personal",
                    "government",
                    "pension",
                    "tax",
                    "other",
                    "bonus_payment",
                    "cash_management_transfer",
                    "card_bulk_clearing",
                    "credit_card_payment",
                    "trade_settlement_payment",
                    "debit_card_payment",
                    "dividend",
                    "deliver_against_payment",
                    "epayment",
                    "fee_collection_and_interest",
                    "fee_collection",
                    "person_to_person_payment",
                    "government_payment",
                    "hedging_transaction",
                    "irrevocable_credit_card_payment",
                    "irrevocable_debit_card_payment",
                    "intra_company_payment",
                    "interest",
                    "lockbox_transactions",
                    "commercial",
                    "consumer",
                    "other_payment",
                    "pension_payment",
                    "represented",
                    "reimbursement_received_credit_transfer",
                    "receive_against_payment",
                    "salary_payment",
                    "securities",
                    "social_security_benefit",
                    "supplier_payment",
                    "tax_payment",
                    "trade",
                    "treasury_payment",
                    "value_added_tax_payment",
                    "with_holding",
                    "cash_management_sweep_account",
                    "cash_management_top_account",
                    "cash_management_zero_balance_account",
                    "crossborder_mi_payments",
                    "foreign_currency_domestic_transfer",
                    "cash_in_pre_credit",
                    "cash_out_notes_coins",
                    "carrier_guarded_wholesale_valuables"
                  ],
                  "type": "string"
                },
                "payment_purpose_code": {
                  "type": "string",
                  "description": "Specifies the underlying purpose of the payment. Defines the specific reason or type of service/goods the payment relates to, improving straight-through processing and compliance.\nSee [VRP Commercial Payment Purpose Codes](https://developer.gocardless.com/vrp-commercial-payment-purpose-codes/) for the complete list of valid codes."
                },
                "payment_context_code": {
                  "description": "Specifies the context or scenario in which the payment is being made. Defines whether the payment is for advance/arrears billing, point of sale transactions, ecommerce, or account transfers. This helps banks and payment processors understand the payment scenario and apply appropriate processing rules and risk controls.",
                  "enum": [
                    "billing_goods_and_services_in_advance",
                    "billing_goods_and_services_in_arrears",
                    "face_to_face_point_of_sale",
                    "ecommerce_merchant_initiated_payment",
                    "transfer_to_self",
                    "transfer_to_third_party"
                  ],
                  "type": "string"
                },
                "created_at": {
                  "type": "string",
                  "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                  "example": "2015-01-01T12:00:00.000Z",
                  "format": "date-time"
                },
                "status": {
                  "type": "string",
                  "description": "One of:\n\n- `pending`: the billing request is pending and can be used\n- `ready_to_fulfil`: the billing request is ready to fulfil\n- `fulfilling`: the billing request is currently undergoing fulfilment\n- `fulfilled`: the billing request has been fulfilled and a payment created\n- `cancelled`: the billing request has been cancelled and cannot be used",
                  "example": "pending",
                  "enum": [
                    "pending",
                    "ready_to_fulfil",
                    "fulfilling",
                    "fulfilled",
                    "cancelled"
                  ]
                },
                "metadata": {
                  "type": "object",
                  "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                },
                "mandate_request": {
                  "type": "object",
                  "nullable": true,
                  "description": "Request for a mandate",
                  "properties": {
                    "description": {
                      "type": "string",
                      "nullable": true,
                      "description": "A human-readable description of the payment and/or mandate. This will be displayed to the payer when authorising the billing request.\n",
                      "example": "Top-up Payment"
                    },
                    "currency": {
                      "type": "string",
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code.",
                      "example": "GBP"
                    },
                    "scheme": {
                      "type": "string",
                      "nullable": true,
                      "description": "A bank payment scheme. Currently \"ach\", \"autogiro\", \"bacs\", \"becs\", \"becs_nz\", \"betalingsservice\", \"faster_payments\", \"pad\", \"pay_to\" and \"sepa_core\" are supported. Optional for mandate only requests - if left blank, the payer will be able to select the currency/scheme to pay with from a list of your available schemes.",
                      "example": "bacs"
                    },
                    "sweeping": {
                      "type": "boolean",
                      "description": "If true, this billing request would be used to set up a mandate solely for moving (or sweeping) money from one account owned by the payer to another account that the payer also owns. This is required for Faster Payments"
                    },
                    "verify": {
                      "description": "Verification preference for the mandate. One of:\n\n- `minimum`: only verify if absolutely required, such as when part of scheme rules\n- `recommended`: in addition to `minimum`, use the GoCardless payment intelligence solution to decide if a payer should be verified\n- `when_available`: if verification mechanisms are available, use them\n- `always`: as `when_available`, but fail to create the Billing Request if a mechanism isn't available\n\nBy default, all Billing Requests use the `recommended` verification preference. It uses GoCardless payment intelligence solution to determine if a payer is fraudulent or not. The verification mechanism is based on the response and the payer may be asked to verify themselves. If the feature is not available, `recommended` behaves like `minimum`.\n\nIf you never wish to take advantage of our reduced risk products and Verified Mandates as they are released in new schemes, please use the `minimum` verification preference.\n\nSee [Billing Requests: Creating Verified Mandates](https://developer.gocardless.com/getting-started/billing-requests/verified-mandates/)\nfor more information.",
                      "enum": [
                        "minimum",
                        "recommended",
                        "when_available",
                        "always"
                      ],
                      "type": "string"
                    },
                    "links": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "mandate": {
                          "type": "string",
                          "description": "(Optional) ID of the [mandate](#core-endpoints-mandates) that was created from this mandate request. this mandate request.\n"
                        }
                      }
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                    },
                    "consent_type": {
                      "type": "string",
                      "nullable": true,
                      "description": "This attribute represents the authorisation type between the payer and merchant. It can be set to `one_off`,\n`recurring` or `standing` for ACH scheme. And `single`, `recurring` and `sporadic` for PAD scheme. _Note:_ This is only supported for ACH and PAD schemes.\n"
                    },
                    "constraints": {
                      "type": "object",
                      "nullable": true,
                      "description": "Constraints that will apply to the mandate_request. (Optional) Specifically required for PayTo and VRP.",
                      "properties": {
                        "start_date": {
                          "type": "string",
                          "description": "The date from which payments can be taken.\n\nThis is an optional field and if it is not supplied the start date will be set to the day\nauthorisation happens.\n"
                        },
                        "end_date": {
                          "type": "string",
                          "description": "The latest date at which payments can be taken, must occur after start_date if present\n\nThis is an optional field and if it is not supplied the agreement will be considered open and\nwill not have an end date. Keep in mind the end date must take into account how long it will\ntake the user to set up this agreement via the Billing Request.\n"
                        },
                        "max_amount_per_payment": {
                          "type": "integer",
                          "description": "The maximum amount that can be charged for a single payment in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR). _Note:_ Required for PayTo and VRP."
                        },
                        "payment_method": {
                          "type": "string",
                          "description": "A constraint where you can specify info (free text string) about how payments are calculated. For use when payments vary and cannot be expressed as a fixed amount and frequency. _Note:_ This is only supported for ACH and PAD schemes.\n"
                        },
                        "periodic_limits": {
                          "type": "array",
                          "description": "Caps on the total amount and/or number of payments that can be collected within a\nrepeating period (e.g. no more than a set amount per month), as opposed to\n`max_amount_per_payment` which caps a single payment.\n\n_Note:_ Required for VRP, where exactly one periodic limit must be provided. Optional for\nPayTo.\n",
                          "items": {
                            "type": "object",
                            "properties": {
                              "period": {
                                "description": "The repeating period for this mandate. Required whenever a periodic limit is provided\n(for both VRP and PayTo). If periodic_limits is omitted entirely for PayTo, this\ndefaults to flexible.\n",
                                "enum": [
                                  "day",
                                  "week",
                                  "month",
                                  "year",
                                  "flexible"
                                ],
                                "type": "string"
                              },
                              "max_total_amount": {
                                "type": "integer",
                                "description": "The maximum total amount that can be charged for all payments in this periodic limit,\nin the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\n_Note:_ Required for VRP. This is not permitted for the PayTo scheme.\n"
                              },
                              "max_payments": {
                                "type": "integer",
                                "description": "The maximum number of payments that can be collected in this periodic limit.\n\n_Note:_ Only supported for the PayTo scheme, where it is optional.\n"
                              },
                              "alignment": {
                                "description": "The alignment of the period. Defaults to `creation_date` if not specified.\n\n`calendar` - the period follows fixed calendar boundaries, the same for every mandate:\n`week` runs Monday to Sunday, `month` runs from the 1st to the last day of the calendar\nmonth, and `year` runs from 1 January to 31 December. If the mandate starts partway\nthrough a period, the limit for that first period is reduced proportionally to the days\nremaining (e.g. a monthly limit starting on the 15th gives roughly half the limit for\nthat first month).\n\n`creation_date` - the period follows the mandate's own start date rather than the\ncalendar. For example, if the mandate starts on the 15th, each monthly period runs from\nthe 15th to the 14th of the following month. The first period is a full period, not\nreduced proportionally.\n\n_Note:_ Has no effect when period is `flexible`.\n",
                                "enum": [
                                  "calendar",
                                  "creation_date"
                                ],
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    },
                    "payer_requested_dual_signature": {
                      "type": "boolean",
                      "description": "This attribute can be set to true if the payer has indicated that multiple signatures are required for the mandate. As long as every other Billing Request actions have been completed, the payer will receive an email notification containing instructions on how to complete the additional signature. The dual signature flow can only be completed using GoCardless branded pages."
                    },
                    "authorisation_source": {
                      "description": "This field is ACH specific, sometimes referred to as [SEC code](https://www.moderntreasury.com/learn/sec-codes).\n\nThis is the way that the payer gives authorisation to the merchant.\n  web: Authorisation is Internet Initiated or via Mobile Entry (maps to SEC code: WEB)\n  telephone: Authorisation is provided orally over telephone (maps to SEC code: TEL)\n  paper: Authorisation is provided in writing and signed, or similarly authenticated (maps to SEC code: PPD)\n",
                      "enum": [
                        "web",
                        "telephone",
                        "paper"
                      ],
                      "type": "string"
                    },
                    "funds_settlement": {
                      "description": "This field will decide how GoCardless handles settlement of funds from the customer.\n\n- `managed` will be moved through GoCardless' account, batched, and payed out.\n- `direct` will be a direct transfer from the payer's account to the merchant where\n  invoicing will be handled separately.\n",
                      "enum": [
                        "managed",
                        "direct"
                      ],
                      "type": "string"
                    }
                  }
                },
                "payment_request": {
                  "type": "object",
                  "nullable": true,
                  "description": "Request for a one-off strongly authorised payment",
                  "properties": {
                    "description": {
                      "type": "string",
                      "nullable": true,
                      "description": "A human-readable description of the payment and/or mandate. This will be displayed to the payer when authorising the billing request.\n",
                      "example": "Top-up Payment"
                    },
                    "currency": {
                      "type": "string",
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. `GBP` and `EUR` supported; `GBP` with your customers in the UK and for `EUR` with your customers in supported Eurozone countries only.",
                      "example": "GBP"
                    },
                    "scheme": {
                      "type": "string",
                      "nullable": true,
                      "description": "(Optional) A scheme used for Open Banking payments. Currently `faster_payments` is supported in the UK (GBP) and `sepa_credit_transfer` and `sepa_instant_credit_transfer` are supported in supported Eurozone countries (EUR). For Eurozone countries, `sepa_credit_transfer` is used as the default. Please be aware that `sepa_instant_credit_transfer` may incur an additional fee for your customer.",
                      "example": "faster_payments"
                    },
                    "amount": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Amount in minor unit (e.g. pence in GBP, cents in EUR).",
                      "example": 1000
                    },
                    "links": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "payment": {
                          "type": "string",
                          "description": "(Optional) ID of the [payment](#core-endpoints-payments) that was created from this payment request."
                        }
                      }
                    },
                    "app_fee": {
                      "oneOf": [
                        {
                          "type": "string",
                          "nullable": true
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "The amount to be deducted from the payment as an app fee, to be paid to the partner integration which created the billing request, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                      "example": 100
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                    },
                    "reference": {
                      "type": "string",
                      "nullable": true,
                      "description": "A custom payment reference defined by the merchant. It is only available for payments on the PayTo scheme or payments using the Direct Funds settlement model on the Faster Payments scheme.\n",
                      "example": "some-custom-ref"
                    },
                    "funds_settlement": {
                      "description": "This field will decide how GoCardless handles settlement of funds from the customer.\n\n- `managed` will be moved through GoCardless' account, batched, and payed out.\n- `direct` will be a direct transfer from the payer's account to the merchant where\n  invoicing will be handled separately.\n",
                      "enum": [
                        "managed",
                        "direct"
                      ],
                      "type": "string"
                    }
                  }
                },
                "subscription_request": {
                  "type": "object",
                  "nullable": true,
                  "description": "Request for a subscription",
                  "properties": {
                    "amount": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Amount in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                      "example": 1000
                    },
                    "currency": {
                      "type": "string",
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"USD\" and \"CAD\" are supported.",
                      "example": "USD"
                    },
                    "interval_unit": {
                      "description": "The unit of time between customer charge dates. One of `weekly`, `monthly` or `yearly`.",
                      "example": "monthly",
                      "enum": [
                        "weekly",
                        "monthly",
                        "yearly"
                      ],
                      "type": "string"
                    },
                    "interval": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Number of `interval_units` between customer charge dates. Must be greater than or equal to `1`. Must result in at least one charge date per year. Defaults to `1`.",
                      "example": 1
                    },
                    "app_fee": {
                      "oneOf": [
                        {
                          "type": "string",
                          "nullable": true
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "The amount to be deducted from each payment as an app fee, to be paid to the partner integration which created the subscription, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                      "example": 100
                    },
                    "count": {
                      "oneOf": [
                        {
                          "type": "string",
                          "nullable": true
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "The total number of payments that should be taken by this subscription.",
                      "example": 5
                    },
                    "day_of_month": {
                      "oneOf": [
                        {
                          "type": "string",
                          "nullable": true
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "As per RFC 2445. The day of the month to charge customers on. `1`-`28` or `-1` to indicate the last day of the month.",
                      "example": 28
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                    },
                    "links": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "subscription": {
                          "type": "string",
                          "description": "(Optional) ID of the [subscription](#core-endpoints-subscriptions) that was created from this subscription request.\n"
                        }
                      }
                    },
                    "month": {
                      "description": "Name of the month on which to charge a customer. Must be lowercase. Only applies\nwhen the interval_unit is `yearly`.\n",
                      "example": "january",
                      "enum": [
                        "january",
                        "february",
                        "march",
                        "april",
                        "may",
                        "june",
                        "july",
                        "august",
                        "september",
                        "october",
                        "november",
                        "december"
                      ],
                      "nullable": true,
                      "type": "string"
                    },
                    "name": {
                      "type": "string",
                      "nullable": true,
                      "description": "Optional name for the subscription. This will be set as the description on each payment created. Must not exceed 255 characters.",
                      "example": "12 month subscription"
                    },
                    "payment_reference": {
                      "type": "string",
                      "nullable": true,
                      "description": "An optional payment reference. This will be set as the reference on each payment\ncreated and will appear on your customer's bank statement. See the documentation for\nthe [create payment endpoint](#payments-create-a-payment) for more details.\n<br />",
                      "example": "GOLDPLAN"
                    },
                    "start_date": {
                      "type": "string",
                      "nullable": true,
                      "description": "The date on which the first payment should be charged. If fulfilled after this date, this will be set as the mandate's `next_possible_charge_date`.\nWhen left blank and `month` or `day_of_month` are provided, this will be set to the date of the first payment.\nIf created without `month` or `day_of_month` this will be set as the mandate's `next_possible_charge_date`.\n",
                      "example": "2014-10-21",
                      "format": "date"
                    },
                    "retry_if_possible": {
                      "type": "boolean",
                      "description": "On failure, automatically retry payments using [intelligent retries](/success-plus/overview). Default is `false`. <p class=\"notice\"><strong>Important</strong>: To be able to use intelligent retries, Success+ needs to be enabled in [GoCardless dashboard](https://manage.gocardless.com/success-plus). </p>"
                    }
                  }
                },
                "instalment_schedule_request": {
                  "type": "object",
                  "nullable": true,
                  "description": "Request for an instalment schedule. Has to contain either `instalments_with_schedule` object or an array of `instalments_with_dates` objects",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Name of the instalment schedule, up to 100 chars. This name will also be\ncopied to the payments of the instalment schedule if you use schedule-based creation.",
                      "example": "Invoice 4404"
                    },
                    "currency": {
                      "type": "string",
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"USD\" and \"CAD\" are supported.",
                      "example": "USD"
                    },
                    "total_amount": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "The total amount of the instalment schedule, defined as the sum of all individual\npayments, in the lowest denomination for the currency (e.g. pence in GBP, cents in\nEUR). If the requested payment amounts do not sum up correctly, a validation error\nwill be returned.",
                      "example": 1000
                    },
                    "payment_reference": {
                      "type": "string",
                      "nullable": true,
                      "description": "An optional payment reference. This will be set as the reference on each payment\ncreated and will appear on your customer's bank statement. See the documentation for\nthe [create payment endpoint](#payments-create-a-payment) for more details.\n<br />",
                      "example": "GOLDPLAN"
                    },
                    "app_fee": {
                      "oneOf": [
                        {
                          "type": "string",
                          "nullable": true
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "The amount to be deducted from each payment as an app fee, to be paid to the partner integration which created the subscription, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                      "example": 100
                    },
                    "instalments_with_dates": {
                      "type": "array",
                      "nullable": true,
                      "description": "An explicit array of instalment payments, each specifying at least an `amount` and `charge_date`. See [create (with dates)](#instalment-schedules-create-with-dates)",
                      "example": [
                        {
                          "amount": 250,
                          "charge_date": "2020-11-03"
                        }
                      ],
                      "items": {
                        "type": "object",
                        "properties": {
                          "amount": {
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "integer"
                              }
                            ],
                            "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\nMinimum and maximum amounts vary by payment scheme. For more information, see [Transaction limits](https://support.gocardless.com/hc/en-gb/articles/115000309245-Transaction-limits)\n\nFor Variable Recurring Payments (VRP), this must not exceed the mandate's `max_amount_per_payment`\nconstraint.",
                            "example": 1000
                          },
                          "charge_date": {
                            "type": "string",
                            "nullable": true,
                            "description": "A future date on which the payment should be collected. If the date\nis before the next_possible_charge_date on the\n[mandate](#core-endpoints-mandates), it will be automatically rolled\nforwards to that date.",
                            "example": "2014-05-21",
                            "format": "date"
                          },
                          "description": {
                            "type": "string",
                            "nullable": true,
                            "description": "A human-readable description of the payment. This will be included in the notification email GoCardless sends to your customer if your organisation does not send its own notifications (see [compliance requirements](#appendix-compliance-requirements)).",
                            "example": "One-off upgrade fee"
                          }
                        }
                      }
                    },
                    "instalments_with_schedule": {
                      "type": "object",
                      "nullable": true,
                      "description": "Frequency of the payments you want to create, together with an array of payment\namounts to be collected, with a specified start date for the first payment.\nSee [create (with schedule)](#instalment-schedules-create-with-schedule)\n",
                      "properties": {
                        "start_date": {
                          "type": "string",
                          "nullable": true,
                          "description": "The date on which the first payment should be charged. Must be on or after the [mandate](#core-endpoints-mandates)'s `next_possible_charge_date`. When left blank and `month` or `day_of_month` are provided, this will be set to the date of the first payment. If created without `month` or `day_of_month` this will be set as the mandate's `next_possible_charge_date`",
                          "example": "2014-10-21",
                          "format": "date"
                        },
                        "interval": {
                          "type": "integer",
                          "description": "Number of `interval_units` between charge dates. Must be greater than or\nequal to `1`.\n",
                          "example": 1
                        },
                        "interval_unit": {
                          "description": "The unit of time between customer charge dates. One of `weekly`, `monthly` or `yearly`.",
                          "example": "monthly",
                          "enum": [
                            "weekly",
                            "monthly",
                            "yearly"
                          ],
                          "type": "string"
                        },
                        "amounts": {
                          "type": "array",
                          "description": "List of amounts of each instalment, in the lowest denomination for the\ncurrency (e.g. cents in USD).\n",
                          "items": {
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "integer"
                              }
                            ],
                            "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\nMinimum and maximum amounts vary by payment scheme. For more information, see [Transaction limits](https://support.gocardless.com/hc/en-gb/articles/115000309245-Transaction-limits)\n\nFor Variable Recurring Payments (VRP), this must not exceed the mandate's `max_amount_per_payment`\nconstraint.",
                            "example": 1000
                          }
                        }
                      }
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                    },
                    "links": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "instalment_schedule": {
                          "type": "string",
                          "description": "(Optional) ID of the [instalment_schedule](#core-endpoints-instalment-schedules) that was created from this instalment schedule request.\n"
                        }
                      }
                    },
                    "retry_if_possible": {
                      "type": "boolean",
                      "description": "On failure, automatically retry payments using [intelligent retries](/success-plus/overview). Default is `false`. <p class=\"notice\"><strong>Important</strong>: To be able to use intelligent retries, Success+ needs to be enabled in [GoCardless dashboard](https://manage.gocardless.com/success-plus). </p>"
                    }
                  }
                },
                "actions": {
                  "type": "array",
                  "description": "List of actions that can be performed before this billing request can be fulfilled.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "description": "Unique identifier for the action.",
                        "example": "collect_bank_account",
                        "enum": [
                          "choose_currency",
                          "collect_amount",
                          "collect_customer_details",
                          "collect_bank_account",
                          "bank_authorisation",
                          "confirm_payer_details",
                          "select_institution"
                        ]
                      },
                      "status": {
                        "type": "string",
                        "description": "Status of the action",
                        "example": "pending",
                        "enum": [
                          "pending",
                          "completed"
                        ]
                      },
                      "required": {
                        "type": "boolean",
                        "description": "Informs you whether the action is required to fulfil the billing request or not.",
                        "example": true
                      },
                      "completes_actions": {
                        "type": "array",
                        "description": "Which other action types this action can complete.",
                        "example": [
                          "collect_bank_account"
                        ],
                        "items": {
                          "type": "string"
                        }
                      },
                      "requires_actions": {
                        "type": "array",
                        "description": "Requires completing these actions before this action can be completed.",
                        "example": [
                          "collect_bank_account"
                        ],
                        "items": {
                          "type": "string"
                        }
                      },
                      "bank_authorisation": {
                        "type": "object",
                        "description": "Describes the behaviour of bank authorisations, for the bank_authorisation action",
                        "properties": {
                          "adapter": {
                            "type": "string",
                            "description": "Which authorisation adapter will be used to power these authorisations (GoCardless internal use only)",
                            "enum": [
                              "open_banking_gateway_pis",
                              "open_banking_gateway_ais",
                              "bankid_ais",
                              "bank_pay_recurring"
                            ]
                          },
                          "authorisation_type": {
                            "type": "string",
                            "description": "What type of bank authorisations are supported on this billing request",
                            "enum": [
                              "payment",
                              "mandate"
                            ]
                          }
                        }
                      },
                      "collect_customer_details": {
                        "type": "object",
                        "description": "Additional parameters to help complete the collect_customer_details action",
                        "properties": {
                          "default_country_code": {
                            "type": "string",
                            "description": "Default customer country code, as determined by scheme and payer location"
                          },
                          "incomplete_fields": {
                            "type": "object",
                            "properties": {
                              "customer": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "description": "A customer field that needs to be collected"
                                }
                              },
                              "customer_billing_detail": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "description": "A customer_billing_detail field that needs to be collected"
                                }
                              }
                            }
                          }
                        }
                      },
                      "available_currencies": {
                        "type": "array",
                        "description": "List of currencies the current mandate supports",
                        "items": {
                          "type": "string",
                          "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code.",
                          "example": "GBP"
                        }
                      },
                      "institution_guess_status": {
                        "type": "string",
                        "description": "Describes whether we inferred the institution from the provided bank account details. One of:\n- `not_needed`: we won't attempt to infer the institution as it is not needed. Either because it was manually selected or the billing request does not support this feature\n- `pending`: we are waiting on the bank details in order to infer the institution\n- `failed`: we weren't able to infer the institution\n- `success`: we inferred the institution and added it to the resources of a Billing Request\n",
                        "example": "pending",
                        "enum": [
                          "not_needed",
                          "pending",
                          "failed",
                          "success"
                        ]
                      }
                    }
                  }
                },
                "resources": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "customer": {
                      "type": "object",
                      "description": "Embedded customer",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "Unique identifier, beginning with \"CU\".",
                          "example": "CU123"
                        },
                        "created_at": {
                          "type": "string",
                          "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                          "example": "2014-01-01T12:00:00.000Z",
                          "format": "date-time"
                        },
                        "email": {
                          "type": "string",
                          "nullable": true,
                          "description": "Customer's email address. Required in most cases, as this allows GoCardless to send notifications to this customer.",
                          "example": "user@example.com"
                        },
                        "given_name": {
                          "type": "string",
                          "nullable": true,
                          "description": "Customer's first name. Required unless a `company_name` is provided.",
                          "example": "Frank"
                        },
                        "family_name": {
                          "type": "string",
                          "nullable": true,
                          "description": "Customer's surname. Required unless a `company_name` is provided.",
                          "example": "Osborne"
                        },
                        "company_name": {
                          "type": "string",
                          "nullable": true,
                          "description": "Customer's company name. Required unless a `given_name` and `family_name` are provided. For Canadian customers, the use of a `company_name` value will mean that any mandate created from this customer will be considered to be a \"Business PAD\" (otherwise, any mandate will be considered to be a \"Personal PAD\").",
                          "example": "Hamilton Trading Ltd."
                        },
                        "language": {
                          "type": "string",
                          "nullable": true,
                          "description": "[ISO 639-1](https://en.wikipedia.org/wiki/List_of_ISO_639-1_codes) code. Used as the language for notification emails sent by GoCardless if your organisation does not send its own (see [compliance requirements](#appendix-compliance-requirements)). Currently only \"en\", \"fr\", \"de\", \"pt\", \"es\", \"it\", \"nl\", \"da\", \"nb\", \"sl\", \"sv\" are supported. If this is not provided, the language will be chosen based on the `country_code` (if supplied) or default to \"en\".",
                          "example": "en"
                        },
                        "phone_number": {
                          "type": "string",
                          "nullable": true,
                          "description": "[ITU E.123](https://en.wikipedia.org/wiki/E.123) formatted phone number, including country code.",
                          "example": "+64 4 817 9999"
                        },
                        "metadata": {
                          "type": "object",
                          "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                        }
                      }
                    },
                    "customer_billing_detail": {
                      "type": "object",
                      "description": "Embedded customer billing detail",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "Unique identifier, beginning with \"CU\".",
                          "example": "CU123"
                        },
                        "schemes": {
                          "type": "array",
                          "description": "The schemes associated with this customer billing detail",
                          "items": {
                            "type": "string"
                          }
                        },
                        "created_at": {
                          "type": "string",
                          "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                          "example": "2014-01-01T12:00:00.000Z",
                          "format": "date-time"
                        },
                        "address_line1": {
                          "type": "string",
                          "nullable": true,
                          "description": "The first line of the customer's address.",
                          "example": "221B Baker Street"
                        },
                        "address_line2": {
                          "type": "string",
                          "nullable": true,
                          "description": "The second line of the customer's address.",
                          "example": "Marylebone"
                        },
                        "address_line3": {
                          "type": "string",
                          "nullable": true,
                          "description": "The third line of the customer's address.",
                          "example": "City of Westminster"
                        },
                        "city": {
                          "type": "string",
                          "nullable": true,
                          "description": "The city of the customer's address.",
                          "example": "London"
                        },
                        "region": {
                          "type": "string",
                          "nullable": true,
                          "description": "The customer's address region, county or department. For US customers a 2 letter [ISO3166-2:US](https://en.wikipedia.org/wiki/ISO_3166-2:US) state code is required (e.g. `CA` for California).",
                          "example": "Greater London"
                        },
                        "postal_code": {
                          "type": "string",
                          "nullable": true,
                          "description": "The customer's postal code.",
                          "example": "NW1 6XE"
                        },
                        "country_code": {
                          "type": "string",
                          "nullable": true,
                          "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                          "example": "GB"
                        },
                        "swedish_identity_number": {
                          "type": "string",
                          "nullable": true,
                          "description": "For Swedish customers only. The civic/company number (personnummer, samordningsnummer, or organisationsnummer) of the customer. Must be supplied if the customer's bank account is denominated in Swedish krona (SEK). This field cannot be changed once it has been set.",
                          "example": "556564-5404"
                        },
                        "danish_identity_number": {
                          "type": "string",
                          "nullable": true,
                          "description": "For Danish customers only. The civic/company number (CPR or CVR) of the customer. Must be supplied if the customer's bank account is denominated in Danish krone (DKK).",
                          "example": "220550-6218"
                        },
                        "ip_address": {
                          "type": "string",
                          "nullable": true,
                          "description": "For ACH customers only. Required for ACH customers. A string containing the IP address of the payer to whom the mandate belongs (i.e. as a result of their completion of a mandate setup flow in their browser).\n\nNot required for creating offline mandates where `authorisation_source` is set to telephone or paper.\n",
                          "example": "127.0.0.1"
                        }
                      }
                    },
                    "customer_bank_account": {
                      "type": "object",
                      "nullable": true,
                      "description": "Embedded customer bank account, only if a bank account is linked",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "Unique identifier, beginning with \"BA\".",
                          "example": "BA123"
                        },
                        "created_at": {
                          "type": "string",
                          "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                          "example": "2014-01-01T12:00:00.000Z",
                          "format": "date-time"
                        },
                        "account_holder_name": {
                          "type": "string",
                          "description": "Name of the account holder, as known by the bank. The full name provided when the customer is created is stored and is available via the API, but is transliterated, upcased, and truncated to 18 characters in bank submissions. This field is required unless the request includes a [customer bank account token](#javascript-flow-customer-bank-account-tokens).",
                          "example": "Billie Jean"
                        },
                        "account_number_ending": {
                          "type": "string",
                          "description": "The last few digits of the account number. Currently 4 digits for NZD bank accounts and 2 digits for other currencies.",
                          "example": "1234"
                        },
                        "account_type": {
                          "description": "Bank account type. Required for USD-denominated bank accounts. Must not be provided for bank accounts in other currencies. See [local details](#local-bank-details-united-states) for more information.",
                          "example": "savings",
                          "enum": [
                            "savings",
                            "checking"
                          ],
                          "nullable": true,
                          "type": "string"
                        },
                        "country_code": {
                          "type": "string",
                          "nullable": true,
                          "description": "[ISO 3166-1 alpha-2 code](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements). Defaults to the country code of the `iban` if supplied, otherwise is required.",
                          "example": "GB"
                        },
                        "currency": {
                          "type": "string",
                          "nullable": true,
                          "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                          "example": "EUR"
                        },
                        "bank_name": {
                          "type": "string",
                          "description": "Name of bank, taken from the bank details.",
                          "example": "BARCLAYS BANK PLC"
                        },
                        "enabled": {
                          "type": "boolean",
                          "description": "Boolean value showing whether the bank account is enabled or disabled.",
                          "example": true
                        },
                        "metadata": {
                          "type": "object",
                          "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                        },
                        "links": {
                          "type": "object",
                          "description": "",
                          "properties": {
                            "customer": {
                              "type": "string",
                              "description": "ID of the [customer](#core-endpoints-customers) that owns this bank account."
                            }
                          }
                        },
                        "bank_account_token": {
                          "type": "string",
                          "nullable": true,
                          "description": "A token to uniquely refer to a set of bank account details. This feature is still in early access and is only available for certain organisations.",
                          "example": "bat_f975ab3c-ecee-47a1-9590-5bb1d56fa113"
                        },
                        "payer_name_verification_result": {
                          "type": "string",
                          "description": "The result of the payer name verification check performed when the bank account was created. Only present if a check was performed.\n\n- `full`: The name provided matches the name held by the bank.\n- `close`: The name provided is a close but not exact match to the name held by the bank.\n- `cannot_perform_verification`: A verification was attempted but could not be completed. This can happen for a number of reasons, including the account holder's bank not participating in the verification scheme, the account not being eligible for verification (e.g. the account holder has opted out), or the bank details not being resolvable, among others.",
                          "example": "full",
                          "enum": [
                            "full",
                            "close",
                            "cannot_perform_verification"
                          ]
                        }
                      }
                    }
                  }
                },
                "links": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "customer": {
                      "type": "string",
                      "description": "ID of the [customer](#core-endpoints-customers) that will be used for this request",
                      "example": "CU123"
                    },
                    "customer_billing_detail": {
                      "type": "string",
                      "description": "ID of the customer billing detail that will be used for this request"
                    },
                    "creditor": {
                      "type": "string",
                      "description": "ID of the associated [creditor](#core-endpoints-creditors).",
                      "example": "CR123"
                    },
                    "organisation": {
                      "type": "string",
                      "description": "ID of the associated organisation.",
                      "example": "OR123"
                    },
                    "customer_bank_account": {
                      "type": "string",
                      "description": "(Optional) ID of the [customer_bank_account](#core-endpoints-customer-bank-accounts) that will be used for this request",
                      "example": "BA123"
                    },
                    "bank_authorisation": {
                      "type": "string",
                      "description": "(Optional) ID of the [bank authorisation](#billing-requests-bank-authorisations) that was used to verify this request."
                    },
                    "payment_request": {
                      "type": "string",
                      "description": "(Optional) ID of the associated payment request",
                      "example": "PRQ123"
                    },
                    "payment_request_payment": {
                      "type": "string",
                      "description": "(Optional) ID of the [payment](#core-endpoints-payments) that was created from this payment request.",
                      "example": "PM123"
                    },
                    "mandate_request": {
                      "type": "string",
                      "description": "(Optional) ID of the associated mandate request",
                      "example": "MRQ123"
                    },
                    "mandate_request_mandate": {
                      "type": "string",
                      "description": "(Optional) ID of the [mandate](#core-endpoints-mandates) that was created from this mandate request. this mandate request.",
                      "example": "MD123"
                    },
                    "subscription_request": {
                      "type": "string",
                      "description": "(Optional) ID of the associated subscription request",
                      "example": "SBR123"
                    },
                    "subscription_request_subscription": {
                      "type": "string",
                      "description": "(Optional) ID of the [subscription](#core-endpoints-subscriptions) that was created from this subscription request.",
                      "example": "SB123"
                    },
                    "instalment_schedule_request": {
                      "type": "string",
                      "description": "(Optional) ID of the associated instalment schedule request",
                      "example": "ISR123"
                    },
                    "instalment_schedule_request_instalment_schedule": {
                      "type": "string",
                      "description": "(Optional) ID of the [instalment_schedule](#core-endpoints-instalment-schedules) that was created from this instalment schedule request.",
                      "example": "IS123"
                    },
                    "payment_provider": {
                      "type": "string",
                      "description": "(Optional) ID of the associated payment provider",
                      "example": "PP123"
                    }
                  }
                },
                "fallback_enabled": {
                  "type": "boolean",
                  "description": "(Optional) If true, this billing request can fallback from instant payment to direct debit.\nShould not be set if GoCardless payment intelligence feature is used.\n\nSee [Billing Requests: Retain customers with Fallbacks](https://developer.gocardless.com/billing-requests/retain-customers-with-fallbacks/)\nfor more information."
                },
                "fallback_occurred": {
                  "type": "boolean",
                  "description": "True if the billing request was completed with direct debit."
                }
              }
            }
          },
          "creditors": {
            "type": "array",
            "description": "A list of creditors linked to the events returned in the list of events.",
            "items": {
              "type": "object",
              "description": "Each [payment](#core-endpoints-payments) taken through the API is linked to a \"creditor\", to whom the payment is then paid out. In most cases your organisation will have a single \"creditor\", but the API also supports collecting payments on behalf of others.\n\nCurrently, for Anti Money Laundering reasons, any creditors you add must be directly related to your organisation.",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier, beginning with \"CR\".",
                  "example": "CR123"
                },
                "created_at": {
                  "type": "string",
                  "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                  "example": "2014-01-01T12:00:00.000Z",
                  "format": "date-time"
                },
                "name": {
                  "type": "string",
                  "description": "The creditor's trading name.",
                  "example": "Acme"
                },
                "address_line1": {
                  "type": "string",
                  "nullable": true,
                  "description": "The first line of the creditor's address.",
                  "example": "338-346 Goswell Road"
                },
                "address_line2": {
                  "type": "string",
                  "nullable": true,
                  "description": "The second line of the creditor's address.",
                  "example": "Islington"
                },
                "address_line3": {
                  "type": "string",
                  "nullable": true,
                  "description": "The third line of the creditor's address."
                },
                "city": {
                  "type": "string",
                  "nullable": true,
                  "description": "The city of the creditor's address.",
                  "example": "London"
                },
                "region": {
                  "type": "string",
                  "nullable": true,
                  "description": "The creditor's address region, county or department."
                },
                "postal_code": {
                  "type": "string",
                  "nullable": true,
                  "description": "The creditor's postal code.",
                  "example": "EC1V 7LQ"
                },
                "country_code": {
                  "type": "string",
                  "nullable": true,
                  "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                  "example": "GB"
                },
                "can_create_refunds": {
                  "type": "boolean",
                  "description": "Boolean indicating whether the creditor is permitted to create refunds."
                },
                "bank_reference_prefix": {
                  "type": "string",
                  "description": "Prefix for the bank reference of payouts sent to this creditor. For instance, if\nthe creditor's `bank_reference_prefix` was `ACME`, the bank reference of a payout\nsent to that creditor could be `ACME-8G7Q8`.\n\nThis prefix is also used for refunds in EUR and GBP.\n",
                  "example": "ACME"
                },
                "links": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "default_aud_payout_account": {
                      "type": "string",
                      "nullable": true,
                      "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in AUD.",
                      "example": "BA234"
                    },
                    "default_gbp_payout_account": {
                      "type": "string",
                      "nullable": true,
                      "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in GBP.",
                      "example": "BA123"
                    },
                    "default_eur_payout_account": {
                      "type": "string",
                      "nullable": true,
                      "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in EUR.",
                      "example": "BA456"
                    },
                    "default_sek_payout_account": {
                      "type": "string",
                      "nullable": true,
                      "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in SEK.",
                      "example": "BA789"
                    },
                    "default_dkk_payout_account": {
                      "type": "string",
                      "nullable": true,
                      "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in DKK.",
                      "example": "BA790"
                    },
                    "default_nzd_payout_account": {
                      "type": "string",
                      "nullable": true,
                      "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in NZD.",
                      "example": "BA791"
                    },
                    "default_cad_payout_account": {
                      "type": "string",
                      "nullable": true,
                      "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in CAD.",
                      "example": "BA792"
                    },
                    "default_usd_payout_account": {
                      "type": "string",
                      "nullable": true,
                      "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in USD.",
                      "example": "BA792"
                    }
                  }
                },
                "scheme_identifiers": {
                  "type": "array",
                  "description": "An array of the scheme identifiers this creditor can create mandates against.\n\nThe support address, `phone_number` and `email` fields are for customers to contact the merchant for support purposes. They must be displayed on the payment page, please see our [compliance requirements](#appendix-compliance-requirements) for more details.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier, usually beginning with \"SU\".",
                        "example": "SU123"
                      },
                      "created_at": {
                        "type": "string",
                        "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                        "example": "2014-01-01T12:00:00.000Z",
                        "format": "date-time"
                      },
                      "name": {
                        "type": "string",
                        "description": "The name which appears on customers' bank statements. This should usually be the merchant's trading name."
                      },
                      "scheme": {
                        "description": "The scheme which this scheme identifier applies to.",
                        "example": "bacs",
                        "enum": [
                          "ach",
                          "autogiro",
                          "bacs",
                          "becs",
                          "becs_nz",
                          "betalingsservice",
                          "faster_payments",
                          "pad",
                          "pay_to",
                          "sepa",
                          "sepa_credit_transfer",
                          "sepa_instant_credit_transfer"
                        ],
                        "type": "string"
                      },
                      "reference": {
                        "type": "string",
                        "description": "The scheme-unique identifier against which payments are submitted."
                      },
                      "status": {
                        "description": "The status of the scheme identifier. Only `active` scheme identifiers will be applied to a creditor and used against payments.",
                        "example": "pending",
                        "enum": [
                          "pending",
                          "active"
                        ],
                        "type": "string"
                      },
                      "minimum_advance_notice": {
                        "type": "integer",
                        "description": "The minimum interval, in working days, between the sending of a pre-notification to the customer, and the charge date of a payment using this scheme identifier.\n\nBy default, GoCardless sends these notifications automatically. Please see our [compliance requirements](#appendix-compliance-requirements) for more details.",
                        "example": 3
                      },
                      "address_line1": {
                        "type": "string",
                        "description": "The first line of the scheme identifier's support address.",
                        "example": "221B Baker Street"
                      },
                      "address_line2": {
                        "type": "string",
                        "nullable": true,
                        "description": "The second line of the scheme identifier's support address.",
                        "example": "Marylebone"
                      },
                      "address_line3": {
                        "type": "string",
                        "nullable": true,
                        "description": "The third line of the scheme identifier's support address.",
                        "example": "City of Westminster"
                      },
                      "city": {
                        "type": "string",
                        "description": "The city of the scheme identifier's support address.",
                        "example": "London"
                      },
                      "region": {
                        "type": "string",
                        "nullable": true,
                        "description": "The scheme identifier's support address region, county or department.",
                        "example": "Greater London"
                      },
                      "postal_code": {
                        "type": "string",
                        "description": "The scheme identifier's support postal code.",
                        "example": "NW1 6XE"
                      },
                      "country_code": {
                        "type": "string",
                        "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                        "example": "GB"
                      },
                      "email": {
                        "type": "string",
                        "description": "Scheme identifier's support email address.",
                        "example": "user@example.com"
                      },
                      "phone_number": {
                        "type": "string",
                        "description": "Scheme identifier's support phone number.",
                        "example": "+44 20 1234 1234"
                      },
                      "currency": {
                        "description": "The currency of the scheme identifier.",
                        "example": "EUR",
                        "enum": [
                          "AUD",
                          "CAD",
                          "DKK",
                          "EUR",
                          "GBP",
                          "NZD",
                          "SEK",
                          "USD"
                        ],
                        "type": "string"
                      },
                      "can_specify_mandate_reference": {
                        "type": "boolean",
                        "description": "Whether a custom reference can be submitted for mandates using this scheme identifier."
                      }
                    }
                  }
                },
                "logo_url": {
                  "type": "string",
                  "nullable": true,
                  "description": "URL for the creditor's logo, which may be shown on their payment pages.",
                  "example": "https://uploads.gocardless.com/logo.png"
                },
                "verification_status": {
                  "description": "The creditor's verification status, indicating whether they can yet receive payouts. For more details on handling verification as a partner, see our [\"Helping your users get verified\" guide](/getting-started/partners/helping-your-users-get-verified/). One of:\n\n- `successful`: The creditor's account is fully verified, and they can receive payouts. Once a creditor has been successfully verified, they may in the future require further verification - for example, if they change their payout bank account, we will have to check that they own the new bank account before they can receive payouts again.\n- `in_review`: The creditor has provided all of the information currently requested, and it is awaiting review by GoCardless before they can be verified and receive payouts.\n- `action_required`: The creditor needs to provide further information to verify their account so they can receive payouts, and should visit the verification flow.",
                  "example": "action_required",
                  "enum": [
                    "successful",
                    "in_review",
                    "action_required"
                  ],
                  "type": "string"
                },
                "merchant_responsible_for_notifications": {
                  "type": "boolean",
                  "description": "Boolean value indicating whether the organisation is responsible for sending all customer notifications (note this is separate from the functionality described [here](/getting-started/api/handling-customer-notifications/)). If you are a partner app, and this value is true, you should not send notifications on behalf of this organisation.",
                  "example": true
                },
                "mandate_imports_enabled": {
                  "type": "boolean",
                  "description": "Boolean value indicating whether creditor has the [Mandate Imports](#core-endpoints-mandate-imports) functionality enabled.",
                  "example": true
                },
                "custom_payment_pages_enabled": {
                  "type": "boolean",
                  "description": "Boolean value indicating whether creditor has the [Custom Payment Pages](https://hub.gocardless.com/s/article/Custom-payment-pages) functionality enabled.",
                  "example": true
                },
                "fx_payout_currency": {
                  "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) code for the currency in which amounts will be paid out (after foreign exchange). Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported. Present only if payouts will be (or were) made via foreign exchange.",
                  "example": "EUR",
                  "enum": [
                    "AUD",
                    "CAD",
                    "DKK",
                    "EUR",
                    "GBP",
                    "NZD",
                    "SEK",
                    "USD"
                  ],
                  "nullable": true,
                  "type": "string"
                },
                "creditor_type": {
                  "description": "The type of business of the creditor. Currently, `individual`, `company`, `charity`, `partnership`, and `trust` are supported.",
                  "example": "company",
                  "enum": [
                    "company",
                    "individual",
                    "charity",
                    "partnership",
                    "trust"
                  ],
                  "type": "string"
                }
              }
            }
          },
          "instalment_schedules": {
            "type": "array",
            "description": "A list of instalment schedules linked to the events returned in the list of events.",
            "items": {
              "type": "object",
              "description": "Instalment schedules are objects which represent a collection of related payments, with the\nintention to collect the `total_amount` specified. The API supports both schedule-based\ncreation (similar to subscriptions) as well as explicit selection of differing payment\namounts and charge dates.\n\nUnlike subscriptions, the payments are created immediately, so the instalment schedule\ncannot be modified once submitted and instead can only be cancelled (which will cancel\nany of the payments which have not yet been submitted).\n\nCustomers will receive a single notification about the complete schedule of collection.\n",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier, beginning with \"IS\".",
                  "example": "IS123"
                },
                "created_at": {
                  "type": "string",
                  "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                  "example": "2014-01-01T12:00:00.000Z",
                  "format": "date-time"
                },
                "total_amount": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "description": "The total amount of the instalment schedule, defined as the sum of all individual\npayments, in the lowest denomination for the currency (e.g. pence in GBP, cents in\nEUR). If the requested payment amounts do not sum up correctly, a validation error\nwill be returned.",
                  "example": 1000
                },
                "name": {
                  "type": "string",
                  "description": "Name of the instalment schedule, up to 100 chars. This name will also be\ncopied to the payments of the instalment schedule if you use schedule-based creation.",
                  "example": "Invoice 4404"
                },
                "currency": {
                  "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                  "example": "EUR",
                  "enum": [
                    "AUD",
                    "CAD",
                    "DKK",
                    "EUR",
                    "GBP",
                    "NZD",
                    "SEK",
                    "USD"
                  ],
                  "type": "string"
                },
                "metadata": {
                  "type": "object",
                  "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                },
                "status": {
                  "description": "One of:\n\n- `pending`: we're waiting for GC to create the payments\n- `active`: the payments have been created, and the schedule is active\n- `creation_failed`: payment creation failed\n- `completed`: we have passed the date of the final payment and all payments have been collected\n- `cancelled`: the schedule has been cancelled\n- `errored`: one or more payments have failed",
                  "example": "active",
                  "enum": [
                    "pending",
                    "active",
                    "creation_failed",
                    "completed",
                    "cancelled",
                    "errored"
                  ],
                  "type": "string"
                },
                "payment_errors": {
                  "type": "object",
                  "description": "If the status is `creation_failed`, this property will be populated with validation\nfailures from the individual payments, arranged by the index of the payment that\nfailed.\n",
                  "example": {
                    "0": [
                      {
                        "field": "charge_date",
                        "message": "must be on or after mandate's next_possible_customer_charge_date"
                      }
                    ]
                  }
                },
                "links": {
                  "type": "object",
                  "description": "Links to associated objects",
                  "properties": {
                    "mandate": {
                      "type": "string",
                      "description": "ID of the associated [mandate](#core-endpoints-mandates) which the instalment schedule will create payments against.",
                      "example": "MD123"
                    },
                    "customer": {
                      "type": "string",
                      "description": "ID of the associated [customer](#core-endpoints-customers).",
                      "example": "CU123"
                    },
                    "payments": {
                      "type": "array",
                      "description": "Array of IDs of the associated [payments](#core-endpoints-payments)",
                      "example": [
                        "PM123",
                        "PM456"
                      ],
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "mandates": {
            "type": "array",
            "description": "A list of mandates linked to the events returned in the list of events.",
            "items": {
              "type": "object",
              "description": "Mandates represent the Direct Debit mandate with a [customer](#core-endpoints-customers).\n\nGoCardless will notify you via a [webhook](#appendix-webhooks) whenever the status of a mandate changes.",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier, beginning with \"MD\". Note that this prefix may not apply to mandates created before 2016.",
                  "example": "MD123"
                },
                "created_at": {
                  "type": "string",
                  "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                  "example": "2014-01-01T12:00:00.000Z",
                  "format": "date-time"
                },
                "reference": {
                  "type": "string",
                  "nullable": true,
                  "description": "Unique reference. Different schemes have different length and [character set](#appendix-character-sets) requirements. GoCardless will generate a unique reference satisfying the different scheme requirements if this field is left blank.",
                  "example": "REF-123"
                },
                "status": {
                  "description": "One of:\n\n- `pending_customer_approval`: the mandate has not yet been signed by the second customer\n- `pending_submission`: the mandate has not yet been submitted to the customer's bank\n- `submitted`: the mandate has been submitted to the customer's bank but has not been processed yet\n- `active`: the mandate has been successfully set up by the customer's bank\n- `suspended_by_payer`: the mandate has been suspended by payer\n- `failed`: the mandate could not be created\n- `cancelled`: the mandate has been cancelled\n- `expired`: the mandate has expired due to dormancy\n- `consumed`: the mandate has been consumed and cannot be reused (note that this only applies to schemes that are per-payment authorised)\n- `blocked`: the mandate has been blocked and payments cannot be created",
                  "example": "pending_submission",
                  "enum": [
                    "pending_customer_approval",
                    "pending_submission",
                    "submitted",
                    "active",
                    "failed",
                    "cancelled",
                    "expired",
                    "consumed",
                    "blocked",
                    "suspended_by_payer"
                  ],
                  "type": "string"
                },
                "scheme": {
                  "type": "string",
                  "nullable": true,
                  "description": "<a name=\"mandates_scheme\"></a>Bank payment scheme to which this mandate and associated payments are submitted. Can be supplied or automatically detected from the customer's bank account.",
                  "example": "bacs"
                },
                "mandate_type": {
                  "type": "string",
                  "nullable": true,
                  "description": "Mandate type",
                  "example": "bank_debit",
                  "enum": [
                    "bank_debit",
                    "instant",
                    "recurring",
                    "vrp_commercial",
                    "vrp_sweeping"
                  ]
                },
                "next_possible_charge_date": {
                  "type": "string",
                  "nullable": true,
                  "description": "The earliest date that can be used as a `charge_date` on any newly created payment for this mandate. This value will change over time.",
                  "example": "2014-10-27",
                  "format": "date"
                },
                "next_possible_standard_ach_charge_date": {
                  "type": "string",
                  "nullable": true,
                  "description": "If this is an an ACH mandate, the earliest date that can be used as a\n`charge_date` on any newly created payment to be charged through standard\nACH, rather than Faster ACH. This value will change over time.\n\nIt is only present in the API response for ACH mandates.",
                  "example": "2014-10-27",
                  "format": "date"
                },
                "payments_require_approval": {
                  "type": "boolean",
                  "description": "Boolean value showing whether payments and subscriptions under this mandate require approval via an automated email before being processed."
                },
                "verified_at": {
                  "type": "string",
                  "nullable": true,
                  "description": "[Timestamp](#api-usage-dates-and-times) recording when this mandate was verified.",
                  "example": "2021-01-01T12:00:00.000Z",
                  "format": "date-time"
                },
                "metadata": {
                  "type": "object",
                  "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                },
                "links": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "customer_bank_account": {
                      "type": "string",
                      "description": "ID of the associated [customer bank account](#core-endpoints-customer-bank-accounts) which the mandate is created and submits payments against.",
                      "example": "BA123"
                    },
                    "creditor": {
                      "type": "string",
                      "description": "ID of the associated [creditor](#core-endpoints-creditors).",
                      "example": "CR123"
                    },
                    "new_mandate": {
                      "type": "string",
                      "description": "ID of the new mandate if this mandate has been replaced.",
                      "example": "MD123"
                    },
                    "customer": {
                      "type": "string",
                      "description": "ID of the associated [customer](#core-endpoints-customers)",
                      "example": "CU123"
                    }
                  }
                },
                "consent_parameters": {
                  "type": "object",
                  "nullable": true,
                  "description": "(Optional) Payto and VRP Scheme specific information",
                  "properties": {
                    "max_amount_per_payment": {
                      "type": "integer",
                      "description": "The maximum amount that can be charged for a single payment"
                    },
                    "period": {
                      "description": "The repeating period for this mandate",
                      "enum": [
                        "day",
                        "week",
                        "month",
                        "year",
                        "flexible"
                      ],
                      "type": "string"
                    },
                    "max_amount_per_period": {
                      "type": "integer",
                      "description": "The maximum total amount that can be charged for all payments in this period"
                    },
                    "max_payments_per_period": {
                      "type": "integer",
                      "description": "The maximum number of payments that can be collected in this period"
                    },
                    "start_date": {
                      "type": "string",
                      "description": "The date from which payments can be taken"
                    },
                    "end_date": {
                      "type": "string",
                      "description": "The latest date at which payments can be taken, must occur after start_date if present"
                    }
                  }
                },
                "authorisation_source": {
                  "description": "This field is ACH specific, sometimes referred to as [SEC code](https://www.moderntreasury.com/learn/sec-codes).\n\nThis is the way that the payer gives authorisation to the merchant.\n  web: Authorisation is Internet Initiated or via Mobile Entry (maps to SEC code: WEB)\n  telephone: Authorisation is provided orally over telephone (maps to SEC code: TEL)\n  paper: Authorisation is provided in writing and signed, or similarly authenticated (maps to SEC code: PPD)\n",
                  "enum": [
                    "web",
                    "telephone",
                    "paper"
                  ],
                  "type": "string"
                },
                "funds_settlement": {
                  "description": "This field will decide how GoCardless handles settlement of funds from the customer.\n\n- `managed` will be moved through GoCardless' account, batched, and payed out.\n- `direct` will be a direct transfer from the payer's account to the merchant where\n  invoicing will be handled separately.\n",
                  "enum": [
                    "managed",
                    "direct"
                  ],
                  "type": "string"
                },
                "consent_type": {
                  "type": "string",
                  "nullable": true,
                  "description": "(Optional) Specifies the type of authorisation agreed between the payer and merchant. It can be set to one-off, recurring or standing for ACH, or single, recurring and sporadic for PAD.",
                  "enum": [
                    "one_off",
                    "single",
                    "recurring",
                    "standing",
                    "sporadic"
                  ]
                }
              }
            }
          },
          "outbound_payments": {
            "type": "array",
            "description": "A list of outbound payments linked to the events returned in the list of events.",
            "items": {
              "type": "object",
              "description": "Outbound Payments represent payments sent from [creditors](#core-endpoints-creditors).\n\nGoCardless will notify you via a [webhook](#appendix-webhooks) when the status of the outbound payment [changes](#event-types-outbound-payment).\n\n#### Rate limiting\n\nTwo rate limits apply to the Outbound Payments APIs:\n- All POST Outbound Payment endpoints (create, withdraw, approve, cancel and etc.) share a single rate-limit group of 300 requests per minute. As initiating a payment typically requires two API calls (one to create the payment and one to approve it), this allows you to add approximately 150 outbound payments per minute.\n- All remaining Outbound Payment endpoints are limited to 500 requests per minute.",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier of the outbound payment.",
                  "example": "OUT123"
                },
                "created_at": {
                  "type": "string",
                  "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when the outbound payment was created.",
                  "example": "2024-01-01T12:00:00.001Z",
                  "format": "date-time"
                },
                "status": {
                  "description": "One of:\n\n- `verifying`: The payment has been [created](#outbound-payments-create-an-outbound-payment) and the verification process has begun.\n- `pending_approval`: The payment is awaiting [approval](#outbound-payments-approve-an-outbound-payment).\n- `scheduled`: The payment has passed verification & [approval](#outbound-payments-approve-an-outbound-payment), but processing has not yet begun.\n- `executing`: The execution date has arrived and the payment has been placed in queue for processing.\n- `executed`: The payment has been accepted by the scheme and is now on its way to the recipient.\n- `cancelled`: The payment has been [cancelled](#outbound-payments-cancel-an-outbound-payment) or was not [approved](#outbound-payments-approve-an-outbound-payment) on time.\n- `failed`: The payment was not sent, usually due to an error while or after executing.",
                  "example": "cancelled",
                  "enum": [
                    "verifying",
                    "pending_approval",
                    "scheduled",
                    "executing",
                    "executed",
                    "cancelled",
                    "failed"
                  ],
                  "type": "string"
                },
                "amount": {
                  "type": "integer",
                  "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                  "example": 1000
                },
                "scheme": {
                  "description": "Bank payment scheme to process the outbound payment. Currently only \"faster_payments\" (GBP) is supported.",
                  "example": "faster_payments",
                  "enum": [
                    "faster_payments"
                  ],
                  "type": "string"
                },
                "currency": {
                  "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency. Currently only \"GBP\" is supported.",
                  "example": "GBP",
                  "enum": [
                    "GBP"
                  ],
                  "type": "string"
                },
                "execution_date": {
                  "type": "string",
                  "description": "A future date on which the outbound payment should be sent.\nIf not specified, the payment will be sent as soon as possible.",
                  "example": "2024-08-31",
                  "format": "date"
                },
                "description": {
                  "type": "string",
                  "description": "A human-readable description of the outbound payment",
                  "example": "Reward Payment (August 2024)"
                },
                "reference": {
                  "type": "string",
                  "description": "An optional reference that will appear on your customer's bank statement.\nThe character limit for this reference is dependent on the scheme.<br />\n<strong>Faster Payments</strong> - 18 characters, including: \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 &-./\"<br />",
                  "example": "GC-QC2FI7GBEW7VCXL"
                },
                "is_withdrawal": {
                  "type": "boolean",
                  "description": "Indicates whether the outbound payment is a withdrawal to your verified business bank account.",
                  "example": true
                },
                "links": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "creditor": {
                      "type": "string",
                      "description": "ID of the creditor who sends the outbound payment.",
                      "example": "CR123"
                    },
                    "customer": {
                      "type": "string",
                      "description": "ID of the [customer](#core-endpoints-customers) that receives this outbound payment",
                      "example": "CU123"
                    },
                    "recipient_bank_account": {
                      "type": "string",
                      "description": "ID of the customer bank account which receives the outbound payment.",
                      "example": "BA123"
                    },
                    "outbound_payment_import": {
                      "type": "string",
                      "description": "ID of the outbound payment import that created this outbound payment.",
                      "example": "IM123"
                    }
                  }
                },
                "verifications": {
                  "type": "object",
                  "nullable": true,
                  "description": "Contains details of the verifications performed for the outbound payment",
                  "properties": {
                    "recipient_bank_account_holder_verification": {
                      "type": "object",
                      "nullable": true,
                      "description": "Checks if the recipient owns the provided bank account",
                      "properties": {
                        "type": {
                          "description": "Type of the verification that has been performed\neg. [Confirmation of Payee](https://www.wearepay.uk/what-we-do/overlay-services/confirmation-of-payee/)",
                          "example": "confirmation_of_payee",
                          "enum": [
                            "confirmation_of_payee"
                          ],
                          "type": "string"
                        },
                        "result": {
                          "description": "Result of the verification, could be one of\n\n- `full_match`: The verification has confirmed that the account name exactly matches the details provided.\n- `partial_match`: The verification has confirmed that the account name is similar but does not match to the details provided.\n- `no_match`: The verification concludes the provided name does not match the account details.\n- `unable_to_match`: The verification could not be performed due to recipient bank issues or technical issues",
                          "example": "partial_match",
                          "enum": [
                            "full_match",
                            "partial_match",
                            "no_match",
                            "unable_to_match"
                          ],
                          "type": "string"
                        },
                        "actual_account_name": {
                          "type": "string",
                          "nullable": true,
                          "description": "The actual account name returned by the recipient's bank, populated only in the case of a partial match.",
                          "example": "Jo Doe"
                        }
                      }
                    }
                  }
                },
                "metadata": {
                  "type": "object",
                  "description": "Key-value store of custom data. Up to 3 keys are permitted, with\nkey names up to 50 characters and values up to 500 characters."
                }
              }
            }
          },
          "payer_authorisations": {
            "type": "array",
            "description": "A list of payer authorisations linked to the events returned in the list of events.",
            "items": {
              "type": "object",
              "description": "<p class=\"restricted-notice\">\n  Don't use Payer Authorisations for new integrations.\n  It is deprecated in favour of\n  <a href=\"https://developer.gocardless.com/getting-started/billing-requests/overview/\">\n  Billing Requests</a>. Use Billing Requests to build any future integrations.\n</p>\n\nPayer Authorisation resource acts as a wrapper for creating customer, bank account and mandate details in a single request.\nPayerAuthorisation API enables the integrators to build their own custom payment pages.\n\nThe process to use the Payer Authorisation API is as follows:\n\n  1. Create a Payer Authorisation, either empty or with already available information\n  2. Update the authorisation with additional information or fix any mistakes\n  3. Submit the authorisation, after the payer has reviewed their information\n  4. [coming soon] Redirect the payer to the verification mechanisms from the response of the Submit request (this will be introduced as a non-breaking change)\n  5. Confirm the authorisation to indicate that the resources can be created\n\nAfter the Payer Authorisation is confirmed, resources will eventually be created as it's an asynchronous process.\n\nTo retrieve the status and ID of the linked resources you can do one of the following:\n<ol>\n  <li> Listen to <code>  payer_authorisation_completed </code>  <a href=\"#appendix-webhooks\"> webhook</a> (recommended)</li>\n  <li> Poll the GET <a href=\"#payer-authorisations-get-a-single-payer-authorisation\"> endpoint</a></li>\n  <li> Poll the GET events API <code>https://api.gocardless.com/events?payer_authorisation={id}&action=completed</code> </li>\n</ol>\n\n<p class=\"notice\">\n  Note that the <code>create</code> and <code>update</code> endpoints behave differently than\n  other existing <code>create</code> and <code>update</code> endpoints. The Payer Authorisation is still saved if incomplete data is provided.\n  We return the list of incomplete data in the <code>incomplete_fields</code> along with the resources in the body of the response.\n  The bank account details(account_number, bank_code & branch_code) must be sent together rather than splitting across different request for both <code>create</code> and <code>update</code> endpoints.\n  <br><br>\n  The API is designed to be flexible and allows you to collect information in multiple steps without storing any sensitive data in the browser or in your servers.\n</p>",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier, beginning with \"PA\".",
                  "example": "PA123"
                },
                "created_at": {
                  "type": "string",
                  "nullable": true,
                  "description": "[Timestamp](#api-usage-dates-and-times), recording when this Payer Authorisation was created.",
                  "example": "2020-01-01T12:00:00.000Z",
                  "format": "date-time"
                },
                "customer": {
                  "type": "object",
                  "description": "All details required for the creation of a [Customer](#core-endpoints-customers).",
                  "properties": {
                    "email": {
                      "type": "string",
                      "nullable": true,
                      "description": "Customer's email address. Required in most cases, as this allows GoCardless to send notifications to this customer.",
                      "example": "user@example.com"
                    },
                    "given_name": {
                      "type": "string",
                      "nullable": true,
                      "description": "Customer's first name. Required unless a `company_name` is provided.",
                      "example": "Frank"
                    },
                    "family_name": {
                      "type": "string",
                      "nullable": true,
                      "description": "Customer's surname. Required unless a `company_name` is provided.",
                      "example": "Osborne"
                    },
                    "company_name": {
                      "type": "string",
                      "nullable": true,
                      "description": "Customer's company name. Required unless a `given_name` and `family_name` are provided. For Canadian customers, the use of a `company_name` value will mean that any mandate created from this customer will be considered to be a \"Business PAD\" (otherwise, any mandate will be considered to be a \"Personal PAD\").",
                      "example": "Hamilton Trading Ltd."
                    },
                    "address_line1": {
                      "type": "string",
                      "nullable": true,
                      "description": "The first line of the customer's address.",
                      "example": "221B Baker Street"
                    },
                    "address_line2": {
                      "type": "string",
                      "nullable": true,
                      "description": "The second line of the customer's address.",
                      "example": "Marylebone"
                    },
                    "address_line3": {
                      "type": "string",
                      "nullable": true,
                      "description": "The third line of the customer's address.",
                      "example": "City of Westminster"
                    },
                    "city": {
                      "type": "string",
                      "nullable": true,
                      "description": "The city of the customer's address.",
                      "example": "London"
                    },
                    "region": {
                      "type": "string",
                      "nullable": true,
                      "description": "The customer's address region, county or department. For US customers a 2 letter [ISO3166-2:US](https://en.wikipedia.org/wiki/ISO_3166-2:US) state code is required (e.g. `CA` for California).",
                      "example": "Greater London"
                    },
                    "postal_code": {
                      "type": "string",
                      "nullable": true,
                      "description": "The customer's postal code.",
                      "example": "NW1 6XE"
                    },
                    "country_code": {
                      "type": "string",
                      "nullable": true,
                      "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                      "example": "GB"
                    },
                    "locale": {
                      "type": "string",
                      "nullable": true,
                      "description": "An [IETF Language Tag](https://tools.ietf.org/html/rfc5646), used for both language\nand regional variations of our product.\n",
                      "example": "en-GB"
                    },
                    "swedish_identity_number": {
                      "type": "string",
                      "nullable": true,
                      "description": "For Swedish customers only. The civic/company number (personnummer, samordningsnummer, or organisationsnummer) of the customer. Must be supplied if the customer's bank account is denominated in Swedish krona (SEK). This field cannot be changed once it has been set.",
                      "example": "556564-5404"
                    },
                    "danish_identity_number": {
                      "type": "string",
                      "nullable": true,
                      "description": "For Danish customers only. The civic/company number (CPR or CVR) of the customer. Must be supplied if the customer's bank account is denominated in Danish krone (DKK).",
                      "example": "220550-6218"
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                    }
                  }
                },
                "bank_account": {
                  "type": "object",
                  "description": "All details required for the creation of a\n[Customer Bank Account](#core-endpoints-customer-bank-accounts).",
                  "properties": {
                    "account_holder_name": {
                      "type": "string",
                      "description": "Name of the account holder, as known by the bank. The full name provided when the customer is created is stored and is available via the API, but is transliterated, upcased, and truncated to 18 characters in bank submissions. This field is required unless the request includes a [customer bank account token](#javascript-flow-customer-bank-account-tokens).",
                      "example": "Billie Jean"
                    },
                    "account_number": {
                      "type": "string",
                      "nullable": true,
                      "description": "Bank account number - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`.",
                      "example": "55779911"
                    },
                    "account_number_ending": {
                      "type": "string",
                      "description": "The last few digits of the account number. Currently 4 digits for NZD bank accounts and 2 digits for other currencies.",
                      "example": "1234"
                    },
                    "account_number_suffix": {
                      "type": "string",
                      "nullable": true,
                      "description": "Account number suffix (only for bank accounts denominated in NZD) - see [local details](#local-bank-details-new-zealand) for more information.",
                      "example": "00"
                    },
                    "bank_code": {
                      "type": "string",
                      "nullable": true,
                      "description": "Bank code - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`."
                    },
                    "branch_code": {
                      "type": "string",
                      "nullable": true,
                      "description": "Branch code - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`.",
                      "example": "20-00-00"
                    },
                    "iban": {
                      "type": "string",
                      "nullable": true,
                      "description": "International Bank Account Number. Alternatively you can provide [local details](#appendix-local-bank-details). IBANs are not accepted for Swedish bank accounts denominated in SEK - you must supply [local details](#local-bank-details-sweden).",
                      "example": "GB60BARC20000055779911"
                    },
                    "country_code": {
                      "type": "string",
                      "nullable": true,
                      "description": "[ISO 3166-1 alpha-2 code](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements). Defaults to the country code of the `iban` if supplied, otherwise is required.",
                      "example": "GB"
                    },
                    "currency": {
                      "type": "string",
                      "nullable": true,
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                      "example": "EUR"
                    },
                    "account_type": {
                      "description": "Bank account type. Required for USD-denominated bank accounts. Must not be provided for bank accounts in other currencies. See [local details](#local-bank-details-united-states) for more information.",
                      "example": "savings",
                      "enum": [
                        "savings",
                        "checking"
                      ],
                      "nullable": true,
                      "type": "string"
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                    }
                  }
                },
                "mandate": {
                  "type": "object",
                  "description": "All details required for the creation of a [Mandate](#core-endpoints-mandates).",
                  "properties": {
                    "reference": {
                      "type": "string",
                      "nullable": true,
                      "description": "Unique reference. Different schemes have different length and [character set](#appendix-character-sets) requirements. GoCardless will generate a unique reference satisfying the different scheme requirements if this field is left blank.",
                      "example": "REF-123"
                    },
                    "scheme": {
                      "description": "A bank payment scheme. Currently \"ach\", \"autogiro\", \"bacs\", \"becs\", \"becs_nz\", \"betalingsservice\", \"faster_payments\", \"pad\", \"pay_to\" and \"sepa_core\" are supported.",
                      "example": "bacs",
                      "enum": [
                        "ach",
                        "autogiro",
                        "bacs",
                        "becs",
                        "becs_nz",
                        "betalingsservice",
                        "faster_payments",
                        "pad",
                        "pay_to",
                        "sepa_core"
                      ],
                      "nullable": true,
                      "type": "string"
                    },
                    "payer_ip_address": {
                      "type": "string",
                      "nullable": true,
                      "description": "For ACH customers only. Required for ACH customers. A string containing the IP address of the payer to whom the mandate belongs (i.e. as a result of their completion of a mandate setup flow in their browser).\n\nNot required for creating offline mandates where `authorisation_source` is set to telephone or paper.\n",
                      "example": "127.0.0.1"
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                    }
                  }
                },
                "incomplete_fields": {
                  "type": "array",
                  "description": "An array of fields which are missing and is required to set up the mandate.",
                  "items": {
                    "type": "object",
                    "description": "",
                    "properties": {
                      "field": {
                        "type": "string",
                        "description": "The root resource."
                      },
                      "message": {
                        "type": "string",
                        "description": "A localised error message"
                      },
                      "request_pointer": {
                        "type": "string",
                        "description": "The path to the field e.g. \"/payer_authorisations/customer/city\""
                      }
                    }
                  }
                },
                "links": {
                  "type": "object",
                  "description": "IDs of the created resources. Available after the Payer Authorisation is completed.",
                  "properties": {
                    "customer": {
                      "type": "string",
                      "description": "Unique identifier, beginning with \"CU\".",
                      "example": "CU123"
                    },
                    "bank_account": {
                      "type": "string",
                      "description": "Unique identifier, beginning with \"BA\".",
                      "example": "BA123"
                    },
                    "mandate": {
                      "type": "string",
                      "description": "Unique identifier, beginning with \"MD\". Note that this prefix may not apply to mandates created before 2016.",
                      "example": "MD123"
                    }
                  }
                },
                "status": {
                  "description": "One of:\n\n- `created`: The PayerAuthorisation has been created, and not been confirmed yet\n- `submitted`: The payer information has been submitted\n- `confirmed`: PayerAuthorisation is confirmed and resources are ready to be created\n- `completed`: The PayerAuthorisation has been completed and customer, bank_account and mandate has been created\n- `failed`: The PayerAuthorisation has failed and customer, bank_account and mandate is not created",
                  "example": "created",
                  "enum": [
                    "created",
                    "submitted",
                    "confirmed",
                    "completed",
                    "failed"
                  ],
                  "type": "string"
                }
              }
            }
          },
          "payment_account_transactions": {
            "type": "array",
            "description": "A list of payment account transactions linked to the events returned in the list of events.",
            "items": {
              "type": "object",
              "description": "Payment account transactions represent movements of funds on a given payment account. The payment account is provisioned by GoCardless and is used to fund [outbound payments](#core-endpoints-outbound-payments).",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The unique ID of the payment account transaction.",
                  "example": "PATR1234"
                },
                "value_date": {
                  "type": "string",
                  "description": "The date of when the transaction occurred.",
                  "example": "2014-01-01",
                  "format": "date"
                },
                "reference": {
                  "type": "string",
                  "description": "The reference of the transaction. This is typically supplied by the sender.",
                  "example": "GC-058408d9"
                },
                "description": {
                  "type": "string",
                  "description": "The description of the transaction, if available",
                  "example": "Reward Payment (August 2024)"
                },
                "counterparty_name": {
                  "type": "string",
                  "description": "The name of the counterparty of the transaction. The counterparty is the recipient for a credit, or the sender for a debit.",
                  "example": "Acme Ltd"
                },
                "links": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "payout": {
                      "type": "string",
                      "description": "ID of the [payout](#core-endpoints-payouts) linked to the transaction.",
                      "example": "PO123"
                    },
                    "outbound_payment": {
                      "type": "string",
                      "description": "ID of the [outbound_payment](#core-endpoints-outbound-payments) linked to the transaction",
                      "example": "OUT123"
                    },
                    "payment_bank_account": {
                      "type": "string",
                      "description": "ID of the payment bank account.",
                      "example": "BA123"
                    }
                  }
                },
                "currency": {
                  "type": "string",
                  "description": "The currency of the transaction.",
                  "enum": [
                    "GBP"
                  ]
                },
                "direction": {
                  "description": "The direction of the transaction. Debits mean money leaving the account (e.g. outbound payment), while credits signify money coming in (e.g. manual top-up).",
                  "example": "credit",
                  "enum": [
                    "credit",
                    "debit"
                  ],
                  "type": "string"
                },
                "amount": {
                  "type": "integer",
                  "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                  "example": 1000
                },
                "balance_after_transaction": {
                  "type": "integer",
                  "description": "Balance after transaction, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                  "example": 1000
                }
              }
            }
          },
          "payments": {
            "type": "array",
            "description": "A list of payments linked to the events returned in the list of events.",
            "items": {
              "type": "object",
              "description": "Payment objects represent payments from a [customer](#core-endpoints-customers) to a [creditor](#core-endpoints-creditors), taken against a Direct Debit [mandate](#core-endpoints-mandates).\n\nGoCardless will notify you via a [webhook](#appendix-webhooks) whenever the state of a payment changes.",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier, beginning with \"PM\".",
                  "example": "PM123"
                },
                "created_at": {
                  "type": "string",
                  "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                  "example": "2014-01-01T12:00:00.000Z",
                  "format": "date-time"
                },
                "amount": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\nMinimum and maximum amounts vary by payment scheme. For more information, see [Transaction limits](https://support.gocardless.com/hc/en-gb/articles/115000309245-Transaction-limits)\n\nFor Variable Recurring Payments (VRP), this must not exceed the mandate's `max_amount_per_payment`\nconstraint.",
                  "example": 1000
                },
                "amount_refunded": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "description": "Amount [refunded](#core-endpoints-refunds), in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                  "example": 150
                },
                "currency": {
                  "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                  "example": "EUR",
                  "enum": [
                    "AUD",
                    "CAD",
                    "DKK",
                    "EUR",
                    "GBP",
                    "NZD",
                    "SEK",
                    "USD"
                  ],
                  "type": "string"
                },
                "description": {
                  "type": "string",
                  "nullable": true,
                  "description": "A human-readable description of the payment. This will be included in the notification email GoCardless sends to your customer if your organisation does not send its own notifications (see [compliance requirements](#appendix-compliance-requirements)).",
                  "example": "One-off upgrade fee"
                },
                "charge_date": {
                  "type": "string",
                  "nullable": true,
                  "description": "A future date on which the payment should be collected. If not specified, the payment will be collected as soon as possible. If the value is before the [mandate](#core-endpoints-mandates)'s `next_possible_charge_date` creation will fail. If the value is not a working day it will be rolled forwards to the next available one.",
                  "example": "2014-05-21",
                  "format": "date"
                },
                "reference": {
                  "type": "string",
                  "nullable": true,
                  "description": "An optional reference that will appear on your customer's bank statement. The character limit for this reference is dependent on the scheme.<br /> <strong>ACH</strong> - 10 characters<br /> <strong>Autogiro</strong> - 11 characters<br /> <strong>Bacs</strong> - 10 characters<br /> <strong>BECS</strong> - 30 characters<br /> <strong>BECS NZ</strong> - 12 characters<br /> <strong>Betalingsservice</strong> - 30 characters<br /> <strong>Faster Payments</strong> - 18 characters<br /> <strong>PAD</strong> - scheme doesn't offer references<br /> <strong>PayTo</strong> - 18 characters<br /> <strong>SEPA</strong> - 140 characters<br /> Note that this reference must be unique (for each merchant) for the BECS scheme as it is a scheme requirement. <p class='restricted-notice'><strong>Restricted</strong>: You can only specify a payment reference for Bacs payments (that is, when collecting from the UK) if you're on the <a href='https://gocardless.com/pricing'>GoCardless Plus, Pro or Enterprise packages</a>.</p> <p class='restricted-notice'><strong>Restricted</strong>: You can not specify a payment reference for Faster Payments.</p>",
                  "example": "WINEBOX001"
                },
                "metadata": {
                  "type": "object",
                  "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                },
                "status": {
                  "description": "One of:\n\n- `pending_customer_approval`: we're waiting for the customer to approve this payment\n- `pending_submission`: the payment has been created, but not yet submitted to the banks\n- `submitted`: the payment has been submitted to the banks\n- `confirmed`: the payment has been confirmed as collected\n- `paid_out`: the payment has been included in a [payout](#core-endpoints-payouts)\n- `cancelled`: the payment has been cancelled\n- `customer_approval_denied`: the customer has denied approval for the payment. You should contact the customer directly\n- `failed`: the payment failed to be processed. Note that payments can fail after being confirmed if the failure message is sent late by the banks.\n- `charged_back`: the payment has been charged back",
                  "example": "submitted",
                  "enum": [
                    "pending_customer_approval",
                    "pending_submission",
                    "submitted",
                    "confirmed",
                    "paid_out",
                    "cancelled",
                    "customer_approval_denied",
                    "failed",
                    "charged_back"
                  ],
                  "type": "string"
                },
                "app_fee": {
                  "oneOf": [
                    {
                      "type": "string",
                      "nullable": true
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "description": "The amount to be deducted from the payment as the OAuth app''s fee,\nin the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\nOnly present if the payment was created via an app.",
                  "example": 100
                },
                "links": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "mandate": {
                      "type": "string",
                      "description": "ID of the [mandate](#core-endpoints-mandates) against which this payment should be collected.",
                      "example": "MD123"
                    },
                    "creditor": {
                      "type": "string",
                      "description": "ID of [creditor](#core-endpoints-creditors) to which the collected payment will be sent.",
                      "example": "CR123"
                    },
                    "payout": {
                      "type": "string",
                      "description": "ID of [payout](#core-endpoints-payouts) which contains the funds from this payment.<br/>_Note_: this property will not be present until the payment has been successfully collected.",
                      "example": "PO123"
                    },
                    "subscription": {
                      "type": "string",
                      "description": "ID of [subscription](#core-endpoints-subscriptions) from which this payment was created.<br/>_Note_: this property will only be present if this payment is part of a subscription.",
                      "example": "SU123"
                    },
                    "instalment_schedule": {
                      "type": "string",
                      "description": "ID of [instalment_schedule](#core-endpoints-instalment-schedules) from which this payment was created.<br/>**Note**: this property will only be present if this payment is part of an instalment schedule.",
                      "example": "IS123"
                    }
                  }
                },
                "faster_ach": {
                  "type": "boolean",
                  "nullable": true,
                  "description": "This field indicates whether the ACH payment is processed through Faster\nACH or standard ACH.\n\nIt is only present in the API response for ACH payments."
                },
                "fx": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "exchange_rate": {
                      "type": "string",
                      "nullable": true,
                      "description": "Rate used in the foreign exchange of the `amount` into the `fx_currency`.\nPresent only after a resource is paid out. Has up to 10 decimal places.",
                      "example": "1.1234567890"
                    },
                    "estimated_exchange_rate": {
                      "type": "string",
                      "nullable": true,
                      "description": "Estimated rate that will be used in the foreign exchange of the `amount` into the `fx_currency`.\nThis will vary based on the prevailing market rate until the moment that it is paid out.\nPresent only before a resource is paid out. Has up to 10 decimal places.",
                      "example": "1.1234567890"
                    },
                    "fx_amount": {
                      "oneOf": [
                        {
                          "type": "string",
                          "nullable": true
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Amount that was paid out in the `fx_currency` after foreign exchange.\nPresent only after the resource has been paid out.",
                      "example": 1150
                    },
                    "fx_currency": {
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) code for the currency in which amounts will be paid out (after foreign exchange). Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported. Present only if payouts will be (or were) made via foreign exchange.",
                      "example": "EUR",
                      "enum": [
                        "AUD",
                        "CAD",
                        "DKK",
                        "EUR",
                        "GBP",
                        "NZD",
                        "SEK",
                        "USD"
                      ],
                      "nullable": true,
                      "type": "string"
                    }
                  }
                },
                "retry_if_possible": {
                  "type": "boolean",
                  "description": "On failure, automatically retry the payment using [intelligent retries](/success-plus/overview). Default is `false`. <p class=\"notice\"><strong>Important</strong>: To be able to use intelligent retries, Success+ needs to be enabled in [GoCardless dashboard](https://manage.gocardless.com/success-plus). </p>"
                },
                "scheme": {
                  "type": "string",
                  "nullable": true,
                  "description": "A bank payment scheme. Currently \"ach\", \"autogiro\", \"bacs\", \"becs\", \"becs_nz\", \"betalingsservice\", \"faster_payments\", \"pad\", \"pay_to\", \"sepa_core\", \"sepa_credit_transfer\" and \"sepa_instant_credit_transfer\" are supported.",
                  "example": "bacs"
                }
              }
            }
          },
          "payouts": {
            "type": "array",
            "description": "A list of payouts linked to the events returned in the list of events.",
            "items": {
              "type": "object",
              "description": "Payouts represent transfers from GoCardless to a [creditor](#core-endpoints-creditors). Each payout contains the funds collected from one or many [payments](#core-endpoints-payments). All the payments in a payout will have been collected in the same currency. Payouts are created automatically after a payment has been successfully collected.",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier, beginning with \"PO\".",
                  "example": "PO123"
                },
                "created_at": {
                  "type": "string",
                  "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                  "example": "2014-01-01T12:00:00.000Z",
                  "format": "date-time"
                },
                "amount": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "description": "Amount in minor unit (e.g. pence in GBP, cents in EUR).",
                  "example": 1000
                },
                "deducted_fees": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "description": "Fees that have already been deducted from the payout amount in minor unit (e.g. pence in GBP, cents in EUR), inclusive of tax if applicable.\n<br />\nFor each `late_failure_settled` or `chargeback_settled` action, we refund the transaction fees in a payout. This means that a payout can have a negative `deducted_fees` value.\n<br />\nThis field is calculated as `(GoCardless fees + app fees + surcharge fees) - (refunded fees)`\n<br />\nIf the merchant is invoiced for fees separately from the payout, then `deducted_fees` will be 0.",
                  "example": 20
                },
                "currency": {
                  "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                  "example": "EUR",
                  "enum": [
                    "AUD",
                    "CAD",
                    "DKK",
                    "EUR",
                    "GBP",
                    "NZD",
                    "SEK",
                    "USD"
                  ],
                  "type": "string"
                },
                "reference": {
                  "type": "string",
                  "description": "Reference which appears on the creditor's bank statement.",
                  "example": "ref-1"
                },
                "status": {
                  "description": "One of:\n\n- `pending`: the payout has been created, but not yet sent to your bank or it is in the process of being exchanged through our FX provider.\n- `paid`: the payout has been sent to the your bank. FX payouts will become `paid` after we emit the `fx_rate_confirmed` webhook.\n- `bounced`: the payout bounced when sent, the payout can be retried.",
                  "example": "pending",
                  "enum": [
                    "pending",
                    "paid",
                    "bounced"
                  ],
                  "type": "string"
                },
                "payout_type": {
                  "description": "Whether a payout contains merchant revenue or partner fees.",
                  "example": "merchant",
                  "enum": [
                    "merchant",
                    "partner"
                  ],
                  "type": "string"
                },
                "arrival_date": {
                  "type": "string",
                  "nullable": true,
                  "description": "Date the payout is due to arrive in the creditor's bank account.\nOne of:\n\n- `yyyy-mm-dd`: the payout has been paid and is due to arrive in the creditor's bank account on this day\n- `null`: the payout hasn't been paid yet\n",
                  "example": "2014-01-01"
                },
                "links": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "creditor": {
                      "type": "string",
                      "description": "ID of [creditor](#core-endpoints-creditors) who will receive this payout, i.e. the owner of the `creditor_bank_account`.",
                      "example": "CR123"
                    },
                    "creditor_bank_account": {
                      "type": "string",
                      "description": "ID of [bank account](#core-endpoints-creditor-bank-accounts) which this will be sent to.",
                      "example": "BA123"
                    }
                  }
                },
                "fx": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "exchange_rate": {
                      "type": "string",
                      "nullable": true,
                      "description": "Rate used in the foreign exchange of the `amount` into the `fx_currency`.\nPresent only after a resource is paid out. Has up to 10 decimal places.",
                      "example": "1.1234567890"
                    },
                    "estimated_exchange_rate": {
                      "type": "string",
                      "nullable": true,
                      "description": "Estimated rate that will be used in the foreign exchange of the `amount` into the `fx_currency`.\nThis will vary based on the prevailing market rate until the moment that it is paid out.\nPresent only before a resource is paid out. Has up to 10 decimal places.",
                      "example": "1.1234567890"
                    },
                    "fx_amount": {
                      "oneOf": [
                        {
                          "type": "string",
                          "nullable": true
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Amount that was paid out in the `fx_currency` after foreign exchange.\nPresent only after the resource has been paid out.",
                      "example": 1150
                    },
                    "fx_currency": {
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) code for the currency in which amounts will be paid out (after foreign exchange). Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported. Present only if payouts will be (or were) made via foreign exchange.",
                      "example": "EUR",
                      "enum": [
                        "AUD",
                        "CAD",
                        "DKK",
                        "EUR",
                        "GBP",
                        "NZD",
                        "SEK",
                        "USD"
                      ],
                      "nullable": true,
                      "type": "string"
                    }
                  }
                },
                "tax_currency": {
                  "type": "string",
                  "nullable": true,
                  "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) code for the currency in which tax is paid out to the tax authorities of your tax jurisdiction. Currently “EUR”, “GBP”, for French or British merchants, this will be `null` if tax is not applicable <em>beta</em>",
                  "example": "EUR"
                },
                "metadata": {
                  "type": "object",
                  "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters. _Note:_ This should not be used for storing PII data.",
                  "example": {
                    "salesforce_id": "ABCD1234"
                  }
                }
              }
            }
          },
          "refunds": {
            "type": "array",
            "description": "A list of refunds linked to the events returned in the list of events.",
            "items": {
              "type": "object",
              "description": "Refund objects represent (partial) refunds of a [payment](#core-endpoints-payments) back to the [customer](#core-endpoints-customers).\n\nGoCardless will notify you via a [webhook](#appendix-webhooks) whenever a refund is created, and will update the `amount_refunded` property of the payment.",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier, beginning with \"RF\".",
                  "example": "RF123"
                },
                "created_at": {
                  "type": "string",
                  "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                  "example": "2014-01-01T12:00:00.000Z",
                  "format": "date-time"
                },
                "amount": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "description": "Amount in minor unit (e.g. pence in GBP, cents in EUR).",
                  "example": 150
                },
                "currency": {
                  "type": "string",
                  "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. This is set to the currency of the refund's [payment](#core-endpoints-payments).",
                  "example": "EUR"
                },
                "status": {
                  "description": "One of:\n\n- `created`: the refund has been created\n- `pending_submission`: the refund has been created, but not yet submitted to the banks\n- `submitted`: the refund has been submitted to the banks\n- `paid`:  the refund has been included in a [payout](#core-endpoints-payouts)\n- `cancelled`: the refund has been cancelled\n- `bounced`: the refund has failed to be paid\n- `funds_returned`: the refund has had its funds returned",
                  "example": "submitted",
                  "enum": [
                    "created",
                    "pending_submission",
                    "submitted",
                    "paid",
                    "cancelled",
                    "bounced",
                    "funds_returned"
                  ],
                  "type": "string"
                },
                "reference": {
                  "type": "string",
                  "nullable": true,
                  "description": "An optional reference that will appear on your customer's bank statement. The character limit for this reference is dependent on the scheme.<br /> <strong>ACH</strong> - 10 characters<br /> <strong>Autogiro</strong> - 11 characters<br /> <strong>Bacs</strong> - 10 characters<br /> <strong>BECS</strong> - 30 characters<br /> <strong>BECS NZ</strong> - 12 characters<br /> <strong>Betalingsservice</strong> - 30 characters<br /> <strong>Faster Payments</strong> - 18 characters<br /> <strong>PAD</strong> - scheme doesn't offer references<br /> <strong>PayTo</strong> - 18 characters<br /> <strong>SEPA</strong> - 140 characters<br /> Note that this reference must be unique (for each merchant) for the BECS scheme as it is a scheme requirement. <p class='restricted-notice'><strong>Restricted</strong>: You can only specify a payment reference for Bacs payments (that is, when collecting from the UK) if you're on the <a href='https://gocardless.com/pricing'>GoCardless Plus, Pro or Enterprise packages</a>.</p> <p class='restricted-notice'><strong>Restricted</strong>: You can not specify a payment reference for Faster Payments.</p>",
                  "example": "WINEBOX001"
                },
                "metadata": {
                  "type": "object",
                  "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                },
                "links": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "payment": {
                      "type": "string",
                      "description": "ID of the [payment](#core-endpoints-payments) against which the refund is being made.",
                      "example": "PM123"
                    },
                    "mandate": {
                      "type": "string",
                      "description": "ID of the [mandate](#core-endpoints-mandates) against which the refund is being made.",
                      "example": "MD123"
                    }
                  }
                },
                "fx": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "exchange_rate": {
                      "type": "string",
                      "nullable": true,
                      "description": "Rate used in the foreign exchange of the `amount` into the `fx_currency`.\nPresent only after a resource is paid out. Has up to 10 decimal places.",
                      "example": "1.1234567890"
                    },
                    "estimated_exchange_rate": {
                      "type": "string",
                      "nullable": true,
                      "description": "Estimated rate that will be used in the foreign exchange of the `amount` into the `fx_currency`.\nThis will vary based on the prevailing market rate until the moment that it is paid out.\nPresent only before a resource is paid out. Has up to 10 decimal places.",
                      "example": "1.1234567890"
                    },
                    "fx_amount": {
                      "oneOf": [
                        {
                          "type": "string",
                          "nullable": true
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Amount that was paid out in the `fx_currency` after foreign exchange.\nPresent only after the resource has been paid out.",
                      "example": 1150
                    },
                    "fx_currency": {
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) code for the currency in which amounts will be paid out (after foreign exchange). Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported. Present only if payouts will be (or were) made via foreign exchange.",
                      "example": "EUR",
                      "enum": [
                        "AUD",
                        "CAD",
                        "DKK",
                        "EUR",
                        "GBP",
                        "NZD",
                        "SEK",
                        "USD"
                      ],
                      "nullable": true,
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "subscriptions": {
            "type": "array",
            "description": "A list of subscriptions linked to the events returned in the list of events.",
            "items": {
              "type": "object",
              "description": "Subscriptions create [payments](#core-endpoints-payments) according to a schedule.\n\n### Recurrence Rules\n\nThe following rules apply when specifying recurrence:\n\n- If `day_of_month` and `start_date` are not provided `start_date` will be the [mandate](#core-endpoints-mandates)'s `next_possible_charge_date` and the subscription will then recur based on the `interval` & `interval_unit`\n- If `month` or `day_of_month` are present the following validations apply:\n\n| __interval_unit__ | __month__                                      | __day_of_month__                           |\n| :---------------- | :--------------------------------------------- | :----------------------------------------- |\n| yearly            | optional (required if `day_of_month` provided) | optional (invalid if `month` not provided) |\n| monthly           | invalid                                        | optional                                   |\n| weekly            | invalid                                        | invalid                                    |\n\nExamples:\n\n| __interval_unit__ | __interval__ | __month__ | __day_of_month__ | valid?                                             |\n| :---------------- | :----------- | :-------- | :--------------- | :------------------------------------------------- |\n| yearly            | 1            | january   | -1               | valid                                              |\n| monthly           | 6            |           |                  | valid                                              |\n| monthly           | 6            |           | 12               | valid                                              |\n| weekly            | 2            |           |                  | valid                                              |\n| yearly            | 1            | march     |                  | invalid - missing `day_of_month`                   |\n| yearly            | 1            |           | 2                | invalid - missing `month`                          |\n| monthly           | 6            | august    | 12               | invalid - `month` must be blank                    |\n| weekly            | 2            | october   | 10               | invalid - `month` and `day_of_month` must be blank |\n\n### Rolling dates\n\nWhen a charge date falls on a non-business day, one of two things will happen:\n\n- if the recurrence rule specified `-1` as the `day_of_month`, the charge date will be rolled __backwards__ to the previous business day (i.e., the last working day of the month).\n- otherwise the charge date will be rolled __forwards__ to the next business day.",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier, beginning with \"SB\".",
                  "example": "SB123"
                },
                "created_at": {
                  "type": "string",
                  "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                  "example": "2014-01-01T12:00:00.000Z",
                  "format": "date-time"
                },
                "amount": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "description": "Amount in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                  "example": 1000
                },
                "name": {
                  "type": "string",
                  "nullable": true,
                  "description": "Optional name for the subscription. This will be set as the description on each payment created. Must not exceed 255 characters.",
                  "example": "12 month subscription"
                },
                "start_date": {
                  "type": "string",
                  "nullable": true,
                  "description": "The date on which the first payment should be charged. Must be on or after the [mandate](#core-endpoints-mandates)'s `next_possible_charge_date`. When left blank and `month` or `day_of_month` are provided, this will be set to the date of the first payment. If created without `month` or `day_of_month` this will be set as the mandate's `next_possible_charge_date`",
                  "example": "2014-10-21",
                  "format": "date"
                },
                "end_date": {
                  "type": "string",
                  "nullable": true,
                  "description": "Date on or after which no further payments should be created.\n<br />\nIf this field is blank and `count` is not specified, the subscription will continue forever.\n<br />\n<p class=\"deprecated-notice\"><strong>Deprecated</strong>: This field will be removed in a future API version. Use <code>count</code> to specify a number of payments instead.</p>",
                  "example": "2015-10-21",
                  "format": "date"
                },
                "interval": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "description": "Number of `interval_units` between customer charge dates. Must be greater than or equal to `1`. Must result in at least one charge date per year. Defaults to `1`.",
                  "example": 1
                },
                "interval_unit": {
                  "description": "The unit of time between customer charge dates. One of `weekly`, `monthly` or `yearly`.",
                  "example": "monthly",
                  "enum": [
                    "weekly",
                    "monthly",
                    "yearly"
                  ],
                  "type": "string"
                },
                "day_of_month": {
                  "oneOf": [
                    {
                      "type": "string",
                      "nullable": true
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "description": "As per RFC 2445. The day of the month to charge customers on. `1`-`28` or `-1` to indicate the last day of the month.",
                  "example": 28
                },
                "currency": {
                  "type": "string",
                  "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                  "example": "EUR"
                },
                "month": {
                  "description": "Name of the month on which to charge a customer. Must be lowercase. Only applies\nwhen the interval_unit is `yearly`.\n",
                  "example": "january",
                  "enum": [
                    "january",
                    "february",
                    "march",
                    "april",
                    "may",
                    "june",
                    "july",
                    "august",
                    "september",
                    "october",
                    "november",
                    "december"
                  ],
                  "nullable": true,
                  "type": "string"
                },
                "count": {
                  "oneOf": [
                    {
                      "type": "string",
                      "nullable": true
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "description": "The total number of payments that should be taken by this subscription.",
                  "example": 5
                },
                "payment_reference": {
                  "type": "string",
                  "nullable": true,
                  "description": "An optional payment reference. This will be set as the reference on each payment\ncreated and will appear on your customer's bank statement. See the documentation for\nthe [create payment endpoint](#payments-create-a-payment) for more details.\n<br />\n<p class=\"restricted-notice\"><strong>Restricted</strong>: You need your own Service User Number to specify a payment reference for Bacs payments.</p>",
                  "example": "GOLDPLAN"
                },
                "metadata": {
                  "type": "object",
                  "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                },
                "status": {
                  "type": "string",
                  "description": "One of:\n\n- `pending_customer_approval`: the subscription is waiting for customer approval before becoming active\n- `customer_approval_denied`: the customer did not approve the subscription\n- `active`: the subscription is currently active and will continue to create payments\n- `finished`: all of the payments scheduled for creation under this subscription have been created\n- `cancelled`: the subscription has been cancelled and will no longer create payments\n- `paused`: the subscription has been paused and will not create payments",
                  "example": "active",
                  "enum": [
                    "pending_customer_approval",
                    "customer_approval_denied",
                    "active",
                    "finished",
                    "cancelled",
                    "paused"
                  ]
                },
                "upcoming_payments": {
                  "type": "array",
                  "description": "Up to 10 upcoming payments with their amounts and charge dates.",
                  "example": [
                    {
                      "amount": 2500,
                      "charge_date": "2014-11-03"
                    }
                  ],
                  "items": {
                    "type": "object",
                    "properties": {
                      "charge_date": {
                        "type": "string",
                        "description": "The date on which this payment will be charged.",
                        "example": "2014-11-03",
                        "format": "date"
                      },
                      "amount": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer"
                          }
                        ],
                        "description": "The amount of this payment, in minor unit (e.g. pence in GBP, cents in EUR).",
                        "example": "2500"
                      }
                    }
                  }
                },
                "app_fee": {
                  "oneOf": [
                    {
                      "type": "string",
                      "nullable": true
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "description": "The amount to be deducted from each payment as an app fee, to be paid to the partner integration which created the subscription, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                  "example": 100
                },
                "links": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "mandate": {
                      "type": "string",
                      "description": "ID of the associated [mandate](#core-endpoints-mandates) which the subscription will create payments against.",
                      "example": "MD123"
                    }
                  }
                },
                "retry_if_possible": {
                  "type": "boolean",
                  "description": "On failure, automatically retry payments using [intelligent retries](/success-plus/overview). Default is `false`. <p class=\"notice\"><strong>Important</strong>: To be able to use intelligent retries, Success+ needs to be enabled in [GoCardless dashboard](https://manage.gocardless.com/success-plus). </p>"
                },
                "earliest_charge_date_after_resume": {
                  "type": "string",
                  "nullable": true,
                  "description": "The earliest date that will be used as a `charge_date` on payments\ncreated for this subscription if it is resumed. Only present for `paused` subscriptions.\nThis value will change over time.",
                  "example": "2014-11-03",
                  "format": "date"
                },
                "parent_plan_paused": {
                  "type": "boolean",
                  "description": "Whether the parent plan of this subscription is paused."
                }
              }
            }
          },
          "scheme_identifiers": {
            "type": "array",
            "description": "A list of scheme identifiers linked to the events returned in the list of events.",
            "items": {
              "type": "object",
              "description": "This represents a scheme identifier (e.g. a SUN in Bacs or a CID in SEPA). Scheme identifiers are used to specify the beneficiary name that appears on customers' bank statements.\n",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier, usually beginning with \"SU\".",
                  "example": "SU123"
                },
                "created_at": {
                  "type": "string",
                  "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                  "example": "2014-01-01T12:00:00.000Z",
                  "format": "date-time"
                },
                "name": {
                  "type": "string",
                  "description": "The name which appears on customers' bank statements. This should usually be the merchant's trading name."
                },
                "scheme": {
                  "description": "The scheme which this scheme identifier applies to.",
                  "example": "bacs",
                  "enum": [
                    "ach",
                    "autogiro",
                    "bacs",
                    "becs",
                    "becs_nz",
                    "betalingsservice",
                    "faster_payments",
                    "pad",
                    "pay_to",
                    "sepa",
                    "sepa_credit_transfer",
                    "sepa_instant_credit_transfer"
                  ],
                  "type": "string"
                },
                "reference": {
                  "type": "string",
                  "description": "The scheme-unique identifier against which payments are submitted."
                },
                "status": {
                  "description": "The status of the scheme identifier. Only `active` scheme identifiers will be applied to a creditor and used against payments.",
                  "example": "pending",
                  "enum": [
                    "pending",
                    "active"
                  ],
                  "type": "string"
                },
                "minimum_advance_notice": {
                  "type": "integer",
                  "description": "The minimum interval, in working days, between the sending of a pre-notification to the customer, and the charge date of a payment using this scheme identifier.\n\nBy default, GoCardless sends these notifications automatically. Please see our [compliance requirements](#appendix-compliance-requirements) for more details.",
                  "example": 3
                },
                "can_specify_mandate_reference": {
                  "type": "boolean",
                  "description": "Whether a custom reference can be submitted for mandates using this scheme identifier."
                },
                "currency": {
                  "description": "The currency of the scheme identifier.",
                  "example": "EUR",
                  "enum": [
                    "AUD",
                    "CAD",
                    "DKK",
                    "EUR",
                    "GBP",
                    "NZD",
                    "SEK",
                    "USD"
                  ],
                  "type": "string"
                },
                "address_line1": {
                  "type": "string",
                  "description": "The first line of the scheme identifier's support address.",
                  "example": "221B Baker Street"
                },
                "address_line2": {
                  "type": "string",
                  "nullable": true,
                  "description": "The second line of the scheme identifier's support address.",
                  "example": "Marylebone"
                },
                "address_line3": {
                  "type": "string",
                  "nullable": true,
                  "description": "The third line of the scheme identifier's support address.",
                  "example": "City of Westminster"
                },
                "city": {
                  "type": "string",
                  "description": "The city of the scheme identifier's support address.",
                  "example": "London"
                },
                "region": {
                  "type": "string",
                  "nullable": true,
                  "description": "The scheme identifier's support address region, county or department.",
                  "example": "Greater London"
                },
                "postal_code": {
                  "type": "string",
                  "description": "The scheme identifier's support postal code.",
                  "example": "NW1 6XE"
                },
                "country_code": {
                  "type": "string",
                  "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                  "example": "GB"
                },
                "email": {
                  "type": "string",
                  "description": "Scheme identifier's support email address.",
                  "example": "user@example.com"
                },
                "phone_number": {
                  "type": "string",
                  "description": "Scheme identifier's support phone number.",
                  "example": "+44 20 1234 1234"
                }
              }
            }
          },
          "customers": {
            "type": "array",
            "description": "A list of customers linked to the events returned in the list of events.",
            "items": {
              "type": "object",
              "description": "Customer objects hold the contact details for a customer. A customer can have several [customer bank accounts](#core-endpoints-customer-bank-accounts), which in turn can have several Direct Debit [mandates](#core-endpoints-mandates).",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier, beginning with \"CU\".",
                  "example": "CU123"
                },
                "created_at": {
                  "type": "string",
                  "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                  "example": "2014-01-01T12:00:00.000Z",
                  "format": "date-time"
                },
                "email": {
                  "type": "string",
                  "nullable": true,
                  "description": "Customer's email address. Required in most cases, as this allows GoCardless to send notifications to this customer.",
                  "example": "user@example.com"
                },
                "given_name": {
                  "type": "string",
                  "nullable": true,
                  "description": "Customer's first name. Required unless a `company_name` is provided.",
                  "example": "Frank"
                },
                "family_name": {
                  "type": "string",
                  "nullable": true,
                  "description": "Customer's surname. Required unless a `company_name` is provided.",
                  "example": "Osborne"
                },
                "company_name": {
                  "type": "string",
                  "nullable": true,
                  "description": "Customer's company name. Required unless a `given_name` and `family_name` are provided. For Canadian customers, the use of a `company_name` value will mean that any mandate created from this customer will be considered to be a \"Business PAD\" (otherwise, any mandate will be considered to be a \"Personal PAD\").",
                  "example": "Hamilton Trading Ltd."
                },
                "address_line1": {
                  "type": "string",
                  "nullable": true,
                  "description": "The first line of the customer's address.",
                  "example": "221B Baker Street"
                },
                "address_line2": {
                  "type": "string",
                  "nullable": true,
                  "description": "The second line of the customer's address.",
                  "example": "Marylebone"
                },
                "address_line3": {
                  "type": "string",
                  "nullable": true,
                  "description": "The third line of the customer's address.",
                  "example": "City of Westminster"
                },
                "city": {
                  "type": "string",
                  "nullable": true,
                  "description": "The city of the customer's address.",
                  "example": "London"
                },
                "region": {
                  "type": "string",
                  "nullable": true,
                  "description": "The customer's address region, county or department. For US customers a 2 letter [ISO3166-2:US](https://en.wikipedia.org/wiki/ISO_3166-2:US) state code is required (e.g. `CA` for California).",
                  "example": "Greater London"
                },
                "postal_code": {
                  "type": "string",
                  "nullable": true,
                  "description": "The customer's postal code.",
                  "example": "NW1 6XE"
                },
                "country_code": {
                  "type": "string",
                  "nullable": true,
                  "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                  "example": "GB"
                },
                "language": {
                  "type": "string",
                  "nullable": true,
                  "description": "[ISO 639-1](https://en.wikipedia.org/wiki/List_of_ISO_639-1_codes) code. Used as the language for notification emails sent by GoCardless if your organisation does not send its own (see [compliance requirements](#appendix-compliance-requirements)). Currently only \"en\", \"fr\", \"de\", \"pt\", \"es\", \"it\", \"nl\", \"da\", \"nb\", \"sl\", \"sv\" are supported. If this is not provided, the language will be chosen based on the `country_code` (if supplied) or default to \"en\".",
                  "example": "en"
                },
                "phone_number": {
                  "type": "string",
                  "nullable": true,
                  "description": "[ITU E.123](https://en.wikipedia.org/wiki/E.123) formatted phone number, including country code.",
                  "example": "+64 4 817 9999"
                },
                "swedish_identity_number": {
                  "type": "string",
                  "nullable": true,
                  "description": "For Swedish customers only. The civic/company number (personnummer, samordningsnummer, or organisationsnummer) of the customer. Must be supplied if the customer's bank account is denominated in Swedish krona (SEK). This field cannot be changed once it has been set.",
                  "example": "556564-5404"
                },
                "danish_identity_number": {
                  "type": "string",
                  "nullable": true,
                  "description": "For Danish customers only. The civic/company number (CPR or CVR) of the customer. Must be supplied if the customer's bank account is denominated in Danish krone (DKK).",
                  "example": "220550-6218"
                },
                "metadata": {
                  "type": "object",
                  "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                }
              }
            }
          }
        }
      },
      "event_pagination_meta": {
        "type": "object",
        "title": "EventPaginationMeta",
        "description": "Cursor pagination information",
        "properties": {
          "limit": {
            "type": "integer",
            "example": 50
          },
          "cursors": {
            "type": "object",
            "properties": {
              "before": {
                "type": "string",
                "nullable": true,
                "description": "Cursor pointing to the end of the desired set."
              },
              "after": {
                "type": "string",
                "nullable": true,
                "description": "Cursor pointing to the start of the desired set."
              }
            }
          }
        }
      },
      "event_single_resource_response": {
        "type": "object",
        "title": "EventSingleResourceResponse",
        "description": "",
        "properties": {
          "events": {
            "type": "object",
            "description": "Events are stored for all webhooks. An event refers to a resource which has been updated, for example a payment which has been collected, or a mandate which has been transferred. Event creation is an asynchronous process, so it can take some time between an action occurring and its corresponding event getting included in API responses. See [here](#event-types) for a complete list of event types.\n<p class=\"notice\"><strong>Important</strong>: Events older than 18 months will be archived and no longer accessible via the API or exports. Archival will begin no sooner than 1 August 2026 in sandbox environments, and no sooner than 1 October 2026 in live environments. Events within the 18-month window are unaffected. If you need archived data, contact GoCardless support.</p>",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier, beginning with \"EV\".",
                "example": "EV123"
              },
              "created_at": {
                "type": "string",
                "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                "example": "2014-01-01T12:00:00.000Z",
                "format": "date-time"
              },
              "resource_type": {
                "description": "The resource type for this event. One of:\n\n- `billing_requests`\n- `creditors`\n- `exports`\n- `instalment_schedules`\n- `mandates`\n- `payer_authorisations`\n- `payments`\n- `payouts`\n- `refunds`\n- `scheme_identifiers`\n- `subscriptions`\n- `outbound_payments`\n- `payment_account_transactions`",
                "example": "mandates",
                "enum": [
                  "billing_requests",
                  "creditors",
                  "customers",
                  "exports",
                  "instalment_schedules",
                  "mandates",
                  "organisations",
                  "outbound_payments",
                  "payer_authorisations",
                  "payments",
                  "payment_account_transactions",
                  "payouts",
                  "refunds",
                  "scheme_identifiers",
                  "subscriptions"
                ],
                "type": "string"
              },
              "action": {
                "type": "string",
                "description": "What has happened to the resource. See [Event Types](#event-types) for the possible actions.",
                "example": "cancelled"
              },
              "customer_notifications": {
                "type": "array",
                "nullable": true,
                "description": "Present only in webhooks when an integrator is authorised to send their own\nnotifications. See [here](/getting-started/api/handling-customer-notifications/)\nfor further information.\n",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The id of the notification.",
                      "example": "EV1D18JEXAMPLE"
                    },
                    "type": {
                      "type": "string",
                      "description": "See [here](#core-endpoints-customer-notifications) for a complete list of customer notification types."
                    },
                    "mandatory": {
                      "type": "boolean",
                      "description": "Whether or not the notification must be sent."
                    },
                    "deadline": {
                      "type": "string",
                      "description": "Time after which GoCardless will send the notification by email.",
                      "format": "date-time"
                    }
                  }
                }
              },
              "details": {
                "type": "object",
                "description": "",
                "properties": {
                  "origin": {
                    "description": "Who initiated the event. One of:\n\n- `bank`: this event was triggered by a report from the banks\n- `gocardless`: this event was performed by GoCardless automatically\n- `api`: this event was triggered by an API endpoint\n- `customer`: this event was triggered by a Customer\n- `payer`: this event was triggered by a Payer",
                    "example": "bank",
                    "enum": [
                      "bank",
                      "api",
                      "gocardless",
                      "customer",
                      "payer"
                    ],
                    "type": "string"
                  },
                  "cause": {
                    "type": "string",
                    "description": "What triggered the event. _Note:_ `cause` is our simplified and predictable key indicating what triggered the event.",
                    "example": "bank_account_disabled"
                  },
                  "description": {
                    "type": "string",
                    "description": "Human readable description of the cause. _Note:_ Changes to event descriptions are not considered breaking.",
                    "example": "Customer's bank account closed"
                  },
                  "scheme": {
                    "description": "A bank payment scheme. Set when a bank is the origin of the event.",
                    "example": "bacs",
                    "enum": [
                      "ach",
                      "autogiro",
                      "bacs",
                      "becs",
                      "becs_nz",
                      "betalingsservice",
                      "faster_payments",
                      "pad",
                      "pay_to",
                      "sepa_core",
                      "sepa_cor1"
                    ],
                    "nullable": true,
                    "type": "string"
                  },
                  "reason_code": {
                    "type": "string",
                    "description": "Set when a `bank` is the origin of the event. This is the reason code received in the report from the customer's bank. See the [GoCardless Direct Debit guide](https://gocardless.com/direct-debit/receiving-messages) for information on the meanings of different reason codes. _Note:_ `reason_code` is payment scheme-specific and can be inconsistent between banks.",
                    "example": "ADDACS-B"
                  },
                  "will_attempt_retry": {
                    "type": "boolean",
                    "description": "Whether the payment will be retried automatically. Set on a payment failed event.",
                    "example": true
                  },
                  "not_retried_reason": {
                    "type": "string",
                    "description": "When will_attempt_retry is set to false, this field will contain\nthe reason the payment was not retried. This can be one of:\n\n- `failure_filter_applied`: The payment won't be intelligently retried as there is a high likelihood of failure on retry.\n- `other`: The payment won't be intelligently retried due to any other reason.",
                    "example": "failure_filter_applied"
                  },
                  "bank_account_id": {
                    "type": "string",
                    "description": "When we send a creditor `new_payout_currency_added` webhook, we also send the bank account id of the new account",
                    "example": "BA123"
                  },
                  "currency": {
                    "type": "string",
                    "description": "When we send a creditor `new_payout_currency_added` webhook, we also send the currency of the new account",
                    "example": "GBP"
                  },
                  "property": {
                    "type": "string",
                    "description": "When we send a creditor `creditor_updated` webhook, this tells you which property on the creditor has been updated",
                    "example": "fx_payout_currency"
                  },
                  "item_count": {
                    "type": "integer",
                    "description": "Count of rows in the csv. This is sent for export events",
                    "example": 10
                  }
                }
              },
              "metadata": {
                "type": "object",
                "description": "The metadata that was passed when making the API request that triggered the event\n(for instance, cancelling a mandate).\n\nThis field will only be populated if the `details[origin]` field is `api` otherwise it will be an empty object.\n"
              },
              "resource_metadata": {
                "type": "object",
                "description": "The metadata of the resource that the event is for. For example, this field will have the same\nvalue of the `mandate[metadata]` field on the response you would receive from performing a GET request on a mandate.\n"
              },
              "source": {
                "type": "object",
                "description": "Audit information about the source of the event.",
                "properties": {
                  "type": {
                    "description": "The type of the event's source.",
                    "enum": [
                      "app",
                      "user",
                      "gc_team",
                      "access_token"
                    ],
                    "type": "string"
                  },
                  "name": {
                    "type": "string",
                    "description": "The name of the event's source.",
                    "example": "Joe Bloggs"
                  }
                }
              },
              "links": {
                "type": "object",
                "description": "",
                "properties": {
                  "billing_request": {
                    "type": "string",
                    "description": "ID of a [billing request](#billing-requests-billing-requests).",
                    "example": "BRQ123"
                  },
                  "billing_request_flow": {
                    "type": "string",
                    "description": "ID of a [billing request flow](#billing-requests-billing-request-flows).",
                    "example": "BRF123"
                  },
                  "bank_authorisation": {
                    "type": "string",
                    "description": "ID of a [bank authorisation](#billing-requests-bank-authorisations).",
                    "example": "BAU123"
                  },
                  "payment_request_payment": {
                    "type": "string",
                    "description": "If `resource_type` is `billing_requests`, this is the ID of the [payment](#core-endpoints-payments) which has been created for Pay by Bank.",
                    "example": "PM123"
                  },
                  "mandate_request": {
                    "type": "string",
                    "description": "This is the id of the mandate request associated to this event",
                    "example": "MRQ123"
                  },
                  "mandate_request_mandate": {
                    "type": "string",
                    "description": "If `resource_type` is `billing_requests`, this is the ID of the [mandate](#core-endpoints-mandates) which has been created.",
                    "example": "MD123"
                  },
                  "customer": {
                    "type": "string",
                    "description": "ID of a [customer](#core-endpoints-customers).",
                    "example": "CU123"
                  },
                  "customer_bank_account": {
                    "type": "string",
                    "description": "ID of a [customer bank account](#core-endpoints-customer-bank-accounts).",
                    "example": "BA123"
                  },
                  "payment": {
                    "type": "string",
                    "description": "If `resource_type` is `payments`, this is the ID of the [payment](#core-endpoints-payments) which has been updated.",
                    "example": "PM123"
                  },
                  "mandate": {
                    "type": "string",
                    "description": "If `resource_type` is `mandates`, this is the ID of the [mandate](#core-endpoints-mandates) which has been updated.",
                    "example": "MD123"
                  },
                  "payer_authorisation": {
                    "type": "string",
                    "description": "ID of a [payer authorisation](#core-endpoints-payer-authorisations).",
                    "example": "PAU123"
                  },
                  "payout": {
                    "type": "string",
                    "description": "If `resource_type` is `payouts`, this is the ID of the [payout](#core-endpoints-payouts) which has been updated.",
                    "example": "PO123"
                  },
                  "refund": {
                    "type": "string",
                    "description": "If `resource_type` is `refunds`, this is the ID of the [refund](#core-endpoints-refunds) which has been updated.",
                    "example": "RF123"
                  },
                  "subscription": {
                    "type": "string",
                    "description": "If `resource_type` is `subscription`, this is the ID of the [subscription](#core-endpoints-subscriptions) which has been updated.",
                    "example": "SB123"
                  },
                  "instalment_schedule": {
                    "type": "string",
                    "description": "If `resource_type` is `instalment_schedule`, this is the ID of the [instalment schedule](#core-endpoints-instalment-schedules) which has been updated.",
                    "example": "IS123"
                  },
                  "creditor": {
                    "type": "string",
                    "description": "If `resource_type` is `creditor`, this is the ID of the [creditor](#core-endpoints-creditors) which has been updated.",
                    "example": "CR123"
                  },
                  "parent_event": {
                    "type": "string",
                    "description": "If this event was caused by another, this is the ID of the cause. For example, if a mandate is cancelled it automatically cancels all pending payments associated with it; in this case, the payment cancellation events would have the ID of the mandate cancellation event in this field.",
                    "example": "EV123"
                  },
                  "previous_customer_bank_account": {
                    "type": "string",
                    "description": "This is only included for mandate transfer events, when it is the ID of the [customer bank account](#core-endpoints-customer-bank-accounts) which the mandate is being transferred from.",
                    "example": "BA123"
                  },
                  "new_customer_bank_account": {
                    "type": "string",
                    "description": "This is only included for mandate transfer events, when it is the ID of the [customer bank account](#core-endpoints-customer-bank-accounts) which the mandate is being transferred to.",
                    "example": "BA123"
                  },
                  "new_mandate": {
                    "type": "string",
                    "description": "This is only included for mandate replaced events, when it is the ID of the new [mandate](#core-endpoints-mandates) that replaces the existing mandate.",
                    "example": "MD123"
                  },
                  "organisation": {
                    "type": "string",
                    "description": "If the event is included in a [webhook](#webhooks-overview) to an [OAuth app](#appendix-oauth), this is the ID of the account to which it belongs.",
                    "example": "OR123"
                  },
                  "outbound_payment": {
                    "type": "string",
                    "description": "If `resource_type` is `outbound_payments`, this is the ID of the outbound_payment which has been updated.",
                    "example": "OUT123"
                  },
                  "payment_account_transaction": {
                    "type": "string",
                    "description": "If `resource_type` is `payment_account_transaction`, this is the ID of a transaction which has been recorded on the payment account.",
                    "example": "PATR123"
                  },
                  "scheme_identifier": {
                    "type": "string",
                    "description": "If `resource_type` is `scheme_identifiers`, this is the ID of the [scheme_identifier](#core-endpoints-scheme-identifiers) which has been updated.",
                    "example": "SU123"
                  }
                }
              }
            }
          }
        }
      },
      "event_multi_resource_response": {
        "type": "object",
        "title": "EventMultiResourceResponse",
        "description": "",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Events are stored for all webhooks. An event refers to a resource which has been updated, for example a payment which has been collected, or a mandate which has been transferred. Event creation is an asynchronous process, so it can take some time between an action occurring and its corresponding event getting included in API responses. See [here](#event-types) for a complete list of event types.\n<p class=\"notice\"><strong>Important</strong>: Events older than 18 months will be archived and no longer accessible via the API or exports. Archival will begin no sooner than 1 August 2026 in sandbox environments, and no sooner than 1 October 2026 in live environments. Events within the 18-month window are unaffected. If you need archived data, contact GoCardless support.</p>",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier, beginning with \"EV\".",
                  "example": "EV123"
                },
                "created_at": {
                  "type": "string",
                  "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                  "example": "2014-01-01T12:00:00.000Z",
                  "format": "date-time"
                },
                "resource_type": {
                  "description": "The resource type for this event. One of:\n\n- `billing_requests`\n- `creditors`\n- `exports`\n- `instalment_schedules`\n- `mandates`\n- `payer_authorisations`\n- `payments`\n- `payouts`\n- `refunds`\n- `scheme_identifiers`\n- `subscriptions`\n- `outbound_payments`\n- `payment_account_transactions`",
                  "example": "mandates",
                  "enum": [
                    "billing_requests",
                    "creditors",
                    "customers",
                    "exports",
                    "instalment_schedules",
                    "mandates",
                    "organisations",
                    "outbound_payments",
                    "payer_authorisations",
                    "payments",
                    "payment_account_transactions",
                    "payouts",
                    "refunds",
                    "scheme_identifiers",
                    "subscriptions"
                  ],
                  "type": "string"
                },
                "action": {
                  "type": "string",
                  "description": "What has happened to the resource. See [Event Types](#event-types) for the possible actions.",
                  "example": "cancelled"
                },
                "customer_notifications": {
                  "type": "array",
                  "nullable": true,
                  "description": "Present only in webhooks when an integrator is authorised to send their own\nnotifications. See [here](/getting-started/api/handling-customer-notifications/)\nfor further information.\n",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "The id of the notification.",
                        "example": "EV1D18JEXAMPLE"
                      },
                      "type": {
                        "type": "string",
                        "description": "See [here](#core-endpoints-customer-notifications) for a complete list of customer notification types."
                      },
                      "mandatory": {
                        "type": "boolean",
                        "description": "Whether or not the notification must be sent."
                      },
                      "deadline": {
                        "type": "string",
                        "description": "Time after which GoCardless will send the notification by email.",
                        "format": "date-time"
                      }
                    }
                  }
                },
                "details": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "origin": {
                      "description": "Who initiated the event. One of:\n\n- `bank`: this event was triggered by a report from the banks\n- `gocardless`: this event was performed by GoCardless automatically\n- `api`: this event was triggered by an API endpoint\n- `customer`: this event was triggered by a Customer\n- `payer`: this event was triggered by a Payer",
                      "example": "bank",
                      "enum": [
                        "bank",
                        "api",
                        "gocardless",
                        "customer",
                        "payer"
                      ],
                      "type": "string"
                    },
                    "cause": {
                      "type": "string",
                      "description": "What triggered the event. _Note:_ `cause` is our simplified and predictable key indicating what triggered the event.",
                      "example": "bank_account_disabled"
                    },
                    "description": {
                      "type": "string",
                      "description": "Human readable description of the cause. _Note:_ Changes to event descriptions are not considered breaking.",
                      "example": "Customer's bank account closed"
                    },
                    "scheme": {
                      "description": "A bank payment scheme. Set when a bank is the origin of the event.",
                      "example": "bacs",
                      "enum": [
                        "ach",
                        "autogiro",
                        "bacs",
                        "becs",
                        "becs_nz",
                        "betalingsservice",
                        "faster_payments",
                        "pad",
                        "pay_to",
                        "sepa_core",
                        "sepa_cor1"
                      ],
                      "nullable": true,
                      "type": "string"
                    },
                    "reason_code": {
                      "type": "string",
                      "description": "Set when a `bank` is the origin of the event. This is the reason code received in the report from the customer's bank. See the [GoCardless Direct Debit guide](https://gocardless.com/direct-debit/receiving-messages) for information on the meanings of different reason codes. _Note:_ `reason_code` is payment scheme-specific and can be inconsistent between banks.",
                      "example": "ADDACS-B"
                    },
                    "will_attempt_retry": {
                      "type": "boolean",
                      "description": "Whether the payment will be retried automatically. Set on a payment failed event.",
                      "example": true
                    },
                    "not_retried_reason": {
                      "type": "string",
                      "description": "When will_attempt_retry is set to false, this field will contain\nthe reason the payment was not retried. This can be one of:\n\n- `failure_filter_applied`: The payment won't be intelligently retried as there is a high likelihood of failure on retry.\n- `other`: The payment won't be intelligently retried due to any other reason.",
                      "example": "failure_filter_applied"
                    },
                    "bank_account_id": {
                      "type": "string",
                      "description": "When we send a creditor `new_payout_currency_added` webhook, we also send the bank account id of the new account",
                      "example": "BA123"
                    },
                    "currency": {
                      "type": "string",
                      "description": "When we send a creditor `new_payout_currency_added` webhook, we also send the currency of the new account",
                      "example": "GBP"
                    },
                    "property": {
                      "type": "string",
                      "description": "When we send a creditor `creditor_updated` webhook, this tells you which property on the creditor has been updated",
                      "example": "fx_payout_currency"
                    },
                    "item_count": {
                      "type": "integer",
                      "description": "Count of rows in the csv. This is sent for export events",
                      "example": 10
                    }
                  }
                },
                "metadata": {
                  "type": "object",
                  "description": "The metadata that was passed when making the API request that triggered the event\n(for instance, cancelling a mandate).\n\nThis field will only be populated if the `details[origin]` field is `api` otherwise it will be an empty object.\n"
                },
                "resource_metadata": {
                  "type": "object",
                  "description": "The metadata of the resource that the event is for. For example, this field will have the same\nvalue of the `mandate[metadata]` field on the response you would receive from performing a GET request on a mandate.\n"
                },
                "source": {
                  "type": "object",
                  "description": "Audit information about the source of the event.",
                  "properties": {
                    "type": {
                      "description": "The type of the event's source.",
                      "enum": [
                        "app",
                        "user",
                        "gc_team",
                        "access_token"
                      ],
                      "type": "string"
                    },
                    "name": {
                      "type": "string",
                      "description": "The name of the event's source.",
                      "example": "Joe Bloggs"
                    }
                  }
                },
                "links": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "billing_request": {
                      "type": "string",
                      "description": "ID of a [billing request](#billing-requests-billing-requests).",
                      "example": "BRQ123"
                    },
                    "billing_request_flow": {
                      "type": "string",
                      "description": "ID of a [billing request flow](#billing-requests-billing-request-flows).",
                      "example": "BRF123"
                    },
                    "bank_authorisation": {
                      "type": "string",
                      "description": "ID of a [bank authorisation](#billing-requests-bank-authorisations).",
                      "example": "BAU123"
                    },
                    "payment_request_payment": {
                      "type": "string",
                      "description": "If `resource_type` is `billing_requests`, this is the ID of the [payment](#core-endpoints-payments) which has been created for Pay by Bank.",
                      "example": "PM123"
                    },
                    "mandate_request": {
                      "type": "string",
                      "description": "This is the id of the mandate request associated to this event",
                      "example": "MRQ123"
                    },
                    "mandate_request_mandate": {
                      "type": "string",
                      "description": "If `resource_type` is `billing_requests`, this is the ID of the [mandate](#core-endpoints-mandates) which has been created.",
                      "example": "MD123"
                    },
                    "customer": {
                      "type": "string",
                      "description": "ID of a [customer](#core-endpoints-customers).",
                      "example": "CU123"
                    },
                    "customer_bank_account": {
                      "type": "string",
                      "description": "ID of a [customer bank account](#core-endpoints-customer-bank-accounts).",
                      "example": "BA123"
                    },
                    "payment": {
                      "type": "string",
                      "description": "If `resource_type` is `payments`, this is the ID of the [payment](#core-endpoints-payments) which has been updated.",
                      "example": "PM123"
                    },
                    "mandate": {
                      "type": "string",
                      "description": "If `resource_type` is `mandates`, this is the ID of the [mandate](#core-endpoints-mandates) which has been updated.",
                      "example": "MD123"
                    },
                    "payer_authorisation": {
                      "type": "string",
                      "description": "ID of a [payer authorisation](#core-endpoints-payer-authorisations).",
                      "example": "PAU123"
                    },
                    "payout": {
                      "type": "string",
                      "description": "If `resource_type` is `payouts`, this is the ID of the [payout](#core-endpoints-payouts) which has been updated.",
                      "example": "PO123"
                    },
                    "refund": {
                      "type": "string",
                      "description": "If `resource_type` is `refunds`, this is the ID of the [refund](#core-endpoints-refunds) which has been updated.",
                      "example": "RF123"
                    },
                    "subscription": {
                      "type": "string",
                      "description": "If `resource_type` is `subscription`, this is the ID of the [subscription](#core-endpoints-subscriptions) which has been updated.",
                      "example": "SB123"
                    },
                    "instalment_schedule": {
                      "type": "string",
                      "description": "If `resource_type` is `instalment_schedule`, this is the ID of the [instalment schedule](#core-endpoints-instalment-schedules) which has been updated.",
                      "example": "IS123"
                    },
                    "creditor": {
                      "type": "string",
                      "description": "If `resource_type` is `creditor`, this is the ID of the [creditor](#core-endpoints-creditors) which has been updated.",
                      "example": "CR123"
                    },
                    "parent_event": {
                      "type": "string",
                      "description": "If this event was caused by another, this is the ID of the cause. For example, if a mandate is cancelled it automatically cancels all pending payments associated with it; in this case, the payment cancellation events would have the ID of the mandate cancellation event in this field.",
                      "example": "EV123"
                    },
                    "previous_customer_bank_account": {
                      "type": "string",
                      "description": "This is only included for mandate transfer events, when it is the ID of the [customer bank account](#core-endpoints-customer-bank-accounts) which the mandate is being transferred from.",
                      "example": "BA123"
                    },
                    "new_customer_bank_account": {
                      "type": "string",
                      "description": "This is only included for mandate transfer events, when it is the ID of the [customer bank account](#core-endpoints-customer-bank-accounts) which the mandate is being transferred to.",
                      "example": "BA123"
                    },
                    "new_mandate": {
                      "type": "string",
                      "description": "This is only included for mandate replaced events, when it is the ID of the new [mandate](#core-endpoints-mandates) that replaces the existing mandate.",
                      "example": "MD123"
                    },
                    "organisation": {
                      "type": "string",
                      "description": "If the event is included in a [webhook](#webhooks-overview) to an [OAuth app](#appendix-oauth), this is the ID of the account to which it belongs.",
                      "example": "OR123"
                    },
                    "outbound_payment": {
                      "type": "string",
                      "description": "If `resource_type` is `outbound_payments`, this is the ID of the outbound_payment which has been updated.",
                      "example": "OUT123"
                    },
                    "payment_account_transaction": {
                      "type": "string",
                      "description": "If `resource_type` is `payment_account_transaction`, this is the ID of a transaction which has been recorded on the payment account.",
                      "example": "PATR123"
                    },
                    "scheme_identifier": {
                      "type": "string",
                      "description": "If `resource_type` is `scheme_identifiers`, this is the ID of the [scheme_identifier](#core-endpoints-scheme-identifiers) which has been updated.",
                      "example": "SU123"
                    }
                  }
                }
              }
            }
          },
          "meta": {
            "type": "object",
            "description": "Cursor pagination information",
            "properties": {
              "limit": {
                "type": "integer",
                "example": 50
              },
              "cursors": {
                "type": "object",
                "properties": {
                  "before": {
                    "type": "string",
                    "nullable": true,
                    "description": "Cursor pointing to the end of the desired set."
                  },
                  "after": {
                    "type": "string",
                    "nullable": true,
                    "description": "Cursor pointing to the start of the desired set."
                  }
                }
              }
            }
          },
          "linked": {
            "type": "object",
            "description": "",
            "properties": {
              "billing_requests": {
                "type": "array",
                "description": "A list of billing requests linked to the events returned in the list of events.",
                "items": {
                  "type": "object",
                  "description": " Billing Requests help create resources that require input or action from a customer. An example of required input might be additional customer billing details, while an action would be asking a customer to authorise a payment using their mobile banking app.\n\nSee [Billing Requests: Overview](https://developer.gocardless.com/getting-started/billing-requests/overview/) for how-to's, explanations and tutorials. <p class=\"notice\"><strong>Important</strong>: All properties associated with `subscription_request` and `instalment_schedule_request` are only supported for ACH and PAD schemes.</p>",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier, beginning with \"BRQ\".",
                      "example": "BRQ123"
                    },
                    "purpose_code": {
                      "description": "Specifies the high-level purpose/category of a mandate and/or payment using a set of pre-defined categories. Provides context on the nature and reason for the payment to facilitate processing and compliance.\nSee [Billing Request Purpose Codes](https://developer.gocardless.com/billing-request-purpose-codes/) for the complete list of valid codes.",
                      "enum": [
                        "mortgage",
                        "utility",
                        "loan",
                        "dependant_support",
                        "gambling",
                        "retail",
                        "salary",
                        "personal",
                        "government",
                        "pension",
                        "tax",
                        "other",
                        "bonus_payment",
                        "cash_management_transfer",
                        "card_bulk_clearing",
                        "credit_card_payment",
                        "trade_settlement_payment",
                        "debit_card_payment",
                        "dividend",
                        "deliver_against_payment",
                        "epayment",
                        "fee_collection_and_interest",
                        "fee_collection",
                        "person_to_person_payment",
                        "government_payment",
                        "hedging_transaction",
                        "irrevocable_credit_card_payment",
                        "irrevocable_debit_card_payment",
                        "intra_company_payment",
                        "interest",
                        "lockbox_transactions",
                        "commercial",
                        "consumer",
                        "other_payment",
                        "pension_payment",
                        "represented",
                        "reimbursement_received_credit_transfer",
                        "receive_against_payment",
                        "salary_payment",
                        "securities",
                        "social_security_benefit",
                        "supplier_payment",
                        "tax_payment",
                        "trade",
                        "treasury_payment",
                        "value_added_tax_payment",
                        "with_holding",
                        "cash_management_sweep_account",
                        "cash_management_top_account",
                        "cash_management_zero_balance_account",
                        "crossborder_mi_payments",
                        "foreign_currency_domestic_transfer",
                        "cash_in_pre_credit",
                        "cash_out_notes_coins",
                        "carrier_guarded_wholesale_valuables"
                      ],
                      "type": "string"
                    },
                    "payment_purpose_code": {
                      "type": "string",
                      "description": "Specifies the underlying purpose of the payment. Defines the specific reason or type of service/goods the payment relates to, improving straight-through processing and compliance.\nSee [VRP Commercial Payment Purpose Codes](https://developer.gocardless.com/vrp-commercial-payment-purpose-codes/) for the complete list of valid codes."
                    },
                    "payment_context_code": {
                      "description": "Specifies the context or scenario in which the payment is being made. Defines whether the payment is for advance/arrears billing, point of sale transactions, ecommerce, or account transfers. This helps banks and payment processors understand the payment scenario and apply appropriate processing rules and risk controls.",
                      "enum": [
                        "billing_goods_and_services_in_advance",
                        "billing_goods_and_services_in_arrears",
                        "face_to_face_point_of_sale",
                        "ecommerce_merchant_initiated_payment",
                        "transfer_to_self",
                        "transfer_to_third_party"
                      ],
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                      "example": "2015-01-01T12:00:00.000Z",
                      "format": "date-time"
                    },
                    "status": {
                      "type": "string",
                      "description": "One of:\n\n- `pending`: the billing request is pending and can be used\n- `ready_to_fulfil`: the billing request is ready to fulfil\n- `fulfilling`: the billing request is currently undergoing fulfilment\n- `fulfilled`: the billing request has been fulfilled and a payment created\n- `cancelled`: the billing request has been cancelled and cannot be used",
                      "example": "pending",
                      "enum": [
                        "pending",
                        "ready_to_fulfil",
                        "fulfilling",
                        "fulfilled",
                        "cancelled"
                      ]
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                    },
                    "mandate_request": {
                      "type": "object",
                      "nullable": true,
                      "description": "Request for a mandate",
                      "properties": {
                        "description": {
                          "type": "string",
                          "nullable": true,
                          "description": "A human-readable description of the payment and/or mandate. This will be displayed to the payer when authorising the billing request.\n",
                          "example": "Top-up Payment"
                        },
                        "currency": {
                          "type": "string",
                          "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code.",
                          "example": "GBP"
                        },
                        "scheme": {
                          "type": "string",
                          "nullable": true,
                          "description": "A bank payment scheme. Currently \"ach\", \"autogiro\", \"bacs\", \"becs\", \"becs_nz\", \"betalingsservice\", \"faster_payments\", \"pad\", \"pay_to\" and \"sepa_core\" are supported. Optional for mandate only requests - if left blank, the payer will be able to select the currency/scheme to pay with from a list of your available schemes.",
                          "example": "bacs"
                        },
                        "sweeping": {
                          "type": "boolean",
                          "description": "If true, this billing request would be used to set up a mandate solely for moving (or sweeping) money from one account owned by the payer to another account that the payer also owns. This is required for Faster Payments"
                        },
                        "verify": {
                          "description": "Verification preference for the mandate. One of:\n\n- `minimum`: only verify if absolutely required, such as when part of scheme rules\n- `recommended`: in addition to `minimum`, use the GoCardless payment intelligence solution to decide if a payer should be verified\n- `when_available`: if verification mechanisms are available, use them\n- `always`: as `when_available`, but fail to create the Billing Request if a mechanism isn't available\n\nBy default, all Billing Requests use the `recommended` verification preference. It uses GoCardless payment intelligence solution to determine if a payer is fraudulent or not. The verification mechanism is based on the response and the payer may be asked to verify themselves. If the feature is not available, `recommended` behaves like `minimum`.\n\nIf you never wish to take advantage of our reduced risk products and Verified Mandates as they are released in new schemes, please use the `minimum` verification preference.\n\nSee [Billing Requests: Creating Verified Mandates](https://developer.gocardless.com/getting-started/billing-requests/verified-mandates/)\nfor more information.",
                          "enum": [
                            "minimum",
                            "recommended",
                            "when_available",
                            "always"
                          ],
                          "type": "string"
                        },
                        "links": {
                          "type": "object",
                          "description": "",
                          "properties": {
                            "mandate": {
                              "type": "string",
                              "description": "(Optional) ID of the [mandate](#core-endpoints-mandates) that was created from this mandate request. this mandate request.\n"
                            }
                          }
                        },
                        "metadata": {
                          "type": "object",
                          "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                        },
                        "consent_type": {
                          "type": "string",
                          "nullable": true,
                          "description": "This attribute represents the authorisation type between the payer and merchant. It can be set to `one_off`,\n`recurring` or `standing` for ACH scheme. And `single`, `recurring` and `sporadic` for PAD scheme. _Note:_ This is only supported for ACH and PAD schemes.\n"
                        },
                        "constraints": {
                          "type": "object",
                          "nullable": true,
                          "description": "Constraints that will apply to the mandate_request. (Optional) Specifically required for PayTo and VRP.",
                          "properties": {
                            "start_date": {
                              "type": "string",
                              "description": "The date from which payments can be taken.\n\nThis is an optional field and if it is not supplied the start date will be set to the day\nauthorisation happens.\n"
                            },
                            "end_date": {
                              "type": "string",
                              "description": "The latest date at which payments can be taken, must occur after start_date if present\n\nThis is an optional field and if it is not supplied the agreement will be considered open and\nwill not have an end date. Keep in mind the end date must take into account how long it will\ntake the user to set up this agreement via the Billing Request.\n"
                            },
                            "max_amount_per_payment": {
                              "type": "integer",
                              "description": "The maximum amount that can be charged for a single payment in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR). _Note:_ Required for PayTo and VRP."
                            },
                            "payment_method": {
                              "type": "string",
                              "description": "A constraint where you can specify info (free text string) about how payments are calculated. For use when payments vary and cannot be expressed as a fixed amount and frequency. _Note:_ This is only supported for ACH and PAD schemes.\n"
                            },
                            "periodic_limits": {
                              "type": "array",
                              "description": "Caps on the total amount and/or number of payments that can be collected within a\nrepeating period (e.g. no more than a set amount per month), as opposed to\n`max_amount_per_payment` which caps a single payment.\n\n_Note:_ Required for VRP, where exactly one periodic limit must be provided. Optional for\nPayTo.\n",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "period": {
                                    "description": "The repeating period for this mandate. Required whenever a periodic limit is provided\n(for both VRP and PayTo). If periodic_limits is omitted entirely for PayTo, this\ndefaults to flexible.\n",
                                    "enum": [
                                      "day",
                                      "week",
                                      "month",
                                      "year",
                                      "flexible"
                                    ],
                                    "type": "string"
                                  },
                                  "max_total_amount": {
                                    "type": "integer",
                                    "description": "The maximum total amount that can be charged for all payments in this periodic limit,\nin the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\n_Note:_ Required for VRP. This is not permitted for the PayTo scheme.\n"
                                  },
                                  "max_payments": {
                                    "type": "integer",
                                    "description": "The maximum number of payments that can be collected in this periodic limit.\n\n_Note:_ Only supported for the PayTo scheme, where it is optional.\n"
                                  },
                                  "alignment": {
                                    "description": "The alignment of the period. Defaults to `creation_date` if not specified.\n\n`calendar` - the period follows fixed calendar boundaries, the same for every mandate:\n`week` runs Monday to Sunday, `month` runs from the 1st to the last day of the calendar\nmonth, and `year` runs from 1 January to 31 December. If the mandate starts partway\nthrough a period, the limit for that first period is reduced proportionally to the days\nremaining (e.g. a monthly limit starting on the 15th gives roughly half the limit for\nthat first month).\n\n`creation_date` - the period follows the mandate's own start date rather than the\ncalendar. For example, if the mandate starts on the 15th, each monthly period runs from\nthe 15th to the 14th of the following month. The first period is a full period, not\nreduced proportionally.\n\n_Note:_ Has no effect when period is `flexible`.\n",
                                    "enum": [
                                      "calendar",
                                      "creation_date"
                                    ],
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        },
                        "payer_requested_dual_signature": {
                          "type": "boolean",
                          "description": "This attribute can be set to true if the payer has indicated that multiple signatures are required for the mandate. As long as every other Billing Request actions have been completed, the payer will receive an email notification containing instructions on how to complete the additional signature. The dual signature flow can only be completed using GoCardless branded pages."
                        },
                        "authorisation_source": {
                          "description": "This field is ACH specific, sometimes referred to as [SEC code](https://www.moderntreasury.com/learn/sec-codes).\n\nThis is the way that the payer gives authorisation to the merchant.\n  web: Authorisation is Internet Initiated or via Mobile Entry (maps to SEC code: WEB)\n  telephone: Authorisation is provided orally over telephone (maps to SEC code: TEL)\n  paper: Authorisation is provided in writing and signed, or similarly authenticated (maps to SEC code: PPD)\n",
                          "enum": [
                            "web",
                            "telephone",
                            "paper"
                          ],
                          "type": "string"
                        },
                        "funds_settlement": {
                          "description": "This field will decide how GoCardless handles settlement of funds from the customer.\n\n- `managed` will be moved through GoCardless' account, batched, and payed out.\n- `direct` will be a direct transfer from the payer's account to the merchant where\n  invoicing will be handled separately.\n",
                          "enum": [
                            "managed",
                            "direct"
                          ],
                          "type": "string"
                        }
                      }
                    },
                    "payment_request": {
                      "type": "object",
                      "nullable": true,
                      "description": "Request for a one-off strongly authorised payment",
                      "properties": {
                        "description": {
                          "type": "string",
                          "nullable": true,
                          "description": "A human-readable description of the payment and/or mandate. This will be displayed to the payer when authorising the billing request.\n",
                          "example": "Top-up Payment"
                        },
                        "currency": {
                          "type": "string",
                          "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. `GBP` and `EUR` supported; `GBP` with your customers in the UK and for `EUR` with your customers in supported Eurozone countries only.",
                          "example": "GBP"
                        },
                        "scheme": {
                          "type": "string",
                          "nullable": true,
                          "description": "(Optional) A scheme used for Open Banking payments. Currently `faster_payments` is supported in the UK (GBP) and `sepa_credit_transfer` and `sepa_instant_credit_transfer` are supported in supported Eurozone countries (EUR). For Eurozone countries, `sepa_credit_transfer` is used as the default. Please be aware that `sepa_instant_credit_transfer` may incur an additional fee for your customer.",
                          "example": "faster_payments"
                        },
                        "amount": {
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "integer"
                            }
                          ],
                          "description": "Amount in minor unit (e.g. pence in GBP, cents in EUR).",
                          "example": 1000
                        },
                        "links": {
                          "type": "object",
                          "description": "",
                          "properties": {
                            "payment": {
                              "type": "string",
                              "description": "(Optional) ID of the [payment](#core-endpoints-payments) that was created from this payment request."
                            }
                          }
                        },
                        "app_fee": {
                          "oneOf": [
                            {
                              "type": "string",
                              "nullable": true
                            },
                            {
                              "type": "integer"
                            }
                          ],
                          "description": "The amount to be deducted from the payment as an app fee, to be paid to the partner integration which created the billing request, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                          "example": 100
                        },
                        "metadata": {
                          "type": "object",
                          "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                        },
                        "reference": {
                          "type": "string",
                          "nullable": true,
                          "description": "A custom payment reference defined by the merchant. It is only available for payments on the PayTo scheme or payments using the Direct Funds settlement model on the Faster Payments scheme.\n",
                          "example": "some-custom-ref"
                        },
                        "funds_settlement": {
                          "description": "This field will decide how GoCardless handles settlement of funds from the customer.\n\n- `managed` will be moved through GoCardless' account, batched, and payed out.\n- `direct` will be a direct transfer from the payer's account to the merchant where\n  invoicing will be handled separately.\n",
                          "enum": [
                            "managed",
                            "direct"
                          ],
                          "type": "string"
                        }
                      }
                    },
                    "subscription_request": {
                      "type": "object",
                      "nullable": true,
                      "description": "Request for a subscription",
                      "properties": {
                        "amount": {
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "integer"
                            }
                          ],
                          "description": "Amount in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                          "example": 1000
                        },
                        "currency": {
                          "type": "string",
                          "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"USD\" and \"CAD\" are supported.",
                          "example": "USD"
                        },
                        "interval_unit": {
                          "description": "The unit of time between customer charge dates. One of `weekly`, `monthly` or `yearly`.",
                          "example": "monthly",
                          "enum": [
                            "weekly",
                            "monthly",
                            "yearly"
                          ],
                          "type": "string"
                        },
                        "interval": {
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "integer"
                            }
                          ],
                          "description": "Number of `interval_units` between customer charge dates. Must be greater than or equal to `1`. Must result in at least one charge date per year. Defaults to `1`.",
                          "example": 1
                        },
                        "app_fee": {
                          "oneOf": [
                            {
                              "type": "string",
                              "nullable": true
                            },
                            {
                              "type": "integer"
                            }
                          ],
                          "description": "The amount to be deducted from each payment as an app fee, to be paid to the partner integration which created the subscription, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                          "example": 100
                        },
                        "count": {
                          "oneOf": [
                            {
                              "type": "string",
                              "nullable": true
                            },
                            {
                              "type": "integer"
                            }
                          ],
                          "description": "The total number of payments that should be taken by this subscription.",
                          "example": 5
                        },
                        "day_of_month": {
                          "oneOf": [
                            {
                              "type": "string",
                              "nullable": true
                            },
                            {
                              "type": "integer"
                            }
                          ],
                          "description": "As per RFC 2445. The day of the month to charge customers on. `1`-`28` or `-1` to indicate the last day of the month.",
                          "example": 28
                        },
                        "metadata": {
                          "type": "object",
                          "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                        },
                        "links": {
                          "type": "object",
                          "description": "",
                          "properties": {
                            "subscription": {
                              "type": "string",
                              "description": "(Optional) ID of the [subscription](#core-endpoints-subscriptions) that was created from this subscription request.\n"
                            }
                          }
                        },
                        "month": {
                          "description": "Name of the month on which to charge a customer. Must be lowercase. Only applies\nwhen the interval_unit is `yearly`.\n",
                          "example": "january",
                          "enum": [
                            "january",
                            "february",
                            "march",
                            "april",
                            "may",
                            "june",
                            "july",
                            "august",
                            "september",
                            "october",
                            "november",
                            "december"
                          ],
                          "nullable": true,
                          "type": "string"
                        },
                        "name": {
                          "type": "string",
                          "nullable": true,
                          "description": "Optional name for the subscription. This will be set as the description on each payment created. Must not exceed 255 characters.",
                          "example": "12 month subscription"
                        },
                        "payment_reference": {
                          "type": "string",
                          "nullable": true,
                          "description": "An optional payment reference. This will be set as the reference on each payment\ncreated and will appear on your customer's bank statement. See the documentation for\nthe [create payment endpoint](#payments-create-a-payment) for more details.\n<br />",
                          "example": "GOLDPLAN"
                        },
                        "start_date": {
                          "type": "string",
                          "nullable": true,
                          "description": "The date on which the first payment should be charged. If fulfilled after this date, this will be set as the mandate's `next_possible_charge_date`.\nWhen left blank and `month` or `day_of_month` are provided, this will be set to the date of the first payment.\nIf created without `month` or `day_of_month` this will be set as the mandate's `next_possible_charge_date`.\n",
                          "example": "2014-10-21",
                          "format": "date"
                        },
                        "retry_if_possible": {
                          "type": "boolean",
                          "description": "On failure, automatically retry payments using [intelligent retries](/success-plus/overview). Default is `false`. <p class=\"notice\"><strong>Important</strong>: To be able to use intelligent retries, Success+ needs to be enabled in [GoCardless dashboard](https://manage.gocardless.com/success-plus). </p>"
                        }
                      }
                    },
                    "instalment_schedule_request": {
                      "type": "object",
                      "nullable": true,
                      "description": "Request for an instalment schedule. Has to contain either `instalments_with_schedule` object or an array of `instalments_with_dates` objects",
                      "properties": {
                        "name": {
                          "type": "string",
                          "description": "Name of the instalment schedule, up to 100 chars. This name will also be\ncopied to the payments of the instalment schedule if you use schedule-based creation.",
                          "example": "Invoice 4404"
                        },
                        "currency": {
                          "type": "string",
                          "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"USD\" and \"CAD\" are supported.",
                          "example": "USD"
                        },
                        "total_amount": {
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "integer"
                            }
                          ],
                          "description": "The total amount of the instalment schedule, defined as the sum of all individual\npayments, in the lowest denomination for the currency (e.g. pence in GBP, cents in\nEUR). If the requested payment amounts do not sum up correctly, a validation error\nwill be returned.",
                          "example": 1000
                        },
                        "payment_reference": {
                          "type": "string",
                          "nullable": true,
                          "description": "An optional payment reference. This will be set as the reference on each payment\ncreated and will appear on your customer's bank statement. See the documentation for\nthe [create payment endpoint](#payments-create-a-payment) for more details.\n<br />",
                          "example": "GOLDPLAN"
                        },
                        "app_fee": {
                          "oneOf": [
                            {
                              "type": "string",
                              "nullable": true
                            },
                            {
                              "type": "integer"
                            }
                          ],
                          "description": "The amount to be deducted from each payment as an app fee, to be paid to the partner integration which created the subscription, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                          "example": 100
                        },
                        "instalments_with_dates": {
                          "type": "array",
                          "nullable": true,
                          "description": "An explicit array of instalment payments, each specifying at least an `amount` and `charge_date`. See [create (with dates)](#instalment-schedules-create-with-dates)",
                          "example": [
                            {
                              "amount": 250,
                              "charge_date": "2020-11-03"
                            }
                          ],
                          "items": {
                            "type": "object",
                            "properties": {
                              "amount": {
                                "oneOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "integer"
                                  }
                                ],
                                "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\nMinimum and maximum amounts vary by payment scheme. For more information, see [Transaction limits](https://support.gocardless.com/hc/en-gb/articles/115000309245-Transaction-limits)\n\nFor Variable Recurring Payments (VRP), this must not exceed the mandate's `max_amount_per_payment`\nconstraint.",
                                "example": 1000
                              },
                              "charge_date": {
                                "type": "string",
                                "nullable": true,
                                "description": "A future date on which the payment should be collected. If the date\nis before the next_possible_charge_date on the\n[mandate](#core-endpoints-mandates), it will be automatically rolled\nforwards to that date.",
                                "example": "2014-05-21",
                                "format": "date"
                              },
                              "description": {
                                "type": "string",
                                "nullable": true,
                                "description": "A human-readable description of the payment. This will be included in the notification email GoCardless sends to your customer if your organisation does not send its own notifications (see [compliance requirements](#appendix-compliance-requirements)).",
                                "example": "One-off upgrade fee"
                              }
                            }
                          }
                        },
                        "instalments_with_schedule": {
                          "type": "object",
                          "nullable": true,
                          "description": "Frequency of the payments you want to create, together with an array of payment\namounts to be collected, with a specified start date for the first payment.\nSee [create (with schedule)](#instalment-schedules-create-with-schedule)\n",
                          "properties": {
                            "start_date": {
                              "type": "string",
                              "nullable": true,
                              "description": "The date on which the first payment should be charged. Must be on or after the [mandate](#core-endpoints-mandates)'s `next_possible_charge_date`. When left blank and `month` or `day_of_month` are provided, this will be set to the date of the first payment. If created without `month` or `day_of_month` this will be set as the mandate's `next_possible_charge_date`",
                              "example": "2014-10-21",
                              "format": "date"
                            },
                            "interval": {
                              "type": "integer",
                              "description": "Number of `interval_units` between charge dates. Must be greater than or\nequal to `1`.\n",
                              "example": 1
                            },
                            "interval_unit": {
                              "description": "The unit of time between customer charge dates. One of `weekly`, `monthly` or `yearly`.",
                              "example": "monthly",
                              "enum": [
                                "weekly",
                                "monthly",
                                "yearly"
                              ],
                              "type": "string"
                            },
                            "amounts": {
                              "type": "array",
                              "description": "List of amounts of each instalment, in the lowest denomination for the\ncurrency (e.g. cents in USD).\n",
                              "items": {
                                "oneOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "integer"
                                  }
                                ],
                                "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\nMinimum and maximum amounts vary by payment scheme. For more information, see [Transaction limits](https://support.gocardless.com/hc/en-gb/articles/115000309245-Transaction-limits)\n\nFor Variable Recurring Payments (VRP), this must not exceed the mandate's `max_amount_per_payment`\nconstraint.",
                                "example": 1000
                              }
                            }
                          }
                        },
                        "metadata": {
                          "type": "object",
                          "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                        },
                        "links": {
                          "type": "object",
                          "description": "",
                          "properties": {
                            "instalment_schedule": {
                              "type": "string",
                              "description": "(Optional) ID of the [instalment_schedule](#core-endpoints-instalment-schedules) that was created from this instalment schedule request.\n"
                            }
                          }
                        },
                        "retry_if_possible": {
                          "type": "boolean",
                          "description": "On failure, automatically retry payments using [intelligent retries](/success-plus/overview). Default is `false`. <p class=\"notice\"><strong>Important</strong>: To be able to use intelligent retries, Success+ needs to be enabled in [GoCardless dashboard](https://manage.gocardless.com/success-plus). </p>"
                        }
                      }
                    },
                    "actions": {
                      "type": "array",
                      "description": "List of actions that can be performed before this billing request can be fulfilled.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "description": "Unique identifier for the action.",
                            "example": "collect_bank_account",
                            "enum": [
                              "choose_currency",
                              "collect_amount",
                              "collect_customer_details",
                              "collect_bank_account",
                              "bank_authorisation",
                              "confirm_payer_details",
                              "select_institution"
                            ]
                          },
                          "status": {
                            "type": "string",
                            "description": "Status of the action",
                            "example": "pending",
                            "enum": [
                              "pending",
                              "completed"
                            ]
                          },
                          "required": {
                            "type": "boolean",
                            "description": "Informs you whether the action is required to fulfil the billing request or not.",
                            "example": true
                          },
                          "completes_actions": {
                            "type": "array",
                            "description": "Which other action types this action can complete.",
                            "example": [
                              "collect_bank_account"
                            ],
                            "items": {
                              "type": "string"
                            }
                          },
                          "requires_actions": {
                            "type": "array",
                            "description": "Requires completing these actions before this action can be completed.",
                            "example": [
                              "collect_bank_account"
                            ],
                            "items": {
                              "type": "string"
                            }
                          },
                          "bank_authorisation": {
                            "type": "object",
                            "description": "Describes the behaviour of bank authorisations, for the bank_authorisation action",
                            "properties": {
                              "adapter": {
                                "type": "string",
                                "description": "Which authorisation adapter will be used to power these authorisations (GoCardless internal use only)",
                                "enum": [
                                  "open_banking_gateway_pis",
                                  "open_banking_gateway_ais",
                                  "bankid_ais",
                                  "bank_pay_recurring"
                                ]
                              },
                              "authorisation_type": {
                                "type": "string",
                                "description": "What type of bank authorisations are supported on this billing request",
                                "enum": [
                                  "payment",
                                  "mandate"
                                ]
                              }
                            }
                          },
                          "collect_customer_details": {
                            "type": "object",
                            "description": "Additional parameters to help complete the collect_customer_details action",
                            "properties": {
                              "default_country_code": {
                                "type": "string",
                                "description": "Default customer country code, as determined by scheme and payer location"
                              },
                              "incomplete_fields": {
                                "type": "object",
                                "properties": {
                                  "customer": {
                                    "type": "array",
                                    "items": {
                                      "type": "string",
                                      "description": "A customer field that needs to be collected"
                                    }
                                  },
                                  "customer_billing_detail": {
                                    "type": "array",
                                    "items": {
                                      "type": "string",
                                      "description": "A customer_billing_detail field that needs to be collected"
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "available_currencies": {
                            "type": "array",
                            "description": "List of currencies the current mandate supports",
                            "items": {
                              "type": "string",
                              "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code.",
                              "example": "GBP"
                            }
                          },
                          "institution_guess_status": {
                            "type": "string",
                            "description": "Describes whether we inferred the institution from the provided bank account details. One of:\n- `not_needed`: we won't attempt to infer the institution as it is not needed. Either because it was manually selected or the billing request does not support this feature\n- `pending`: we are waiting on the bank details in order to infer the institution\n- `failed`: we weren't able to infer the institution\n- `success`: we inferred the institution and added it to the resources of a Billing Request\n",
                            "example": "pending",
                            "enum": [
                              "not_needed",
                              "pending",
                              "failed",
                              "success"
                            ]
                          }
                        }
                      }
                    },
                    "resources": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "customer": {
                          "type": "object",
                          "description": "Embedded customer",
                          "properties": {
                            "id": {
                              "type": "string",
                              "description": "Unique identifier, beginning with \"CU\".",
                              "example": "CU123"
                            },
                            "created_at": {
                              "type": "string",
                              "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                              "example": "2014-01-01T12:00:00.000Z",
                              "format": "date-time"
                            },
                            "email": {
                              "type": "string",
                              "nullable": true,
                              "description": "Customer's email address. Required in most cases, as this allows GoCardless to send notifications to this customer.",
                              "example": "user@example.com"
                            },
                            "given_name": {
                              "type": "string",
                              "nullable": true,
                              "description": "Customer's first name. Required unless a `company_name` is provided.",
                              "example": "Frank"
                            },
                            "family_name": {
                              "type": "string",
                              "nullable": true,
                              "description": "Customer's surname. Required unless a `company_name` is provided.",
                              "example": "Osborne"
                            },
                            "company_name": {
                              "type": "string",
                              "nullable": true,
                              "description": "Customer's company name. Required unless a `given_name` and `family_name` are provided. For Canadian customers, the use of a `company_name` value will mean that any mandate created from this customer will be considered to be a \"Business PAD\" (otherwise, any mandate will be considered to be a \"Personal PAD\").",
                              "example": "Hamilton Trading Ltd."
                            },
                            "language": {
                              "type": "string",
                              "nullable": true,
                              "description": "[ISO 639-1](https://en.wikipedia.org/wiki/List_of_ISO_639-1_codes) code. Used as the language for notification emails sent by GoCardless if your organisation does not send its own (see [compliance requirements](#appendix-compliance-requirements)). Currently only \"en\", \"fr\", \"de\", \"pt\", \"es\", \"it\", \"nl\", \"da\", \"nb\", \"sl\", \"sv\" are supported. If this is not provided, the language will be chosen based on the `country_code` (if supplied) or default to \"en\".",
                              "example": "en"
                            },
                            "phone_number": {
                              "type": "string",
                              "nullable": true,
                              "description": "[ITU E.123](https://en.wikipedia.org/wiki/E.123) formatted phone number, including country code.",
                              "example": "+64 4 817 9999"
                            },
                            "metadata": {
                              "type": "object",
                              "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                            }
                          }
                        },
                        "customer_billing_detail": {
                          "type": "object",
                          "description": "Embedded customer billing detail",
                          "properties": {
                            "id": {
                              "type": "string",
                              "description": "Unique identifier, beginning with \"CU\".",
                              "example": "CU123"
                            },
                            "schemes": {
                              "type": "array",
                              "description": "The schemes associated with this customer billing detail",
                              "items": {
                                "type": "string"
                              }
                            },
                            "created_at": {
                              "type": "string",
                              "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                              "example": "2014-01-01T12:00:00.000Z",
                              "format": "date-time"
                            },
                            "address_line1": {
                              "type": "string",
                              "nullable": true,
                              "description": "The first line of the customer's address.",
                              "example": "221B Baker Street"
                            },
                            "address_line2": {
                              "type": "string",
                              "nullable": true,
                              "description": "The second line of the customer's address.",
                              "example": "Marylebone"
                            },
                            "address_line3": {
                              "type": "string",
                              "nullable": true,
                              "description": "The third line of the customer's address.",
                              "example": "City of Westminster"
                            },
                            "city": {
                              "type": "string",
                              "nullable": true,
                              "description": "The city of the customer's address.",
                              "example": "London"
                            },
                            "region": {
                              "type": "string",
                              "nullable": true,
                              "description": "The customer's address region, county or department. For US customers a 2 letter [ISO3166-2:US](https://en.wikipedia.org/wiki/ISO_3166-2:US) state code is required (e.g. `CA` for California).",
                              "example": "Greater London"
                            },
                            "postal_code": {
                              "type": "string",
                              "nullable": true,
                              "description": "The customer's postal code.",
                              "example": "NW1 6XE"
                            },
                            "country_code": {
                              "type": "string",
                              "nullable": true,
                              "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                              "example": "GB"
                            },
                            "swedish_identity_number": {
                              "type": "string",
                              "nullable": true,
                              "description": "For Swedish customers only. The civic/company number (personnummer, samordningsnummer, or organisationsnummer) of the customer. Must be supplied if the customer's bank account is denominated in Swedish krona (SEK). This field cannot be changed once it has been set.",
                              "example": "556564-5404"
                            },
                            "danish_identity_number": {
                              "type": "string",
                              "nullable": true,
                              "description": "For Danish customers only. The civic/company number (CPR or CVR) of the customer. Must be supplied if the customer's bank account is denominated in Danish krone (DKK).",
                              "example": "220550-6218"
                            },
                            "ip_address": {
                              "type": "string",
                              "nullable": true,
                              "description": "For ACH customers only. Required for ACH customers. A string containing the IP address of the payer to whom the mandate belongs (i.e. as a result of their completion of a mandate setup flow in their browser).\n\nNot required for creating offline mandates where `authorisation_source` is set to telephone or paper.\n",
                              "example": "127.0.0.1"
                            }
                          }
                        },
                        "customer_bank_account": {
                          "type": "object",
                          "nullable": true,
                          "description": "Embedded customer bank account, only if a bank account is linked",
                          "properties": {
                            "id": {
                              "type": "string",
                              "description": "Unique identifier, beginning with \"BA\".",
                              "example": "BA123"
                            },
                            "created_at": {
                              "type": "string",
                              "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                              "example": "2014-01-01T12:00:00.000Z",
                              "format": "date-time"
                            },
                            "account_holder_name": {
                              "type": "string",
                              "description": "Name of the account holder, as known by the bank. The full name provided when the customer is created is stored and is available via the API, but is transliterated, upcased, and truncated to 18 characters in bank submissions. This field is required unless the request includes a [customer bank account token](#javascript-flow-customer-bank-account-tokens).",
                              "example": "Billie Jean"
                            },
                            "account_number_ending": {
                              "type": "string",
                              "description": "The last few digits of the account number. Currently 4 digits for NZD bank accounts and 2 digits for other currencies.",
                              "example": "1234"
                            },
                            "account_type": {
                              "description": "Bank account type. Required for USD-denominated bank accounts. Must not be provided for bank accounts in other currencies. See [local details](#local-bank-details-united-states) for more information.",
                              "example": "savings",
                              "enum": [
                                "savings",
                                "checking"
                              ],
                              "nullable": true,
                              "type": "string"
                            },
                            "country_code": {
                              "type": "string",
                              "nullable": true,
                              "description": "[ISO 3166-1 alpha-2 code](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements). Defaults to the country code of the `iban` if supplied, otherwise is required.",
                              "example": "GB"
                            },
                            "currency": {
                              "type": "string",
                              "nullable": true,
                              "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                              "example": "EUR"
                            },
                            "bank_name": {
                              "type": "string",
                              "description": "Name of bank, taken from the bank details.",
                              "example": "BARCLAYS BANK PLC"
                            },
                            "enabled": {
                              "type": "boolean",
                              "description": "Boolean value showing whether the bank account is enabled or disabled.",
                              "example": true
                            },
                            "metadata": {
                              "type": "object",
                              "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                            },
                            "links": {
                              "type": "object",
                              "description": "",
                              "properties": {
                                "customer": {
                                  "type": "string",
                                  "description": "ID of the [customer](#core-endpoints-customers) that owns this bank account."
                                }
                              }
                            },
                            "bank_account_token": {
                              "type": "string",
                              "nullable": true,
                              "description": "A token to uniquely refer to a set of bank account details. This feature is still in early access and is only available for certain organisations.",
                              "example": "bat_f975ab3c-ecee-47a1-9590-5bb1d56fa113"
                            },
                            "payer_name_verification_result": {
                              "type": "string",
                              "description": "The result of the payer name verification check performed when the bank account was created. Only present if a check was performed.\n\n- `full`: The name provided matches the name held by the bank.\n- `close`: The name provided is a close but not exact match to the name held by the bank.\n- `cannot_perform_verification`: A verification was attempted but could not be completed. This can happen for a number of reasons, including the account holder's bank not participating in the verification scheme, the account not being eligible for verification (e.g. the account holder has opted out), or the bank details not being resolvable, among others.",
                              "example": "full",
                              "enum": [
                                "full",
                                "close",
                                "cannot_perform_verification"
                              ]
                            }
                          }
                        }
                      }
                    },
                    "links": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "customer": {
                          "type": "string",
                          "description": "ID of the [customer](#core-endpoints-customers) that will be used for this request",
                          "example": "CU123"
                        },
                        "customer_billing_detail": {
                          "type": "string",
                          "description": "ID of the customer billing detail that will be used for this request"
                        },
                        "creditor": {
                          "type": "string",
                          "description": "ID of the associated [creditor](#core-endpoints-creditors).",
                          "example": "CR123"
                        },
                        "organisation": {
                          "type": "string",
                          "description": "ID of the associated organisation.",
                          "example": "OR123"
                        },
                        "customer_bank_account": {
                          "type": "string",
                          "description": "(Optional) ID of the [customer_bank_account](#core-endpoints-customer-bank-accounts) that will be used for this request",
                          "example": "BA123"
                        },
                        "bank_authorisation": {
                          "type": "string",
                          "description": "(Optional) ID of the [bank authorisation](#billing-requests-bank-authorisations) that was used to verify this request."
                        },
                        "payment_request": {
                          "type": "string",
                          "description": "(Optional) ID of the associated payment request",
                          "example": "PRQ123"
                        },
                        "payment_request_payment": {
                          "type": "string",
                          "description": "(Optional) ID of the [payment](#core-endpoints-payments) that was created from this payment request.",
                          "example": "PM123"
                        },
                        "mandate_request": {
                          "type": "string",
                          "description": "(Optional) ID of the associated mandate request",
                          "example": "MRQ123"
                        },
                        "mandate_request_mandate": {
                          "type": "string",
                          "description": "(Optional) ID of the [mandate](#core-endpoints-mandates) that was created from this mandate request. this mandate request.",
                          "example": "MD123"
                        },
                        "subscription_request": {
                          "type": "string",
                          "description": "(Optional) ID of the associated subscription request",
                          "example": "SBR123"
                        },
                        "subscription_request_subscription": {
                          "type": "string",
                          "description": "(Optional) ID of the [subscription](#core-endpoints-subscriptions) that was created from this subscription request.",
                          "example": "SB123"
                        },
                        "instalment_schedule_request": {
                          "type": "string",
                          "description": "(Optional) ID of the associated instalment schedule request",
                          "example": "ISR123"
                        },
                        "instalment_schedule_request_instalment_schedule": {
                          "type": "string",
                          "description": "(Optional) ID of the [instalment_schedule](#core-endpoints-instalment-schedules) that was created from this instalment schedule request.",
                          "example": "IS123"
                        },
                        "payment_provider": {
                          "type": "string",
                          "description": "(Optional) ID of the associated payment provider",
                          "example": "PP123"
                        }
                      }
                    },
                    "fallback_enabled": {
                      "type": "boolean",
                      "description": "(Optional) If true, this billing request can fallback from instant payment to direct debit.\nShould not be set if GoCardless payment intelligence feature is used.\n\nSee [Billing Requests: Retain customers with Fallbacks](https://developer.gocardless.com/billing-requests/retain-customers-with-fallbacks/)\nfor more information."
                    },
                    "fallback_occurred": {
                      "type": "boolean",
                      "description": "True if the billing request was completed with direct debit."
                    }
                  }
                }
              },
              "creditors": {
                "type": "array",
                "description": "A list of creditors linked to the events returned in the list of events.",
                "items": {
                  "type": "object",
                  "description": "Each [payment](#core-endpoints-payments) taken through the API is linked to a \"creditor\", to whom the payment is then paid out. In most cases your organisation will have a single \"creditor\", but the API also supports collecting payments on behalf of others.\n\nCurrently, for Anti Money Laundering reasons, any creditors you add must be directly related to your organisation.",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier, beginning with \"CR\".",
                      "example": "CR123"
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                      "example": "2014-01-01T12:00:00.000Z",
                      "format": "date-time"
                    },
                    "name": {
                      "type": "string",
                      "description": "The creditor's trading name.",
                      "example": "Acme"
                    },
                    "address_line1": {
                      "type": "string",
                      "nullable": true,
                      "description": "The first line of the creditor's address.",
                      "example": "338-346 Goswell Road"
                    },
                    "address_line2": {
                      "type": "string",
                      "nullable": true,
                      "description": "The second line of the creditor's address.",
                      "example": "Islington"
                    },
                    "address_line3": {
                      "type": "string",
                      "nullable": true,
                      "description": "The third line of the creditor's address."
                    },
                    "city": {
                      "type": "string",
                      "nullable": true,
                      "description": "The city of the creditor's address.",
                      "example": "London"
                    },
                    "region": {
                      "type": "string",
                      "nullable": true,
                      "description": "The creditor's address region, county or department."
                    },
                    "postal_code": {
                      "type": "string",
                      "nullable": true,
                      "description": "The creditor's postal code.",
                      "example": "EC1V 7LQ"
                    },
                    "country_code": {
                      "type": "string",
                      "nullable": true,
                      "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                      "example": "GB"
                    },
                    "can_create_refunds": {
                      "type": "boolean",
                      "description": "Boolean indicating whether the creditor is permitted to create refunds."
                    },
                    "bank_reference_prefix": {
                      "type": "string",
                      "description": "Prefix for the bank reference of payouts sent to this creditor. For instance, if\nthe creditor's `bank_reference_prefix` was `ACME`, the bank reference of a payout\nsent to that creditor could be `ACME-8G7Q8`.\n\nThis prefix is also used for refunds in EUR and GBP.\n",
                      "example": "ACME"
                    },
                    "links": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "default_aud_payout_account": {
                          "type": "string",
                          "nullable": true,
                          "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in AUD.",
                          "example": "BA234"
                        },
                        "default_gbp_payout_account": {
                          "type": "string",
                          "nullable": true,
                          "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in GBP.",
                          "example": "BA123"
                        },
                        "default_eur_payout_account": {
                          "type": "string",
                          "nullable": true,
                          "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in EUR.",
                          "example": "BA456"
                        },
                        "default_sek_payout_account": {
                          "type": "string",
                          "nullable": true,
                          "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in SEK.",
                          "example": "BA789"
                        },
                        "default_dkk_payout_account": {
                          "type": "string",
                          "nullable": true,
                          "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in DKK.",
                          "example": "BA790"
                        },
                        "default_nzd_payout_account": {
                          "type": "string",
                          "nullable": true,
                          "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in NZD.",
                          "example": "BA791"
                        },
                        "default_cad_payout_account": {
                          "type": "string",
                          "nullable": true,
                          "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in CAD.",
                          "example": "BA792"
                        },
                        "default_usd_payout_account": {
                          "type": "string",
                          "nullable": true,
                          "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in USD.",
                          "example": "BA792"
                        }
                      }
                    },
                    "scheme_identifiers": {
                      "type": "array",
                      "description": "An array of the scheme identifiers this creditor can create mandates against.\n\nThe support address, `phone_number` and `email` fields are for customers to contact the merchant for support purposes. They must be displayed on the payment page, please see our [compliance requirements](#appendix-compliance-requirements) for more details.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Unique identifier, usually beginning with \"SU\".",
                            "example": "SU123"
                          },
                          "created_at": {
                            "type": "string",
                            "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                            "example": "2014-01-01T12:00:00.000Z",
                            "format": "date-time"
                          },
                          "name": {
                            "type": "string",
                            "description": "The name which appears on customers' bank statements. This should usually be the merchant's trading name."
                          },
                          "scheme": {
                            "description": "The scheme which this scheme identifier applies to.",
                            "example": "bacs",
                            "enum": [
                              "ach",
                              "autogiro",
                              "bacs",
                              "becs",
                              "becs_nz",
                              "betalingsservice",
                              "faster_payments",
                              "pad",
                              "pay_to",
                              "sepa",
                              "sepa_credit_transfer",
                              "sepa_instant_credit_transfer"
                            ],
                            "type": "string"
                          },
                          "reference": {
                            "type": "string",
                            "description": "The scheme-unique identifier against which payments are submitted."
                          },
                          "status": {
                            "description": "The status of the scheme identifier. Only `active` scheme identifiers will be applied to a creditor and used against payments.",
                            "example": "pending",
                            "enum": [
                              "pending",
                              "active"
                            ],
                            "type": "string"
                          },
                          "minimum_advance_notice": {
                            "type": "integer",
                            "description": "The minimum interval, in working days, between the sending of a pre-notification to the customer, and the charge date of a payment using this scheme identifier.\n\nBy default, GoCardless sends these notifications automatically. Please see our [compliance requirements](#appendix-compliance-requirements) for more details.",
                            "example": 3
                          },
                          "address_line1": {
                            "type": "string",
                            "description": "The first line of the scheme identifier's support address.",
                            "example": "221B Baker Street"
                          },
                          "address_line2": {
                            "type": "string",
                            "nullable": true,
                            "description": "The second line of the scheme identifier's support address.",
                            "example": "Marylebone"
                          },
                          "address_line3": {
                            "type": "string",
                            "nullable": true,
                            "description": "The third line of the scheme identifier's support address.",
                            "example": "City of Westminster"
                          },
                          "city": {
                            "type": "string",
                            "description": "The city of the scheme identifier's support address.",
                            "example": "London"
                          },
                          "region": {
                            "type": "string",
                            "nullable": true,
                            "description": "The scheme identifier's support address region, county or department.",
                            "example": "Greater London"
                          },
                          "postal_code": {
                            "type": "string",
                            "description": "The scheme identifier's support postal code.",
                            "example": "NW1 6XE"
                          },
                          "country_code": {
                            "type": "string",
                            "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                            "example": "GB"
                          },
                          "email": {
                            "type": "string",
                            "description": "Scheme identifier's support email address.",
                            "example": "user@example.com"
                          },
                          "phone_number": {
                            "type": "string",
                            "description": "Scheme identifier's support phone number.",
                            "example": "+44 20 1234 1234"
                          },
                          "currency": {
                            "description": "The currency of the scheme identifier.",
                            "example": "EUR",
                            "enum": [
                              "AUD",
                              "CAD",
                              "DKK",
                              "EUR",
                              "GBP",
                              "NZD",
                              "SEK",
                              "USD"
                            ],
                            "type": "string"
                          },
                          "can_specify_mandate_reference": {
                            "type": "boolean",
                            "description": "Whether a custom reference can be submitted for mandates using this scheme identifier."
                          }
                        }
                      }
                    },
                    "logo_url": {
                      "type": "string",
                      "nullable": true,
                      "description": "URL for the creditor's logo, which may be shown on their payment pages.",
                      "example": "https://uploads.gocardless.com/logo.png"
                    },
                    "verification_status": {
                      "description": "The creditor's verification status, indicating whether they can yet receive payouts. For more details on handling verification as a partner, see our [\"Helping your users get verified\" guide](/getting-started/partners/helping-your-users-get-verified/). One of:\n\n- `successful`: The creditor's account is fully verified, and they can receive payouts. Once a creditor has been successfully verified, they may in the future require further verification - for example, if they change their payout bank account, we will have to check that they own the new bank account before they can receive payouts again.\n- `in_review`: The creditor has provided all of the information currently requested, and it is awaiting review by GoCardless before they can be verified and receive payouts.\n- `action_required`: The creditor needs to provide further information to verify their account so they can receive payouts, and should visit the verification flow.",
                      "example": "action_required",
                      "enum": [
                        "successful",
                        "in_review",
                        "action_required"
                      ],
                      "type": "string"
                    },
                    "merchant_responsible_for_notifications": {
                      "type": "boolean",
                      "description": "Boolean value indicating whether the organisation is responsible for sending all customer notifications (note this is separate from the functionality described [here](/getting-started/api/handling-customer-notifications/)). If you are a partner app, and this value is true, you should not send notifications on behalf of this organisation.",
                      "example": true
                    },
                    "mandate_imports_enabled": {
                      "type": "boolean",
                      "description": "Boolean value indicating whether creditor has the [Mandate Imports](#core-endpoints-mandate-imports) functionality enabled.",
                      "example": true
                    },
                    "custom_payment_pages_enabled": {
                      "type": "boolean",
                      "description": "Boolean value indicating whether creditor has the [Custom Payment Pages](https://hub.gocardless.com/s/article/Custom-payment-pages) functionality enabled.",
                      "example": true
                    },
                    "fx_payout_currency": {
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) code for the currency in which amounts will be paid out (after foreign exchange). Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported. Present only if payouts will be (or were) made via foreign exchange.",
                      "example": "EUR",
                      "enum": [
                        "AUD",
                        "CAD",
                        "DKK",
                        "EUR",
                        "GBP",
                        "NZD",
                        "SEK",
                        "USD"
                      ],
                      "nullable": true,
                      "type": "string"
                    },
                    "creditor_type": {
                      "description": "The type of business of the creditor. Currently, `individual`, `company`, `charity`, `partnership`, and `trust` are supported.",
                      "example": "company",
                      "enum": [
                        "company",
                        "individual",
                        "charity",
                        "partnership",
                        "trust"
                      ],
                      "type": "string"
                    }
                  }
                }
              },
              "instalment_schedules": {
                "type": "array",
                "description": "A list of instalment schedules linked to the events returned in the list of events.",
                "items": {
                  "type": "object",
                  "description": "Instalment schedules are objects which represent a collection of related payments, with the\nintention to collect the `total_amount` specified. The API supports both schedule-based\ncreation (similar to subscriptions) as well as explicit selection of differing payment\namounts and charge dates.\n\nUnlike subscriptions, the payments are created immediately, so the instalment schedule\ncannot be modified once submitted and instead can only be cancelled (which will cancel\nany of the payments which have not yet been submitted).\n\nCustomers will receive a single notification about the complete schedule of collection.\n",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier, beginning with \"IS\".",
                      "example": "IS123"
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                      "example": "2014-01-01T12:00:00.000Z",
                      "format": "date-time"
                    },
                    "total_amount": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "The total amount of the instalment schedule, defined as the sum of all individual\npayments, in the lowest denomination for the currency (e.g. pence in GBP, cents in\nEUR). If the requested payment amounts do not sum up correctly, a validation error\nwill be returned.",
                      "example": 1000
                    },
                    "name": {
                      "type": "string",
                      "description": "Name of the instalment schedule, up to 100 chars. This name will also be\ncopied to the payments of the instalment schedule if you use schedule-based creation.",
                      "example": "Invoice 4404"
                    },
                    "currency": {
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                      "example": "EUR",
                      "enum": [
                        "AUD",
                        "CAD",
                        "DKK",
                        "EUR",
                        "GBP",
                        "NZD",
                        "SEK",
                        "USD"
                      ],
                      "type": "string"
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                    },
                    "status": {
                      "description": "One of:\n\n- `pending`: we're waiting for GC to create the payments\n- `active`: the payments have been created, and the schedule is active\n- `creation_failed`: payment creation failed\n- `completed`: we have passed the date of the final payment and all payments have been collected\n- `cancelled`: the schedule has been cancelled\n- `errored`: one or more payments have failed",
                      "example": "active",
                      "enum": [
                        "pending",
                        "active",
                        "creation_failed",
                        "completed",
                        "cancelled",
                        "errored"
                      ],
                      "type": "string"
                    },
                    "payment_errors": {
                      "type": "object",
                      "description": "If the status is `creation_failed`, this property will be populated with validation\nfailures from the individual payments, arranged by the index of the payment that\nfailed.\n",
                      "example": {
                        "0": [
                          {
                            "field": "charge_date",
                            "message": "must be on or after mandate's next_possible_customer_charge_date"
                          }
                        ]
                      }
                    },
                    "links": {
                      "type": "object",
                      "description": "Links to associated objects",
                      "properties": {
                        "mandate": {
                          "type": "string",
                          "description": "ID of the associated [mandate](#core-endpoints-mandates) which the instalment schedule will create payments against.",
                          "example": "MD123"
                        },
                        "customer": {
                          "type": "string",
                          "description": "ID of the associated [customer](#core-endpoints-customers).",
                          "example": "CU123"
                        },
                        "payments": {
                          "type": "array",
                          "description": "Array of IDs of the associated [payments](#core-endpoints-payments)",
                          "example": [
                            "PM123",
                            "PM456"
                          ],
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "mandates": {
                "type": "array",
                "description": "A list of mandates linked to the events returned in the list of events.",
                "items": {
                  "type": "object",
                  "description": "Mandates represent the Direct Debit mandate with a [customer](#core-endpoints-customers).\n\nGoCardless will notify you via a [webhook](#appendix-webhooks) whenever the status of a mandate changes.",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier, beginning with \"MD\". Note that this prefix may not apply to mandates created before 2016.",
                      "example": "MD123"
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                      "example": "2014-01-01T12:00:00.000Z",
                      "format": "date-time"
                    },
                    "reference": {
                      "type": "string",
                      "nullable": true,
                      "description": "Unique reference. Different schemes have different length and [character set](#appendix-character-sets) requirements. GoCardless will generate a unique reference satisfying the different scheme requirements if this field is left blank.",
                      "example": "REF-123"
                    },
                    "status": {
                      "description": "One of:\n\n- `pending_customer_approval`: the mandate has not yet been signed by the second customer\n- `pending_submission`: the mandate has not yet been submitted to the customer's bank\n- `submitted`: the mandate has been submitted to the customer's bank but has not been processed yet\n- `active`: the mandate has been successfully set up by the customer's bank\n- `suspended_by_payer`: the mandate has been suspended by payer\n- `failed`: the mandate could not be created\n- `cancelled`: the mandate has been cancelled\n- `expired`: the mandate has expired due to dormancy\n- `consumed`: the mandate has been consumed and cannot be reused (note that this only applies to schemes that are per-payment authorised)\n- `blocked`: the mandate has been blocked and payments cannot be created",
                      "example": "pending_submission",
                      "enum": [
                        "pending_customer_approval",
                        "pending_submission",
                        "submitted",
                        "active",
                        "failed",
                        "cancelled",
                        "expired",
                        "consumed",
                        "blocked",
                        "suspended_by_payer"
                      ],
                      "type": "string"
                    },
                    "scheme": {
                      "type": "string",
                      "nullable": true,
                      "description": "<a name=\"mandates_scheme\"></a>Bank payment scheme to which this mandate and associated payments are submitted. Can be supplied or automatically detected from the customer's bank account.",
                      "example": "bacs"
                    },
                    "mandate_type": {
                      "type": "string",
                      "nullable": true,
                      "description": "Mandate type",
                      "example": "bank_debit",
                      "enum": [
                        "bank_debit",
                        "instant",
                        "recurring",
                        "vrp_commercial",
                        "vrp_sweeping"
                      ]
                    },
                    "next_possible_charge_date": {
                      "type": "string",
                      "nullable": true,
                      "description": "The earliest date that can be used as a `charge_date` on any newly created payment for this mandate. This value will change over time.",
                      "example": "2014-10-27",
                      "format": "date"
                    },
                    "next_possible_standard_ach_charge_date": {
                      "type": "string",
                      "nullable": true,
                      "description": "If this is an an ACH mandate, the earliest date that can be used as a\n`charge_date` on any newly created payment to be charged through standard\nACH, rather than Faster ACH. This value will change over time.\n\nIt is only present in the API response for ACH mandates.",
                      "example": "2014-10-27",
                      "format": "date"
                    },
                    "payments_require_approval": {
                      "type": "boolean",
                      "description": "Boolean value showing whether payments and subscriptions under this mandate require approval via an automated email before being processed."
                    },
                    "verified_at": {
                      "type": "string",
                      "nullable": true,
                      "description": "[Timestamp](#api-usage-dates-and-times) recording when this mandate was verified.",
                      "example": "2021-01-01T12:00:00.000Z",
                      "format": "date-time"
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                    },
                    "links": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "customer_bank_account": {
                          "type": "string",
                          "description": "ID of the associated [customer bank account](#core-endpoints-customer-bank-accounts) which the mandate is created and submits payments against.",
                          "example": "BA123"
                        },
                        "creditor": {
                          "type": "string",
                          "description": "ID of the associated [creditor](#core-endpoints-creditors).",
                          "example": "CR123"
                        },
                        "new_mandate": {
                          "type": "string",
                          "description": "ID of the new mandate if this mandate has been replaced.",
                          "example": "MD123"
                        },
                        "customer": {
                          "type": "string",
                          "description": "ID of the associated [customer](#core-endpoints-customers)",
                          "example": "CU123"
                        }
                      }
                    },
                    "consent_parameters": {
                      "type": "object",
                      "nullable": true,
                      "description": "(Optional) Payto and VRP Scheme specific information",
                      "properties": {
                        "max_amount_per_payment": {
                          "type": "integer",
                          "description": "The maximum amount that can be charged for a single payment"
                        },
                        "period": {
                          "description": "The repeating period for this mandate",
                          "enum": [
                            "day",
                            "week",
                            "month",
                            "year",
                            "flexible"
                          ],
                          "type": "string"
                        },
                        "max_amount_per_period": {
                          "type": "integer",
                          "description": "The maximum total amount that can be charged for all payments in this period"
                        },
                        "max_payments_per_period": {
                          "type": "integer",
                          "description": "The maximum number of payments that can be collected in this period"
                        },
                        "start_date": {
                          "type": "string",
                          "description": "The date from which payments can be taken"
                        },
                        "end_date": {
                          "type": "string",
                          "description": "The latest date at which payments can be taken, must occur after start_date if present"
                        }
                      }
                    },
                    "authorisation_source": {
                      "description": "This field is ACH specific, sometimes referred to as [SEC code](https://www.moderntreasury.com/learn/sec-codes).\n\nThis is the way that the payer gives authorisation to the merchant.\n  web: Authorisation is Internet Initiated or via Mobile Entry (maps to SEC code: WEB)\n  telephone: Authorisation is provided orally over telephone (maps to SEC code: TEL)\n  paper: Authorisation is provided in writing and signed, or similarly authenticated (maps to SEC code: PPD)\n",
                      "enum": [
                        "web",
                        "telephone",
                        "paper"
                      ],
                      "type": "string"
                    },
                    "funds_settlement": {
                      "description": "This field will decide how GoCardless handles settlement of funds from the customer.\n\n- `managed` will be moved through GoCardless' account, batched, and payed out.\n- `direct` will be a direct transfer from the payer's account to the merchant where\n  invoicing will be handled separately.\n",
                      "enum": [
                        "managed",
                        "direct"
                      ],
                      "type": "string"
                    },
                    "consent_type": {
                      "type": "string",
                      "nullable": true,
                      "description": "(Optional) Specifies the type of authorisation agreed between the payer and merchant. It can be set to one-off, recurring or standing for ACH, or single, recurring and sporadic for PAD.",
                      "enum": [
                        "one_off",
                        "single",
                        "recurring",
                        "standing",
                        "sporadic"
                      ]
                    }
                  }
                }
              },
              "outbound_payments": {
                "type": "array",
                "description": "A list of outbound payments linked to the events returned in the list of events.",
                "items": {
                  "type": "object",
                  "description": "Outbound Payments represent payments sent from [creditors](#core-endpoints-creditors).\n\nGoCardless will notify you via a [webhook](#appendix-webhooks) when the status of the outbound payment [changes](#event-types-outbound-payment).\n\n#### Rate limiting\n\nTwo rate limits apply to the Outbound Payments APIs:\n- All POST Outbound Payment endpoints (create, withdraw, approve, cancel and etc.) share a single rate-limit group of 300 requests per minute. As initiating a payment typically requires two API calls (one to create the payment and one to approve it), this allows you to add approximately 150 outbound payments per minute.\n- All remaining Outbound Payment endpoints are limited to 500 requests per minute.",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier of the outbound payment.",
                      "example": "OUT123"
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when the outbound payment was created.",
                      "example": "2024-01-01T12:00:00.001Z",
                      "format": "date-time"
                    },
                    "status": {
                      "description": "One of:\n\n- `verifying`: The payment has been [created](#outbound-payments-create-an-outbound-payment) and the verification process has begun.\n- `pending_approval`: The payment is awaiting [approval](#outbound-payments-approve-an-outbound-payment).\n- `scheduled`: The payment has passed verification & [approval](#outbound-payments-approve-an-outbound-payment), but processing has not yet begun.\n- `executing`: The execution date has arrived and the payment has been placed in queue for processing.\n- `executed`: The payment has been accepted by the scheme and is now on its way to the recipient.\n- `cancelled`: The payment has been [cancelled](#outbound-payments-cancel-an-outbound-payment) or was not [approved](#outbound-payments-approve-an-outbound-payment) on time.\n- `failed`: The payment was not sent, usually due to an error while or after executing.",
                      "example": "cancelled",
                      "enum": [
                        "verifying",
                        "pending_approval",
                        "scheduled",
                        "executing",
                        "executed",
                        "cancelled",
                        "failed"
                      ],
                      "type": "string"
                    },
                    "amount": {
                      "type": "integer",
                      "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                      "example": 1000
                    },
                    "scheme": {
                      "description": "Bank payment scheme to process the outbound payment. Currently only \"faster_payments\" (GBP) is supported.",
                      "example": "faster_payments",
                      "enum": [
                        "faster_payments"
                      ],
                      "type": "string"
                    },
                    "currency": {
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency. Currently only \"GBP\" is supported.",
                      "example": "GBP",
                      "enum": [
                        "GBP"
                      ],
                      "type": "string"
                    },
                    "execution_date": {
                      "type": "string",
                      "description": "A future date on which the outbound payment should be sent.\nIf not specified, the payment will be sent as soon as possible.",
                      "example": "2024-08-31",
                      "format": "date"
                    },
                    "description": {
                      "type": "string",
                      "description": "A human-readable description of the outbound payment",
                      "example": "Reward Payment (August 2024)"
                    },
                    "reference": {
                      "type": "string",
                      "description": "An optional reference that will appear on your customer's bank statement.\nThe character limit for this reference is dependent on the scheme.<br />\n<strong>Faster Payments</strong> - 18 characters, including: \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 &-./\"<br />",
                      "example": "GC-QC2FI7GBEW7VCXL"
                    },
                    "is_withdrawal": {
                      "type": "boolean",
                      "description": "Indicates whether the outbound payment is a withdrawal to your verified business bank account.",
                      "example": true
                    },
                    "links": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "creditor": {
                          "type": "string",
                          "description": "ID of the creditor who sends the outbound payment.",
                          "example": "CR123"
                        },
                        "customer": {
                          "type": "string",
                          "description": "ID of the [customer](#core-endpoints-customers) that receives this outbound payment",
                          "example": "CU123"
                        },
                        "recipient_bank_account": {
                          "type": "string",
                          "description": "ID of the customer bank account which receives the outbound payment.",
                          "example": "BA123"
                        },
                        "outbound_payment_import": {
                          "type": "string",
                          "description": "ID of the outbound payment import that created this outbound payment.",
                          "example": "IM123"
                        }
                      }
                    },
                    "verifications": {
                      "type": "object",
                      "nullable": true,
                      "description": "Contains details of the verifications performed for the outbound payment",
                      "properties": {
                        "recipient_bank_account_holder_verification": {
                          "type": "object",
                          "nullable": true,
                          "description": "Checks if the recipient owns the provided bank account",
                          "properties": {
                            "type": {
                              "description": "Type of the verification that has been performed\neg. [Confirmation of Payee](https://www.wearepay.uk/what-we-do/overlay-services/confirmation-of-payee/)",
                              "example": "confirmation_of_payee",
                              "enum": [
                                "confirmation_of_payee"
                              ],
                              "type": "string"
                            },
                            "result": {
                              "description": "Result of the verification, could be one of\n\n- `full_match`: The verification has confirmed that the account name exactly matches the details provided.\n- `partial_match`: The verification has confirmed that the account name is similar but does not match to the details provided.\n- `no_match`: The verification concludes the provided name does not match the account details.\n- `unable_to_match`: The verification could not be performed due to recipient bank issues or technical issues",
                              "example": "partial_match",
                              "enum": [
                                "full_match",
                                "partial_match",
                                "no_match",
                                "unable_to_match"
                              ],
                              "type": "string"
                            },
                            "actual_account_name": {
                              "type": "string",
                              "nullable": true,
                              "description": "The actual account name returned by the recipient's bank, populated only in the case of a partial match.",
                              "example": "Jo Doe"
                            }
                          }
                        }
                      }
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with\nkey names up to 50 characters and values up to 500 characters."
                    }
                  }
                }
              },
              "payer_authorisations": {
                "type": "array",
                "description": "A list of payer authorisations linked to the events returned in the list of events.",
                "items": {
                  "type": "object",
                  "description": "<p class=\"restricted-notice\">\n  Don't use Payer Authorisations for new integrations.\n  It is deprecated in favour of\n  <a href=\"https://developer.gocardless.com/getting-started/billing-requests/overview/\">\n  Billing Requests</a>. Use Billing Requests to build any future integrations.\n</p>\n\nPayer Authorisation resource acts as a wrapper for creating customer, bank account and mandate details in a single request.\nPayerAuthorisation API enables the integrators to build their own custom payment pages.\n\nThe process to use the Payer Authorisation API is as follows:\n\n  1. Create a Payer Authorisation, either empty or with already available information\n  2. Update the authorisation with additional information or fix any mistakes\n  3. Submit the authorisation, after the payer has reviewed their information\n  4. [coming soon] Redirect the payer to the verification mechanisms from the response of the Submit request (this will be introduced as a non-breaking change)\n  5. Confirm the authorisation to indicate that the resources can be created\n\nAfter the Payer Authorisation is confirmed, resources will eventually be created as it's an asynchronous process.\n\nTo retrieve the status and ID of the linked resources you can do one of the following:\n<ol>\n  <li> Listen to <code>  payer_authorisation_completed </code>  <a href=\"#appendix-webhooks\"> webhook</a> (recommended)</li>\n  <li> Poll the GET <a href=\"#payer-authorisations-get-a-single-payer-authorisation\"> endpoint</a></li>\n  <li> Poll the GET events API <code>https://api.gocardless.com/events?payer_authorisation={id}&action=completed</code> </li>\n</ol>\n\n<p class=\"notice\">\n  Note that the <code>create</code> and <code>update</code> endpoints behave differently than\n  other existing <code>create</code> and <code>update</code> endpoints. The Payer Authorisation is still saved if incomplete data is provided.\n  We return the list of incomplete data in the <code>incomplete_fields</code> along with the resources in the body of the response.\n  The bank account details(account_number, bank_code & branch_code) must be sent together rather than splitting across different request for both <code>create</code> and <code>update</code> endpoints.\n  <br><br>\n  The API is designed to be flexible and allows you to collect information in multiple steps without storing any sensitive data in the browser or in your servers.\n</p>",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier, beginning with \"PA\".",
                      "example": "PA123"
                    },
                    "created_at": {
                      "type": "string",
                      "nullable": true,
                      "description": "[Timestamp](#api-usage-dates-and-times), recording when this Payer Authorisation was created.",
                      "example": "2020-01-01T12:00:00.000Z",
                      "format": "date-time"
                    },
                    "customer": {
                      "type": "object",
                      "description": "All details required for the creation of a [Customer](#core-endpoints-customers).",
                      "properties": {
                        "email": {
                          "type": "string",
                          "nullable": true,
                          "description": "Customer's email address. Required in most cases, as this allows GoCardless to send notifications to this customer.",
                          "example": "user@example.com"
                        },
                        "given_name": {
                          "type": "string",
                          "nullable": true,
                          "description": "Customer's first name. Required unless a `company_name` is provided.",
                          "example": "Frank"
                        },
                        "family_name": {
                          "type": "string",
                          "nullable": true,
                          "description": "Customer's surname. Required unless a `company_name` is provided.",
                          "example": "Osborne"
                        },
                        "company_name": {
                          "type": "string",
                          "nullable": true,
                          "description": "Customer's company name. Required unless a `given_name` and `family_name` are provided. For Canadian customers, the use of a `company_name` value will mean that any mandate created from this customer will be considered to be a \"Business PAD\" (otherwise, any mandate will be considered to be a \"Personal PAD\").",
                          "example": "Hamilton Trading Ltd."
                        },
                        "address_line1": {
                          "type": "string",
                          "nullable": true,
                          "description": "The first line of the customer's address.",
                          "example": "221B Baker Street"
                        },
                        "address_line2": {
                          "type": "string",
                          "nullable": true,
                          "description": "The second line of the customer's address.",
                          "example": "Marylebone"
                        },
                        "address_line3": {
                          "type": "string",
                          "nullable": true,
                          "description": "The third line of the customer's address.",
                          "example": "City of Westminster"
                        },
                        "city": {
                          "type": "string",
                          "nullable": true,
                          "description": "The city of the customer's address.",
                          "example": "London"
                        },
                        "region": {
                          "type": "string",
                          "nullable": true,
                          "description": "The customer's address region, county or department. For US customers a 2 letter [ISO3166-2:US](https://en.wikipedia.org/wiki/ISO_3166-2:US) state code is required (e.g. `CA` for California).",
                          "example": "Greater London"
                        },
                        "postal_code": {
                          "type": "string",
                          "nullable": true,
                          "description": "The customer's postal code.",
                          "example": "NW1 6XE"
                        },
                        "country_code": {
                          "type": "string",
                          "nullable": true,
                          "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                          "example": "GB"
                        },
                        "locale": {
                          "type": "string",
                          "nullable": true,
                          "description": "An [IETF Language Tag](https://tools.ietf.org/html/rfc5646), used for both language\nand regional variations of our product.\n",
                          "example": "en-GB"
                        },
                        "swedish_identity_number": {
                          "type": "string",
                          "nullable": true,
                          "description": "For Swedish customers only. The civic/company number (personnummer, samordningsnummer, or organisationsnummer) of the customer. Must be supplied if the customer's bank account is denominated in Swedish krona (SEK). This field cannot be changed once it has been set.",
                          "example": "556564-5404"
                        },
                        "danish_identity_number": {
                          "type": "string",
                          "nullable": true,
                          "description": "For Danish customers only. The civic/company number (CPR or CVR) of the customer. Must be supplied if the customer's bank account is denominated in Danish krone (DKK).",
                          "example": "220550-6218"
                        },
                        "metadata": {
                          "type": "object",
                          "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                        }
                      }
                    },
                    "bank_account": {
                      "type": "object",
                      "description": "All details required for the creation of a\n[Customer Bank Account](#core-endpoints-customer-bank-accounts).",
                      "properties": {
                        "account_holder_name": {
                          "type": "string",
                          "description": "Name of the account holder, as known by the bank. The full name provided when the customer is created is stored and is available via the API, but is transliterated, upcased, and truncated to 18 characters in bank submissions. This field is required unless the request includes a [customer bank account token](#javascript-flow-customer-bank-account-tokens).",
                          "example": "Billie Jean"
                        },
                        "account_number": {
                          "type": "string",
                          "nullable": true,
                          "description": "Bank account number - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`.",
                          "example": "55779911"
                        },
                        "account_number_ending": {
                          "type": "string",
                          "description": "The last few digits of the account number. Currently 4 digits for NZD bank accounts and 2 digits for other currencies.",
                          "example": "1234"
                        },
                        "account_number_suffix": {
                          "type": "string",
                          "nullable": true,
                          "description": "Account number suffix (only for bank accounts denominated in NZD) - see [local details](#local-bank-details-new-zealand) for more information.",
                          "example": "00"
                        },
                        "bank_code": {
                          "type": "string",
                          "nullable": true,
                          "description": "Bank code - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`."
                        },
                        "branch_code": {
                          "type": "string",
                          "nullable": true,
                          "description": "Branch code - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`.",
                          "example": "20-00-00"
                        },
                        "iban": {
                          "type": "string",
                          "nullable": true,
                          "description": "International Bank Account Number. Alternatively you can provide [local details](#appendix-local-bank-details). IBANs are not accepted for Swedish bank accounts denominated in SEK - you must supply [local details](#local-bank-details-sweden).",
                          "example": "GB60BARC20000055779911"
                        },
                        "country_code": {
                          "type": "string",
                          "nullable": true,
                          "description": "[ISO 3166-1 alpha-2 code](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements). Defaults to the country code of the `iban` if supplied, otherwise is required.",
                          "example": "GB"
                        },
                        "currency": {
                          "type": "string",
                          "nullable": true,
                          "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                          "example": "EUR"
                        },
                        "account_type": {
                          "description": "Bank account type. Required for USD-denominated bank accounts. Must not be provided for bank accounts in other currencies. See [local details](#local-bank-details-united-states) for more information.",
                          "example": "savings",
                          "enum": [
                            "savings",
                            "checking"
                          ],
                          "nullable": true,
                          "type": "string"
                        },
                        "metadata": {
                          "type": "object",
                          "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                        }
                      }
                    },
                    "mandate": {
                      "type": "object",
                      "description": "All details required for the creation of a [Mandate](#core-endpoints-mandates).",
                      "properties": {
                        "reference": {
                          "type": "string",
                          "nullable": true,
                          "description": "Unique reference. Different schemes have different length and [character set](#appendix-character-sets) requirements. GoCardless will generate a unique reference satisfying the different scheme requirements if this field is left blank.",
                          "example": "REF-123"
                        },
                        "scheme": {
                          "description": "A bank payment scheme. Currently \"ach\", \"autogiro\", \"bacs\", \"becs\", \"becs_nz\", \"betalingsservice\", \"faster_payments\", \"pad\", \"pay_to\" and \"sepa_core\" are supported.",
                          "example": "bacs",
                          "enum": [
                            "ach",
                            "autogiro",
                            "bacs",
                            "becs",
                            "becs_nz",
                            "betalingsservice",
                            "faster_payments",
                            "pad",
                            "pay_to",
                            "sepa_core"
                          ],
                          "nullable": true,
                          "type": "string"
                        },
                        "payer_ip_address": {
                          "type": "string",
                          "nullable": true,
                          "description": "For ACH customers only. Required for ACH customers. A string containing the IP address of the payer to whom the mandate belongs (i.e. as a result of their completion of a mandate setup flow in their browser).\n\nNot required for creating offline mandates where `authorisation_source` is set to telephone or paper.\n",
                          "example": "127.0.0.1"
                        },
                        "metadata": {
                          "type": "object",
                          "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                        }
                      }
                    },
                    "incomplete_fields": {
                      "type": "array",
                      "description": "An array of fields which are missing and is required to set up the mandate.",
                      "items": {
                        "type": "object",
                        "description": "",
                        "properties": {
                          "field": {
                            "type": "string",
                            "description": "The root resource."
                          },
                          "message": {
                            "type": "string",
                            "description": "A localised error message"
                          },
                          "request_pointer": {
                            "type": "string",
                            "description": "The path to the field e.g. \"/payer_authorisations/customer/city\""
                          }
                        }
                      }
                    },
                    "links": {
                      "type": "object",
                      "description": "IDs of the created resources. Available after the Payer Authorisation is completed.",
                      "properties": {
                        "customer": {
                          "type": "string",
                          "description": "Unique identifier, beginning with \"CU\".",
                          "example": "CU123"
                        },
                        "bank_account": {
                          "type": "string",
                          "description": "Unique identifier, beginning with \"BA\".",
                          "example": "BA123"
                        },
                        "mandate": {
                          "type": "string",
                          "description": "Unique identifier, beginning with \"MD\". Note that this prefix may not apply to mandates created before 2016.",
                          "example": "MD123"
                        }
                      }
                    },
                    "status": {
                      "description": "One of:\n\n- `created`: The PayerAuthorisation has been created, and not been confirmed yet\n- `submitted`: The payer information has been submitted\n- `confirmed`: PayerAuthorisation is confirmed and resources are ready to be created\n- `completed`: The PayerAuthorisation has been completed and customer, bank_account and mandate has been created\n- `failed`: The PayerAuthorisation has failed and customer, bank_account and mandate is not created",
                      "example": "created",
                      "enum": [
                        "created",
                        "submitted",
                        "confirmed",
                        "completed",
                        "failed"
                      ],
                      "type": "string"
                    }
                  }
                }
              },
              "payment_account_transactions": {
                "type": "array",
                "description": "A list of payment account transactions linked to the events returned in the list of events.",
                "items": {
                  "type": "object",
                  "description": "Payment account transactions represent movements of funds on a given payment account. The payment account is provisioned by GoCardless and is used to fund [outbound payments](#core-endpoints-outbound-payments).",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The unique ID of the payment account transaction.",
                      "example": "PATR1234"
                    },
                    "value_date": {
                      "type": "string",
                      "description": "The date of when the transaction occurred.",
                      "example": "2014-01-01",
                      "format": "date"
                    },
                    "reference": {
                      "type": "string",
                      "description": "The reference of the transaction. This is typically supplied by the sender.",
                      "example": "GC-058408d9"
                    },
                    "description": {
                      "type": "string",
                      "description": "The description of the transaction, if available",
                      "example": "Reward Payment (August 2024)"
                    },
                    "counterparty_name": {
                      "type": "string",
                      "description": "The name of the counterparty of the transaction. The counterparty is the recipient for a credit, or the sender for a debit.",
                      "example": "Acme Ltd"
                    },
                    "links": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "payout": {
                          "type": "string",
                          "description": "ID of the [payout](#core-endpoints-payouts) linked to the transaction.",
                          "example": "PO123"
                        },
                        "outbound_payment": {
                          "type": "string",
                          "description": "ID of the [outbound_payment](#core-endpoints-outbound-payments) linked to the transaction",
                          "example": "OUT123"
                        },
                        "payment_bank_account": {
                          "type": "string",
                          "description": "ID of the payment bank account.",
                          "example": "BA123"
                        }
                      }
                    },
                    "currency": {
                      "type": "string",
                      "description": "The currency of the transaction.",
                      "enum": [
                        "GBP"
                      ]
                    },
                    "direction": {
                      "description": "The direction of the transaction. Debits mean money leaving the account (e.g. outbound payment), while credits signify money coming in (e.g. manual top-up).",
                      "example": "credit",
                      "enum": [
                        "credit",
                        "debit"
                      ],
                      "type": "string"
                    },
                    "amount": {
                      "type": "integer",
                      "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                      "example": 1000
                    },
                    "balance_after_transaction": {
                      "type": "integer",
                      "description": "Balance after transaction, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                      "example": 1000
                    }
                  }
                }
              },
              "payments": {
                "type": "array",
                "description": "A list of payments linked to the events returned in the list of events.",
                "items": {
                  "type": "object",
                  "description": "Payment objects represent payments from a [customer](#core-endpoints-customers) to a [creditor](#core-endpoints-creditors), taken against a Direct Debit [mandate](#core-endpoints-mandates).\n\nGoCardless will notify you via a [webhook](#appendix-webhooks) whenever the state of a payment changes.",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier, beginning with \"PM\".",
                      "example": "PM123"
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                      "example": "2014-01-01T12:00:00.000Z",
                      "format": "date-time"
                    },
                    "amount": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\nMinimum and maximum amounts vary by payment scheme. For more information, see [Transaction limits](https://support.gocardless.com/hc/en-gb/articles/115000309245-Transaction-limits)\n\nFor Variable Recurring Payments (VRP), this must not exceed the mandate's `max_amount_per_payment`\nconstraint.",
                      "example": 1000
                    },
                    "amount_refunded": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Amount [refunded](#core-endpoints-refunds), in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                      "example": 150
                    },
                    "currency": {
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                      "example": "EUR",
                      "enum": [
                        "AUD",
                        "CAD",
                        "DKK",
                        "EUR",
                        "GBP",
                        "NZD",
                        "SEK",
                        "USD"
                      ],
                      "type": "string"
                    },
                    "description": {
                      "type": "string",
                      "nullable": true,
                      "description": "A human-readable description of the payment. This will be included in the notification email GoCardless sends to your customer if your organisation does not send its own notifications (see [compliance requirements](#appendix-compliance-requirements)).",
                      "example": "One-off upgrade fee"
                    },
                    "charge_date": {
                      "type": "string",
                      "nullable": true,
                      "description": "A future date on which the payment should be collected. If not specified, the payment will be collected as soon as possible. If the value is before the [mandate](#core-endpoints-mandates)'s `next_possible_charge_date` creation will fail. If the value is not a working day it will be rolled forwards to the next available one.",
                      "example": "2014-05-21",
                      "format": "date"
                    },
                    "reference": {
                      "type": "string",
                      "nullable": true,
                      "description": "An optional reference that will appear on your customer's bank statement. The character limit for this reference is dependent on the scheme.<br /> <strong>ACH</strong> - 10 characters<br /> <strong>Autogiro</strong> - 11 characters<br /> <strong>Bacs</strong> - 10 characters<br /> <strong>BECS</strong> - 30 characters<br /> <strong>BECS NZ</strong> - 12 characters<br /> <strong>Betalingsservice</strong> - 30 characters<br /> <strong>Faster Payments</strong> - 18 characters<br /> <strong>PAD</strong> - scheme doesn't offer references<br /> <strong>PayTo</strong> - 18 characters<br /> <strong>SEPA</strong> - 140 characters<br /> Note that this reference must be unique (for each merchant) for the BECS scheme as it is a scheme requirement. <p class='restricted-notice'><strong>Restricted</strong>: You can only specify a payment reference for Bacs payments (that is, when collecting from the UK) if you're on the <a href='https://gocardless.com/pricing'>GoCardless Plus, Pro or Enterprise packages</a>.</p> <p class='restricted-notice'><strong>Restricted</strong>: You can not specify a payment reference for Faster Payments.</p>",
                      "example": "WINEBOX001"
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                    },
                    "status": {
                      "description": "One of:\n\n- `pending_customer_approval`: we're waiting for the customer to approve this payment\n- `pending_submission`: the payment has been created, but not yet submitted to the banks\n- `submitted`: the payment has been submitted to the banks\n- `confirmed`: the payment has been confirmed as collected\n- `paid_out`: the payment has been included in a [payout](#core-endpoints-payouts)\n- `cancelled`: the payment has been cancelled\n- `customer_approval_denied`: the customer has denied approval for the payment. You should contact the customer directly\n- `failed`: the payment failed to be processed. Note that payments can fail after being confirmed if the failure message is sent late by the banks.\n- `charged_back`: the payment has been charged back",
                      "example": "submitted",
                      "enum": [
                        "pending_customer_approval",
                        "pending_submission",
                        "submitted",
                        "confirmed",
                        "paid_out",
                        "cancelled",
                        "customer_approval_denied",
                        "failed",
                        "charged_back"
                      ],
                      "type": "string"
                    },
                    "app_fee": {
                      "oneOf": [
                        {
                          "type": "string",
                          "nullable": true
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "The amount to be deducted from the payment as the OAuth app''s fee,\nin the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\nOnly present if the payment was created via an app.",
                      "example": 100
                    },
                    "links": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "mandate": {
                          "type": "string",
                          "description": "ID of the [mandate](#core-endpoints-mandates) against which this payment should be collected.",
                          "example": "MD123"
                        },
                        "creditor": {
                          "type": "string",
                          "description": "ID of [creditor](#core-endpoints-creditors) to which the collected payment will be sent.",
                          "example": "CR123"
                        },
                        "payout": {
                          "type": "string",
                          "description": "ID of [payout](#core-endpoints-payouts) which contains the funds from this payment.<br/>_Note_: this property will not be present until the payment has been successfully collected.",
                          "example": "PO123"
                        },
                        "subscription": {
                          "type": "string",
                          "description": "ID of [subscription](#core-endpoints-subscriptions) from which this payment was created.<br/>_Note_: this property will only be present if this payment is part of a subscription.",
                          "example": "SU123"
                        },
                        "instalment_schedule": {
                          "type": "string",
                          "description": "ID of [instalment_schedule](#core-endpoints-instalment-schedules) from which this payment was created.<br/>**Note**: this property will only be present if this payment is part of an instalment schedule.",
                          "example": "IS123"
                        }
                      }
                    },
                    "faster_ach": {
                      "type": "boolean",
                      "nullable": true,
                      "description": "This field indicates whether the ACH payment is processed through Faster\nACH or standard ACH.\n\nIt is only present in the API response for ACH payments."
                    },
                    "fx": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "exchange_rate": {
                          "type": "string",
                          "nullable": true,
                          "description": "Rate used in the foreign exchange of the `amount` into the `fx_currency`.\nPresent only after a resource is paid out. Has up to 10 decimal places.",
                          "example": "1.1234567890"
                        },
                        "estimated_exchange_rate": {
                          "type": "string",
                          "nullable": true,
                          "description": "Estimated rate that will be used in the foreign exchange of the `amount` into the `fx_currency`.\nThis will vary based on the prevailing market rate until the moment that it is paid out.\nPresent only before a resource is paid out. Has up to 10 decimal places.",
                          "example": "1.1234567890"
                        },
                        "fx_amount": {
                          "oneOf": [
                            {
                              "type": "string",
                              "nullable": true
                            },
                            {
                              "type": "integer"
                            }
                          ],
                          "description": "Amount that was paid out in the `fx_currency` after foreign exchange.\nPresent only after the resource has been paid out.",
                          "example": 1150
                        },
                        "fx_currency": {
                          "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) code for the currency in which amounts will be paid out (after foreign exchange). Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported. Present only if payouts will be (or were) made via foreign exchange.",
                          "example": "EUR",
                          "enum": [
                            "AUD",
                            "CAD",
                            "DKK",
                            "EUR",
                            "GBP",
                            "NZD",
                            "SEK",
                            "USD"
                          ],
                          "nullable": true,
                          "type": "string"
                        }
                      }
                    },
                    "retry_if_possible": {
                      "type": "boolean",
                      "description": "On failure, automatically retry the payment using [intelligent retries](/success-plus/overview). Default is `false`. <p class=\"notice\"><strong>Important</strong>: To be able to use intelligent retries, Success+ needs to be enabled in [GoCardless dashboard](https://manage.gocardless.com/success-plus). </p>"
                    },
                    "scheme": {
                      "type": "string",
                      "nullable": true,
                      "description": "A bank payment scheme. Currently \"ach\", \"autogiro\", \"bacs\", \"becs\", \"becs_nz\", \"betalingsservice\", \"faster_payments\", \"pad\", \"pay_to\", \"sepa_core\", \"sepa_credit_transfer\" and \"sepa_instant_credit_transfer\" are supported.",
                      "example": "bacs"
                    }
                  }
                }
              },
              "payouts": {
                "type": "array",
                "description": "A list of payouts linked to the events returned in the list of events.",
                "items": {
                  "type": "object",
                  "description": "Payouts represent transfers from GoCardless to a [creditor](#core-endpoints-creditors). Each payout contains the funds collected from one or many [payments](#core-endpoints-payments). All the payments in a payout will have been collected in the same currency. Payouts are created automatically after a payment has been successfully collected.",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier, beginning with \"PO\".",
                      "example": "PO123"
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                      "example": "2014-01-01T12:00:00.000Z",
                      "format": "date-time"
                    },
                    "amount": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Amount in minor unit (e.g. pence in GBP, cents in EUR).",
                      "example": 1000
                    },
                    "deducted_fees": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Fees that have already been deducted from the payout amount in minor unit (e.g. pence in GBP, cents in EUR), inclusive of tax if applicable.\n<br />\nFor each `late_failure_settled` or `chargeback_settled` action, we refund the transaction fees in a payout. This means that a payout can have a negative `deducted_fees` value.\n<br />\nThis field is calculated as `(GoCardless fees + app fees + surcharge fees) - (refunded fees)`\n<br />\nIf the merchant is invoiced for fees separately from the payout, then `deducted_fees` will be 0.",
                      "example": 20
                    },
                    "currency": {
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                      "example": "EUR",
                      "enum": [
                        "AUD",
                        "CAD",
                        "DKK",
                        "EUR",
                        "GBP",
                        "NZD",
                        "SEK",
                        "USD"
                      ],
                      "type": "string"
                    },
                    "reference": {
                      "type": "string",
                      "description": "Reference which appears on the creditor's bank statement.",
                      "example": "ref-1"
                    },
                    "status": {
                      "description": "One of:\n\n- `pending`: the payout has been created, but not yet sent to your bank or it is in the process of being exchanged through our FX provider.\n- `paid`: the payout has been sent to the your bank. FX payouts will become `paid` after we emit the `fx_rate_confirmed` webhook.\n- `bounced`: the payout bounced when sent, the payout can be retried.",
                      "example": "pending",
                      "enum": [
                        "pending",
                        "paid",
                        "bounced"
                      ],
                      "type": "string"
                    },
                    "payout_type": {
                      "description": "Whether a payout contains merchant revenue or partner fees.",
                      "example": "merchant",
                      "enum": [
                        "merchant",
                        "partner"
                      ],
                      "type": "string"
                    },
                    "arrival_date": {
                      "type": "string",
                      "nullable": true,
                      "description": "Date the payout is due to arrive in the creditor's bank account.\nOne of:\n\n- `yyyy-mm-dd`: the payout has been paid and is due to arrive in the creditor's bank account on this day\n- `null`: the payout hasn't been paid yet\n",
                      "example": "2014-01-01"
                    },
                    "links": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "creditor": {
                          "type": "string",
                          "description": "ID of [creditor](#core-endpoints-creditors) who will receive this payout, i.e. the owner of the `creditor_bank_account`.",
                          "example": "CR123"
                        },
                        "creditor_bank_account": {
                          "type": "string",
                          "description": "ID of [bank account](#core-endpoints-creditor-bank-accounts) which this will be sent to.",
                          "example": "BA123"
                        }
                      }
                    },
                    "fx": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "exchange_rate": {
                          "type": "string",
                          "nullable": true,
                          "description": "Rate used in the foreign exchange of the `amount` into the `fx_currency`.\nPresent only after a resource is paid out. Has up to 10 decimal places.",
                          "example": "1.1234567890"
                        },
                        "estimated_exchange_rate": {
                          "type": "string",
                          "nullable": true,
                          "description": "Estimated rate that will be used in the foreign exchange of the `amount` into the `fx_currency`.\nThis will vary based on the prevailing market rate until the moment that it is paid out.\nPresent only before a resource is paid out. Has up to 10 decimal places.",
                          "example": "1.1234567890"
                        },
                        "fx_amount": {
                          "oneOf": [
                            {
                              "type": "string",
                              "nullable": true
                            },
                            {
                              "type": "integer"
                            }
                          ],
                          "description": "Amount that was paid out in the `fx_currency` after foreign exchange.\nPresent only after the resource has been paid out.",
                          "example": 1150
                        },
                        "fx_currency": {
                          "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) code for the currency in which amounts will be paid out (after foreign exchange). Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported. Present only if payouts will be (or were) made via foreign exchange.",
                          "example": "EUR",
                          "enum": [
                            "AUD",
                            "CAD",
                            "DKK",
                            "EUR",
                            "GBP",
                            "NZD",
                            "SEK",
                            "USD"
                          ],
                          "nullable": true,
                          "type": "string"
                        }
                      }
                    },
                    "tax_currency": {
                      "type": "string",
                      "nullable": true,
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) code for the currency in which tax is paid out to the tax authorities of your tax jurisdiction. Currently “EUR”, “GBP”, for French or British merchants, this will be `null` if tax is not applicable <em>beta</em>",
                      "example": "EUR"
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters. _Note:_ This should not be used for storing PII data.",
                      "example": {
                        "salesforce_id": "ABCD1234"
                      }
                    }
                  }
                }
              },
              "refunds": {
                "type": "array",
                "description": "A list of refunds linked to the events returned in the list of events.",
                "items": {
                  "type": "object",
                  "description": "Refund objects represent (partial) refunds of a [payment](#core-endpoints-payments) back to the [customer](#core-endpoints-customers).\n\nGoCardless will notify you via a [webhook](#appendix-webhooks) whenever a refund is created, and will update the `amount_refunded` property of the payment.",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier, beginning with \"RF\".",
                      "example": "RF123"
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                      "example": "2014-01-01T12:00:00.000Z",
                      "format": "date-time"
                    },
                    "amount": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Amount in minor unit (e.g. pence in GBP, cents in EUR).",
                      "example": 150
                    },
                    "currency": {
                      "type": "string",
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. This is set to the currency of the refund's [payment](#core-endpoints-payments).",
                      "example": "EUR"
                    },
                    "status": {
                      "description": "One of:\n\n- `created`: the refund has been created\n- `pending_submission`: the refund has been created, but not yet submitted to the banks\n- `submitted`: the refund has been submitted to the banks\n- `paid`:  the refund has been included in a [payout](#core-endpoints-payouts)\n- `cancelled`: the refund has been cancelled\n- `bounced`: the refund has failed to be paid\n- `funds_returned`: the refund has had its funds returned",
                      "example": "submitted",
                      "enum": [
                        "created",
                        "pending_submission",
                        "submitted",
                        "paid",
                        "cancelled",
                        "bounced",
                        "funds_returned"
                      ],
                      "type": "string"
                    },
                    "reference": {
                      "type": "string",
                      "nullable": true,
                      "description": "An optional reference that will appear on your customer's bank statement. The character limit for this reference is dependent on the scheme.<br /> <strong>ACH</strong> - 10 characters<br /> <strong>Autogiro</strong> - 11 characters<br /> <strong>Bacs</strong> - 10 characters<br /> <strong>BECS</strong> - 30 characters<br /> <strong>BECS NZ</strong> - 12 characters<br /> <strong>Betalingsservice</strong> - 30 characters<br /> <strong>Faster Payments</strong> - 18 characters<br /> <strong>PAD</strong> - scheme doesn't offer references<br /> <strong>PayTo</strong> - 18 characters<br /> <strong>SEPA</strong> - 140 characters<br /> Note that this reference must be unique (for each merchant) for the BECS scheme as it is a scheme requirement. <p class='restricted-notice'><strong>Restricted</strong>: You can only specify a payment reference for Bacs payments (that is, when collecting from the UK) if you're on the <a href='https://gocardless.com/pricing'>GoCardless Plus, Pro or Enterprise packages</a>.</p> <p class='restricted-notice'><strong>Restricted</strong>: You can not specify a payment reference for Faster Payments.</p>",
                      "example": "WINEBOX001"
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                    },
                    "links": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "payment": {
                          "type": "string",
                          "description": "ID of the [payment](#core-endpoints-payments) against which the refund is being made.",
                          "example": "PM123"
                        },
                        "mandate": {
                          "type": "string",
                          "description": "ID of the [mandate](#core-endpoints-mandates) against which the refund is being made.",
                          "example": "MD123"
                        }
                      }
                    },
                    "fx": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "exchange_rate": {
                          "type": "string",
                          "nullable": true,
                          "description": "Rate used in the foreign exchange of the `amount` into the `fx_currency`.\nPresent only after a resource is paid out. Has up to 10 decimal places.",
                          "example": "1.1234567890"
                        },
                        "estimated_exchange_rate": {
                          "type": "string",
                          "nullable": true,
                          "description": "Estimated rate that will be used in the foreign exchange of the `amount` into the `fx_currency`.\nThis will vary based on the prevailing market rate until the moment that it is paid out.\nPresent only before a resource is paid out. Has up to 10 decimal places.",
                          "example": "1.1234567890"
                        },
                        "fx_amount": {
                          "oneOf": [
                            {
                              "type": "string",
                              "nullable": true
                            },
                            {
                              "type": "integer"
                            }
                          ],
                          "description": "Amount that was paid out in the `fx_currency` after foreign exchange.\nPresent only after the resource has been paid out.",
                          "example": 1150
                        },
                        "fx_currency": {
                          "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) code for the currency in which amounts will be paid out (after foreign exchange). Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported. Present only if payouts will be (or were) made via foreign exchange.",
                          "example": "EUR",
                          "enum": [
                            "AUD",
                            "CAD",
                            "DKK",
                            "EUR",
                            "GBP",
                            "NZD",
                            "SEK",
                            "USD"
                          ],
                          "nullable": true,
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "subscriptions": {
                "type": "array",
                "description": "A list of subscriptions linked to the events returned in the list of events.",
                "items": {
                  "type": "object",
                  "description": "Subscriptions create [payments](#core-endpoints-payments) according to a schedule.\n\n### Recurrence Rules\n\nThe following rules apply when specifying recurrence:\n\n- If `day_of_month` and `start_date` are not provided `start_date` will be the [mandate](#core-endpoints-mandates)'s `next_possible_charge_date` and the subscription will then recur based on the `interval` & `interval_unit`\n- If `month` or `day_of_month` are present the following validations apply:\n\n| __interval_unit__ | __month__                                      | __day_of_month__                           |\n| :---------------- | :--------------------------------------------- | :----------------------------------------- |\n| yearly            | optional (required if `day_of_month` provided) | optional (invalid if `month` not provided) |\n| monthly           | invalid                                        | optional                                   |\n| weekly            | invalid                                        | invalid                                    |\n\nExamples:\n\n| __interval_unit__ | __interval__ | __month__ | __day_of_month__ | valid?                                             |\n| :---------------- | :----------- | :-------- | :--------------- | :------------------------------------------------- |\n| yearly            | 1            | january   | -1               | valid                                              |\n| monthly           | 6            |           |                  | valid                                              |\n| monthly           | 6            |           | 12               | valid                                              |\n| weekly            | 2            |           |                  | valid                                              |\n| yearly            | 1            | march     |                  | invalid - missing `day_of_month`                   |\n| yearly            | 1            |           | 2                | invalid - missing `month`                          |\n| monthly           | 6            | august    | 12               | invalid - `month` must be blank                    |\n| weekly            | 2            | october   | 10               | invalid - `month` and `day_of_month` must be blank |\n\n### Rolling dates\n\nWhen a charge date falls on a non-business day, one of two things will happen:\n\n- if the recurrence rule specified `-1` as the `day_of_month`, the charge date will be rolled __backwards__ to the previous business day (i.e., the last working day of the month).\n- otherwise the charge date will be rolled __forwards__ to the next business day.",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier, beginning with \"SB\".",
                      "example": "SB123"
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                      "example": "2014-01-01T12:00:00.000Z",
                      "format": "date-time"
                    },
                    "amount": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Amount in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                      "example": 1000
                    },
                    "name": {
                      "type": "string",
                      "nullable": true,
                      "description": "Optional name for the subscription. This will be set as the description on each payment created. Must not exceed 255 characters.",
                      "example": "12 month subscription"
                    },
                    "start_date": {
                      "type": "string",
                      "nullable": true,
                      "description": "The date on which the first payment should be charged. Must be on or after the [mandate](#core-endpoints-mandates)'s `next_possible_charge_date`. When left blank and `month` or `day_of_month` are provided, this will be set to the date of the first payment. If created without `month` or `day_of_month` this will be set as the mandate's `next_possible_charge_date`",
                      "example": "2014-10-21",
                      "format": "date"
                    },
                    "end_date": {
                      "type": "string",
                      "nullable": true,
                      "description": "Date on or after which no further payments should be created.\n<br />\nIf this field is blank and `count` is not specified, the subscription will continue forever.\n<br />\n<p class=\"deprecated-notice\"><strong>Deprecated</strong>: This field will be removed in a future API version. Use <code>count</code> to specify a number of payments instead.</p>",
                      "example": "2015-10-21",
                      "format": "date"
                    },
                    "interval": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Number of `interval_units` between customer charge dates. Must be greater than or equal to `1`. Must result in at least one charge date per year. Defaults to `1`.",
                      "example": 1
                    },
                    "interval_unit": {
                      "description": "The unit of time between customer charge dates. One of `weekly`, `monthly` or `yearly`.",
                      "example": "monthly",
                      "enum": [
                        "weekly",
                        "monthly",
                        "yearly"
                      ],
                      "type": "string"
                    },
                    "day_of_month": {
                      "oneOf": [
                        {
                          "type": "string",
                          "nullable": true
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "As per RFC 2445. The day of the month to charge customers on. `1`-`28` or `-1` to indicate the last day of the month.",
                      "example": 28
                    },
                    "currency": {
                      "type": "string",
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                      "example": "EUR"
                    },
                    "month": {
                      "description": "Name of the month on which to charge a customer. Must be lowercase. Only applies\nwhen the interval_unit is `yearly`.\n",
                      "example": "january",
                      "enum": [
                        "january",
                        "february",
                        "march",
                        "april",
                        "may",
                        "june",
                        "july",
                        "august",
                        "september",
                        "october",
                        "november",
                        "december"
                      ],
                      "nullable": true,
                      "type": "string"
                    },
                    "count": {
                      "oneOf": [
                        {
                          "type": "string",
                          "nullable": true
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "The total number of payments that should be taken by this subscription.",
                      "example": 5
                    },
                    "payment_reference": {
                      "type": "string",
                      "nullable": true,
                      "description": "An optional payment reference. This will be set as the reference on each payment\ncreated and will appear on your customer's bank statement. See the documentation for\nthe [create payment endpoint](#payments-create-a-payment) for more details.\n<br />\n<p class=\"restricted-notice\"><strong>Restricted</strong>: You need your own Service User Number to specify a payment reference for Bacs payments.</p>",
                      "example": "GOLDPLAN"
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                    },
                    "status": {
                      "type": "string",
                      "description": "One of:\n\n- `pending_customer_approval`: the subscription is waiting for customer approval before becoming active\n- `customer_approval_denied`: the customer did not approve the subscription\n- `active`: the subscription is currently active and will continue to create payments\n- `finished`: all of the payments scheduled for creation under this subscription have been created\n- `cancelled`: the subscription has been cancelled and will no longer create payments\n- `paused`: the subscription has been paused and will not create payments",
                      "example": "active",
                      "enum": [
                        "pending_customer_approval",
                        "customer_approval_denied",
                        "active",
                        "finished",
                        "cancelled",
                        "paused"
                      ]
                    },
                    "upcoming_payments": {
                      "type": "array",
                      "description": "Up to 10 upcoming payments with their amounts and charge dates.",
                      "example": [
                        {
                          "amount": 2500,
                          "charge_date": "2014-11-03"
                        }
                      ],
                      "items": {
                        "type": "object",
                        "properties": {
                          "charge_date": {
                            "type": "string",
                            "description": "The date on which this payment will be charged.",
                            "example": "2014-11-03",
                            "format": "date"
                          },
                          "amount": {
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "integer"
                              }
                            ],
                            "description": "The amount of this payment, in minor unit (e.g. pence in GBP, cents in EUR).",
                            "example": "2500"
                          }
                        }
                      }
                    },
                    "app_fee": {
                      "oneOf": [
                        {
                          "type": "string",
                          "nullable": true
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "The amount to be deducted from each payment as an app fee, to be paid to the partner integration which created the subscription, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                      "example": 100
                    },
                    "links": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "mandate": {
                          "type": "string",
                          "description": "ID of the associated [mandate](#core-endpoints-mandates) which the subscription will create payments against.",
                          "example": "MD123"
                        }
                      }
                    },
                    "retry_if_possible": {
                      "type": "boolean",
                      "description": "On failure, automatically retry payments using [intelligent retries](/success-plus/overview). Default is `false`. <p class=\"notice\"><strong>Important</strong>: To be able to use intelligent retries, Success+ needs to be enabled in [GoCardless dashboard](https://manage.gocardless.com/success-plus). </p>"
                    },
                    "earliest_charge_date_after_resume": {
                      "type": "string",
                      "nullable": true,
                      "description": "The earliest date that will be used as a `charge_date` on payments\ncreated for this subscription if it is resumed. Only present for `paused` subscriptions.\nThis value will change over time.",
                      "example": "2014-11-03",
                      "format": "date"
                    },
                    "parent_plan_paused": {
                      "type": "boolean",
                      "description": "Whether the parent plan of this subscription is paused."
                    }
                  }
                }
              },
              "scheme_identifiers": {
                "type": "array",
                "description": "A list of scheme identifiers linked to the events returned in the list of events.",
                "items": {
                  "type": "object",
                  "description": "This represents a scheme identifier (e.g. a SUN in Bacs or a CID in SEPA). Scheme identifiers are used to specify the beneficiary name that appears on customers' bank statements.\n",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier, usually beginning with \"SU\".",
                      "example": "SU123"
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                      "example": "2014-01-01T12:00:00.000Z",
                      "format": "date-time"
                    },
                    "name": {
                      "type": "string",
                      "description": "The name which appears on customers' bank statements. This should usually be the merchant's trading name."
                    },
                    "scheme": {
                      "description": "The scheme which this scheme identifier applies to.",
                      "example": "bacs",
                      "enum": [
                        "ach",
                        "autogiro",
                        "bacs",
                        "becs",
                        "becs_nz",
                        "betalingsservice",
                        "faster_payments",
                        "pad",
                        "pay_to",
                        "sepa",
                        "sepa_credit_transfer",
                        "sepa_instant_credit_transfer"
                      ],
                      "type": "string"
                    },
                    "reference": {
                      "type": "string",
                      "description": "The scheme-unique identifier against which payments are submitted."
                    },
                    "status": {
                      "description": "The status of the scheme identifier. Only `active` scheme identifiers will be applied to a creditor and used against payments.",
                      "example": "pending",
                      "enum": [
                        "pending",
                        "active"
                      ],
                      "type": "string"
                    },
                    "minimum_advance_notice": {
                      "type": "integer",
                      "description": "The minimum interval, in working days, between the sending of a pre-notification to the customer, and the charge date of a payment using this scheme identifier.\n\nBy default, GoCardless sends these notifications automatically. Please see our [compliance requirements](#appendix-compliance-requirements) for more details.",
                      "example": 3
                    },
                    "can_specify_mandate_reference": {
                      "type": "boolean",
                      "description": "Whether a custom reference can be submitted for mandates using this scheme identifier."
                    },
                    "currency": {
                      "description": "The currency of the scheme identifier.",
                      "example": "EUR",
                      "enum": [
                        "AUD",
                        "CAD",
                        "DKK",
                        "EUR",
                        "GBP",
                        "NZD",
                        "SEK",
                        "USD"
                      ],
                      "type": "string"
                    },
                    "address_line1": {
                      "type": "string",
                      "description": "The first line of the scheme identifier's support address.",
                      "example": "221B Baker Street"
                    },
                    "address_line2": {
                      "type": "string",
                      "nullable": true,
                      "description": "The second line of the scheme identifier's support address.",
                      "example": "Marylebone"
                    },
                    "address_line3": {
                      "type": "string",
                      "nullable": true,
                      "description": "The third line of the scheme identifier's support address.",
                      "example": "City of Westminster"
                    },
                    "city": {
                      "type": "string",
                      "description": "The city of the scheme identifier's support address.",
                      "example": "London"
                    },
                    "region": {
                      "type": "string",
                      "nullable": true,
                      "description": "The scheme identifier's support address region, county or department.",
                      "example": "Greater London"
                    },
                    "postal_code": {
                      "type": "string",
                      "description": "The scheme identifier's support postal code.",
                      "example": "NW1 6XE"
                    },
                    "country_code": {
                      "type": "string",
                      "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                      "example": "GB"
                    },
                    "email": {
                      "type": "string",
                      "description": "Scheme identifier's support email address.",
                      "example": "user@example.com"
                    },
                    "phone_number": {
                      "type": "string",
                      "description": "Scheme identifier's support phone number.",
                      "example": "+44 20 1234 1234"
                    }
                  }
                }
              },
              "customers": {
                "type": "array",
                "description": "A list of customers linked to the events returned in the list of events.",
                "items": {
                  "type": "object",
                  "description": "Customer objects hold the contact details for a customer. A customer can have several [customer bank accounts](#core-endpoints-customer-bank-accounts), which in turn can have several Direct Debit [mandates](#core-endpoints-mandates).",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier, beginning with \"CU\".",
                      "example": "CU123"
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                      "example": "2014-01-01T12:00:00.000Z",
                      "format": "date-time"
                    },
                    "email": {
                      "type": "string",
                      "nullable": true,
                      "description": "Customer's email address. Required in most cases, as this allows GoCardless to send notifications to this customer.",
                      "example": "user@example.com"
                    },
                    "given_name": {
                      "type": "string",
                      "nullable": true,
                      "description": "Customer's first name. Required unless a `company_name` is provided.",
                      "example": "Frank"
                    },
                    "family_name": {
                      "type": "string",
                      "nullable": true,
                      "description": "Customer's surname. Required unless a `company_name` is provided.",
                      "example": "Osborne"
                    },
                    "company_name": {
                      "type": "string",
                      "nullable": true,
                      "description": "Customer's company name. Required unless a `given_name` and `family_name` are provided. For Canadian customers, the use of a `company_name` value will mean that any mandate created from this customer will be considered to be a \"Business PAD\" (otherwise, any mandate will be considered to be a \"Personal PAD\").",
                      "example": "Hamilton Trading Ltd."
                    },
                    "address_line1": {
                      "type": "string",
                      "nullable": true,
                      "description": "The first line of the customer's address.",
                      "example": "221B Baker Street"
                    },
                    "address_line2": {
                      "type": "string",
                      "nullable": true,
                      "description": "The second line of the customer's address.",
                      "example": "Marylebone"
                    },
                    "address_line3": {
                      "type": "string",
                      "nullable": true,
                      "description": "The third line of the customer's address.",
                      "example": "City of Westminster"
                    },
                    "city": {
                      "type": "string",
                      "nullable": true,
                      "description": "The city of the customer's address.",
                      "example": "London"
                    },
                    "region": {
                      "type": "string",
                      "nullable": true,
                      "description": "The customer's address region, county or department. For US customers a 2 letter [ISO3166-2:US](https://en.wikipedia.org/wiki/ISO_3166-2:US) state code is required (e.g. `CA` for California).",
                      "example": "Greater London"
                    },
                    "postal_code": {
                      "type": "string",
                      "nullable": true,
                      "description": "The customer's postal code.",
                      "example": "NW1 6XE"
                    },
                    "country_code": {
                      "type": "string",
                      "nullable": true,
                      "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                      "example": "GB"
                    },
                    "language": {
                      "type": "string",
                      "nullable": true,
                      "description": "[ISO 639-1](https://en.wikipedia.org/wiki/List_of_ISO_639-1_codes) code. Used as the language for notification emails sent by GoCardless if your organisation does not send its own (see [compliance requirements](#appendix-compliance-requirements)). Currently only \"en\", \"fr\", \"de\", \"pt\", \"es\", \"it\", \"nl\", \"da\", \"nb\", \"sl\", \"sv\" are supported. If this is not provided, the language will be chosen based on the `country_code` (if supplied) or default to \"en\".",
                      "example": "en"
                    },
                    "phone_number": {
                      "type": "string",
                      "nullable": true,
                      "description": "[ITU E.123](https://en.wikipedia.org/wiki/E.123) formatted phone number, including country code.",
                      "example": "+64 4 817 9999"
                    },
                    "swedish_identity_number": {
                      "type": "string",
                      "nullable": true,
                      "description": "For Swedish customers only. The civic/company number (personnummer, samordningsnummer, or organisationsnummer) of the customer. Must be supplied if the customer's bank account is denominated in Swedish krona (SEK). This field cannot be changed once it has been set.",
                      "example": "556564-5404"
                    },
                    "danish_identity_number": {
                      "type": "string",
                      "nullable": true,
                      "description": "For Danish customers only. The civic/company number (CPR or CVR) of the customer. Must be supplied if the customer's bank account is denominated in Danish krone (DKK).",
                      "example": "220550-6218"
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                    }
                  }
                }
              }
            }
          }
        }
      },
      "export": {
        "type": "object",
        "title": "Exports",
        "description": "File-based exports of data",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier, beginning with \"EX\".",
            "example": "EX123"
          },
          "created_at": {
            "type": "string",
            "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
            "example": "2014-01-01T12:00:00.000Z",
            "format": "date-time"
          },
          "export_type": {
            "description": "The type of the export",
            "example": "payments_index",
            "enum": [
              "payments_index",
              "events_index",
              "refunds_index",
              "payouts_index",
              "customers_index",
              "subscriptions_index",
              "payment_events",
              "subscription_events",
              "payout_events",
              "refund_events",
              "mandate_events",
              "payout_events_breakdown",
              "payout_events_reconciliation",
              "payout_transactions_breakdown",
              "payout_transactions_reconciliation",
              "authorisation_requests",
              "customer_bank_accounts",
              "users",
              "organisation_authorisations",
              "gc_invalid_authorisation_requests",
              "partner_fees",
              "payments_import_template",
              "payment_account_statement",
              "outbound_payments_index",
              "payment_account_transactions"
            ],
            "type": "string"
          },
          "download_url": {
            "type": "string",
            "nullable": true,
            "description": "Download url for the export file. Subject to expiry."
          },
          "currency": {
            "type": "string",
            "description": "The currency of the export (if applicable)",
            "example": "GBP"
          },
          "error_message": {
            "type": "string",
            "nullable": true,
            "description": "Error message if the export encountered an error during processing."
          }
        }
      },
      "export_id": {
        "type": "string",
        "title": "ExportId",
        "description": "Unique identifier, beginning with \"EX\".",
        "example": "EX123"
      },
      "export_identity": {
        "type": "string",
        "title": "ExportIdentity",
        "description": "Unique identifier, beginning with \"EX\".",
        "example": "EX123"
      },
      "export_created_at": {
        "type": "string",
        "title": "ExportCreatedAt",
        "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
        "example": "2014-01-01T12:00:00.000Z",
        "format": "date-time"
      },
      "export_currency": {
        "type": "string",
        "title": "ExportCurrency",
        "description": "The currency of the export (if applicable)",
        "example": "GBP"
      },
      "export_export_type": {
        "title": "ExportExportType",
        "description": "The type of the export",
        "example": "payments_index",
        "enum": [
          "payments_index",
          "events_index",
          "refunds_index",
          "payouts_index",
          "customers_index",
          "subscriptions_index",
          "payment_events",
          "subscription_events",
          "payout_events",
          "refund_events",
          "mandate_events",
          "payout_events_breakdown",
          "payout_events_reconciliation",
          "payout_transactions_breakdown",
          "payout_transactions_reconciliation",
          "authorisation_requests",
          "customer_bank_accounts",
          "users",
          "organisation_authorisations",
          "gc_invalid_authorisation_requests",
          "partner_fees",
          "payments_import_template",
          "payment_account_statement",
          "outbound_payments_index",
          "payment_account_transactions"
        ],
        "type": "string"
      },
      "export_download_url": {
        "type": "string",
        "nullable": true,
        "title": "ExportDownloadUrl",
        "description": "Download url for the export file. Subject to expiry."
      },
      "export_error_message": {
        "type": "string",
        "nullable": true,
        "title": "ExportErrorMessage",
        "description": "Error message if the export encountered an error during processing."
      },
      "export_pagination_meta": {
        "type": "object",
        "title": "ExportPaginationMeta",
        "description": "Cursor pagination information",
        "properties": {
          "limit": {
            "type": "integer",
            "example": 50
          },
          "cursors": {
            "type": "object",
            "properties": {
              "before": {
                "type": "string",
                "nullable": true,
                "description": "Cursor pointing to the end of the desired set."
              },
              "after": {
                "type": "string",
                "nullable": true,
                "description": "Cursor pointing to the start of the desired set."
              }
            }
          }
        }
      },
      "export_single_resource_response": {
        "type": "object",
        "title": "ExportSingleResourceResponse",
        "description": "",
        "properties": {
          "exports": {
            "type": "object",
            "description": "File-based exports of data",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier, beginning with \"EX\".",
                "example": "EX123"
              },
              "created_at": {
                "type": "string",
                "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                "example": "2014-01-01T12:00:00.000Z",
