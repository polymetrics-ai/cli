      "mandate_pdf": {
        "type": "object",
        "title": "Mandate PDFs",
        "description": "Mandate PDFs allow you to easily display [scheme-rules compliant](#appendix-compliance-requirements) Direct Debit mandates to your customers.",
        "properties": {
          "url": {
            "type": "string",
            "description": "The URL at which this mandate PDF can be viewed until it expires at the date and time specified by `expires_at`. You should not store this URL or rely on its structure remaining the same.",
            "example": "https://api.gocardless.com/mandate_pdfs/wLJKzbG12uqcDly7t6L2"
          },
          "expires_at": {
            "type": "string",
            "description": "The date and time at which the `url` will expire (10 minutes after the original request).",
            "example": "2014-01-01T12:00:00.000Z",
            "format": "date-time"
          }
        }
      },
      "mandate_pdf_scheme": {
        "type": "string",
        "nullable": true,
        "title": "MandatePdfScheme",
        "description": "Direct Debit scheme. Can be supplied or automatically detected from the bank account details provided. If you do not provide a scheme, you must provide either a mandate, an `iban`, or [local details](#appendix-local-bank-details) including a `country_code`.",
        "example": "bacs"
      },
      "mandate_pdf_iban": {
        "type": "string",
        "nullable": true,
        "title": "MandatePdfIban",
        "description": "International Bank Account Number. Alternatively you can provide [local details](#appendix-local-bank-details). IBANs cannot be provided for Autogiro mandates."
      },
      "mandate_pdf_bic": {
        "type": "string",
        "nullable": true,
        "title": "MandatePdfBic",
        "description": "SWIFT BIC. Will be derived automatically if a valid `iban` or [local details](#appendix-local-bank-details) are provided."
      },
      "mandate_pdf_account_number": {
        "type": "string",
        "nullable": true,
        "title": "MandatePdfAccountNumber",
        "description": "Bank account number - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`.",
        "example": "55779912"
      },
      "mandate_pdf_bank_code": {
        "type": "string",
        "nullable": true,
        "title": "MandatePdfBankCode",
        "description": "Bank code - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`.",
        "example": "20041"
      },
      "mandate_pdf_branch_code": {
        "type": "string",
        "nullable": true,
        "title": "MandatePdfBranchCode",
        "description": "Branch code - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`.",
        "example": "01005"
      },
      "mandate_pdf_country_code": {
        "type": "string",
        "nullable": true,
        "title": "MandatePdfCountryCode",
        "description": "[ISO 3166-1](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements) alpha-2 code. Required if providing local details."
      },
      "mandate_pdf_account_holder_name": {
        "type": "string",
        "nullable": true,
        "title": "MandatePdfAccountHolderName",
        "description": "Name of the account holder, as known by the bank. Usually this matches the name of the [customer](#core-endpoints-customers). This field cannot exceed 18 characters.",
        "example": "Lando Calrissian"
      },
      "mandate_pdf_given_name": {
        "type": "string",
        "nullable": true,
        "title": "MandatePdfGivenName",
        "description": "The customer's given name (i.e. first name). Used to populate the \"Customer Name or Company name\" field on the PDF. Ignored if `company_name` is provided.",
        "example": "Lando"
      },
      "mandate_pdf_family_name": {
        "type": "string",
        "nullable": true,
        "title": "MandatePdfFamilyName",
        "description": "The customer's family name (i.e. last name). Used to populate the \"Customer Name or Company name\" field on the PDF. Ignored if `company_name` is provided.",
        "example": "Calrissian"
      },
      "mandate_pdf_company_name": {
        "type": "string",
        "nullable": true,
        "title": "MandatePdfCompanyName",
        "description": "The customer's company name. Used to populate the \"Customer Name or Company name\" field on the PDF.",
        "example": "Lando Corp"
      },
      "mandate_pdf_phone_number": {
        "type": "string",
        "nullable": true,
        "title": "MandatePdfPhoneNumber",
        "description": "The customer phone number. Should only be provided for BECS NZ mandates.",
        "example": "+64 4 817 9999"
      },
      "mandate_pdf_mandate_reference": {
        "type": "string",
        "nullable": true,
        "title": "MandatePdfMandateReference",
        "description": "Unique 6 to 18 character reference. This may be left blank at the point of signing.",
        "example": "Foo Subscription"
      },
      "mandate_pdf_signature_date": {
        "type": "string",
        "nullable": true,
        "title": "MandatePdfSignatureDate",
        "description": "If provided, a form will be generated with this date and no signature field.",
        "example": "2014-01-18",
        "format": "date"
      },
      "mandate_pdf_swedish_identity_number": {
        "type": "string",
        "nullable": true,
        "title": "MandatePdfSwedishIdentityNumber",
        "description": "For Swedish customers only. The civic/company number (personnummer, samordningsnummer, or organisationsnummer) of the customer. Should only be supplied for Autogiro mandates.",
        "example": "556564-5404"
      },
      "mandate_pdf_danish_identity_number": {
        "type": "string",
        "nullable": true,
        "title": "MandatePdfDanishIdentityNumber",
        "description": "For Danish customers only. The civic/company number (CPR or CVR) of the customer. Should only be supplied for Betalingsservice mandates.",
        "example": "220550-6218"
      },
      "mandate_pdf_url": {
        "type": "string",
        "title": "MandatePdfUrl",
        "description": "The URL at which this mandate PDF can be viewed until it expires at the date and time specified by `expires_at`. You should not store this URL or rely on its structure remaining the same.",
        "example": "https://api.gocardless.com/mandate_pdfs/wLJKzbG12uqcDly7t6L2"
      },
      "mandate_pdf_expires_at": {
        "type": "string",
        "title": "MandatePdfExpiresAt",
        "description": "The date and time at which the `url` will expire (10 minutes after the original request).",
        "example": "2014-01-01T12:00:00.000Z",
        "format": "date-time"
      },
      "mandate_pdf_account_type": {
        "title": "MandatePdfAccountType",
        "description": "Bank account type. Required for USD-denominated bank accounts. Must not be provided for bank accounts in other currencies. See [local details](#local-bank-details-united-states) for more information.",
        "example": "savings",
        "enum": [
          "savings",
          "checking"
        ],
        "nullable": true,
        "type": "string"
      },
      "mandate_pdf_payer_ip_address": {
        "type": "string",
        "nullable": true,
        "title": "MandatePdfPayerIpAddress",
        "description": "For American customers only. IP address of the computer used by the customer to set up the mandate. This is required in order to create compliant Mandate PDFs according to the ACH scheme rules.",
        "example": "127.0.0.1"
      },
      "mandate_pdf_subscription_amount": {
        "oneOf": [
          {
            "type": "string",
            "nullable": true
          },
          {
            "type": "integer"
          }
        ],
        "title": "MandatePdfSubscriptionAmount",
        "description": "For American customers only. Subscription amount being authorised by the mandate. In the lowest denomination for the currency (cents in USD). Is required if `subscription_frequency` has been provided.",
        "example": "5000"
      },
      "mandate_pdf_subscription_frequency": {
        "type": "string",
        "nullable": true,
        "title": "MandatePdfSubscriptionFrequency",
        "description": "For American customers only. Frequency of the subscription being authorised by the mandate. One of `weekly`, `monthly` or `yearly`. Is required if `subscription_amount` has been provided.",
        "example": "monthly",
        "enum": [
          "weekly",
          "monthly",
          "yearly"
        ]
      },
      "mandate_pdf_single_resource_response": {
        "type": "object",
        "title": "MandatePdfSingleResourceResponse",
        "description": "",
        "properties": {
          "mandate_pdfs": {
            "type": "object",
            "description": "Mandate PDFs allow you to easily display [scheme-rules compliant](#appendix-compliance-requirements) Direct Debit mandates to your customers.",
            "properties": {
              "url": {
                "type": "string",
                "description": "The URL at which this mandate PDF can be viewed until it expires at the date and time specified by `expires_at`. You should not store this URL or rely on its structure remaining the same.",
                "example": "https://api.gocardless.com/mandate_pdfs/wLJKzbG12uqcDly7t6L2"
              },
              "expires_at": {
                "type": "string",
                "description": "The date and time at which the `url` will expire (10 minutes after the original request).",
                "example": "2014-01-01T12:00:00.000Z",
                "format": "date-time"
              }
            }
          }
        }
      },
      "negative_balance_limit": {
        "type": "object",
        "title": "Negative Balance Limit",
        "description": "The negative balance limit is a threshold for the creditor balance beyond which refunds are not permitted. The default limit is zero — refunds are not permitted if the creditor has a negative balance. The limit can be changed on a per-creditor basis.\n",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier, beginning with \"NBL\".",
            "example": "NBL123"
          },
          "created_at": {
            "type": "string",
            "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this limit was created.",
            "example": "2014-01-01T12:00:00.000Z",
            "format": "date-time"
          },
          "balance_limit": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "description": "The limit amount in pence (e.g. 10000 for a -100 GBP limit).",
            "example": 10000
          },
          "currency": {
            "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
            "example": "EUR",
            "enum": [
              "AUD",
              "CAD",
              "DKK",
              "EUR",
              "GBP",
              "NZD",
              "SEK",
              "USD"
            ],
            "type": "string"
          },
          "links": {
            "type": "object",
            "description": "",
            "properties": {
              "creator_user": {
                "type": "string",
                "description": "ID of the creator_user who created this limit",
                "example": "US123"
              },
              "creditor": {
                "type": "string",
                "description": "ID of [creditor](#core-endpoints-creditors) which this limit relates to",
                "example": "CR123"
              }
            }
          }
        }
      },
      "negative_balance_limit_id": {
        "type": "string",
        "title": "NegativeBalanceLimitId",
        "description": "Unique identifier, beginning with \"NBL\".",
        "example": "NBL123"
