    "/refunds": {
      "post": {
        "operationId": "create_refund",
        "summary": "Create a refund",
        "description": "Creates a new refund object.\n\nThis fails with:<a name=\"total_amount_confirmation_invalid\"></a><a name=\"number_of_refunds_exceeded\"></a><a name=\"available_refund_amount_insufficient\"></a>\n\n- `total_amount_confirmation_invalid` if the confirmation amount doesn't match the total amount refunded for the payment. This safeguard is there to prevent two processes from creating refunds without awareness of each other.\n\n- `available_refund_amount_insufficient` if the creditor does not have sufficient balance for refunds available to cover the cost of the requested refund.\n\n\n<p class=\"restricted-notice\"><strong>Restricted</strong>: This endpoint is disabled by default. To enable it, you will need to enable refunds on your GoCardless Dashboard.</p>\n\n<p class=\"notice--warning\"><strong>Warning</strong>: A payment that has been (partially) refunded can still receive a late failure or chargeback from the customer's bank.<br /><br />\nA refund can only be created once it is outside the safer refund period (7 calendar days after the charge date) otherwise an error is returned. The safer refund period can be disabled by contacting GoCardless.</p>",
        "tags": [
          "Refund"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GoCardlessVersionHeader"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/refund_single_resource_response"
                }
              }
            },
            "description": "Resource created successfully"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refunds": {
                    "type": "object",
                    "properties": {
                      "amount": {
                        "$ref": "#/components/schemas/refund_amount"
                      },
                      "reference": {
                        "$ref": "#/components/schemas/refund_reference"
                      },
                      "total_amount_confirmation": {
                        "$ref": "#/components/schemas/refund_total_amount_confirmation"
                      },
                      "metadata": {
                        "$ref": "#/components/schemas/customer_metadata"
                      },
                      "links": {
                        "type": "object",
                        "description": "",
                        "properties": {
                          "payment": {
                            "type": "string",
                            "description": "ID of the [payment](#core-endpoints-payments) against which the refund is being made.",
                            "example": "PM123"
                          },
                          "mandate": {
                            "allOf": [
                              {
                                "$ref": "#/components/schemas/refund"
                              },
                              {
                                "description": " ID of the [mandate](#core-endpoints-mandates) against which the refund is being made. <br /> <p class=\"restricted-notice\"><strong>Restricted</strong>: You must request access to Mandate Refunds by contacting <a href=\"mailto:support@gocardless.com\">our support team</a>.</p>"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "Ruby",
            "label": "Ruby",
            "source": "@client.refunds.create(\n  params: {\n    amount: 100,\n    total_amount_confirmation: 150,\n    reference: \"Service refund\",\n    metadata: { reason: \"Late delivery\" },\n    links: { payment: \"PM123\"}\n  }\n)"
          },
          {
            "lang": "Python",
            "label": "Python",
            "source": "client.refunds.create(params={\n  \"amount\": 100,\n  \"total_amount_confirmation\": 150,\n  \"reference\": \"Acme refund\",\n  \"metadata\": {\n    \"reason\": \"late delivery\"\n  },\n  \"links\": {\n    \"payment\": \"PM123\"\n  }\n})"
          },
          {
            "lang": "JavaScript",
            "label": "JavaScript",
            "source": "const refund = await client.refunds.create({\n  amount: \"100\",\n  total_amount_confirmation: \"150\",\n  reference: \"Acme refund\",\n  metadata: {\n    reason: \"late delivery\"\n  },\n  links: {\n    payment: \"PM123\"\n  }\n});"
          },
          {
            "lang": "PHP",
            "label": "PHP",
            "source": "$client->refunds()->create([\n  \"params\" => [\"amount\" => 100,\n               \"total_amount_confirmation\" => 150,\n               \"reference\" => \"Acme refund\",\n               \"metadata\" => [\"reason\" => \"Late delivery\"],\n               \"links\" => [\"payment\" => \"PM123\"]]\n]);"
          },
          {
            "lang": "Java",
            "label": "Java",
            "source": "client.refunds().create()\n  .withAmount(100)\n  .withTotalAmountConfirmation(150)\n  .withReference(\"Acme refund\")\n  .withMetadata(\"reason\", \"late delivery\")\n  .withLinksPayment(\"PM123\")\n  .execute();"
          },
          {
            "lang": "Go",
            "label": "Go",
            "source": "refundCreateParams := gocardless.RefundCreateParams{\n  Amount:                  100,\n  TotalAmountConfirmation: 150,\n  Reference:               \"Acme refund\",\n  Metadata:                map[string]string{\"reason\": \"late delivery\"},\n  Links: gocardless.RefundCreateParamsLinks{\n    Payment: \"PM123\",\n  },\n}\n\nrefund, err := client.Refunds.Create(ctx, refundCreateParams)"
          },
          {
            "lang": "C#",
            "label": ".NET",
            "source": "var refundRequest = new GoCardless.Services.RefundCreateRequest()\n{\n    Amount = 100,\n    TotalAmountConfirmation = 150,\n    Reference = \"Partial refund\",\n    Links = new GoCardless.Services.RefundCreateRequest.RefundLinks()\n    {\n        Payment = \"PM0123\"\n    }\n};\nvar refundResponse = await client.Refunds.CreateAsync(refundRequest);\nGoCardless.Resources.Refund refund = refundResponse.Refund;"
          },
          {
            "lang": "HTTP",
            "label": "HTTP",
            "source": "POST https://api.gocardless.com/refunds HTTP/1.1\nContent-Type: application/json\n{\n  \"refunds\": {\n    \"amount\": 100,\n    \"total_amount_confirmation\": 150,\n    \"reference\": \"Acme refund\",\n    \"metadata\": {\n      \"reason\": \"late delivery\"\n    },\n    \"links\": {\n      \"payment\": \"PM123\"\n    }\n  }\n}\n\nHTTP/1.1 201 Created\nLocation: /payments/RF123\nContent-Type: application/json\n{\n  \"refunds\": {\n    \"id\": \"RF123\",\n    \"created_at\": \"2014-05-08T17:01:06.000Z\",\n    \"amount\": 100,\n    \"currency\": \"GBP\",\n    \"reference\": \"Acme refund\",\n    \"fx\": {\n      \"fx_currency\": \"EUR\",\n      \"fx_amount\": null,\n      \"exchange_rate\": null,\n      \"estimated_exchange_rate\": \"1.1234567890\"\n    },\n    \"status\": \"created\",\n    \"metadata\": {\n      \"reason\": \"late delivery\"\n    },\n    \"links\": {\n      \"payment\": \"PM123\"\n    }\n  }\n}\n\n// Or, if the creditor does not have a sufficient balance to create the refund:\nHTTP/1.1 422 Validation Failed\nContent-Type: application/json\n{\n  \"error\": {\n    \"message\": \"It’s not possible to process this refund because you don’t have enough funds in GBP. Your available refund amount for payments in GBP is: 0.9 GBP\",\n    \"errors\": [\n        {\n            \"reason\": \"available_refund_amount_insufficient\",\n            \"message\": \"It’s not possible to process this refund because you don’t have enough funds in GBP. Your available refund amount for payments in GBP is: 0.9 GBP\",\n            \"metadata\": {\n              \"available_refund_amount\": 90\n            }\n        }\n    ],\n    \"documentation_url\": \"https://developer.gocardless.com/api-reference#available_refund_amount_insufficient\",\n    \"type\": \"validation_failed\",\n    \"request_id\": \"...\",\n    \"code\": 422\n  }\n}"
          }
        ]
      },
