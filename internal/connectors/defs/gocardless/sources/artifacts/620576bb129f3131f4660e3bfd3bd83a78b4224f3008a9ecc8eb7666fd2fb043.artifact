                          },
                          "retry_if_possible": {
                            "$ref": "#/components/schemas/subscription_retry_if_possible"
                          }
                        }
                      },
                      "instalment_schedule_request": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "$ref": "#/components/schemas/instalment_schedule_name"
                          },
                          "currency": {
