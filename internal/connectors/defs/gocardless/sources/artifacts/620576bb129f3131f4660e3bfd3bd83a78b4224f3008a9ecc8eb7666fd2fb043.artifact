      },
      "billing_request": {
        "type": "object",
        "title": "Billing Requests",
        "description": " Billing Requests help create resources that require input or action from a customer. An example of required input might be additional customer billing details, while an action would be asking a customer to authorise a payment using their mobile banking app.\n\nSee [Billing Requests: Overview](https://developer.gocardless.com/getting-started/billing-requests/overview/) for how-to's, explanations and tutorials. <p class=\"notice\"><strong>Important</strong>: All properties associated with `subscription_request` and `instalment_schedule_request` are only supported for ACH and PAD schemes.</p>",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier, beginning with \"BRQ\".",
            "example": "BRQ123"
          },
          "purpose_code": {
            "description": "Specifies the high-level purpose/category of a mandate and/or payment using a set of pre-defined categories. Provides context on the nature and reason for the payment to facilitate processing and compliance.\nSee [Billing Request Purpose Codes](https://developer.gocardless.com/billing-request-purpose-codes/) for the complete list of valid codes.",
            "enum": [
              "mortgage",
              "utility",
              "loan",
              "dependant_support",
              "gambling",
              "retail",
              "salary",
              "personal",
              "government",
              "pension",
              "tax",
              "other",
              "bonus_payment",
              "cash_management_transfer",
              "card_bulk_clearing",
              "credit_card_payment",
              "trade_settlement_payment",
              "debit_card_payment",
              "dividend",
              "deliver_against_payment",
              "epayment",
              "fee_collection_and_interest",
              "fee_collection",
              "person_to_person_payment",
              "government_payment",
              "hedging_transaction",
              "irrevocable_credit_card_payment",
              "irrevocable_debit_card_payment",
              "intra_company_payment",
              "interest",
              "lockbox_transactions",
              "commercial",
              "consumer",
              "other_payment",
              "pension_payment",
              "represented",
              "reimbursement_received_credit_transfer",
              "receive_against_payment",
              "salary_payment",
              "securities",
              "social_security_benefit",
              "supplier_payment",
              "tax_payment",
              "trade",
              "treasury_payment",
              "value_added_tax_payment",
              "with_holding",
              "cash_management_sweep_account",
              "cash_management_top_account",
              "cash_management_zero_balance_account",
              "crossborder_mi_payments",
              "foreign_currency_domestic_transfer",
              "cash_in_pre_credit",
              "cash_out_notes_coins",
              "carrier_guarded_wholesale_valuables"
            ],
            "type": "string"
          },
          "payment_purpose_code": {
            "type": "string",
            "description": "Specifies the underlying purpose of the payment. Defines the specific reason or type of service/goods the payment relates to, improving straight-through processing and compliance.\nSee [VRP Commercial Payment Purpose Codes](https://developer.gocardless.com/vrp-commercial-payment-purpose-codes/) for the complete list of valid codes."
          },
          "payment_context_code": {
            "description": "Specifies the context or scenario in which the payment is being made. Defines whether the payment is for advance/arrears billing, point of sale transactions, ecommerce, or account transfers. This helps banks and payment processors understand the payment scenario and apply appropriate processing rules and risk controls.",
            "enum": [
              "billing_goods_and_services_in_advance",
              "billing_goods_and_services_in_arrears",
              "face_to_face_point_of_sale",
              "ecommerce_merchant_initiated_payment",
              "transfer_to_self",
              "transfer_to_third_party"
            ],
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
            "example": "2015-01-01T12:00:00.000Z",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "description": "One of:\n\n- `pending`: the billing request is pending and can be used\n- `ready_to_fulfil`: the billing request is ready to fulfil\n- `fulfilling`: the billing request is currently undergoing fulfilment\n- `fulfilled`: the billing request has been fulfilled and a payment created\n- `cancelled`: the billing request has been cancelled and cannot be used",
            "example": "pending",
            "enum": [
              "pending",
              "ready_to_fulfil",
              "fulfilling",
              "fulfilled",
              "cancelled"
            ]
          },
          "metadata": {
            "type": "object",
            "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
          },
          "mandate_request": {
            "type": "object",
            "nullable": true,
            "description": "Request for a mandate",
            "properties": {
              "description": {
                "type": "string",
                "nullable": true,
                "description": "A human-readable description of the payment and/or mandate. This will be displayed to the payer when authorising the billing request.\n",
                "example": "Top-up Payment"
              },
              "currency": {
                "type": "string",
                "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code.",
                "example": "GBP"
              },
              "scheme": {
                "type": "string",
                "nullable": true,
                "description": "A bank payment scheme. Currently \"ach\", \"autogiro\", \"bacs\", \"becs\", \"becs_nz\", \"betalingsservice\", \"faster_payments\", \"pad\", \"pay_to\" and \"sepa_core\" are supported. Optional for mandate only requests - if left blank, the payer will be able to select the currency/scheme to pay with from a list of your available schemes.",
                "example": "bacs"
              },
              "sweeping": {
                "type": "boolean",
                "description": "If true, this billing request would be used to set up a mandate solely for moving (or sweeping) money from one account owned by the payer to another account that the payer also owns. This is required for Faster Payments"
              },
              "verify": {
                "description": "Verification preference for the mandate. One of:\n\n- `minimum`: only verify if absolutely required, such as when part of scheme rules\n- `recommended`: in addition to `minimum`, use the GoCardless payment intelligence solution to decide if a payer should be verified\n- `when_available`: if verification mechanisms are available, use them\n- `always`: as `when_available`, but fail to create the Billing Request if a mechanism isn't available\n\nBy default, all Billing Requests use the `recommended` verification preference. It uses GoCardless payment intelligence solution to determine if a payer is fraudulent or not. The verification mechanism is based on the response and the payer may be asked to verify themselves. If the feature is not available, `recommended` behaves like `minimum`.\n\nIf you never wish to take advantage of our reduced risk products and Verified Mandates as they are released in new schemes, please use the `minimum` verification preference.\n\nSee [Billing Requests: Creating Verified Mandates](https://developer.gocardless.com/getting-started/billing-requests/verified-mandates/)\nfor more information.",
                "enum": [
                  "minimum",
                  "recommended",
                  "when_available",
                  "always"
                ],
                "type": "string"
              },
              "links": {
                "type": "object",
                "description": "",
                "properties": {
                  "mandate": {
                    "type": "string",
                    "description": "(Optional) ID of the [mandate](#core-endpoints-mandates) that was created from this mandate request. this mandate request.\n"
                  }
                }
              },
              "metadata": {
                "type": "object",
                "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
              },
              "consent_type": {
                "type": "string",
                "nullable": true,
                "description": "This attribute represents the authorisation type between the payer and merchant. It can be set to `one_off`,\n`recurring` or `standing` for ACH scheme. And `single`, `recurring` and `sporadic` for PAD scheme. _Note:_ This is only supported for ACH and PAD schemes.\n"
              },
              "constraints": {
                "type": "object",
                "nullable": true,
                "description": "Constraints that will apply to the mandate_request. (Optional) Specifically required for PayTo and VRP.",
                "properties": {
                  "start_date": {
                    "type": "string",
                    "description": "The date from which payments can be taken.\n\nThis is an optional field and if it is not supplied the start date will be set to the day\nauthorisation happens.\n"
                  },
                  "end_date": {
                    "type": "string",
                    "description": "The latest date at which payments can be taken, must occur after start_date if present\n\nThis is an optional field and if it is not supplied the agreement will be considered open and\nwill not have an end date. Keep in mind the end date must take into account how long it will\ntake the user to set up this agreement via the Billing Request.\n"
                  },
                  "max_amount_per_payment": {
                    "type": "integer",
                    "description": "The maximum amount that can be charged for a single payment in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR). _Note:_ Required for PayTo and VRP."
                  },
                  "payment_method": {
                    "type": "string",
                    "description": "A constraint where you can specify info (free text string) about how payments are calculated. For use when payments vary and cannot be expressed as a fixed amount and frequency. _Note:_ This is only supported for ACH and PAD schemes.\n"
                  },
                  "periodic_limits": {
                    "type": "array",
                    "description": "Caps on the total amount and/or number of payments that can be collected within a\nrepeating period (e.g. no more than a set amount per month), as opposed to\n`max_amount_per_payment` which caps a single payment.\n\n_Note:_ Required for VRP, where exactly one periodic limit must be provided. Optional for\nPayTo.\n",
                    "items": {
                      "type": "object",
                      "properties": {
                        "period": {
                          "description": "The repeating period for this mandate. Required whenever a periodic limit is provided\n(for both VRP and PayTo). If periodic_limits is omitted entirely for PayTo, this\ndefaults to flexible.\n",
                          "enum": [
                            "day",
                            "week",
                            "month",
                            "year",
                            "flexible"
                          ],
                          "type": "string"
                        },
                        "max_total_amount": {
                          "type": "integer",
                          "description": "The maximum total amount that can be charged for all payments in this periodic limit,\nin the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\n_Note:_ Required for VRP. This is not permitted for the PayTo scheme.\n"
                        },
                        "max_payments": {
                          "type": "integer",
                          "description": "The maximum number of payments that can be collected in this periodic limit.\n\n_Note:_ Only supported for the PayTo scheme, where it is optional.\n"
                        },
                        "alignment": {
                          "description": "The alignment of the period. Defaults to `creation_date` if not specified.\n\n`calendar` - the period follows fixed calendar boundaries, the same for every mandate:\n`week` runs Monday to Sunday, `month` runs from the 1st to the last day of the calendar\nmonth, and `year` runs from 1 January to 31 December. If the mandate starts partway\nthrough a period, the limit for that first period is reduced proportionally to the days\nremaining (e.g. a monthly limit starting on the 15th gives roughly half the limit for\nthat first month).\n\n`creation_date` - the period follows the mandate's own start date rather than the\ncalendar. For example, if the mandate starts on the 15th, each monthly period runs from\nthe 15th to the 14th of the following month. The first period is a full period, not\nreduced proportionally.\n\n_Note:_ Has no effect when period is `flexible`.\n",
                          "enum": [
                            "calendar",
                            "creation_date"
                          ],
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "payer_requested_dual_signature": {
                "type": "boolean",
                "description": "This attribute can be set to true if the payer has indicated that multiple signatures are required for the mandate. As long as every other Billing Request actions have been completed, the payer will receive an email notification containing instructions on how to complete the additional signature. The dual signature flow can only be completed using GoCardless branded pages."
              },
              "authorisation_source": {
                "description": "This field is ACH specific, sometimes referred to as [SEC code](https://www.moderntreasury.com/learn/sec-codes).\n\nThis is the way that the payer gives authorisation to the merchant.\n  web: Authorisation is Internet Initiated or via Mobile Entry (maps to SEC code: WEB)\n  telephone: Authorisation is provided orally over telephone (maps to SEC code: TEL)\n  paper: Authorisation is provided in writing and signed, or similarly authenticated (maps to SEC code: PPD)\n",
                "enum": [
                  "web",
                  "telephone",
                  "paper"
                ],
                "type": "string"
              },
              "funds_settlement": {
                "description": "This field will decide how GoCardless handles settlement of funds from the customer.\n\n- `managed` will be moved through GoCardless' account, batched, and payed out.\n- `direct` will be a direct transfer from the payer's account to the merchant where\n  invoicing will be handled separately.\n",
                "enum": [
                  "managed",
                  "direct"
                ],
                "type": "string"
              }
            }
          },
          "payment_request": {
            "type": "object",
            "nullable": true,
            "description": "Request for a one-off strongly authorised payment",
            "properties": {
              "description": {
                "type": "string",
                "nullable": true,
                "description": "A human-readable description of the payment and/or mandate. This will be displayed to the payer when authorising the billing request.\n",
                "example": "Top-up Payment"
              },
              "currency": {
                "type": "string",
                "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. `GBP` and `EUR` supported; `GBP` with your customers in the UK and for `EUR` with your customers in supported Eurozone countries only.",
                "example": "GBP"
              },
              "scheme": {
                "type": "string",
                "nullable": true,
                "description": "(Optional) A scheme used for Open Banking payments. Currently `faster_payments` is supported in the UK (GBP) and `sepa_credit_transfer` and `sepa_instant_credit_transfer` are supported in supported Eurozone countries (EUR). For Eurozone countries, `sepa_credit_transfer` is used as the default. Please be aware that `sepa_instant_credit_transfer` may incur an additional fee for your customer.",
                "example": "faster_payments"
              },
              "amount": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "description": "Amount in minor unit (e.g. pence in GBP, cents in EUR).",
                "example": 1000
              },
              "links": {
                "type": "object",
                "description": "",
                "properties": {
                  "payment": {
                    "type": "string",
                    "description": "(Optional) ID of the [payment](#core-endpoints-payments) that was created from this payment request."
                  }
                }
              },
              "app_fee": {
                "oneOf": [
                  {
                    "type": "string",
                    "nullable": true
                  },
                  {
                    "type": "integer"
                  }
                ],
                "description": "The amount to be deducted from the payment as an app fee, to be paid to the partner integration which created the billing request, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                "example": 100
              },
              "metadata": {
                "type": "object",
                "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
              },
              "reference": {
                "type": "string",
                "nullable": true,
                "description": "A custom payment reference defined by the merchant. It is only available for payments on the PayTo scheme or payments using the Direct Funds settlement model on the Faster Payments scheme.\n",
                "example": "some-custom-ref"
              },
              "funds_settlement": {
                "description": "This field will decide how GoCardless handles settlement of funds from the customer.\n\n- `managed` will be moved through GoCardless' account, batched, and payed out.\n- `direct` will be a direct transfer from the payer's account to the merchant where\n  invoicing will be handled separately.\n",
                "enum": [
                  "managed",
                  "direct"
                ],
                "type": "string"
              }
            }
          },
          "subscription_request": {
            "type": "object",
            "nullable": true,
            "description": "Request for a subscription",
            "properties": {
              "amount": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "description": "Amount in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                "example": 1000
              },
              "currency": {
                "type": "string",
                "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"USD\" and \"CAD\" are supported.",
                "example": "USD"
              },
              "interval_unit": {
                "description": "The unit of time between customer charge dates. One of `weekly`, `monthly` or `yearly`.",
                "example": "monthly",
                "enum": [
                  "weekly",
                  "monthly",
                  "yearly"
                ],
                "type": "string"
              },
              "interval": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "description": "Number of `interval_units` between customer charge dates. Must be greater than or equal to `1`. Must result in at least one charge date per year. Defaults to `1`.",
                "example": 1
              },
              "app_fee": {
                "oneOf": [
                  {
                    "type": "string",
                    "nullable": true
                  },
                  {
                    "type": "integer"
                  }
                ],
                "description": "The amount to be deducted from each payment as an app fee, to be paid to the partner integration which created the subscription, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                "example": 100
              },
              "count": {
                "oneOf": [
                  {
                    "type": "string",
                    "nullable": true
                  },
                  {
                    "type": "integer"
                  }
                ],
                "description": "The total number of payments that should be taken by this subscription.",
                "example": 5
              },
              "day_of_month": {
                "oneOf": [
                  {
                    "type": "string",
                    "nullable": true
                  },
                  {
                    "type": "integer"
                  }
                ],
                "description": "As per RFC 2445. The day of the month to charge customers on. `1`-`28` or `-1` to indicate the last day of the month.",
                "example": 28
              },
              "metadata": {
                "type": "object",
                "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
              },
              "links": {
                "type": "object",
                "description": "",
                "properties": {
                  "subscription": {
                    "type": "string",
                    "description": "(Optional) ID of the [subscription](#core-endpoints-subscriptions) that was created from this subscription request.\n"
                  }
                }
              },
              "month": {
                "description": "Name of the month on which to charge a customer. Must be lowercase. Only applies\nwhen the interval_unit is `yearly`.\n",
                "example": "january",
                "enum": [
                  "january",
                  "february",
                  "march",
                  "april",
                  "may",
                  "june",
                  "july",
                  "august",
                  "september",
                  "october",
                  "november",
                  "december"
                ],
                "nullable": true,
                "type": "string"
              },
              "name": {
                "type": "string",
                "nullable": true,
                "description": "Optional name for the subscription. This will be set as the description on each payment created. Must not exceed 255 characters.",
                "example": "12 month subscription"
              },
              "payment_reference": {
                "type": "string",
                "nullable": true,
                "description": "An optional payment reference. This will be set as the reference on each payment\ncreated and will appear on your customer's bank statement. See the documentation for\nthe [create payment endpoint](#payments-create-a-payment) for more details.\n<br />",
                "example": "GOLDPLAN"
              },
              "start_date": {
                "type": "string",
                "nullable": true,
                "description": "The date on which the first payment should be charged. If fulfilled after this date, this will be set as the mandate's `next_possible_charge_date`.\nWhen left blank and `month` or `day_of_month` are provided, this will be set to the date of the first payment.\nIf created without `month` or `day_of_month` this will be set as the mandate's `next_possible_charge_date`.\n",
                "example": "2014-10-21",
                "format": "date"
              },
              "retry_if_possible": {
                "type": "boolean",
                "description": "On failure, automatically retry payments using [intelligent retries](/success-plus/overview). Default is `false`. <p class=\"notice\"><strong>Important</strong>: To be able to use intelligent retries, Success+ needs to be enabled in [GoCardless dashboard](https://manage.gocardless.com/success-plus). </p>"
              }
            }
          },
          "instalment_schedule_request": {
            "type": "object",
            "nullable": true,
            "description": "Request for an instalment schedule. Has to contain either `instalments_with_schedule` object or an array of `instalments_with_dates` objects",
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of the instalment schedule, up to 100 chars. This name will also be\ncopied to the payments of the instalment schedule if you use schedule-based creation.",
                "example": "Invoice 4404"
              },
              "currency": {
                "type": "string",
                "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"USD\" and \"CAD\" are supported.",
                "example": "USD"
              },
              "total_amount": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "description": "The total amount of the instalment schedule, defined as the sum of all individual\npayments, in the lowest denomination for the currency (e.g. pence in GBP, cents in\nEUR). If the requested payment amounts do not sum up correctly, a validation error\nwill be returned.",
                "example": 1000
              },
              "payment_reference": {
                "type": "string",
                "nullable": true,
                "description": "An optional payment reference. This will be set as the reference on each payment\ncreated and will appear on your customer's bank statement. See the documentation for\nthe [create payment endpoint](#payments-create-a-payment) for more details.\n<br />",
                "example": "GOLDPLAN"
              },
              "app_fee": {
                "oneOf": [
                  {
                    "type": "string",
                    "nullable": true
                  },
                  {
                    "type": "integer"
                  }
                ],
                "description": "The amount to be deducted from each payment as an app fee, to be paid to the partner integration which created the subscription, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                "example": 100
              },
              "instalments_with_dates": {
                "type": "array",
                "nullable": true,
                "description": "An explicit array of instalment payments, each specifying at least an `amount` and `charge_date`. See [create (with dates)](#instalment-schedules-create-with-dates)",
                "example": [
                  {
                    "amount": 250,
                    "charge_date": "2020-11-03"
                  }
                ],
                "items": {
                  "type": "object",
                  "properties": {
                    "amount": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\nMinimum and maximum amounts vary by payment scheme. For more information, see [Transaction limits](https://support.gocardless.com/hc/en-gb/articles/115000309245-Transaction-limits)\n\nFor Variable Recurring Payments (VRP), this must not exceed the mandate's `max_amount_per_payment`\nconstraint.",
                      "example": 1000
                    },
                    "charge_date": {
                      "type": "string",
                      "nullable": true,
                      "description": "A future date on which the payment should be collected. If the date\nis before the next_possible_charge_date on the\n[mandate](#core-endpoints-mandates), it will be automatically rolled\nforwards to that date.",
                      "example": "2014-05-21",
                      "format": "date"
                    },
                    "description": {
                      "type": "string",
                      "nullable": true,
                      "description": "A human-readable description of the payment. This will be included in the notification email GoCardless sends to your customer if your organisation does not send its own notifications (see [compliance requirements](#appendix-compliance-requirements)).",
                      "example": "One-off upgrade fee"
                    }
                  }
                }
              },
              "instalments_with_schedule": {
                "type": "object",
                "nullable": true,
                "description": "Frequency of the payments you want to create, together with an array of payment\namounts to be collected, with a specified start date for the first payment.\nSee [create (with schedule)](#instalment-schedules-create-with-schedule)\n",
                "properties": {
                  "start_date": {
                    "type": "string",
                    "nullable": true,
                    "description": "The date on which the first payment should be charged. Must be on or after the [mandate](#core-endpoints-mandates)'s `next_possible_charge_date`. When left blank and `month` or `day_of_month` are provided, this will be set to the date of the first payment. If created without `month` or `day_of_month` this will be set as the mandate's `next_possible_charge_date`",
                    "example": "2014-10-21",
                    "format": "date"
                  },
                  "interval": {
                    "type": "integer",
                    "description": "Number of `interval_units` between charge dates. Must be greater than or\nequal to `1`.\n",
                    "example": 1
                  },
                  "interval_unit": {
                    "description": "The unit of time between customer charge dates. One of `weekly`, `monthly` or `yearly`.",
                    "example": "monthly",
                    "enum": [
                      "weekly",
                      "monthly",
                      "yearly"
                    ],
                    "type": "string"
                  },
                  "amounts": {
                    "type": "array",
                    "description": "List of amounts of each instalment, in the lowest denomination for the\ncurrency (e.g. cents in USD).\n",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\nMinimum and maximum amounts vary by payment scheme. For more information, see [Transaction limits](https://support.gocardless.com/hc/en-gb/articles/115000309245-Transaction-limits)\n\nFor Variable Recurring Payments (VRP), this must not exceed the mandate's `max_amount_per_payment`\nconstraint.",
                      "example": 1000
                    }
                  }
                }
              },
              "metadata": {
                "type": "object",
                "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
              },
              "links": {
                "type": "object",
                "description": "",
                "properties": {
                  "instalment_schedule": {
                    "type": "string",
                    "description": "(Optional) ID of the [instalment_schedule](#core-endpoints-instalment-schedules) that was created from this instalment schedule request.\n"
                  }
                }
              },
              "retry_if_possible": {
                "type": "boolean",
                "description": "On failure, automatically retry payments using [intelligent retries](/success-plus/overview). Default is `false`. <p class=\"notice\"><strong>Important</strong>: To be able to use intelligent retries, Success+ needs to be enabled in [GoCardless dashboard](https://manage.gocardless.com/success-plus). </p>"
              }
            }
          },
          "actions": {
            "type": "array",
            "description": "List of actions that can be performed before this billing request can be fulfilled.",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Unique identifier for the action.",
                  "example": "collect_bank_account",
                  "enum": [
                    "choose_currency",
                    "collect_amount",
                    "collect_customer_details",
                    "collect_bank_account",
                    "bank_authorisation",
                    "confirm_payer_details",
                    "select_institution"
                  ]
                },
                "status": {
                  "type": "string",
                  "description": "Status of the action",
                  "example": "pending",
                  "enum": [
                    "pending",
                    "completed"
                  ]
                },
                "required": {
                  "type": "boolean",
                  "description": "Informs you whether the action is required to fulfil the billing request or not.",
                  "example": true
                },
                "completes_actions": {
                  "type": "array",
                  "description": "Which other action types this action can complete.",
                  "example": [
                    "collect_bank_account"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "requires_actions": {
                  "type": "array",
                  "description": "Requires completing these actions before this action can be completed.",
                  "example": [
                    "collect_bank_account"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "bank_authorisation": {
                  "type": "object",
                  "description": "Describes the behaviour of bank authorisations, for the bank_authorisation action",
                  "properties": {
                    "adapter": {
                      "type": "string",
                      "description": "Which authorisation adapter will be used to power these authorisations (GoCardless internal use only)",
                      "enum": [
                        "open_banking_gateway_pis",
                        "open_banking_gateway_ais",
                        "bankid_ais",
                        "bank_pay_recurring"
                      ]
                    },
                    "authorisation_type": {
                      "type": "string",
                      "description": "What type of bank authorisations are supported on this billing request",
                      "enum": [
                        "payment",
                        "mandate"
                      ]
                    }
                  }
                },
                "collect_customer_details": {
                  "type": "object",
                  "description": "Additional parameters to help complete the collect_customer_details action",
                  "properties": {
                    "default_country_code": {
                      "type": "string",
                      "description": "Default customer country code, as determined by scheme and payer location"
                    },
                    "incomplete_fields": {
                      "type": "object",
                      "properties": {
                        "customer": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "description": "A customer field that needs to be collected"
                          }
                        },
                        "customer_billing_detail": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "description": "A customer_billing_detail field that needs to be collected"
                          }
                        }
                      }
                    }
                  }
                },
                "available_currencies": {
                  "type": "array",
                  "description": "List of currencies the current mandate supports",
                  "items": {
                    "type": "string",
                    "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code.",
                    "example": "GBP"
                  }
                },
                "institution_guess_status": {
                  "type": "string",
                  "description": "Describes whether we inferred the institution from the provided bank account details. One of:\n- `not_needed`: we won't attempt to infer the institution as it is not needed. Either because it was manually selected or the billing request does not support this feature\n- `pending`: we are waiting on the bank details in order to infer the institution\n- `failed`: we weren't able to infer the institution\n- `success`: we inferred the institution and added it to the resources of a Billing Request\n",
                  "example": "pending",
                  "enum": [
                    "not_needed",
                    "pending",
                    "failed",
                    "success"
                  ]
                }
              }
            }
          },
          "resources": {
            "type": "object",
            "description": "",
            "properties": {
              "customer": {
                "type": "object",
                "description": "Embedded customer",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Unique identifier, beginning with \"CU\".",
                    "example": "CU123"
                  },
                  "created_at": {
                    "type": "string",
                    "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                    "example": "2014-01-01T12:00:00.000Z",
                    "format": "date-time"
                  },
                  "email": {
                    "type": "string",
                    "nullable": true,
                    "description": "Customer's email address. Required in most cases, as this allows GoCardless to send notifications to this customer.",
                    "example": "user@example.com"
                  },
                  "given_name": {
                    "type": "string",
                    "nullable": true,
                    "description": "Customer's first name. Required unless a `company_name` is provided.",
                    "example": "Frank"
                  },
                  "family_name": {
                    "type": "string",
                    "nullable": true,
                    "description": "Customer's surname. Required unless a `company_name` is provided.",
                    "example": "Osborne"
                  },
                  "company_name": {
                    "type": "string",
                    "nullable": true,
                    "description": "Customer's company name. Required unless a `given_name` and `family_name` are provided. For Canadian customers, the use of a `company_name` value will mean that any mandate created from this customer will be considered to be a \"Business PAD\" (otherwise, any mandate will be considered to be a \"Personal PAD\").",
                    "example": "Hamilton Trading Ltd."
                  },
                  "language": {
                    "type": "string",
                    "nullable": true,
                    "description": "[ISO 639-1](https://en.wikipedia.org/wiki/List_of_ISO_639-1_codes) code. Used as the language for notification emails sent by GoCardless if your organisation does not send its own (see [compliance requirements](#appendix-compliance-requirements)). Currently only \"en\", \"fr\", \"de\", \"pt\", \"es\", \"it\", \"nl\", \"da\", \"nb\", \"sl\", \"sv\" are supported. If this is not provided, the language will be chosen based on the `country_code` (if supplied) or default to \"en\".",
                    "example": "en"
                  },
                  "phone_number": {
                    "type": "string",
                    "nullable": true,
                    "description": "[ITU E.123](https://en.wikipedia.org/wiki/E.123) formatted phone number, including country code.",
                    "example": "+64 4 817 9999"
                  },
                  "metadata": {
                    "type": "object",
                    "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                  }
                }
              },
              "customer_billing_detail": {
                "type": "object",
                "description": "Embedded customer billing detail",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Unique identifier, beginning with \"CU\".",
                    "example": "CU123"
                  },
                  "schemes": {
                    "type": "array",
                    "description": "The schemes associated with this customer billing detail",
                    "items": {
                      "type": "string"
                    }
                  },
                  "created_at": {
                    "type": "string",
                    "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                    "example": "2014-01-01T12:00:00.000Z",
                    "format": "date-time"
                  },
                  "address_line1": {
                    "type": "string",
                    "nullable": true,
                    "description": "The first line of the customer's address.",
                    "example": "221B Baker Street"
                  },
                  "address_line2": {
                    "type": "string",
                    "nullable": true,
                    "description": "The second line of the customer's address.",
                    "example": "Marylebone"
                  },
                  "address_line3": {
                    "type": "string",
                    "nullable": true,
                    "description": "The third line of the customer's address.",
                    "example": "City of Westminster"
                  },
                  "city": {
                    "type": "string",
                    "nullable": true,
                    "description": "The city of the customer's address.",
                    "example": "London"
                  },
                  "region": {
                    "type": "string",
                    "nullable": true,
                    "description": "The customer's address region, county or department. For US customers a 2 letter [ISO3166-2:US](https://en.wikipedia.org/wiki/ISO_3166-2:US) state code is required (e.g. `CA` for California).",
                    "example": "Greater London"
                  },
                  "postal_code": {
                    "type": "string",
                    "nullable": true,
                    "description": "The customer's postal code.",
                    "example": "NW1 6XE"
                  },
                  "country_code": {
                    "type": "string",
                    "nullable": true,
                    "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                    "example": "GB"
                  },
                  "swedish_identity_number": {
                    "type": "string",
                    "nullable": true,
                    "description": "For Swedish customers only. The civic/company number (personnummer, samordningsnummer, or organisationsnummer) of the customer. Must be supplied if the customer's bank account is denominated in Swedish krona (SEK). This field cannot be changed once it has been set.",
                    "example": "556564-5404"
                  },
                  "danish_identity_number": {
                    "type": "string",
                    "nullable": true,
                    "description": "For Danish customers only. The civic/company number (CPR or CVR) of the customer. Must be supplied if the customer's bank account is denominated in Danish krone (DKK).",
                    "example": "220550-6218"
                  },
                  "ip_address": {
                    "type": "string",
                    "nullable": true,
                    "description": "For ACH customers only. Required for ACH customers. A string containing the IP address of the payer to whom the mandate belongs (i.e. as a result of their completion of a mandate setup flow in their browser).\n\nNot required for creating offline mandates where `authorisation_source` is set to telephone or paper.\n",
                    "example": "127.0.0.1"
                  }
                }
              },
              "customer_bank_account": {
                "type": "object",
                "nullable": true,
                "description": "Embedded customer bank account, only if a bank account is linked",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Unique identifier, beginning with \"BA\".",
                    "example": "BA123"
                  },
                  "created_at": {
                    "type": "string",
                    "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                    "example": "2014-01-01T12:00:00.000Z",
                    "format": "date-time"
                  },
                  "account_holder_name": {
                    "type": "string",
                    "description": "Name of the account holder, as known by the bank. The full name provided when the customer is created is stored and is available via the API, but is transliterated, upcased, and truncated to 18 characters in bank submissions. This field is required unless the request includes a [customer bank account token](#javascript-flow-customer-bank-account-tokens).",
                    "example": "Billie Jean"
                  },
                  "account_number_ending": {
                    "type": "string",
                    "description": "The last few digits of the account number. Currently 4 digits for NZD bank accounts and 2 digits for other currencies.",
                    "example": "1234"
                  },
                  "account_type": {
                    "description": "Bank account type. Required for USD-denominated bank accounts. Must not be provided for bank accounts in other currencies. See [local details](#local-bank-details-united-states) for more information.",
                    "example": "savings",
                    "enum": [
                      "savings",
                      "checking"
                    ],
                    "nullable": true,
                    "type": "string"
                  },
                  "country_code": {
                    "type": "string",
                    "nullable": true,
                    "description": "[ISO 3166-1 alpha-2 code](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements). Defaults to the country code of the `iban` if supplied, otherwise is required.",
                    "example": "GB"
                  },
                  "currency": {
                    "type": "string",
                    "nullable": true,
                    "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                    "example": "EUR"
                  },
                  "bank_name": {
                    "type": "string",
                    "description": "Name of bank, taken from the bank details.",
                    "example": "BARCLAYS BANK PLC"
                  },
                  "enabled": {
                    "type": "boolean",
                    "description": "Boolean value showing whether the bank account is enabled or disabled.",
                    "example": true
                  },
                  "metadata": {
                    "type": "object",
                    "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                  },
                  "links": {
                    "type": "object",
                    "description": "",
                    "properties": {
                      "customer": {
                        "type": "string",
                        "description": "ID of the [customer](#core-endpoints-customers) that owns this bank account."
                      }
                    }
                  },
                  "bank_account_token": {
                    "type": "string",
                    "nullable": true,
                    "description": "A token to uniquely refer to a set of bank account details. This feature is still in early access and is only available for certain organisations.",
                    "example": "bat_f975ab3c-ecee-47a1-9590-5bb1d56fa113"
                  },
                  "payer_name_verification_result": {
                    "type": "string",
                    "description": "The result of the payer name verification check performed when the bank account was created. Only present if a check was performed.\n\n- `full`: The name provided matches the name held by the bank.\n- `close`: The name provided is a close but not exact match to the name held by the bank.\n- `cannot_perform_verification`: A verification was attempted but could not be completed. This can happen for a number of reasons, including the account holder's bank not participating in the verification scheme, the account not being eligible for verification (e.g. the account holder has opted out), or the bank details not being resolvable, among others.",
                    "example": "full",
                    "enum": [
                      "full",
                      "close",
                      "cannot_perform_verification"
                    ]
                  }
                }
              }
            }
          },
          "links": {
            "type": "object",
            "description": "",
            "properties": {
              "customer": {
                "type": "string",
                "description": "ID of the [customer](#core-endpoints-customers) that will be used for this request",
                "example": "CU123"
              },
              "customer_billing_detail": {
                "type": "string",
                "description": "ID of the customer billing detail that will be used for this request"
              },
              "creditor": {
                "type": "string",
                "description": "ID of the associated [creditor](#core-endpoints-creditors).",
                "example": "CR123"
              },
              "organisation": {
                "type": "string",
                "description": "ID of the associated organisation.",
                "example": "OR123"
              },
              "customer_bank_account": {
                "type": "string",
                "description": "(Optional) ID of the [customer_bank_account](#core-endpoints-customer-bank-accounts) that will be used for this request",
                "example": "BA123"
              },
              "bank_authorisation": {
                "type": "string",
                "description": "(Optional) ID of the [bank authorisation](#billing-requests-bank-authorisations) that was used to verify this request."
              },
              "payment_request": {
                "type": "string",
                "description": "(Optional) ID of the associated payment request",
                "example": "PRQ123"
              },
              "payment_request_payment": {
                "type": "string",
                "description": "(Optional) ID of the [payment](#core-endpoints-payments) that was created from this payment request.",
                "example": "PM123"
              },
              "mandate_request": {
                "type": "string",
                "description": "(Optional) ID of the associated mandate request",
                "example": "MRQ123"
              },
              "mandate_request_mandate": {
                "type": "string",
                "description": "(Optional) ID of the [mandate](#core-endpoints-mandates) that was created from this mandate request. this mandate request.",
                "example": "MD123"
              },
              "subscription_request": {
                "type": "string",
                "description": "(Optional) ID of the associated subscription request",
                "example": "SBR123"
              },
              "subscription_request_subscription": {
                "type": "string",
                "description": "(Optional) ID of the [subscription](#core-endpoints-subscriptions) that was created from this subscription request.",
                "example": "SB123"
              },
              "instalment_schedule_request": {
                "type": "string",
                "description": "(Optional) ID of the associated instalment schedule request",
                "example": "ISR123"
              },
              "instalment_schedule_request_instalment_schedule": {
                "type": "string",
                "description": "(Optional) ID of the [instalment_schedule](#core-endpoints-instalment-schedules) that was created from this instalment schedule request.",
                "example": "IS123"
              },
              "payment_provider": {
                "type": "string",
                "description": "(Optional) ID of the associated payment provider",
                "example": "PP123"
              }
            }
          },
          "fallback_enabled": {
            "type": "boolean",
            "description": "(Optional) If true, this billing request can fallback from instant payment to direct debit.\nShould not be set if GoCardless payment intelligence feature is used.\n\nSee [Billing Requests: Retain customers with Fallbacks](https://developer.gocardless.com/billing-requests/retain-customers-with-fallbacks/)\nfor more information."
          },
          "fallback_occurred": {
            "type": "boolean",
            "description": "True if the billing request was completed with direct debit."
          }
        }
      },
      "billing_request_country_code": {
        "type": "string",
        "title": "BillingRequestCountryCode",
        "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
        "example": "GB"
      },
      "billing_request_id": {
        "type": "string",
        "title": "BillingRequestId",
        "description": "Unique identifier, beginning with \"BRQ\".",
        "example": "BRQ123"
      },
      "billing_request_identity": {
        "type": "string",
        "title": "BillingRequestIdentity",
        "description": "Unique identifier, beginning with \"BRQ\".",
        "example": "BRQ123"
      },
      "billing_request_created_at": {
        "type": "string",
        "title": "BillingRequestCreatedAt",
        "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
        "example": "2015-01-01T12:00:00.000Z",
        "format": "date-time"
      },
      "billing_request_status": {
        "type": "string",
        "title": "BillingRequestStatus",
        "description": "One of:\n\n- `pending`: the billing request is pending and can be used\n- `ready_to_fulfil`: the billing request is ready to fulfil\n- `fulfilling`: the billing request is currently undergoing fulfilment\n- `fulfilled`: the billing request has been fulfilled and a payment created\n- `cancelled`: the billing request has been cancelled and cannot be used",
        "example": "pending",
        "enum": [
          "pending",
          "ready_to_fulfil",
          "fulfilling",
          "fulfilled",
          "cancelled"
        ]
      },
      "billing_request_fallback_enabled": {
        "type": "boolean",
        "title": "BillingRequestFallbackEnabled",
        "description": "(Optional) If true, this billing request can fallback from instant payment to direct debit.\nShould not be set if GoCardless payment intelligence feature is used.\n\nSee [Billing Requests: Retain customers with Fallbacks](https://developer.gocardless.com/billing-requests/retain-customers-with-fallbacks/)\nfor more information."
      },
      "billing_request_purpose_code": {
        "title": "BillingRequestPurposeCode",
        "description": "Specifies the high-level purpose/category of a mandate and/or payment using a set of pre-defined categories. Provides context on the nature and reason for the payment to facilitate processing and compliance.\nSee [Billing Request Purpose Codes](https://developer.gocardless.com/billing-request-purpose-codes/) for the complete list of valid codes.",
        "enum": [
          "mortgage",
          "utility",
          "loan",
          "dependant_support",
          "gambling",
          "retail",
          "salary",
          "personal",
          "government",
          "pension",
          "tax",
          "other",
          "bonus_payment",
          "cash_management_transfer",
          "card_bulk_clearing",
          "credit_card_payment",
          "trade_settlement_payment",
          "debit_card_payment",
          "dividend",
          "deliver_against_payment",
          "epayment",
          "fee_collection_and_interest",
          "fee_collection",
          "person_to_person_payment",
          "government_payment",
          "hedging_transaction",
          "irrevocable_credit_card_payment",
          "irrevocable_debit_card_payment",
          "intra_company_payment",
          "interest",
          "lockbox_transactions",
          "commercial",
          "consumer",
          "other_payment",
          "pension_payment",
          "represented",
          "reimbursement_received_credit_transfer",
          "receive_against_payment",
          "salary_payment",
          "securities",
          "social_security_benefit",
          "supplier_payment",
          "tax_payment",
          "trade",
          "treasury_payment",
          "value_added_tax_payment",
          "with_holding",
          "cash_management_sweep_account",
          "cash_management_top_account",
          "cash_management_zero_balance_account",
          "crossborder_mi_payments",
          "foreign_currency_domestic_transfer",
          "cash_in_pre_credit",
          "cash_out_notes_coins",
          "carrier_guarded_wholesale_valuables"
        ],
        "type": "string"
      },
      "billing_request_payment_purpose_code": {
        "type": "string",
        "title": "BillingRequestPaymentPurposeCode",
        "description": "Specifies the underlying purpose of the payment. Defines the specific reason or type of service/goods the payment relates to, improving straight-through processing and compliance.\nSee [VRP Commercial Payment Purpose Codes](https://developer.gocardless.com/vrp-commercial-payment-purpose-codes/) for the complete list of valid codes."
      },
      "billing_request_payment_context_code": {
        "title": "BillingRequestPaymentContextCode",
        "description": "Specifies the context or scenario in which the payment is being made. Defines whether the payment is for advance/arrears billing, point of sale transactions, ecommerce, or account transfers. This helps banks and payment processors understand the payment scenario and apply appropriate processing rules and risk controls.",
        "enum": [
          "billing_goods_and_services_in_advance",
          "billing_goods_and_services_in_arrears",
          "face_to_face_point_of_sale",
          "ecommerce_merchant_initiated_payment",
          "transfer_to_self",
          "transfer_to_third_party"
        ],
        "type": "string"
      },
      "billing_request_fallback_occurred": {
        "type": "boolean",
        "title": "BillingRequestFallbackOccurred",
        "description": "True if the billing request was completed with direct debit."
      },
      "billing_request_pay_id": {
        "type": "string",
        "title": "BillingRequestPayId",
        "description": "A unique record such as an email address, mobile number or company number, that can be used to make and accept payments."
      },
      "billing_request_payment_currency": {
        "type": "string",
        "title": "BillingRequestPaymentCurrency",
        "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. `GBP` and `EUR` supported; `GBP` with your customers in the UK and for `EUR` with your customers in supported Eurozone countries only.",
        "example": "GBP"
      },
      "billing_request_payment_scheme": {
        "type": "string",
        "nullable": true,
        "title": "BillingRequestPaymentScheme",
        "description": "(Optional) A scheme used for Open Banking payments. Currently `faster_payments` is supported in the UK (GBP) and `sepa_credit_transfer` and `sepa_instant_credit_transfer` are supported in supported Eurozone countries (EUR). For Eurozone countries, `sepa_credit_transfer` is used as the default. Please be aware that `sepa_instant_credit_transfer` may incur an additional fee for your customer.",
        "example": "faster_payments"
      },
      "billing_request_ach_pad_scheme": {
        "type": "string",
        "nullable": true,
        "title": "BillingRequestAchPadScheme",
        "description": "Payment scheme. Currently supports `ach` in the US (USD) and 'pad' in the Canada (CAD)",
        "example": "ach"
      },
      "billing_request_currency": {
        "type": "string",
        "title": "BillingRequestCurrency",
        "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code.",
        "example": "GBP"
      },
      "billing_request_scheme": {
        "type": "string",
        "nullable": true,
        "title": "BillingRequestScheme",
        "description": "A bank payment scheme. Currently \"ach\", \"autogiro\", \"bacs\", \"becs\", \"becs_nz\", \"betalingsservice\", \"faster_payments\", \"pad\", \"pay_to\" and \"sepa_core\" are supported. Optional for mandate only requests - if left blank, the payer will be able to select the currency/scheme to pay with from a list of your available schemes.",
        "example": "bacs"
      },
      "billing_request_notification_type": {
        "type": "string",
        "title": "BillingRequestNotificationType",
        "description": "Currently, can only be `email`.",
        "example": "email",
        "enum": [
          "email"
        ]
      },
      "billing_request_description": {
        "type": "string",
        "nullable": true,
        "title": "BillingRequestDescription",
        "description": "A human-readable description of the payment and/or mandate. This will be displayed to the payer when authorising the billing request.\n",
        "example": "Top-up Payment"
      },
      "billing_request_ach_pad_currency": {
        "type": "string",
        "title": "BillingRequestAchPadCurrency",
        "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"USD\" and \"CAD\" are supported.",
        "example": "USD"
      },
      "billing_request_charge_date": {
        "type": "string",
        "nullable": true,
        "title": "BillingRequestChargeDate",
        "description": "A future date on which the payment should be collected. If the date\nis before the next_possible_charge_date on the\n[mandate](#core-endpoints-mandates), it will be automatically rolled\nforwards to that date.",
        "example": "2014-05-21",
        "format": "date"
      },
      "billing_request_amount": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          }
        ],
        "title": "BillingRequestAmount",
        "description": "Amount in minor unit (e.g. pence in GBP, cents in EUR).",
        "example": 1000
      },
      "billing_request_app_fee": {
        "oneOf": [
          {
            "type": "string",
            "nullable": true
          },
          {
            "type": "integer"
          }
        ],
        "title": "BillingRequestAppFee",
        "description": "The amount to be deducted from the payment as an app fee, to be paid to the partner integration which created the billing request, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
        "example": 100
      },
      "billing_request_payment_request_links": {
        "type": "object",
        "title": "BillingRequestPaymentRequestLinks",
        "description": "",
        "properties": {
          "payment": {
            "type": "string",
            "description": "(Optional) ID of the [payment](#core-endpoints-payments) that was created from this payment request."
          }
        }
      },
      "billing_request_reference": {
        "type": "string",
        "nullable": true,
        "title": "BillingRequestReference",
        "description": "A custom payment reference defined by the merchant. It is only available for payments on the PayTo scheme or payments using the Direct Funds settlement model on the Faster Payments scheme.\n",
        "example": "some-custom-ref"
      },
      "billing_request_funds_settlement": {
        "title": "BillingRequestFundsSettlement",
        "description": "This field will decide how GoCardless handles settlement of funds from the customer.\n\n- `managed` will be moved through GoCardless' account, batched, and payed out.\n- `direct` will be a direct transfer from the payer's account to the merchant where\n  invoicing will be handled separately.\n",
        "enum": [
          "managed",
          "direct"
        ],
        "type": "string"
      },
      "billing_request_mandate_request_verify": {
        "title": "BillingRequestMandateRequestVerify",
        "description": "Verification preference for the mandate. One of:\n\n- `minimum`: only verify if absolutely required, such as when part of scheme rules\n- `recommended`: in addition to `minimum`, use the GoCardless payment intelligence solution to decide if a payer should be verified\n- `when_available`: if verification mechanisms are available, use them\n- `always`: as `when_available`, but fail to create the Billing Request if a mechanism isn't available\n\nBy default, all Billing Requests use the `recommended` verification preference. It uses GoCardless payment intelligence solution to determine if a payer is fraudulent or not. The verification mechanism is based on the response and the payer may be asked to verify themselves. If the feature is not available, `recommended` behaves like `minimum`.\n\nIf you never wish to take advantage of our reduced risk products and Verified Mandates as they are released in new schemes, please use the `minimum` verification preference.\n\nSee [Billing Requests: Creating Verified Mandates](https://developer.gocardless.com/getting-started/billing-requests/verified-mandates/)\nfor more information.",
        "enum": [
          "minimum",
          "recommended",
          "when_available",
          "always"
        ],
        "type": "string"
      },
      "billing_request_sweeping": {
        "type": "boolean",
        "title": "BillingRequestSweeping",
        "description": "If true, this billing request would be used to set up a mandate solely for moving (or sweeping) money from one account owned by the payer to another account that the payer also owns. This is required for Faster Payments"
      },
      "billing_request_payer_requested_dual_signature": {
        "type": "boolean",
        "title": "BillingRequestPayerRequestedDualSignature",
        "description": "This attribute can be set to true if the payer has indicated that multiple signatures are required for the mandate. As long as every other Billing Request actions have been completed, the payer will receive an email notification containing instructions on how to complete the additional signature. The dual signature flow can only be completed using GoCardless branded pages."
      },
      "billing_request_consent_type": {
        "type": "string",
        "nullable": true,
        "title": "BillingRequestConsentType",
        "description": "This attribute represents the authorisation type between the payer and merchant. It can be set to `one_off`,\n`recurring` or `standing` for ACH scheme. And `single`, `recurring` and `sporadic` for PAD scheme. _Note:_ This is only supported for ACH and PAD schemes.\n"
      },
      "billing_request_mandate_request_links": {
        "type": "object",
        "title": "BillingRequestMandateRequestLinks",
        "description": "",
        "properties": {
          "mandate": {
            "type": "string",
            "description": "(Optional) ID of the [mandate](#core-endpoints-mandates) that was created from this mandate request. this mandate request.\n"
          }
        }
      },
      "billing_request_subscription_request_start_date": {
        "type": "string",
        "nullable": true,
        "title": "BillingRequestSubscriptionRequestStartDate",
        "description": "The date on which the first payment should be charged. If fulfilled after this date, this will be set as the mandate's `next_possible_charge_date`.\nWhen left blank and `month` or `day_of_month` are provided, this will be set to the date of the first payment.\nIf created without `month` or `day_of_month` this will be set as the mandate's `next_possible_charge_date`.\n",
        "example": "2014-10-21",
        "format": "date"
      },
      "billing_request_subscription_request_links": {
        "type": "object",
        "title": "BillingRequestSubscriptionRequestLinks",
        "description": "",
        "properties": {
          "subscription": {
            "type": "string",
            "description": "(Optional) ID of the [subscription](#core-endpoints-subscriptions) that was created from this subscription request.\n"
          }
        }
      },
      "billing_request_subscription_payment_reference": {
        "type": "string",
        "nullable": true,
        "title": "BillingRequestSubscriptionPaymentReference",
        "description": "An optional payment reference. This will be set as the reference on each payment\ncreated and will appear on your customer's bank statement. See the documentation for\nthe [create payment endpoint](#payments-create-a-payment) for more details.\n<br />",
        "example": "GOLDPLAN"
      },
      "billing_request_instalments_with_schedule": {
        "type": "object",
        "nullable": true,
        "title": "BillingRequestInstalmentsWithSchedule",
        "description": "Frequency of the payments you want to create, together with an array of payment\namounts to be collected, with a specified start date for the first payment.\nSee [create (with schedule)](#instalment-schedules-create-with-schedule)\n",
        "properties": {
          "start_date": {
            "type": "string",
            "nullable": true,
            "description": "The date on which the first payment should be charged. Must be on or after the [mandate](#core-endpoints-mandates)'s `next_possible_charge_date`. When left blank and `month` or `day_of_month` are provided, this will be set to the date of the first payment. If created without `month` or `day_of_month` this will be set as the mandate's `next_possible_charge_date`",
            "example": "2014-10-21",
            "format": "date"
          },
          "interval": {
            "type": "integer",
            "description": "Number of `interval_units` between charge dates. Must be greater than or\nequal to `1`.\n",
            "example": 1
          },
          "interval_unit": {
            "description": "The unit of time between customer charge dates. One of `weekly`, `monthly` or `yearly`.",
            "example": "monthly",
            "enum": [
              "weekly",
              "monthly",
              "yearly"
            ],
            "type": "string"
          },
          "amounts": {
            "type": "array",
            "description": "List of amounts of each instalment, in the lowest denomination for the\ncurrency (e.g. cents in USD).\n",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ],
              "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\nMinimum and maximum amounts vary by payment scheme. For more information, see [Transaction limits](https://support.gocardless.com/hc/en-gb/articles/115000309245-Transaction-limits)\n\nFor Variable Recurring Payments (VRP), this must not exceed the mandate's `max_amount_per_payment`\nconstraint.",
              "example": 1000
            }
          }
        }
      },
      "billing_request_instalments_with_dates": {
        "type": "array",
        "nullable": true,
        "title": "BillingRequestInstalmentsWithDates",
        "description": "An explicit array of instalment payments, each specifying at least an `amount` and `charge_date`. See [create (with dates)](#instalment-schedules-create-with-dates)",
        "example": [
          {
            "amount": 250,
            "charge_date": "2020-11-03"
          }
        ],
        "items": {
          "type": "object",
          "properties": {
            "amount": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ],
              "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\nMinimum and maximum amounts vary by payment scheme. For more information, see [Transaction limits](https://support.gocardless.com/hc/en-gb/articles/115000309245-Transaction-limits)\n\nFor Variable Recurring Payments (VRP), this must not exceed the mandate's `max_amount_per_payment`\nconstraint.",
              "example": 1000
            },
            "charge_date": {
              "type": "string",
              "nullable": true,
              "description": "A future date on which the payment should be collected. If the date\nis before the next_possible_charge_date on the\n[mandate](#core-endpoints-mandates), it will be automatically rolled\nforwards to that date.",
              "example": "2014-05-21",
              "format": "date"
            },
            "description": {
              "type": "string",
              "nullable": true,
              "description": "A human-readable description of the payment. This will be included in the notification email GoCardless sends to your customer if your organisation does not send its own notifications (see [compliance requirements](#appendix-compliance-requirements)).",
              "example": "One-off upgrade fee"
            }
          }
        }
      },
      "billing_request_instalment_schedule_request_links": {
        "type": "object",
        "title": "BillingRequestInstalmentScheduleRequestLinks",
        "description": "",
        "properties": {
          "instalment_schedule": {
            "type": "string",
            "description": "(Optional) ID of the [instalment_schedule](#core-endpoints-instalment-schedules) that was created from this instalment schedule request.\n"
          }
        }
      },
      "billing_request_payment_request": {
        "type": "object",
        "nullable": true,
        "title": "BillingRequestPaymentRequest",
        "description": "Request for a one-off strongly authorised payment",
        "properties": {
          "description": {
            "type": "string",
            "nullable": true,
            "description": "A human-readable description of the payment and/or mandate. This will be displayed to the payer when authorising the billing request.\n",
            "example": "Top-up Payment"
          },
          "currency": {
            "type": "string",
            "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. `GBP` and `EUR` supported; `GBP` with your customers in the UK and for `EUR` with your customers in supported Eurozone countries only.",
            "example": "GBP"
          },
          "scheme": {
            "type": "string",
            "nullable": true,
            "description": "(Optional) A scheme used for Open Banking payments. Currently `faster_payments` is supported in the UK (GBP) and `sepa_credit_transfer` and `sepa_instant_credit_transfer` are supported in supported Eurozone countries (EUR). For Eurozone countries, `sepa_credit_transfer` is used as the default. Please be aware that `sepa_instant_credit_transfer` may incur an additional fee for your customer.",
            "example": "faster_payments"
          },
          "amount": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "description": "Amount in minor unit (e.g. pence in GBP, cents in EUR).",
            "example": 1000
          },
          "links": {
            "type": "object",
            "description": "",
            "properties": {
              "payment": {
                "type": "string",
                "description": "(Optional) ID of the [payment](#core-endpoints-payments) that was created from this payment request."
              }
            }
          },
          "app_fee": {
            "oneOf": [
              {
                "type": "string",
                "nullable": true
              },
              {
                "type": "integer"
              }
            ],
            "description": "The amount to be deducted from the payment as an app fee, to be paid to the partner integration which created the billing request, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
            "example": 100
          },
          "metadata": {
            "type": "object",
            "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
          },
          "reference": {
            "type": "string",
            "nullable": true,
            "description": "A custom payment reference defined by the merchant. It is only available for payments on the PayTo scheme or payments using the Direct Funds settlement model on the Faster Payments scheme.\n",
            "example": "some-custom-ref"
          },
          "funds_settlement": {
            "description": "This field will decide how GoCardless handles settlement of funds from the customer.\n\n- `managed` will be moved through GoCardless' account, batched, and payed out.\n- `direct` will be a direct transfer from the payer's account to the merchant where\n  invoicing will be handled separately.\n",
            "enum": [
              "managed",
              "direct"
            ],
            "type": "string"
          }
        }
      },
      "billing_request_mandate_request": {
        "type": "object",
        "nullable": true,
        "title": "BillingRequestMandateRequest",
        "description": "Request for a mandate",
        "properties": {
          "description": {
            "type": "string",
            "nullable": true,
            "description": "A human-readable description of the payment and/or mandate. This will be displayed to the payer when authorising the billing request.\n",
            "example": "Top-up Payment"
          },
          "currency": {
            "type": "string",
            "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code.",
            "example": "GBP"
          },
          "scheme": {
            "type": "string",
            "nullable": true,
            "description": "A bank payment scheme. Currently \"ach\", \"autogiro\", \"bacs\", \"becs\", \"becs_nz\", \"betalingsservice\", \"faster_payments\", \"pad\", \"pay_to\" and \"sepa_core\" are supported. Optional for mandate only requests - if left blank, the payer will be able to select the currency/scheme to pay with from a list of your available schemes.",
            "example": "bacs"
          },
          "sweeping": {
            "type": "boolean",
            "description": "If true, this billing request would be used to set up a mandate solely for moving (or sweeping) money from one account owned by the payer to another account that the payer also owns. This is required for Faster Payments"
          },
          "verify": {
            "description": "Verification preference for the mandate. One of:\n\n- `minimum`: only verify if absolutely required, such as when part of scheme rules\n- `recommended`: in addition to `minimum`, use the GoCardless payment intelligence solution to decide if a payer should be verified\n- `when_available`: if verification mechanisms are available, use them\n- `always`: as `when_available`, but fail to create the Billing Request if a mechanism isn't available\n\nBy default, all Billing Requests use the `recommended` verification preference. It uses GoCardless payment intelligence solution to determine if a payer is fraudulent or not. The verification mechanism is based on the response and the payer may be asked to verify themselves. If the feature is not available, `recommended` behaves like `minimum`.\n\nIf you never wish to take advantage of our reduced risk products and Verified Mandates as they are released in new schemes, please use the `minimum` verification preference.\n\nSee [Billing Requests: Creating Verified Mandates](https://developer.gocardless.com/getting-started/billing-requests/verified-mandates/)\nfor more information.",
            "enum": [
              "minimum",
              "recommended",
              "when_available",
              "always"
            ],
            "type": "string"
          },
          "links": {
            "type": "object",
            "description": "",
            "properties": {
              "mandate": {
                "type": "string",
                "description": "(Optional) ID of the [mandate](#core-endpoints-mandates) that was created from this mandate request. this mandate request.\n"
              }
            }
          },
          "metadata": {
            "type": "object",
            "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
          },
          "consent_type": {
            "type": "string",
            "nullable": true,
            "description": "This attribute represents the authorisation type between the payer and merchant. It can be set to `one_off`,\n`recurring` or `standing` for ACH scheme. And `single`, `recurring` and `sporadic` for PAD scheme. _Note:_ This is only supported for ACH and PAD schemes.\n"
          },
          "constraints": {
            "type": "object",
            "nullable": true,
            "description": "Constraints that will apply to the mandate_request. (Optional) Specifically required for PayTo and VRP.",
            "properties": {
              "start_date": {
                "type": "string",
                "description": "The date from which payments can be taken.\n\nThis is an optional field and if it is not supplied the start date will be set to the day\nauthorisation happens.\n"
              },
              "end_date": {
                "type": "string",
                "description": "The latest date at which payments can be taken, must occur after start_date if present\n\nThis is an optional field and if it is not supplied the agreement will be considered open and\nwill not have an end date. Keep in mind the end date must take into account how long it will\ntake the user to set up this agreement via the Billing Request.\n"
              },
              "max_amount_per_payment": {
                "type": "integer",
                "description": "The maximum amount that can be charged for a single payment in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR). _Note:_ Required for PayTo and VRP."
              },
              "payment_method": {
                "type": "string",
                "description": "A constraint where you can specify info (free text string) about how payments are calculated. For use when payments vary and cannot be expressed as a fixed amount and frequency. _Note:_ This is only supported for ACH and PAD schemes.\n"
              },
              "periodic_limits": {
                "type": "array",
                "description": "Caps on the total amount and/or number of payments that can be collected within a\nrepeating period (e.g. no more than a set amount per month), as opposed to\n`max_amount_per_payment` which caps a single payment.\n\n_Note:_ Required for VRP, where exactly one periodic limit must be provided. Optional for\nPayTo.\n",
                "items": {
                  "type": "object",
                  "properties": {
                    "period": {
                      "description": "The repeating period for this mandate. Required whenever a periodic limit is provided\n(for both VRP and PayTo). If periodic_limits is omitted entirely for PayTo, this\ndefaults to flexible.\n",
                      "enum": [
                        "day",
                        "week",
                        "month",
                        "year",
                        "flexible"
                      ],
                      "type": "string"
                    },
                    "max_total_amount": {
                      "type": "integer",
                      "description": "The maximum total amount that can be charged for all payments in this periodic limit,\nin the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\n_Note:_ Required for VRP. This is not permitted for the PayTo scheme.\n"
                    },
                    "max_payments": {
                      "type": "integer",
                      "description": "The maximum number of payments that can be collected in this periodic limit.\n\n_Note:_ Only supported for the PayTo scheme, where it is optional.\n"
                    },
                    "alignment": {
                      "description": "The alignment of the period. Defaults to `creation_date` if not specified.\n\n`calendar` - the period follows fixed calendar boundaries, the same for every mandate:\n`week` runs Monday to Sunday, `month` runs from the 1st to the last day of the calendar\nmonth, and `year` runs from 1 January to 31 December. If the mandate starts partway\nthrough a period, the limit for that first period is reduced proportionally to the days\nremaining (e.g. a monthly limit starting on the 15th gives roughly half the limit for\nthat first month).\n\n`creation_date` - the period follows the mandate's own start date rather than the\ncalendar. For example, if the mandate starts on the 15th, each monthly period runs from\nthe 15th to the 14th of the following month. The first period is a full period, not\nreduced proportionally.\n\n_Note:_ Has no effect when period is `flexible`.\n",
                      "enum": [
                        "calendar",
                        "creation_date"
                      ],
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "payer_requested_dual_signature": {
            "type": "boolean",
            "description": "This attribute can be set to true if the payer has indicated that multiple signatures are required for the mandate. As long as every other Billing Request actions have been completed, the payer will receive an email notification containing instructions on how to complete the additional signature. The dual signature flow can only be completed using GoCardless branded pages."
          },
          "authorisation_source": {
            "description": "This field is ACH specific, sometimes referred to as [SEC code](https://www.moderntreasury.com/learn/sec-codes).\n\nThis is the way that the payer gives authorisation to the merchant.\n  web: Authorisation is Internet Initiated or via Mobile Entry (maps to SEC code: WEB)\n  telephone: Authorisation is provided orally over telephone (maps to SEC code: TEL)\n  paper: Authorisation is provided in writing and signed, or similarly authenticated (maps to SEC code: PPD)\n",
            "enum": [
              "web",
              "telephone",
              "paper"
            ],
            "type": "string"
          },
          "funds_settlement": {
            "description": "This field will decide how GoCardless handles settlement of funds from the customer.\n\n- `managed` will be moved through GoCardless' account, batched, and payed out.\n- `direct` will be a direct transfer from the payer's account to the merchant where\n  invoicing will be handled separately.\n",
            "enum": [
              "managed",
              "direct"
            ],
            "type": "string"
          }
        }
      },
      "billing_request_mandate_request_constraints": {
        "type": "object",
        "nullable": true,
        "title": "BillingRequestMandateRequestConstraints",
        "description": "Constraints that will apply to the mandate_request. (Optional) Specifically required for PayTo and VRP.",
        "properties": {
          "start_date": {
            "type": "string",
            "description": "The date from which payments can be taken.\n\nThis is an optional field and if it is not supplied the start date will be set to the day\nauthorisation happens.\n"
          },
          "end_date": {
            "type": "string",
            "description": "The latest date at which payments can be taken, must occur after start_date if present\n\nThis is an optional field and if it is not supplied the agreement will be considered open and\nwill not have an end date. Keep in mind the end date must take into account how long it will\ntake the user to set up this agreement via the Billing Request.\n"
          },
          "max_amount_per_payment": {
            "type": "integer",
            "description": "The maximum amount that can be charged for a single payment in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR). _Note:_ Required for PayTo and VRP."
          },
          "payment_method": {
            "type": "string",
            "description": "A constraint where you can specify info (free text string) about how payments are calculated. For use when payments vary and cannot be expressed as a fixed amount and frequency. _Note:_ This is only supported for ACH and PAD schemes.\n"
          },
          "periodic_limits": {
            "type": "array",
            "description": "Caps on the total amount and/or number of payments that can be collected within a\nrepeating period (e.g. no more than a set amount per month), as opposed to\n`max_amount_per_payment` which caps a single payment.\n\n_Note:_ Required for VRP, where exactly one periodic limit must be provided. Optional for\nPayTo.\n",
            "items": {
              "type": "object",
              "properties": {
                "period": {
                  "description": "The repeating period for this mandate. Required whenever a periodic limit is provided\n(for both VRP and PayTo). If periodic_limits is omitted entirely for PayTo, this\ndefaults to flexible.\n",
                  "enum": [
                    "day",
                    "week",
                    "month",
                    "year",
                    "flexible"
                  ],
                  "type": "string"
                },
                "max_total_amount": {
                  "type": "integer",
                  "description": "The maximum total amount that can be charged for all payments in this periodic limit,\nin the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\n_Note:_ Required for VRP. This is not permitted for the PayTo scheme.\n"
                },
                "max_payments": {
                  "type": "integer",
                  "description": "The maximum number of payments that can be collected in this periodic limit.\n\n_Note:_ Only supported for the PayTo scheme, where it is optional.\n"
                },
                "alignment": {
                  "description": "The alignment of the period. Defaults to `creation_date` if not specified.\n\n`calendar` - the period follows fixed calendar boundaries, the same for every mandate:\n`week` runs Monday to Sunday, `month` runs from the 1st to the last day of the calendar\nmonth, and `year` runs from 1 January to 31 December. If the mandate starts partway\nthrough a period, the limit for that first period is reduced proportionally to the days\nremaining (e.g. a monthly limit starting on the 15th gives roughly half the limit for\nthat first month).\n\n`creation_date` - the period follows the mandate's own start date rather than the\ncalendar. For example, if the mandate starts on the 15th, each monthly period runs from\nthe 15th to the 14th of the following month. The first period is a full period, not\nreduced proportionally.\n\n_Note:_ Has no effect when period is `flexible`.\n",
                  "enum": [
                    "calendar",
                    "creation_date"
                  ],
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "billing_request_subscription_request": {
        "type": "object",
        "nullable": true,
        "title": "BillingRequestSubscriptionRequest",
        "description": "Request for a subscription",
        "properties": {
          "amount": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "description": "Amount in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
            "example": 1000
          },
          "currency": {
            "type": "string",
            "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"USD\" and \"CAD\" are supported.",
            "example": "USD"
          },
          "interval_unit": {
            "description": "The unit of time between customer charge dates. One of `weekly`, `monthly` or `yearly`.",
            "example": "monthly",
            "enum": [
              "weekly",
              "monthly",
              "yearly"
            ],
            "type": "string"
          },
          "interval": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "description": "Number of `interval_units` between customer charge dates. Must be greater than or equal to `1`. Must result in at least one charge date per year. Defaults to `1`.",
            "example": 1
          },
          "app_fee": {
            "oneOf": [
              {
                "type": "string",
                "nullable": true
              },
              {
                "type": "integer"
              }
            ],
            "description": "The amount to be deducted from each payment as an app fee, to be paid to the partner integration which created the subscription, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
            "example": 100
          },
          "count": {
            "oneOf": [
              {
                "type": "string",
                "nullable": true
              },
              {
                "type": "integer"
              }
            ],
            "description": "The total number of payments that should be taken by this subscription.",
            "example": 5
          },
          "day_of_month": {
            "oneOf": [
              {
                "type": "string",
                "nullable": true
              },
              {
                "type": "integer"
              }
            ],
            "description": "As per RFC 2445. The day of the month to charge customers on. `1`-`28` or `-1` to indicate the last day of the month.",
            "example": 28
          },
          "metadata": {
            "type": "object",
            "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
          },
          "links": {
            "type": "object",
            "description": "",
            "properties": {
              "subscription": {
                "type": "string",
                "description": "(Optional) ID of the [subscription](#core-endpoints-subscriptions) that was created from this subscription request.\n"
              }
            }
          },
          "month": {
            "description": "Name of the month on which to charge a customer. Must be lowercase. Only applies\nwhen the interval_unit is `yearly`.\n",
            "example": "january",
            "enum": [
              "january",
              "february",
              "march",
              "april",
              "may",
              "june",
              "july",
              "august",
              "september",
              "october",
              "november",
              "december"
            ],
            "nullable": true,
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "description": "Optional name for the subscription. This will be set as the description on each payment created. Must not exceed 255 characters.",
            "example": "12 month subscription"
          },
          "payment_reference": {
            "type": "string",
            "nullable": true,
            "description": "An optional payment reference. This will be set as the reference on each payment\ncreated and will appear on your customer's bank statement. See the documentation for\nthe [create payment endpoint](#payments-create-a-payment) for more details.\n<br />",
            "example": "GOLDPLAN"
          },
          "start_date": {
            "type": "string",
            "nullable": true,
            "description": "The date on which the first payment should be charged. If fulfilled after this date, this will be set as the mandate's `next_possible_charge_date`.\nWhen left blank and `month` or `day_of_month` are provided, this will be set to the date of the first payment.\nIf created without `month` or `day_of_month` this will be set as the mandate's `next_possible_charge_date`.\n",
            "example": "2014-10-21",
            "format": "date"
          },
          "retry_if_possible": {
            "type": "boolean",
            "description": "On failure, automatically retry payments using [intelligent retries](/success-plus/overview). Default is `false`. <p class=\"notice\"><strong>Important</strong>: To be able to use intelligent retries, Success+ needs to be enabled in [GoCardless dashboard](https://manage.gocardless.com/success-plus). </p>"
          }
        }
      },
      "billing_request_instalment_schedule_request": {
        "type": "object",
        "nullable": true,
        "title": "BillingRequestInstalmentScheduleRequest",
        "description": "Request for an instalment schedule. Has to contain either `instalments_with_schedule` object or an array of `instalments_with_dates` objects",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the instalment schedule, up to 100 chars. This name will also be\ncopied to the payments of the instalment schedule if you use schedule-based creation.",
            "example": "Invoice 4404"
          },
          "currency": {
            "type": "string",
            "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"USD\" and \"CAD\" are supported.",
            "example": "USD"
          },
          "total_amount": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "description": "The total amount of the instalment schedule, defined as the sum of all individual\npayments, in the lowest denomination for the currency (e.g. pence in GBP, cents in\nEUR). If the requested payment amounts do not sum up correctly, a validation error\nwill be returned.",
            "example": 1000
          },
          "payment_reference": {
            "type": "string",
            "nullable": true,
            "description": "An optional payment reference. This will be set as the reference on each payment\ncreated and will appear on your customer's bank statement. See the documentation for\nthe [create payment endpoint](#payments-create-a-payment) for more details.\n<br />",
            "example": "GOLDPLAN"
          },
          "app_fee": {
            "oneOf": [
              {
                "type": "string",
                "nullable": true
              },
              {
                "type": "integer"
              }
            ],
            "description": "The amount to be deducted from each payment as an app fee, to be paid to the partner integration which created the subscription, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
            "example": 100
          },
          "instalments_with_dates": {
            "type": "array",
            "nullable": true,
            "description": "An explicit array of instalment payments, each specifying at least an `amount` and `charge_date`. See [create (with dates)](#instalment-schedules-create-with-dates)",
            "example": [
              {
                "amount": 250,
                "charge_date": "2020-11-03"
              }
            ],
            "items": {
              "type": "object",
              "properties": {
                "amount": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\nMinimum and maximum amounts vary by payment scheme. For more information, see [Transaction limits](https://support.gocardless.com/hc/en-gb/articles/115000309245-Transaction-limits)\n\nFor Variable Recurring Payments (VRP), this must not exceed the mandate's `max_amount_per_payment`\nconstraint.",
                  "example": 1000
                },
                "charge_date": {
                  "type": "string",
                  "nullable": true,
                  "description": "A future date on which the payment should be collected. If the date\nis before the next_possible_charge_date on the\n[mandate](#core-endpoints-mandates), it will be automatically rolled\nforwards to that date.",
                  "example": "2014-05-21",
                  "format": "date"
                },
                "description": {
                  "type": "string",
                  "nullable": true,
                  "description": "A human-readable description of the payment. This will be included in the notification email GoCardless sends to your customer if your organisation does not send its own notifications (see [compliance requirements](#appendix-compliance-requirements)).",
                  "example": "One-off upgrade fee"
                }
              }
            }
          },
          "instalments_with_schedule": {
            "type": "object",
            "nullable": true,
            "description": "Frequency of the payments you want to create, together with an array of payment\namounts to be collected, with a specified start date for the first payment.\nSee [create (with schedule)](#instalment-schedules-create-with-schedule)\n",
            "properties": {
              "start_date": {
                "type": "string",
                "nullable": true,
                "description": "The date on which the first payment should be charged. Must be on or after the [mandate](#core-endpoints-mandates)'s `next_possible_charge_date`. When left blank and `month` or `day_of_month` are provided, this will be set to the date of the first payment. If created without `month` or `day_of_month` this will be set as the mandate's `next_possible_charge_date`",
                "example": "2014-10-21",
                "format": "date"
              },
              "interval": {
                "type": "integer",
                "description": "Number of `interval_units` between charge dates. Must be greater than or\nequal to `1`.\n",
                "example": 1
              },
              "interval_unit": {
                "description": "The unit of time between customer charge dates. One of `weekly`, `monthly` or `yearly`.",
                "example": "monthly",
                "enum": [
                  "weekly",
                  "monthly",
                  "yearly"
                ],
                "type": "string"
              },
              "amounts": {
                "type": "array",
                "description": "List of amounts of each instalment, in the lowest denomination for the\ncurrency (e.g. cents in USD).\n",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\nMinimum and maximum amounts vary by payment scheme. For more information, see [Transaction limits](https://support.gocardless.com/hc/en-gb/articles/115000309245-Transaction-limits)\n\nFor Variable Recurring Payments (VRP), this must not exceed the mandate's `max_amount_per_payment`\nconstraint.",
                  "example": 1000
                }
              }
            }
          },
          "metadata": {
            "type": "object",
            "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
          },
          "links": {
            "type": "object",
            "description": "",
            "properties": {
              "instalment_schedule": {
                "type": "string",
                "description": "(Optional) ID of the [instalment_schedule](#core-endpoints-instalment-schedules) that was created from this instalment schedule request.\n"
              }
            }
          },
          "retry_if_possible": {
            "type": "boolean",
            "description": "On failure, automatically retry payments using [intelligent retries](/success-plus/overview). Default is `false`. <p class=\"notice\"><strong>Important</strong>: To be able to use intelligent retries, Success+ needs to be enabled in [GoCardless dashboard](https://manage.gocardless.com/success-plus). </p>"
          }
        }
      },
      "billing_request_actions": {
        "type": "array",
        "title": "BillingRequestActions",
        "description": "List of actions that can be performed before this billing request can be fulfilled.",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "description": "Unique identifier for the action.",
              "example": "collect_bank_account",
              "enum": [
                "choose_currency",
                "collect_amount",
                "collect_customer_details",
                "collect_bank_account",
                "bank_authorisation",
                "confirm_payer_details",
                "select_institution"
              ]
            },
            "status": {
              "type": "string",
              "description": "Status of the action",
              "example": "pending",
              "enum": [
                "pending",
                "completed"
              ]
            },
            "required": {
              "type": "boolean",
              "description": "Informs you whether the action is required to fulfil the billing request or not.",
              "example": true
            },
            "completes_actions": {
              "type": "array",
              "description": "Which other action types this action can complete.",
              "example": [
                "collect_bank_account"
              ],
              "items": {
                "type": "string"
              }
            },
            "requires_actions": {
              "type": "array",
              "description": "Requires completing these actions before this action can be completed.",
              "example": [
                "collect_bank_account"
              ],
              "items": {
                "type": "string"
              }
            },
            "bank_authorisation": {
              "type": "object",
              "description": "Describes the behaviour of bank authorisations, for the bank_authorisation action",
              "properties": {
                "adapter": {
                  "type": "string",
                  "description": "Which authorisation adapter will be used to power these authorisations (GoCardless internal use only)",
                  "enum": [
                    "open_banking_gateway_pis",
                    "open_banking_gateway_ais",
                    "bankid_ais",
                    "bank_pay_recurring"
                  ]
                },
                "authorisation_type": {
                  "type": "string",
                  "description": "What type of bank authorisations are supported on this billing request",
                  "enum": [
                    "payment",
                    "mandate"
                  ]
                }
              }
            },
            "collect_customer_details": {
              "type": "object",
              "description": "Additional parameters to help complete the collect_customer_details action",
              "properties": {
                "default_country_code": {
                  "type": "string",
                  "description": "Default customer country code, as determined by scheme and payer location"
                },
                "incomplete_fields": {
                  "type": "object",
                  "properties": {
                    "customer": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "description": "A customer field that needs to be collected"
                      }
                    },
                    "customer_billing_detail": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "description": "A customer_billing_detail field that needs to be collected"
                      }
                    }
                  }
                }
              }
            },
            "available_currencies": {
              "type": "array",
              "description": "List of currencies the current mandate supports",
              "items": {
                "type": "string",
                "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code.",
                "example": "GBP"
              }
            },
            "institution_guess_status": {
              "type": "string",
              "description": "Describes whether we inferred the institution from the provided bank account details. One of:\n- `not_needed`: we won't attempt to infer the institution as it is not needed. Either because it was manually selected or the billing request does not support this feature\n- `pending`: we are waiting on the bank details in order to infer the institution\n- `failed`: we weren't able to infer the institution\n- `success`: we inferred the institution and added it to the resources of a Billing Request\n",
              "example": "pending",
              "enum": [
                "not_needed",
                "pending",
                "failed",
                "success"
              ]
            }
          }
        }
      },
      "billing_request_resources": {
        "type": "object",
        "title": "BillingRequestResources",
        "description": "",
        "properties": {
          "customer": {
            "type": "object",
            "description": "Embedded customer",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier, beginning with \"CU\".",
                "example": "CU123"
              },
              "created_at": {
                "type": "string",
                "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                "example": "2014-01-01T12:00:00.000Z",
                "format": "date-time"
              },
              "email": {
                "type": "string",
                "nullable": true,
                "description": "Customer's email address. Required in most cases, as this allows GoCardless to send notifications to this customer.",
                "example": "user@example.com"
              },
              "given_name": {
                "type": "string",
                "nullable": true,
                "description": "Customer's first name. Required unless a `company_name` is provided.",
                "example": "Frank"
              },
              "family_name": {
                "type": "string",
                "nullable": true,
                "description": "Customer's surname. Required unless a `company_name` is provided.",
                "example": "Osborne"
              },
              "company_name": {
                "type": "string",
                "nullable": true,
                "description": "Customer's company name. Required unless a `given_name` and `family_name` are provided. For Canadian customers, the use of a `company_name` value will mean that any mandate created from this customer will be considered to be a \"Business PAD\" (otherwise, any mandate will be considered to be a \"Personal PAD\").",
                "example": "Hamilton Trading Ltd."
              },
              "language": {
                "type": "string",
                "nullable": true,
                "description": "[ISO 639-1](https://en.wikipedia.org/wiki/List_of_ISO_639-1_codes) code. Used as the language for notification emails sent by GoCardless if your organisation does not send its own (see [compliance requirements](#appendix-compliance-requirements)). Currently only \"en\", \"fr\", \"de\", \"pt\", \"es\", \"it\", \"nl\", \"da\", \"nb\", \"sl\", \"sv\" are supported. If this is not provided, the language will be chosen based on the `country_code` (if supplied) or default to \"en\".",
                "example": "en"
              },
              "phone_number": {
                "type": "string",
                "nullable": true,
                "description": "[ITU E.123](https://en.wikipedia.org/wiki/E.123) formatted phone number, including country code.",
                "example": "+64 4 817 9999"
              },
              "metadata": {
                "type": "object",
                "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
              }
            }
          },
          "customer_billing_detail": {
            "type": "object",
            "description": "Embedded customer billing detail",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier, beginning with \"CU\".",
                "example": "CU123"
              },
              "schemes": {
                "type": "array",
                "description": "The schemes associated with this customer billing detail",
                "items": {
                  "type": "string"
                }
              },
              "created_at": {
                "type": "string",
                "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                "example": "2014-01-01T12:00:00.000Z",
                "format": "date-time"
              },
              "address_line1": {
                "type": "string",
                "nullable": true,
                "description": "The first line of the customer's address.",
                "example": "221B Baker Street"
              },
              "address_line2": {
                "type": "string",
                "nullable": true,
                "description": "The second line of the customer's address.",
                "example": "Marylebone"
              },
              "address_line3": {
                "type": "string",
                "nullable": true,
                "description": "The third line of the customer's address.",
                "example": "City of Westminster"
              },
              "city": {
                "type": "string",
                "nullable": true,
                "description": "The city of the customer's address.",
                "example": "London"
              },
              "region": {
                "type": "string",
                "nullable": true,
                "description": "The customer's address region, county or department. For US customers a 2 letter [ISO3166-2:US](https://en.wikipedia.org/wiki/ISO_3166-2:US) state code is required (e.g. `CA` for California).",
                "example": "Greater London"
              },
              "postal_code": {
                "type": "string",
                "nullable": true,
                "description": "The customer's postal code.",
                "example": "NW1 6XE"
              },
              "country_code": {
                "type": "string",
                "nullable": true,
                "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                "example": "GB"
              },
              "swedish_identity_number": {
                "type": "string",
                "nullable": true,
                "description": "For Swedish customers only. The civic/company number (personnummer, samordningsnummer, or organisationsnummer) of the customer. Must be supplied if the customer's bank account is denominated in Swedish krona (SEK). This field cannot be changed once it has been set.",
                "example": "556564-5404"
              },
              "danish_identity_number": {
                "type": "string",
                "nullable": true,
                "description": "For Danish customers only. The civic/company number (CPR or CVR) of the customer. Must be supplied if the customer's bank account is denominated in Danish krone (DKK).",
                "example": "220550-6218"
              },
              "ip_address": {
                "type": "string",
                "nullable": true,
                "description": "For ACH customers only. Required for ACH customers. A string containing the IP address of the payer to whom the mandate belongs (i.e. as a result of their completion of a mandate setup flow in their browser).\n\nNot required for creating offline mandates where `authorisation_source` is set to telephone or paper.\n",
                "example": "127.0.0.1"
              }
            }
          },
          "customer_bank_account": {
            "type": "object",
            "nullable": true,
            "description": "Embedded customer bank account, only if a bank account is linked",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier, beginning with \"BA\".",
                "example": "BA123"
              },
              "created_at": {
                "type": "string",
                "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                "example": "2014-01-01T12:00:00.000Z",
                "format": "date-time"
              },
              "account_holder_name": {
                "type": "string",
                "description": "Name of the account holder, as known by the bank. The full name provided when the customer is created is stored and is available via the API, but is transliterated, upcased, and truncated to 18 characters in bank submissions. This field is required unless the request includes a [customer bank account token](#javascript-flow-customer-bank-account-tokens).",
                "example": "Billie Jean"
              },
              "account_number_ending": {
                "type": "string",
                "description": "The last few digits of the account number. Currently 4 digits for NZD bank accounts and 2 digits for other currencies.",
                "example": "1234"
              },
              "account_type": {
                "description": "Bank account type. Required for USD-denominated bank accounts. Must not be provided for bank accounts in other currencies. See [local details](#local-bank-details-united-states) for more information.",
                "example": "savings",
                "enum": [
                  "savings",
                  "checking"
                ],
                "nullable": true,
                "type": "string"
              },
              "country_code": {
                "type": "string",
                "nullable": true,
                "description": "[ISO 3166-1 alpha-2 code](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements). Defaults to the country code of the `iban` if supplied, otherwise is required.",
                "example": "GB"
              },
              "currency": {
                "type": "string",
                "nullable": true,
                "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                "example": "EUR"
              },
              "bank_name": {
                "type": "string",
                "description": "Name of bank, taken from the bank details.",
                "example": "BARCLAYS BANK PLC"
              },
              "enabled": {
                "type": "boolean",
                "description": "Boolean value showing whether the bank account is enabled or disabled.",
                "example": true
              },
              "metadata": {
                "type": "object",
                "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
              },
              "links": {
                "type": "object",
                "description": "",
                "properties": {
                  "customer": {
                    "type": "string",
                    "description": "ID of the [customer](#core-endpoints-customers) that owns this bank account."
                  }
                }
              },
              "bank_account_token": {
                "type": "string",
                "nullable": true,
                "description": "A token to uniquely refer to a set of bank account details. This feature is still in early access and is only available for certain organisations.",
                "example": "bat_f975ab3c-ecee-47a1-9590-5bb1d56fa113"
              },
              "payer_name_verification_result": {
                "type": "string",
                "description": "The result of the payer name verification check performed when the bank account was created. Only present if a check was performed.\n\n- `full`: The name provided matches the name held by the bank.\n- `close`: The name provided is a close but not exact match to the name held by the bank.\n- `cannot_perform_verification`: A verification was attempted but could not be completed. This can happen for a number of reasons, including the account holder's bank not participating in the verification scheme, the account not being eligible for verification (e.g. the account holder has opted out), or the bank details not being resolvable, among others.",
                "example": "full",
                "enum": [
                  "full",
                  "close",
                  "cannot_perform_verification"
                ]
              }
            }
          }
        }
      },
      "billing_request_links": {
        "type": "object",
        "title": "BillingRequestLinks",
        "description": "",
        "properties": {
          "customer": {
            "type": "string",
            "description": "ID of the [customer](#core-endpoints-customers) that will be used for this request",
            "example": "CU123"
          },
          "customer_billing_detail": {
            "type": "string",
            "description": "ID of the customer billing detail that will be used for this request"
          },
          "creditor": {
            "type": "string",
            "description": "ID of the associated [creditor](#core-endpoints-creditors).",
            "example": "CR123"
          },
          "organisation": {
            "type": "string",
            "description": "ID of the associated organisation.",
            "example": "OR123"
          },
          "customer_bank_account": {
            "type": "string",
            "description": "(Optional) ID of the [customer_bank_account](#core-endpoints-customer-bank-accounts) that will be used for this request",
            "example": "BA123"
          },
          "bank_authorisation": {
            "type": "string",
            "description": "(Optional) ID of the [bank authorisation](#billing-requests-bank-authorisations) that was used to verify this request."
          },
          "payment_request": {
            "type": "string",
            "description": "(Optional) ID of the associated payment request",
            "example": "PRQ123"
          },
          "payment_request_payment": {
            "type": "string",
            "description": "(Optional) ID of the [payment](#core-endpoints-payments) that was created from this payment request.",
            "example": "PM123"
          },
          "mandate_request": {
            "type": "string",
            "description": "(Optional) ID of the associated mandate request",
            "example": "MRQ123"
          },
          "mandate_request_mandate": {
            "type": "string",
            "description": "(Optional) ID of the [mandate](#core-endpoints-mandates) that was created from this mandate request. this mandate request.",
            "example": "MD123"
          },
          "subscription_request": {
            "type": "string",
            "description": "(Optional) ID of the associated subscription request",
            "example": "SBR123"
          },
          "subscription_request_subscription": {
            "type": "string",
            "description": "(Optional) ID of the [subscription](#core-endpoints-subscriptions) that was created from this subscription request.",
            "example": "SB123"
          },
          "instalment_schedule_request": {
            "type": "string",
            "description": "(Optional) ID of the associated instalment schedule request",
            "example": "ISR123"
          },
          "instalment_schedule_request_instalment_schedule": {
            "type": "string",
            "description": "(Optional) ID of the [instalment_schedule](#core-endpoints-instalment-schedules) that was created from this instalment schedule request.",
            "example": "IS123"
          },
          "payment_provider": {
            "type": "string",
            "description": "(Optional) ID of the associated payment provider",
            "example": "PP123"
          }
        }
      },
      "billing_request_single_resource_response": {
        "type": "object",
        "title": "BillingRequestSingleResourceResponse",
        "description": "",
        "properties": {
          "billing_requests": {
            "type": "object",
            "description": " Billing Requests help create resources that require input or action from a customer. An example of required input might be additional customer billing details, while an action would be asking a customer to authorise a payment using their mobile banking app.\n\nSee [Billing Requests: Overview](https://developer.gocardless.com/getting-started/billing-requests/overview/) for how-to's, explanations and tutorials. <p class=\"notice\"><strong>Important</strong>: All properties associated with `subscription_request` and `instalment_schedule_request` are only supported for ACH and PAD schemes.</p>",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier, beginning with \"BRQ\".",
                "example": "BRQ123"
              },
              "purpose_code": {
                "description": "Specifies the high-level purpose/category of a mandate and/or payment using a set of pre-defined categories. Provides context on the nature and reason for the payment to facilitate processing and compliance.\nSee [Billing Request Purpose Codes](https://developer.gocardless.com/billing-request-purpose-codes/) for the complete list of valid codes.",
                "enum": [
                  "mortgage",
                  "utility",
                  "loan",
                  "dependant_support",
                  "gambling",
                  "retail",
                  "salary",
                  "personal",
                  "government",
                  "pension",
                  "tax",
                  "other",
                  "bonus_payment",
                  "cash_management_transfer",
                  "card_bulk_clearing",
                  "credit_card_payment",
                  "trade_settlement_payment",
                  "debit_card_payment",
                  "dividend",
                  "deliver_against_payment",
                  "epayment",
                  "fee_collection_and_interest",
                  "fee_collection",
                  "person_to_person_payment",
                  "government_payment",
                  "hedging_transaction",
                  "irrevocable_credit_card_payment",
                  "irrevocable_debit_card_payment",
                  "intra_company_payment",
                  "interest",
                  "lockbox_transactions",
                  "commercial",
                  "consumer",
                  "other_payment",
                  "pension_payment",
                  "represented",
                  "reimbursement_received_credit_transfer",
                  "receive_against_payment",
                  "salary_payment",
                  "securities",
                  "social_security_benefit",
                  "supplier_payment",
                  "tax_payment",
                  "trade",
                  "treasury_payment",
                  "value_added_tax_payment",
                  "with_holding",
                  "cash_management_sweep_account",
                  "cash_management_top_account",
                  "cash_management_zero_balance_account",
                  "crossborder_mi_payments",
                  "foreign_currency_domestic_transfer",
                  "cash_in_pre_credit",
                  "cash_out_notes_coins",
                  "carrier_guarded_wholesale_valuables"
                ],
                "type": "string"
              },
              "payment_purpose_code": {
                "type": "string",
                "description": "Specifies the underlying purpose of the payment. Defines the specific reason or type of service/goods the payment relates to, improving straight-through processing and compliance.\nSee [VRP Commercial Payment Purpose Codes](https://developer.gocardless.com/vrp-commercial-payment-purpose-codes/) for the complete list of valid codes."
              },
              "payment_context_code": {
                "description": "Specifies the context or scenario in which the payment is being made. Defines whether the payment is for advance/arrears billing, point of sale transactions, ecommerce, or account transfers. This helps banks and payment processors understand the payment scenario and apply appropriate processing rules and risk controls.",
                "enum": [
                  "billing_goods_and_services_in_advance",
                  "billing_goods_and_services_in_arrears",
                  "face_to_face_point_of_sale",
                  "ecommerce_merchant_initiated_payment",
                  "transfer_to_self",
                  "transfer_to_third_party"
                ],
                "type": "string"
              },
              "created_at": {
                "type": "string",
                "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                "example": "2015-01-01T12:00:00.000Z",
                "format": "date-time"
              },
              "status": {
                "type": "string",
                "description": "One of:\n\n- `pending`: the billing request is pending and can be used\n- `ready_to_fulfil`: the billing request is ready to fulfil\n- `fulfilling`: the billing request is currently undergoing fulfilment\n- `fulfilled`: the billing request has been fulfilled and a payment created\n- `cancelled`: the billing request has been cancelled and cannot be used",
                "example": "pending",
                "enum": [
                  "pending",
                  "ready_to_fulfil",
                  "fulfilling",
                  "fulfilled",
                  "cancelled"
                ]
              },
              "metadata": {
                "type": "object",
                "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
              },
              "mandate_request": {
                "type": "object",
                "nullable": true,
                "description": "Request for a mandate",
                "properties": {
                  "description": {
                    "type": "string",
                    "nullable": true,
                    "description": "A human-readable description of the payment and/or mandate. This will be displayed to the payer when authorising the billing request.\n",
                    "example": "Top-up Payment"
                  },
                  "currency": {
                    "type": "string",
                    "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code.",
                    "example": "GBP"
                  },
                  "scheme": {
                    "type": "string",
                    "nullable": true,
                    "description": "A bank payment scheme. Currently \"ach\", \"autogiro\", \"bacs\", \"becs\", \"becs_nz\", \"betalingsservice\", \"faster_payments\", \"pad\", \"pay_to\" and \"sepa_core\" are supported. Optional for mandate only requests - if left blank, the payer will be able to select the currency/scheme to pay with from a list of your available schemes.",
                    "example": "bacs"
                  },
                  "sweeping": {
                    "type": "boolean",
                    "description": "If true, this billing request would be used to set up a mandate solely for moving (or sweeping) money from one account owned by the payer to another account that the payer also owns. This is required for Faster Payments"
                  },
                  "verify": {
                    "description": "Verification preference for the mandate. One of:\n\n- `minimum`: only verify if absolutely required, such as when part of scheme rules\n- `recommended`: in addition to `minimum`, use the GoCardless payment intelligence solution to decide if a payer should be verified\n- `when_available`: if verification mechanisms are available, use them\n- `always`: as `when_available`, but fail to create the Billing Request if a mechanism isn't available\n\nBy default, all Billing Requests use the `recommended` verification preference. It uses GoCardless payment intelligence solution to determine if a payer is fraudulent or not. The verification mechanism is based on the response and the payer may be asked to verify themselves. If the feature is not available, `recommended` behaves like `minimum`.\n\nIf you never wish to take advantage of our reduced risk products and Verified Mandates as they are released in new schemes, please use the `minimum` verification preference.\n\nSee [Billing Requests: Creating Verified Mandates](https://developer.gocardless.com/getting-started/billing-requests/verified-mandates/)\nfor more information.",
                    "enum": [
                      "minimum",
                      "recommended",
                      "when_available",
                      "always"
                    ],
                    "type": "string"
                  },
                  "links": {
                    "type": "object",
                    "description": "",
                    "properties": {
                      "mandate": {
                        "type": "string",
                        "description": "(Optional) ID of the [mandate](#core-endpoints-mandates) that was created from this mandate request. this mandate request.\n"
                      }
                    }
                  },
                  "metadata": {
                    "type": "object",
                    "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                  },
                  "consent_type": {
                    "type": "string",
                    "nullable": true,
                    "description": "This attribute represents the authorisation type between the payer and merchant. It can be set to `one_off`,\n`recurring` or `standing` for ACH scheme. And `single`, `recurring` and `sporadic` for PAD scheme. _Note:_ This is only supported for ACH and PAD schemes.\n"
                  },
                  "constraints": {
                    "type": "object",
                    "nullable": true,
                    "description": "Constraints that will apply to the mandate_request. (Optional) Specifically required for PayTo and VRP.",
                    "properties": {
                      "start_date": {
                        "type": "string",
                        "description": "The date from which payments can be taken.\n\nThis is an optional field and if it is not supplied the start date will be set to the day\nauthorisation happens.\n"
                      },
                      "end_date": {
                        "type": "string",
                        "description": "The latest date at which payments can be taken, must occur after start_date if present\n\nThis is an optional field and if it is not supplied the agreement will be considered open and\nwill not have an end date. Keep in mind the end date must take into account how long it will\ntake the user to set up this agreement via the Billing Request.\n"
                      },
                      "max_amount_per_payment": {
                        "type": "integer",
                        "description": "The maximum amount that can be charged for a single payment in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR). _Note:_ Required for PayTo and VRP."
                      },
                      "payment_method": {
                        "type": "string",
                        "description": "A constraint where you can specify info (free text string) about how payments are calculated. For use when payments vary and cannot be expressed as a fixed amount and frequency. _Note:_ This is only supported for ACH and PAD schemes.\n"
                      },
                      "periodic_limits": {
                        "type": "array",
                        "description": "Caps on the total amount and/or number of payments that can be collected within a\nrepeating period (e.g. no more than a set amount per month), as opposed to\n`max_amount_per_payment` which caps a single payment.\n\n_Note:_ Required for VRP, where exactly one periodic limit must be provided. Optional for\nPayTo.\n",
                        "items": {
                          "type": "object",
                          "properties": {
                            "period": {
                              "description": "The repeating period for this mandate. Required whenever a periodic limit is provided\n(for both VRP and PayTo). If periodic_limits is omitted entirely for PayTo, this\ndefaults to flexible.\n",
                              "enum": [
                                "day",
                                "week",
                                "month",
                                "year",
                                "flexible"
                              ],
                              "type": "string"
                            },
                            "max_total_amount": {
                              "type": "integer",
                              "description": "The maximum total amount that can be charged for all payments in this periodic limit,\nin the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\n_Note:_ Required for VRP. This is not permitted for the PayTo scheme.\n"
                            },
                            "max_payments": {
                              "type": "integer",
                              "description": "The maximum number of payments that can be collected in this periodic limit.\n\n_Note:_ Only supported for the PayTo scheme, where it is optional.\n"
                            },
                            "alignment": {
                              "description": "The alignment of the period. Defaults to `creation_date` if not specified.\n\n`calendar` - the period follows fixed calendar boundaries, the same for every mandate:\n`week` runs Monday to Sunday, `month` runs from the 1st to the last day of the calendar\nmonth, and `year` runs from 1 January to 31 December. If the mandate starts partway\nthrough a period, the limit for that first period is reduced proportionally to the days\nremaining (e.g. a monthly limit starting on the 15th gives roughly half the limit for\nthat first month).\n\n`creation_date` - the period follows the mandate's own start date rather than the\ncalendar. For example, if the mandate starts on the 15th, each monthly period runs from\nthe 15th to the 14th of the following month. The first period is a full period, not\nreduced proportionally.\n\n_Note:_ Has no effect when period is `flexible`.\n",
                              "enum": [
                                "calendar",
                                "creation_date"
                              ],
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  },
                  "payer_requested_dual_signature": {
                    "type": "boolean",
                    "description": "This attribute can be set to true if the payer has indicated that multiple signatures are required for the mandate. As long as every other Billing Request actions have been completed, the payer will receive an email notification containing instructions on how to complete the additional signature. The dual signature flow can only be completed using GoCardless branded pages."
                  },
                  "authorisation_source": {
                    "description": "This field is ACH specific, sometimes referred to as [SEC code](https://www.moderntreasury.com/learn/sec-codes).\n\nThis is the way that the payer gives authorisation to the merchant.\n  web: Authorisation is Internet Initiated or via Mobile Entry (maps to SEC code: WEB)\n  telephone: Authorisation is provided orally over telephone (maps to SEC code: TEL)\n  paper: Authorisation is provided in writing and signed, or similarly authenticated (maps to SEC code: PPD)\n",
                    "enum": [
                      "web",
                      "telephone",
                      "paper"
                    ],
                    "type": "string"
                  },
                  "funds_settlement": {
                    "description": "This field will decide how GoCardless handles settlement of funds from the customer.\n\n- `managed` will be moved through GoCardless' account, batched, and payed out.\n- `direct` will be a direct transfer from the payer's account to the merchant where\n  invoicing will be handled separately.\n",
                    "enum": [
                      "managed",
                      "direct"
                    ],
                    "type": "string"
                  }
                }
              },
              "payment_request": {
                "type": "object",
                "nullable": true,
                "description": "Request for a one-off strongly authorised payment",
                "properties": {
                  "description": {
                    "type": "string",
                    "nullable": true,
                    "description": "A human-readable description of the payment and/or mandate. This will be displayed to the payer when authorising the billing request.\n",
                    "example": "Top-up Payment"
                  },
                  "currency": {
                    "type": "string",
                    "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. `GBP` and `EUR` supported; `GBP` with your customers in the UK and for `EUR` with your customers in supported Eurozone countries only.",
                    "example": "GBP"
                  },
                  "scheme": {
                    "type": "string",
                    "nullable": true,
                    "description": "(Optional) A scheme used for Open Banking payments. Currently `faster_payments` is supported in the UK (GBP) and `sepa_credit_transfer` and `sepa_instant_credit_transfer` are supported in supported Eurozone countries (EUR). For Eurozone countries, `sepa_credit_transfer` is used as the default. Please be aware that `sepa_instant_credit_transfer` may incur an additional fee for your customer.",
                    "example": "faster_payments"
                  },
                  "amount": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ],
                    "description": "Amount in minor unit (e.g. pence in GBP, cents in EUR).",
                    "example": 1000
                  },
                  "links": {
                    "type": "object",
                    "description": "",
                    "properties": {
                      "payment": {
                        "type": "string",
                        "description": "(Optional) ID of the [payment](#core-endpoints-payments) that was created from this payment request."
                      }
                    }
                  },
                  "app_fee": {
                    "oneOf": [
                      {
                        "type": "string",
                        "nullable": true
                      },
                      {
                        "type": "integer"
                      }
                    ],
                    "description": "The amount to be deducted from the payment as an app fee, to be paid to the partner integration which created the billing request, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                    "example": 100
                  },
                  "metadata": {
                    "type": "object",
                    "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                  },
                  "reference": {
                    "type": "string",
                    "nullable": true,
                    "description": "A custom payment reference defined by the merchant. It is only available for payments on the PayTo scheme or payments using the Direct Funds settlement model on the Faster Payments scheme.\n",
                    "example": "some-custom-ref"
                  },
                  "funds_settlement": {
                    "description": "This field will decide how GoCardless handles settlement of funds from the customer.\n\n- `managed` will be moved through GoCardless' account, batched, and payed out.\n- `direct` will be a direct transfer from the payer's account to the merchant where\n  invoicing will be handled separately.\n",
                    "enum": [
                      "managed",
                      "direct"
                    ],
                    "type": "string"
                  }
                }
              },
              "subscription_request": {
                "type": "object",
                "nullable": true,
                "description": "Request for a subscription",
                "properties": {
                  "amount": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ],
                    "description": "Amount in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                    "example": 1000
                  },
                  "currency": {
                    "type": "string",
                    "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"USD\" and \"CAD\" are supported.",
                    "example": "USD"
                  },
                  "interval_unit": {
                    "description": "The unit of time between customer charge dates. One of `weekly`, `monthly` or `yearly`.",
                    "example": "monthly",
                    "enum": [
                      "weekly",
                      "monthly",
                      "yearly"
                    ],
                    "type": "string"
                  },
                  "interval": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ],
                    "description": "Number of `interval_units` between customer charge dates. Must be greater than or equal to `1`. Must result in at least one charge date per year. Defaults to `1`.",
                    "example": 1
                  },
                  "app_fee": {
                    "oneOf": [
                      {
                        "type": "string",
                        "nullable": true
                      },
                      {
                        "type": "integer"
                      }
                    ],
                    "description": "The amount to be deducted from each payment as an app fee, to be paid to the partner integration which created the subscription, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                    "example": 100
                  },
                  "count": {
                    "oneOf": [
                      {
                        "type": "string",
                        "nullable": true
                      },
                      {
                        "type": "integer"
                      }
                    ],
                    "description": "The total number of payments that should be taken by this subscription.",
                    "example": 5
                  },
                  "day_of_month": {
                    "oneOf": [
                      {
                        "type": "string",
                        "nullable": true
                      },
                      {
                        "type": "integer"
                      }
                    ],
                    "description": "As per RFC 2445. The day of the month to charge customers on. `1`-`28` or `-1` to indicate the last day of the month.",
                    "example": 28
                  },
                  "metadata": {
                    "type": "object",
                    "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                  },
                  "links": {
                    "type": "object",
                    "description": "",
                    "properties": {
                      "subscription": {
                        "type": "string",
                        "description": "(Optional) ID of the [subscription](#core-endpoints-subscriptions) that was created from this subscription request.\n"
                      }
                    }
                  },
                  "month": {
                    "description": "Name of the month on which to charge a customer. Must be lowercase. Only applies\nwhen the interval_unit is `yearly`.\n",
                    "example": "january",
                    "enum": [
                      "january",
                      "february",
                      "march",
                      "april",
                      "may",
                      "june",
                      "july",
                      "august",
                      "september",
                      "october",
                      "november",
                      "december"
                    ],
                    "nullable": true,
                    "type": "string"
                  },
                  "name": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optional name for the subscription. This will be set as the description on each payment created. Must not exceed 255 characters.",
                    "example": "12 month subscription"
                  },
                  "payment_reference": {
                    "type": "string",
                    "nullable": true,
                    "description": "An optional payment reference. This will be set as the reference on each payment\ncreated and will appear on your customer's bank statement. See the documentation for\nthe [create payment endpoint](#payments-create-a-payment) for more details.\n<br />",
                    "example": "GOLDPLAN"
                  },
                  "start_date": {
                    "type": "string",
                    "nullable": true,
                    "description": "The date on which the first payment should be charged. If fulfilled after this date, this will be set as the mandate's `next_possible_charge_date`.\nWhen left blank and `month` or `day_of_month` are provided, this will be set to the date of the first payment.\nIf created without `month` or `day_of_month` this will be set as the mandate's `next_possible_charge_date`.\n",
                    "example": "2014-10-21",
                    "format": "date"
                  },
                  "retry_if_possible": {
                    "type": "boolean",
                    "description": "On failure, automatically retry payments using [intelligent retries](/success-plus/overview). Default is `false`. <p class=\"notice\"><strong>Important</strong>: To be able to use intelligent retries, Success+ needs to be enabled in [GoCardless dashboard](https://manage.gocardless.com/success-plus). </p>"
                  }
                }
              },
              "instalment_schedule_request": {
                "type": "object",
                "nullable": true,
                "description": "Request for an instalment schedule. Has to contain either `instalments_with_schedule` object or an array of `instalments_with_dates` objects",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Name of the instalment schedule, up to 100 chars. This name will also be\ncopied to the payments of the instalment schedule if you use schedule-based creation.",
                    "example": "Invoice 4404"
                  },
                  "currency": {
                    "type": "string",
                    "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"USD\" and \"CAD\" are supported.",
                    "example": "USD"
                  },
                  "total_amount": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ],
                    "description": "The total amount of the instalment schedule, defined as the sum of all individual\npayments, in the lowest denomination for the currency (e.g. pence in GBP, cents in\nEUR). If the requested payment amounts do not sum up correctly, a validation error\nwill be returned.",
                    "example": 1000
                  },
                  "payment_reference": {
                    "type": "string",
                    "nullable": true,
                    "description": "An optional payment reference. This will be set as the reference on each payment\ncreated and will appear on your customer's bank statement. See the documentation for\nthe [create payment endpoint](#payments-create-a-payment) for more details.\n<br />",
                    "example": "GOLDPLAN"
                  },
                  "app_fee": {
                    "oneOf": [
                      {
                        "type": "string",
                        "nullable": true
                      },
                      {
                        "type": "integer"
                      }
                    ],
                    "description": "The amount to be deducted from each payment as an app fee, to be paid to the partner integration which created the subscription, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                    "example": 100
                  },
                  "instalments_with_dates": {
                    "type": "array",
                    "nullable": true,
                    "description": "An explicit array of instalment payments, each specifying at least an `amount` and `charge_date`. See [create (with dates)](#instalment-schedules-create-with-dates)",
                    "example": [
                      {
                        "amount": 250,
                        "charge_date": "2020-11-03"
                      }
                    ],
                    "items": {
                      "type": "object",
                      "properties": {
                        "amount": {
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "integer"
                            }
                          ],
                          "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\nMinimum and maximum amounts vary by payment scheme. For more information, see [Transaction limits](https://support.gocardless.com/hc/en-gb/articles/115000309245-Transaction-limits)\n\nFor Variable Recurring Payments (VRP), this must not exceed the mandate's `max_amount_per_payment`\nconstraint.",
                          "example": 1000
                        },
                        "charge_date": {
                          "type": "string",
                          "nullable": true,
                          "description": "A future date on which the payment should be collected. If the date\nis before the next_possible_charge_date on the\n[mandate](#core-endpoints-mandates), it will be automatically rolled\nforwards to that date.",
                          "example": "2014-05-21",
                          "format": "date"
                        },
                        "description": {
                          "type": "string",
                          "nullable": true,
                          "description": "A human-readable description of the payment. This will be included in the notification email GoCardless sends to your customer if your organisation does not send its own notifications (see [compliance requirements](#appendix-compliance-requirements)).",
                          "example": "One-off upgrade fee"
                        }
                      }
                    }
                  },
                  "instalments_with_schedule": {
                    "type": "object",
                    "nullable": true,
                    "description": "Frequency of the payments you want to create, together with an array of payment\namounts to be collected, with a specified start date for the first payment.\nSee [create (with schedule)](#instalment-schedules-create-with-schedule)\n",
                    "properties": {
                      "start_date": {
                        "type": "string",
                        "nullable": true,
                        "description": "The date on which the first payment should be charged. Must be on or after the [mandate](#core-endpoints-mandates)'s `next_possible_charge_date`. When left blank and `month` or `day_of_month` are provided, this will be set to the date of the first payment. If created without `month` or `day_of_month` this will be set as the mandate's `next_possible_charge_date`",
                        "example": "2014-10-21",
                        "format": "date"
                      },
                      "interval": {
                        "type": "integer",
                        "description": "Number of `interval_units` between charge dates. Must be greater than or\nequal to `1`.\n",
                        "example": 1
                      },
                      "interval_unit": {
                        "description": "The unit of time between customer charge dates. One of `weekly`, `monthly` or `yearly`.",
                        "example": "monthly",
                        "enum": [
                          "weekly",
                          "monthly",
                          "yearly"
                        ],
                        "type": "string"
                      },
                      "amounts": {
                        "type": "array",
                        "description": "List of amounts of each instalment, in the lowest denomination for the\ncurrency (e.g. cents in USD).\n",
                        "items": {
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "integer"
                            }
                          ],
                          "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\nMinimum and maximum amounts vary by payment scheme. For more information, see [Transaction limits](https://support.gocardless.com/hc/en-gb/articles/115000309245-Transaction-limits)\n\nFor Variable Recurring Payments (VRP), this must not exceed the mandate's `max_amount_per_payment`\nconstraint.",
                          "example": 1000
                        }
                      }
                    }
                  },
                  "metadata": {
                    "type": "object",
                    "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                  },
                  "links": {
                    "type": "object",
                    "description": "",
                    "properties": {
                      "instalment_schedule": {
                        "type": "string",
                        "description": "(Optional) ID of the [instalment_schedule](#core-endpoints-instalment-schedules) that was created from this instalment schedule request.\n"
                      }
                    }
                  },
                  "retry_if_possible": {
                    "type": "boolean",
                    "description": "On failure, automatically retry payments using [intelligent retries](/success-plus/overview). Default is `false`. <p class=\"notice\"><strong>Important</strong>: To be able to use intelligent retries, Success+ needs to be enabled in [GoCardless dashboard](https://manage.gocardless.com/success-plus). </p>"
                  }
                }
              },
              "actions": {
                "type": "array",
                "description": "List of actions that can be performed before this billing request can be fulfilled.",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "description": "Unique identifier for the action.",
                      "example": "collect_bank_account",
                      "enum": [
                        "choose_currency",
                        "collect_amount",
                        "collect_customer_details",
                        "collect_bank_account",
                        "bank_authorisation",
                        "confirm_payer_details",
                        "select_institution"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "description": "Status of the action",
                      "example": "pending",
                      "enum": [
                        "pending",
                        "completed"
                      ]
                    },
                    "required": {
                      "type": "boolean",
                      "description": "Informs you whether the action is required to fulfil the billing request or not.",
                      "example": true
                    },
                    "completes_actions": {
                      "type": "array",
                      "description": "Which other action types this action can complete.",
                      "example": [
                        "collect_bank_account"
                      ],
                      "items": {
                        "type": "string"
                      }
                    },
                    "requires_actions": {
                      "type": "array",
                      "description": "Requires completing these actions before this action can be completed.",
                      "example": [
                        "collect_bank_account"
                      ],
                      "items": {
                        "type": "string"
                      }
                    },
                    "bank_authorisation": {
                      "type": "object",
                      "description": "Describes the behaviour of bank authorisations, for the bank_authorisation action",
                      "properties": {
                        "adapter": {
                          "type": "string",
                          "description": "Which authorisation adapter will be used to power these authorisations (GoCardless internal use only)",
                          "enum": [
                            "open_banking_gateway_pis",
                            "open_banking_gateway_ais",
                            "bankid_ais",
                            "bank_pay_recurring"
                          ]
                        },
                        "authorisation_type": {
                          "type": "string",
                          "description": "What type of bank authorisations are supported on this billing request",
                          "enum": [
                            "payment",
                            "mandate"
                          ]
                        }
                      }
                    },
                    "collect_customer_details": {
                      "type": "object",
                      "description": "Additional parameters to help complete the collect_customer_details action",
                      "properties": {
                        "default_country_code": {
                          "type": "string",
                          "description": "Default customer country code, as determined by scheme and payer location"
                        },
                        "incomplete_fields": {
                          "type": "object",
                          "properties": {
                            "customer": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "description": "A customer field that needs to be collected"
                              }
                            },
                            "customer_billing_detail": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "description": "A customer_billing_detail field that needs to be collected"
                              }
                            }
                          }
                        }
                      }
                    },
                    "available_currencies": {
                      "type": "array",
                      "description": "List of currencies the current mandate supports",
                      "items": {
                        "type": "string",
                        "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code.",
                        "example": "GBP"
                      }
                    },
                    "institution_guess_status": {
                      "type": "string",
                      "description": "Describes whether we inferred the institution from the provided bank account details. One of:\n- `not_needed`: we won't attempt to infer the institution as it is not needed. Either because it was manually selected or the billing request does not support this feature\n- `pending`: we are waiting on the bank details in order to infer the institution\n- `failed`: we weren't able to infer the institution\n- `success`: we inferred the institution and added it to the resources of a Billing Request\n",
                      "example": "pending",
                      "enum": [
                        "not_needed",
                        "pending",
                        "failed",
                        "success"
                      ]
                    }
                  }
                }
              },
              "resources": {
                "type": "object",
                "description": "",
                "properties": {
                  "customer": {
                    "type": "object",
                    "description": "Embedded customer",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier, beginning with \"CU\".",
                        "example": "CU123"
                      },
                      "created_at": {
                        "type": "string",
                        "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                        "example": "2014-01-01T12:00:00.000Z",
                        "format": "date-time"
                      },
                      "email": {
                        "type": "string",
                        "nullable": true,
                        "description": "Customer's email address. Required in most cases, as this allows GoCardless to send notifications to this customer.",
                        "example": "user@example.com"
                      },
                      "given_name": {
                        "type": "string",
                        "nullable": true,
                        "description": "Customer's first name. Required unless a `company_name` is provided.",
                        "example": "Frank"
                      },
                      "family_name": {
                        "type": "string",
                        "nullable": true,
                        "description": "Customer's surname. Required unless a `company_name` is provided.",
                        "example": "Osborne"
                      },
                      "company_name": {
                        "type": "string",
                        "nullable": true,
                        "description": "Customer's company name. Required unless a `given_name` and `family_name` are provided. For Canadian customers, the use of a `company_name` value will mean that any mandate created from this customer will be considered to be a \"Business PAD\" (otherwise, any mandate will be considered to be a \"Personal PAD\").",
                        "example": "Hamilton Trading Ltd."
                      },
                      "language": {
                        "type": "string",
                        "nullable": true,
                        "description": "[ISO 639-1](https://en.wikipedia.org/wiki/List_of_ISO_639-1_codes) code. Used as the language for notification emails sent by GoCardless if your organisation does not send its own (see [compliance requirements](#appendix-compliance-requirements)). Currently only \"en\", \"fr\", \"de\", \"pt\", \"es\", \"it\", \"nl\", \"da\", \"nb\", \"sl\", \"sv\" are supported. If this is not provided, the language will be chosen based on the `country_code` (if supplied) or default to \"en\".",
                        "example": "en"
                      },
                      "phone_number": {
                        "type": "string",
                        "nullable": true,
                        "description": "[ITU E.123](https://en.wikipedia.org/wiki/E.123) formatted phone number, including country code.",
                        "example": "+64 4 817 9999"
                      },
                      "metadata": {
                        "type": "object",
                        "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                      }
                    }
                  },
                  "customer_billing_detail": {
                    "type": "object",
                    "description": "Embedded customer billing detail",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier, beginning with \"CU\".",
                        "example": "CU123"
                      },
                      "schemes": {
                        "type": "array",
                        "description": "The schemes associated with this customer billing detail",
                        "items": {
                          "type": "string"
                        }
                      },
                      "created_at": {
                        "type": "string",
                        "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                        "example": "2014-01-01T12:00:00.000Z",
                        "format": "date-time"
                      },
                      "address_line1": {
                        "type": "string",
                        "nullable": true,
                        "description": "The first line of the customer's address.",
                        "example": "221B Baker Street"
                      },
                      "address_line2": {
                        "type": "string",
                        "nullable": true,
                        "description": "The second line of the customer's address.",
                        "example": "Marylebone"
                      },
                      "address_line3": {
                        "type": "string",
                        "nullable": true,
                        "description": "The third line of the customer's address.",
                        "example": "City of Westminster"
                      },
                      "city": {
                        "type": "string",
                        "nullable": true,
                        "description": "The city of the customer's address.",
                        "example": "London"
                      },
                      "region": {
                        "type": "string",
                        "nullable": true,
                        "description": "The customer's address region, county or department. For US customers a 2 letter [ISO3166-2:US](https://en.wikipedia.org/wiki/ISO_3166-2:US) state code is required (e.g. `CA` for California).",
                        "example": "Greater London"
                      },
                      "postal_code": {
                        "type": "string",
                        "nullable": true,
                        "description": "The customer's postal code.",
                        "example": "NW1 6XE"
                      },
                      "country_code": {
                        "type": "string",
                        "nullable": true,
                        "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                        "example": "GB"
                      },
                      "swedish_identity_number": {
                        "type": "string",
                        "nullable": true,
                        "description": "For Swedish customers only. The civic/company number (personnummer, samordningsnummer, or organisationsnummer) of the customer. Must be supplied if the customer's bank account is denominated in Swedish krona (SEK). This field cannot be changed once it has been set.",
                        "example": "556564-5404"
                      },
                      "danish_identity_number": {
                        "type": "string",
                        "nullable": true,
                        "description": "For Danish customers only. The civic/company number (CPR or CVR) of the customer. Must be supplied if the customer's bank account is denominated in Danish krone (DKK).",
                        "example": "220550-6218"
                      },
                      "ip_address": {
                        "type": "string",
                        "nullable": true,
                        "description": "For ACH customers only. Required for ACH customers. A string containing the IP address of the payer to whom the mandate belongs (i.e. as a result of their completion of a mandate setup flow in their browser).\n\nNot required for creating offline mandates where `authorisation_source` is set to telephone or paper.\n",
                        "example": "127.0.0.1"
                      }
                    }
                  },
                  "customer_bank_account": {
                    "type": "object",
                    "nullable": true,
                    "description": "Embedded customer bank account, only if a bank account is linked",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier, beginning with \"BA\".",
                        "example": "BA123"
                      },
                      "created_at": {
                        "type": "string",
                        "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                        "example": "2014-01-01T12:00:00.000Z",
                        "format": "date-time"
                      },
                      "account_holder_name": {
                        "type": "string",
                        "description": "Name of the account holder, as known by the bank. The full name provided when the customer is created is stored and is available via the API, but is transliterated, upcased, and truncated to 18 characters in bank submissions. This field is required unless the request includes a [customer bank account token](#javascript-flow-customer-bank-account-tokens).",
                        "example": "Billie Jean"
                      },
                      "account_number_ending": {
                        "type": "string",
                        "description": "The last few digits of the account number. Currently 4 digits for NZD bank accounts and 2 digits for other currencies.",
                        "example": "1234"
                      },
                      "account_type": {
                        "description": "Bank account type. Required for USD-denominated bank accounts. Must not be provided for bank accounts in other currencies. See [local details](#local-bank-details-united-states) for more information.",
                        "example": "savings",
                        "enum": [
                          "savings",
                          "checking"
                        ],
                        "nullable": true,
                        "type": "string"
                      },
                      "country_code": {
                        "type": "string",
                        "nullable": true,
                        "description": "[ISO 3166-1 alpha-2 code](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements). Defaults to the country code of the `iban` if supplied, otherwise is required.",
                        "example": "GB"
                      },
                      "currency": {
                        "type": "string",
                        "nullable": true,
                        "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                        "example": "EUR"
                      },
                      "bank_name": {
                        "type": "string",
                        "description": "Name of bank, taken from the bank details.",
                        "example": "BARCLAYS BANK PLC"
                      },
                      "enabled": {
                        "type": "boolean",
                        "description": "Boolean value showing whether the bank account is enabled or disabled.",
                        "example": true
                      },
                      "metadata": {
                        "type": "object",
                        "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                      },
                      "links": {
                        "type": "object",
                        "description": "",
                        "properties": {
                          "customer": {
                            "type": "string",
                            "description": "ID of the [customer](#core-endpoints-customers) that owns this bank account."
                          }
                        }
                      },
                      "bank_account_token": {
                        "type": "string",
                        "nullable": true,
                        "description": "A token to uniquely refer to a set of bank account details. This feature is still in early access and is only available for certain organisations.",
                        "example": "bat_f975ab3c-ecee-47a1-9590-5bb1d56fa113"
                      },
                      "payer_name_verification_result": {
                        "type": "string",
                        "description": "The result of the payer name verification check performed when the bank account was created. Only present if a check was performed.\n\n- `full`: The name provided matches the name held by the bank.\n- `close`: The name provided is a close but not exact match to the name held by the bank.\n- `cannot_perform_verification`: A verification was attempted but could not be completed. This can happen for a number of reasons, including the account holder's bank not participating in the verification scheme, the account not being eligible for verification (e.g. the account holder has opted out), or the bank details not being resolvable, among others.",
                        "example": "full",
                        "enum": [
                          "full",
                          "close",
                          "cannot_perform_verification"
                        ]
                      }
                    }
                  }
                }
              },
              "links": {
                "type": "object",
                "description": "",
                "properties": {
                  "customer": {
                    "type": "string",
                    "description": "ID of the [customer](#core-endpoints-customers) that will be used for this request",
                    "example": "CU123"
                  },
                  "customer_billing_detail": {
                    "type": "string",
                    "description": "ID of the customer billing detail that will be used for this request"
                  },
                  "creditor": {
                    "type": "string",
                    "description": "ID of the associated [creditor](#core-endpoints-creditors).",
                    "example": "CR123"
                  },
                  "organisation": {
                    "type": "string",
                    "description": "ID of the associated organisation.",
                    "example": "OR123"
                  },
                  "customer_bank_account": {
                    "type": "string",
                    "description": "(Optional) ID of the [customer_bank_account](#core-endpoints-customer-bank-accounts) that will be used for this request",
                    "example": "BA123"
                  },
                  "bank_authorisation": {
                    "type": "string",
                    "description": "(Optional) ID of the [bank authorisation](#billing-requests-bank-authorisations) that was used to verify this request."
                  },
                  "payment_request": {
                    "type": "string",
                    "description": "(Optional) ID of the associated payment request",
                    "example": "PRQ123"
                  },
                  "payment_request_payment": {
                    "type": "string",
                    "description": "(Optional) ID of the [payment](#core-endpoints-payments) that was created from this payment request.",
                    "example": "PM123"
                  },
                  "mandate_request": {
                    "type": "string",
                    "description": "(Optional) ID of the associated mandate request",
                    "example": "MRQ123"
                  },
                  "mandate_request_mandate": {
                    "type": "string",
                    "description": "(Optional) ID of the [mandate](#core-endpoints-mandates) that was created from this mandate request. this mandate request.",
                    "example": "MD123"
                  },
                  "subscription_request": {
                    "type": "string",
                    "description": "(Optional) ID of the associated subscription request",
                    "example": "SBR123"
                  },
                  "subscription_request_subscription": {
                    "type": "string",
                    "description": "(Optional) ID of the [subscription](#core-endpoints-subscriptions) that was created from this subscription request.",
                    "example": "SB123"
                  },
                  "instalment_schedule_request": {
                    "type": "string",
                    "description": "(Optional) ID of the associated instalment schedule request",
                    "example": "ISR123"
                  },
                  "instalment_schedule_request_instalment_schedule": {
                    "type": "string",
                    "description": "(Optional) ID of the [instalment_schedule](#core-endpoints-instalment-schedules) that was created from this instalment schedule request.",
                    "example": "IS123"
                  },
                  "payment_provider": {
                    "type": "string",
                    "description": "(Optional) ID of the associated payment provider",
                    "example": "PP123"
                  }
                }
              },
              "fallback_enabled": {
                "type": "boolean",
                "description": "(Optional) If true, this billing request can fallback from instant payment to direct debit.\nShould not be set if GoCardless payment intelligence feature is used.\n\nSee [Billing Requests: Retain customers with Fallbacks](https://developer.gocardless.com/billing-requests/retain-customers-with-fallbacks/)\nfor more information."
              },
              "fallback_occurred": {
                "type": "boolean",
                "description": "True if the billing request was completed with direct debit."
              }
            }
          }
        }
      },
      "billing_request_pagination_meta": {
        "type": "object",
        "title": "BillingRequestPaginationMeta",
        "description": "Cursor pagination information",
        "properties": {
          "limit": {
            "type": "integer",
            "example": 50
          },
          "cursors": {
            "type": "object",
            "properties": {
              "before": {
                "type": "string",
                "nullable": true,
                "description": "Cursor pointing to the end of the desired set."
              },
              "after": {
                "type": "string",
                "nullable": true,
                "description": "Cursor pointing to the start of the desired set."
              }
            }
          }
        }
      },
      "billing_request_multi_resource_response": {
        "type": "object",
        "title": "BillingRequestMultiResourceResponse",
        "description": "",
        "properties": {
          "billing_requests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier, beginning with \"BRQ\".",
                  "example": "BRQ123"
                },
                "created_at": {
                  "type": "string",
                  "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                  "example": "2015-01-01T12:00:00.000Z",
                  "format": "date-time"
                },
                "status": {
                  "type": "string",
                  "description": "One of:\n\n- `pending`: the billing request is pending and can be used\n- `ready_to_fulfil`: the billing request is ready to fulfil\n- `fulfilling`: the billing request is currently undergoing fulfilment\n- `fulfilled`: the billing request has been fulfilled and a payment created\n- `cancelled`: the billing request has been cancelled and cannot be used",
                  "example": "pending",
                  "enum": [
                    "pending",
                    "ready_to_fulfil",
                    "fulfilling",
                    "fulfilled",
                    "cancelled"
                  ]
                },
                "metadata": {
                  "type": "object",
                  "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                },
                "mandate_request": {
                  "type": "object",
                  "nullable": true,
                  "description": "Request for a mandate",
                  "properties": {
                    "description": {
                      "type": "string",
                      "nullable": true,
                      "description": "A human-readable description of the payment and/or mandate. This will be displayed to the payer when authorising the billing request.\n",
                      "example": "Top-up Payment"
                    },
                    "currency": {
                      "type": "string",
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code.",
                      "example": "GBP"
                    },
                    "scheme": {
                      "type": "string",
                      "nullable": true,
                      "description": "A bank payment scheme. Currently \"ach\", \"autogiro\", \"bacs\", \"becs\", \"becs_nz\", \"betalingsservice\", \"faster_payments\", \"pad\", \"pay_to\" and \"sepa_core\" are supported. Optional for mandate only requests - if left blank, the payer will be able to select the currency/scheme to pay with from a list of your available schemes.",
                      "example": "bacs"
                    },
                    "sweeping": {
                      "type": "boolean",
                      "description": "If true, this billing request would be used to set up a mandate solely for moving (or sweeping) money from one account owned by the payer to another account that the payer also owns. This is required for Faster Payments"
                    },
                    "verify": {
                      "description": "Verification preference for the mandate. One of:\n\n- `minimum`: only verify if absolutely required, such as when part of scheme rules\n- `recommended`: in addition to `minimum`, use the GoCardless payment intelligence solution to decide if a payer should be verified\n- `when_available`: if verification mechanisms are available, use them\n- `always`: as `when_available`, but fail to create the Billing Request if a mechanism isn't available\n\nBy default, all Billing Requests use the `recommended` verification preference. It uses GoCardless payment intelligence solution to determine if a payer is fraudulent or not. The verification mechanism is based on the response and the payer may be asked to verify themselves. If the feature is not available, `recommended` behaves like `minimum`.\n\nIf you never wish to take advantage of our reduced risk products and Verified Mandates as they are released in new schemes, please use the `minimum` verification preference.\n\nSee [Billing Requests: Creating Verified Mandates](https://developer.gocardless.com/getting-started/billing-requests/verified-mandates/)\nfor more information.",
                      "enum": [
                        "minimum",
                        "recommended",
                        "when_available",
                        "always"
                      ],
                      "type": "string"
                    },
                    "links": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "mandate": {
                          "type": "string",
                          "description": "(Optional) ID of the [mandate](#core-endpoints-mandates) that was created from this mandate request. this mandate request.\n"
                        }
                      }
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                    },
                    "consent_type": {
                      "type": "string",
                      "nullable": true,
                      "description": "This attribute represents the authorisation type between the payer and merchant. It can be set to `one_off`,\n`recurring` or `standing` for ACH scheme. And `single`, `recurring` and `sporadic` for PAD scheme. _Note:_ This is only supported for ACH and PAD schemes.\n"
                    },
                    "constraints": {
                      "type": "object",
                      "nullable": true,
                      "description": "Constraints that will apply to the mandate_request. (Optional) Specifically required for PayTo and VRP.",
                      "properties": {
                        "start_date": {
                          "type": "string",
                          "description": "The date from which payments can be taken.\n\nThis is an optional field and if it is not supplied the start date will be set to the day\nauthorisation happens.\n"
                        },
                        "end_date": {
                          "type": "string",
                          "description": "The latest date at which payments can be taken, must occur after start_date if present\n\nThis is an optional field and if it is not supplied the agreement will be considered open and\nwill not have an end date. Keep in mind the end date must take into account how long it will\ntake the user to set up this agreement via the Billing Request.\n"
                        },
                        "max_amount_per_payment": {
                          "type": "integer",
                          "description": "The maximum amount that can be charged for a single payment in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR). _Note:_ Required for PayTo and VRP."
                        },
                        "payment_method": {
                          "type": "string",
                          "description": "A constraint where you can specify info (free text string) about how payments are calculated. For use when payments vary and cannot be expressed as a fixed amount and frequency. _Note:_ This is only supported for ACH and PAD schemes.\n"
                        },
                        "periodic_limits": {
                          "type": "array",
                          "description": "Caps on the total amount and/or number of payments that can be collected within a\nrepeating period (e.g. no more than a set amount per month), as opposed to\n`max_amount_per_payment` which caps a single payment.\n\n_Note:_ Required for VRP, where exactly one periodic limit must be provided. Optional for\nPayTo.\n",
                          "items": {
                            "type": "object",
                            "properties": {
                              "period": {
                                "description": "The repeating period for this mandate. Required whenever a periodic limit is provided\n(for both VRP and PayTo). If periodic_limits is omitted entirely for PayTo, this\ndefaults to flexible.\n",
                                "enum": [
                                  "day",
                                  "week",
                                  "month",
                                  "year",
                                  "flexible"
                                ],
                                "type": "string"
                              },
                              "max_total_amount": {
                                "type": "integer",
                                "description": "The maximum total amount that can be charged for all payments in this periodic limit,\nin the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\n_Note:_ Required for VRP. This is not permitted for the PayTo scheme.\n"
                              },
                              "max_payments": {
                                "type": "integer",
                                "description": "The maximum number of payments that can be collected in this periodic limit.\n\n_Note:_ Only supported for the PayTo scheme, where it is optional.\n"
                              },
                              "alignment": {
                                "description": "The alignment of the period. Defaults to `creation_date` if not specified.\n\n`calendar` - the period follows fixed calendar boundaries, the same for every mandate:\n`week` runs Monday to Sunday, `month` runs from the 1st to the last day of the calendar\nmonth, and `year` runs from 1 January to 31 December. If the mandate starts partway\nthrough a period, the limit for that first period is reduced proportionally to the days\nremaining (e.g. a monthly limit starting on the 15th gives roughly half the limit for\nthat first month).\n\n`creation_date` - the period follows the mandate's own start date rather than the\ncalendar. For example, if the mandate starts on the 15th, each monthly period runs from\nthe 15th to the 14th of the following month. The first period is a full period, not\nreduced proportionally.\n\n_Note:_ Has no effect when period is `flexible`.\n",
                                "enum": [
                                  "calendar",
                                  "creation_date"
                                ],
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    },
                    "payer_requested_dual_signature": {
                      "type": "boolean",
                      "description": "This attribute can be set to true if the payer has indicated that multiple signatures are required for the mandate. As long as every other Billing Request actions have been completed, the payer will receive an email notification containing instructions on how to complete the additional signature. The dual signature flow can only be completed using GoCardless branded pages."
                    },
                    "authorisation_source": {
                      "description": "This field is ACH specific, sometimes referred to as [SEC code](https://www.moderntreasury.com/learn/sec-codes).\n\nThis is the way that the payer gives authorisation to the merchant.\n  web: Authorisation is Internet Initiated or via Mobile Entry (maps to SEC code: WEB)\n  telephone: Authorisation is provided orally over telephone (maps to SEC code: TEL)\n  paper: Authorisation is provided in writing and signed, or similarly authenticated (maps to SEC code: PPD)\n",
                      "enum": [
                        "web",
                        "telephone",
                        "paper"
                      ],
                      "type": "string"
                    },
                    "funds_settlement": {
                      "description": "This field will decide how GoCardless handles settlement of funds from the customer.\n\n- `managed` will be moved through GoCardless' account, batched, and payed out.\n- `direct` will be a direct transfer from the payer's account to the merchant where\n  invoicing will be handled separately.\n",
                      "enum": [
                        "managed",
                        "direct"
                      ],
                      "type": "string"
                    }
                  }
                },
                "payment_request": {
                  "type": "object",
                  "nullable": true,
                  "description": "Request for a one-off strongly authorised payment",
                  "properties": {
                    "description": {
                      "type": "string",
                      "nullable": true,
                      "description": "A human-readable description of the payment and/or mandate. This will be displayed to the payer when authorising the billing request.\n",
                      "example": "Top-up Payment"
                    },
                    "currency": {
                      "type": "string",
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. `GBP` and `EUR` supported; `GBP` with your customers in the UK and for `EUR` with your customers in supported Eurozone countries only.",
                      "example": "GBP"
                    },
                    "scheme": {
                      "type": "string",
                      "nullable": true,
                      "description": "(Optional) A scheme used for Open Banking payments. Currently `faster_payments` is supported in the UK (GBP) and `sepa_credit_transfer` and `sepa_instant_credit_transfer` are supported in supported Eurozone countries (EUR). For Eurozone countries, `sepa_credit_transfer` is used as the default. Please be aware that `sepa_instant_credit_transfer` may incur an additional fee for your customer.",
                      "example": "faster_payments"
                    },
                    "amount": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Amount in minor unit (e.g. pence in GBP, cents in EUR).",
                      "example": 1000
                    },
                    "links": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "payment": {
                          "type": "string",
                          "description": "(Optional) ID of the [payment](#core-endpoints-payments) that was created from this payment request."
                        }
                      }
                    },
                    "app_fee": {
                      "oneOf": [
                        {
                          "type": "string",
                          "nullable": true
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "The amount to be deducted from the payment as an app fee, to be paid to the partner integration which created the billing request, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                      "example": 100
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                    },
                    "reference": {
                      "type": "string",
                      "nullable": true,
                      "description": "A custom payment reference defined by the merchant. It is only available for payments on the PayTo scheme or payments using the Direct Funds settlement model on the Faster Payments scheme.\n",
                      "example": "some-custom-ref"
                    },
                    "funds_settlement": {
                      "description": "This field will decide how GoCardless handles settlement of funds from the customer.\n\n- `managed` will be moved through GoCardless' account, batched, and payed out.\n- `direct` will be a direct transfer from the payer's account to the merchant where\n  invoicing will be handled separately.\n",
                      "enum": [
                        "managed",
                        "direct"
                      ],
                      "type": "string"
                    }
                  }
                },
                "subscription_request": {
                  "type": "object",
                  "nullable": true,
                  "description": "Request for a subscription",
                  "properties": {
                    "amount": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Amount in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                      "example": 1000
                    },
                    "currency": {
                      "type": "string",
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"USD\" and \"CAD\" are supported.",
                      "example": "USD"
                    },
                    "interval_unit": {
                      "description": "The unit of time between customer charge dates. One of `weekly`, `monthly` or `yearly`.",
                      "example": "monthly",
                      "enum": [
                        "weekly",
                        "monthly",
                        "yearly"
                      ],
                      "type": "string"
                    },
                    "interval": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Number of `interval_units` between customer charge dates. Must be greater than or equal to `1`. Must result in at least one charge date per year. Defaults to `1`.",
                      "example": 1
                    },
                    "app_fee": {
                      "oneOf": [
                        {
                          "type": "string",
                          "nullable": true
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "The amount to be deducted from each payment as an app fee, to be paid to the partner integration which created the subscription, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                      "example": 100
                    },
                    "count": {
                      "oneOf": [
                        {
                          "type": "string",
                          "nullable": true
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "The total number of payments that should be taken by this subscription.",
                      "example": 5
                    },
                    "day_of_month": {
                      "oneOf": [
                        {
                          "type": "string",
                          "nullable": true
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "As per RFC 2445. The day of the month to charge customers on. `1`-`28` or `-1` to indicate the last day of the month.",
                      "example": 28
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                    },
                    "links": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "subscription": {
                          "type": "string",
                          "description": "(Optional) ID of the [subscription](#core-endpoints-subscriptions) that was created from this subscription request.\n"
                        }
                      }
                    },
                    "month": {
                      "description": "Name of the month on which to charge a customer. Must be lowercase. Only applies\nwhen the interval_unit is `yearly`.\n",
                      "example": "january",
                      "enum": [
                        "january",
                        "february",
                        "march",
                        "april",
                        "may",
                        "june",
                        "july",
                        "august",
                        "september",
                        "october",
                        "november",
                        "december"
                      ],
                      "nullable": true,
                      "type": "string"
                    },
                    "name": {
                      "type": "string",
                      "nullable": true,
                      "description": "Optional name for the subscription. This will be set as the description on each payment created. Must not exceed 255 characters.",
                      "example": "12 month subscription"
                    },
                    "payment_reference": {
                      "type": "string",
                      "nullable": true,
                      "description": "An optional payment reference. This will be set as the reference on each payment\ncreated and will appear on your customer's bank statement. See the documentation for\nthe [create payment endpoint](#payments-create-a-payment) for more details.\n<br />",
                      "example": "GOLDPLAN"
                    },
                    "start_date": {
                      "type": "string",
                      "nullable": true,
                      "description": "The date on which the first payment should be charged. If fulfilled after this date, this will be set as the mandate's `next_possible_charge_date`.\nWhen left blank and `month` or `day_of_month` are provided, this will be set to the date of the first payment.\nIf created without `month` or `day_of_month` this will be set as the mandate's `next_possible_charge_date`.\n",
                      "example": "2014-10-21",
                      "format": "date"
                    },
                    "retry_if_possible": {
                      "type": "boolean",
                      "description": "On failure, automatically retry payments using [intelligent retries](/success-plus/overview). Default is `false`. <p class=\"notice\"><strong>Important</strong>: To be able to use intelligent retries, Success+ needs to be enabled in [GoCardless dashboard](https://manage.gocardless.com/success-plus). </p>"
                    }
                  }
                },
                "instalment_schedule_request": {
                  "type": "object",
                  "nullable": true,
                  "description": "Request for an instalment schedule. Has to contain either `instalments_with_schedule` object or an array of `instalments_with_dates` objects",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Name of the instalment schedule, up to 100 chars. This name will also be\ncopied to the payments of the instalment schedule if you use schedule-based creation.",
                      "example": "Invoice 4404"
                    },
                    "currency": {
                      "type": "string",
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"USD\" and \"CAD\" are supported.",
                      "example": "USD"
                    },
                    "total_amount": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "The total amount of the instalment schedule, defined as the sum of all individual\npayments, in the lowest denomination for the currency (e.g. pence in GBP, cents in\nEUR). If the requested payment amounts do not sum up correctly, a validation error\nwill be returned.",
                      "example": 1000
                    },
                    "payment_reference": {
                      "type": "string",
                      "nullable": true,
                      "description": "An optional payment reference. This will be set as the reference on each payment\ncreated and will appear on your customer's bank statement. See the documentation for\nthe [create payment endpoint](#payments-create-a-payment) for more details.\n<br />",
                      "example": "GOLDPLAN"
                    },
                    "app_fee": {
                      "oneOf": [
                        {
                          "type": "string",
                          "nullable": true
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "The amount to be deducted from each payment as an app fee, to be paid to the partner integration which created the subscription, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                      "example": 100
                    },
                    "instalments_with_dates": {
                      "type": "array",
                      "nullable": true,
                      "description": "An explicit array of instalment payments, each specifying at least an `amount` and `charge_date`. See [create (with dates)](#instalment-schedules-create-with-dates)",
                      "example": [
                        {
                          "amount": 250,
                          "charge_date": "2020-11-03"
                        }
                      ],
                      "items": {
                        "type": "object",
                        "properties": {
                          "amount": {
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "integer"
                              }
                            ],
                            "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\nMinimum and maximum amounts vary by payment scheme. For more information, see [Transaction limits](https://support.gocardless.com/hc/en-gb/articles/115000309245-Transaction-limits)\n\nFor Variable Recurring Payments (VRP), this must not exceed the mandate's `max_amount_per_payment`\nconstraint.",
                            "example": 1000
                          },
                          "charge_date": {
                            "type": "string",
                            "nullable": true,
                            "description": "A future date on which the payment should be collected. If the date\nis before the next_possible_charge_date on the\n[mandate](#core-endpoints-mandates), it will be automatically rolled\nforwards to that date.",
                            "example": "2014-05-21",
                            "format": "date"
                          },
                          "description": {
                            "type": "string",
                            "nullable": true,
                            "description": "A human-readable description of the payment. This will be included in the notification email GoCardless sends to your customer if your organisation does not send its own notifications (see [compliance requirements](#appendix-compliance-requirements)).",
                            "example": "One-off upgrade fee"
                          }
                        }
                      }
                    },
                    "instalments_with_schedule": {
                      "type": "object",
                      "nullable": true,
                      "description": "Frequency of the payments you want to create, together with an array of payment\namounts to be collected, with a specified start date for the first payment.\nSee [create (with schedule)](#instalment-schedules-create-with-schedule)\n",
                      "properties": {
                        "start_date": {
                          "type": "string",
                          "nullable": true,
                          "description": "The date on which the first payment should be charged. Must be on or after the [mandate](#core-endpoints-mandates)'s `next_possible_charge_date`. When left blank and `month` or `day_of_month` are provided, this will be set to the date of the first payment. If created without `month` or `day_of_month` this will be set as the mandate's `next_possible_charge_date`",
                          "example": "2014-10-21",
                          "format": "date"
                        },
                        "interval": {
                          "type": "integer",
                          "description": "Number of `interval_units` between charge dates. Must be greater than or\nequal to `1`.\n",
                          "example": 1
                        },
                        "interval_unit": {
                          "description": "The unit of time between customer charge dates. One of `weekly`, `monthly` or `yearly`.",
                          "example": "monthly",
                          "enum": [
                            "weekly",
                            "monthly",
                            "yearly"
                          ],
                          "type": "string"
                        },
                        "amounts": {
                          "type": "array",
                          "description": "List of amounts of each instalment, in the lowest denomination for the\ncurrency (e.g. cents in USD).\n",
                          "items": {
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "integer"
                              }
                            ],
                            "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).\n\nMinimum and maximum amounts vary by payment scheme. For more information, see [Transaction limits](https://support.gocardless.com/hc/en-gb/articles/115000309245-Transaction-limits)\n\nFor Variable Recurring Payments (VRP), this must not exceed the mandate's `max_amount_per_payment`\nconstraint.",
                            "example": 1000
                          }
                        }
                      }
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
                    },
                    "links": {
                      "type": "object",
                      "description": "",
                      "properties": {
                        "instalment_schedule": {
                          "type": "string",
                          "description": "(Optional) ID of the [instalment_schedule](#core-endpoints-instalment-schedules) that was created from this instalment schedule request.\n"
                        }
                      }
                    },
                    "retry_if_possible": {
                      "type": "boolean",
                      "description": "On failure, automatically retry payments using [intelligent retries](/success-plus/overview). Default is `false`. <p class=\"notice\"><strong>Important</strong>: To be able to use intelligent retries, Success+ needs to be enabled in [GoCardless dashboard](https://manage.gocardless.com/success-plus). </p>"
                    }
                  }
                },
                "links": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "customer": {
                      "type": "string",
                      "description": "ID of the [customer](#core-endpoints-customers) that will be used for this request",
                      "example": "CU123"
                    },
                    "customer_billing_detail": {
                      "type": "string",
                      "description": "ID of the customer billing detail that will be used for this request"
                    },
                    "creditor": {
                      "type": "string",
                      "description": "ID of the associated [creditor](#core-endpoints-creditors).",
                      "example": "CR123"
                    },
                    "organisation": {
                      "type": "string",
                      "description": "ID of the associated organisation.",
                      "example": "OR123"
                    },
                    "customer_bank_account": {
                      "type": "string",
                      "description": "(Optional) ID of the [customer_bank_account](#core-endpoints-customer-bank-accounts) that will be used for this request",
                      "example": "BA123"
                    },
                    "bank_authorisation": {
                      "type": "string",
                      "description": "(Optional) ID of the [bank authorisation](#billing-requests-bank-authorisations) that was used to verify this request."
                    },
                    "payment_request": {
                      "type": "string",
                      "description": "(Optional) ID of the associated payment request",
                      "example": "PRQ123"
                    },
                    "payment_request_payment": {
                      "type": "string",
                      "description": "(Optional) ID of the [payment](#core-endpoints-payments) that was created from this payment request.",
                      "example": "PM123"
                    },
                    "mandate_request": {
                      "type": "string",
                      "description": "(Optional) ID of the associated mandate request",
                      "example": "MRQ123"
                    },
                    "mandate_request_mandate": {
                      "type": "string",
                      "description": "(Optional) ID of the [mandate](#core-endpoints-mandates) that was created from this mandate request. this mandate request.",
                      "example": "MD123"
                    },
                    "subscription_request": {
                      "type": "string",
                      "description": "(Optional) ID of the associated subscription request",
                      "example": "SBR123"
                    },
                    "subscription_request_subscription": {
                      "type": "string",
                      "description": "(Optional) ID of the [subscription](#core-endpoints-subscriptions) that was created from this subscription request.",
                      "example": "SB123"
                    },
                    "instalment_schedule_request": {
                      "type": "string",
                      "description": "(Optional) ID of the associated instalment schedule request",
                      "example": "ISR123"
                    },
                    "instalment_schedule_request_instalment_schedule": {
                      "type": "string",
                      "description": "(Optional) ID of the [instalment_schedule](#core-endpoints-instalment-schedules) that was created from this instalment schedule request.",
                      "example": "IS123"
                    },
                    "payment_provider": {
                      "type": "string",
                      "description": "(Optional) ID of the associated payment provider",
                      "example": "PP123"
                    }
                  }
                }
              }
            }
          },
          "meta": {
            "type": "object",
            "description": "Cursor pagination information",
            "properties": {
              "limit": {
                "type": "integer",
                "example": 50
              },
              "cursors": {
                "type": "object",
                "properties": {
                  "before": {
                    "type": "string",
                    "nullable": true,
                    "description": "Cursor pointing to the end of the desired set."
                  },
                  "after": {
                    "type": "string",
                    "nullable": true,
                    "description": "Cursor pointing to the start of the desired set."
                  }
                }
              }
            }
          }
        }
      },
      "billing_request_authorisation_source": {
        "title": "BillingRequestAuthorisationSource",
        "description": "This field is ACH specific, sometimes referred to as [SEC code](https://www.moderntreasury.com/learn/sec-codes).\n\nThis is the way that the payer gives authorisation to the merchant.\n  web: Authorisation is Internet Initiated or via Mobile Entry (maps to SEC code: WEB)\n  telephone: Authorisation is provided orally over telephone (maps to SEC code: TEL)\n  paper: Authorisation is provided in writing and signed, or similarly authenticated (maps to SEC code: PPD)\n",
        "enum": [
          "web",
          "telephone",
          "paper"
        ],
        "type": "string"
      },
      "billing_request_flow": {
        "type": "object",
        "title": "Billing Request Flows",
        "description": "Billing Request Flows can be created to enable a payer to authorise a payment created for a scheme with strong payer\nauthorisation (such as open banking single payments).",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier, beginning with \"BRF\".",
            "example": "BRF123"
          },
          "redirect_uri": {
            "type": "string",
            "nullable": true,
            "description": "URL that the payer can be redirected to after completing the request flow.",
            "example": "https://my-website.com/abc/callback"
          },
          "skip_success_screen": {
            "type": "boolean",
            "description": "If true, the payer will not be redirected to the success screen after completing the flow. A redirect_uri needs to be provided for this parameter to be taken into account."
          },
          "exit_uri": {
            "type": "string",
            "nullable": true,
            "description": "URL that the payer can be taken to if there isn't a way to progress ahead in flow, for example if the customer searches for a bank that doesn't exist or isn't supported on the scheme.",
            "example": "https://my-website.com/abc/callback"
          },
          "show_redirect_buttons": {
            "type": "boolean",
            "description": "If true, the payer will be able to see redirect action buttons on Thank You page. These action buttons will provide a way to connect back to the billing request flow app if opened within a mobile app. For successful flow, the button will take the payer back the billing request flow where they will see the success screen. For failure, button will take the payer to url being provided against exit_uri field."
          },
          "show_success_redirect_button": {
            "type": "boolean",
            "description": "If true, the payer will be able to see a redirect action button on the Success page. This action button will provide a way to redirect the payer to the given redirect_uri. This functionality is helpful when merchants do not want payers to be automatically redirected or on Android devices, where automatic redirections are not possible."
          },
          "authorisation_url": {
            "type": "string",
            "description": "URL for a GC-controlled flow which will allow the payer to fulfil the billing request",
            "example": "https://monzo.com/abc-123-things"
          },
          "created_at": {
            "type": "string",
            "description": "Timestamp when the flow was created",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "description": "Timestamp when the flow will expire. Each flow currently lasts for 7 days.",
            "format": "date-time"
          },
          "session_token": {
            "type": "string",
            "nullable": true,
            "description": "Session token populated when responding to the initialise action",
            "example": "sesh_123"
          },
          "auto_fulfil": {
            "type": "boolean",
            "description": "(Experimental feature) Fulfil the Billing Request on completion of the flow (true by default). Disabling the auto_fulfil is not allowed currently."
          },
          "lock_bank_account": {
            "type": "boolean",
            "description": "If true, the payer will not be able to change their bank account within the flow. If the bank_account details are collected as part of bank_authorisation then GC will set this value to true mid flow.\n\nYou can only lock bank account if these have already been completed as a part of the billing request.\n"
          },
          "lock_currency": {
            "type": "boolean",
            "description": "If true, the payer will not be able to change their currency/scheme manually within the flow. Note that this only applies to the mandate only flows - currency/scheme can never be changed when there is a specified subscription or payment."
          },
          "lock_customer_details": {
            "type": "boolean",
            "description": "If true, the payer will not be able to edit their customer details within the flow. If the customer details are collected as part of bank_authorisation then GC will set this value to true mid flow.\n\nYou can only lock customer details if these have already been completed as a part of the billing request.\n"
          },
          "prefilled_customer": {
            "type": "object",
            "nullable": true,
            "description": "Customer information used to prefill the payment page so your customer doesn't have to re-type details you already hold about them. It will be stored unvalidated and the customer will be able to review and amend it before completing the form.",
            "properties": {
              "email": {
                "type": "string",
                "nullable": true,
                "description": "Customer's email address.",
                "example": "user@example.com"
              },
              "given_name": {
                "type": "string",
                "nullable": true,
                "description": "Customer's first name.",
                "example": "Frank"
              },
              "family_name": {
                "type": "string",
                "nullable": true,
                "description": "Customer's surname.",
                "example": "Osborne"
              },
              "company_name": {
                "type": "string",
                "nullable": true,
                "description": "Customer's company name. Company name should only be provided if `given_name` and `family_name` are null.",
                "example": "Hamilton Trading Ltd."
              },
              "address_line1": {
                "type": "string",
                "nullable": true,
                "description": "The first line of the customer's address.",
                "example": "221B Baker Street"
              },
              "address_line2": {
                "type": "string",
                "nullable": true,
                "description": "The second line of the customer's address.",
                "example": "Marylebone"
              },
              "address_line3": {
                "type": "string",
                "nullable": true,
                "description": "The third line of the customer's address.",
                "example": "City of Westminster"
              },
              "city": {
                "type": "string",
                "nullable": true,
                "description": "The city of the customer's address.",
                "example": "London"
              },
              "region": {
                "type": "string",
                "nullable": true,
                "description": "The customer's address region, county or department.",
                "example": "Greater London"
              },
              "postal_code": {
                "type": "string",
                "nullable": true,
                "description": "The customer's postal code.",
                "example": "NW1 6XE"
              },
              "country_code": {
                "type": "string",
                "nullable": true,
                "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                "example": "GB"
              },
              "swedish_identity_number": {
                "type": "string",
                "nullable": true,
                "description": "For Swedish customers only. The civic/company number (personnummer, samordningsnummer, or organisationsnummer) of the customer.",
                "example": "556564-5404"
              },
              "danish_identity_number": {
                "type": "string",
                "nullable": true,
                "description": "For Danish customers only. The civic/company number (CPR or CVR) of the customer.",
                "example": "220550-6218"
              }
            }
          },
          "prefilled_bank_account": {
            "type": "object",
            "nullable": true,
            "description": "Bank account information used to prefill the payment page so your customer doesn't have to re-type details you already hold about them. It will be stored unvalidated and the customer will be able to review and amend it before completing the form.",
            "properties": {
              "account_type": {
                "description": "Bank account type for USD-denominated bank accounts. Must not be provided for bank accounts in other currencies. See [local details](#local-bank-details-united-states) for more information.",
                "example": "savings",
                "enum": [
                  "savings",
                  "checking"
                ],
                "nullable": true,
                "type": "string"
              }
            }
          },
          "language": {
            "type": "string",
            "nullable": true,
            "description": "Sets the default language of the Billing Request Flow and the customer. [ISO 639-1](https://en.wikipedia.org/wiki/List_of_ISO_639-1_codes) code.",
            "example": "en"
          },
          "links": {
            "type": "object",
            "description": "",
            "properties": {
              "billing_request": {
                "type": "string",
                "description": "ID of the [billing request](#billing-requests-billing-requests) against which this flow was created.",
                "example": "BRQ123"
              }
            }
          },
          "customer_details_captured": {
            "type": "boolean",
            "description": "Identifies whether a Billing Request belongs to a specific customer"
          }
        }
      },
      "billing_request_flow_id": {
        "type": "string",
        "title": "BillingRequestFlowId",
        "description": "Unique identifier, beginning with \"BRF\".",
        "example": "BRF123"
      },
      "billing_request_flow_identity": {
        "type": "string",
        "title": "BillingRequestFlowIdentity",
        "description": "Unique identifier, beginning with \"BRF\".",
        "example": "BRF123"
      },
      "billing_request_flow_auto_fulfil": {
        "type": "boolean",
        "title": "BillingRequestFlowAutoFulfil",
        "description": "(Experimental feature) Fulfil the Billing Request on completion of the flow (true by default). Disabling the auto_fulfil is not allowed currently."
      },
      "billing_request_flow_customer_details_captured": {
        "type": "boolean",
        "title": "BillingRequestFlowCustomerDetailsCaptured",
        "description": "Identifies whether a Billing Request belongs to a specific customer"
      },
      "billing_request_flow_redirect_uri": {
        "type": "string",
        "nullable": true,
        "title": "BillingRequestFlowRedirectUri",
        "description": "URL that the payer can be redirected to after completing the request flow.",
        "example": "https://my-website.com/abc/callback"
      },
      "billing_request_flow_exit_uri": {
        "type": "string",
        "nullable": true,
        "title": "BillingRequestFlowExitUri",
        "description": "URL that the payer can be taken to if there isn't a way to progress ahead in flow, for example if the customer searches for a bank that doesn't exist or isn't supported on the scheme.",
        "example": "https://my-website.com/abc/callback"
      },
      "billing_request_flow_authorisation_url": {
        "type": "string",
        "title": "BillingRequestFlowAuthorisationUrl",
        "description": "URL for a GC-controlled flow which will allow the payer to fulfil the billing request",
        "example": "https://monzo.com/abc-123-things"
      },
      "billing_request_flow_event_name": {
        "type": "string",
        "title": "BillingRequestFlowEventName",
        "description": "name of the billing request flow UI event",
        "example": "collect_customer_details_started"
      },
      "billing_request_flow_created_at": {
        "type": "string",
        "title": "BillingRequestFlowCreatedAt",
        "description": "Timestamp when the flow was created",
        "format": "date-time"
      },
      "billing_request_flow_expires_at": {
        "type": "string",
        "title": "BillingRequestFlowExpiresAt",
        "description": "Timestamp when the flow will expire. Each flow currently lasts for 7 days.",
        "format": "date-time"
      },
      "billing_request_flow_lock_currency": {
        "type": "boolean",
        "title": "BillingRequestFlowLockCurrency",
        "description": "If true, the payer will not be able to change their currency/scheme manually within the flow. Note that this only applies to the mandate only flows - currency/scheme can never be changed when there is a specified subscription or payment."
      },
      "billing_request_flow_lock_customer_details": {
        "type": "boolean",
        "title": "BillingRequestFlowLockCustomerDetails",
        "description": "If true, the payer will not be able to edit their customer details within the flow. If the customer details are collected as part of bank_authorisation then GC will set this value to true mid flow.\n\nYou can only lock customer details if these have already been completed as a part of the billing request.\n"
      },
      "billing_request_flow_lock_bank_account": {
        "type": "boolean",
        "title": "BillingRequestFlowLockBankAccount",
        "description": "If true, the payer will not be able to change their bank account within the flow. If the bank_account details are collected as part of bank_authorisation then GC will set this value to true mid flow.\n\nYou can only lock bank account if these have already been completed as a part of the billing request.\n"
      },
      "billing_request_flow_show_redirect_buttons": {
        "type": "boolean",
        "title": "BillingRequestFlowShowRedirectButtons",
        "description": "If true, the payer will be able to see redirect action buttons on Thank You page. These action buttons will provide a way to connect back to the billing request flow app if opened within a mobile app. For successful flow, the button will take the payer back the billing request flow where they will see the success screen. For failure, button will take the payer to url being provided against exit_uri field."
      },
      "billing_request_flow_show_success_redirect_button": {
        "type": "boolean",
        "title": "BillingRequestFlowShowSuccessRedirectButton",
        "description": "If true, the payer will be able to see a redirect action button on the Success page. This action button will provide a way to redirect the payer to the given redirect_uri. This functionality is helpful when merchants do not want payers to be automatically redirected or on Android devices, where automatic redirections are not possible."
      },
      "billing_request_flow_session_token": {
        "type": "string",
        "nullable": true,
        "title": "BillingRequestFlowSessionToken",
        "description": "Session token populated when responding to the initialise action",
        "example": "sesh_123"
      },
      "billing_request_flow_skip_success_screen": {
        "type": "boolean",
        "title": "BillingRequestFlowSkipSuccessScreen",
        "description": "If true, the payer will not be redirected to the success screen after completing the flow. A redirect_uri needs to be provided for this parameter to be taken into account."
      },
      "billing_request_flow_prefilled_customer": {
        "type": "object",
        "nullable": true,
        "title": "BillingRequestFlowPrefilledCustomer",
        "description": "Customer information used to prefill the payment page so your customer doesn't have to re-type details you already hold about them. It will be stored unvalidated and the customer will be able to review and amend it before completing the form.",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true,
            "description": "Customer's email address.",
            "example": "user@example.com"
          },
          "given_name": {
            "type": "string",
            "nullable": true,
            "description": "Customer's first name.",
            "example": "Frank"
          },
          "family_name": {
            "type": "string",
            "nullable": true,
            "description": "Customer's surname.",
            "example": "Osborne"
          },
          "company_name": {
            "type": "string",
            "nullable": true,
            "description": "Customer's company name. Company name should only be provided if `given_name` and `family_name` are null.",
            "example": "Hamilton Trading Ltd."
          },
          "address_line1": {
            "type": "string",
            "nullable": true,
            "description": "The first line of the customer's address.",
            "example": "221B Baker Street"
          },
          "address_line2": {
            "type": "string",
            "nullable": true,
            "description": "The second line of the customer's address.",
            "example": "Marylebone"
          },
          "address_line3": {
            "type": "string",
            "nullable": true,
            "description": "The third line of the customer's address.",
            "example": "City of Westminster"
          },
          "city": {
            "type": "string",
            "nullable": true,
            "description": "The city of the customer's address.",
            "example": "London"
          },
          "region": {
            "type": "string",
            "nullable": true,
            "description": "The customer's address region, county or department.",
            "example": "Greater London"
          },
          "postal_code": {
            "type": "string",
            "nullable": true,
            "description": "The customer's postal code.",
            "example": "NW1 6XE"
          },
          "country_code": {
            "type": "string",
            "nullable": true,
            "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
            "example": "GB"
          },
          "swedish_identity_number": {
            "type": "string",
            "nullable": true,
            "description": "For Swedish customers only. The civic/company number (personnummer, samordningsnummer, or organisationsnummer) of the customer.",
            "example": "556564-5404"
          },
          "danish_identity_number": {
            "type": "string",
            "nullable": true,
            "description": "For Danish customers only. The civic/company number (CPR or CVR) of the customer.",
            "example": "220550-6218"
          }
        }
      },
      "billing_request_flow_prefilled_bank_account": {
        "type": "object",
        "nullable": true,
        "title": "BillingRequestFlowPrefilledBankAccount",
