    "/bank_details_lookups": {
      "post": {
        "operationId": "create_bank_details_lookup",
        "summary": "Perform a bank details lookup",
        "description": "Performs a bank details lookup. As part of the lookup, a modulus check and\nreachability check are performed.\n\nFor UK or Eurozone-based bank accounts, where an account holder name is provided \n(and an account number, a sort code or an IBAN are already present), we verify that \nthe account holder name and bank account number match the details held by the relevant bank. \nIf there is no match, the endpoint will return a 422 - validation error on account_holder_name: \n\"Account holder name does not match bank account details provided\".\n\nIf your request returns an [error](#api-usage-errors) or the `available_debit_schemes`\nattribute is an empty array, you will not be able to collect payments from the\nspecified bank account. GoCardless may be able to collect payments from an account\neven if no `bic` is returned.\n\nBank account details may be supplied using [local details](#appendix-local-bank-details) or an IBAN.\n\n_ACH scheme_ For compliance reasons, an extra validation step is done using\na third-party provider to make sure the customer's bank account can accept\nDirect Debit. If a bank account is discovered to be closed or invalid, the\ncustomer is requested to adjust the account number/routing number and\nsucceed in this check to continue with the flow.\n\n_Note:_ Usage of this endpoint is monitored. If your organisation relies on GoCardless for\nmodulus or reachability checking but not for payment collection, please get in touch.",
        "tags": [
          "Bank Details Lookup"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GoCardlessVersionHeader"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/bank_details_lookup_single_resource_response"
                }
              }
            },
            "description": "Resource created successfully"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bank_details_lookups": {
                    "type": "object",
                    "properties": {
                      "iban": {
                        "$ref": "#/components/schemas/bank_details_lookup_iban"
                      },
                      "account_number": {
                        "$ref": "#/components/schemas/bank_details_lookup_account_number"
                      },
                      "bank_code": {
                        "$ref": "#/components/schemas/bank_details_lookup_bank_code"
                      },
                      "branch_code": {
                        "$ref": "#/components/schemas/bank_details_lookup_branch_code"
                      },
                      "country_code": {
                        "$ref": "#/components/schemas/bank_details_lookup_country_code"
                      },
                      "account_holder_name": {
                        "$ref": "#/components/schemas/bank_details_lookup_account_holder_name"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "Ruby",
            "label": "Ruby",
            "source": "@client.bank_details_lookups.create(\n  params: {\n    country_code: \"GB\",\n    account_number: \"55779911\",\n    branch_code: \"200000\"\n  }\n)"
          },
          {
            "lang": "Python",
            "label": "Python",
            "source": "client.bank_details_lookups.create(params={\n  \"account_number\": \"55779911\",\n  \"branch_code\": \"200000\",\n  \"country_code\": \"GB\"\n})"
          },
          {
            "lang": "JavaScript",
            "label": "JavaScript",
            "source": "const bankDetailsLookup = await client.bankDetailsLookups.create({\n  account_number: \"55779911\",\n  branch_code: \"200000\",\n  country_code: \"GB\"\n});"
          },
          {
            "lang": "PHP",
            "label": "PHP",
            "source": "$client->bankDetailsLookups()->create([\n  \"params\" => [\"account_number\" => \"55779911\",\n               \"branch_code\" => \"200000\",\n               \"country_code\" => \"GB\"]\n]);"
          },
          {
            "lang": "Java",
            "label": "Java",
            "source": "BankDetailsLookup bankDetailsLookup = client.bankDetailsLookups().create()\n  .withAccountNumber(\"55779911\")\n  .withBranchCode(\"200000\")\n  .withCountryCode(\"GB\")\n  .execute();"
          },
          {
            "lang": "Go",
            "label": "Go",
            "source": "bankDetailsLookupCreateParams := gocardless.BankDetailsLookupCreateParams{\n  AccountNumber: \"55779911\",\n  BranchCode:    \"200000\",\n  CountryCode:   \"GB\",\n}\n\nbankDetailsLookup, err := client.BankDetailsLookups.Create(ctx, bankDetailsLookupCreateParams)"
          },
          {
            "lang": "C#",
            "label": ".NET",
            "source": "var bankDetailsRequest = new GoCardless.Services.BankDetailsLookupCreateRequest()\n{\n    AccountNumber = \"55779911\",\n    BranchCode = \"200000\",\n    CountryCode = \"GB\"\n};\n\nvar bankDetailsResponse = await client.BankDetailsLookups.CreateAsync(bankDetailsRequest);\nGoCardless.Resources.BankDetailsLookup bankDetails = bankDetailsResponse.BankDetailsLookup;"
          },
          {
            "lang": "HTTP",
            "label": "HTTP",
            "source": "POST https://api.gocardless.com/bank_details_lookups HTTP/1.1\nContent-Type: application/json\n{\n  \"bank_details_lookups\": {\n    \"account_number\": \"55779911\",\n    \"branch_code\": \"200000\",\n    \"country_code\": \"GB\"\n  }\n}\n\nHTTP/1.1 200 OK\nContent-Type: application/json\n{\n  \"bank_details_lookups\": {\n    \"available_debit_schemes\": [\"bacs\"],\n    \"bank_name\": \"BARCLAYS BANK PLC\",\n    \"bic\": \"BARCGB22XXX\"\n  }\n}"
          }
        ]
      }
    },
    "/billing_requests": {
      "post": {
        "operationId": "create_billing_request",
        "summary": "Create a Billing Request",
        "description": "<p class=\"notice\"><strong>Important</strong>: All properties associated with <code>subscription_request</code> and <code>instalment_schedule_request</code> are only supported for ACH and PAD schemes.</p>\n\n<p class=\"notice\"><strong>Note</strong>: Pay by Bank is only available for transactions in GBP with your customers in the UK and for EUR with your customers in supported Eurozone countries. We will be adding other countries soon.</p>\n\n<p class=\"notice--warning\"><strong>Warning</strong>: by default, the ability to provide a custom mandate reference is switched off. The banking system rules for valid references are quite complex, and we recommend allowing GoCardless to generate it. If you would like to provide custom references, please contact support.</p>",
        "tags": [
          "Billing Request"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GoCardlessVersionHeader"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/billing_request_single_resource_response"
                }
              }
            },
            "description": "Resource created successfully"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "billing_requests": {
                    "type": "object",
                    "properties": {
                      "mandate_request": {
                        "type": "object",
                        "properties": {
                          "currency": {
                            "$ref": "#/components/schemas/billing_request_currency"
                          },
                          "scheme": {
                            "$ref": "#/components/schemas/billing_request_scheme"
                          },
                          "verify": {
                            "$ref": "#/components/schemas/billing_request_mandate_request_verify"
                          },
                          "metadata": {
                            "$ref": "#/components/schemas/customer_metadata"
                          },
                          "reference": {
                            "$ref": "#/components/schemas/mandate_reference"
                          },
                          "description": {
                            "$ref": "#/components/schemas/billing_request_description"
                          },
                          "constraints": {
                            "$ref": "#/components/schemas/billing_request_mandate_request_constraints"
                          },
                          "sweeping": {
                            "$ref": "#/components/schemas/billing_request_sweeping"
                          },
                          "authorisation_source": {
                            "$ref": "#/components/schemas/billing_request_authorisation_source"
                          },
                          "funds_settlement": {
                            "$ref": "#/components/schemas/billing_request_funds_settlement"
                          },
                          "consent_type": {
                            "$ref": "#/components/schemas/billing_request_consent_type"
                          }
                        }
                      },
                      "payment_request": {
                        "type": "object",
                        "properties": {
                          "description": {
                            "$ref": "#/components/schemas/billing_request_description"
                          },
                          "currency": {
