                  "format": "date-time"
                },
                "authorised_at": {
                  "type": "string",
                  "nullable": true,
                  "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when the user has been authorised.",
                  "example": "2020-01-01T12:00:00.000Z",
                  "format": "date-time"
                },
                "links": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "billing_request": {
                      "type": "string",
                      "description": "ID of the [billing request](#billing-requests-billing-requests) against which this authorisation was created.",
                      "example": "BRQ123"
                    },
                    "institution": {
                      "type": "string",
                      "description": "ID of the [institution](#billing-requests-institutions) against which this authorisation was created.",
                      "example": "monzo"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "bank_details_lookup": {
        "type": "object",
        "title": "Bank Details Lookups",
        "description": "Look up the name and reachability of a bank account.",
        "properties": {
          "bank_name": {
            "type": "string",
            "nullable": true,
            "description": "The name of the bank with which the account is held (if available).",
            "example": "NATWEST BANK PLC"
          },
          "bic": {
            "type": "string",
            "nullable": true,
            "description": "ISO 9362 SWIFT BIC of the bank with which the account is held.\n\n<p class=\"notice\">Even if no BIC is returned for an account, GoCardless may still be able to collect payments from it - you should refer to the <code>available_debit_schemes</code> attribute to determine reachability.</p>",
            "example": "BARCGB22XXX"
          },
          "available_debit_schemes": {
            "type": "array",
            "description": "Array of [schemes](#mandates_scheme) supported for this bank account. This will be an empty array if the bank account is not reachable by any schemes.",
            "items": {
              "description": "A bank payment scheme for this bank account.",
              "example": "bacs",
              "enum": [
                "ach",
                "autogiro",
                "bacs",
                "becs",
                "becs_nz",
                "betalingsservice",
                "faster_payments",
                "pad",
                "pay_to",
                "sepa_core"
              ],
              "nullable": true,
              "type": "string"
            }
          }
        }
      },
      "bank_details_lookup_iban": {
        "type": "string",
        "nullable": true,
        "title": "BankDetailsLookupIban",
        "description": "International Bank Account Number. Alternatively you can provide [local details](#appendix-local-bank-details).",
        "example": "GB60BARC20000055779911"
      },
      "bank_details_lookup_account_number": {
        "type": "string",
        "nullable": true,
        "title": "BankDetailsLookupAccountNumber",
        "description": "Bank account number - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`.",
        "example": "55779912"
      },
      "bank_details_lookup_bank_code": {
        "type": "string",
        "nullable": true,
        "title": "BankDetailsLookupBankCode",
        "description": "Bank code - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`.",
        "example": "20041"
      },
      "bank_details_lookup_branch_code": {
        "type": "string",
        "nullable": true,
        "title": "BankDetailsLookupBranchCode",
        "description": "Branch code - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`.",
        "example": "01005"
      },
      "bank_details_lookup_country_code": {
        "type": "string",
        "nullable": true,
        "title": "BankDetailsLookupCountryCode",
        "description": "[ISO 3166-1](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements) alpha-2 code. Must be provided if specifying local details.",
        "example": "GB"
      },
      "bank_details_lookup_bank_name": {
        "type": "string",
        "nullable": true,
        "title": "BankDetailsLookupBankName",
        "description": "The name of the bank with which the account is held (if available).",
        "example": "NATWEST BANK PLC"
      },
      "bank_details_lookup_account_holder_name": {
        "type": "string",
        "nullable": true,
        "title": "BankDetailsLookupAccountHolderName",
        "description": "The account holder name associated with the account number (if available). If provided and the country code is GB, a payer name verification will be performed.",
        "example": "John Smith"
      },
      "bank_details_lookup_bic": {
        "type": "string",
        "nullable": true,
        "title": "BankDetailsLookupBic",
        "description": "ISO 9362 SWIFT BIC of the bank with which the account is held.\n\n<p class=\"notice\">Even if no BIC is returned for an account, GoCardless may still be able to collect payments from it - you should refer to the <code>available_debit_schemes</code> attribute to determine reachability.</p>",
        "example": "BARCGB22XXX"
      },
      "bank_details_lookup_available_debit_schemes": {
        "type": "array",
        "title": "BankDetailsLookupAvailableDebitSchemes",
        "description": "Array of [schemes](#mandates_scheme) supported for this bank account. This will be an empty array if the bank account is not reachable by any schemes.",
        "items": {
          "description": "A bank payment scheme for this bank account.",
          "example": "bacs",
          "enum": [
            "ach",
            "autogiro",
            "bacs",
            "becs",
            "becs_nz",
            "betalingsservice",
            "faster_payments",
            "pad",
            "pay_to",
            "sepa_core"
          ],
          "nullable": true,
          "type": "string"
        }
      },
      "bank_details_lookup_scheme": {
        "title": "BankDetailsLookupScheme",
        "description": "A bank payment scheme for this bank account.",
        "example": "bacs",
        "enum": [
          "ach",
          "autogiro",
          "bacs",
          "becs",
          "becs_nz",
          "betalingsservice",
          "faster_payments",
          "pad",
