    "/customer_bank_accounts": {
      "post": {
        "operationId": "create_customer_bank_account",
        "summary": "Create a customer bank account",
        "description": "Creates a new customer bank account object.\n\nThere are three different ways to supply bank account details:\n\n- [Local details](#appendix-local-bank-details)\n\n- IBAN\n\n- [Customer Bank Account Tokens](#javascript-flow-create-a-customer-bank-account-token)\n\nFor more information on the different fields required in each country, see [local bank details](#appendix-local-bank-details).\n\n<p class=\"restricted-notice\"><strong>Restricted</strong>: this endpoint is [restricted](#overview-restrictions) to [GoCardless Pro](https://gocardless.com/pricing) and [GoCardless Enterprise](https://gocardless.com/pricing) accounts with approved payment pages.</p>\n\n<p class=\"notice\"><strong>Note</strong>: this endpoint is a legacy API endpoint and does not support GoCardless' newest features. We recommend using the [Billing Requests API](/billing-requests/overview) instead.</p>",
        "tags": [
          "Customer Bank Account"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GoCardlessVersionHeader"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/customer_bank_account_single_resource_response"
