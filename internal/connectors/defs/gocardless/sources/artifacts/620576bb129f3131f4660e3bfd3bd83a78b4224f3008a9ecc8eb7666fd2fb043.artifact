    "/payout_items": {
      "get": {
        "operationId": "list_payout_item",
        "summary": "Get all payout items in a single payout",
        "description": "Returns a [cursor-paginated](#api-usage-cursor-pagination) list of items in the payout.\n\n<strong>This endpoint only serves requests for payouts created in the last 6 months. Requests for older payouts will return an HTTP status <code>410 Gone</code>.</strong>\n",
        "tags": [
          "Payout Item"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GoCardlessVersionHeader"
          }
        ],
        "responses": {
          "200": {
