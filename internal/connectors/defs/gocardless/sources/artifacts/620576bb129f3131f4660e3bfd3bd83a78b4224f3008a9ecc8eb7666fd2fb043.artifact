      "creditor_single_copied_creditor_detail_attributes_resource_response": {
        "type": "object",
        "title": "CreditorSingleCopiedCreditorDetailAttributesResourceResponse",
        "description": "",
        "properties": {
          "copied_creditor_detail_attributes": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              },
              "cascaded_attributes": {
                "type": "object"
              },
              "links": {
                "type": "object",
                "properties": {
                  "creditor": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "creditor_bank_account": {
        "type": "object",
        "title": "Creditor Bank Accounts",
        "description": "Creditor Bank Accounts hold the bank details of a [creditor](#core-endpoints-creditors). These are the bank accounts which your [payouts](#core-endpoints-payouts) will be sent to.\n\nNote that creditor bank accounts must be unique, and so you will encounter a `bank_account_exists` error if you try to create a duplicate bank account. You may wish to handle this by updating the existing record instead, the ID of which will be provided as `links[creditor_bank_account]` in the error response.\n\n<p class=\"restricted-notice\"><strong>Restricted</strong>: This API is not available for partner integrations.</p>",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier, beginning with \"BA\".",
            "example": "BA123"
          },
          "created_at": {
            "type": "string",
            "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
            "example": "2014-01-01T12:00:00.000Z",
            "format": "date-time"
          },
          "account_holder_name": {
            "type": "string",
            "description": "Name of the account holder, as known by the bank. Usually this is the same as the name stored with the linked [creditor](#core-endpoints-creditors). This field will be transliterated, upcased and truncated to 18 characters.",
            "example": "Billie Jean"
          },
          "account_number_ending": {
            "type": "string",
            "description": "The last few digits of the account number. Currently 4 digits for NZD bank accounts and 2 digits for other currencies.",
            "example": "1234"
          },
          "account_type": {
            "description": "Bank account type. Required for USD-denominated bank accounts. Must not be provided for bank accounts in other currencies. See [local details](#local-bank-details-united-states) for more information.",
            "example": "savings",
            "enum": [
              "savings",
              "checking"
            ],
            "nullable": true,
            "type": "string"
          },
          "country_code": {
            "type": "string",
            "nullable": true,
            "description": "[ISO 3166-1 alpha-2 code](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements). Defaults to the country code of the `iban` if supplied, otherwise is required.",
            "example": "GB"
          },
          "currency": {
            "type": "string",
            "nullable": true,
            "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
            "example": "EUR"
          },
          "bank_name": {
            "type": "string",
            "description": "Name of bank, taken from the bank details.",
            "example": "BARCLAYS BANK PLC"
          },
          "enabled": {
            "type": "boolean",
            "description": "Boolean value showing whether the bank account is enabled or disabled.",
            "example": true
          },
          "metadata": {
            "type": "object",
            "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
          },
          "links": {
            "type": "object",
            "description": "",
            "properties": {
              "creditor": {
                "type": "string",
                "description": "ID of the [creditor](#core-endpoints-creditors) that owns this bank account.",
                "example": "CR123"
              }
            }
          },
          "verification_status": {
            "description": "Verification status of the Bank Account. Can be one of `pending`, `in_review` or `successful`",
            "example": "successful",
            "enum": [
              "pending",
              "in_review",
              "successful",
              "could_not_verify"
            ],
            "type": "string"
          }
        }
      },
      "creditor_bank_account_id": {
        "type": "string",
        "title": "CreditorBankAccountId",
        "description": "Unique identifier, beginning with \"BA\".",
        "example": "BA123"
      },
      "creditor_bank_account_identity": {
        "type": "string",
        "title": "CreditorBankAccountIdentity",
        "description": "Unique identifier, beginning with \"BA\".",
        "example": "BA123"
      },
      "creditor_bank_account_created_at": {
        "type": "string",
        "title": "CreditorBankAccountCreatedAt",
        "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
        "example": "2014-01-01T12:00:00.000Z",
        "format": "date-time"
      },
      "creditor_bank_account_account_holder_name": {
        "type": "string",
        "title": "CreditorBankAccountAccountHolderName",
        "description": "Name of the account holder, as known by the bank. Usually this is the same as the name stored with the linked [creditor](#core-endpoints-creditors). This field will be transliterated, upcased and truncated to 18 characters.",
        "example": "Billie Jean"
      },
      "creditor_bank_account_account_number_ending": {
        "type": "string",
        "title": "CreditorBankAccountAccountNumberEnding",
        "description": "The last few digits of the account number. Currently 4 digits for NZD bank accounts and 2 digits for other currencies.",
        "example": "1234"
      },
      "creditor_bank_account_country_code": {
        "type": "string",
        "nullable": true,
        "title": "CreditorBankAccountCountryCode",
        "description": "[ISO 3166-1 alpha-2 code](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements). Defaults to the country code of the `iban` if supplied, otherwise is required.",
        "example": "GB"
      },
      "creditor_bank_account_currency": {
        "type": "string",
        "nullable": true,
        "title": "CreditorBankAccountCurrency",
        "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
        "example": "EUR"
      },
      "creditor_bank_account_bank_name": {
        "type": "string",
        "title": "CreditorBankAccountBankName",
        "description": "Name of bank, taken from the bank details.",
        "example": "BARCLAYS BANK PLC"
      },
      "creditor_bank_account_enabled": {
        "type": "boolean",
        "title": "CreditorBankAccountEnabled",
        "description": "Boolean value showing whether the bank account is enabled or disabled.",
        "example": true
      },
      "creditor_bank_account_account_number": {
        "type": "string",
        "nullable": true,
        "title": "CreditorBankAccountAccountNumber",
        "description": "Bank account number - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`.",
        "example": "55779911"
      },
      "creditor_bank_account_bank_code": {
        "type": "string",
        "nullable": true,
        "title": "CreditorBankAccountBankCode",
        "description": "Bank code - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`."
      },
      "creditor_bank_account_branch_code": {
        "type": "string",
        "nullable": true,
        "title": "CreditorBankAccountBranchCode",
        "description": "Branch code - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`.",
        "example": "20-00-00"
      },
      "creditor_bank_account_account_type": {
        "title": "CreditorBankAccountAccountType",
        "description": "Bank account type. Required for USD-denominated bank accounts. Must not be provided for bank accounts in other currencies. See [local details](#local-bank-details-united-states) for more information.",
        "example": "savings",
        "enum": [
          "savings",
          "checking"
        ],
        "nullable": true,
        "type": "string"
      },
      "creditor_bank_account_iban": {
        "type": "string",
        "nullable": true,
        "title": "CreditorBankAccountIban",
        "description": "International Bank Account Number. Alternatively you can provide [local details](#appendix-local-bank-details). IBANs are not accepted for Swedish bank accounts denominated in SEK - you must supply [local details](#local-bank-details-sweden).",
        "example": "GB60BARC20000055779911"
      },
      "creditor_bank_account_set_as_default_payout_account": {
        "type": "boolean",
        "title": "CreditorBankAccountSetAsDefaultPayoutAccount",
        "description": "Defaults to `true`. When this is set to `true`, it will cause this bank account to be set as the account that GoCardless will pay out to."
      },
