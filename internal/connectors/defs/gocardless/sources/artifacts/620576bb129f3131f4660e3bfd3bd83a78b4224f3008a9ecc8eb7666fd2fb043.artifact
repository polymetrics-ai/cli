          "GBP"
        ],
        "type": "string"
      },
      "outbound_payment_execution_date": {
        "type": "string",
        "title": "OutboundPaymentExecutionDate",
        "description": "A future date on which the outbound payment should be sent.\nIf not specified, the payment will be sent as soon as possible.",
        "example": "2024-08-31",
        "format": "date"
      },
      "outbound_payment_description": {
        "type": "string",
        "title": "OutboundPaymentDescription",
        "description": "A human-readable description of the outbound payment",
        "example": "Reward Payment (August 2024)"
      },
      "outbound_payment_reference": {
        "type": "string",
        "title": "OutboundPaymentReference",
        "description": "An optional reference that will appear on your customer's bank statement.\nThe character limit for this reference is dependent on the scheme.<br />\n<strong>Faster Payments</strong> - 18 characters, including: \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 &-./\"<br />",
        "example": "GC-QC2FI7GBEW7VCXL"
      },
      "outbound_payment_metadata": {
        "type": "object",
        "title": "OutboundPaymentMetadata",
        "description": "Key-value store of custom data. Up to 3 keys are permitted, with\nkey names up to 50 characters and values up to 500 characters."
      },
      "outbound_payment_is_withdrawal": {
        "type": "boolean",
        "title": "OutboundPaymentIsWithdrawal",
        "description": "Indicates whether the outbound payment is a withdrawal to your verified business bank account.",
        "example": true
      },
      "outbound_payment_created_at": {
        "type": "string",
        "title": "OutboundPaymentCreatedAt",
        "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when the outbound payment was created.",
        "example": "2024-01-01T12:00:00.001Z",
        "format": "date-time"
      },
      "outbound_payment_verifications": {
        "type": "object",
        "nullable": true,
        "title": "OutboundPaymentVerifications",
        "description": "Contains details of the verifications performed for the outbound payment",
        "properties": {
          "recipient_bank_account_holder_verification": {
            "type": "object",
            "nullable": true,
            "description": "Checks if the recipient owns the provided bank account",
            "properties": {
              "type": {
                "description": "Type of the verification that has been performed\neg. [Confirmation of Payee](https://www.wearepay.uk/what-we-do/overlay-services/confirmation-of-payee/)",
                "example": "confirmation_of_payee",
                "enum": [
                  "confirmation_of_payee"
                ],
                "type": "string"
              },
              "result": {
                "description": "Result of the verification, could be one of\n\n- `full_match`: The verification has confirmed that the account name exactly matches the details provided.\n- `partial_match`: The verification has confirmed that the account name is similar but does not match to the details provided.\n- `no_match`: The verification concludes the provided name does not match the account details.\n- `unable_to_match`: The verification could not be performed due to recipient bank issues or technical issues",
                "example": "partial_match",
                "enum": [
                  "full_match",
                  "partial_match",
                  "no_match",
                  "unable_to_match"
                ],
                "type": "string"
              },
              "actual_account_name": {
                "type": "string",
                "nullable": true,
                "description": "The actual account name returned by the recipient's bank, populated only in the case of a partial match.",
                "example": "Jo Doe"
              }
            }
          }
        }
      },
      "outbound_payment_status": {
        "title": "OutboundPaymentStatus",
        "description": "One of:\n\n- `verifying`: The payment has been [created](#outbound-payments-create-an-outbound-payment) and the verification process has begun.\n- `pending_approval`: The payment is awaiting [approval](#outbound-payments-approve-an-outbound-payment).\n- `scheduled`: The payment has passed verification & [approval](#outbound-payments-approve-an-outbound-payment), but processing has not yet begun.\n- `executing`: The execution date has arrived and the payment has been placed in queue for processing.\n- `executed`: The payment has been accepted by the scheme and is now on its way to the recipient.\n- `cancelled`: The payment has been [cancelled](#outbound-payments-cancel-an-outbound-payment) or was not [approved](#outbound-payments-approve-an-outbound-payment) on time.\n- `failed`: The payment was not sent, usually due to an error while or after executing.",
        "example": "cancelled",
        "enum": [
          "verifying",
          "pending_approval",
          "scheduled",
          "executing",
          "executed",
          "cancelled",
          "failed"
        ],
        "type": "string"
      },
      "outbound_payment_links": {
        "type": "object",
        "title": "OutboundPaymentLinks",
        "description": "",
        "properties": {
          "creditor": {
            "type": "string",
            "description": "ID of the creditor who sends the outbound payment.",
            "example": "CR123"
          },
          "customer": {
            "type": "string",
            "description": "ID of the [customer](#core-endpoints-customers) that receives this outbound payment",
            "example": "CU123"
          },
          "recipient_bank_account": {
            "type": "string",
            "description": "ID of the customer bank account which receives the outbound payment.",
            "example": "BA123"
          },
          "outbound_payment_import": {
            "type": "string",
            "description": "ID of the outbound payment import that created this outbound payment.",
            "example": "IM123"
          }
        }
      },
      "outbound_payment_single_resource_response": {
        "type": "object",
        "title": "OutboundPaymentSingleResourceResponse",
        "description": "",
        "properties": {
          "outbound_payments": {
            "type": "object",
            "description": "Outbound Payments represent payments sent from [creditors](#core-endpoints-creditors).\n\nGoCardless will notify you via a [webhook](#appendix-webhooks) when the status of the outbound payment [changes](#event-types-outbound-payment).\n\n#### Rate limiting\n\nTwo rate limits apply to the Outbound Payments APIs:\n- All POST Outbound Payment endpoints (create, withdraw, approve, cancel and etc.) share a single rate-limit group of 300 requests per minute. As initiating a payment typically requires two API calls (one to create the payment and one to approve it), this allows you to add approximately 150 outbound payments per minute.\n- All remaining Outbound Payment endpoints are limited to 500 requests per minute.",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier of the outbound payment.",
                "example": "OUT123"
              },
              "created_at": {
                "type": "string",
                "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when the outbound payment was created.",
                "example": "2024-01-01T12:00:00.001Z",
                "format": "date-time"
              },
              "status": {
                "description": "One of:\n\n- `verifying`: The payment has been [created](#outbound-payments-create-an-outbound-payment) and the verification process has begun.\n- `pending_approval`: The payment is awaiting [approval](#outbound-payments-approve-an-outbound-payment).\n- `scheduled`: The payment has passed verification & [approval](#outbound-payments-approve-an-outbound-payment), but processing has not yet begun.\n- `executing`: The execution date has arrived and the payment has been placed in queue for processing.\n- `executed`: The payment has been accepted by the scheme and is now on its way to the recipient.\n- `cancelled`: The payment has been [cancelled](#outbound-payments-cancel-an-outbound-payment) or was not [approved](#outbound-payments-approve-an-outbound-payment) on time.\n- `failed`: The payment was not sent, usually due to an error while or after executing.",
                "example": "cancelled",
                "enum": [
                  "verifying",
                  "pending_approval",
                  "scheduled",
                  "executing",
                  "executed",
                  "cancelled",
                  "failed"
                ],
                "type": "string"
              },
              "amount": {
                "type": "integer",
                "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                "example": 1000
              },
              "scheme": {
                "description": "Bank payment scheme to process the outbound payment. Currently only \"faster_payments\" (GBP) is supported.",
                "example": "faster_payments",
                "enum": [
                  "faster_payments"
                ],
                "type": "string"
              },
              "currency": {
                "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency. Currently only \"GBP\" is supported.",
                "example": "GBP",
                "enum": [
                  "GBP"
                ],
                "type": "string"
              },
              "execution_date": {
                "type": "string",
                "description": "A future date on which the outbound payment should be sent.\nIf not specified, the payment will be sent as soon as possible.",
                "example": "2024-08-31",
                "format": "date"
              },
              "description": {
                "type": "string",
                "description": "A human-readable description of the outbound payment",
                "example": "Reward Payment (August 2024)"
              },
              "reference": {
                "type": "string",
                "description": "An optional reference that will appear on your customer's bank statement.\nThe character limit for this reference is dependent on the scheme.<br />\n<strong>Faster Payments</strong> - 18 characters, including: \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 &-./\"<br />",
                "example": "GC-QC2FI7GBEW7VCXL"
              },
              "is_withdrawal": {
                "type": "boolean",
                "description": "Indicates whether the outbound payment is a withdrawal to your verified business bank account.",
                "example": true
              },
              "links": {
                "type": "object",
                "description": "",
                "properties": {
                  "creditor": {
                    "type": "string",
                    "description": "ID of the creditor who sends the outbound payment.",
                    "example": "CR123"
                  },
                  "customer": {
                    "type": "string",
                    "description": "ID of the [customer](#core-endpoints-customers) that receives this outbound payment",
                    "example": "CU123"
                  },
                  "recipient_bank_account": {
                    "type": "string",
                    "description": "ID of the customer bank account which receives the outbound payment.",
                    "example": "BA123"
                  },
                  "outbound_payment_import": {
                    "type": "string",
                    "description": "ID of the outbound payment import that created this outbound payment.",
                    "example": "IM123"
                  }
                }
              },
              "verifications": {
                "type": "object",
                "nullable": true,
                "description": "Contains details of the verifications performed for the outbound payment",
                "properties": {
                  "recipient_bank_account_holder_verification": {
                    "type": "object",
                    "nullable": true,
                    "description": "Checks if the recipient owns the provided bank account",
                    "properties": {
                      "type": {
                        "description": "Type of the verification that has been performed\neg. [Confirmation of Payee](https://www.wearepay.uk/what-we-do/overlay-services/confirmation-of-payee/)",
                        "example": "confirmation_of_payee",
                        "enum": [
                          "confirmation_of_payee"
                        ],
                        "type": "string"
                      },
                      "result": {
                        "description": "Result of the verification, could be one of\n\n- `full_match`: The verification has confirmed that the account name exactly matches the details provided.\n- `partial_match`: The verification has confirmed that the account name is similar but does not match to the details provided.\n- `no_match`: The verification concludes the provided name does not match the account details.\n- `unable_to_match`: The verification could not be performed due to recipient bank issues or technical issues",
                        "example": "partial_match",
                        "enum": [
                          "full_match",
                          "partial_match",
                          "no_match",
                          "unable_to_match"
                        ],
                        "type": "string"
                      },
                      "actual_account_name": {
                        "type": "string",
                        "nullable": true,
                        "description": "The actual account name returned by the recipient's bank, populated only in the case of a partial match.",
                        "example": "Jo Doe"
                      }
                    }
                  }
                }
              },
              "metadata": {
                "type": "object",
                "description": "Key-value store of custom data. Up to 3 keys are permitted, with\nkey names up to 50 characters and values up to 500 characters."
              }
            }
          }
        }
      },
      "outbound_payment_pagination_meta": {
        "type": "object",
        "title": "OutboundPaymentPaginationMeta",
        "description": "Cursor pagination information",
        "properties": {
          "limit": {
            "type": "integer",
            "example": 50
          },
          "cursors": {
            "type": "object",
            "properties": {
