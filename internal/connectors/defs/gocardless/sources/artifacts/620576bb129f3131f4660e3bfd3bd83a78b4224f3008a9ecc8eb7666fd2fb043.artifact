          {
            "lang": "Ruby",
            "label": "Ruby",
            "source": "@client.billing_requests.collect_customer_details(\"BR123\", {\n  params: {\n    customer: {\n      email: \"alice@example.com\",\n      given_name: \"Alice\",\n      family_name: \"Smith\",\n    },\n    customer_billing_detail: {\n      address_line1: \"1 Somewhere Lane\"\n    }\n  }\n})"
          },
          {
            "lang": "Python",
            "label": "Python",
            "source": "client.billing_requests.collect_customer_details(\"BR123\", params={\n  \"customer\": {\n    \"email\": \"alice@example.com\",\n    \"given_name\": \"Alice\",\n    \"family_name\": \"Smith\"\n  },\n  \"customer_billing_detail\": {\n    \"address_line1\": \"1 Somewhere Lane\"\n  }\n})"
          },
