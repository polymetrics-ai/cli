  "paths": {
    "/balances": {
      "get": {
        "operationId": "list_balance",
        "summary": "List balances",
        "description": "Returns a [cursor-paginated](#api-usage-cursor-pagination) list of balances for a given creditor. This endpoint is rate limited to 60 requests per minute.",
        "tags": [
          "Balance"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GoCardlessVersionHeader"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/balance_multi_resource_response"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "Ruby",
            "label": "Ruby",
            "source": "@client.balances.list(\n  params: {\n    creditor: \"CR123\",\n  }\n).records"
          },
          {
            "lang": "Python",
            "label": "Python",
            "source": "client.balances.list(params={\n  \"creditor\": \"CR123\",\n}).records"
          },
          {
            "lang": "JavaScript",
            "label": "JavaScript",
            "source": "await client.balances.list({\n  creditor: \"CR123\",\n});"
          },
          {
            "lang": "PHP",
            "label": "PHP",
            "source": "$client->balances()->list([\n  \"params\" => [\n    \"creditor\" => \"CR123\",\n  ]\n]);"
          },
          {
            "lang": "Java",
            "label": "Java",
            "source": "client.balances().\n  all().\n  withCreditor(\"CR123\").\n  execute();"
          },
          {
            "lang": "Go",
            "label": "Go",
            "source": "params := gocardless.BalanceListParams{\n  Creditor: \"CR123\",\n}\n\nresponse, err := client.Balances.List(ctx, params)"
          },
          {
            "lang": "C#",
            "label": ".NET",
            "source": "var request = new GoCardless.Services.BalanceListRequest()\n{\n  Creditor = \"CR123\",\n};\n\nclient.Balances.All(request);"
          },
          {
            "lang": "HTTP",
            "label": "HTTP",
            "source": "GET https://api.gocardless.com/balances?creditor=CR123 HTTP/1.1\n\nHTTP/1.1 200 OK\nContent-Type: application/json\n{\n  \"balances\": [\n    {\n      \"balance_type\": \"pending_payments_submitted\",\n      \"amount\": 365000,\n      \"currency\": \"EUR\",\n      \"last_updated_at\": \"2025-03-17T11:08:04.926Z\",\n      \"links\": {\n        \"creditor\": \"CR123\"\n      }\n    },\n    {\n      \"balance_type\": \"pending_payouts\",\n      \"amount\": 0,\n      \"currency\": \"EUR\",\n      \"last_updated_at\": \"2025-03-17T11:48:14.416Z\",\n      \"links\": {\n        \"creditor\": \"CR123\"\n      }\n    },\n    {\n      \"balance_type\": \"confirmed_funds\",\n      \"amount\": 421198,\n      \"currency\": \"EUR\",\n      \"last_updated_at\": \"2025-03-17T11:15:52.201Z\",\n      \"links\": {\n        \"creditor\": \"CR123\"\n      }\n    }\n  ],\n  \"meta\": {\n    \"cursors\": {\n      \"before\": null,\n      \"after\": null\n    },\n    \"limit\": 50\n  }\n}"
          }
        ]
      }
    },
    "/bank_account_details/{customer_bank_account_id}": {
      "get": {
        "operationId": "get_bank_account_details",
        "summary": "Get encrypted bank details",
        "description": "Returns bank account details in the flattened JSON Web Encryption format described in RFC 7516.\n\nYou must specify a `Gc-Key-Id` header when using this endpoint. See [Public Key Setup](https://developer.gocardless.com/gc-embed/bank-details-access#public_key_setup) for more details.\n\n<p class=\"restricted-notice\"><strong>Restricted</strong>: This endpoint is restricted to organisations with the Encrypted Bank Details Access upgrade</p>\n\n<p class=\"notice\"><strong>Note</strong>: See our [Security Requirements](#appendix-security-requirements) before using this feature</p>",
        "tags": [
          "Bank Account Detail"
        ],
