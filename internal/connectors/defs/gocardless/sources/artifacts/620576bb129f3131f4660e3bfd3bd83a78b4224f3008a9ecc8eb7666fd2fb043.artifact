        "description": "A future date on which the payment should be collected. If the date\nis before the next_possible_charge_date on the\n[mandate](#core-endpoints-mandates), it will be automatically rolled\nforwards to that date.",
        "example": "2014-05-21",
        "format": "date"
      },
      "institution": {
        "type": "object",
        "title": "Institutions",
        "description": "Institutions that are supported when creating [Bank Authorisations](#billing-requests-bank-authorisations) for a particular country or purpose.\n\nNot all institutions support both Payment Initiation (PIS) and Account Information (AIS) services.",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier for this institution",
            "example": "monzo"
          },
          "name": {
            "type": "string",
            "description": "A human readable name for this institution",
            "example": "VAT"
          },
          "icon_url": {
            "type": "string",
            "description": "A URL pointing to the icon for this institution",
            "example": "https://gocardless/assets/icons/monzo"
          },
          "logo_url": {
            "type": "string",
            "description": "A URL pointing to the logo for this institution",
            "example": "https://gocardless/assets/logos/monzo"
          },
          "roles": {
            "type": "array",
            "description": "The roles assigned to this institution, representing the open banking features it supports.",
            "example": [
              "corporate_accounts",
              "funds_confirmation"
            ],
            "items": {
              "type": "string",
              "description": "- `read_refund_account`: The institution can return the payer's refund account.\n- `read_debtor_account`: The institution can return the payer's debtor account.\n- `funds_confirmation`: The institution supports a funds-confirmation check before authorising an instant payment.\n- `corporate_accounts`: The institution supports corporate accounts."
            }
          },
          "country_code": {
            "type": "string",
            "description": "[ISO 3166-1](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements) alpha-2 code. The country code of the institution. If nothing is provided, institutions with the country code 'GB' are returned by default.",
            "example": "GB"
          },
          "limits": {
            "type": "object",
            "nullable": true,
            "description": "Defines individual limits for business and personal accounts.",
            "properties": {
              "daily": {
                "type": "object",
                "nullable": true,
                "description": "Daily limit details for this institution, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR). The 'limits' property is only available via an authenticated request with a generated access token"
              },
              "single": {
                "type": "object",
                "nullable": true,
                "description": "Single transaction limit details for this institution, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR). The 'limits' property is only available via an authenticated request with a generated access token"
              }
            }
          },
          "autocompletes_collect_bank_account": {
            "type": "boolean",
            "description": "Flag to show if selecting this institution in the select_institution action can auto-complete the collect_bank_account action. The bank can return the payer's bank account details to GoCardless.",
            "example": true
          },
          "status": {
            "type": "string",
            "description": "The status of the institution",
            "example": "enabled",
            "enum": [
              "enabled",
              "disabled",
              "temporarily_disabled"
            ]
          }
        }
      },
      "institution_id": {
        "type": "string",
        "title": "InstitutionId",
        "description": "The unique identifier for this institution",
        "example": "monzo"
      },
      "institution_identity": {
        "type": "string",
        "title": "InstitutionIdentity",
        "description": "The unique identifier for this institution",
        "example": "monzo"
      },
      "institution_icon_url": {
        "type": "string",
        "title": "InstitutionIconUrl",
        "description": "A URL pointing to the icon for this institution",
        "example": "https://gocardless/assets/icons/monzo"
      },
      "institution_logo_url": {
        "type": "string",
        "title": "InstitutionLogoUrl",
        "description": "A URL pointing to the logo for this institution",
        "example": "https://gocardless/assets/logos/monzo"
      },
      "institution_roles": {
        "type": "array",
        "title": "InstitutionRoles",
        "description": "The roles assigned to this institution, representing the open banking features it supports.",
        "example": [
          "corporate_accounts",
          "funds_confirmation"
        ],
        "items": {
          "type": "string",
          "description": "- `read_refund_account`: The institution can return the payer's refund account.\n- `read_debtor_account`: The institution can return the payer's debtor account.\n- `funds_confirmation`: The institution supports a funds-confirmation check before authorising an instant payment.\n- `corporate_accounts`: The institution supports corporate accounts."
        }
      },
      "institution_name": {
        "type": "string",
        "title": "InstitutionName",
        "description": "A human readable name for this institution",
        "example": "VAT"
      },
      "institution_country_code": {
        "type": "string",
        "title": "InstitutionCountryCode",
        "description": "[ISO 3166-1](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements) alpha-2 code. The country code of the institution. If nothing is provided, institutions with the country code 'GB' are returned by default.",
        "example": "GB"
      },
      "institution_scheme": {
        "type": "string",
        "title": "InstitutionScheme",
        "description": "The scheme that institutions support. The available options include `faster_payments`, `sepa_credit_transfer`, and `sepa_instant_credit_transfer`. If nothing is provided, institutions supporting 'faster_payments' are returned by default.",
        "example": "faster_payments"
      },
      "institution_feature": {
        "type": "string",
        "title": "InstitutionFeature",
        "description": "The feature that institutions support. The available options include `pis`, and `vrp_sweeping`. If nothing is provided, institutions supporting 'pis' are returned by default.",
        "example": "pis"
      },
      "institution_branch_code": {
        "type": "string",
        "title": "InstitutionBranchCode",
        "description": "(Currently only supports UK sort-codes) The six-digit number that identifies both the bank and the specific branch where an account is held, eg. '601234'.",
        "example": "601234"
      },
      "institution_autocompletes_collect_bank_account": {
        "type": "boolean",
        "title": "InstitutionAutocompletesCollectBankAccount",
        "description": "Flag to show if selecting this institution in the select_institution action can auto-complete the collect_bank_account action. The bank can return the payer's bank account details to GoCardless.",
        "example": true
      },
      "institution_status": {
        "type": "string",
        "title": "InstitutionStatus",
        "description": "The status of the institution",
        "example": "enabled",
        "enum": [
          "enabled",
          "disabled",
          "temporarily_disabled"
        ]
      },
      "institution_limits": {
