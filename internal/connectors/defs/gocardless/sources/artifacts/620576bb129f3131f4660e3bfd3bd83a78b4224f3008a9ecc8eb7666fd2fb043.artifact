                    "type": "object",
                    "properties": {
                      "entry_items": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "description": "The entry items contain attributes required to [Create an outbound payment](#outbound-payments-create-an-outbound-payment).\nPlease refer to that documentation for more information on the requirements for these fields.\n\n**Required**:\n\n- `amount`\n- `scheme`\n- `recipient_bank_account_id`\n\nAdditional supported fields:\n\n- `reference`\n- `metadata`\n",
                          "properties": {
                            "scheme": {
                              "$ref": "#/components/schemas/outbound_payment_scheme"
                            },
                            "amount": {
                              "$ref": "#/components/schemas/outbound_payment_import_entry_amount"
