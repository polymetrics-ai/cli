      "customer_bank_account": {
        "type": "object",
        "title": "Customer Bank Accounts",
        "description": "Customer Bank Accounts hold the bank details of a [customer](#core-endpoints-customers). They always belong to a [customer](#core-endpoints-customers), and may be linked to several Direct Debit [mandates](#core-endpoints-mandates).\n\nNote that customer bank accounts must be unique, and so you will encounter a `bank_account_exists` error if you try to create a duplicate bank account. You may wish to handle this by updating the existing record instead, the ID of which will be provided as `links[customer_bank_account]` in the error response.\n\n_Note:_ To ensure the customer's bank accounts are valid, verify them first\nusing\n[bank_details_lookups](#bank-details-lookups-perform-a-bank-details-lookup),\nbefore proceeding with creating the accounts",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier, beginning with \"BA\".",
            "example": "BA123"
          },
          "created_at": {
            "type": "string",
            "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
            "example": "2014-01-01T12:00:00.000Z",
            "format": "date-time"
          },
          "account_holder_name": {
            "type": "string",
            "description": "Name of the account holder, as known by the bank. The full name provided when the customer is created is stored and is available via the API, but is transliterated, upcased, and truncated to 18 characters in bank submissions. This field is required unless the request includes a [customer bank account token](#javascript-flow-customer-bank-account-tokens).",
            "example": "Billie Jean"
          },
          "account_number_ending": {
            "type": "string",
            "description": "The last few digits of the account number. Currently 4 digits for NZD bank accounts and 2 digits for other currencies.",
            "example": "1234"
          },
          "account_type": {
            "description": "Bank account type. Required for USD-denominated bank accounts. Must not be provided for bank accounts in other currencies. See [local details](#local-bank-details-united-states) for more information.",
            "example": "savings",
            "enum": [
              "savings",
              "checking"
            ],
            "nullable": true,
            "type": "string"
          },
          "country_code": {
            "type": "string",
            "nullable": true,
            "description": "[ISO 3166-1 alpha-2 code](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements). Defaults to the country code of the `iban` if supplied, otherwise is required.",
            "example": "GB"
          },
          "currency": {
            "type": "string",
            "nullable": true,
            "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
            "example": "EUR"
          },
          "bank_name": {
            "type": "string",
            "description": "Name of bank, taken from the bank details.",
            "example": "BARCLAYS BANK PLC"
          },
          "bank_account_token": {
            "type": "string",
            "nullable": true,
            "description": "A token to uniquely refer to a set of bank account details. This feature is still in early access and is only available for certain organisations.",
            "example": "bat_f975ab3c-ecee-47a1-9590-5bb1d56fa113"
          },
          "enabled": {
            "type": "boolean",
            "description": "Boolean value showing whether the bank account is enabled or disabled.",
            "example": true
          },
          "metadata": {
            "type": "object",
            "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
          },
          "links": {
            "type": "object",
            "description": "",
            "properties": {
              "customer": {
                "type": "string",
                "description": "ID of the [customer](#core-endpoints-customers) that owns this bank account."
              }
            }
          },
          "trusted_recipient": {
            "type": "boolean",
            "description": "Whether this customer bank account is registered as a trusted recipient for Outbound Payments. Only present when the feature is enabled for the organisation.",
            "example": true
          },
          "payer_name_verification_result": {
            "type": "string",
            "description": "The result of the payer name verification check performed when the bank account was created. Only present if a check was performed.\n\n- `full`: The name provided matches the name held by the bank.\n- `close`: The name provided is a close but not exact match to the name held by the bank.\n- `cannot_perform_verification`: A verification was attempted but could not be completed. This can happen for a number of reasons, including the account holder's bank not participating in the verification scheme, the account not being eligible for verification (e.g. the account holder has opted out), or the bank details not being resolvable, among others.",
            "example": "full",
            "enum": [
              "full",
              "close",
              "cannot_perform_verification"
            ]
          }
        }
      },
      "customer_bank_account_id": {
        "type": "string",
        "title": "CustomerBankAccountId",
        "description": "Unique identifier, beginning with \"BA\".",
        "example": "BA123"
      },
      "customer_bank_account_identity": {
        "type": "string",
        "title": "CustomerBankAccountIdentity",
        "description": "Unique identifier, beginning with \"BA\".",
        "example": "BA123"
      },
      "customer_bank_account_created_at": {
        "type": "string",
        "title": "CustomerBankAccountCreatedAt",
        "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
        "example": "2014-01-01T12:00:00.000Z",
        "format": "date-time"
      },
      "customer_bank_account_account_holder_name": {
        "type": "string",
        "title": "CustomerBankAccountAccountHolderName",
        "description": "Name of the account holder, as known by the bank. The full name provided when the customer is created is stored and is available via the API, but is transliterated, upcased, and truncated to 18 characters in bank submissions. This field is required unless the request includes a [customer bank account token](#javascript-flow-customer-bank-account-tokens).",
        "example": "Billie Jean"
      },
      "customer_bank_account_account_number_ending": {
        "type": "string",
        "title": "CustomerBankAccountAccountNumberEnding",
        "description": "The last few digits of the account number. Currently 4 digits for NZD bank accounts and 2 digits for other currencies.",
        "example": "1234"
      },
      "customer_bank_account_country_code": {
        "type": "string",
        "nullable": true,
        "title": "CustomerBankAccountCountryCode",
        "description": "[ISO 3166-1 alpha-2 code](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements). Defaults to the country code of the `iban` if supplied, otherwise is required.",
        "example": "GB"
      },
      "customer_bank_account_currency": {
        "type": "string",
        "nullable": true,
        "title": "CustomerBankAccountCurrency",
        "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
        "example": "EUR"
      },
      "customer_bank_account_bank_name": {
        "type": "string",
        "title": "CustomerBankAccountBankName",
        "description": "Name of bank, taken from the bank details.",
        "example": "BARCLAYS BANK PLC"
      },
      "customer_bank_account_enabled": {
        "type": "boolean",
        "title": "CustomerBankAccountEnabled",
        "description": "Boolean value showing whether the bank account is enabled or disabled.",
        "example": true
      },
      "customer_bank_account_account_number": {
        "type": "string",
        "nullable": true,
        "title": "CustomerBankAccountAccountNumber",
        "description": "Bank account number - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`.",
        "example": "55779911"
      },
      "customer_bank_account_account_type": {
        "title": "CustomerBankAccountAccountType",
        "description": "Bank account type. Required for USD-denominated bank accounts. Must not be provided for bank accounts in other currencies. See [local details](#local-bank-details-united-states) for more information.",
        "example": "savings",
        "enum": [
          "savings",
          "checking"
        ],
        "nullable": true,
        "type": "string"
      },
      "customer_bank_account_bank_code": {
        "type": "string",
        "nullable": true,
        "title": "CustomerBankAccountBankCode",
        "description": "Bank code - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`."
      },
      "customer_bank_account_bank_account_token": {
        "type": "string",
        "nullable": true,
        "title": "CustomerBankAccountBankAccountToken",
        "description": "A token to uniquely refer to a set of bank account details. This feature is still in early access and is only available for certain organisations.",
        "example": "bat_f975ab3c-ecee-47a1-9590-5bb1d56fa113"
      },
      "customer_bank_account_branch_code": {
        "type": "string",
        "nullable": true,
        "title": "CustomerBankAccountBranchCode",
        "description": "Branch code - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`.",
        "example": "20-00-00"
      },
      "customer_bank_account_iban": {
        "type": "string",
        "nullable": true,
        "title": "CustomerBankAccountIban",
        "description": "International Bank Account Number. Alternatively you can provide [local details](#appendix-local-bank-details). IBANs are not accepted for Swedish bank accounts denominated in SEK - you must supply [local details](#local-bank-details-sweden).",
        "example": "GB60BARC20000055779911"
      },
      "customer_bank_account_trusted_recipient": {
        "type": "boolean",
        "title": "CustomerBankAccountTrustedRecipient",
        "description": "Whether this customer bank account is registered as a trusted recipient for Outbound Payments. Only present when the feature is enabled for the organisation.",
        "example": true
      },
      "customer_bank_account_payer_name_verification_result": {
        "type": "string",
        "title": "CustomerBankAccountPayerNameVerificationResult",
        "description": "The result of the payer name verification check performed when the bank account was created. Only present if a check was performed.\n\n- `full`: The name provided matches the name held by the bank.\n- `close`: The name provided is a close but not exact match to the name held by the bank.\n- `cannot_perform_verification`: A verification was attempted but could not be completed. This can happen for a number of reasons, including the account holder's bank not participating in the verification scheme, the account not being eligible for verification (e.g. the account holder has opted out), or the bank details not being resolvable, among others.",
        "example": "full",
        "enum": [
          "full",
          "close",
          "cannot_perform_verification"
        ]
      },
      "customer_bank_account_links": {
        "type": "object",
        "title": "CustomerBankAccountLinks",
        "description": "",
        "properties": {
          "customer": {
            "type": "string",
            "description": "ID of the [customer](#core-endpoints-customers) that owns this bank account."
          }
        }
      },
      "customer_bank_account_pagination_meta": {
        "type": "object",
        "title": "CustomerBankAccountPaginationMeta",
        "description": "Cursor pagination information",
        "properties": {
          "limit": {
            "type": "integer",
            "example": 50
          },
          "cursors": {
            "type": "object",
            "properties": {
              "before": {
                "type": "string",
                "nullable": true,
                "description": "Cursor pointing to the end of the desired set."
              },
              "after": {
                "type": "string",
                "nullable": true,
                "description": "Cursor pointing to the start of the desired set."
              }
            }
          }
        }
      },
      "customer_bank_account_single_resource_response": {
        "type": "object",
        "title": "CustomerBankAccountSingleResourceResponse",
        "description": "",
        "properties": {
          "customer_bank_accounts": {
            "type": "object",
            "description": "Customer Bank Accounts hold the bank details of a [customer](#core-endpoints-customers). They always belong to a [customer](#core-endpoints-customers), and may be linked to several Direct Debit [mandates](#core-endpoints-mandates).\n\nNote that customer bank accounts must be unique, and so you will encounter a `bank_account_exists` error if you try to create a duplicate bank account. You may wish to handle this by updating the existing record instead, the ID of which will be provided as `links[customer_bank_account]` in the error response.\n\n_Note:_ To ensure the customer's bank accounts are valid, verify them first\nusing\n[bank_details_lookups](#bank-details-lookups-perform-a-bank-details-lookup),\nbefore proceeding with creating the accounts",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier, beginning with \"BA\".",
                "example": "BA123"
              },
              "created_at": {
                "type": "string",
                "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                "example": "2014-01-01T12:00:00.000Z",
                "format": "date-time"
              },
              "account_holder_name": {
                "type": "string",
                "description": "Name of the account holder, as known by the bank. The full name provided when the customer is created is stored and is available via the API, but is transliterated, upcased, and truncated to 18 characters in bank submissions. This field is required unless the request includes a [customer bank account token](#javascript-flow-customer-bank-account-tokens).",
                "example": "Billie Jean"
              },
              "account_number_ending": {
                "type": "string",
                "description": "The last few digits of the account number. Currently 4 digits for NZD bank accounts and 2 digits for other currencies.",
                "example": "1234"
              },
              "account_type": {
                "description": "Bank account type. Required for USD-denominated bank accounts. Must not be provided for bank accounts in other currencies. See [local details](#local-bank-details-united-states) for more information.",
                "example": "savings",
                "enum": [
                  "savings",
                  "checking"
                ],
                "nullable": true,
                "type": "string"
              },
              "country_code": {
                "type": "string",
                "nullable": true,
                "description": "[ISO 3166-1 alpha-2 code](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements). Defaults to the country code of the `iban` if supplied, otherwise is required.",
                "example": "GB"
              },
              "currency": {
                "type": "string",
                "nullable": true,
                "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                "example": "EUR"
              },
              "bank_name": {
                "type": "string",
                "description": "Name of bank, taken from the bank details.",
                "example": "BARCLAYS BANK PLC"
              },
              "bank_account_token": {
                "type": "string",
                "nullable": true,
                "description": "A token to uniquely refer to a set of bank account details. This feature is still in early access and is only available for certain organisations.",
                "example": "bat_f975ab3c-ecee-47a1-9590-5bb1d56fa113"
              },
              "enabled": {
                "type": "boolean",
                "description": "Boolean value showing whether the bank account is enabled or disabled.",
                "example": true
              },
              "metadata": {
                "type": "object",
                "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
              },
              "links": {
                "type": "object",
                "description": "",
                "properties": {
                  "customer": {
                    "type": "string",
                    "description": "ID of the [customer](#core-endpoints-customers) that owns this bank account."
                  }
                }
              },
              "trusted_recipient": {
                "type": "boolean",
                "description": "Whether this customer bank account is registered as a trusted recipient for Outbound Payments. Only present when the feature is enabled for the organisation.",
                "example": true
              },
              "payer_name_verification_result": {
                "type": "string",
                "description": "The result of the payer name verification check performed when the bank account was created. Only present if a check was performed.\n\n- `full`: The name provided matches the name held by the bank.\n- `close`: The name provided is a close but not exact match to the name held by the bank.\n- `cannot_perform_verification`: A verification was attempted but could not be completed. This can happen for a number of reasons, including the account holder's bank not participating in the verification scheme, the account not being eligible for verification (e.g. the account holder has opted out), or the bank details not being resolvable, among others.",
                "example": "full",
                "enum": [
                  "full",
                  "close",
                  "cannot_perform_verification"
                ]
              }
            }
          }
        }
      },
