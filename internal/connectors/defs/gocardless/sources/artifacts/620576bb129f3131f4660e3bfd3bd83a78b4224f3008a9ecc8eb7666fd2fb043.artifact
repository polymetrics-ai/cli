      "payment_account_transaction_single_resource_response": {
        "type": "object",
        "title": "PaymentAccountTransactionSingleResourceResponse",
        "description": "",
        "properties": {
          "payment_account_transactions": {
            "type": "object",
            "description": "Payment account transactions represent movements of funds on a given payment account. The payment account is provisioned by GoCardless and is used to fund [outbound payments](#core-endpoints-outbound-payments).",
            "properties": {
              "id": {
                "type": "string",
                "description": "The unique ID of the payment account transaction.",
                "example": "PATR1234"
              },
              "value_date": {
                "type": "string",
                "description": "The date of when the transaction occurred.",
                "example": "2014-01-01",
                "format": "date"
              },
              "reference": {
                "type": "string",
                "description": "The reference of the transaction. This is typically supplied by the sender.",
                "example": "GC-058408d9"
              },
              "description": {
                "type": "string",
                "description": "The description of the transaction, if available",
                "example": "Reward Payment (August 2024)"
              },
              "counterparty_name": {
                "type": "string",
                "description": "The name of the counterparty of the transaction. The counterparty is the recipient for a credit, or the sender for a debit.",
                "example": "Acme Ltd"
              },
              "links": {
                "type": "object",
                "description": "",
                "properties": {
                  "payout": {
                    "type": "string",
                    "description": "ID of the [payout](#core-endpoints-payouts) linked to the transaction.",
                    "example": "PO123"
                  },
                  "outbound_payment": {
                    "type": "string",
                    "description": "ID of the [outbound_payment](#core-endpoints-outbound-payments) linked to the transaction",
                    "example": "OUT123"
                  },
                  "payment_bank_account": {
                    "type": "string",
                    "description": "ID of the payment bank account.",
                    "example": "BA123"
                  }
                }
              },
              "currency": {
                "type": "string",
                "description": "The currency of the transaction.",
                "enum": [
                  "GBP"
                ]
              },
              "direction": {
                "description": "The direction of the transaction. Debits mean money leaving the account (e.g. outbound payment), while credits signify money coming in (e.g. manual top-up).",
                "example": "credit",
                "enum": [
                  "credit",
                  "debit"
                ],
                "type": "string"
              },
              "amount": {
                "type": "integer",
                "description": "Amount, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                "example": 1000
              },
              "balance_after_transaction": {
                "type": "integer",
                "description": "Balance after transaction, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                "example": 1000
              }
            }
          }
        }
      },
      "payment_account_transaction_multi_resource_response": {
        "type": "object",
        "title": "PaymentAccountTransactionMultiResourceResponse",
        "description": "",
        "properties": {
          "payment_account_transactions": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Payment account transactions represent movements of funds on a given payment account. The payment account is provisioned by GoCardless and is used to fund [outbound payments](#core-endpoints-outbound-payments).",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The unique ID of the payment account transaction.",
                  "example": "PATR1234"
                },
                "value_date": {
                  "type": "string",
