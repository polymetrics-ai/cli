            "type": "string"
          },
          "advance_notice": {
            "type": "number"
          },
          "address": {
            "type": "string"
          },
          "bank_statement_name": {
            "type": "string"
          },
          "registered_name": {
            "type": "string",
            "description": "The registered sun name for the organisation"
          }
        }
      },
      "billing_request_flow_single_resource_response": {
        "type": "object",
        "title": "BillingRequestFlowSingleResourceResponse",
        "description": "",
        "properties": {
          "billing_request_flows": {
            "type": "object",
            "description": "Billing Request Flows can be created to enable a payer to authorise a payment created for a scheme with strong payer\nauthorisation (such as open banking single payments).",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier, beginning with \"BRF\".",
                "example": "BRF123"
              },
              "redirect_uri": {
                "type": "string",
                "nullable": true,
                "description": "URL that the payer can be redirected to after completing the request flow.",
                "example": "https://my-website.com/abc/callback"
              },
              "skip_success_screen": {
                "type": "boolean",
                "description": "If true, the payer will not be redirected to the success screen after completing the flow. A redirect_uri needs to be provided for this parameter to be taken into account."
              },
              "exit_uri": {
                "type": "string",
                "nullable": true,
                "description": "URL that the payer can be taken to if there isn't a way to progress ahead in flow, for example if the customer searches for a bank that doesn't exist or isn't supported on the scheme.",
                "example": "https://my-website.com/abc/callback"
              },
              "show_redirect_buttons": {
                "type": "boolean",
                "description": "If true, the payer will be able to see redirect action buttons on Thank You page. These action buttons will provide a way to connect back to the billing request flow app if opened within a mobile app. For successful flow, the button will take the payer back the billing request flow where they will see the success screen. For failure, button will take the payer to url being provided against exit_uri field."
              },
              "show_success_redirect_button": {
                "type": "boolean",
                "description": "If true, the payer will be able to see a redirect action button on the Success page. This action button will provide a way to redirect the payer to the given redirect_uri. This functionality is helpful when merchants do not want payers to be automatically redirected or on Android devices, where automatic redirections are not possible."
              },
              "authorisation_url": {
                "type": "string",
                "description": "URL for a GC-controlled flow which will allow the payer to fulfil the billing request",
                "example": "https://monzo.com/abc-123-things"
              },
              "created_at": {
                "type": "string",
                "description": "Timestamp when the flow was created",
                "format": "date-time"
              },
              "expires_at": {
                "type": "string",
                "description": "Timestamp when the flow will expire. Each flow currently lasts for 7 days.",
                "format": "date-time"
