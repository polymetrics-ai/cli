    "/billing_requests/create_with_actions": {
      "post": {
        "operationId": "create_with_actions_billing_requests",
        "summary": "Create a Billing Request with Actions",
        "description": "Creates a billing request and completes any specified actions in a single request.\nThis endpoint allows you to create a billing request and immediately complete actions\nsuch as collecting customer details, bank account details, or other required actions.\n\n<p class=\"restricted-notice\"><strong>Restricted</strong>: this endpoint is restricted to [GoCardless Pro](https://gocardless.com/pricing) and [GoCardless Enterprise](https://gocardless.com/pricing) accounts with the [custom payment pages upgrade](https://hub.gocardless.com/s/article/Custom-payment-pages).</p>\n\n<p class=\"notice\"><strong>Note</strong>: to modify data on an already created billing request, call individual action endpoints. Calling this endpoint creates a new billing request everytime.</p>\n\n<p class=\"notice--warning\"><strong>Warning</strong>: ACH/PAD is not supported on this endpoint.</p>",
        "tags": [
          "Billing Request With Action"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GoCardlessVersionHeader"
          }
        ],
        "responses": {
          "201": {
            "content": {
