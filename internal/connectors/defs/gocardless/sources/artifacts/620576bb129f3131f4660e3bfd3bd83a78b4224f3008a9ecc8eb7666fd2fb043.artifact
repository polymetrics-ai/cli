                "schema": {
                  "$ref": "#/components/schemas/billing_request_multi_resource_response"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "Ruby",
            "label": "Ruby",
            "source": "@client.billing_requests.list"
          },
          {
            "lang": "Python",
            "label": "Python",
            "source": "client.billing_requests.list().records"
          },
          {
            "lang": "JavaScript",
            "label": "JavaScript",
            "source": "const billingRequests = await client.billingRequests.list();"
          },
          {
            "lang": "PHP",
            "label": "PHP",
            "source": "$client->billingRequests()->list();"
          },
          {
            "lang": "Java",
            "label": "Java",
            "source": "for (BillingRequest billingRequest : client.billingRequests().all().execute()) {\n  System.out.println(billingRequest.getId());\n}"
          },
          {
            "lang": "Go",
            "label": "Go",
            "source": "billingRequestListParams := gocardless.BillingRequestListParams{}\nbillingRequestListResult, err :=  client.BillingRequests.List(ctx, billingRequestListParams)\nfor _, billingRequest := range billingRequestListResult.BillingRequests {\n    fmt.Println(billingRequest.Id)\n}"
          },
          {
            "lang": "C#",
            "label": ".NET",
            "source": "var billingRequestListResponse = client.BillingRequests.All();\nforeach (GoCardless.Resources.BillingRequest billingRequest in billingRequestListResponse)\n{\n    Console.WriteLine(billingRequest.Id);\n}"
          },
