{
  "openapi": "3.0.0",
  "info": {
    "title": "GoCardless API",
    "description": "GoCardless API",
    "version": "2015-07-06",
    "x-schema-version": "0.115.0"
  },
  "servers": [
    {
      "url": "https://api.gocardless.com",
      "description": "Production API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "schemas": {
      "balance": {
        "type": "object",
        "title": "Balances",
        "description": "Returns the balances for a creditor. These balances are the same as what’s shown in the dashboard with one exception (mentioned below under balance_type).\n\nThese balances will typically be 3-5 minutes old. The balance amounts likely won’t match what’s shown in the dashboard as the dashboard balances are updated much less frequently (once per day).",
        "properties": {
          "balance_type": {
            "description": "Type of the balance. Could be one of\n\n- `pending_payments_submitted`: Payments we have submitted to the scheme but not yet confirmed. This does not exactly correspond to <i>Pending payments</i> in the dashboard, because this balance does not include payments that are pending submission.\n- `confirmed_funds`: Payments that have been confirmed minus fees and unclaimed debits for refunds, failures and chargebacks. These funds have not yet been moved into a payout.\n- `pending_payouts`: Confirmed payments that have been moved into a payout. This is the total due to be paid into your bank account in the next payout run (payouts happen once every business day).\n  `pending_payouts` will only be non-zero while we are generating and submitting the payouts to our partner bank.",
            "example": "confirmed_funds",
            "enum": [
              "confirmed_funds",
              "pending_payouts",
              "pending_payments_submitted"
            ],
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "description": "The total amount in the balance, defined as the sum of all debits subtracted from the sum of all credits,\nin the lowest denomination for the currency (e.g. pence in GBP, cents in EUR)."
          },
          "currency": {
            "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
            "example": "EUR",
            "enum": [
              "AUD",
              "CAD",
              "DKK",
              "EUR",
              "GBP",
              "NZD",
              "SEK",
              "USD"
            ],
            "type": "string"
          },
          "last_updated_at": {
            "type": "string",
            "description": "Dynamic [timestamp](#api-usage-dates-and-times) recording when this resource was last updated.",
            "example": "2014-01-01T12:00:00.000Z",
            "format": "date-time"
          },
          "links": {
            "type": "object",
            "description": "",
            "properties": {
              "creditor": {
                "type": "string",
                "description": "ID of the associated [creditor](#core-endpoints-creditors).",
                "example": "CR123"
              }
            }
          }
        }
      },
      "balance_balance_type": {
        "title": "BalanceBalanceType",
        "description": "Type of the balance. Could be one of\n\n- `pending_payments_submitted`: Payments we have submitted to the scheme but not yet confirmed. This does not exactly correspond to <i>Pending payments</i> in the dashboard, because this balance does not include payments that are pending submission.\n- `confirmed_funds`: Payments that have been confirmed minus fees and unclaimed debits for refunds, failures and chargebacks. These funds have not yet been moved into a payout.\n- `pending_payouts`: Confirmed payments that have been moved into a payout. This is the total due to be paid into your bank account in the next payout run (payouts happen once every business day).\n  `pending_payouts` will only be non-zero while we are generating and submitting the payouts to our partner bank.",
        "example": "confirmed_funds",
        "enum": [
          "confirmed_funds",
          "pending_payouts",
          "pending_payments_submitted"
        ],
        "type": "string"
      },
      "balance_amount": {
        "type": "integer",
        "title": "BalanceAmount",
        "description": "The total amount in the balance, defined as the sum of all debits subtracted from the sum of all credits,\nin the lowest denomination for the currency (e.g. pence in GBP, cents in EUR)."
      },
      "balance_currency": {
        "title": "BalanceCurrency",
        "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
        "example": "EUR",
        "enum": [
          "AUD",
          "CAD",
          "DKK",
          "EUR",
          "GBP",
          "NZD",
          "SEK",
          "USD"
        ],
        "type": "string"
      },
      "balance_last_updated_at": {
        "type": "string",
        "title": "BalanceLastUpdatedAt",
        "description": "Dynamic [timestamp](#api-usage-dates-and-times) recording when this resource was last updated.",
        "example": "2014-01-01T12:00:00.000Z",
        "format": "date-time"
      },
      "balance_links": {
        "type": "object",
        "title": "BalanceLinks",
        "description": "",
        "properties": {
          "creditor": {
            "type": "string",
            "description": "ID of the associated [creditor](#core-endpoints-creditors).",
            "example": "CR123"
          }
        }
      },
      "balance_pagination_meta": {
        "type": "object",
        "title": "BalancePaginationMeta",
        "description": "Cursor pagination information",
        "properties": {
          "limit": {
            "type": "integer",
            "example": 50
          },
          "cursors": {
            "type": "object",
            "properties": {
              "before": {
                "type": "string",
                "nullable": true,
                "description": "Cursor pointing to the end of the desired set."
              },
              "after": {
                "type": "string",
                "nullable": true,
                "description": "Cursor pointing to the start of the desired set."
              }
            }
          }
        }
      },
      "balance_creditor": {
        "type": "string",
        "title": "BalanceCreditor",
        "description": "ID of the associated [creditor](#core-endpoints-creditors). Only required if your account manages multiple creditors.",
        "example": "CR123"
      },
      "balance_multi_resource_response": {
        "type": "object",
        "title": "BalanceMultiResourceResponse",
        "description": "",
        "properties": {
          "balances": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "balance_type": {
                  "description": "Type of the balance. Could be one of\n\n- `pending_payments_submitted`: Payments we have submitted to the scheme but not yet confirmed. This does not exactly correspond to <i>Pending payments</i> in the dashboard, because this balance does not include payments that are pending submission.\n- `confirmed_funds`: Payments that have been confirmed minus fees and unclaimed debits for refunds, failures and chargebacks. These funds have not yet been moved into a payout.\n- `pending_payouts`: Confirmed payments that have been moved into a payout. This is the total due to be paid into your bank account in the next payout run (payouts happen once every business day).\n  `pending_payouts` will only be non-zero while we are generating and submitting the payouts to our partner bank.",
                  "example": "confirmed_funds",
                  "enum": [
                    "confirmed_funds",
                    "pending_payouts",
                    "pending_payments_submitted"
                  ],
                  "type": "string"
                },
                "amount": {
                  "type": "integer",
                  "description": "The total amount in the balance, defined as the sum of all debits subtracted from the sum of all credits,\nin the lowest denomination for the currency (e.g. pence in GBP, cents in EUR)."
                },
                "currency": {
                  "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                  "example": "EUR",
                  "enum": [
                    "AUD",
                    "CAD",
                    "DKK",
                    "EUR",
                    "GBP",
                    "NZD",
                    "SEK",
                    "USD"
                  ],
                  "type": "string"
                },
                "last_updated_at": {
                  "type": "string",
                  "description": "Dynamic [timestamp](#api-usage-dates-and-times) recording when this resource was last updated.",
                  "example": "2014-01-01T12:00:00.000Z",
                  "format": "date-time"
                },
                "links": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "creditor": {
                      "type": "string",
                      "description": "ID of the associated [creditor](#core-endpoints-creditors).",
                      "example": "CR123"
                    }
                  }
                }
              }
            }
          },
          "meta": {
            "type": "object",
            "description": "Cursor pagination information",
            "properties": {
              "limit": {
                "type": "integer",
                "example": 50
              },
              "cursors": {
                "type": "object",
                "properties": {
                  "before": {
                    "type": "string",
                    "nullable": true,
                    "description": "Cursor pointing to the end of the desired set."
                  },
                  "after": {
                    "type": "string",
                    "nullable": true,
                    "description": "Cursor pointing to the start of the desired set."
                  }
                }
              }
            }
          }
        }
      },
      "bank_account_detail": {
        "type": "object",
        "title": "Bank Account Details",
        "description": "Retrieve bank account details in JWE encrypted format",
        "properties": {
          "protected": {
            "type": "string",
            "description": "Base64 URL encoded JWE header values, containing the following keys:\n\n  - `alg`: the asymmetric encryption type used to encrypt symmetric key, e.g: `RSA-OAEP`.\n  - `enc`: the content encryption type, e.g: `A256GCM`.\n  - `kid`: the ID of an RSA-2048 public key, from your JWKS, used to encrypt the AES key."
          },
          "encrypted_key": {
            "type": "string",
            "description": "Base64 URL encoded symmetric content encryption key, encrypted with the asymmetric key from your JWKS."
          },
          "iv": {
            "type": "string",
            "description": "Base64 URL encoded initialization vector, used during content encryption."
          },
          "ciphertext": {
            "type": "string",
            "description": "Base64 URL encoded encrypted payload, in this case bank details."
          },
          "tag": {
            "type": "string",
            "description": "Base64 URL encoded authentication tag, used to verify payload integrity during decryption."
          }
        }
      },
      "bank_account_detail_protected": {
        "type": "string",
        "title": "BankAccountDetailProtected",
        "description": "Base64 URL encoded JWE header values, containing the following keys:\n\n  - `alg`: the asymmetric encryption type used to encrypt symmetric key, e.g: `RSA-OAEP`.\n  - `enc`: the content encryption type, e.g: `A256GCM`.\n  - `kid`: the ID of an RSA-2048 public key, from your JWKS, used to encrypt the AES key."
      },
      "bank_account_detail_encrypted_key": {
        "type": "string",
        "title": "BankAccountDetailEncryptedKey",
        "description": "Base64 URL encoded symmetric content encryption key, encrypted with the asymmetric key from your JWKS."
      },
      "bank_account_detail_iv": {
        "type": "string",
        "title": "BankAccountDetailIv",
        "description": "Base64 URL encoded initialization vector, used during content encryption."
      },
      "bank_account_detail_ciphertext": {
        "type": "string",
        "title": "BankAccountDetailCiphertext",
        "description": "Base64 URL encoded encrypted payload, in this case bank details."
      },
      "bank_account_detail_tag": {
        "type": "string",
        "title": "BankAccountDetailTag",
        "description": "Base64 URL encoded authentication tag, used to verify payload integrity during decryption."
      },
      "bank_account_detail_single_resource_response": {
        "type": "object",
        "title": "BankAccountDetailSingleResourceResponse",
        "description": "",
        "properties": {
          "bank_account_details": {
            "type": "object",
            "description": "Retrieve bank account details in JWE encrypted format",
            "properties": {
              "protected": {
                "type": "string",
                "description": "Base64 URL encoded JWE header values, containing the following keys:\n\n  - `alg`: the asymmetric encryption type used to encrypt symmetric key, e.g: `RSA-OAEP`.\n  - `enc`: the content encryption type, e.g: `A256GCM`.\n  - `kid`: the ID of an RSA-2048 public key, from your JWKS, used to encrypt the AES key."
              },
              "encrypted_key": {
                "type": "string",
                "description": "Base64 URL encoded symmetric content encryption key, encrypted with the asymmetric key from your JWKS."
              },
              "iv": {
                "type": "string",
                "description": "Base64 URL encoded initialization vector, used during content encryption."
              },
              "ciphertext": {
                "type": "string",
                "description": "Base64 URL encoded encrypted payload, in this case bank details."
              },
              "tag": {
                "type": "string",
                "description": "Base64 URL encoded authentication tag, used to verify payload integrity during decryption."
              }
            }
          }
        }
      },
      "bank_account_holder_verification": {
        "type": "object",
        "title": "Bank Account Holder Verification",
        "description": "Create a bank account holder verification for a bank account.",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier for the bank account holder verification resource, e.g. \"BAHV123\".",
            "example": "BAHV123"
          },
          "type": {
            "description": "Type of the verification that has been performed\neg. [Confirmation of Payee](https://www.wearepay.uk/what-we-do/overlay-services/confirmation-of-payee/)",
            "example": "confirmation_of_payee",
            "enum": [
              "confirmation_of_payee"
            ],
            "type": "string"
          },
          "result": {
            "description": "Result of the verification, could be one of\n\n- `full_match`: The verification has confirmed that the account name exactly matches the details provided.\n- `partial_match`: The verification has confirmed that the account name is similar but does not match to the details provided.\n- `no_match`: The verification concludes the provided name does not match the account details.\n- `unable_to_match`: The verification could not be performed due to recipient bank issues or technical issues",
            "example": "partial_match",
            "enum": [
              "full_match",
              "partial_match",
              "no_match",
              "unable_to_match"
            ],
            "type": "string"
          },
          "actual_account_name": {
            "type": "string",
            "nullable": true,
            "description": "The actual account name returned by the recipient's bank, populated only in the case of a partial match.",
            "example": "Jo Doe"
          },
          "status": {
            "type": "string",
            "description": "The status of the bank account holder verification.\n\n- `pending`: We have triggered the verification, but the result has not come back yet.\n- `completed`: The verification is complete and is ready to be used.\n",
            "example": "pending",
            "enum": [
              "pending",
              "completed"
            ]
          }
        }
      },
      "bank_account_holder_verification_id": {
        "type": "string",
        "title": "BankAccountHolderVerificationId",
        "description": "The unique identifier for the bank account holder verification resource, e.g. \"BAHV123\".",
        "example": "BAHV123"
      },
      "bank_account_holder_verification_identity": {
        "type": "string",
        "title": "BankAccountHolderVerificationIdentity",
        "description": "The unique identifier for the bank account holder verification resource, e.g. \"BAHV123\".",
        "example": "BAHV123"
      },
      "bank_account_holder_verification_bank_account": {
        "type": "string",
        "title": "BankAccountHolderVerificationBankAccount",
        "description": "The ID of the bank account to verify, e.g. \"BA123\".",
        "example": "BA123"
      },
      "bank_account_holder_verification_type": {
        "title": "BankAccountHolderVerificationType",
        "description": "Type of the verification that has been performed\neg. [Confirmation of Payee](https://www.wearepay.uk/what-we-do/overlay-services/confirmation-of-payee/)",
        "example": "confirmation_of_payee",
        "enum": [
          "confirmation_of_payee"
        ],
        "type": "string"
      },
      "bank_account_holder_verification_result": {
        "title": "BankAccountHolderVerificationResult",
        "description": "Result of the verification, could be one of\n\n- `full_match`: The verification has confirmed that the account name exactly matches the details provided.\n- `partial_match`: The verification has confirmed that the account name is similar but does not match to the details provided.\n- `no_match`: The verification concludes the provided name does not match the account details.\n- `unable_to_match`: The verification could not be performed due to recipient bank issues or technical issues",
        "example": "partial_match",
        "enum": [
          "full_match",
          "partial_match",
          "no_match",
          "unable_to_match"
        ],
        "type": "string"
      },
      "bank_account_holder_verification_actual_account_name": {
        "type": "string",
        "nullable": true,
        "title": "BankAccountHolderVerificationActualAccountName",
        "description": "The actual account name returned by the recipient's bank, populated only in the case of a partial match.",
        "example": "Jo Doe"
      },
      "bank_account_holder_verification_status": {
        "type": "string",
        "title": "BankAccountHolderVerificationStatus",
        "description": "The status of the bank account holder verification.\n\n- `pending`: We have triggered the verification, but the result has not come back yet.\n- `completed`: The verification is complete and is ready to be used.\n",
        "example": "pending",
        "enum": [
          "pending",
          "completed"
        ]
      },
      "bank_account_holder_verification_single_resource_response": {
        "type": "object",
        "title": "BankAccountHolderVerificationSingleResourceResponse",
        "description": "",
        "properties": {
          "bank_account_holder_verifications": {
            "type": "object",
            "description": "Create a bank account holder verification for a bank account.",
            "properties": {
              "id": {
                "type": "string",
                "description": "The unique identifier for the bank account holder verification resource, e.g. \"BAHV123\".",
                "example": "BAHV123"
              },
              "type": {
                "description": "Type of the verification that has been performed\neg. [Confirmation of Payee](https://www.wearepay.uk/what-we-do/overlay-services/confirmation-of-payee/)",
                "example": "confirmation_of_payee",
                "enum": [
                  "confirmation_of_payee"
                ],
                "type": "string"
              },
              "result": {
                "description": "Result of the verification, could be one of\n\n- `full_match`: The verification has confirmed that the account name exactly matches the details provided.\n- `partial_match`: The verification has confirmed that the account name is similar but does not match to the details provided.\n- `no_match`: The verification concludes the provided name does not match the account details.\n- `unable_to_match`: The verification could not be performed due to recipient bank issues or technical issues",
                "example": "partial_match",
                "enum": [
                  "full_match",
                  "partial_match",
                  "no_match",
                  "unable_to_match"
                ],
                "type": "string"
              },
              "actual_account_name": {
                "type": "string",
                "nullable": true,
                "description": "The actual account name returned by the recipient's bank, populated only in the case of a partial match.",
                "example": "Jo Doe"
              },
              "status": {
                "type": "string",
                "description": "The status of the bank account holder verification.\n\n- `pending`: We have triggered the verification, but the result has not come back yet.\n- `completed`: The verification is complete and is ready to be used.\n",
                "example": "pending",
                "enum": [
                  "pending",
                  "completed"
                ]
              }
            }
          }
        }
      },
      "bank_authorisation": {
        "type": "object",
        "title": "Bank Authorisations",
        "description": "Bank Authorisations can be used to authorise Billing Requests. Authorisations\nare created against a specific bank, usually the bank that provides the payer's\naccount.\n\nCreation of Bank Authorisations is only permitted from GoCardless hosted UIs\n(see Billing Request Flows) to ensure we meet regulatory requirements for\ncheckout flows.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier, beginning with \"BAU\".",
            "example": "BAU123"
          },
          "redirect_uri": {
            "type": "string",
            "description": "URL that the payer can be redirected to after authorising the payment.\n\nOn completion of bank authorisation, the query parameter of either `outcome=success` or `outcome=failure` will be\nappended to the `redirect_uri` to indicate the result of the bank authorisation. If the bank authorisation is\nexpired, the query parameter `outcome=timeout` will be appended to the `redirect_uri`, in which case you should\nprompt the user to try the bank authorisation step again.\n\nPlease note: bank authorisations can still fail despite an `outcome=success` on the `redirect_uri`. It is therefore recommended to wait for the relevant bank authorisation event, such as [`BANK_AUTHORISATION_AUTHORISED`](#billing-request-bankauthorisationauthorised), [`BANK_AUTHORISATION_DENIED`](#billing-request-bankauthorisationdenied), or [`BANK_AUTHORISATION_FAILED`](#billing-request-bankauthorisationfailed) in order to show the correct outcome to the user.\n\nThe BillingRequestFlow ID will also be appended to the `redirect_uri` as query parameter `id=BRF123`.\n\nDefaults to `https://pay.gocardless.com/billing/static/thankyou`.",
            "example": "https://my-website.com/abc/callback"
          },
          "url": {
            "type": "string",
            "description": "URL for an oauth flow that will allow the user to authorise the payment",
            "example": "https://pay.gocardless.com/obauth/BAU123"
          },
          "qr_code_url": {
            "type": "string",
            "nullable": true,
            "description": "URL to a QR code PNG image of the bank authorisation url.\nThis QR code can be used as an alternative to providing the `url` to the payer to allow them to authorise with their mobile devices.",
            "example": "https://pay.gocardless.com/obauth/BAU123/qr_code"
          },
          "authorisation_type": {
            "type": "string",
            "description": "Type of authorisation, can be either 'mandate' or 'payment'.",
            "enum": [
              "mandate",
              "payment"
            ]
          },
          "created_at": {
            "type": "string",
            "description": "Timestamp when the flow was created",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "description": "Timestamp when the url will expire. Each authorisation url currently lasts for 15 minutes, but this can vary by bank.",
            "format": "date-time"
          },
          "last_visited_at": {
            "type": "string",
            "nullable": true,
            "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when the authorisation URL has been visited.",
            "example": "2020-01-01T12:00:00.000Z",
            "format": "date-time"
          },
          "authorised_at": {
            "type": "string",
            "nullable": true,
            "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when the user has been authorised.",
            "example": "2020-01-01T12:00:00.000Z",
            "format": "date-time"
          },
          "links": {
            "type": "object",
            "description": "",
            "properties": {
              "billing_request": {
                "type": "string",
                "description": "ID of the [billing request](#billing-requests-billing-requests) against which this authorisation was created.",
                "example": "BRQ123"
              },
              "institution": {
                "type": "string",
                "description": "ID of the [institution](#billing-requests-institutions) against which this authorisation was created.",
                "example": "monzo"
              }
            }
          }
        }
      },
      "bank_authorisation_id": {
        "type": "string",
        "title": "BankAuthorisationId",
        "description": "Unique identifier, beginning with \"BAU\".",
        "example": "BAU123"
      },
      "bank_authorisation_identity": {
        "type": "string",
        "title": "BankAuthorisationIdentity",
        "description": "Unique identifier, beginning with \"BAU\".",
        "example": "BAU123"
      },
      "bank_authorisation_authorisation_type": {
        "type": "string",
        "title": "BankAuthorisationAuthorisationType",
        "description": "Type of authorisation, can be either 'mandate' or 'payment'.",
        "enum": [
          "mandate",
          "payment"
        ]
      },
      "bank_authorisation_redirect_uri": {
        "type": "string",
        "title": "BankAuthorisationRedirectUri",
        "description": "URL that the payer can be redirected to after authorising the payment.\n\nOn completion of bank authorisation, the query parameter of either `outcome=success` or `outcome=failure` will be\nappended to the `redirect_uri` to indicate the result of the bank authorisation. If the bank authorisation is\nexpired, the query parameter `outcome=timeout` will be appended to the `redirect_uri`, in which case you should\nprompt the user to try the bank authorisation step again.\n\nPlease note: bank authorisations can still fail despite an `outcome=success` on the `redirect_uri`. It is therefore recommended to wait for the relevant bank authorisation event, such as [`BANK_AUTHORISATION_AUTHORISED`](#billing-request-bankauthorisationauthorised), [`BANK_AUTHORISATION_DENIED`](#billing-request-bankauthorisationdenied), or [`BANK_AUTHORISATION_FAILED`](#billing-request-bankauthorisationfailed) in order to show the correct outcome to the user.\n\nThe BillingRequestFlow ID will also be appended to the `redirect_uri` as query parameter `id=BRF123`.\n\nDefaults to `https://pay.gocardless.com/billing/static/thankyou`.",
        "example": "https://my-website.com/abc/callback"
      },
      "bank_authorisation_url": {
        "type": "string",
        "title": "BankAuthorisationUrl",
        "description": "URL for an oauth flow that will allow the user to authorise the payment",
        "example": "https://pay.gocardless.com/obauth/BAU123"
      },
      "bank_authorisation_qr_code_url": {
        "type": "string",
        "nullable": true,
        "title": "BankAuthorisationQrCodeUrl",
        "description": "URL to a QR code PNG image of the bank authorisation url.\nThis QR code can be used as an alternative to providing the `url` to the payer to allow them to authorise with their mobile devices.",
        "example": "https://pay.gocardless.com/obauth/BAU123/qr_code"
      },
      "bank_authorisation_created_at": {
        "type": "string",
        "title": "BankAuthorisationCreatedAt",
        "description": "Timestamp when the flow was created",
        "format": "date-time"
      },
      "bank_authorisation_expires_at": {
        "type": "string",
        "title": "BankAuthorisationExpiresAt",
        "description": "Timestamp when the url will expire. Each authorisation url currently lasts for 15 minutes, but this can vary by bank.",
        "format": "date-time"
      },
      "bank_authorisation_last_visited_at": {
        "type": "string",
        "nullable": true,
        "title": "BankAuthorisationLastVisitedAt",
        "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when the authorisation URL has been visited.",
        "example": "2020-01-01T12:00:00.000Z",
        "format": "date-time"
      },
      "bank_authorisation_authorised_at": {
        "type": "string",
        "nullable": true,
        "title": "BankAuthorisationAuthorisedAt",
        "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when the user has been authorised.",
        "example": "2020-01-01T12:00:00.000Z",
        "format": "date-time"
      },
      "bank_authorisation_payer_authorisation_visit_flow": {
        "type": "string",
        "title": "BankAuthorisationPayerAuthorisationVisitFlow",
        "description": "bank authorisation flow for the track visit event",
        "example": "desktop_to_mobile"
      },
      "bank_authorisation_links": {
        "type": "object",
        "title": "BankAuthorisationLinks",
        "description": "",
        "properties": {
          "billing_request": {
            "type": "string",
            "description": "ID of the [billing request](#billing-requests-billing-requests) against which this authorisation was created.",
            "example": "BRQ123"
          },
          "institution": {
            "type": "string",
            "description": "ID of the [institution](#billing-requests-institutions) against which this authorisation was created.",
            "example": "monzo"
          }
        }
      },
      "bank_authorisation_single_resource_response": {
        "type": "object",
        "title": "BankAuthorisationSingleResourceResponse",
        "description": "",
        "properties": {
          "bank_authorisations": {
            "type": "object",
            "description": "Bank Authorisations can be used to authorise Billing Requests. Authorisations\nare created against a specific bank, usually the bank that provides the payer's\naccount.\n\nCreation of Bank Authorisations is only permitted from GoCardless hosted UIs\n(see Billing Request Flows) to ensure we meet regulatory requirements for\ncheckout flows.",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier, beginning with \"BAU\".",
                "example": "BAU123"
              },
              "redirect_uri": {
                "type": "string",
                "description": "URL that the payer can be redirected to after authorising the payment.\n\nOn completion of bank authorisation, the query parameter of either `outcome=success` or `outcome=failure` will be\nappended to the `redirect_uri` to indicate the result of the bank authorisation. If the bank authorisation is\nexpired, the query parameter `outcome=timeout` will be appended to the `redirect_uri`, in which case you should\nprompt the user to try the bank authorisation step again.\n\nPlease note: bank authorisations can still fail despite an `outcome=success` on the `redirect_uri`. It is therefore recommended to wait for the relevant bank authorisation event, such as [`BANK_AUTHORISATION_AUTHORISED`](#billing-request-bankauthorisationauthorised), [`BANK_AUTHORISATION_DENIED`](#billing-request-bankauthorisationdenied), or [`BANK_AUTHORISATION_FAILED`](#billing-request-bankauthorisationfailed) in order to show the correct outcome to the user.\n\nThe BillingRequestFlow ID will also be appended to the `redirect_uri` as query parameter `id=BRF123`.\n\nDefaults to `https://pay.gocardless.com/billing/static/thankyou`.",
                "example": "https://my-website.com/abc/callback"
              },
              "url": {
                "type": "string",
                "description": "URL for an oauth flow that will allow the user to authorise the payment",
                "example": "https://pay.gocardless.com/obauth/BAU123"
              },
              "qr_code_url": {
                "type": "string",
                "nullable": true,
                "description": "URL to a QR code PNG image of the bank authorisation url.\nThis QR code can be used as an alternative to providing the `url` to the payer to allow them to authorise with their mobile devices.",
                "example": "https://pay.gocardless.com/obauth/BAU123/qr_code"
              },
              "authorisation_type": {
                "type": "string",
                "description": "Type of authorisation, can be either 'mandate' or 'payment'.",
                "enum": [
                  "mandate",
                  "payment"
                ]
              },
              "created_at": {
                "type": "string",
                "description": "Timestamp when the flow was created",
                "format": "date-time"
              },
              "expires_at": {
                "type": "string",
                "description": "Timestamp when the url will expire. Each authorisation url currently lasts for 15 minutes, but this can vary by bank.",
                "format": "date-time"
              },
              "last_visited_at": {
                "type": "string",
                "nullable": true,
                "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when the authorisation URL has been visited.",
                "example": "2020-01-01T12:00:00.000Z",
                "format": "date-time"
              },
              "authorised_at": {
                "type": "string",
                "nullable": true,
                "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when the user has been authorised.",
                "example": "2020-01-01T12:00:00.000Z",
                "format": "date-time"
              },
              "links": {
                "type": "object",
                "description": "",
                "properties": {
                  "billing_request": {
                    "type": "string",
                    "description": "ID of the [billing request](#billing-requests-billing-requests) against which this authorisation was created.",
                    "example": "BRQ123"
                  },
                  "institution": {
                    "type": "string",
                    "description": "ID of the [institution](#billing-requests-institutions) against which this authorisation was created.",
                    "example": "monzo"
                  }
                }
              }
            }
          }
        }
      },
      "bank_authorisation_multi_resource_response": {
        "type": "object",
        "title": "BankAuthorisationMultiResourceResponse",
        "description": "",
        "properties": {
          "bank_authorisations": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Bank Authorisations can be used to authorise Billing Requests. Authorisations\nare created against a specific bank, usually the bank that provides the payer's\naccount.\n\nCreation of Bank Authorisations is only permitted from GoCardless hosted UIs\n(see Billing Request Flows) to ensure we meet regulatory requirements for\ncheckout flows.",
