              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "Ruby",
            "label": "Ruby",
            "source": "@client.payout_items.list(params: {payout: \"PO123\"})"
          },
          {
            "lang": "Python",
            "label": "Python",
            "source": "client.payout_items.list(params={'payout': 'PO123'})"
          },
          {
            "lang": "JavaScript",
            "label": "JavaScript",
            "source": "const payoutItems = await client.payoutItems.list({ payout: \"P0123\" });\n\n// List the first three payout items for a payout\nconst limitedPayoutItems = await client.payoutItems.list({ payout: \"P0123\", limit: \"3\" });"
          },
          {
            "lang": "PHP",
            "label": "PHP",
            "source": "$client->payoutItems()->list([\n  'params' => ['payout' => 'PO123']\n]);"
          },
          {
            "lang": "Java",
            "label": "Java",
            "source": "client.payoutItems().all().withPayout(\"PO123\").execute();"
          },
          {
            "lang": "Go",
            "label": "Go",
            "source": "payoutItemsListParams := gocardless.PayoutItemListParams{\n  Payout: \"PO123\",\n}\n\npayoutItemsListResult, err := client.PayoutItems.List(ctx, payoutItemsListParams)\nfor _, payoutItem := range payoutItemsListResult.PayoutItems {\n    fmt.Println(payoutItem.Amount)\n}"
          },
          {
            "lang": "C#",
            "label": ".NET",
            "source": "var itemsRequest = new GoCardless.Services.PayoutItemListRequest()\n{\n    Payout = \"PO123\"\n};\n\nvar response = client.PayoutItems.All(itemsRequest);\nforeach (GoCardless.Resources.PayoutItem item in response)\n{\n    Console.WriteLine(item.Amount);\n}"
          },
          {
            "lang": "HTTP",
            "label": "HTTP",
            "source": "GET https://api.gocardless.com/payout_items?payout=PO123 HTTP/1.1\n\nHTTP/1.1 200 OK\nContent-Type: application/json\n{\n  \"payout_items\": [\n    {\n      \"amount\": \"4.0\",\n      \"type\": \"gocardless_fee\",\n      \"taxes\": [{\n        \"amount\": \"1.0\",\n        \"currency\": \"GBP\",\n        \"destination_amount\": \"1.1\",\n        \"destination_currency\": \"EUR\",\n        \"exchange_rate\": \"1.11205\",\n        \"tax_rate_id\": \"FR_VAT_1\"\n      }],\n      \"links\": {\n        \"payment\": \"PM456\"\n      }\n    },\n    {\n      \"amount\": \"1000.0\",\n      \"type\": \"payment_paid_out\",\n      \"taxes\": [],\n      \"links\": {\n        \"payment\": \"PM123\"\n      }\n    },\n    {\n      \"amount\": \"-24.0\",\n      \"type\": \"gocardless_fee\",\n      \"taxes\": [{\n        \"amount\": \"4.0\",\n        \"currency\": \"EUR\",\n        \"destination_amount\": \"4.0\",\n        \"destination_currency\": \"EUR\",\n        \"exchange_rate\": null,\n        \"tax_rate_id\": \"FR_VAT_1\"\n      }],\n      \"links\": {\n        \"payment\": \"PM123\"\n      }\n    },\n    {\n      \"amount\": \"30.0\",\n      \"type\": \"payment_paid_out\",\n      \"taxes\": [],\n      \"links\": {\n        \"payment\": \"PM456\"\n      }\n    },\n    {\n      \"amount\": \"-500.0\",\n      \"type\": \"payment_refunded\",\n      \"taxes\": [],\n      \"links\": {\n        \"payment\": \"PM789\"\n      }\n    },\n    {\n      \"amount\": \"4.0\",\n      \"type\": \"gocardless_fee\",\n      \"taxes\": [{\n        \"amount\": \"1.0\",\n        \"currency\": \"GBP\",\n        \"destination_amount\": \"1.1\",\n        \"destination_currency\": \"EUR\",\n        \"exchange_rate\": \"1.11205\",\n        \"tax_rate_id\": \"FR_VAT_1\"\n      }],\n      \"links\": {\n        \"payment\": \"PM456\"\n      }\n    },\n    {\n      \"amount\": \"-1.0\",\n      \"type\": \"app_fee\",\n      \"taxes\": [],\n      \"links\": {\n        \"payment\": \"PM456\"\n      }\n    }\n  ],\n  \"meta\": {\n    \"cursors\": { \"before\": null, \"after\": null },\n    \"limit\": 50\n  }\n}\n\nGET https://api.gocardless.com/payout_items?payout=PO456 HTTP/1.1\n\nHTTP/1.1 410 Gone\nContent-Type: application/json\n{\n    \"error\": {\n      \"documentation_url\": \"https://developer.gocardless.com/api-reference#payout_items_data_archived\",\n      \"message\": \"Payout items for payouts created more than 6 months ago are archived. Please contact support if you require access to this data.\",\n      \"type\": \"invalid_api_usage\",\n      \"errors\": [\n        {\n          \"reason\": \"payout_items_data_archived\",\n          \"message\": \"Payout items for payouts created more than 6 months ago are archived. Please contact support if you require access to this data.\"\n        }\n      ],\n      \"code\": 410,\n      \"request_id\": \"deadbeef-0000-4000-0000-444400004444\"\n    }\n}"
          }
        ]
      }
    },
    "/redirect_flows": {
      "post": {
        "operationId": "create_redirect_flow",
        "summary": "Create a redirect flow",
        "description": "Creates a redirect flow object which can then be used to redirect your customer to the GoCardless hosted payment pages.\n\n**Deprecated:** Redirect Flows are legacy APIs and cannot be used by new integrators.\nThe [Billing Request flow](#billing-requests) API should be used for your payment flows.",
        "tags": [
          "Redirect Flow"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GoCardlessVersionHeader"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/redirect_flow_single_resource_response"
                }
              }
            },
            "description": "Resource created successfully"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "redirect_flows": {
                    "type": "object",
                    "properties": {
                      "description": {
                        "$ref": "#/components/schemas/redirect_flow_description"
                      },
                      "session_token": {
                        "$ref": "#/components/schemas/redirect_flow_session_token"
                      },
                      "scheme": {
                        "$ref": "#/components/schemas/redirect_flow_scheme"
                      },
                      "success_redirect_url": {
                        "$ref": "#/components/schemas/redirect_flow_success_redirect_url"
                      },
                      "prefilled_customer": {
                        "type": "object",
                        "description": "Customer information used to prefill the payment page so your customer doesn't have to re-type details you already hold about them. It will be stored unvalidated and the customer will be able to review and amend it before completing the form.",
                        "properties": {
                          "email": {
                            "type": "string",
                            "nullable": true,
                            "description": "Customer's email address.",
                            "example": "user@example.com"
                          },
                          "given_name": {
                            "type": "string",
                            "nullable": true,
                            "description": "Customer's first name.",
                            "example": "Frank"
                          },
                          "family_name": {
                            "type": "string",
                            "nullable": true,
                            "description": "Customer's surname.",
                            "example": "Osborne"
                          },
                          "company_name": {
                            "type": "string",
                            "nullable": true,
                            "description": "Customer's company name. Company name should only be provided if `given_name` and `family_name` are null.",
                            "example": "Hamilton Trading Ltd."
                          },
                          "address_line1": {
                            "type": "string",
                            "nullable": true,
                            "description": "The first line of the customer's address.",
                            "example": "221B Baker Street"
                          },
                          "address_line2": {
                            "type": "string",
                            "nullable": true,
                            "description": "The second line of the customer's address.",
                            "example": "Marylebone"
                          },
                          "address_line3": {
                            "type": "string",
                            "nullable": true,
                            "description": "The third line of the customer's address.",
                            "example": "City of Westminster"
                          },
                          "city": {
                            "type": "string",
                            "nullable": true,
                            "description": "The city of the customer's address.",
                            "example": "London"
                          },
                          "region": {
                            "type": "string",
                            "nullable": true,
                            "description": "The customer's address region, county or department.",
                            "example": "Greater London"
                          },
                          "postal_code": {
                            "type": "string",
                            "nullable": true,
                            "description": "The customer's postal code.",
                            "example": "NW1 6XE"
                          },
                          "country_code": {
                            "type": "string",
                            "nullable": true,
                            "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                            "example": "GB"
                          },
                          "language": {
                            "type": "string",
                            "nullable": true,
                            "description": "[ISO 639-1](https://en.wikipedia.org/wiki/List_of_ISO_639-1_codes) code.",
                            "example": "en"
                          },
                          "phone_number": {
                            "type": "string",
                            "nullable": true,
                            "description": "For New Zealand customers only.",
                            "example": "+64 4 817 9999"
                          },
                          "swedish_identity_number": {
                            "type": "string",
                            "nullable": true,
                            "description": "For Swedish customers only. The civic/company number (personnummer, samordningsnummer, or organisationsnummer) of the customer.",
                            "example": "556564-5404"
                          },
                          "danish_identity_number": {
                            "type": "string",
                            "nullable": true,
                            "description": "For Danish customers only. The civic/company number (CPR or CVR) of the customer.",
                            "example": "220550-6218"
                          }
                        }
                      },
                      "prefilled_bank_account": {
                        "type": "object",
                        "description": "Bank account information used to prefill the payment page so your customer doesn't have to re-type details you already hold about them. It will be stored unvalidated and the customer will be able to review and amend it before completing the form.",
                        "properties": {
                          "account_type": {
                            "description": "Bank account type for USD-denominated bank accounts. Must not be provided for bank accounts in other currencies. See [local details](#local-bank-details-united-states) for more information.",
                            "example": "savings",
                            "enum": [
                              "savings",
                              "checking"
                            ],
                            "nullable": true,
                            "type": "string"
                          }
                        }
                      },
                      "links": {
                        "type": "object",
                        "description": "",
                        "properties": {
                          "creditor": {
                            "type": "string",
                            "description": "The [creditor](#core-endpoints-creditors) for whom the mandate will be created. The `name` of the creditor will be displayed on the payment page. Required if your account manages multiple creditors.",
                            "example": "CR123"
                          }
                        }
                      },
                      "metadata": {
                        "$ref": "#/components/schemas/redirect_flow_metadata"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": true,
        "x-codeSamples": [
          {
            "lang": "Ruby",
            "label": "Ruby",
            "source": "@client.redirect_flows.create(\n  params: {\n    description: \"Team membership\",\n    session_token: \"my_unique_tracking_id\",\n    success_redirect_url: \"https://example.com/pay/confirm\",\n    prefilled_customer: {\n      given_name: \"Frank\",\n      family_name: \"Osborne\",\n      email: \"frank.osborne@acmeplc.com\"\n    }\n  }\n)"
          },
