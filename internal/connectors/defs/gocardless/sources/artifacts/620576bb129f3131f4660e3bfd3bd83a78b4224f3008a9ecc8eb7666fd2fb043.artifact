    "/customers": {
      "post": {
        "operationId": "create_customer",
        "summary": "Create a customer",
        "description": "Creates a new customer object.\n\n<p class=\"restricted-notice\"><strong>Restricted</strong>: this endpoint is [restricted](#overview-restrictions) to [GoCardless Pro](https://gocardless.com/pricing) and [GoCardless Enterprise](https://gocardless.com/pricing) accounts with approved payment pages.</p>\n\n<p class=\"notice--warning\"><strong>Warning</strong>: this endpoint is a legacy API endpoint and does not support GoCardless' newest features. We recommend using the [Billing Requests API](/billing-requests/overview) instead.</p>",
