    "/bank_account_holder_verifications": {
      "post": {
        "operationId": "create_bank_account_holder_verification",
        "summary": "Create a bank account holder verification.",
        "description": "Verify the account holder of the bank account. A complete verification can be attached when creating an outbound payment. \nThis endpoint allows partner merchants to create Confirmation of Payee checks on customer bank accounts before sending outbound payments.\n\n<p class=\"restricted-notice\"><strong>Restricted</strong>: This endpoint is restricted to organisations with Outbound Payments enabled</p>",
        "tags": [
          "Bank Account Holder Verification"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GoCardlessVersionHeader"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/bank_account_holder_verification_single_resource_response"
                }
              }
            },
            "description": "Resource created successfully"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bank_account_holder_verifications": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/components/schemas/bank_account_holder_verification_type"
                      },
                      "links": {
                        "type": "object",
                        "properties": {
                          "bank_account": {
                            "$ref": "#/components/schemas/bank_account_holder_verification_bank_account"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "Ruby",
            "label": "Ruby",
            "source": "@client.bank_account_holder_verifications.create(\n  params: {\n    type: \"confirmation_of_payee\",\n    links: {\n      bank_account: \"BA123\"\n    }\n  }\n)"
          },
          {
            "lang": "Python",
            "label": "Python",
            "source": "client.bank_account_holder_verifications.create(params={\n  \"type\": \"confirmation_of_payee\",\n  \"links\": {\n    \"bank_account\": \"BA123\"\n  }\n})"
          },
          {
            "lang": "JavaScript",
            "label": "JavaScript",
            "source": "const verification = await client.bankAccountHolderVerifications.create({\n  type: \"confirmation_of_payee\",\n  links: {\n    bank_account: \"BA123\"\n  }\n});"
          },
          {
            "lang": "PHP",
            "label": "PHP",
            "source": "$client->bankAccountHolderVerifications()->create([\n  \"params\" => [\n    \"type\" => \"confirmation_of_payee\",\n    \"links\" => [\n      \"bank_account\" => \"BA123\"\n    ]\n  ]\n]);"
          },
          {
            "lang": "Java",
            "label": "Java",
            "source": "import com.gocardless.services.BankAccountHolderVerificationService.BankAccountHolderVerificationCreateRequest.Type;\n\nclient.bankAccountHolderVerifications().create()\n  .withType(Type.CONFIRMATION_OF_PAYEE)\n  .withLinksBankAccount(\"BA123\")\n  .execute();"
          },
          {
            "lang": "Go",
            "label": "Go",
            "source": "bankAccountHolderVerificationCreateParams := gocardless.BankAccountHolderVerificationCreateParams{\n  Type: \"confirmation_of_payee\",\n  Links: gocardless.BankAccountHolderVerificationCreateParamsLinks{\n    BankAccount: \"BA123\",\n  },\n}\n\nverification, err := client.BankAccountHolderVerifications.Create(ctx, bankAccountHolderVerificationCreateParams)"
          },
          {
            "lang": "C#",
            "label": ".NET",
            "source": "var verificationLinks = new GoCardless.Services.BankAccountHolderVerificationCreateRequest.BankAccountHolderVerificationLinks\n{\n  BankAccount = \"BA123\"\n};\n\nvar resp = await client.BankAccountHolderVerifications.CreateAsync(\n  new GoCardless.Services.BankAccountHolderVerificationCreateRequest()\n  {\n    Type = GoCardless.Services.BankAccountHolderVerificationCreateRequest.BankAccountHolderVerificationType.ConfirmationOfPayee,\n    Links = verificationLinks,\n  }\n);"
          },
          {
            "lang": "HTTP",
            "label": "HTTP",
            "source": "POST https://api.gocardless.com/bank_account_holder_verifications HTTP/1.1\nContent-Type: application/json\n{\n  \"bank_account_holder_verifications\": {\n    \"type\": \"confirmation_of_payee\",\n    \"links\": {\n      \"bank_account\": \"BA123\"\n    }\n  }\n}\n\nHTTP/1.1 201 Created\nContent-Type: application/json\n{\n  \"bank_account_holder_verifications\": {\n    \"id\": \"BAHV123\",\n    \"type\": \"confirmation_of_payee\",\n    \"result\": \"partial_match\",\n    \"status\": \"pending\"\n  }\n}"
          }
        ]
      }
    },
