    "/subscriptions/{subscription_id}/actions/cancel": {
      "post": {
        "operationId": "cancel_subscription",
        "summary": "Cancel a subscription",
        "description": "Immediately cancels a subscription; no more payments will be created under it. Any metadata supplied to this endpoint will be stored on the payment cancellation event it causes.\n\nThis will fail with a cancellation_failed error if the subscription is already cancelled or finished.\n\n<p class=\"notice--warning\"><strong>Warning</strong>: Please note that this will not cancel any payments that have already been created\nfrom this subscription — these payments will still be collected unless you also\nmanually cancel them.</p>",
        "tags": [
          "Subscription"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GoCardlessVersionHeader"
