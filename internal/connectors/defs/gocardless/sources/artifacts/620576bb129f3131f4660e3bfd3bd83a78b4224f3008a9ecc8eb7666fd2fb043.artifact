                      "iban": {
                        "$ref": "#/components/schemas/mandate_pdf_iban"
                      },
                      "bic": {
                        "$ref": "#/components/schemas/mandate_pdf_bic"
                      },
                      "account_number": {
                        "$ref": "#/components/schemas/mandate_pdf_account_number"
                      },
                      "bank_code": {
                        "$ref": "#/components/schemas/mandate_pdf_bank_code"
                      },
                      "branch_code": {
                        "$ref": "#/components/schemas/mandate_pdf_branch_code"
                      },
                      "account_holder_name": {
                        "$ref": "#/components/schemas/mandate_pdf_account_holder_name"
                      },
                      "given_name": {
                        "$ref": "#/components/schemas/mandate_pdf_given_name"
                      },
                      "family_name": {
                        "$ref": "#/components/schemas/mandate_pdf_family_name"
                      },
                      "company_name": {
                        "$ref": "#/components/schemas/mandate_pdf_company_name"
                      },
                      "mandate_reference": {
                        "$ref": "#/components/schemas/mandate_pdf_mandate_reference"
                      },
                      "signature_date": {
                        "$ref": "#/components/schemas/mandate_pdf_signature_date"
                      },
                      "phone_number": {
                        "$ref": "#/components/schemas/mandate_pdf_phone_number"
                      },
                      "swedish_identity_number": {
                        "$ref": "#/components/schemas/mandate_pdf_swedish_identity_number"
                      },
                      "danish_identity_number": {
                        "$ref": "#/components/schemas/mandate_pdf_danish_identity_number"
