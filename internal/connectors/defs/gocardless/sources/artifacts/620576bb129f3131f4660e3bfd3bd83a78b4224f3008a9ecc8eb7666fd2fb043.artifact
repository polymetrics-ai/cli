      "outbound_payment_import_single_resource_response": {
        "type": "object",
        "title": "OutboundPaymentImportSingleResourceResponse",
        "description": "",
        "properties": {
          "outbound_payment_imports": {
            "type": "object",
            "description": "Outbound Payment Imports allow you to create multiple payments via a single API call.\n\nThe Workflow:\n1. Create the outbound payment import.\n2. Retrieve an authorisation link from the response.\n3. Redirect the user to the link to authorise the import.\n4. Once the user authorises the import, the individual outbound payments are automatically submitted.\n\nImport entries are not processed as actual payments until they are reviewed and authorised in GoCardless Dashboard.\nUpon approval, a unique outbound payment is generated for every entry in the import.\n\n<p class=\"notice\">Outbound Payment Imports are capped at 1000 entries. If you expect to exceed this limit, please create multiple smaller imports.</p>",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier, beginning with \"IM\".",
                "example": "IM123"
              },
              "created_at": {
                "type": "string",
                "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                "example": "2014-01-01T12:00:00.000Z",
                "format": "date-time"
              },
              "status": {
                "description": "The status of the outbound payment import.\n\n- `created`: The initial state of a new import.\n- `validating`: Import validation in progress.\n- `invalid`: Import validation failed.\n- `valid`: Import validation succeeded.\n- `processing`: Authorisation received; payments are being generated.\n- `processed`: All entries have been successfully converted into outbound payments.\n- `cancelled`: The import was cancelled by a user or automatically expired by the system.",
                "example": "created",
                "enum": [
                  "created",
                  "validating",
                  "valid",
                  "invalid",
                  "processing",
                  "processed",
                  "cancelled"
                ],
                "type": "string"
              },
              "amount_sum": {
                "type": "integer",
                "description": "The sum of all import entry amounts, in the lowest denomination for the currency (e.g. pence in GBP, cents in EUR).",
                "example": 1000
              },
              "currency": {
                "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency. Currently only \"GBP\" is supported.",
                "example": "GBP",
                "enum": [
                  "GBP"
                ],
                "type": "string"
              },
              "authorisation_url": {
                "type": "string",
                "description": "The link to the GoCardless dashboard to review and authorise the import",
                "example": "https://manage.gocardless.com/imports/IM123"
              },
              "entry_counts": {
                "type": "object",
                "description": "",
                "properties": {
                  "total": {
                    "type": "integer",
                    "description": "The total number of entries included in the import.",
                    "example": 1000
                  },
                  "valid": {
                    "type": "integer",
                    "description": "Count of entries that passed validation checks.",
                    "example": 1000
                  },
                  "invalid": {
                    "type": "integer",
                    "description": "Count of entries that failed validation checks.",
                    "example": 0
                  },
                  "processed": {
                    "type": "integer",
                    "description": "Count of entries successfully converted into outbound payments after the import was authorised.",
                    "example": 1000
                  },
                  "failed_to_process": {
                    "type": "integer",
                    "description": "Count of entries that encountered a terminal error during the outbound payment generation process.",
                    "example": 0
                  },
                  "verified": {
                    "type": "integer",
                    "description": "Total count of entries checked against bank account holder verification services (e.g., CoP).",
                    "example": 0
                  },
                  "verified_with_full_match": {
                    "type": "integer",
                    "description": "Count of entries where the account holder name was a direct match.",
                    "example": 0
                  },
                  "verified_with_partial_match": {
                    "type": "integer",
                    "description": "Count of entries where the account holder name was a close match.",
                    "example": 0
                  },
                  "verified_with_no_match": {
                    "type": "integer",
                    "description": "Count of entries where the account holder name did not match the records.",
                    "example": 0
                  },
                  "verified_with_unable_to_match": {
                    "type": "integer",
                    "description": "Count of entries where the verification service could not return a definitive result.",
                    "example": 0
                  }
                }
              },
              "links": {
                "type": "object",
                "description": "",
                "properties": {
                  "creditor": {
                    "type": "string",
                    "description": "ID of the creditor who sends the outbound payments from the import.",
                    "example": "CR123"
                  }
                }
              }
            }
          }
        }
      },
      "outbound_payment_import_pagination_meta": {
        "type": "object",
        "title": "OutboundPaymentImportPaginationMeta",
        "description": "Cursor pagination information",
        "properties": {
          "limit": {
            "type": "integer",
            "example": 50
          },
          "cursors": {
            "type": "object",
            "properties": {
