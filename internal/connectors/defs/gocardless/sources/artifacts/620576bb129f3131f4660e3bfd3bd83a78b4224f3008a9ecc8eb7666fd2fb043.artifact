      "logo": {
        "type": "object",
        "title": "Logos",
        "description": "Logos are image uploads that, when associated with a creditor, are shown on the [billing request flow](#billing-requests-billing-request-flows) payment pages.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier, beginning with \"LO\".",
            "example": "LO123"
          }
        }
      },
      "logo_id": {
        "type": "string",
        "title": "LogoId",
        "description": "Unique identifier, beginning with \"LO\".",
        "example": "LO123"
      },
      "logo_identity": {
        "type": "string",
        "title": "LogoIdentity",
        "description": "Unique identifier, beginning with \"LO\".",
        "example": "LO123"
      },
      "logo_single_resource_response": {
        "type": "object",
        "title": "LogoSingleResourceResponse",
        "description": "",
        "properties": {
          "logos": {
            "type": "object",
            "description": "Logos are image uploads that, when associated with a creditor, are shown on the [billing request flow](#billing-requests-billing-request-flows) payment pages.",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier, beginning with \"LO\".",
                "example": "LO123"
              }
            }
          }
        }
      },
      "mandate": {
        "type": "object",
        "title": "Mandates",
        "description": "Mandates represent the Direct Debit mandate with a [customer](#core-endpoints-customers).\n\nGoCardless will notify you via a [webhook](#appendix-webhooks) whenever the status of a mandate changes.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier, beginning with \"MD\". Note that this prefix may not apply to mandates created before 2016.",
            "example": "MD123"
          },
          "created_at": {
            "type": "string",
            "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
            "example": "2014-01-01T12:00:00.000Z",
            "format": "date-time"
          },
          "reference": {
            "type": "string",
            "nullable": true,
            "description": "Unique reference. Different schemes have different length and [character set](#appendix-character-sets) requirements. GoCardless will generate a unique reference satisfying the different scheme requirements if this field is left blank.",
            "example": "REF-123"
          },
          "status": {
            "description": "One of:\n\n- `pending_customer_approval`: the mandate has not yet been signed by the second customer\n- `pending_submission`: the mandate has not yet been submitted to the customer's bank\n- `submitted`: the mandate has been submitted to the customer's bank but has not been processed yet\n- `active`: the mandate has been successfully set up by the customer's bank\n- `suspended_by_payer`: the mandate has been suspended by payer\n- `failed`: the mandate could not be created\n- `cancelled`: the mandate has been cancelled\n- `expired`: the mandate has expired due to dormancy\n- `consumed`: the mandate has been consumed and cannot be reused (note that this only applies to schemes that are per-payment authorised)\n- `blocked`: the mandate has been blocked and payments cannot be created",
            "example": "pending_submission",
            "enum": [
              "pending_customer_approval",
              "pending_submission",
              "submitted",
              "active",
              "failed",
              "cancelled",
              "expired",
              "consumed",
              "blocked",
              "suspended_by_payer"
            ],
            "type": "string"
          },
          "scheme": {
            "type": "string",
            "nullable": true,
            "description": "<a name=\"mandates_scheme\"></a>Bank payment scheme to which this mandate and associated payments are submitted. Can be supplied or automatically detected from the customer's bank account.",
            "example": "bacs"
          },
          "mandate_type": {
            "type": "string",
            "nullable": true,
            "description": "Mandate type",
            "example": "bank_debit",
            "enum": [
              "bank_debit",
              "instant",
              "recurring",
              "vrp_commercial",
              "vrp_sweeping"
            ]
          },
          "next_possible_charge_date": {
            "type": "string",
            "nullable": true,
            "description": "The earliest date that can be used as a `charge_date` on any newly created payment for this mandate. This value will change over time.",
            "example": "2014-10-27",
            "format": "date"
          },
          "next_possible_standard_ach_charge_date": {
            "type": "string",
            "nullable": true,
            "description": "If this is an an ACH mandate, the earliest date that can be used as a\n`charge_date` on any newly created payment to be charged through standard\nACH, rather than Faster ACH. This value will change over time.\n\nIt is only present in the API response for ACH mandates.",
            "example": "2014-10-27",
            "format": "date"
          },
          "payments_require_approval": {
            "type": "boolean",
            "description": "Boolean value showing whether payments and subscriptions under this mandate require approval via an automated email before being processed."
          },
          "verified_at": {
            "type": "string",
            "nullable": true,
            "description": "[Timestamp](#api-usage-dates-and-times) recording when this mandate was verified.",
            "example": "2021-01-01T12:00:00.000Z",
            "format": "date-time"
          },
          "metadata": {
            "type": "object",
            "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
          },
          "links": {
            "type": "object",
            "description": "",
            "properties": {
              "customer_bank_account": {
                "type": "string",
                "description": "ID of the associated [customer bank account](#core-endpoints-customer-bank-accounts) which the mandate is created and submits payments against.",
                "example": "BA123"
              },
              "creditor": {
                "type": "string",
                "description": "ID of the associated [creditor](#core-endpoints-creditors).",
                "example": "CR123"
              },
              "new_mandate": {
                "type": "string",
                "description": "ID of the new mandate if this mandate has been replaced.",
                "example": "MD123"
              },
              "customer": {
                "type": "string",
                "description": "ID of the associated [customer](#core-endpoints-customers)",
                "example": "CU123"
              }
            }
          },
          "consent_parameters": {
            "type": "object",
            "nullable": true,
            "description": "(Optional) Payto and VRP Scheme specific information",
            "properties": {
              "max_amount_per_payment": {
                "type": "integer",
                "description": "The maximum amount that can be charged for a single payment"
              },
              "period": {
                "description": "The repeating period for this mandate",
                "enum": [
                  "day",
                  "week",
                  "month",
                  "year",
                  "flexible"
                ],
                "type": "string"
              },
              "max_amount_per_period": {
                "type": "integer",
                "description": "The maximum total amount that can be charged for all payments in this period"
              },
              "max_payments_per_period": {
                "type": "integer",
                "description": "The maximum number of payments that can be collected in this period"
              },
              "start_date": {
                "type": "string",
                "description": "The date from which payments can be taken"
              },
              "end_date": {
                "type": "string",
                "description": "The latest date at which payments can be taken, must occur after start_date if present"
              }
            }
          },
          "authorisation_source": {
            "description": "This field is ACH specific, sometimes referred to as [SEC code](https://www.moderntreasury.com/learn/sec-codes).\n\nThis is the way that the payer gives authorisation to the merchant.\n  web: Authorisation is Internet Initiated or via Mobile Entry (maps to SEC code: WEB)\n  telephone: Authorisation is provided orally over telephone (maps to SEC code: TEL)\n  paper: Authorisation is provided in writing and signed, or similarly authenticated (maps to SEC code: PPD)\n",
            "enum": [
              "web",
              "telephone",
              "paper"
            ],
            "type": "string"
          },
          "funds_settlement": {
            "description": "This field will decide how GoCardless handles settlement of funds from the customer.\n\n- `managed` will be moved through GoCardless' account, batched, and payed out.\n- `direct` will be a direct transfer from the payer's account to the merchant where\n  invoicing will be handled separately.\n",
            "enum": [
              "managed",
              "direct"
            ],
            "type": "string"
          },
          "consent_type": {
            "type": "string",
            "nullable": true,
            "description": "(Optional) Specifies the type of authorisation agreed between the payer and merchant. It can be set to one-off, recurring or standing for ACH, or single, recurring and sporadic for PAD.",
            "enum": [
              "one_off",
              "single",
              "recurring",
              "standing",
              "sporadic"
            ]
          }
        }
      },
      "mandate_id": {
        "type": "string",
        "title": "MandateId",
        "description": "Unique identifier, beginning with \"MD\". Note that this prefix may not apply to mandates created before 2016.",
        "example": "MD123"
      },
      "mandate_identity": {
        "type": "string",
        "title": "MandateIdentity",
        "description": "Unique identifier, beginning with \"MD\". Note that this prefix may not apply to mandates created before 2016.",
        "example": "MD123"
      },
      "mandate_created_at": {
        "type": "string",
        "title": "MandateCreatedAt",
        "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
        "example": "2014-01-01T12:00:00.000Z",
        "format": "date-time"
      },
      "mandate_reference": {
        "type": "string",
        "nullable": true,
        "title": "MandateReference",
        "description": "Unique reference. Different schemes have different length and [character set](#appendix-character-sets) requirements. GoCardless will generate a unique reference satisfying the different scheme requirements if this field is left blank.",
        "example": "REF-123"
      },
      "mandate_status": {
        "title": "MandateStatus",
        "description": "One of:\n\n- `pending_customer_approval`: the mandate has not yet been signed by the second customer\n- `pending_submission`: the mandate has not yet been submitted to the customer's bank\n- `submitted`: the mandate has been submitted to the customer's bank but has not been processed yet\n- `active`: the mandate has been successfully set up by the customer's bank\n- `suspended_by_payer`: the mandate has been suspended by payer\n- `failed`: the mandate could not be created\n- `cancelled`: the mandate has been cancelled\n- `expired`: the mandate has expired due to dormancy\n- `consumed`: the mandate has been consumed and cannot be reused (note that this only applies to schemes that are per-payment authorised)\n- `blocked`: the mandate has been blocked and payments cannot be created",
        "example": "pending_submission",
        "enum": [
          "pending_customer_approval",
          "pending_submission",
          "submitted",
          "active",
          "failed",
          "cancelled",
          "expired",
          "consumed",
          "blocked",
          "suspended_by_payer"
        ],
        "type": "string"
      },
      "mandate_scheme": {
        "type": "string",
        "nullable": true,
        "title": "MandateScheme",
        "description": "<a name=\"mandates_scheme\"></a>Bank payment scheme to which this mandate and associated payments are submitted. Can be supplied or automatically detected from the customer's bank account.",
        "example": "bacs"
      },
      "mandate_mandate_type": {
        "type": "string",
        "nullable": true,
        "title": "MandateMandateType",
        "description": "Mandate type",
        "example": "bank_debit",
        "enum": [
          "bank_debit",
          "instant",
          "recurring",
          "vrp_commercial",
          "vrp_sweeping"
        ]
      },
      "mandate_next_possible_charge_date": {
        "type": "string",
        "nullable": true,
        "title": "MandateNextPossibleChargeDate",
        "description": "The earliest date that can be used as a `charge_date` on any newly created payment for this mandate. This value will change over time.",
        "example": "2014-10-27",
        "format": "date"
      },
      "mandate_next_possible_standard_ach_charge_date": {
        "type": "string",
        "nullable": true,
        "title": "MandateNextPossibleStandardAchChargeDate",
        "description": "If this is an an ACH mandate, the earliest date that can be used as a\n`charge_date` on any newly created payment to be charged through standard\nACH, rather than Faster ACH. This value will change over time.\n\nIt is only present in the API response for ACH mandates.",
        "example": "2014-10-27",
        "format": "date"
      },
      "mandate_payments_require_approval": {
        "type": "boolean",
        "title": "MandatePaymentsRequireApproval",
        "description": "Boolean value showing whether payments and subscriptions under this mandate require approval via an automated email before being processed."
      },
      "mandate_payer_ip_address": {
        "type": "string",
        "nullable": true,
        "title": "MandatePayerIpAddress",
        "description": "For ACH customers only. Required for ACH customers. A string containing the IP address of the payer to whom the mandate belongs (i.e. as a result of their completion of a mandate setup flow in their browser).\n\nNot required for creating offline mandates where `authorisation_source` is set to telephone or paper.\n",
        "example": "127.0.0.1"
      },
      "mandate_verified_at": {
        "type": "string",
        "nullable": true,
        "title": "MandateVerifiedAt",
        "description": "[Timestamp](#api-usage-dates-and-times) recording when this mandate was verified.",
        "example": "2021-01-01T12:00:00.000Z",
        "format": "date-time"
      },
      "mandate_period": {
        "title": "MandatePeriod",
        "description": "The repeating period for this mandate",
        "enum": [
          "day",
          "week",
          "month",
          "year",
          "flexible"
        ],
        "type": "string"
      },
      "mandate_max_amount_per_period": {
        "type": "integer",
        "title": "MandateMaxAmountPerPeriod",
        "description": "The maximum total amount that can be charged for all payments in this period"
      },
      "mandate_max_payments_per_period": {
        "type": "integer",
        "title": "MandateMaxPaymentsPerPeriod",
        "description": "The maximum number of payments that can be collected in this period"
      },
      "mandate_start_date": {
        "type": "string",
        "title": "MandateStartDate",
        "description": "The date from which payments can be taken"
      },
      "mandate_end_date": {
        "type": "string",
        "title": "MandateEndDate",
        "description": "The latest date at which payments can be taken, must occur after start_date if present"
      },
      "mandate_max_amount_per_payment": {
        "type": "integer",
        "title": "MandateMaxAmountPerPayment",
        "description": "The maximum amount that can be charged for a single payment"
      },
      "mandate_consent_type": {
        "type": "string",
        "nullable": true,
        "title": "MandateConsentType",
        "description": "(Optional) Specifies the type of authorisation agreed between the payer and merchant. It can be set to one-off, recurring or standing for ACH, or single, recurring and sporadic for PAD.",
        "enum": [
          "one_off",
          "single",
          "recurring",
          "standing",
          "sporadic"
        ]
      },
      "mandate_consent_parameters": {
        "type": "object",
        "nullable": true,
        "title": "MandateConsentParameters",
        "description": "(Optional) Payto and VRP Scheme specific information",
        "properties": {
          "max_amount_per_payment": {
            "type": "integer",
            "description": "The maximum amount that can be charged for a single payment"
          },
          "period": {
            "description": "The repeating period for this mandate",
            "enum": [
              "day",
              "week",
              "month",
              "year",
              "flexible"
            ],
            "type": "string"
          },
          "max_amount_per_period": {
            "type": "integer",
            "description": "The maximum total amount that can be charged for all payments in this period"
          },
          "max_payments_per_period": {
            "type": "integer",
            "description": "The maximum number of payments that can be collected in this period"
          },
          "start_date": {
            "type": "string",
            "description": "The date from which payments can be taken"
          },
          "end_date": {
            "type": "string",
            "description": "The latest date at which payments can be taken, must occur after start_date if present"
          }
        }
      },
      "mandate_funds_settlement": {
        "title": "MandateFundsSettlement",
        "description": "This field will decide how GoCardless handles settlement of funds from the customer.\n\n- `managed` will be moved through GoCardless' account, batched, and payed out.\n- `direct` will be a direct transfer from the payer's account to the merchant where\n  invoicing will be handled separately.\n",
        "enum": [
          "managed",
          "direct"
        ],
        "type": "string"
      },
      "mandate_links": {
        "type": "object",
        "title": "MandateLinks",
        "description": "",
        "properties": {
          "customer_bank_account": {
            "type": "string",
            "description": "ID of the associated [customer bank account](#core-endpoints-customer-bank-accounts) which the mandate is created and submits payments against.",
            "example": "BA123"
          },
          "creditor": {
            "type": "string",
            "description": "ID of the associated [creditor](#core-endpoints-creditors).",
            "example": "CR123"
          },
          "new_mandate": {
            "type": "string",
            "description": "ID of the new mandate if this mandate has been replaced.",
            "example": "MD123"
          },
          "customer": {
            "type": "string",
            "description": "ID of the associated [customer](#core-endpoints-customers)",
            "example": "CU123"
          }
        }
      },
      "mandate_pagination_meta": {
        "type": "object",
        "title": "MandatePaginationMeta",
        "description": "Cursor pagination information",
        "properties": {
          "limit": {
            "type": "integer",
            "example": 50
          },
          "cursors": {
            "type": "object",
            "properties": {
              "before": {
                "type": "string",
                "nullable": true,
                "description": "Cursor pointing to the end of the desired set."
              },
              "after": {
                "type": "string",
                "nullable": true,
                "description": "Cursor pointing to the start of the desired set."
              }
            }
          }
        }
      },
      "mandate_single_resource_response": {
        "type": "object",
        "title": "MandateSingleResourceResponse",
        "description": "",
        "properties": {
          "mandates": {
            "type": "object",
            "description": "Mandates represent the Direct Debit mandate with a [customer](#core-endpoints-customers).\n\nGoCardless will notify you via a [webhook](#appendix-webhooks) whenever the status of a mandate changes.",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier, beginning with \"MD\". Note that this prefix may not apply to mandates created before 2016.",
                "example": "MD123"
              },
              "created_at": {
                "type": "string",
                "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                "example": "2014-01-01T12:00:00.000Z",
                "format": "date-time"
              },
              "reference": {
                "type": "string",
                "nullable": true,
                "description": "Unique reference. Different schemes have different length and [character set](#appendix-character-sets) requirements. GoCardless will generate a unique reference satisfying the different scheme requirements if this field is left blank.",
                "example": "REF-123"
              },
              "status": {
                "description": "One of:\n\n- `pending_customer_approval`: the mandate has not yet been signed by the second customer\n- `pending_submission`: the mandate has not yet been submitted to the customer's bank\n- `submitted`: the mandate has been submitted to the customer's bank but has not been processed yet\n- `active`: the mandate has been successfully set up by the customer's bank\n- `suspended_by_payer`: the mandate has been suspended by payer\n- `failed`: the mandate could not be created\n- `cancelled`: the mandate has been cancelled\n- `expired`: the mandate has expired due to dormancy\n- `consumed`: the mandate has been consumed and cannot be reused (note that this only applies to schemes that are per-payment authorised)\n- `blocked`: the mandate has been blocked and payments cannot be created",
                "example": "pending_submission",
                "enum": [
                  "pending_customer_approval",
                  "pending_submission",
                  "submitted",
                  "active",
                  "failed",
                  "cancelled",
                  "expired",
                  "consumed",
                  "blocked",
                  "suspended_by_payer"
                ],
                "type": "string"
              },
              "scheme": {
                "type": "string",
                "nullable": true,
                "description": "<a name=\"mandates_scheme\"></a>Bank payment scheme to which this mandate and associated payments are submitted. Can be supplied or automatically detected from the customer's bank account.",
                "example": "bacs"
              },
              "mandate_type": {
                "type": "string",
                "nullable": true,
                "description": "Mandate type",
                "example": "bank_debit",
                "enum": [
                  "bank_debit",
                  "instant",
                  "recurring",
                  "vrp_commercial",
                  "vrp_sweeping"
                ]
              },
              "next_possible_charge_date": {
                "type": "string",
                "nullable": true,
                "description": "The earliest date that can be used as a `charge_date` on any newly created payment for this mandate. This value will change over time.",
                "example": "2014-10-27",
                "format": "date"
              },
              "next_possible_standard_ach_charge_date": {
                "type": "string",
                "nullable": true,
                "description": "If this is an an ACH mandate, the earliest date that can be used as a\n`charge_date` on any newly created payment to be charged through standard\nACH, rather than Faster ACH. This value will change over time.\n\nIt is only present in the API response for ACH mandates.",
                "example": "2014-10-27",
                "format": "date"
              },
              "payments_require_approval": {
                "type": "boolean",
                "description": "Boolean value showing whether payments and subscriptions under this mandate require approval via an automated email before being processed."
              },
              "verified_at": {
                "type": "string",
                "nullable": true,
                "description": "[Timestamp](#api-usage-dates-and-times) recording when this mandate was verified.",
                "example": "2021-01-01T12:00:00.000Z",
                "format": "date-time"
              },
              "metadata": {
                "type": "object",
                "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
              },
              "links": {
                "type": "object",
                "description": "",
                "properties": {
                  "customer_bank_account": {
                    "type": "string",
                    "description": "ID of the associated [customer bank account](#core-endpoints-customer-bank-accounts) which the mandate is created and submits payments against.",
                    "example": "BA123"
                  },
                  "creditor": {
                    "type": "string",
                    "description": "ID of the associated [creditor](#core-endpoints-creditors).",
                    "example": "CR123"
                  },
                  "new_mandate": {
                    "type": "string",
                    "description": "ID of the new mandate if this mandate has been replaced.",
                    "example": "MD123"
                  },
                  "customer": {
                    "type": "string",
                    "description": "ID of the associated [customer](#core-endpoints-customers)",
                    "example": "CU123"
                  }
                }
              },
              "consent_parameters": {
                "type": "object",
                "nullable": true,
                "description": "(Optional) Payto and VRP Scheme specific information",
                "properties": {
                  "max_amount_per_payment": {
                    "type": "integer",
                    "description": "The maximum amount that can be charged for a single payment"
                  },
                  "period": {
                    "description": "The repeating period for this mandate",
                    "enum": [
                      "day",
                      "week",
                      "month",
                      "year",
                      "flexible"
                    ],
                    "type": "string"
                  },
                  "max_amount_per_period": {
                    "type": "integer",
                    "description": "The maximum total amount that can be charged for all payments in this period"
                  },
                  "max_payments_per_period": {
                    "type": "integer",
                    "description": "The maximum number of payments that can be collected in this period"
                  },
                  "start_date": {
                    "type": "string",
                    "description": "The date from which payments can be taken"
                  },
                  "end_date": {
                    "type": "string",
                    "description": "The latest date at which payments can be taken, must occur after start_date if present"
                  }
                }
              },
              "authorisation_source": {
                "description": "This field is ACH specific, sometimes referred to as [SEC code](https://www.moderntreasury.com/learn/sec-codes).\n\nThis is the way that the payer gives authorisation to the merchant.\n  web: Authorisation is Internet Initiated or via Mobile Entry (maps to SEC code: WEB)\n  telephone: Authorisation is provided orally over telephone (maps to SEC code: TEL)\n  paper: Authorisation is provided in writing and signed, or similarly authenticated (maps to SEC code: PPD)\n",
                "enum": [
                  "web",
                  "telephone",
                  "paper"
                ],
                "type": "string"
              },
              "funds_settlement": {
                "description": "This field will decide how GoCardless handles settlement of funds from the customer.\n\n- `managed` will be moved through GoCardless' account, batched, and payed out.\n- `direct` will be a direct transfer from the payer's account to the merchant where\n  invoicing will be handled separately.\n",
                "enum": [
                  "managed",
                  "direct"
                ],
                "type": "string"
              },
              "consent_type": {
                "type": "string",
                "nullable": true,
                "description": "(Optional) Specifies the type of authorisation agreed between the payer and merchant. It can be set to one-off, recurring or standing for ACH, or single, recurring and sporadic for PAD.",
                "enum": [
                  "one_off",
                  "single",
                  "recurring",
                  "standing",
                  "sporadic"
                ]
              }
            }
          }
        }
