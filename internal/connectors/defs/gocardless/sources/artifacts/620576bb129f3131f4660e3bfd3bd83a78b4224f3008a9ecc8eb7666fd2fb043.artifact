      "funds_availability": {
        "type": "object",
        "title": "Funds Availability",
        "description": "Checks if the payer's current balance is sufficient to cover the amount the merchant wants to charge within the consent parameters defined on the mandate.",
        "properties": {
          "available": {
            "type": "boolean",
            "description": "Indicates if the amount is available"
          }
        }
      },
      "funds_availability_available": {
        "type": "boolean",
        "title": "FundsAvailabilityAvailable",
        "description": "Indicates if the amount is available"
      },
      "funds_availability_amount": {
        "type": "string",
        "title": "FundsAvailabilityAmount",
        "description": "The amount of the payment",
        "example": "1000"
      },
      "instalment_schedule": {
        "type": "object",
        "title": "Instalment Schedule",
        "description": "Instalment schedules are objects which represent a collection of related payments, with the\nintention to collect the `total_amount` specified. The API supports both schedule-based\ncreation (similar to subscriptions) as well as explicit selection of differing payment\namounts and charge dates.\n\nUnlike subscriptions, the payments are created immediately, so the instalment schedule\ncannot be modified once submitted and instead can only be cancelled (which will cancel\nany of the payments which have not yet been submitted).\n\nCustomers will receive a single notification about the complete schedule of collection.\n",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier, beginning with \"IS\".",
            "example": "IS123"
          },
          "created_at": {
            "type": "string",
            "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
            "example": "2014-01-01T12:00:00.000Z",
            "format": "date-time"
          },
          "total_amount": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "description": "The total amount of the instalment schedule, defined as the sum of all individual\npayments, in the lowest denomination for the currency (e.g. pence in GBP, cents in\nEUR). If the requested payment amounts do not sum up correctly, a validation error\nwill be returned.",
            "example": 1000
          },
          "name": {
            "type": "string",
            "description": "Name of the instalment schedule, up to 100 chars. This name will also be\ncopied to the payments of the instalment schedule if you use schedule-based creation.",
            "example": "Invoice 4404"
          },
          "currency": {
            "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
            "example": "EUR",
            "enum": [
              "AUD",
              "CAD",
              "DKK",
              "EUR",
              "GBP",
              "NZD",
              "SEK",
              "USD"
            ],
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
          },
          "status": {
            "description": "One of:\n\n- `pending`: we're waiting for GC to create the payments\n- `active`: the payments have been created, and the schedule is active\n- `creation_failed`: payment creation failed\n- `completed`: we have passed the date of the final payment and all payments have been collected\n- `cancelled`: the schedule has been cancelled\n- `errored`: one or more payments have failed",
            "example": "active",
            "enum": [
              "pending",
              "active",
              "creation_failed",
              "completed",
              "cancelled",
              "errored"
            ],
            "type": "string"
          },
          "payment_errors": {
            "type": "object",
            "description": "If the status is `creation_failed`, this property will be populated with validation\nfailures from the individual payments, arranged by the index of the payment that\nfailed.\n",
            "example": {
              "0": [
                {
                  "field": "charge_date",
                  "message": "must be on or after mandate's next_possible_customer_charge_date"
                }
              ]
            }
          },
          "links": {
            "type": "object",
            "description": "Links to associated objects",
            "properties": {
              "mandate": {
                "type": "string",
                "description": "ID of the associated [mandate](#core-endpoints-mandates) which the instalment schedule will create payments against.",
                "example": "MD123"
              },
              "customer": {
                "type": "string",
                "description": "ID of the associated [customer](#core-endpoints-customers).",
                "example": "CU123"
              },
              "payments": {
                "type": "array",
                "description": "Array of IDs of the associated [payments](#core-endpoints-payments)",
                "example": [
                  "PM123",
                  "PM456"
                ],
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "instalment_schedule_id": {
        "type": "string",
        "title": "InstalmentScheduleId",
        "description": "Unique identifier, beginning with \"IS\".",
        "example": "IS123"
      },
      "instalment_schedule_identity": {
        "type": "string",
        "title": "InstalmentScheduleIdentity",
        "description": "Unique identifier, beginning with \"IS\".",
        "example": "IS123"
      },
      "instalment_schedule_name": {
        "type": "string",
        "title": "InstalmentScheduleName",
        "description": "Name of the instalment schedule, up to 100 chars. This name will also be\ncopied to the payments of the instalment schedule if you use schedule-based creation.",
        "example": "Invoice 4404"
      },
      "instalment_schedule_currency": {
        "title": "InstalmentScheduleCurrency",
        "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
        "example": "EUR",
        "enum": [
          "AUD",
          "CAD",
          "DKK",
          "EUR",
          "GBP",
          "NZD",
          "SEK",
          "USD"
        ],
        "type": "string"
      },
      "instalment_schedule_payment_reference": {
        "type": "string",
        "nullable": true,
        "title": "InstalmentSchedulePaymentReference",
        "description": "An optional reference that will appear on your customer's bank statement. The character limit for this reference is dependent on the scheme.<br /> <strong>ACH</strong> - 10 characters<br /> <strong>Autogiro</strong> - 11 characters<br /> <strong>Bacs</strong> - 10 characters<br /> <strong>BECS</strong> - 30 characters<br /> <strong>BECS NZ</strong> - 12 characters<br /> <strong>Betalingsservice</strong> - 30 characters<br /> <strong>Faster Payments</strong> - 18 characters<br /> <strong>PAD</strong> - scheme doesn't offer references<br /> <strong>PayTo</strong> - 18 characters<br /> <strong>SEPA</strong> - 140 characters<br /> Note that this reference must be unique (for each merchant) for the BECS scheme as it is a scheme requirement. <p class='restricted-notice'><strong>Restricted</strong>: You can only specify a payment reference for Bacs payments (that is, when collecting from the UK) if you're on the <a href='https://gocardless.com/pricing'>GoCardless Plus, Pro or Enterprise packages</a>.</p> <p class='restricted-notice'><strong>Restricted</strong>: You can not specify a payment reference for Faster Payments.</p>",
        "example": "WINEBOX001"
      },
      "instalment_schedule_retry_if_possible": {
        "type": "boolean",
        "title": "InstalmentScheduleRetryIfPossible",
        "description": "On failure, automatically retry payments using [intelligent retries](/success-plus/overview). Default is `false`. <p class=\"notice\"><strong>Important</strong>: To be able to use intelligent retries, Success+ needs to be enabled in [GoCardless dashboard](https://manage.gocardless.com/success-plus). </p>"
      },
      "instalment_schedule_total_amount": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          }
        ],
        "title": "InstalmentScheduleTotalAmount",
        "description": "The total amount of the instalment schedule, defined as the sum of all individual\npayments, in the lowest denomination for the currency (e.g. pence in GBP, cents in\nEUR). If the requested payment amounts do not sum up correctly, a validation error\nwill be returned.",
        "example": 1000
      },
      "instalment_schedule_status": {
        "title": "InstalmentScheduleStatus",
        "description": "One of:\n\n- `pending`: we're waiting for GC to create the payments\n- `active`: the payments have been created, and the schedule is active\n- `creation_failed`: payment creation failed\n- `completed`: we have passed the date of the final payment and all payments have been collected\n- `cancelled`: the schedule has been cancelled\n- `errored`: one or more payments have failed",
        "example": "active",
        "enum": [
          "pending",
          "active",
          "creation_failed",
          "completed",
          "cancelled",
          "errored"
        ],
        "type": "string"
      },
      "instalment_schedule_created_at": {
        "type": "string",
        "title": "InstalmentScheduleCreatedAt",
        "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
        "example": "2014-01-01T12:00:00.000Z",
        "format": "date-time"
      },
