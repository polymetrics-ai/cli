    "/scheme_identifiers": {
      "post": {
        "operationId": "create_scheme_identifier",
        "summary": "Create a scheme identifier",
        "description": "Creates a new scheme identifier. The scheme identifier status will be `pending` while GoCardless is\nprocessing the request. Once the scheme identifier is ready to be used the status will be updated to `active`.\nAt this point, GoCardless will emit a scheme identifier activated event via webhook to notify you of this change.\nIn Bacs, it will take up to five working days for a scheme identifier to become active. On other schemes, including SEPA,\nthis happens instantly.\n\n#### Scheme identifier name validations\n\nThe `name` field of a scheme identifier can contain alphanumeric characters, spaces and\nspecial characters.\n\nIts maximum length and the special characters it supports depend on the scheme:\n\n| __scheme__        | __maximum length__ | __special characters allowed__                      |\n| :---------------- | :----------------- | :-------------------------------------------------- |\n| `bacs`            | 18 characters      | `/` `.` `&` `-`                                     |\n| `sepa`            | 70 characters      | `/` `?` `:` `(` `)` `.` `,` `+` `&` `<` `>` `'` `\"` |\n| `ach`             | 16 characters      | `/` `?` `:` `(` `)` `.` `,` `'` `+` `-`             |\n| `faster_payments` | 18 characters      | `/` `?` `:` `(` `)` `.` `,` `'` `+` `-`             |\n\nThe validation error that gets returned for an invalid name will contain a suggested name\nin the metadata that is guaranteed to pass name validations.\n\nYou should ensure that the name you set matches the legal name or the trading name of\nthe creditor, otherwise, there is an increased risk of chargeback.\n\n\n<p class=\"restricted-notice\"><strong>Restricted</strong>: This endpoint is restricted to GoCardless Embed customers. Please [contact us](https://forms.gocardless.com/l/305971/2023-01-25/535t8n){:target=\"_blank\"} if you are interested in using this product.</p>",
        "tags": [
          "Scheme Identifier"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GoCardlessVersionHeader"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/scheme_identifier_single_resource_response"
                }
              }
            },
            "description": "Resource created successfully"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "scheme_identifiers": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "$ref": "#/components/schemas/scheme_identifier_name"
                      },
                      "scheme": {
                        "$ref": "#/components/schemas/scheme_identifier_scheme"
                      },
                      "links": {
                        "type": "object",
                        "description": "",
                        "properties": {
                          "creditor": {
                            "type": "string",
                            "description": "<em>required</em> ID of the associated [creditor](#core-endpoints-creditors).\n",
                            "example": "CR123"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "Ruby",
            "label": "Ruby",
            "source": "@client.scheme_identifiers.create(\n  params: {\n    scheme: \"bacs\",\n    name: \"Example Ltd\",\n    links: {\n      creditor: \"CR123\"\n    }\n  }\n)"
          },
          {
            "lang": "Python",
            "label": "Python",
            "source": "client.scheme_identifiers.create(params={\n    \"scheme\": \"bacs\",\n    \"name\": \"Example Ltd\",\n    \"links\": {\n        \"creditor\": \"CR123\"\n    }\n})"
          },
          {
            "lang": "JavaScript",
            "label": "JavaScript",
            "source": "const schemeIdentifier = await client.schemeIdentifiers.create({\n  scheme: \"bacs\",\n  name: \"The Wine Club\",\n  links: {\n    creditor: \"CR123\"\n  }\n});"
          },
          {
            "lang": "PHP",
            "label": "PHP",
            "source": "$client->schemeIdentifiers()->create([\n  'params' => ['scheme' => 'bacs',\n              'name' => 'Example Ltd',\n              'links' => ['creditor' => 'CR123']\n  ]\n]);"
          },
          {
            "lang": "Java",
            "label": "Java",
            "source": "import com.gocardless.services.SchemeIdentifierService.SchemeIdentifierCreateRequest.Scheme;\n\nSchemeIdentifier schemeIdentifier = client.schemeIdentifiers().create()\n  .withScheme(Scheme.BACS)\n  .withName(\"The Wine Club\")\n  .withLinksCreditor(\"CR123\")\n  .execute();"
          },
          {
            "lang": "Go",
            "label": "Go",
            "source": "schemeIdentifierCreateParams := gocardless.SchemeIdentifierCreateParams{\n  Name:   \"Durian Co\",\n  Scheme: \"bacs\",\n  Links: &gocardless.SchemeIdentifierCreateParamsLinks{\n    Creditor: \"CR123\",\n  },\n}\nschemeIdentifier, err := client.SchemeIdentifiers.Create(ctx, schemeIdentifierCreateParams)\nif err != nil {\n  fmt.Printf(\"error creating scheme identifier: %s\", err.Error())\n  return\n}"
          },
          {
            "lang": "C#",
            "label": ".NET",
            "source": "var schemeIdentifierRequest = new GoCardless.Services.SchemeIdentifierCreateRequest\n{\n    Name = \"The Wine Club\",\n    Scheme = GoCardless.Services.SchemeIdentifierCreateRequest.SchemeIdentifierScheme.Bacs,\n    Links = new GoCardless.Services.SchemeIdentifierCreateRequest.SchemeIdentifierLinks()\n    {\n        Creditor = \"CR123\"\n    }\n};\n\nvar schemeIdentifierResponse = await client.SchemeIdentifiers.CreateAsync(schemeIdentifierRequest);\n\nGoCardless.Resources.SchemeIdentifier schemeIdentifier = schemeIdentifierResponse.SchemeIdentifier;"
          },
          {
            "lang": "HTTP",
            "label": "HTTP",
            "source": "POST https://api.gocardless.com/scheme_identifiers HTTP/1.1\nContent-Type: application/json\n{\n  \"scheme_identifiers\": {\n    \"name\": \"The Wine Club\",\n    \"scheme\": \"bacs\",\n    \"links\": {\n      \"creditor\": \"CR123\"\n    }\n  }\n}\nHTTP/1.1 201 Created\nLocation: /scheme_identifiers/SU123\nContent-Type: application/json\n{\n  \"scheme_identifiers\": {\n      \"id\": \"SU123\",\n      \"created_at\": \"2021-01-23T13:44:19.006Z\",\n      \"name\": \"The Wine Club\",\n      \"scheme\": \"bacs\",\n      \"reference\": \"REF123\",\n      \"status\": \"pending\",\n      \"minimum_advance_notice\": 3,\n      \"can_specify_mandate_reference\": false,\n      \"currency\": \"GBP\",\n      \"address_line1\": \"65 Goswell Road\",\n      \"address_line2\": null,\n      \"address_line3\": null,\n      \"city\": \"London\",\n      \"region\": null,\n      \"postal_code\": \"EC1V 7EN\",\n      \"country_code\": \"GB\",\n      \"email\": \"name@example.com\",\n      \"phone_number\": \"+44 20 8338 9540\"\n  }\n}"
          }
        ]
      },
