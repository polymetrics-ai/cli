tion\": \"The mandate for this payment was cancelled at a bank branch.\",\n        \"scheme\": \"bacs\",\n        \"reason_code\": \"ADDACS-B\"\n      },\n      \"metadata\": {},\n      \"resource_metadata\": { \"order_dispatch_date\": \"2014-05-22\" },\n      \"links\": {\n        \"payment\": \"PM123\",\n        \"parent_event\": \"EV123\"\n      }\n    }\n  ],\n  \"linked\": {\n    \"payments\": [\n      {\n        \"id\": \"PM123\",\n        \"created_at\": \"2014-05-08T17:01:06.000Z\",\n        \"charge_date\": \"2014-05-15\",\n        \"amount\": 100,\n        \"description\": null,\n        \"currency\": \"GBP\",\n        \"status\": \"paid_out\",\n        \"reference\": \"WINEBOX001\",\n        \"metadata\": {\n          \"order_dispatch_date\": \"2014-05-22\"\n        },\n        \"amount_refunded\": 0,\n        \"links\": {\n          \"mandate\": \"MD123\",\n          \"creditor\": \"CR123\"\n        }\n      }\n    ]\n  }\n}"
          }
        ]
