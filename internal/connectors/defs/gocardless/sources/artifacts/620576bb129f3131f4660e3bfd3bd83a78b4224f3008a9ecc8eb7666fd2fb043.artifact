      "payout_item_multi_resource_response": {
        "type": "object",
        "title": "PayoutItemMultiResourceResponse",
        "description": "A list of payout items",
        "properties": {
          "payout_items": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "When we collect a payment on your behalf, we add the money you've collected to your\nGoCardless balance, minus any fees paid. Periodically (usually every working day),\nwe take any positive balance in your GoCardless account, and pay it out to your\nnominated bank account.\n\nOther actions in your GoCardless account can also affect your balance. For example,\nif a customer charges back a payment, we'll deduct the payment's amount from your\nbalance, but add any fees you paid for that payment back to your balance.\n\nThe Payout Items API allows you to view, on a per-payout basis, the credit and debit\nitems that make up that payout's amount.  Payout items can only be retrieved for payouts\ncreated in the last 6 months. Requests for older payouts will return an HTTP status\n<code>410 Gone</code>.\n",
              "properties": {
                "amount": {
                  "type": "string",
                  "description": "The positive (credit) or negative (debit) value of the item, in fractional currency;\nthe lowest denomination for the currency (e.g. pence in GBP, cents in EUR), to one decimal place.\n<p class=\"notice\">For accuracy, we store some of our fees to greater precision than we can actually pay out (for example, a GoCardless fee we record might come to 0.5 pence, but it is not possible to send a payout via bank transfer including a half penny).<br><br>To calculate the final amount of the payout, we sum all of the items and then round to the nearest currency unit.</p>",
                  "example": "45.0"
                },
                "type": {
                  "description": "The type of the credit (positive) or debit (negative) item in the payout (inclusive of VAT if applicable). One of:\n\n- `payment_paid_out` (credit)\n- `payment_failed` (debit): The payment failed to be processed.\n- `payment_charged_back` (debit): The payment has been charged back.\n- `payment_refunded` (debit): The payment has been refunded to the customer.\n- `refund` (debit): A refund sent to a customer, not linked to a payment.\n- `refund_funds_returned` (credit): The refund could not be sent to the customer, and the funds have been returned to you.\n- `gocardless_fee` (credit/debit): The fees that GoCardless charged for a payment. In the case of a payment failure or chargeback, these will appear as credits. Will include taxes if applicable for merchants.\n- `app_fee` (credit/debit): The optional fees that a partner may have taken for a payment. In the case of a payment failure or chargeback, these will appear as credits.\n- `revenue_share` (credit/debit): A share of the fees that GoCardless collected which some partner integrations receive when their users take payments. Only shown in partner payouts. In the case of a payment failure or chargeback, these will appear as credits.\n- `surcharge_fee` (credit/debit): GoCardless deducted a surcharge fee as the payment failed or was charged back, or refunded a surcharge fee as the bank or customer cancelled the chargeback. Will include taxes if applicable for merchants.\n",
                  "example": "payment_paid_out",
                  "enum": [
                    "payment_paid_out",
                    "payment_failed",
                    "payment_charged_back",
                    "payment_refunded",
                    "refund",
                    "gocardless_fee",
                    "app_fee",
                    "revenue_share",
                    "surcharge_fee",
                    "refund_funds_returned"
                  ],
                  "type": "string"
                },
                "taxes": {
                  "type": "array",
                  "description": "An array of tax items <em>beta</em>\n\n_Note_: VAT applies to transaction and surcharge fees for merchants operating in the UK and France.",
                  "items": {
                    "type": "object",
                    "description": "",
                    "properties": {
                      "amount": {
                        "type": "string",
                        "description": "The amount of tax applied to a fee in fractional currency; the lowest denomination for the currency (e.g. pence in GBP, cents in EUR), to one decimal place.",
                        "example": "1.1"
                      },
                      "currency": {
                        "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                        "example": "EUR",
                        "enum": [
                          "AUD",
                          "CAD",
                          "DKK",
                          "EUR",
                          "GBP",
                          "NZD",
                          "SEK",
                          "USD"
                        ],
                        "type": "string"
                      },
                      "destination_amount": {
                        "type": "string",
                        "nullable": true,
                        "description": "The amount of tax to be paid out to the tax authorities in fractional currency; the lowest denomination for the currency (e.g. pence in GBP, cents in EUR), to one decimal place.\n\nWhen `currency` and `destination_currency` don't match this will be `null` until the `exchange_rate` has been finalised.",
                        "example": "1.1"
                      },
                      "destination_currency": {
                        "type": "string",
                        "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) code for the currency in which tax is paid out to the tax authorities of your tax jurisdiction. Currently “EUR” for French merchants and “GBP” for British merchants.",
                        "example": "EUR"
                      },
                      "exchange_rate": {
                        "type": "string",
                        "nullable": true,
                        "description": "The exchange rate for the tax from the currency into the destination currency.\n\nPresent only if the currency and the destination currency don't match and the exchange rate has been finalised.\n\nYou can listen for the payout's [`tax_exchange_rates_confirmed` webhook](https://developer.gocardless.com/api-reference/#event-types-payout) to know when the exchange rate has been finalised for all fees in the payout.",
                        "example": "1.11205"
                      },
                      "tax_rate_id": {
                        "type": "string",
                        "description": "The unique identifier created by the jurisdiction, tax type and version",
                        "example": "GB_VAT_1"
                      }
                    }
                  }
                },
                "links": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "payment": {
                      "type": "string",
                      "description": "Unique identifier, beginning with \"PM\".",
                      "example": "PM123"
                    },
                    "mandate": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/mandate"
                        },
                        {
                          "description": "Unique identifier, beginning with \"MD\". Note that this prefix may not apply to mandates created before 2016. Present only for the items of type `payment_refunded`, `refund` and `refund_funds_returned`."
                        }
                      ]
                    },
                    "refund": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/refund"
                        },
                        {
                          "description": "Unique identifier, beginning with \"RF\". Present only for the items of type `payment_refunded`, `refund` and `refund_funds_returned`."
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "meta": {
            "type": "object",
            "description": "Cursor pagination information",
            "properties": {
              "limit": {
                "type": "integer",
                "example": 50
              },
              "cursors": {
                "type": "object",
                "properties": {
                  "before": {
                    "type": "string",
                    "nullable": true,
                    "description": "Cursor pointing to the end of the desired set."
                  },
                  "after": {
                    "type": "string",
                    "nullable": true,
                    "description": "Cursor pointing to the start of the desired set."
                  }
                }
              }
            }
          }
        }
      },
      "redirect_flow": {
        "type": "object",
        "title": "Redirect Flows",
        "description": "<p class=\"deprecated-notice\"><strong>Deprecated</strong>: Redirect Flows are legacy APIs and cannot be used by new integrators.\n    The <a href=\"https://developer.gocardless.com/api-reference/#billing-requests-billing-requests\">Billing Request flow</a> API should be used for your payment flows.</p>\n\nRedirect flows enable you to use GoCardless' [hosted payment pages](https://pay-sandbox.gocardless.com/AL000000AKFPFF) to set up mandates with your customers. These pages are fully compliant and have been translated into Danish, Dutch, French, German, Italian, Norwegian, Portuguese, Slovak, Spanish and Swedish.\n\nThe overall flow is:\n\n1. You [create](#redirect-flows-create-a-redirect-flow) a redirect flow for your customer, and redirect them to the returned redirect url, e.g. `https://pay.gocardless.com/flow/RE123`.\n\n2. Your customer supplies their name, email, address, and bank account details, and submits the form. This securely stores their details, and redirects them back to your `success_redirect_url` with `redirect_flow_id=RE123` in the querystring.\n\n3. You [complete](#redirect-flows-complete-a-redirect-flow) the redirect flow, which creates a [customer](#core-endpoints-customers), [customer bank account](#core-endpoints-customer-bank-accounts), and [mandate](#core-endpoints-mandates), and returns the ID of the mandate. You may wish to create a [subscription](#core-endpoints-subscriptions) or [payment](#core-endpoints-payments) at this point.\n\nOnce you have [completed](#redirect-flows-complete-a-redirect-flow) the redirect flow via the API, you should display a confirmation page to your customer, confirming that their Direct Debit has been set up. You can build your own page, or redirect to the one we provide in the `confirmation_url` attribute of the redirect flow.\n\nRedirect flows expire 30 minutes after they are first created. You cannot complete an expired redirect flow. For an integrator this is shorter and they will expire after 10 minutes.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier, beginning with \"RE\".",
            "example": "RE123456"
          },
          "description": {
            "type": "string",
            "description": "A description of the item the customer is paying for. This will be shown on the hosted payment pages.",
            "example": "Standard subscription"
          },
          "session_token": {
            "type": "string",
            "description": "The customer's session ID must be provided when the redirect flow is set up and again when it is completed. This allows integrators to ensure that the user who was originally sent to the GoCardless payment pages is the one who has completed them.",
            "example": "SESS_wSs0uGYMISxzqOBq"
          },
          "scheme": {
            "description": "The Direct Debit scheme of the mandate. If specified, the payment pages will only allow the set-up of a mandate for the specified scheme. It is recommended that you leave this blank so the most appropriate scheme is picked based on the customer's bank account.",
            "example": "bacs",
            "enum": [
              "ach",
              "autogiro",
              "bacs",
              "becs",
              "becs_nz",
              "betalingsservice",
              "pad",
              "sepa_core"
            ],
            "nullable": true,
            "type": "string"
          },
          "success_redirect_url": {
            "type": "string",
            "description": "The URL to redirect to upon successful mandate setup. You must use a URL beginning `https` in the live environment.",
            "example": "https://example.com/pay/confirm"
          },
          "confirmation_url": {
            "type": "string",
            "description": "The URL of a confirmation page, which you may optionally redirect the customer to rather than use your own page, that confirms in their chosen language that their Direct Debit has been set up successfully. Only returned once the customer has set up their mandate via the payment pages and the redirect flow has been [completed](#redirect-flows-complete-a-redirect-flow), and only available for 15 minutes from when you complete the redirect flow. The structure of this URL may change at any time, so you should read it directly from the API response.",
            "example": "https://pay.gocardless.com/flow/RE123/success"
          },
          "redirect_url": {
            "type": "string",
            "description": "The URL of the hosted payment pages for this redirect flow. This is the URL you should redirect your customer to.",
            "example": "http://pay.gocardless.com/flow/RE123"
          },
          "created_at": {
            "type": "string",
            "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
            "example": "2014-01-01T12:00:00.000Z",
            "format": "date-time"
          },
          "links": {
            "type": "object",
            "description": "",
            "properties": {
              "creditor": {
                "type": "string",
                "description": "The [creditor](#core-endpoints-creditors) for whom the mandate will be created. The `name` of the creditor will be displayed on the payment page.",
                "example": "CR123"
              },
              "mandate": {
                "type": "string",
                "description": "ID of [mandate](#core-endpoints-mandates) created by this redirect flow.<br/>**Note**: this property will not be present until the redirect flow has been successfully completed.",
                "example": "MD123"
              },
              "customer": {
                "type": "string",
                "description": "ID of [customer](#core-endpoints-customers) created by this redirect flow.<br/>**Note**: this property will not be present until the redirect flow has been successfully completed.",
                "example": "CU123"
              },
              "customer_bank_account": {
                "type": "string",
                "description": "ID of [customer bank account](#core-endpoints-customer-bank-accounts) created by this redirect flow.<br/>**Note**: this property will not be present until the redirect flow has been successfully completed.",
                "example": "BA123"
              },
              "billing_request": {
                "type": "string",
                "description": "ID of [billing request](#billing-requests-billing-requests) that a redirect flow can create.<br />**Note**: The redirect flow will only create a billing request in the event the redirect flow is eligible to send the payer down this new and improved flow",
                "example": "BR123"
              }
            }
          },
          "metadata": {
            "type": "object",
            "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters. _Note:_ This should not be used for storing PII data.",
            "example": {
              "salesforce_id": "ABCD1234"
            }
          },
          "mandate_reference": {
            "type": "string",
            "description": "Mandate reference generated by GoCardless or submitted by an integrator."
          }
        }
      },
      "redirect_flow_id": {
        "type": "string",
        "title": "RedirectFlowId",
        "description": "Unique identifier, beginning with \"RE\".",
        "example": "RE123456"
      },
      "redirect_flow_identity": {
        "type": "string",
        "title": "RedirectFlowIdentity",
        "description": "Unique identifier, beginning with \"RE\".",
