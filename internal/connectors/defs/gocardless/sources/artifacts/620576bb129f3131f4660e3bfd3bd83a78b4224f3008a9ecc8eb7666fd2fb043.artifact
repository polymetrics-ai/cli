        ],
        "nullable": true,
        "type": "string"
      },
      "bank_details_lookup_single_resource_response": {
        "type": "object",
        "title": "BankDetailsLookupSingleResourceResponse",
        "description": "",
        "properties": {
          "bank_details_lookups": {
            "type": "object",
            "description": "Look up the name and reachability of a bank account.",
            "properties": {
              "bank_name": {
                "type": "string",
                "nullable": true,
                "description": "The name of the bank with which the account is held (if available).",
                "example": "NATWEST BANK PLC"
              },
              "bic": {
                "type": "string",
                "nullable": true,
                "description": "ISO 9362 SWIFT BIC of the bank with which the account is held.\n\n<p class=\"notice\">Even if no BIC is returned for an account, GoCardless may still be able to collect payments from it - you should refer to the <code>available_debit_schemes</code> attribute to determine reachability.</p>",
                "example": "BARCGB22XXX"
              },
              "available_debit_schemes": {
                "type": "array",
                "description": "Array of [schemes](#mandates_scheme) supported for this bank account. This will be an empty array if the bank account is not reachable by any schemes.",
                "items": {
                  "description": "A bank payment scheme for this bank account.",
                  "example": "bacs",
                  "enum": [
                    "ach",
                    "autogiro",
                    "bacs",
                    "becs",
                    "becs_nz",
                    "betalingsservice",
                    "faster_payments",
