      "customer_notification_multi_resource_response": {
        "type": "object",
        "title": "CustomerNotificationMultiResourceResponse",
        "description": "",
        "properties": {
          "payments": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Customer Notifications represent the notification which is due to be sent to a customer\nafter an event has happened. The event, the resource and the customer to be notified\nare all identified in the `links` property.\n\nNote that these are ephemeral records - once the notification has been actioned in some\nway, it is no longer visible using this API.\n\n<p class=\"restricted-notice\"><strong>Restricted</strong>: This API is currently only available for approved integrators - please <a href=\"mailto:help@gocardless.com\">get in touch</a> if you would like to use this API.</p>",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The id of the notification.",
                  "example": "EV1D18JEXAMPLE"
                },
                "type": {
                  "type": "string",
                  "description": "The type of notification the customer shall receive.\nOne of:\n\n- `payment_created`\n- `payment_cancelled`\n- `mandate_created`\n- `mandate_blocked`\n- `subscription_created`\n- `subscription_cancelled`\n- `instalment_schedule_created`\n- `instalment_schedule_cancelled`",
                  "example": "payment_created",
                  "enum": [
                    "payment_created",
                    "payment_cancelled",
                    "mandate_created",
                    "mandate_blocked",
                    "subscription_created",
                    "subscription_cancelled",
                    "instalment_schedule_created",
                    "instalment_schedule_cancelled"
                  ]
                },
                "action_taken": {
                  "type": "string",
                  "description": "The action that was taken on the notification. Currently this can only be `handled`,\nwhich means the integrator sent the notification themselves.\n",
                  "enum": [
                    "handled"
                  ]
                },
                "action_taken_at": {
                  "type": "string",
                  "nullable": true,
                  "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this\naction was taken.",
                  "format": "date-time"
                },
                "action_taken_by": {
                  "type": "string",
                  "nullable": true,
                  "description": "A string identifying the integrator who was able to handle this notification."
                },
                "links": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "payment": {
                      "type": "string",
                      "description": "The identifier of the related payment.",
                      "example": "PM123"
                    },
                    "mandate": {
                      "type": "string",
                      "description": "The identifier of the related mandate.",
                      "example": "MD123"
                    },
                    "refund": {
                      "type": "string",
                      "description": "The identifier of the related refund.",
                      "example": "RF123"
                    },
                    "subscription": {
                      "type": "string",
                      "description": "The identifier of the related subscription.",
                      "example": "SB123"
                    },
                    "customer": {
                      "type": "string",
                      "description": "The customer who should be contacted with this notification.",
                      "example": "CU123"
                    },
                    "event": {
                      "type": "string",
                      "description": "The event that triggered the notification to be scheduled.",
                      "example": "EV123"
                    }
                  }
                }
              }
            }
          },
          "meta": {
            "type": "object",
            "description": "Cursor pagination information",
            "properties": {
              "limit": {
                "type": "integer",
                "example": 50
              },
              "cursors": {
                "type": "object",
                "properties": {
                  "before": {
                    "type": "string",
                    "nullable": true,
                    "description": "Cursor pointing to the end of the desired set."
                  },
                  "after": {
                    "type": "string",
                    "nullable": true,
                    "description": "Cursor pointing to the start of the desired set."
                  }
                }
              }
            }
          }
        }
      },
      "event": {
        "type": "object",
        "title": "Events",
        "description": "Events are stored for all webhooks. An event refers to a resource which has been updated, for example a payment which has been collected, or a mandate which has been transferred. Event creation is an asynchronous process, so it can take some time between an action occurring and its corresponding event getting included in API responses. See [here](#event-types) for a complete list of event types.\n<p class=\"notice\"><strong>Important</strong>: Events older than 18 months will be archived and no longer accessible via the API or exports. Archival will begin no sooner than 1 August 2026 in sandbox environments, and no sooner than 1 October 2026 in live environments. Events within the 18-month window are unaffected. If you need archived data, contact GoCardless support.</p>",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier, beginning with \"EV\".",
            "example": "EV123"
          },
          "created_at": {
            "type": "string",
            "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
            "example": "2014-01-01T12:00:00.000Z",
            "format": "date-time"
          },
          "resource_type": {
            "description": "The resource type for this event. One of:\n\n- `billing_requests`\n- `creditors`\n- `exports`\n- `instalment_schedules`\n- `mandates`\n- `payer_authorisations`\n- `payments`\n- `payouts`\n- `refunds`\n- `scheme_identifiers`\n- `subscriptions`\n- `outbound_payments`\n- `payment_account_transactions`",
            "example": "mandates",
            "enum": [
              "billing_requests",
              "creditors",
              "customers",
              "exports",
              "instalment_schedules",
              "mandates",
              "organisations",
              "outbound_payments",
              "payer_authorisations",
              "payments",
              "payment_account_transactions",
              "payouts",
              "refunds",
              "scheme_identifiers",
              "subscriptions"
            ],
            "type": "string"
          },
          "action": {
            "type": "string",
            "description": "What has happened to the resource. See [Event Types](#event-types) for the possible actions.",
            "example": "cancelled"
          },
          "customer_notifications": {
            "type": "array",
            "nullable": true,
            "description": "Present only in webhooks when an integrator is authorised to send their own\nnotifications. See [here](/getting-started/api/handling-customer-notifications/)\nfor further information.\n",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The id of the notification.",
                  "example": "EV1D18JEXAMPLE"
                },
                "type": {
                  "type": "string",
                  "description": "See [here](#core-endpoints-customer-notifications) for a complete list of customer notification types."
                },
                "mandatory": {
                  "type": "boolean",
                  "description": "Whether or not the notification must be sent."
                },
                "deadline": {
                  "type": "string",
                  "description": "Time after which GoCardless will send the notification by email.",
                  "format": "date-time"
                }
              }
            }
          },
          "details": {
            "type": "object",
            "description": "",
            "properties": {
              "origin": {
                "description": "Who initiated the event. One of:\n\n- `bank`: this event was triggered by a report from the banks\n- `gocardless`: this event was performed by GoCardless automatically\n- `api`: this event was triggered by an API endpoint\n- `customer`: this event was triggered by a Customer\n- `payer`: this event was triggered by a Payer",
                "example": "bank",
                "enum": [
                  "bank",
                  "api",
                  "gocardless",
                  "customer",
                  "payer"
                ],
                "type": "string"
              },
              "cause": {
                "type": "string",
                "description": "What triggered the event. _Note:_ `cause` is our simplified and predictable key indicating what triggered the event.",
                "example": "bank_account_disabled"
              },
              "description": {
                "type": "string",
                "description": "Human readable description of the cause. _Note:_ Changes to event descriptions are not considered breaking.",
                "example": "Customer's bank account closed"
              },
              "scheme": {
                "description": "A bank payment scheme. Set when a bank is the origin of the event.",
                "example": "bacs",
                "enum": [
                  "ach",
                  "autogiro",
                  "bacs",
                  "becs",
                  "becs_nz",
                  "betalingsservice",
                  "faster_payments",
                  "pad",
                  "pay_to",
                  "sepa_core",
                  "sepa_cor1"
                ],
                "nullable": true,
                "type": "string"
              },
              "reason_code": {
                "type": "string",
                "description": "Set when a `bank` is the origin of the event. This is the reason code received in the report from the customer's bank. See the [GoCardless Direct Debit guide](https://gocardless.com/direct-debit/receiving-messages) for information on the meanings of different reason codes. _Note:_ `reason_code` is payment scheme-specific and can be inconsistent between banks.",
                "example": "ADDACS-B"
              },
              "will_attempt_retry": {
                "type": "boolean",
                "description": "Whether the payment will be retried automatically. Set on a payment failed event.",
                "example": true
              },
              "not_retried_reason": {
                "type": "string",
                "description": "When will_attempt_retry is set to false, this field will contain\nthe reason the payment was not retried. This can be one of:\n\n- `failure_filter_applied`: The payment won't be intelligently retried as there is a high likelihood of failure on retry.\n- `other`: The payment won't be intelligently retried due to any other reason.",
                "example": "failure_filter_applied"
              },
              "bank_account_id": {
                "type": "string",
                "description": "When we send a creditor `new_payout_currency_added` webhook, we also send the bank account id of the new account",
                "example": "BA123"
              },
              "currency": {
                "type": "string",
                "description": "When we send a creditor `new_payout_currency_added` webhook, we also send the currency of the new account",
                "example": "GBP"
              },
              "property": {
                "type": "string",
                "description": "When we send a creditor `creditor_updated` webhook, this tells you which property on the creditor has been updated",
                "example": "fx_payout_currency"
              },
              "item_count": {
                "type": "integer",
                "description": "Count of rows in the csv. This is sent for export events",
                "example": 10
              }
            }
          },
          "metadata": {
            "type": "object",
            "description": "The metadata that was passed when making the API request that triggered the event\n(for instance, cancelling a mandate).\n\nThis field will only be populated if the `details[origin]` field is `api` otherwise it will be an empty object.\n"
          },
          "resource_metadata": {
            "type": "object",
            "description": "The metadata of the resource that the event is for. For example, this field will have the same\nvalue of the `mandate[metadata]` field on the response you would receive from performing a GET request on a mandate.\n"
          },
          "source": {
            "type": "object",
            "description": "Audit information about the source of the event.",
            "properties": {
              "type": {
                "description": "The type of the event's source.",
                "enum": [
                  "app",
                  "user",
                  "gc_team",
                  "access_token"
                ],
                "type": "string"
              },
              "name": {
                "type": "string",
                "description": "The name of the event's source.",
                "example": "Joe Bloggs"
              }
            }
          },
          "links": {
            "type": "object",
            "description": "",
            "properties": {
              "billing_request": {
                "type": "string",
                "description": "ID of a [billing request](#billing-requests-billing-requests).",
                "example": "BRQ123"
              },
              "billing_request_flow": {
                "type": "string",
                "description": "ID of a [billing request flow](#billing-requests-billing-request-flows).",
                "example": "BRF123"
              },
              "bank_authorisation": {
                "type": "string",
                "description": "ID of a [bank authorisation](#billing-requests-bank-authorisations).",
                "example": "BAU123"
              },
              "payment_request_payment": {
                "type": "string",
                "description": "If `resource_type` is `billing_requests`, this is the ID of the [payment](#core-endpoints-payments) which has been created for Pay by Bank.",
                "example": "PM123"
              },
              "mandate_request": {
                "type": "string",
                "description": "This is the id of the mandate request associated to this event",
                "example": "MRQ123"
              },
              "mandate_request_mandate": {
                "type": "string",
                "description": "If `resource_type` is `billing_requests`, this is the ID of the [mandate](#core-endpoints-mandates) which has been created.",
                "example": "MD123"
              },
              "customer": {
                "type": "string",
                "description": "ID of a [customer](#core-endpoints-customers).",
                "example": "CU123"
              },
              "customer_bank_account": {
                "type": "string",
                "description": "ID of a [customer bank account](#core-endpoints-customer-bank-accounts).",
                "example": "BA123"
              },
              "payment": {
                "type": "string",
                "description": "If `resource_type` is `payments`, this is the ID of the [payment](#core-endpoints-payments) which has been updated.",
                "example": "PM123"
              },
              "mandate": {
                "type": "string",
                "description": "If `resource_type` is `mandates`, this is the ID of the [mandate](#core-endpoints-mandates) which has been updated.",
                "example": "MD123"
              },
              "payer_authorisation": {
                "type": "string",
                "description": "ID of a [payer authorisation](#core-endpoints-payer-authorisations).",
                "example": "PAU123"
              },
              "payout": {
                "type": "string",
                "description": "If `resource_type` is `payouts`, this is the ID of the [payout](#core-endpoints-payouts) which has been updated.",
                "example": "PO123"
              },
              "refund": {
                "type": "string",
                "description": "If `resource_type` is `refunds`, this is the ID of the [refund](#core-endpoints-refunds) which has been updated.",
                "example": "RF123"
              },
              "subscription": {
                "type": "string",
                "description": "If `resource_type` is `subscription`, this is the ID of the [subscription](#core-endpoints-subscriptions) which has been updated.",
                "example": "SB123"
              },
              "instalment_schedule": {
                "type": "string",
                "description": "If `resource_type` is `instalment_schedule`, this is the ID of the [instalment schedule](#core-endpoints-instalment-schedules) which has been updated.",
                "example": "IS123"
              },
              "creditor": {
                "type": "string",
                "description": "If `resource_type` is `creditor`, this is the ID of the [creditor](#core-endpoints-creditors) which has been updated.",
                "example": "CR123"
              },
              "parent_event": {
                "type": "string",
                "description": "If this event was caused by another, this is the ID of the cause. For example, if a mandate is cancelled it automatically cancels all pending payments associated with it; in this case, the payment cancellation events would have the ID of the mandate cancellation event in this field.",
                "example": "EV123"
              },
              "previous_customer_bank_account": {
                "type": "string",
                "description": "This is only included for mandate transfer events, when it is the ID of the [customer bank account](#core-endpoints-customer-bank-accounts) which the mandate is being transferred from.",
                "example": "BA123"
              },
              "new_customer_bank_account": {
                "type": "string",
                "description": "This is only included for mandate transfer events, when it is the ID of the [customer bank account](#core-endpoints-customer-bank-accounts) which the mandate is being transferred to.",
                "example": "BA123"
              },
              "new_mandate": {
                "type": "string",
                "description": "This is only included for mandate replaced events, when it is the ID of the new [mandate](#core-endpoints-mandates) that replaces the existing mandate.",
                "example": "MD123"
              },
              "organisation": {
                "type": "string",
                "description": "If the event is included in a [webhook](#webhooks-overview) to an [OAuth app](#appendix-oauth), this is the ID of the account to which it belongs.",
                "example": "OR123"
              },
              "outbound_payment": {
                "type": "string",
                "description": "If `resource_type` is `outbound_payments`, this is the ID of the outbound_payment which has been updated.",
                "example": "OUT123"
              },
              "payment_account_transaction": {
                "type": "string",
                "description": "If `resource_type` is `payment_account_transaction`, this is the ID of a transaction which has been recorded on the payment account.",
                "example": "PATR123"
              },
              "scheme_identifier": {
                "type": "string",
                "description": "If `resource_type` is `scheme_identifiers`, this is the ID of the [scheme_identifier](#core-endpoints-scheme-identifiers) which has been updated.",
                "example": "SU123"
              }
            }
          }
        }
      },
      "event_id": {
        "type": "string",
        "title": "EventId",
        "description": "Unique identifier, beginning with \"EV\".",
        "example": "EV123"
      },
      "event_identity": {
        "type": "string",
        "title": "EventIdentity",
        "description": "Unique identifier, beginning with \"EV\".",
        "example": "EV123"
