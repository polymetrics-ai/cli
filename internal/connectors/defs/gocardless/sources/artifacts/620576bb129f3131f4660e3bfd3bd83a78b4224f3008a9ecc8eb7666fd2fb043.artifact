                    "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in SEK.",
                    "example": "BA789"
                  },
                  "default_dkk_payout_account": {
                    "type": "string",
                    "nullable": true,
                    "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in DKK.",
                    "example": "BA790"
                  },
                  "default_nzd_payout_account": {
                    "type": "string",
                    "nullable": true,
                    "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in NZD.",
                    "example": "BA791"
                  },
                  "default_cad_payout_account": {
                    "type": "string",
                    "nullable": true,
                    "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in CAD.",
                    "example": "BA792"
                  },
                  "default_usd_payout_account": {
                    "type": "string",
                    "nullable": true,
                    "description": "ID of the [bank account](#core-endpoints-creditor-bank-accounts) which is set up to receive payouts in USD.",
                    "example": "BA792"
                  }
                }
              },
              "scheme_identifiers": {
                "type": "array",
                "description": "An array of the scheme identifiers this creditor can create mandates against.\n\nThe support address, `phone_number` and `email` fields are for customers to contact the merchant for support purposes. They must be displayed on the payment page, please see our [compliance requirements](#appendix-compliance-requirements) for more details.",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier, usually beginning with \"SU\".",
                      "example": "SU123"
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                      "example": "2014-01-01T12:00:00.000Z",
                      "format": "date-time"
                    },
                    "name": {
                      "type": "string",
                      "description": "The name which appears on customers' bank statements. This should usually be the merchant's trading name."
                    },
                    "scheme": {
                      "description": "The scheme which this scheme identifier applies to.",
                      "example": "bacs",
                      "enum": [
                        "ach",
                        "autogiro",
                        "bacs",
                        "becs",
                        "becs_nz",
                        "betalingsservice",
                        "faster_payments",
                        "pad",
                        "pay_to",
                        "sepa",
                        "sepa_credit_transfer",
                        "sepa_instant_credit_transfer"
                      ],
                      "type": "string"
                    },
                    "reference": {
                      "type": "string",
                      "description": "The scheme-unique identifier against which payments are submitted."
                    },
                    "status": {
                      "description": "The status of the scheme identifier. Only `active` scheme identifiers will be applied to a creditor and used against payments.",
                      "example": "pending",
                      "enum": [
                        "pending",
                        "active"
                      ],
                      "type": "string"
                    },
                    "minimum_advance_notice": {
                      "type": "integer",
                      "description": "The minimum interval, in working days, between the sending of a pre-notification to the customer, and the charge date of a payment using this scheme identifier.\n\nBy default, GoCardless sends these notifications automatically. Please see our [compliance requirements](#appendix-compliance-requirements) for more details.",
                      "example": 3
                    },
                    "address_line1": {
                      "type": "string",
                      "description": "The first line of the scheme identifier's support address.",
                      "example": "221B Baker Street"
                    },
                    "address_line2": {
                      "type": "string",
                      "nullable": true,
                      "description": "The second line of the scheme identifier's support address.",
                      "example": "Marylebone"
                    },
                    "address_line3": {
                      "type": "string",
                      "nullable": true,
                      "description": "The third line of the scheme identifier's support address.",
                      "example": "City of Westminster"
                    },
                    "city": {
                      "type": "string",
                      "description": "The city of the scheme identifier's support address.",
                      "example": "London"
                    },
                    "region": {
                      "type": "string",
                      "nullable": true,
                      "description": "The scheme identifier's support address region, county or department.",
                      "example": "Greater London"
                    },
                    "postal_code": {
                      "type": "string",
                      "description": "The scheme identifier's support postal code.",
                      "example": "NW1 6XE"
                    },
                    "country_code": {
                      "type": "string",
                      "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                      "example": "GB"
                    },
                    "email": {
                      "type": "string",
                      "description": "Scheme identifier's support email address.",
                      "example": "user@example.com"
                    },
                    "phone_number": {
                      "type": "string",
                      "description": "Scheme identifier's support phone number.",
                      "example": "+44 20 1234 1234"
                    },
                    "currency": {
                      "description": "The currency of the scheme identifier.",
                      "example": "EUR",
                      "enum": [
                        "AUD",
                        "CAD",
                        "DKK",
                        "EUR",
                        "GBP",
                        "NZD",
                        "SEK",
                        "USD"
                      ],
                      "type": "string"
                    },
                    "can_specify_mandate_reference": {
                      "type": "boolean",
                      "description": "Whether a custom reference can be submitted for mandates using this scheme identifier."
                    }
                  }
                }
              },
              "logo_url": {
                "type": "string",
                "nullable": true,
                "description": "URL for the creditor's logo, which may be shown on their payment pages.",
                "example": "https://uploads.gocardless.com/logo.png"
              },
              "verification_status": {
                "description": "The creditor's verification status, indicating whether they can yet receive payouts. For more details on handling verification as a partner, see our [\"Helping your users get verified\" guide](/getting-started/partners/helping-your-users-get-verified/). One of:\n\n- `successful`: The creditor's account is fully verified, and they can receive payouts. Once a creditor has been successfully verified, they may in the future require further verification - for example, if they change their payout bank account, we will have to check that they own the new bank account before they can receive payouts again.\n- `in_review`: The creditor has provided all of the information currently requested, and it is awaiting review by GoCardless before they can be verified and receive payouts.\n- `action_required`: The creditor needs to provide further information to verify their account so they can receive payouts, and should visit the verification flow.",
                "example": "action_required",
                "enum": [
                  "successful",
                  "in_review",
                  "action_required"
                ],
                "type": "string"
              },
              "merchant_responsible_for_notifications": {
                "type": "boolean",
                "description": "Boolean value indicating whether the organisation is responsible for sending all customer notifications (note this is separate from the functionality described [here](/getting-started/api/handling-customer-notifications/)). If you are a partner app, and this value is true, you should not send notifications on behalf of this organisation.",
                "example": true
              },
              "mandate_imports_enabled": {
                "type": "boolean",
                "description": "Boolean value indicating whether creditor has the [Mandate Imports](#core-endpoints-mandate-imports) functionality enabled.",
                "example": true
              },
              "custom_payment_pages_enabled": {
                "type": "boolean",
                "description": "Boolean value indicating whether creditor has the [Custom Payment Pages](https://hub.gocardless.com/s/article/Custom-payment-pages) functionality enabled.",
                "example": true
              },
              "fx_payout_currency": {
                "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) code for the currency in which amounts will be paid out (after foreign exchange). Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported. Present only if payouts will be (or were) made via foreign exchange.",
                "example": "EUR",
                "enum": [
                  "AUD",
                  "CAD",
                  "DKK",
                  "EUR",
                  "GBP",
                  "NZD",
                  "SEK",
                  "USD"
                ],
                "nullable": true,
                "type": "string"
              },
              "creditor_type": {
                "description": "The type of business of the creditor. Currently, `individual`, `company`, `charity`, `partnership`, and `trust` are supported.",
                "example": "company",
                "enum": [
                  "company",
                  "individual",
                  "charity",
                  "partnership",
                  "trust"
                ],
                "type": "string"
              }
            }
          }
        }
      },
      "creditor_multi_resource_response": {
        "type": "object",
        "title": "CreditorMultiResourceResponse",
        "description": "",
        "properties": {
          "creditors": {
            "type": "array",
            "items": {
