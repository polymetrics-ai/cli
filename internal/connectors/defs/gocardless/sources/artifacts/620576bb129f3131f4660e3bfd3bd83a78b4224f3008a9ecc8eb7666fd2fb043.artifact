    "/bank_authorisations": {
      "post": {
        "operationId": "create_bank_authorisation",
        "summary": "Create a Bank Authorisation",
        "description": "Create a Bank Authorisation.\n\n<p class=\"restricted-notice\"><strong>Restricted</strong>: this endpoint is restricted as the authorisation must be used within a\ncheckout flow that meets regulatory requirements for each payment\nscheme. Integrators should use a Billing Request Flow to do this.<br /><br />\nIf you would like to enable bank authorisations, you will need to go through a separate compliance process.\nFor more details please <a href=\"mailto:help@gocardless.com\">get in touch</a>.</p>",
        "tags": [
          "Bank Authorisation"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GoCardlessVersionHeader"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/bank_authorisation_single_resource_response"
                }
              }
            },
            "description": "Resource created successfully"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bank_authorisations": {
                    "type": "object",
                    "properties": {
                      "redirect_uri": {
                        "$ref": "#/components/schemas/bank_authorisation_redirect_uri"
                      },
                      "links": {
                        "type": "object",
                        "properties": {
                          "billing_request": {
                            "type": "string",
                            "description": "ID of the [billing request](#billing-requests-billing-requests) against which this authorisation was created.",
                            "example": "BRQ123"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "Ruby",
            "label": "Ruby",
            "source": "@client.bank_authorisations.create(\n  params: {\n    redirect_uri: \"https://my-company.com/landing\",\n    links: {\n        billing_request: \"BRQ123\"\n    }\n  }\n)"
          },
          {
            "lang": "Python",
            "label": "Python",
            "source": "client.bank_authorisations.create(params={\n  \"redirect_uri\": \"https://my-company.com/landing\",\n  \"links\": {\n    \"billing_request\": \"BRQ123\"\n  }\n})"
          },
          {
            "lang": "JavaScript",
            "label": "JavaScript",
            "source": "const bankAuthorisation = await client.bankAuthorisations.create({\n  redirect_uri: \"https://my-company.com/landing\",\n  links: {\n    billing_request: \"BRQ123\"\n  }\n});"
          },
          {
            "lang": "PHP",
            "label": "PHP",
            "source": "$client->bankAuthorisations()->create([\n  \"params\" => [\n    \"redirect_uri\" => \"https://my-company.com/landing\",\n    \"links\" => [\n      \"billing_request\" => \"BRQ123\"\n    ]\n  ]\n]);"
          },
          {
            "lang": "Java",
            "label": "Java",
            "source": "BankAuthorisation bankAuthorisation = client.bankAuthorisations().create()\n  .withRedirectUri(\"https://my-company.com/landing\")\n  .withLinksBillingRequest(\"BRQ123\")\n  .execute();"
          },
          {
            "lang": "Go",
            "label": "Go",
            "source": "bankAuthorisationCreateParams := gocardless.BankAuthorisationCreateParams{\n  RedirectUri: \"https://my-company.com/landing\",\n  Links: gocardless.BankAuthorisationCreateParamsLinks{\n    BillingRequest: \"BR123\",\n  },\n}\n\nbankAuthorisation, err :=  client.BankAuthorisations.Create(ctx, bankAuthorisationCreateParams)"
          },
          {
            "lang": "C#",
            "label": ".NET",
            "source": "var authorisationLinks = new GoCardless.Services.BankAuthorisationCreateRequest.BankAuthorisationLinks\n{\n  BillingRequest = \"BRQ123\"\n};\n\nvar resp = await client.BankAuthorisations.CreateAsync(\n  new GoCardless.Services.BankAuthorisationCreateRequest()\n  {\n    RedirectUri = \"https://my-company.com/landing\",\n    Links = authorisationLinks,\n  }\n);\n\nGoCardless.Resources.BankAuthorisation bankAuthorisation = resp.BankAuthorisation;"
          },
          {
            "lang": "HTTP",
            "label": "HTTP",
            "source": "POST https://api.gocardless.com/bank_authorisations HTTP/1.1\nContent-Type: application/json\n{\n  \"bank_authorisations\": {\n    \"redirect_uri\": \"https://my-company.com/landing\",\n    \"links\": {\n      \"billing_request\": \"BRQ123\"\n    }\n  }\n}\n\nHTTP/1.1 201 Created\nLocation: /bank_authorisations/BAU123\nContent-Type: application/json\n{\n  \"bank_authorisations\": {\n    \"id\": \"BAU123\",\n    \"url\": \"https://pay-staging.gocardless.com/obauth/BAU123\",\n    \"qr_code_url\": \"https://pay-staging.gocardless.com/obauth/BAU123/qr_code\",\n    \"created_at\": \"2021-03-25T17:26:28.305Z\",\n    \"authorisation_type\": \"payment\",\n    \"last_visited_at\": null,\n    \"authorised_at\": null,\n    \"expires_at\": \"2021-03-25T17:41:28.000Z\",\n    \"redirect_uri\": \"https://my-company.com/landing\",\n    \"links\": {\n      \"billing_request\": \"BRQ123\",\n      \"institution\": \"monzo\"\n    }\n  }\n}"
          }
        ]
      }
    },
