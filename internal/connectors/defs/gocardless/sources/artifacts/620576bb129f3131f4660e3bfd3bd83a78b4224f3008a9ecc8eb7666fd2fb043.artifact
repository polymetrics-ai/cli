            "lang": "JavaScript",
            "label": "JavaScript",
            "source": "const subscription = await client.subscriptions.create({\n  amount: \"2500\",\n  currency: \"GBP\",\n  name: \"Monthly Magazine\",\n  interval_unit: \"monthly\",\n  day_of_month:  \"1\",\n  metadata: {\n    order_no: \"ABCD1234\"\n  },\n  links: {\n    mandate: \"MA123\"\n  }\n});"
