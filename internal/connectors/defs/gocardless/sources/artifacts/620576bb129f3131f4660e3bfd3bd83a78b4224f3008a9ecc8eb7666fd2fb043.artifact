                      },
                      "subscription_frequency": {
                        "$ref": "#/components/schemas/mandate_pdf_subscription_frequency"
                      },
                      "links": {
                        "type": "object",
                        "description": "",
                        "properties": {
                          "mandate": {
                            "type": "string",
                            "description": "ID of an existing [mandate](#core-endpoints-mandates) to build the PDF from. The customer's bank details will be censored in the generated PDF. No other parameters may be provided alongside this."
                          },
                          "creditor": {
                            "type": "string",
                            "description": "ID of an existing [creditor](#core-endpoints-creditors). Only required if your account manages multiple creditors."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
