                    "description": "Estimated rate that will be used in the foreign exchange of the `amount` into the `fx_currency`.\nThis will vary based on the prevailing market rate until the moment that it is paid out.\nPresent only before a resource is paid out. Has up to 10 decimal places.",
                    "example": "1.1234567890"
                  },
                  "fx_amount": {
                    "oneOf": [
                      {
                        "type": "string",
                        "nullable": true
                      },
                      {
                        "type": "integer"
                      }
                    ],
                    "description": "Amount that was paid out in the `fx_currency` after foreign exchange.\nPresent only after the resource has been paid out.",
                    "example": 1150
                  },
                  "fx_currency": {
                    "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) code for the currency in which amounts will be paid out (after foreign exchange). Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported. Present only if payouts will be (or were) made via foreign exchange.",
                    "example": "EUR",
                    "enum": [
                      "AUD",
                      "CAD",
                      "DKK",
                      "EUR",
                      "GBP",
                      "NZD",
                      "SEK",
                      "USD"
                    ],
                    "nullable": true,
                    "type": "string"
                  }
                }
              },
              "tax_currency": {
                "type": "string",
                "nullable": true,
                "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) code for the currency in which tax is paid out to the tax authorities of your tax jurisdiction. Currently “EUR”, “GBP”, for French or British merchants, this will be `null` if tax is not applicable <em>beta</em>",
                "example": "EUR"
              },
              "metadata": {
                "type": "object",
                "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters. _Note:_ This should not be used for storing PII data.",
                "example": {
                  "salesforce_id": "ABCD1234"
                }
              }
            }
          }
        }
      },
      "payout_multi_resource_response": {
        "type": "object",
        "title": "PayoutMultiResourceResponse",
        "description": "",
        "properties": {
          "payouts": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Payouts represent transfers from GoCardless to a [creditor](#core-endpoints-creditors). Each payout contains the funds collected from one or many [payments](#core-endpoints-payments). All the payments in a payout will have been collected in the same currency. Payouts are created automatically after a payment has been successfully collected.",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier, beginning with \"PO\".",
                  "example": "PO123"
                },
                "created_at": {
                  "type": "string",
                  "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
                  "example": "2014-01-01T12:00:00.000Z",
                  "format": "date-time"
                },
                "amount": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "description": "Amount in minor unit (e.g. pence in GBP, cents in EUR).",
                  "example": 1000
                },
                "deducted_fees": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "description": "Fees that have already been deducted from the payout amount in minor unit (e.g. pence in GBP, cents in EUR), inclusive of tax if applicable.\n<br />\nFor each `late_failure_settled` or `chargeback_settled` action, we refund the transaction fees in a payout. This means that a payout can have a negative `deducted_fees` value.\n<br />\nThis field is calculated as `(GoCardless fees + app fees + surcharge fees) - (refunded fees)`\n<br />\nIf the merchant is invoiced for fees separately from the payout, then `deducted_fees` will be 0.",
                  "example": 20
                },
                "currency": {
                  "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                  "example": "EUR",
                  "enum": [
                    "AUD",
                    "CAD",
                    "DKK",
                    "EUR",
                    "GBP",
                    "NZD",
                    "SEK",
                    "USD"
                  ],
                  "type": "string"
                },
                "reference": {
                  "type": "string",
                  "description": "Reference which appears on the creditor's bank statement.",
                  "example": "ref-1"
                },
                "status": {
                  "description": "One of:\n\n- `pending`: the payout has been created, but not yet sent to your bank or it is in the process of being exchanged through our FX provider.\n- `paid`: the payout has been sent to the your bank. FX payouts will become `paid` after we emit the `fx_rate_confirmed` webhook.\n- `bounced`: the payout bounced when sent, the payout can be retried.",
                  "example": "pending",
                  "enum": [
                    "pending",
                    "paid",
                    "bounced"
                  ],
                  "type": "string"
                },
                "payout_type": {
                  "description": "Whether a payout contains merchant revenue or partner fees.",
                  "example": "merchant",
                  "enum": [
                    "merchant",
                    "partner"
                  ],
                  "type": "string"
                },
                "arrival_date": {
                  "type": "string",
                  "nullable": true,
                  "description": "Date the payout is due to arrive in the creditor's bank account.\nOne of:\n\n- `yyyy-mm-dd`: the payout has been paid and is due to arrive in the creditor's bank account on this day\n- `null`: the payout hasn't been paid yet\n",
                  "example": "2014-01-01"
                },
                "links": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "creditor": {
                      "type": "string",
                      "description": "ID of [creditor](#core-endpoints-creditors) who will receive this payout, i.e. the owner of the `creditor_bank_account`.",
                      "example": "CR123"
                    },
                    "creditor_bank_account": {
                      "type": "string",
                      "description": "ID of [bank account](#core-endpoints-creditor-bank-accounts) which this will be sent to.",
                      "example": "BA123"
                    }
                  }
                },
                "fx": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "exchange_rate": {
                      "type": "string",
                      "nullable": true,
                      "description": "Rate used in the foreign exchange of the `amount` into the `fx_currency`.\nPresent only after a resource is paid out. Has up to 10 decimal places.",
                      "example": "1.1234567890"
                    },
                    "estimated_exchange_rate": {
                      "type": "string",
                      "nullable": true,
                      "description": "Estimated rate that will be used in the foreign exchange of the `amount` into the `fx_currency`.\nThis will vary based on the prevailing market rate until the moment that it is paid out.\nPresent only before a resource is paid out. Has up to 10 decimal places.",
                      "example": "1.1234567890"
                    },
                    "fx_amount": {
                      "oneOf": [
                        {
                          "type": "string",
                          "nullable": true
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Amount that was paid out in the `fx_currency` after foreign exchange.\nPresent only after the resource has been paid out.",
                      "example": 1150
                    },
                    "fx_currency": {
                      "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) code for the currency in which amounts will be paid out (after foreign exchange). Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported. Present only if payouts will be (or were) made via foreign exchange.",
                      "example": "EUR",
                      "enum": [
                        "AUD",
                        "CAD",
                        "DKK",
                        "EUR",
                        "GBP",
                        "NZD",
                        "SEK",
                        "USD"
                      ],
                      "nullable": true,
                      "type": "string"
                    }
                  }
                },
                "tax_currency": {
                  "type": "string",
                  "nullable": true,
                  "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) code for the currency in which tax is paid out to the tax authorities of your tax jurisdiction. Currently “EUR”, “GBP”, for French or British merchants, this will be `null` if tax is not applicable <em>beta</em>",
                  "example": "EUR"
                },
                "metadata": {
                  "type": "object",
                  "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters. _Note:_ This should not be used for storing PII data.",
                  "example": {
                    "salesforce_id": "ABCD1234"
                  }
                }
              }
            }
          },
          "meta": {
            "type": "object",
            "description": "Cursor pagination information",
            "properties": {
              "limit": {
                "type": "integer",
                "example": 50
              },
              "cursors": {
                "type": "object",
                "properties": {
                  "before": {
                    "type": "string",
                    "nullable": true,
                    "description": "Cursor pointing to the end of the desired set."
                  },
                  "after": {
                    "type": "string",
                    "nullable": true,
                    "description": "Cursor pointing to the start of the desired set."
                  }
                }
              }
            }
          }
        }
      },
      "payout_item": {
        "type": "object",
        "title": "Payout Items",
        "description": "When we collect a payment on your behalf, we add the money you've collected to your\nGoCardless balance, minus any fees paid. Periodically (usually every working day),\nwe take any positive balance in your GoCardless account, and pay it out to your\nnominated bank account.\n\nOther actions in your GoCardless account can also affect your balance. For example,\nif a customer charges back a payment, we'll deduct the payment's amount from your\nbalance, but add any fees you paid for that payment back to your balance.\n\nThe Payout Items API allows you to view, on a per-payout basis, the credit and debit\nitems that make up that payout's amount.  Payout items can only be retrieved for payouts\ncreated in the last 6 months. Requests for older payouts will return an HTTP status\n<code>410 Gone</code>.\n",
        "properties": {
          "amount": {
            "type": "string",
            "description": "The positive (credit) or negative (debit) value of the item, in fractional currency;\nthe lowest denomination for the currency (e.g. pence in GBP, cents in EUR), to one decimal place.\n<p class=\"notice\">For accuracy, we store some of our fees to greater precision than we can actually pay out (for example, a GoCardless fee we record might come to 0.5 pence, but it is not possible to send a payout via bank transfer including a half penny).<br><br>To calculate the final amount of the payout, we sum all of the items and then round to the nearest currency unit.</p>",
            "example": "45.0"
          },
          "type": {
            "description": "The type of the credit (positive) or debit (negative) item in the payout (inclusive of VAT if applicable). One of:\n\n- `payment_paid_out` (credit)\n- `payment_failed` (debit): The payment failed to be processed.\n- `payment_charged_back` (debit): The payment has been charged back.\n- `payment_refunded` (debit): The payment has been refunded to the customer.\n- `refund` (debit): A refund sent to a customer, not linked to a payment.\n- `refund_funds_returned` (credit): The refund could not be sent to the customer, and the funds have been returned to you.\n- `gocardless_fee` (credit/debit): The fees that GoCardless charged for a payment. In the case of a payment failure or chargeback, these will appear as credits. Will include taxes if applicable for merchants.\n- `app_fee` (credit/debit): The optional fees that a partner may have taken for a payment. In the case of a payment failure or chargeback, these will appear as credits.\n- `revenue_share` (credit/debit): A share of the fees that GoCardless collected which some partner integrations receive when their users take payments. Only shown in partner payouts. In the case of a payment failure or chargeback, these will appear as credits.\n- `surcharge_fee` (credit/debit): GoCardless deducted a surcharge fee as the payment failed or was charged back, or refunded a surcharge fee as the bank or customer cancelled the chargeback. Will include taxes if applicable for merchants.\n",
            "example": "payment_paid_out",
            "enum": [
              "payment_paid_out",
              "payment_failed",
              "payment_charged_back",
              "payment_refunded",
              "refund",
              "gocardless_fee",
              "app_fee",
              "revenue_share",
              "surcharge_fee",
              "refund_funds_returned"
            ],
            "type": "string"
          },
          "taxes": {
            "type": "array",
            "description": "An array of tax items <em>beta</em>\n\n_Note_: VAT applies to transaction and surcharge fees for merchants operating in the UK and France.",
            "items": {
              "type": "object",
              "description": "",
              "properties": {
                "amount": {
                  "type": "string",
                  "description": "The amount of tax applied to a fee in fractional currency; the lowest denomination for the currency (e.g. pence in GBP, cents in EUR), to one decimal place.",
                  "example": "1.1"
                },
                "currency": {
                  "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                  "example": "EUR",
                  "enum": [
                    "AUD",
                    "CAD",
                    "DKK",
                    "EUR",
                    "GBP",
                    "NZD",
                    "SEK",
                    "USD"
                  ],
                  "type": "string"
                },
                "destination_amount": {
                  "type": "string",
                  "nullable": true,
                  "description": "The amount of tax to be paid out to the tax authorities in fractional currency; the lowest denomination for the currency (e.g. pence in GBP, cents in EUR), to one decimal place.\n\nWhen `currency` and `destination_currency` don't match this will be `null` until the `exchange_rate` has been finalised.",
                  "example": "1.1"
                },
                "destination_currency": {
                  "type": "string",
                  "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) code for the currency in which tax is paid out to the tax authorities of your tax jurisdiction. Currently “EUR” for French merchants and “GBP” for British merchants.",
                  "example": "EUR"
                },
                "exchange_rate": {
                  "type": "string",
                  "nullable": true,
                  "description": "The exchange rate for the tax from the currency into the destination currency.\n\nPresent only if the currency and the destination currency don't match and the exchange rate has been finalised.\n\nYou can listen for the payout's [`tax_exchange_rates_confirmed` webhook](https://developer.gocardless.com/api-reference/#event-types-payout) to know when the exchange rate has been finalised for all fees in the payout.",
                  "example": "1.11205"
                },
                "tax_rate_id": {
                  "type": "string",
                  "description": "The unique identifier created by the jurisdiction, tax type and version",
                  "example": "GB_VAT_1"
                }
              }
            }
          },
          "links": {
            "type": "object",
            "description": "",
            "properties": {
              "payment": {
                "type": "string",
                "description": "Unique identifier, beginning with \"PM\".",
                "example": "PM123"
              },
              "mandate": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/mandate"
                  },
                  {
                    "description": "Unique identifier, beginning with \"MD\". Note that this prefix may not apply to mandates created before 2016. Present only for the items of type `payment_refunded`, `refund` and `refund_funds_returned`."
                  }
                ]
              },
              "refund": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/refund"
                  },
                  {
                    "description": "Unique identifier, beginning with \"RF\". Present only for the items of type `payment_refunded`, `refund` and `refund_funds_returned`."
                  }
                ]
              }
            }
          }
        }
      },
      "payout_item_include_2020_tax_cutover": {
        "title": "PayoutItemInclude2020TaxCutover",
        "description": "Boolean value indicating whether the API should return tax data for the cutover period of April to August 2020. Defaults to false.",
        "enum": [
          "true",
          "false"
        ],
        "type": "string"
      },
      "payout_item_amount": {
