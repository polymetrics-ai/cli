      "redirect_flow_success_redirect_url": {
        "type": "string",
        "title": "RedirectFlowSuccessRedirectUrl",
        "description": "The URL to redirect to upon successful mandate setup. You must use a URL beginning `https` in the live environment.",
        "example": "https://example.com/pay/confirm"
