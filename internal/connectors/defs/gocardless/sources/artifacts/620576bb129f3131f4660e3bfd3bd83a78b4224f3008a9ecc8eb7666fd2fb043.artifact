      "refund_single_resource_response": {
        "type": "object",
        "title": "RefundSingleResourceResponse",
        "description": "",
        "properties": {
          "refunds": {
            "type": "object",
            "description": "Refund objects represent (partial) refunds of a [payment](#core-endpoints-payments) back to the [customer](#core-endpoints-customers).\n\nGoCardless will notify you via a [webhook](#appendix-webhooks) whenever a refund is created, and will update the `amount_refunded` property of the payment.",
