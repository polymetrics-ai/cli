    "/subscriptions/{subscription_id}/actions/pause": {
      "post": {
        "operationId": "pause_subscription",
        "summary": "Pause a subscription",
        "description": "Pause a subscription object.\nNo payments will be created until it is resumed.\n\nThis can only be used when a subscription is collecting a fixed number of payments (created using `count`),\nwhen they continue forever (created without `count` or `end_date`) or\nthe subscription is already paused for a number of cycles.\n\nWhen `pause_cycles` is omitted the subscription is paused until the [resume endpoint](#subscriptions-resume-a-subscription) is called.\nIf the subscription is collecting a fixed number of payments, `end_date` will be set to `null`.\nWhen paused indefinitely, `upcoming_payments` will be empty.\n\nWhen `pause_cycles` is provided the subscription will be paused for the number of cycles requested.\nIf the subscription is collecting a fixed number of payments, `end_date` will be set to a new value.\nWhen paused for a number of cycles, `upcoming_payments` will still contain the upcoming charge dates.\n\nThis fails with:\n\n- `forbidden` if the subscription was created by an app and you are not authenticated as that app, or if the subscription was not created by an app and you are authenticated as an app\n\n- `validation_failed` if invalid data is provided when attempting to pause a subscription.\n\n- `subscription_paused_cannot_update_cycles` if the subscription is already paused for a number of cycles and the request provides a value for `pause_cycle`.\n\n- `subscription_cannot_be_paused` if the subscription cannot be paused.\n\n- `subscription_already_ended` if the subscription has taken all payments.\n\n- `pause_cycles_must_be_greater_than_or_equal_to` if the provided value for `pause_cycles` cannot be satisfied.\n\n<p class=\"notice--warning\"><strong>Warning</strong>: Please note that any payments that have already been created from this\nsubscription will still be collected unless you manually cancel them.</p>",
        "tags": [
          "Subscription"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GoCardlessVersionHeader"
          },
          {
            "name": "subscription_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The subscription id"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/subscription_single_resource_response"
                }
              }
            },
            "description": "Action completed successfully"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subscriptions": {
                    "type": "object",
                    "properties": {
                      "pause_cycles": {
                        "$ref": "#/components/schemas/subscription_pause_cycles"
                      },
                      "metadata": {
                        "$ref": "#/components/schemas/customer_metadata"
                      }
                    }
                  }
                }
