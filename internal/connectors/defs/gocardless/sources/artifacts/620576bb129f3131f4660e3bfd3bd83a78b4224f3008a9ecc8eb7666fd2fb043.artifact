      "customer": {
        "type": "object",
        "title": "Customers",
        "description": "Customer objects hold the contact details for a customer. A customer can have several [customer bank accounts](#core-endpoints-customer-bank-accounts), which in turn can have several Direct Debit [mandates](#core-endpoints-mandates).",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier, beginning with \"CU\".",
            "example": "CU123"
          },
          "created_at": {
            "type": "string",
            "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
            "example": "2014-01-01T12:00:00.000Z",
            "format": "date-time"
          },
          "email": {
            "type": "string",
            "nullable": true,
            "description": "Customer's email address. Required in most cases, as this allows GoCardless to send notifications to this customer.",
            "example": "user@example.com"
          },
          "given_name": {
            "type": "string",
            "nullable": true,
            "description": "Customer's first name. Required unless a `company_name` is provided.",
            "example": "Frank"
          },
          "family_name": {
            "type": "string",
            "nullable": true,
            "description": "Customer's surname. Required unless a `company_name` is provided.",
            "example": "Osborne"
          },
          "company_name": {
            "type": "string",
            "nullable": true,
            "description": "Customer's company name. Required unless a `given_name` and `family_name` are provided. For Canadian customers, the use of a `company_name` value will mean that any mandate created from this customer will be considered to be a \"Business PAD\" (otherwise, any mandate will be considered to be a \"Personal PAD\").",
            "example": "Hamilton Trading Ltd."
          },
          "address_line1": {
            "type": "string",
            "nullable": true,
            "description": "The first line of the customer's address.",
            "example": "221B Baker Street"
          },
          "address_line2": {
            "type": "string",
            "nullable": true,
            "description": "The second line of the customer's address.",
            "example": "Marylebone"
          },
          "address_line3": {
            "type": "string",
            "nullable": true,
            "description": "The third line of the customer's address.",
            "example": "City of Westminster"
          },
          "city": {
            "type": "string",
            "nullable": true,
            "description": "The city of the customer's address.",
            "example": "London"
          },
          "region": {
            "type": "string",
            "nullable": true,
            "description": "The customer's address region, county or department. For US customers a 2 letter [ISO3166-2:US](https://en.wikipedia.org/wiki/ISO_3166-2:US) state code is required (e.g. `CA` for California).",
            "example": "Greater London"
          },
          "postal_code": {
            "type": "string",
            "nullable": true,
            "description": "The customer's postal code.",
            "example": "NW1 6XE"
          },
          "country_code": {
            "type": "string",
            "nullable": true,
            "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
            "example": "GB"
          },
          "language": {
            "type": "string",
            "nullable": true,
            "description": "[ISO 639-1](https://en.wikipedia.org/wiki/List_of_ISO_639-1_codes) code. Used as the language for notification emails sent by GoCardless if your organisation does not send its own (see [compliance requirements](#appendix-compliance-requirements)). Currently only \"en\", \"fr\", \"de\", \"pt\", \"es\", \"it\", \"nl\", \"da\", \"nb\", \"sl\", \"sv\" are supported. If this is not provided, the language will be chosen based on the `country_code` (if supplied) or default to \"en\".",
            "example": "en"
          },
          "phone_number": {
            "type": "string",
            "nullable": true,
            "description": "[ITU E.123](https://en.wikipedia.org/wiki/E.123) formatted phone number, including country code.",
            "example": "+64 4 817 9999"
          },
          "swedish_identity_number": {
            "type": "string",
            "nullable": true,
            "description": "For Swedish customers only. The civic/company number (personnummer, samordningsnummer, or organisationsnummer) of the customer. Must be supplied if the customer's bank account is denominated in Swedish krona (SEK). This field cannot be changed once it has been set.",
            "example": "556564-5404"
          },
          "danish_identity_number": {
            "type": "string",
            "nullable": true,
            "description": "For Danish customers only. The civic/company number (CPR or CVR) of the customer. Must be supplied if the customer's bank account is denominated in Danish krone (DKK).",
            "example": "220550-6218"
          },
          "metadata": {
            "type": "object",
            "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
          }
        }
      },
      "customer_metadata": {
        "type": "object",
        "title": "CustomerMetadata",
        "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
      },
      "customer_instances_before": {
        "type": "string",
        "title": "CustomerInstancesBefore",
        "description": "Cursor pointing to the end of the desired set."
      },
      "customer_instances_after": {
        "type": "string",
        "title": "CustomerInstancesAfter",
        "description": "Cursor pointing to the start of the desired set."
      },
      "customer_instances_limit": {
        "oneOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "title": "CustomerInstancesLimit",
        "description": "Number of records to return."
      },
      "customer_instances_created_at": {
        "type": "object",
        "title": "CustomerInstancesCreatedAt",
        "description": "",
        "properties": {
          "gt": {
            "type": "string",
            "description": "Limit to records created after the specified date-time.",
            "format": "date-time"
          },
          "lt": {
            "type": "string",
            "description": "Limit to records created before the specified date-time.",
            "format": "date-time"
          },
          "gte": {
            "type": "string",
            "description": "Limit to records created on or after the specified date-time.",
            "format": "date-time"
          },
          "lte": {
            "type": "string",
            "description": "Limit to records created on or before the specified date-time.",
            "format": "date-time"
          }
        }
      },
      "customer_sort_direction": {
        "title": "CustomerSortDirection",
        "description": "The direction to sort in.\nOne of:\n\n- `asc`\n- `desc`",
        "enum": [
          "asc",
          "desc"
        ],
        "type": "string"
      },
      "customer_sort_field": {
        "title": "CustomerSortField",
        "description": "Field by which to sort records.\nOne of:\n\n- `name`\n- `company_name`\n- `created_at`",
        "enum": [
          "name",
          "company_name",
          "created_at"
        ],
        "type": "string"
      },
      "customer_id": {
        "type": "string",
        "title": "CustomerId",
        "description": "Unique identifier, beginning with \"CU\".",
        "example": "CU123"
      },
      "customer_identity": {
        "type": "string",
        "title": "CustomerIdentity",
        "description": "Unique identifier, beginning with \"CU\".",
        "example": "CU123"
      },
      "customer_created_at": {
        "type": "string",
        "title": "CustomerCreatedAt",
        "description": "Fixed [timestamp](#api-usage-dates-and-times), recording when this resource was created.",
        "example": "2014-01-01T12:00:00.000Z",
        "format": "date-time"
      },
      "customer_email": {
        "type": "string",
        "nullable": true,
        "title": "CustomerEmail",
        "description": "Customer's email address. Required in most cases, as this allows GoCardless to send notifications to this customer.",
        "example": "user@example.com"
      },
      "customer_given_name": {
        "type": "string",
        "nullable": true,
        "title": "CustomerGivenName",
        "description": "Customer's first name. Required unless a `company_name` is provided.",
        "example": "Frank"
      },
      "customer_family_name": {
        "type": "string",
        "nullable": true,
        "title": "CustomerFamilyName",
        "description": "Customer's surname. Required unless a `company_name` is provided.",
        "example": "Osborne"
      },
      "customer_company_name": {
        "type": "string",
        "nullable": true,
        "title": "CustomerCompanyName",
        "description": "Customer's company name. Required unless a `given_name` and `family_name` are provided. For Canadian customers, the use of a `company_name` value will mean that any mandate created from this customer will be considered to be a \"Business PAD\" (otherwise, any mandate will be considered to be a \"Personal PAD\").",
        "example": "Hamilton Trading Ltd."
      },
      "customer_address_line1": {
        "type": "string",
        "nullable": true,
        "title": "CustomerAddressLine1",
        "description": "The first line of the customer's address.",
        "example": "221B Baker Street"
      },
      "customer_address_line2": {
        "type": "string",
        "nullable": true,
        "title": "CustomerAddressLine2",
        "description": "The second line of the customer's address.",
        "example": "Marylebone"
      },
      "customer_address_line3": {
        "type": "string",
        "nullable": true,
        "title": "CustomerAddressLine3",
        "description": "The third line of the customer's address.",
        "example": "City of Westminster"
      },
      "customer_city": {
        "type": "string",
        "nullable": true,
        "title": "CustomerCity",
        "description": "The city of the customer's address.",
        "example": "London"
      },
      "customer_region": {
        "type": "string",
        "nullable": true,
        "title": "CustomerRegion",
        "description": "The customer's address region, county or department. For US customers a 2 letter [ISO3166-2:US](https://en.wikipedia.org/wiki/ISO_3166-2:US) state code is required (e.g. `CA` for California).",
        "example": "Greater London"
      },
      "customer_postal_code": {
        "type": "string",
        "nullable": true,
        "title": "CustomerPostalCode",
        "description": "The customer's postal code.",
        "example": "NW1 6XE"
      },
      "customer_country_code": {
        "type": "string",
        "nullable": true,
        "title": "CustomerCountryCode",
        "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
        "example": "GB"
      },
      "customer_language": {
        "type": "string",
        "nullable": true,
        "title": "CustomerLanguage",
        "description": "[ISO 639-1](https://en.wikipedia.org/wiki/List_of_ISO_639-1_codes) code. Used as the language for notification emails sent by GoCardless if your organisation does not send its own (see [compliance requirements](#appendix-compliance-requirements)). Currently only \"en\", \"fr\", \"de\", \"pt\", \"es\", \"it\", \"nl\", \"da\", \"nb\", \"sl\", \"sv\" are supported. If this is not provided, the language will be chosen based on the `country_code` (if supplied) or default to \"en\".",
        "example": "en"
      },
      "customer_phone_number": {
        "type": "string",
        "nullable": true,
        "title": "CustomerPhoneNumber",
        "description": "[ITU E.123](https://en.wikipedia.org/wiki/E.123) formatted phone number, including country code.",
        "example": "+64 4 817 9999"
      },
      "customer_swedish_identity_number": {
        "type": "string",
        "nullable": true,
        "title": "CustomerSwedishIdentityNumber",
        "description": "For Swedish customers only. The civic/company number (personnummer, samordningsnummer, or organisationsnummer) of the customer. Must be supplied if the customer's bank account is denominated in Swedish krona (SEK). This field cannot be changed once it has been set.",
        "example": "556564-5404"
      },
      "customer_danish_identity_number": {
        "type": "string",
        "nullable": true,
        "title": "CustomerDanishIdentityNumber",
        "description": "For Danish customers only. The civic/company number (CPR or CVR) of the customer. Must be supplied if the customer's bank account is denominated in Danish krone (DKK).",
        "example": "220550-6218"
      },
      "customer_currency": {
        "title": "CustomerCurrency",
        "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
        "example": "EUR",
        "enum": [
          "AUD",
          "CAD",
          "DKK",
          "EUR",
          "GBP",
          "NZD",
          "SEK",
          "USD"
        ],
        "type": "string"
      },
      "customer_pagination_meta": {
        "type": "object",
        "title": "CustomerPaginationMeta",
        "description": "Cursor pagination information",
        "properties": {
          "limit": {
            "type": "integer",
            "example": 50
          },
          "cursors": {
            "type": "object",
            "properties": {
              "before": {
                "type": "string",
                "nullable": true,
                "description": "Cursor pointing to the end of the desired set."
              },
              "after": {
                "type": "string",
                "nullable": true,
                "description": "Cursor pointing to the start of the desired set."
              }
            }
          }
        }
      },
