    "/payer_authorisations/{payer_authorisation_id}/actions/confirm": {
      "post": {
        "operationId": "confirm_payer_authorisation",
        "summary": "Confirm a Payer Authorisation",
        "description": "Confirms the Payer Authorisation, indicating that the resources are ready to be created.\nA Payer Authorisation cannot be confirmed if it hasn't been submitted yet.\n\n<p class=\"notice\">\n  The main use of the confirm endpoint is to enable integrators to acknowledge the end of the setup process.\n  They might want to make the payers go through some other steps after they go through our flow or make them go through the necessary verification mechanism (upcoming feature).\n</p>\n\n**Deprecated:** Payer Authorisation is legacy API and cannot be used by new integrators.\nThe [Billing Request](#billing-requests) API should be used for any new integrations.",
        "tags": [
          "Payer Authorisation"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GoCardlessVersionHeader"
          },
          {
            "name": "payer_authorisation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The payer authorisation id"
