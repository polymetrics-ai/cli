                  "users",
                  "organisation_authorisations",
                  "gc_invalid_authorisation_requests",
                  "partner_fees",
                  "payments_import_template",
                  "payment_account_statement",
                  "outbound_payments_index",
                  "payment_account_transactions"
                ],
                "type": "string"
              },
              "download_url": {
                "type": "string",
                "nullable": true,
                "description": "Download url for the export file. Subject to expiry."
