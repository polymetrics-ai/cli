                            "faster_payments"
                          ],
                          "type": "string"
                        },
                        "recipient_bank_account": {
                          "type": "array",
                          "description": "Errors related to the recipient bank account.",
                          "items": {
                            "type": "string"
                          }
                        },
                        "reference": {
                          "type": "array",
                          "description": "Errors related to the reference field.",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                },
                "links": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "outbound_payment_import": {
                      "type": "string",
                      "description": "ID of the associated import.",
                      "example": "IM123"
                    },
                    "outbound_payment": {
                      "type": "string",
                      "nullable": true,
                      "description": "ID of the associated outbound payment, once the entry has been processed.",
                      "example": "OUT123"
                    },
                    "recipient_bank_account": {
                      "type": "string",
                      "nullable": true,
                      "description": "ID of the recipient bank account.",
                      "example": "BA123"
                    }
                  }
                },
                "metadata": {
                  "type": "object",
                  "nullable": true,
                  "description": "Key-value store of custom data. Up to 3 keys are permitted, with\nkey names up to 50 characters and values up to 500 characters."
                }
              }
            }
          },
          "meta": {
            "type": "object",
            "description": "Cursor pagination information",
            "properties": {
              "limit": {
                "type": "integer",
                "example": 50
              },
              "cursors": {
                "type": "object",
                "properties": {
                  "before": {
                    "type": "string",
                    "nullable": true,
                    "description": "Cursor pointing to the end of the desired set."
                  },
                  "after": {
                    "type": "string",
                    "nullable": true,
                    "description": "Cursor pointing to the start of the desired set."
                  }
                }
              }
            }
          }
        }
      },
      "payer_authorisation": {
        "type": "object",
        "title": "Payer Authorisations",
        "description": "<p class=\"restricted-notice\">\n  Don't use Payer Authorisations for new integrations.\n  It is deprecated in favour of\n  <a href=\"https://developer.gocardless.com/getting-started/billing-requests/overview/\">\n  Billing Requests</a>. Use Billing Requests to build any future integrations.\n</p>\n\nPayer Authorisation resource acts as a wrapper for creating customer, bank account and mandate details in a single request.\nPayerAuthorisation API enables the integrators to build their own custom payment pages.\n\nThe process to use the Payer Authorisation API is as follows:\n\n  1. Create a Payer Authorisation, either empty or with already available information\n  2. Update the authorisation with additional information or fix any mistakes\n  3. Submit the authorisation, after the payer has reviewed their information\n  4. [coming soon] Redirect the payer to the verification mechanisms from the response of the Submit request (this will be introduced as a non-breaking change)\n  5. Confirm the authorisation to indicate that the resources can be created\n\nAfter the Payer Authorisation is confirmed, resources will eventually be created as it's an asynchronous process.\n\nTo retrieve the status and ID of the linked resources you can do one of the following:\n<ol>\n  <li> Listen to <code>  payer_authorisation_completed </code>  <a href=\"#appendix-webhooks\"> webhook</a> (recommended)</li>\n  <li> Poll the GET <a href=\"#payer-authorisations-get-a-single-payer-authorisation\"> endpoint</a></li>\n  <li> Poll the GET events API <code>https://api.gocardless.com/events?payer_authorisation={id}&action=completed</code> </li>\n</ol>\n\n<p class=\"notice\">\n  Note that the <code>create</code> and <code>update</code> endpoints behave differently than\n  other existing <code>create</code> and <code>update</code> endpoints. The Payer Authorisation is still saved if incomplete data is provided.\n  We return the list of incomplete data in the <code>incomplete_fields</code> along with the resources in the body of the response.\n  The bank account details(account_number, bank_code & branch_code) must be sent together rather than splitting across different request for both <code>create</code> and <code>update</code> endpoints.\n  <br><br>\n  The API is designed to be flexible and allows you to collect information in multiple steps without storing any sensitive data in the browser or in your servers.\n</p>",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier, beginning with \"PA\".",
            "example": "PA123"
          },
          "created_at": {
            "type": "string",
            "nullable": true,
            "description": "[Timestamp](#api-usage-dates-and-times), recording when this Payer Authorisation was created.",
            "example": "2020-01-01T12:00:00.000Z",
            "format": "date-time"
          },
          "customer": {
            "type": "object",
            "description": "All details required for the creation of a [Customer](#core-endpoints-customers).",
            "properties": {
              "email": {
                "type": "string",
                "nullable": true,
                "description": "Customer's email address. Required in most cases, as this allows GoCardless to send notifications to this customer.",
                "example": "user@example.com"
              },
              "given_name": {
                "type": "string",
                "nullable": true,
                "description": "Customer's first name. Required unless a `company_name` is provided.",
                "example": "Frank"
              },
              "family_name": {
                "type": "string",
                "nullable": true,
                "description": "Customer's surname. Required unless a `company_name` is provided.",
                "example": "Osborne"
              },
              "company_name": {
                "type": "string",
                "nullable": true,
                "description": "Customer's company name. Required unless a `given_name` and `family_name` are provided. For Canadian customers, the use of a `company_name` value will mean that any mandate created from this customer will be considered to be a \"Business PAD\" (otherwise, any mandate will be considered to be a \"Personal PAD\").",
                "example": "Hamilton Trading Ltd."
              },
              "address_line1": {
                "type": "string",
                "nullable": true,
                "description": "The first line of the customer's address.",
                "example": "221B Baker Street"
              },
              "address_line2": {
                "type": "string",
                "nullable": true,
                "description": "The second line of the customer's address.",
                "example": "Marylebone"
              },
              "address_line3": {
                "type": "string",
                "nullable": true,
                "description": "The third line of the customer's address.",
                "example": "City of Westminster"
              },
              "city": {
                "type": "string",
                "nullable": true,
                "description": "The city of the customer's address.",
                "example": "London"
              },
              "region": {
                "type": "string",
                "nullable": true,
                "description": "The customer's address region, county or department. For US customers a 2 letter [ISO3166-2:US](https://en.wikipedia.org/wiki/ISO_3166-2:US) state code is required (e.g. `CA` for California).",
                "example": "Greater London"
              },
              "postal_code": {
                "type": "string",
                "nullable": true,
                "description": "The customer's postal code.",
                "example": "NW1 6XE"
              },
              "country_code": {
                "type": "string",
                "nullable": true,
                "description": "[ISO 3166-1 alpha-2 code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)",
                "example": "GB"
              },
              "locale": {
                "type": "string",
                "nullable": true,
                "description": "An [IETF Language Tag](https://tools.ietf.org/html/rfc5646), used for both language\nand regional variations of our product.\n",
                "example": "en-GB"
              },
              "swedish_identity_number": {
                "type": "string",
                "nullable": true,
                "description": "For Swedish customers only. The civic/company number (personnummer, samordningsnummer, or organisationsnummer) of the customer. Must be supplied if the customer's bank account is denominated in Swedish krona (SEK). This field cannot be changed once it has been set.",
                "example": "556564-5404"
              },
              "danish_identity_number": {
                "type": "string",
                "nullable": true,
                "description": "For Danish customers only. The civic/company number (CPR or CVR) of the customer. Must be supplied if the customer's bank account is denominated in Danish krone (DKK).",
                "example": "220550-6218"
              },
              "metadata": {
                "type": "object",
                "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
              }
            }
          },
          "bank_account": {
            "type": "object",
            "description": "All details required for the creation of a\n[Customer Bank Account](#core-endpoints-customer-bank-accounts).",
            "properties": {
              "account_holder_name": {
                "type": "string",
                "description": "Name of the account holder, as known by the bank. The full name provided when the customer is created is stored and is available via the API, but is transliterated, upcased, and truncated to 18 characters in bank submissions. This field is required unless the request includes a [customer bank account token](#javascript-flow-customer-bank-account-tokens).",
                "example": "Billie Jean"
              },
              "account_number": {
                "type": "string",
                "nullable": true,
                "description": "Bank account number - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`.",
                "example": "55779911"
              },
              "account_number_ending": {
                "type": "string",
                "description": "The last few digits of the account number. Currently 4 digits for NZD bank accounts and 2 digits for other currencies.",
                "example": "1234"
              },
              "account_number_suffix": {
                "type": "string",
                "nullable": true,
                "description": "Account number suffix (only for bank accounts denominated in NZD) - see [local details](#local-bank-details-new-zealand) for more information.",
                "example": "00"
              },
              "bank_code": {
                "type": "string",
                "nullable": true,
                "description": "Bank code - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`."
              },
              "branch_code": {
                "type": "string",
                "nullable": true,
                "description": "Branch code - see [local details](#appendix-local-bank-details) for more information. Alternatively you can provide an `iban`.",
                "example": "20-00-00"
              },
              "iban": {
                "type": "string",
                "nullable": true,
                "description": "International Bank Account Number. Alternatively you can provide [local details](#appendix-local-bank-details). IBANs are not accepted for Swedish bank accounts denominated in SEK - you must supply [local details](#local-bank-details-sweden).",
                "example": "GB60BARC20000055779911"
              },
              "country_code": {
                "type": "string",
                "nullable": true,
                "description": "[ISO 3166-1 alpha-2 code](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements). Defaults to the country code of the `iban` if supplied, otherwise is required.",
                "example": "GB"
              },
              "currency": {
                "type": "string",
                "nullable": true,
                "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) currency code. Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported.",
                "example": "EUR"
              },
              "account_type": {
                "description": "Bank account type. Required for USD-denominated bank accounts. Must not be provided for bank accounts in other currencies. See [local details](#local-bank-details-united-states) for more information.",
                "example": "savings",
                "enum": [
                  "savings",
                  "checking"
                ],
                "nullable": true,
                "type": "string"
              },
              "metadata": {
                "type": "object",
                "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
              }
            }
          },
          "mandate": {
            "type": "object",
            "description": "All details required for the creation of a [Mandate](#core-endpoints-mandates).",
            "properties": {
              "reference": {
                "type": "string",
                "nullable": true,
                "description": "Unique reference. Different schemes have different length and [character set](#appendix-character-sets) requirements. GoCardless will generate a unique reference satisfying the different scheme requirements if this field is left blank.",
                "example": "REF-123"
              },
              "scheme": {
                "description": "A bank payment scheme. Currently \"ach\", \"autogiro\", \"bacs\", \"becs\", \"becs_nz\", \"betalingsservice\", \"faster_payments\", \"pad\", \"pay_to\" and \"sepa_core\" are supported.",
                "example": "bacs",
                "enum": [
                  "ach",
                  "autogiro",
                  "bacs",
                  "becs",
                  "becs_nz",
                  "betalingsservice",
                  "faster_payments",
                  "pad",
                  "pay_to",
                  "sepa_core"
                ],
                "nullable": true,
                "type": "string"
              },
              "payer_ip_address": {
                "type": "string",
                "nullable": true,
                "description": "For ACH customers only. Required for ACH customers. A string containing the IP address of the payer to whom the mandate belongs (i.e. as a result of their completion of a mandate setup flow in their browser).\n\nNot required for creating offline mandates where `authorisation_source` is set to telephone or paper.\n",
                "example": "127.0.0.1"
              },
              "metadata": {
                "type": "object",
                "description": "Key-value store of custom data. Up to 3 keys are permitted, with key names up to 50 characters and values up to 500 characters."
              }
            }
          },
          "incomplete_fields": {
            "type": "array",
            "description": "An array of fields which are missing and is required to set up the mandate.",
            "items": {
              "type": "object",
              "description": "",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "The root resource."
                },
                "message": {
                  "type": "string",
                  "description": "A localised error message"
                },
                "request_pointer": {
                  "type": "string",
                  "description": "The path to the field e.g. \"/payer_authorisations/customer/city\""
                }
              }
            }
          },
          "links": {
            "type": "object",
            "description": "IDs of the created resources. Available after the Payer Authorisation is completed.",
            "properties": {
              "customer": {
                "type": "string",
                "description": "Unique identifier, beginning with \"CU\".",
                "example": "CU123"
              },
              "bank_account": {
                "type": "string",
                "description": "Unique identifier, beginning with \"BA\".",
                "example": "BA123"
              },
              "mandate": {
                "type": "string",
                "description": "Unique identifier, beginning with \"MD\". Note that this prefix may not apply to mandates created before 2016.",
                "example": "MD123"
              }
            }
          },
          "status": {
            "description": "One of:\n\n- `created`: The PayerAuthorisation has been created, and not been confirmed yet\n- `submitted`: The payer information has been submitted\n- `confirmed`: PayerAuthorisation is confirmed and resources are ready to be created\n- `completed`: The PayerAuthorisation has been completed and customer, bank_account and mandate has been created\n- `failed`: The PayerAuthorisation has failed and customer, bank_account and mandate is not created",
            "example": "created",
            "enum": [
              "created",
              "submitted",
              "confirmed",
              "completed",
              "failed"
            ],
            "type": "string"
          }
        }
      },
      "payer_authorisation_id": {
        "type": "string",
        "title": "PayerAuthorisationId",
        "description": "Unique identifier, beginning with \"PA\".",
        "example": "PA123"
      },
      "payer_authorisation_identity": {
        "type": "string",
        "title": "PayerAuthorisationIdentity",
        "description": "Unique identifier, beginning with \"PA\".",
        "example": "PA123"
      },
