      "creditor_payout_day_of_month": {
        "type": "integer",
        "nullable": true,
        "title": "CreditorPayoutDayOfMonth",
        "description": "As per RFC 2445. A day of the month a merchant has selected for payouts to occur on. `1`-`28` or `-1` to indicate the last day of the month.",
        "example": 28
      },
      "creditor_payout_day_of_week": {
        "title": "CreditorPayoutDayOfWeek",
        "description": "The day of the week a merchant has selected for payouts to occur on. Must be lowercase.",
        "example": "tuesday",
        "enum": [
          "sunday",
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday",
          "saturday"
        ],
        "nullable": true,
        "type": "string"
      },
      "creditor_payout_interval_unit": {
        "title": "CreditorPayoutIntervalUnit",
        "description": "The unit of time between payouts for a merchant. Either `daily`, `weekly`, `monthly` or null.",
        "example": "monthly",
        "enum": [
          "daily",
          "weekly",
          "monthly"
        ],
        "nullable": true,
        "type": "string"
      },
      "creditor_payout_override_timestamp": {
        "type": "string",
        "nullable": true,
        "title": "CreditorPayoutOverrideTimestamp",
        "description": "A timestamp that is set when a merchant wants to withdraw all available payouts regardless of when the next payout is scheduled. Used to determine whether or not an out-of-cycle payout has occurred yet.",
        "example": "2024-12-02T12:00:00.000Z",
        "format": "date-time"
      },
      "creditor_can_create_refunds": {
        "type": "boolean",
        "title": "CreditorCanCreateRefunds",
        "description": "Boolean indicating whether the creditor is permitted to create refunds."
      },
      "creditor_bank_reference_prefix": {
        "type": "string",
        "title": "CreditorBankReferencePrefix",
        "description": "Prefix for the bank reference of payouts sent to this creditor. For instance, if\nthe creditor's `bank_reference_prefix` was `ACME`, the bank reference of a payout\nsent to that creditor could be `ACME-8G7Q8`.\n\nThis prefix is also used for refunds in EUR and GBP.\n",
        "example": "ACME"
      },
      "creditor_fx_payout_currency": {
        "title": "CreditorFxPayoutCurrency",
        "description": "[ISO 4217](https://en.wikipedia.org/wiki/ISO_4217#Active_codes) code for the currency in which amounts will be paid out (after foreign exchange). Currently \"AUD\", \"CAD\", \"DKK\", \"EUR\", \"GBP\", \"NZD\", \"SEK\" and \"USD\" are supported. Present only if payouts will be (or were) made via foreign exchange.",
        "example": "EUR",
        "enum": [
          "AUD",
          "CAD",
          "DKK",
          "EUR",
          "GBP",
          "NZD",
          "SEK",
          "USD"
        ],
        "nullable": true,
        "type": "string"
      },
