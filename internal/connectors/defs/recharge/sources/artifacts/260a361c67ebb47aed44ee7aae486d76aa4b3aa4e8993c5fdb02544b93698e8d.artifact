 CHARGE] `\u002Fcharges\u002F{id}`  (if it's a charge that does not have a processed_at date or the processed_at date is within the last 90 days) \u003Cbr\u003E\u003Cbr\u003EExample of API calls that will result in an error: \u003Cbr\u003E[RETRIEVE A CHARGE] `\u002Fcharges\u002F{id}`  (if it's a charge with a processed_at date older than 90 days)\u003Cbr\u003E",documentation:[],parameters:{},body_parameters:{},responses:{"200":{error_code:y,description:x,json_example:{charge:{id:gf,address_id:ch,analytics_data:{utm_params:[{utm_source:cl,utm_medium:bR}]},billing_address:{address1:eO,address2:aU,city:eP,company:fQ,country_code:ai,first_name:de,last_name:cT,phone:eQ,province:eR,zip:eS},client_details:{browser_ip:dI,user_agent:dJ},created_at:gg,currency:aq,customer:{id:bh,email:ep,external_customer_id:{ecommerce:eq},hash:cM},discounts:[{id:dq,code:eo,value:dd,value_type:an}],error:a,error_type:a,external_order_id:{ecommerce:fR},external_transaction_id:{payment_processor:er},has_uncommitted_changes:c,line_items:[{purchase_item_id:cN,external_product_id:{ecommerce:cj},external_variant_id:{ecommerce:es},grams:aZ,handle:gh,images:{large:dK,medium:dL,original:dM,small:dN},original_price:w,properties:[{name:bO,value:bS}],purchase_item_type:E,quantity:z,sku:bn,tax_due:eT,tax_lines:[{price:gi,rate:bT,title:af,unit_price:gj},{price:gk,rate:bU,title:ds,unit_price:gl}],taxable:b,taxable_amount:w,title:gm,total_price:eU,unit_price:w,unit_price_includes_tax:c,variant_title:gn}],note:eV,order_attributes:[{name:go,value:gp}],orders_count:z,payment_processor:bY,processed_at:iQ,retry_date:ng,scheduled_at:gq,shipping_address:{address1:cU,address2:aU,city:cV,company:cW,country_code:ai,first_name:cX,last_name:cY,phone:cZ,province:cL,zip:c_},shipping_lines:[{code:aW,price:dO,source:dt,taxable:b,tax_lines:[{price:dP,rate:bW,title:af},{price:du,rate:bX,title:bL}],title:aW}],status:bi,subtotal_price:w,tags:et,tax_lines:[{price:dv,rate:bW,title:af},{price:dw,rate:bX,title:bL}],taxable:b,taxes_