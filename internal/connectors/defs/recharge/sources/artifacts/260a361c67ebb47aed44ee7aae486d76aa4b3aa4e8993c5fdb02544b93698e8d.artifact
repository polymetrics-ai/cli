<span class="hljs-punctuation">}</span></code></pre></div></div></div></div></div></div></div></div></div> <!----></div></div></div>  <div class="divider" data-v-7c527c32></div></div></div></section><section class="w-full" data-v-0edaa383><div id="checkout_create" class="api-section w-full" style="display:none;" data-v-0edaa383><!----> <div class="w-full" data-v-7c527c32><div class="p-5 md:p-10 lg:flex lg:p-10 xl:p-8 xl:pt-20 lg:w-full" data-v-7c527c32><div class="api-section-left-side lg:pr-10 lg:w-2/3 overflow-x-hidden" data-v-7c527c32><div class="py-2" data-v-7c527c32><div class="flex items-center cursor-pointer relative" data-v-7c527c32><svg aria-hidden="true" focusable="false" data-prefix="fas" data-icon="link" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" name="checkout_create" class="text-gray-400 anchor-icon svg-inline--fa fa-link fa-w-16" style="display:none;" data-v-7c527c32 data-v-7c527c32><path fill="currentColor" d="M326.612 185.391c59.747 59.809 58.927 155.698.36 214.59-.11.12-.24.25-.36.37l-67.2 67.2c-59.27 59.27-155.699 59.262-214.96 0-59.27-59.26-59.27-155.7 0-214.96l37.106-37.106c9.84-9.84 26.786-3.3 27.294 10.606.648 17.722 3.826 35.527 9.69 52.721 1.986 5.822.567 12.262-3.783 16.612l-13.087 13.087c-28.026 28.026-28.905 73.66-1.155 101.96 28.024 28.579 74.086 28.749 102.325.51l67.2-67.19c28.191-28.191 28.073-73.757 0-101.83-3.701-3.694-7.429-6.564-10.341-8.569a16.037 16.037 0 0 1-6.947-12.606c-.396-10.567 3.348-21.456 11.698-29.806l21.054-21.055c5.521-5.521 14.182-6.199 20.584-1.731a152.482 152.482 0 0 1 20.522 17.197zM467.547 44.449c-59.261-59.262-155.69-59.27-214.96 0l-67.2 67.2c-.12.12-.25.25-.36.37-58.566 58.892-59.387 154.781.36 214.59a152.454 152.454 0 0 0 20.521 17.196c6.402 4.468 15.064 3.789 20.584-1.731l21.054-21.055c8.35-8.35 12.094-19.239 11.698-29.806a16.037 16.037 0 0 0-6.947-12.606c-2.912-2.005-6.64-4.875-10.341-8.569-28.073-28.073-28.191-73.639 0-101.83l67.2-67.19c28.239-28.239 74.3-28.069 102.325.51 27.75 28.