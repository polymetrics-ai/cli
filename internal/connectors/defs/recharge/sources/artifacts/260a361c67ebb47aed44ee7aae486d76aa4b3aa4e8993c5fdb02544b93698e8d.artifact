    <span class="hljs-attr">&quot;total_price&quot;</span><span class="hljs-punctuation">:</span> <span class="hljs-string">&quot;31.00&quot;</span><span class="hljs-punctuation">,</span>
    <span class="hljs-attr">&quot;total_tax&quot;</span><span class="hljs-punctuation">:</span> <span class="hljs-string">&quot;0.00&quot;</span><span class="hljs-punctuation">,</span>
