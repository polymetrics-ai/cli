cumentation:[],properties:a}}}},request:"curl 'https:\u002F\u002Fapi.rechargeapps.com\u002Fsubscriptions\u002Fskip_gift' \\ \n -H 'X-Recharge-Version: 2021-11' \\ \n -H 'Content-Type: application\u002Fjson' \\ \n -H 'X-Recharge-Access-Token: your_api_token' \\ \n -d '{\"recipient_address\": {\n  \"address1\": \"1776 Washington Street\",\n  \"address2\": \"\",\n  \"city\": \"Los Angeles\",\n  \"company\": \"Recharge\",\n  \"country_code\": \"US\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n \"phone\": \"5551234567\",\n \"province\": \"California\",\n  \"zip\": \"90404\", \"email\": \"fake@example.com\" \n },\n\"purchase_item_ids\": [27363808, 27363809]}'",requiredProperties:{purchase_item_ids:b,recipient_address:b}},live:b},webhooks_endpoints:{title:ES,group_anchor:iE,anchor:em,section_anchor:em,subsection_anchors:[uV,xM,uW,uX,uY,uZ,u_,u$],path:ET,display_on_load:c,section_type:ah,order:131,version:k,data:{section_type:ah,description:"Webhooks are a mechanism for reacting to specific events that are triggered in the Recharge system. \u003Cbr\u003EFor example, a checkout completion, a customer activation or subscription cancellation. Webhooks will deliver you the data of the specific event in real-time. This data can be used to custom code logic behind automated subscription management, dashboards creation, discounts applying... \u003Cbr\u003E\u003Cbr\u003E When a webhook is triggered, the payload will be identical to the payload you would receive from another API endpoint.\u003Cbr\u003E\u003Cbr\u003EFor example, a webhook on subscription\u002Fcreated will be identical to the payload for retrieving a subscription by ID from the Recharge API.\u003Cbr\u003E\u003Cbr\u003EThere are a lot of things that can be done via Webhooks: It can be used to collect all kinds of data from our API and then create a custom Dashboard to show how much and when your customers are buying in real time, or use all this data to do Analytics of some kind in order to create a better customer experience. Webhooks can be used as a “Trigger” on your backend to update subscription products.\u003Cbr\u003E\u003Cbr\u003EIf you have some kind of a Subscription where you want to change the Product that the customer gets every month, you can do it by waiting for an order\u002Fcreated webhook on your backend, and when it fires you can make an API call to change the Product of that subscription or the next shipping date, etc. \u003Cbr\u003E\u003Cbr\u003E \u003Ch2\u003ERetries \u002F Idempotency\u003C\u002Fh2\u003E\u003Cbr\u003EDue to webhook retries, it’s possible that your application receives the same webhook more than once. Ensure idempotency of the webhook call by detecting such duplicates within your application. \u003Cbr\u003E\u003Cbr\u003E\u003Cbr\u003E \u003Ch2\u003ERespond to a webhook\u003C\u002Fh2\u003E \u003Cbr\u003E\u003Cbr\u003E Your webhook acknowledges that it received data by sending a `200` OK response. Any response outside of the `200` range will let Recharge know that you didn’t receive your webhook. Recharge has implemented a 5 second time-out period. We wait 5 seconds, if our system doesn’t get a response in that period we consider that request as failed. Our system will try 20 times to send the same webhook over the next 2 days, if the request fails every time our system will delete this webhook. At this moment our system is logging those deleted webhooks.",section_tag:iE,subsection_summaries:[{anchor:uV,curl_definition:a},{anchor:uW,curl_definition:Ld},{anchor:uX,curl_definition:Le},{anchor:uY,curl_definition:Lf},{anchor:uZ,curl_definition:Lg},{anchor:u_,curl_definition:Lh},{anchor:u$,curl_definition:Li}]},live:b},webhooks_object:{title:EU,group_anchor:iE,anchor:uV,section_anchor:em,subsection_anchors:a,path:EV,display_on_load:c,section_type:cG,doc_object:"webhook",order:132,version:k,data:{description:"Please note that the store domain header has changed to X-Recharge-External-Platform-Domain",specs:{id:{description:sG,name:l,type:f,common:b,less_common:c,error_related:c,tags:[],enum:[],notes:d,live:b,extendable:a,deprecated:a,allowEmptyValue:a,format:a,validate:a,example:a,documentation:[],properties:a},address:{description:qf,name:eM,type:e,common:b,less_common:c,error_related:c,tags:[],enum:[],notes:d,live:b,extendable:a,deprecated:a,allowEmptyValue:a,format:a,validate:a,example:a,documentation:[],properties:a},included_objects:{description:mJ,name:mK,type:j,common:b,less_common:c,error_related:c,tags:[],enum:[dp,dc,aH,el],notes:d,live:b,extendable:a,deprecated:a,allowEmptyValue:a,format:a,validate:a,example:a,documentation:[],properties:a},topic:{description:mL,name:mM,type:e,common:b,less_common:c,error_related:c,tags:[],enum:[],notes:d,live:b,extendable:a,deprecated:a,allowEmptyValue:a,format:a,validate:a,example:a,documentation:[],properties:a},version:{description:qg,name:f$,type:e,common:b,less_common:c,error_related:c,tags:[],enum:[],notes:d,live:b,extendable:a,deprecated:a,allowEmptyValue:a,format:a,validate:a,example:a,documentation:[],properties:a}},tags:[],live:b,notes:"These topics are deprecated, however they will not be removed from this API version: `checkout\u002Fcompleted`.",documentation:[{display_name:zc,url:zd}],example:{webhook:{id:Lj,address:qh,included_objects:[],topic:sH,version:k}}},live:b},webhooks_available:{title:EW,group_anchor:iE,anchor:xM,section_anchor:em,content_anchor:"webhooks_available_202111",subsection_anchors:a,path:EX,display_on_load:c,section_type:hN,order:133,version:k,live:b},webhooks_create:{title:EY,group_anchor:em,anchor:uW,section_anchor:em,subsection_anchors:a,path:EZ,display_on_load:c,section_type:r,order:134,version:k,data:{curl_definition:Ld,description:"Create a webhook. Currently, only the API can be used to create a webhook.\u003Cbr\u003E\u003Cbr\u003ETo register a webhook endpoint for a specific object, you will need to have read permissions for that object on your Recharge API token. For example, if you want to register a webhook for subscription\u002Fcreated, you will need the `read_subscriptions` permissions.\u003Cbr\u003E\u003Cbr\u003EEach API token can register a maximum of 10 webhooks of the same topic.\u003Cbr\u003E\u003Cbr\u003ERelated guides: \u003Ca href=\"https:\u002F\u002Fdocs.rechargepayments.com\u002Fdocs\u002Fwebhook-payload-examples\" targe=\"_blank\"\u003EWebhook payload examples\u003C\u002Fa\u003E",scopes:[],tags:[],live:b,notes:d,documentation:[{display_name:zc,url:zd}],parameters:{},body_parameters:{address:{description:qf,name:eM,type:f,common:b,less_common:c,error_related:c,tags:[],enum:[],notes:d,live:b,extendable:a,deprecated:a,allowEmptyValue:a,format:a,validate:a,example:a,documentation:[],properties:a},included_objects:{description:mJ,name:mK,type:j,common:b,less_common:c,error_related:c,tags:[],enum:[dp,dc,aH,el],notes:d,live:b,extendable:a,deprecated:a,allowEmptyValue:a,format:a,validate:a,example:a,documentation:[],properties:a},topic:{description:mL,name:mM,type:f,common:b,less_common:c,error_related:c,tags:[],enum:[],notes:d,live:b,extendable:a,deprecated:a,allowEmptyValue:a,format:a,validate:a,example:a,documentation:[],properties:a},version:{description:qg,name:f$,type:e,common:b,less_common:c,error_related:c,tags:[],enum:[],notes:d,live:b,extendable:a,deprecated:a,allowEmptyValue:a,format:a,validate:a,example:a,documentation:[],properties:a}},responses:{"200":{error_code:y,description:x,json_example:{webhook:{id:gD,address:qh,topic:sH,included_objects:[],version:k}},is_response:b,live:b,properties:{id:{description:sG,name:l,type:f,common:b,less_common:c,error_related:c,tags:[],enum:[],notes:d,live:b,extendable:a,deprecated:a,allowEmptyValue:a,format:a,validate:a,example:a,documentation:[],properties:a},address:{description:qf,name:eM,type:e,common:b,less_common:c,error_related:c,tags:[],enum:[],notes:d,live:b,extendable:a,deprecated:a,allowEmptyValue:a,format:a,validate:a,example:a,documentation:[],properties:a},included_objects:{description:mJ,name:mK,type:j,common:b,less_common:c,error_related:c,tags:[],enum:[dp,dc,aH,el],notes:d,live:b,extendable:a,deprecated:a,allowEmptyValue:a,format:a,validate:a,example:a,documentation:[],properties:a},topic:{description:mL,name:mM,type:e,common:b,less_common:c,error_related:c,tags:[],enum:[],notes:d,live:b,extendable:a,deprecated:a,allowEmptyValue:a,format:a,validate:a,example:a,documentation:[],properties:a},version:{description:qg,name:f$,type:e,common:b,less_common:c,error_related:c,tags:[],enum:[],notes:d,live:b,extendable:a,deprecated:a,allowEmptyValue:a,format:a,validate:a,example:a,documentation:[],properties:a}}}},request:"curl -i -H 'X-Recharge-Version: 2021-11' \\ \n -H 'X-Recharge-Access-Token: your_api_token' \\ \n -H 'Content-Type: application\u002Fjson' \\ \n -H 'Accept: application\u002Fjson' \\ \n -X POST 'https:\u002F\u002Fapi.rechargeapps.com\u002Fwebhooks' \\ \n --data '{\"address\": \"https:\u002F\u002Frequest.in\u002Ffoo\", \"topic\": \"subscription\u002Fcreated\", \"version\": \"2021-11\"}'",requiredProperties:{address:b,topic:b}},live:b},webhooks_retrieve:{title:E_,group_anchor:em,anchor:uX,section_anchor:em,subsection_anchors:a,path:E$,display_on_load:c,section_type:r,order:135,version:k,data:{curl_definition:Le,description:"Retrieve a webhook using the Recharge webhook id.",scopes:[],tags:[],live:b,notes:d,documentation:[],parameters:{},body_parameters:{},responses:{"200":{error_code:y,description:x,json_example:{webhook:{id:gD,address:qh,topic:sH,included_objects:[],version:k}},is_response:b,live:b,properties:{id:{description:sG,name:l,type:f,common:b,less_common:c,error_related:c,tags:[],enum:[],notes:d,live:b,extendable:a,deprecated:a,allowEmptyValue:a,format:a,validate:a,example:a,documentation:[],properties:a},address:{description:qf,name:eM,type:e,common:b,less_common:c,error_related:c,tags:[],enum:[],notes:d,live:b,extendable:a,deprecated:a,allowEmptyValue:a,format:a,validate:a,example:a,documentation:[],properties:a},included_objects:{description:m