</div> <!----> <!----> <!----> <!----> <!----> <!----></div> <div class="lg:w-1/3" data-v-7c527c32><div class="sticky mt-5 lg:mt-16 top-5 lg:top-24" data-v-7c527c32><div data-v-7c527c32><div class="flex mb-3 justify-center" data-v-e5c496f2><div class="flex flex-col w-full bg-example-request-bg rounded-lg shadow-keyline max-w-screen-sm" data-v-e5c496f2><div class="flex bg-example-request-topbar-bg rounded-t-lg p-1" data-v-e5c496f2><div class="flex items-center text-example-request-topbar-color text-sm uppercase p-2 overflow-hidden font-extralight flex-grow" data-v-e5c496f2>Endpoints</div> <!----> <!----></div> <div class="__vuescroll" style="height:100%;width:100%;padding:0;position:relative;overflow:hidden;" data-v-e5c496f2><div class="__panel __hidebar" style="position:relative;box-sizing:border-box;height:100%;overflow-y:hidden;overflow-x:hidden;transform-origin:;transform:;"><div class="__view" style="position:relative;box-sizing:border-box;min-width:100%;min-height:100%;"><div class="rounded-b-lg pt-3 pb-2 code-block" data-v-e5c496f2><div class="p-3 font-extralight" data-v-e5c496f2> <div><!----></div><div><div class="flex mb-1 pl-5 cursor-pointer"><div class="mr-2 w-14 text-right text-verbGet">
  GET
</div> <div class="text-smoke">
                /accounts/{id}
              </div></div></div><div><div class="flex mb-1 pl-5 cursor-pointer"><div class="mr-2 w-14 text-right text-verbGet">
  GET
</div> <div class="text-smoke">
                /accounts
              </div></div></div></div></div></div></div></div></div></div></div> <!----> <!----></div></div></div> <div section="[object Object]" class="flex h-7 justify-center -top-5 relative" data-v-7c527c32><div class="flex items-center bg-background py-1 px-3 cursor-pointer shadow-sm rounded-3xl text-links text-xs" data-v-7c527c32><div class="flex items-center" data-v-7c527c32><span class="uppercase mr-1" data-v-7c527c32>Expand</span> <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" data-v-187ac308><path d="M8.13676 8.59003L12.4118 12.953L16.6868 8.59003L18 9.9332L12.4118 15.6489L6.82353 9.9332L8.13676 8.59003Z" class="chevron" data-v-187ac308></path></svg></div></div></div> <div class="divider" data-v-7c527c32></div></div></div> <section class="w-full" data-v-0edaa383><div id="account_object" class="api-section w-full" style="display:none;" data-v-0edaa383><!----> <div class="w-full" data-v-7c527c32><div class="p-5 md:p-10 lg:flex lg:p-10 xl:p-8 xl:pt-20 lg:w-full" data-v-7c527c32><div class="api-section-left-side lg:pr-10 lg:w-2/3 overflow-x-hidden" data-v-7c527c32><div class="py-2" data-v-7c527c32><div class="flex items-center cursor-pointer relative" data-v-7c527c32><svg aria-hidden="true" focusable="false" data-prefix="fas" data-icon="link" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" name="account_object" class="text-gray-400 anchor-icon svg-inline--fa fa-link fa-w-16" style="display:none;" data-v-7c527c32 data-v-7c527c32><path fill="currentColor" d="M326.612 185.391c59.747 59.809 58.927 155.698.36 214.59-.11.12-.24.25-.36.37l-67.2 67.2c-59.27 59.27-155.699 59.262-214.96 0-59.27-59.26-59.27-155.7 0-214.96l37.106-37.106c9.84-9.84 26.786-3.3 27.294 10.606.648 17.722 3.826 35.527 9.69 52.721 1.986 5.822.567 12.262-3.783 16.612l-13.087 13.087c-28.026 28.026-28.905 73.66-1.155 101.96 28.024 28.579 74.086 28.749 102.325.51l67.2-67.19c28.191-28.191 28.073-73.757 0-101.83-3.701-3.694-7.429-6.564-