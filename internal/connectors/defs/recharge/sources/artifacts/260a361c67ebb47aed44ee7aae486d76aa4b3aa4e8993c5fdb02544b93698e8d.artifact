  POST
</div> <div class="text-smoke text-xs normal-case font-extralight font-mono leading-5" data-v-e5c496f2>
                /webhooks/{id}/test
              </div></div></div> <div class="flex mr-2" data-v-e5c496f2><div class="flex items-center pr-2" data-v-e5c496f2><label data-v-e5c496f2><select value="curl" class="cursor-pointer appearance-none text-xs bg-transparent" data-v-e5c496f2><option value="curl" data-v-e5c496f2>cURL</option> <option value="python" data-v-e5c496f2>Python</option> <option value="php" data-v-e5c496f2>PHP</option> <option value="ruby" data-v-e5c496f2>Ruby</option></select></label></div> <!----></div> <div class="flex mr-2" data-v-e5c496f2><button id="clipboardCopy" data-v-e5c496f2><svg aria-hidden="true" focusable="false" data-prefix="fas" data-icon="copy" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" class="text-gray-400 svg-inline--fa fa-copy fa-w-14" data-v-e5c496f2 data-v-e5c496f2><path fill="currentColor" d="M320 448v40c0 13.255-10.745 24-24 24H24c-13.255 0-24-10.745-24-24V120c0-13.255 10.745-24 24-24h72v296c0 30.879 25.121 56 56 56h168zm0-344V0H152c-13.255 0-24 10.745-24 24v368c0 13.255 10.745 24 24 24h272c13.255 0 24-10.745 24-24V128H344c-13.2 0-24-10.8-24-24zm120.971-31.029L375.029 7.029A24 24 0 0 0 358.059 0H352v96h96v-6.059a24 24 0 0 0-7.029-16.97z" data-v-e5c496f2 data-v-e5c496f2></path></svg></button></div></div> <div class="__vuescroll" style="height:100%;width:100%;padding:0;position:relative;overflow:hidden;" data-v-e5c496f2><div class="__panel __hidebar" style="position:relative;box-sizing:border-box;height:100%;overflow-y:hidden;overflow-x:hidden;transform-origin:;transform:;"><div class="__view" style="position:relative;box-sizing:border-box;min-width:100%;min-height:100%;"><div class="rounded-b-lg pt-3 pb-2 code-block" data-v-e5c496f2><div class="p-3 font-extralight" data-v-e5c496f2> <pre><code class="hljs js">curl -i -H <span class="hljs-string">&#x27;X-Recharge-Version: 2021-11&#x27;</span> \ 
 -H <span class="hljs-string">&#x27;X-Recharge-Access-Token: your_api_token&#x27;</span> \ 
 -H <span class="hljs-string">&#x27;Content-Type: application/json&#x27;</span> \ 
