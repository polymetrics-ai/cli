ead_body\n"},live:b},versioning:{title:zQ,group_title:jY,group_anchor:jZ,anchor:xr,section_anchor:xr,subsection_anchors:[],path:zR,display_on_load:b,section_type:hN,order:hO,version:k,live:b},responses:{title:zS,group_title:jY,group_anchor:jZ,anchor:xs,section_anchor:xs,subsection_anchors:[],path:zT,display_on_load:b,section_type:hN,order:F_,version:k,live:b},extending_responses:{title:zU,group_title:jY,group_anchor:jZ,anchor:xt,section_anchor:xt,content_anchor:"extending_responses_202111",subsection_anchors:[],path:zV,display_on_load:b,section_type:hN,order:qB,version:k,live:b},cursor_pagination:{title:zW,group_title:jY,group_anchor:jZ,anchor:xu,section_anchor:xu,content_anchor:"cursor_pagination_202111",subsection_anchors:[],path:zX,display_on_load:b,section_type:hN,order:gD,version:k,codeSamples:{curl:"URL=\"https:\u002F\u002Fapi.rechargeapps.com\u002Fcharges?limit=5\"\n\nresponse=$(curl -s -w \"%{http_code}\"\\ \n    -H 'X-Recharge-Access-Token: your_api_token' \\ \n    -H 'X-Recharge-Version: 2021-11' \\    -X GET $URL)\n\ncontent=$(sed '$ d' \u003C\u003C\u003C \"$response\") # get all but the last line which contains the status code\n\n# Display results\necho $content | jq \".\"\n\n# parse next url\necho \"Next URL\"\nnext_cursor=$(jq \".next_cursor\" \u003C\u003C\u003C \"${content}\")\n\n# Notice next_cursor value is passed as page_info query param\necho \"$URL&page_info=$next_cursor\"",python:"import json\nimport requests\nimport time\nfrom pprint import pprint\n\n# Set the amount of records per request to receive\nlimit = 5\nbase_url = f\"https:\u002F\u002Fapi.rechargeapps.com\u002Fcharges?limit={limit}\"headers = {    \"X-Recharge-Access-Token\": \"your_api_token\",\n    \"X-Recharge-Version\": \"2021-11\",\n    \"Accept\": \"application\u002Fjson\",\n}\n\n# Note that the value of next_cursor is passed as a page_info query param\ndef get_next_url(response_data):\n    next_url = None\n    if response_data.get('next_cursor') is not None:\n        next_cursor = response_data['next_cursor']\n        next_url = f\"{base_url}&page_info={next_cursor}\"\n    return next_url\n\nall_records = []\nurl = base_url\nwhile len(all_records) \u003C 20:\n    # Get the data for this page\n    result = requests.get(url, headers=headers)\n    data = json.loads(result.text)\n\n    # Add the results to our result set\n    for charge in data.get('charges', []):\n        all_records.append(charge)\n\n    if not data.get('next_cursor'):\n        # Do not loop again, no more records available\n        break\n    else:\n        # Update the URL for the next page\n        url = get_next_url(data)\n        if not url:\n            # no next url\n            break\n\n        # Sleep to avoid hitting rate limits\n        time.sleep(1)\n\npprint(all_records)",php:"\u003C?php\n\n\u002F\u002F set the amount of records per request to receive\n$limit = 5;\n$opts = [\"http\" =\u003E [\n        \"method\" =\u003E \"GET\",\n        \"header\" =\u003E \"X-Recharge-Access-Token: your_api_token\\r\\n\" .\n                    \"Accept: application\u002Fjson\\r\\n\" .\n\"X-Recharge-Version: 2021-11\\r\\n\"\n     ]\n];\n\n$base_url = \"https:\u002F\u002Fapi.rechargeapps.com\u002Fcharges?limit={$limit}\";\n\u002F\u002F Note that the next_cursor value is passed in as a page_info query param\nfunction get_next_url($response_data, $base_url) {\n    $next_url = \"\";\n    if (!empty($response_data['next_cursor'])) {\n         $next_cursor = $response_data['next_cursor'];\n         $next_url = \"{$base_url}&page_info={$next_cursor}\";\n    }\n    return $next_url;\n}\n$context = stream_context_create($opts);\n$url = $base_url;\n$all_records = [];\n\nwhile(count($all_records) \u003C 20) {\n    \u002F\u002F get the results for the page\n    $result = file_get_contents($url, FALSE, $context);\n    $data = json_decode($result, TRUE);\n    foreach ($data['charges'] as $key =\u003E $value) {\n        $all_records[] = $value;\n    }\n\n    echo(\"Next cursor {$data['next_cursor']}\\n\");\n    if (empty($data['next_cursor'])) {\n         \u002F\u002F stop looping, there are no more records\n         break;\n    } else {\n         \u002F\u002F udpate the url for the next page\n         $url = get_next_url($data, $base_url);\n         if (empty($url)) {\n            \u002F\u002F there is no next url\n            break;\n         }\n\n         \u002F\u002F sleep to avoid hitting rate limits\n         sleep(1);\n    }\n}\n\n$json_string = json_encode($all_records, JSON_PRETTY_PRINT);\nprint_r($json_string)\n\n\n",ruby:"#!\u002Fusr\u002Fbin\u002Fenv ruby\nrequire \"Faraday\"\nrequire \"json\"\n# Set the amount of records per request to receive\nlimit = 5\nbase_url = \"https:\u002F\u002Fapi.rechargeapps.com\u002Fcharges?limit=#{limit}\"\nputs base_url\nheaders = {   \"X-Recharge-Access-Token\" =\u003E \"your_api_token\",\n   \"Accept\" =\u003E \"application\u002Fjson\",\n   \"X-Recharge-Version\" =\u003E \"2021-11\"\n}\n\n# Note that the value of next_cursor is passed in a page_info query param\ndef get_next_url(response_data, base_url)\n  next_url = '' \n  if response_data['next_cursor']\n    cursor = response_data['next_cursor']\n    next_url = \"#{base_url}&page_info=#{cursor}\"\n  end\n  \n\nurl = base_url\nall_records = []\n\nwhile all_records.size \u003C 20\n  # Get the data for this page\n  response = Faraday.get(url, {}, headers)\n\n  data = JSON.parse(response.body)\n\n   # Add the results to our result set\ndata['charges'].each do |charge|\n    all_records \u003C\u003C charge\n  end\n\n  if not data['next_cursor']\n    # Do not loop again, we've read all records\n    break\n  lse\n    # update the url for the next page\n    url = get_next_url(data, base_url)\n    if url.size == 0\n      # No next url\n      breakd\n    end\n\n    # Sleep to avoid hitting rate limits\n    sleep(1)\n  end\nend\n\nputs all_records\n"},live:b},sorting:{title:zY,group_title:jY,group_anchor:jZ,anchor:xv,section_anchor:xv,content_anchor:"sorting_202111",su