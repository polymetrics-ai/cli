{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hubplanner Connection Specification",
  "type": "object",
  "required": [
    "api_key"
  ],
  "properties": {
    "api_key": {
      "type": "string",
      "description": "Hubplanner API key passed in the Authorization header.",
      "x-secret": true
    },
    "base_url": {
      "type": "string",
      "format": "uri",
      "default": "https://api.hubplanner.com/v1",
      "description": "Hubplanner API base URL."
    }
  }
}
