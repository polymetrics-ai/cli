</dd><dt>offer_id</dt><dd><code>integer</code>&nbsp;<span class="required">(required)</span>&nbsp;<p>Offer ID</p>
</dd><dt>offer_template_id</dt><dd><code>integer</code>&nbsp;<span class="required">(required)</span>&nbsp;<p>Offer template ID</p>
</dd><dt>placements_movements</dt><dd><code>array</code>&nbsp;<span>(optional)</span>&nbsp;<p>Array of objects, example: [
{
“source_stage_id”: 123,
“destination_stage_id”: 124
},
{
“source_stage_id”: 125,
“destination_stage_id”: 126
},
{
“source_stage_id”: 127,
“destination_stage_id”: 128
}
]</p>
</dd><dt>company_id</dt><dd><code>integer</code>&nbsp;<span class="required">(required)</span>&nbsp;<span class="text-muted example"><strong>Example:&nbsp;</strong><span>123</span></span><p>Company ID</p>
</dd></dl></div></div></div><hr class="split"><div class="middle"><section id="offertemplate.web.offertemplate" class="resource-group"><h2 class="group-heading">OfferTemplate.Web.OfferTemplate <a href="#offertemplate.web.offertemplate" class="permalink">&para;</a></h2></section></div><div class="middle"><div id="offertemplate.web.offertemplate-offertemplate.web.offertemplate" class="resource"><h3 class="resource-heading">OfferTemplate.Web.OfferTemplate <a href="#offertemplate.web.offertemplate-offertemplate.web.offertemplate" class="permalink">&para;</a></h3></div></div><div class="right"><div class="definition"><span class="method post">POST</span>&nbsp;<span class="uri"><span class="hostname">https://api.recruitee.com</span>/c/<span class="hljs-attribute" title="company_id">123</span>/offer_templates</span></div><div class="tabs"><div class="example-names"><span>Requests</span><span class="tab-button">json</span></div><div class="tab"><div><div class="inner"><h5>Headers</h5><pre><code><span class="hljs-attribute">Content-Type</span>: <span class="hljs-string">application/json</span></code></pre><div style="height: 1px;"></div><h5>Body</h5><pre><code>{
