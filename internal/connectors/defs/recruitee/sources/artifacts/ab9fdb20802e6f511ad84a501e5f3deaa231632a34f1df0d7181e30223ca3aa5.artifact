</dd><dt>message</dt><dd><code>string</code>&nbsp;<span>(optional)</span>&nbsp;<p>Message to be sent to candidate after e-mail deleteion</p>
</dd><dt>notify_candidate</dt><dd><code>boolean</code>&nbsp;<span>(optional)</span>&nbsp;<p>Notify candidate</p>
</dd><dt>company_id</dt><dd><code>integer</code>&nbsp;<span class="required">(required)</span>&nbsp;<span class="text-muted example"><strong>Example:&nbsp;</strong><span>123</span></span><p>Company ID</p>
