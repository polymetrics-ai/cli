</dd></dl></div></div></div><hr class="split"><div class="middle"><section id="gdpr.web.configuration" class="resource-group"><h2 class="group-heading">GDPR.Web.Configuration <a href="#gdpr.web.configuration" class="permalink">&para;</a></h2></section></div><div class="middle"><div id="gdpr.web.configuration-gdpr.web.configuration" class="resource"><h3 class="resource-heading">GDPR.Web.Configuration <a href="#gdpr.web.configuration-gdpr.web.configuration" class="permalink">&para;</a></h3></div></div><div class="right"><div class="definition"><span class="method patch">PATCH</span>&nbsp;<span class="uri"><span class="hostname">https://api.recruitee.com</span>/c/<span class="hljs-attribute" title="company_id">123</span>/gdpr/configuration</span></div><div class="tabs"><div class="example-names"><span>Requests</span><span class="tab-button">json</span></div><div class="tab"><div><div class="inner"><h5>Headers</h5><pre><code><span class="hljs-attribute">Content-Type</span>: <span class="hljs-string">application/json</span></code></pre><div style="height: 1px;"></div><h5>Body</h5><pre><code>{
  "<span class="hljs-attribute">auto_consent</span>": <span class="hljs-value">{
    "<span class="hljs-attribute">email_subject</span>": <span class="hljs-value"><span class="hljs-string">"GDPR Consent"</span>
  </span>}</span>,
  "<span class="hljs-attribute">auto_delete</span>": <span class="hljs-value">{
    "<span class="hljs-attribute">enabled</span>": <span class="hljs-value"><span class="hljs-literal">true</span>
  </span>}</span>,
  "<span class="hljs-attribute">consent_privacy_link</span>": <span class="hljs-value"><span class="hljs-string">"http://example.com/privacy"</span></span>,
