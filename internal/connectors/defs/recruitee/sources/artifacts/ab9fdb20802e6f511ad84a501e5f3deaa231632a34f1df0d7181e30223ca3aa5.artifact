</dd></dl></div></div></div><hr class="split"><div class="middle"><div id="candidate.web.candidate-candidate.web.candidate-3" class="resource"><h3 class="resource-heading">Candidate.Web.Candidate <a href="#candidate.web.candidate-candidate.web.candidate-3" class="permalink">&para;</a></h3></div></div><div class="right"><div class="definition"><span class="method patch">PATCH</span>&nbsp;<span class="uri"><span class="hostname">https://api.recruitee.com</span>/c/<span class="hljs-attribute" title="company_id">123</span>/candidates/<span class="hljs-attribute" title="id">id</span></span></div><div class="tabs"><div class="example-names"><span>Requests</span><span class="tab-button">json</span></div><div class="tab"><div><div class="inner"><h5>Headers</h5><pre><code><span class="hljs-attribute">Content-Type</span>: <span class="hljs-string">application/json</span></code></pre><div style="height: 1px;"></div><h5>Body</h5><pre><code>{
  "<span class="hljs-attribute">candidate</span>": <span class="hljs-value">{
    "<span class="hljs-attribute">emails</span>": <span class="hljs-value">[
      <span class="hljs-string">"  jw@example.com  "</span>,
