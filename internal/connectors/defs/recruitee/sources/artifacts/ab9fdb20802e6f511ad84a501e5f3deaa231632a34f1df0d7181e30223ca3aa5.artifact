</dd></dl></div></div></div><hr class="split"><div class="middle"><div id="pipeline.web.placement-pipeline.web.placement-8" class="resource"><h3 class="resource-heading">Pipeline.Web.Placement <a href="#pipeline.web.placement-pipeline.web.placement-8" class="permalink">&para;</a></h3></div></div><div class="right"><div class="definition"><span class="method patch">PATCH</span>&nbsp;<span class="uri"><span class="hostname">https://api.recruitee.com</span>/c/<span class="hljs-attribute" title="company_id">123</span>/placements/<span class="hljs-attribute" title="id">id</span>/hiring_details</span></div><div class="tabs"><div class="example-names"><span>Requests</span><span class="tab-button">json</span></div><div class="tab"><div><div class="inner"><h5>Headers</h5><pre><code><span class="hljs-attribute">Content-Type</span>: <span class="hljs-string">application/json</span></code></pre><div style="height: 1px;"></div><h5>Body</h5><pre><code>{
  "<span class="hljs-attribute">placement</span>": <span class="hljs-value">{
    "<span class="hljs-attribute">hired_at</span>": <span class="hljs-value"><span class="hljs-string">"2022-08-01T00:00:00.000000Z"</span></span>,
