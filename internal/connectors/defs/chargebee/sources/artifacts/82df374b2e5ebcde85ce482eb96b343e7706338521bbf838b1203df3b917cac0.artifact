          "schema" : {
            "type" : "object",
            "deprecated" : false,
            "description" : "The reason for issuing this Credit Note. The following reason codes are supported now[Deprecated; use the <a href=\"/docs/api/credit_notes#credit_note_create_reason_code\">create_reason_code</a> parameter instead]",
            "example" : "waiver",
            "x-cb-parameter-blank-option" : "as_null",
