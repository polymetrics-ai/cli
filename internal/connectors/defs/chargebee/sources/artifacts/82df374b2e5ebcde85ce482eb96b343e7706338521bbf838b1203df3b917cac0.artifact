                            "type" : "string",
                            "description" : "* `in_progress` - Dunning is still in progress.\n* `exhausted` - Maximum number of attempts have been made.\n* `stopped` - Dunning has stopped for this invoice.\n* `success` - Payment successfully collected during dunning process.",
                            "enum" : [ "in_progress", "exhausted", "stopped", "success" ],
                            "x-cb-is-external-enum" : false,
                            "x-cb-is-api-column" : true,
                            "x-cb-is-gen-separate" : false,
                            "x-cb-sdk-enum-api-name" : "DunningStatus",
                            "example" : null
