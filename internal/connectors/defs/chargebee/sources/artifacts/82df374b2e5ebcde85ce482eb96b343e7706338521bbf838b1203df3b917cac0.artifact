                        "type" : "object",
                        "deprecated" : false,
                        "description" : "Gateway through which this transaction was done. Applicable only for 'Card' Payment Method",
                        "example" : "stripe",
                        "x-cb-parameter-blank-option" : "not_allowed",
                        "x-cb-attribute-meta-comment" : "optional",
                        "x-cb-is-sub-resource" : true,
                        "x-cb-is-filter-parameter" : true,
                        "x-cb-meta-model-name" : "transactions",
