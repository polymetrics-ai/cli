      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "archived": {
          "type": "boolean"
        },
        "personal_owner_id": {
          "type": "integer"
        },
        "location": {
          "type": "string"
        }
      },
      "x-primary-key": [
        "id"
      ]
    },
    "schemas/databases.json": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "databases",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "is_sample": {
          "type": "boolean"
        },
        "is_on_demand": {
          "type": "boolean"
        },
        "timezone": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
