{
  "schema_version": 4,
  "connector": "metabase",
  "lanes": {
    "binary_download": "unsupported",
    "binary_upload": "unsupported",
    "direct_read": "unsupported",
    "direct_write": "unsupported",
    "etl": "implemented",
    "reverse_etl": "unsupported",
    "sync_transport": "unsupported"
  },
  "provider_evidence": {
    "documentation": [
      {
        "role": "provider_reference",
        "url": "https://www.metabase.com/docs/latest/api-documentation"
      }
    ]
  },
  "metadata": {
    "name": "metabase",
    "display_name": "Metabase",
    "description": "Reads Metabase cards, dashboards, collections, databases, and users through the Metabase REST API using a declared session token.",
    "integration_type": "api",
    "release_stage": "alpha",
    "capabilities": {
      "check": true,
      "read": true,
      "write": false,
      "query": false,
      "cdc": false,
      "dynamic_schema": false
    },
    "risk": {
      "read": "external Metabase API reads through a declaration-bound tenant origin and session authentication",
      "write": "unsupported",
      "approval": "none; read-only"
    },
    "docs_url": "https://www.metabase.com/docs/latest/api-documentation"
  },
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Metabase Connection Specification",
    "type": "object",
    "required": [
      "instance_api_url",
      "username"
    ],
    "properties": {
      "instance_api_url": {
        "type": "string",
        "description": "Required Metabase instance HTTPS origin, or declared loopback HTTP for local testing."
      },
      "password": {
        "type": "string",
        "x-secret": true,
        "description": "Metabase password used only for the fixed declared session exchange when session_token is absent."
      },
      "session_token": {
        "type": "string",
        "x-secret": true,
        "description": "Existing Metabase session token sent only as X-Metabase-Session."
      },
      "username": {
        "type": "string"
      }
    },
    "x-reject-unknown-config": true
  },
  "http": {
    "url": "https://unused.invalid",
    "user_agent": "polymetrics-go-cli",
    "auth": [
      {
        "mode": "api_key_header",
        "header": "X-Metabase-Session",
        "value": "{{ secrets.session_token }}",
        "when": "{{ secrets.session_token }}"
      },
      {
        "mode": "declared_session",
        "token_url": "https://unused.invalid/session",
        "username": "{{ config.username }}",
        "password": "{{ secrets.password }}"
      }
    ],
    "pagination": {
      "type": "none"
    },
    "check": {
      "method": "GET",
      "path": "/card"
    },
    "error_map": [],
    "tenant_origin": {
      "config_key": "instance_api_url",
      "append_path": "/api",
      "allow_loopback_http": true
    }
  },
  "schemas": {
    "schemas/cards.json": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "cards",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "collection_id": {
          "type": "integer"
        },
        "database_id": {
          "type": "integer"
        },
        "query_type": {
          "type": "string"
        },
        "display": {
          "type": "string"
        },
        "archived": {
          "type": "boolean"
        },
        "creator_id": {
          "type": "integer"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "x-primary-key": [
        "id"
      ]
    },
    "schemas/dashboards.json": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "dashboards",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "collection_id": {
          "type": "integer"
        },
        "archived": {
          "type": "boolean"
        },
        "creator_id": {
          "type": "integer"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "x-primary-key": [
        "id"
      ]
    },
    "schemas/collections.json": {
      "$schema": "http://json-schema.org/draft-07/schema#",
