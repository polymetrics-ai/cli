{
  "base": {
    "auth": [
      {
        "header": "X-Metabase-Session",
        "mode": "api_key_header",
        "value": "{{ secrets.session_token }}",
        "when": "{{ secrets.session_token }}"
      },
      {
        "mode": "declared_session",
        "password": "{{ secrets.password }}",
        "token_url": "https://unused.invalid/session",
        "username": "{{ config.username }}"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/card"
    },
    "error_map": [],
    "pagination": {
      "type": "none"
    },
    "tenant_origin": {
      "allow_loopback_http": true,
      "append_path": "/api",
      "config_key": "instance_api_url"
    },
    "url": "https://unused.invalid",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "method": "GET",
      "name": "cards",
      "path": "/card",
      "records": {
        "path": "."
      },
      "schema": "schemas/cards.json"
    },
    {
      "method": "GET",
      "name": "dashboards",
      "path": "/dashboard",
      "records": {
        "path": "."
      },
      "schema": "schemas/dashboards.json"
    },
    {
      "method": "GET",
      "name": "collections",
      "path": "/collection",
      "records": {
        "path": "."
      },
      "schema": "schemas/collections.json"
    },
    {
      "method": "GET",
      "name": "databases",
      "path": "/database",
      "records": {
        "path": "."
      },
      "schema": "schemas/databases.json"
    },
    {
      "method": "GET",
      "name": "users",
      "path": "/user",
      "records": {
        "path": "."
      },
      "schema": "schemas/users.json"
    }
  ]
}
