  "help_topics": [
    {
      "name": "safety",
      "summary": "Reverse ETL mutations require plan, preview, explicit approval, and execute; destructive actions require destructive confirmation."
    },
    {
      "name": "parity",
      "summary": "Operation ledger partitions all 197 Recurly v2021-02-25 OpenAPI operations once."
    }
  ]
