    {
      "path": "gift cards preview",
      "summary": "Preview gift card",
      "intent": "direct_read",
      "availability": "implemented",
      "operation": "preview_gift_card",
      "flags": [
        {
          "name": "product-code",
          "type": "string",
          "summary": "The product code or SKU of the gift card product.",
          "maps_to": "body.product_code"
        },
        {
          "name": "unit-amount",
          "type": "integer",
          "summary": "The whole-number gift card amount to preview; mapped to Recurly unit_amount.",
