  "commands": [
    {
      "path": "invoices preview",
      "summary": "Preview new invoice for pending line items",
      "intent": "direct_read",
      "availability": "implemented",
      "operation": "preview_invoice",
      "flags": [
        {
          "name": "account-id",
          "type": "string",
          "summary": "Path parameter `account_id`.",
          "maps_to": "path.account_id"
        },
        {
          "name": "currency",
          "type": "string",
          "summary": "3-letter ISO 4217 currency code.",
          "maps_to": "body.currency"
        }
      ],
      "source_url": "https://recurly.com/developers/api/v2021-02-25/#operation/preview_invoice",
      "output_policy": "json_redacted",
      "redact_fields": [
        "billing_info",
        "gateway_code",
        "number",
        "token"
      ],
      "api_surface": [
        {
          "method": "POST",
          "path": "/accounts/{account_id}/invoices/preview"
        }
      ],
      "notes": "Bounded Recurly read/preview operation; fixed method and path, typed request fields, and redacted JSON output.",
      "examples": [
        "pm recurly invoices preview --json"
      ]
    },
    {
      "path": "invoice pdf get",
      "summary": "Fetch an invoice as a PDF",
      "intent": "direct_read",
      "availability": "planned",
      "operation": "get_invoice_pdf",
      "source_url": "https://recurly.com/developers/api/v2021-02-25/#operation/get_invoice_pdf",
      "api_surface": [
        {
          "method": "GET",
          "path": "/invoices/{invoice_id}.pdf"
        }
      ],
      "notes": "Official binary/export endpoint recorded as bounded metadata; shared direct-read runtime does not execute binary transfers in this slice."
    },
