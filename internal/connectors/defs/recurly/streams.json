        "path": "data"
      },
      "computed_fields": {
        "id": "{{ record.id }}",
        "code": "{{ record.code }}",
        "email": "{{ record.email }}",
        "state": "{{ record.state }}",
        "created_at": "{{ record.created_at }}",
        "updated_at": "{{ record.updated_at }}"
