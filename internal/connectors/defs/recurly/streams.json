{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "auth": [
      {
        "mode": "basic",
        "username": "{{ secrets.api_key }}",
        "password": ""
      }
    ],
    "headers": {
      "Accept": "application/vnd.recurly.v2021-02-25"
    },
    "pagination": {
      "type": "link_header",
      "page_size": 200
    },
    "check": {
      "method": "GET",
      "path": "/accounts",
      "query": {
        "limit": "1"
      }
    },
    "error_map": [
      {
        "status": 401,
        "hint": "recurly api_key is missing or invalid; re-run pm credentials add recurly using a secret source"
      },
      {
        "status": 403,
        "hint": "recurly API key lacks access for this request"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "recurly rate limit exceeded; retry after the provider reset window"
      }
    ]
  },
  "streams": [
    {
      "name": "list_sites",
      "path": "/sites",
