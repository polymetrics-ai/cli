{
  "base": {
    "auth": [
      {
        "mode": "bearer",
        "token": "{{ secrets.api_key }}"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/v1/incidents",
      "query": {
        "page[size]": "1"
      }
    },
    "error_map": [],
    "pagination": {
      "max_pages": 100,
      "next_url_path": "links.next",
      "type": "next_url"
    },
    "url": "https://api.rootly.com",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "computed_fields": {
        "status": "{{ record.attributes.status }}",
        "title": "{{ record.attributes.title }}"
      },
      "method": "GET",
      "name": "incidents",
      "path": "/v1/incidents",
      "query": {
        "page[number]": "1",
        "page[size]": "100"
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/incidents.json"
    },
    {
      "computed_fields": {
        "status": "{{ record.attributes.status }}",
        "title": "{{ record.attributes.title }}"
      },
      "method": "GET",
      "name": "services",
      "path": "/v1/services",
      "query": {
        "page[number]": "1",
        "page[size]": "100"
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/services.json"
    },
    {
      "computed_fields": {
        "status": "{{ record.attributes.status }}",
        "title": "{{ record.attributes.title }}"
      },
      "method": "GET",
      "name": "users",
      "path": "/v1/users",
      "query": {
        "page[number]": "1",
        "page[size]": "100"
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/users.json"
    }
  ]
}
