{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "api_key": {
      "description": "Rootly API token.",
      "type": "string",
      "x-secret": true
    },
    "start_date": {
      "description": "Retained initial ETL lower-bound configuration.",
      "type": "string"
    }
  },
  "required": [
    "api_key",
    "start_date"
  ],
  "title": "Rootly Connection Specification",
  "type": "object",
  "x-reject-unknown-config": true
}
