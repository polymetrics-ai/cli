      "path": "/categories/list",
      "projection": "passthrough",
      "records": {
        "path": "categories"
      },
      "schema": "schemas/categories.json"
    },
    {
      "body": {
        "apiKey": "{{ secrets.api_key }}"
      },
      "body_type": "form",
      "incremental": {
        "client_filtered": true,
        "cursor_field": "created"
      },
      "method": "POST",
      "name": "companies",
      "path": "/companies/list",
      "projection": "passthrough",
      "records": {
        "path": "companies"
      },
      "schema": "schemas/companies.json"
    }
  ]
}
