{
  "base": {
    "auth": [
      {
        "mode": "none"
      }
    ],
    "check": {
      "body": {
        "apiKey": "{{ secrets.api_key }}"
      },
      "body_type": "form",
      "method": "POST",
      "path": "/boards/list"
    },
    "error_map": [],
    "pagination": {
      "limit_param": "limit",
      "max_pages": 100,
      "offset_param": "skip",
      "page_size": 100,
      "type": "offset_limit"
    },
    "url": "https://canny.io/api/v1",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "body": {
        "apiKey": "{{ secrets.api_key }}"
      },
      "body_type": "form",
      "incremental": {
        "client_filtered": true,
        "cursor_field": "created"
      },
      "method": "POST",
      "name": "boards",
      "path": "/boards/list",
      "projection": "passthrough",
      "records": {
        "path": "boards"
      },
      "schema": "schemas/boards.json"
    },
    {
      "body": {
        "apiKey": "{{ secrets.api_key }}"
      },
      "body_type": "form",
      "incremental": {
        "client_filtered": true,
        "cursor_field": "created"
      },
      "method": "POST",
      "name": "posts",
      "path": "/posts/list",
      "projection": "passthrough",
      "records": {
        "path": "posts"
      },
      "schema": "schemas/posts.json"
    },
    {
      "body": {
        "apiKey": "{{ secrets.api_key }}"
      },
      "body_type": "form",
      "incremental": {
        "client_filtered": true,
        "cursor_field": "created"
