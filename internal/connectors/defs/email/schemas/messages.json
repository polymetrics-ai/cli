{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "messages",
  "type": "object",
  "x-primary-key": ["mailbox", "uid_validity", "uid"],
  "x-cursor-field": "imap_cursor",
  "required": ["mailbox", "uid_validity", "uid", "imap_cursor"],
  "additionalProperties": true,
  "properties": {
    "mailbox": {"type": "string"},
    "uid_validity": {"type": "string"},
    "uid": {"type": "string"},
    "imap_cursor": {"type": "string"},
    "envelope": {"type": ["object", "null"]},
    "flags": {"type": "array", "items": {"type": "string"}},
    "internal_date": {"type": ["string", "null"]},
    "size": {"type": ["integer", "null"]},
    "body_parts": {"type": "array", "items": {"type": "object"}}
  }
}
