      "id": "gorgias.download_file",
      "kind": "binary_download",
      "summary": "Download a file",
      "description": "Official Gorgias file download. The provider responds 307 redirecting to signed, cross-host file storage, so this operation declares allow_cross_host; the download credential (Basic auth) is never forwarded across that redirect by the runtime.",
      "source_url": "https://developers.gorgias.com/reference/download-file",
      "risk": "medium",
      "approval": "none",
      "output_policy": "binary",
      "binary": {
        "method": "GET",
        "path": "/api/{file_type}/download/{domain_hash}/{resource_name}",
        "max_bytes": 104857600,
        "allow_cross_host": true
      }
    },
