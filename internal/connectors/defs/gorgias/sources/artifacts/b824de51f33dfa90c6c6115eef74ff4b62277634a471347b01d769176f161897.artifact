his view is shared with.","examples":[[1,2]],"title":"shared  with  teams","items":{"type":"integer"},"maxItems":100,"type":"array"},"shared_with_users":{"description":"IDs of users this view is shared with.","examples":[[1,2]],"title":"shared  with  users","items":{"type":"integer"},"maxItems":100,"type":"array"},"slug":{"description":"DEPRECATED - URL-compatible name of the view.","examples":["my-tickets"],"title":"slug","type":"string"},"type":{"description":"Type of objects the view is applied on.","enum":["ticket-list"],"examples":["ticket-list"],"$ref":"#/components/schemas/ViewType"},"visibility":{"description":"Visibility of the view.\n\nPossible values are:\n\n- `public`: any user of your helpdesk can see it.\n- `shared`: users listed under `shared_with_users` attribute and teams listed under `shared_with_teams` attribute can see it. All admins and lead agents will see it as well, even if they are not explicitly listed in the `shared_with_users` attribute.\n- `private`: only the single user listed under `shared_with_users` attribute can see it.\n","examples":["public"],"$ref":"#/components/schemas/ViewVisibility"}},"title":"view update","type":"object"},"ViewItemsListRespMeta":{"type":"object","properties":{"current_cursor":{"type":"string","description":"Value indicating your position in the list of all the view's items. ","example":"MTU5MzE2NDMwMDAwMDAwMC1mYWxzZQ=="},"next_items":{"type":"string","format":"url","description":"Link to the next items, if any.","example":"/api/views/10/items/?direction=next&ignored_item=1781&cursor=MTU5MzA5ODYyNDAwMDAwMC1mYWxzZQ%3D%3D"},"prev_items":{"type":"string","format":"url","description":"Link to the previous items, if any.","example":"/api/views/10/items/?direction=prev&cursor=MTU5MzEyMTk4MTAwMDAwMC1mYWxzZQ%3D%3D&ignored_item=1743"}}},"VoiceCall":{"type":"object","properties":{"id":{"type":"integer","readOnly":true,"description":"ID of the voice call.","example":123},"integration_id":{"type":"integer","readOnly":true,"description":"ID of the voice integration that managed the voice call.","example":234},"ticket_id":{"type":"integer","readOnly":true,"description":"ID of the ticket the voice call belongs to.","example":345},"phone_number_id":{"type":"integer","readOnly":true,"description":"ID of the phone number that received or performed the voice call.","example":456},"external_id":{"type":"string","readOnly":true,"description":"ID of the voice call on the provider side (Twilio, etc...).","example":"CA777a8b2bfef8cdf709896080fe94cd10"},"provider":{"type":"string","readOnly":true,"description":"The voice solutions provider handling the voice call. It provides the `external_id`.","example":"twilio"},"status":{"type":"string","enum":["answered","connected","in-progress","initiated","queued","ringing","ending","busy","canceled","completed","failed","no-answer","missed"],"readOnly":true,"description":"The current status of the voice call.","example":"completed"},"direction":{"type":"string","enum":["inbound","outbound"],"readOnly":true,"description":"Whether the voice call is received from a customer (inbound) or addressed to a customer (outbound).","example":"inbound"},"phone_number_source":{"type":"string","readOnly":true,"description":"The phone number performing the voice call.","example":"+14791234567"},"country_source":{"type":"string","readOnly":true,"description":"The country code of the phone number performing the voice call.","example":"US"},"phone_number_destination":{"type":"string","readOnly":true,"description":"The phone number receiving the voice call.","example":"+17201234567"},"country_destination":{"type":"string","readOnly":true,"description":"The country code of the phone number receiving the voice call.","example":"US"},"duration":{"type":"integer","readOnly":true,"description":"Duration in seconds of the voice call.","example":60,"x-unit":"seconds"},"started_datetime":{"type":"string","format":"date-time","readOnly":true,"description":"When the voice call started on the provider side.","example":"2023-08-31T00:00:00.000000+00:00"},"created_datetime":{"type":"string","format":"date-time","readOnly":true,"description":"When the voice call was created in Gorgias.","example":"2023-08-31T00:00:00.000000+00:00"},"updated_datetime":{"type":"string","format":"date-time","readOnly":true,"description":"When the voice call was last updated.","example":"2023-08-31T00:00:00.000000+00:00"},"initiated_by_agent_id":{"type":"integer","readOnly":true,"description":"The agent that initiated the voice call, only for outbound calls.","example":567},"last_answered_by_agent_id":{"type":"integer","readOnly":true,"description":"The last agent that answered the voice call.","example":678},"customer_id":{"type":"integer","readOnly":true,"description":"For inbound calls, the customer that initiated the voice call.For outbound calls, the customer that received the voice call.","example":789},"last_rang_agent_id":{"type":"integer","readOnly":true,"description":"The last agent that received the voice call.","example":235},"has_voicemail":{"type":"boolean","readOnly":true,"description":"Whether the voice call has a voicemail attached.","example":true},"has_call_recording":{"type":"boolean","readOnly":true,"description":"Whether the voice call has a call recording attached.","example":false},"summaries":{"type":"array","readOnly":true,"description":"Summaries generated of the recordings of the voice call.","items":{"type":"object","properties":{"id":{"type":"integer","readOnly":true,"description":"ID of the voice call.","example":123},"recording_id":{"type":"integer","readOnly":true,"description":"ID of the recording associated to the summary.","example":234},"summary":{"type":"string","readOnly":true,"description":"Summary of the voice call.","example":"Call from +14791234567"},"created_datetime":{"type":"string","format":"date-time","readOnly":true,"description":"When the summary was created.","example":"2023-08-31T00:00:00.000000+00:00"}},"required":["created_datetime","id","recording_id","summary"]}},"termination_status":{"type":"string","enum":["answered","cancelled","missed","abandoned","callback-requested"],"readOnly":true,"description":"The termination status of the voice call.","example":"abandoned"},"queue_id":{"type":"integer","readOnly":true,"description":"ID of the voice queue that managed the voice call.","example":142},"status_in_queue":{"type":"string","readOnly":true,"description":"Sub-status of the voice call when status is Queued","example":"waiting"},"answered_by_external_number":{"type":"string","readOnly":true,"description":"The external phone number that answered the voice call when forwarded externally.","example":"+14791234567"},"answered_by_external_customer_id":{"type":"integer","readOnly":true,"description":"The customer associated with the external number that answered the voice call.","example":250},"monitoring_status":{"type":["string","null"],"enum":["listening","whispering","none"],"readOnly":true,"description":"Which type of monitoring is being currently performed on the call, if any.","example":"listening"},"last_monitoring_agent_id":{"type":["integer","null"],"readOnly":true,"description":"The id of the last agent that was monitoring the call.","example":123}},"required":["created_datetime","direction","external_id","id","integration_id","provider","status"],"description":"A voice call represents a phone call received from a customer (inbound) or addressed to a customer (outbound)."},"VoiceCallRecording":{"type":"object","properties":{"id":{"type":"integer","readOnly":true,"description":"ID of the voicemail or call recording.","example":123},"call_id":{"type":"integer","readOnly":true,"description":"ID of the voice call the voicemail or call recording belongs to.","example":234},"external_id":{"type":"string","readOnly":true,"description":"ID of the voicemail or call recording on the provider side (Twilio, etc...).","example":"REe51e36db1c44458d8a173959d4affc71"},"url":{"type":"string","readOnly":true,"description":"Voicemail or call recording direct access URL.","example":"https://uploads.gorgias.io/GRO7iuEcV1WHfQvm/phone-REe51e36db1c44458d8a173959d4affc71-2fee010d-489b-473f-851c-b50eb3182b2e.mp3"},"duration":{"type":"integer","readOnly":true,"description":"Duration in seconds of the voicemail or call recording.","example":20,"x-unit":"seconds"},"type":{"type":"string","enum":["call-recording","voicemail"],"readOnly":true,"description":"Whether this is a voicemail or a call recording.","example":"voicemail"},"created_datetime":{"type":"string","format":"date-time","readOnly":true,"description":"When the voicemail or call recording was created.","example":"2023-08-31T00:00:00.000000+00:00"},"deleted_datetime":{"type":"string","format":"date-time","readOnly":true,"description":"When the voicemail or call recording was deleted, if deleted.","example":"2023-08-31T00:00:00.000000+00:00"},"deleted_by_user_id":{"type":"integer","readOnly":true,"description":"Which agent deleted the voicemail or call recording, if deleted."},"error_code":{"type":"string","nullable":true,"enum":["RECORDING_IS_PRIVATE"],"readOnly":true,"description":"Reason why the URL could not be provided.","example":"RECORDING_IS_PRIVATE"},"transcription_status":{"type":"string","enum":["requested","completed","failed","recording_too_short","recording_too_long",null,"low_quality_transcription"],"readOnly":true,"description":"The status of the transcription of the voicemail or call recording.","example":"completed"}},"description":"A voicemail left after a missed voice call, or a voice call recording."},"VoiceCallEvent":{"type":"object","properties":{"id":{"type":"integer","readOnly":true,"description":"ID of the event.","example":123},"type":{"type":"string","enum":["phone-call-answered","phone-call-ringing","phone-call-dial-failed","phone-call-agent-dialed","incoming-phone-call","outgoing-phone-call","completed-phone-call","call-recording","missed-phone-call","declined-phone-call","call-ending-triggered","voicemail-recording","phone-call-conversation-started","phone-call-forwarded-to-external-number","phone-call-forwarded-to-gorgias-number","phone-call-forwarded","message-played","outgoing-phone-call-connected","child-call-not_answered","phone-call-transfer-initiated","phone-call-transfer-failed","phone-call-enqueued","phone-call-enqueue-skipped","phone-call-dequeued","phone-call-wrap-up-started","phone-call-wrap-up-ended","ivr-menu-presented","ivr-option-selected","phone-call-deflected-to-sms","customer-field-conditional-evaluated","monitoring-started","monitoring-ended","monitoring-updated"],"readOnly":true,"description":"The voice call event type.","example":"completed-phone-call"},"account_id":{"type":"integer","readOnly":true,"description":"ID of the account the event belongs to.","example":234},"call_id":{"type":"integer","readOnly":true,"description":"ID of the call for which the event happened.","example":345},"user_id":{"type":"integer","readOnly":true,"description":"ID of the agent related to the event.","example":456},"customer_id":{"type":"integer","readOnly":true,"description":"ID of the customer related to the event.","example":567},"created_datetime":{"type":"string","format":"date-time","readOnly":true,"description":"When the event was created.","example":"2023-08-31T00:00:00.000000+00:00"},"meta":{"type":"object","readOnly":true,"description":"Data associated to the event.","example":"{}"}},"description":"An event related to a voice call."},"Widget":{"type":"object","properties":{"id":{"type":"integer","description":"ID of the widget.","example":123},"context":{"type":"string","default":"ticket","enum":["ticket","customer","user"],"description":"The context to display this widget in.\n\nSupported values are: `ticket`, `customer`, `user`.\n\nThe value <span style={{color: 'red'}}>`user` has been deprecated</span>,\n please use `customer` instead.","example":"ticket"},"created_datetime":{"type":"string","format":"date-time","description":"When the widget was created.","example":"2020-12-01T13:00:00.123456"},"deactivated_datetime":{"type":["string","null"],"format":"date-time","description":"When the widget was deactivated.","example":"2020-12-03T13:00:00.123456"},"integration_id":{"type":["integer","null"],"minimum":0,"description":"ID of the integration that the widget's data is attached to. Only used for widgets attached to HTTP integrations. Widgets are the same for all Shopify integrations, but each HTTP integration needs a specific widget."},"app_id":{"type":["string","null"],"description":"The ID of the 3rd party app that  the widget's data is attached to. Used for customer external data widgets.","example":"60b9f144096cf92533e0a14d"},"order":{"type":"integer","default":0,"minimum":0,"description":"Order of precedence of the widget. Widgets with lower order are shown first.","example":3},"template":{"type":"object","description":"Template to render the data of the widget.","example":{"type":"wrapper","widgets":[{"path":"account_info","type":"card","title":"account  info","widgets":[{"path":"account_id","type":"text","title":"account id"}]}]}},"type":{"type":"string","enum":["bigcommerce","custom","customer_external_data","http","magento2","recharge","shopify","smile","standalone","yotpo","klaviyo","stripe","woocommerce"],"description":"Type of data the widget is attached to.","example":"http"},"updated_datetime":{"type":"string","format":"date-time","description":"When the widget was updated.","example":"2020-12-02T13:00:00.123456"},"uri":{"type":"string","readOnly":true,"description":"URI of the widget."}},"description":"A widget is a container that can be used to display customized data coming from integrations at the right-hand sidebar of the [ticket](#the-ticket-object) or user page.\nIt contains a list of fields and values that come from integrations."}},"securitySchemes":{"basicAuth":{"type":"http","scheme":"basic","description":"The username will be the email address of your Gorgias account and the password will be your API key."}}}}