(implicit `one-of` operator).","items":{"type":"string"},"title":"values","type":"array"}},"required":["member","values"],"title":"metric card api filter","type":"object"},"MetricCardApiMapping":{"additionalProperties":false,"properties":{"scope":{"description":"The /stats discriminated-union scope variant for this metric.","title":"scope","type":"string"},"measures":{"description":"Measures to request on the scope.","items":{"type":"string"},"title":"measures","type":"array"},"dimensions":{"description":"Dimensions to request on the scope.","items":{"type":"string"},"title":"dimensions","type":"array"},"filters":{"description":"Filters the caller must include to disambiguate this metric.","items":{"$ref":"#/components/schemas/MetricCardApiFilter"},"title":"filters","type":"array"}},"required":["scope"],"title":"metric card api mapping","type":"object"},"MetricCardPublic":{"additionalProperties":false,"properties":{"definition":{"description":"Plain-text metric definition.","title":"definition","type":"string"},"formula":{"description":"Plain-text formula.","title":"formula","type":"string"},"computation_logic":{"description":"Plain-text computation-logic entries, one per bullet.","items":{"type":"string"},"title":"computation  logic","type":"array"}},"required":["definition","formula","computation_logic"],"title":"metric card public","type":"object"},"MetricCardRef":{"additionalProperties":false,"properties":{"slug":{"description":"Slug of the referenced metric card.","title":"slug","type":"string"},"url":{"description":"Relative URL of the referenced metric card.","title":"url","type":"string"}},"required":["slug","url"],"title":"metric card ref","type":"object"},"MetricCardSlugEnum":{"description":"The slugs gorgias exposes, mirroring the published + deprecated cards in the analytics repo.\n\ngorgias owns this list as the public contract: it is enumerated in the OpenAPI spec, gates which\ncards the list/detail endpoints surface, and validates the get-by-slug path parameter. It is a\npoint-in-time snapshot of `analytics/docs/metrics` (status: published | deprecated) and MUST be\nupdated (here) whenever a card is added, renamed, deprecated, or removed in analytics — a new card\nis not exposed through gorgias until this enum ships. `SearchMetricCardsUseCase` logs + counts any\nslug analytics returns that is missing here, so a forgotten update surfaces as a Datadog signal.","enum":["abandoned-calls","accuracy","achievement-rate","agents-offline","agents-online","ai-agent-automation-rate","ai-agent-average-csat","ai-agent-closed-tickets","all-used-tags-all","all-used-tags-all-created","all-used-values","all-used-values-created","article-views","assigned-open-tickets","automated-interactions","average-csat","average-discount-amount","average-order-value","average-survey-score","average-talk-time","average-ticket-handle-time","average-wait-time","brand-voice","buy-through-rate","callback-requests","calls-in-queue","cancelled-calls","click-through-rate","closed-tickets","closed-tickets-per-hour","comment-highlights","communication-skills","contribution-to-total-sales","conversion-rate","cost-saved","coverage-rate","created-tickets","decrease-in-frt","decrease-in-resolution-time","discount-codes-applied","discount-usage","discounts-offered","efficiency","first-response-time","handover-interactions","human-response-time-after-ai-handoff","inbound-answered-per-agent","inbound-calls","inbound-declined","inbound-transferred","internal-compliance","language-proficiency","live-messages-sent","live-online-status","live-open-tickets","live-tickets-closed","live-tickets-created","live-tickets-replied","median-purchase-time","median-response-time","messages-per-ticket","messages-received","messages-sent","messages-sent-per-hour","messages-sent-per-macro","missed-calls","no-search-results-search-count","one-touch-tickets","online-time","open-tickets","orders-influenced","outbound-calls","overall-automation-rate","percent-abandoned-calls","percent-callback-requests","percent-cancelled-calls","percent-missed-calls","percent-sla-achievement-rate","percentage-of-closed-tickets","percentage-of-created-tickets","performance-per-article-views","product-recommendations","resolution-completeness","resolution-time","response-rate","revenue-per-interaction","reviewed-tickets","satisfaction-score","search-results","search-terms-with-results-articles-clicked","search-terms-with-results-click-through-rate","search-terms-with-results-search-count","searches","sla-achievement-rate","success-rate","surveys-sent","ticket-handle-time-per-agent","tickets-replied","tickets-replied-per-hour","tickets-with-achieved-slas","tickets-with-breached-slas","time-saved-by-agent","top-performer-frt","top-performers-closed-tickets","top-performers-csat","top-performers-resolution-time","top-used-tags-all","top-used-tags-all-created","top-used-tags-all-created-trend","top-used-tags-all-trend","top-used-values","top-used-values-created","top-used-values-created-trend","top-used-values-trend","total-calls","total-sales","unanswered-calls","unassigned-open-tickets","wait-time-per-call","zero-touch-tickets"],"title":"metric card slug enum","type":"string"},"MetricCardStatusEnum":{"enum":["published","deprecated"],"title":"metric card status enum","type":"string"},"MetricCard":{"additionalProperties":false,"properties":{"slug":{"$ref":"#/components/schemas/MetricCardSlugEnum","description":"Unique metric identifier."},"category":{"description":"Metric category.","title":"category","type":"string"},"title":{"description":"Display name.","title":"title","type":"string"},"status":{"$ref":"#/components/schemas/MetricCardStatusEnum","description":"Publication status."},"definition_revised_at":{"description":"Date the public content was last revised (YYYY-MM-DD).","title":"definition  revised  at","type":"string"},"public":{"$ref":"#/components/schemas/MetricCardPublic","description":"Customer-facing content."},"api":{"description":"Pointer into the public /stats API (omitted for metrics not exposed there).","$ref":"#/components/schemas/MetricCardApiMapping"},"aliases":{"description":"Previous slugs that still resolve to this card.","items":{"type":"string"},"title":"aliases","type":"array"},"related":{"description":"Related metric cards.","items":{"$ref":"#/components/schemas/MetricCardRef"},"title":"related","type":"array"},"replaces":{"description":"Metric cards this one replaces.","items":{"$ref":"#/components/schemas/MetricCardRef"},"title":"replaces","type":"array"},"used_in_reports":{"description":"Report views where this metric is surfaced.","items":{"type":"string"},"title":"used  in  reports","type":"array"},"used_in_reports_links":{"description":"Direct report/dashboard URLs (relative paths) where this metric is surfaced.","items":{"type":"string"},"title":"used  in  reports  links","type":"array"}},"required":["slug","category","title","status","definition_revised_at","public","aliases","related","replaces","used_in_reports"],"title":"metric card","type":"object"},"MetricCardIncludeEnum":{"const":"deprecated","enum":["deprecated"],"title":"metric card include enum","type":"string"},"MetricCardList":{"additionalProperties":false,"properties":{"data":{"description":"The metric cards matching the query.","items":{"$ref":"#/components/schemas/MetricCard"},"title":"data","type":"array"}},"required":["data"],"title":"metric card list","type":"object"},"MetricFeedbackDisagreementType":{"enum":["definition_unclear","formula_seems_wrong","edge_case_missing","other"],"title":"metric feedback disagreement type","type":"string"},"MetricFeedbackRequest":{"additionalProperties":false,"properties":{"disagreement_type":{"$ref":"#/components/schemas/MetricFeedbackDisagreementType","description":"Why the customer disagrees with the metric definition."},"metric_category":{"description":"Category of the metric the feedback is about.","maxLength":100,"title":"metric  category","type":"string"},"comment":{"description":"Optional free-text comment.","title":"comment","maxLength":5000,"type":"string"}},"required":["disagreement_type","metric_category"],"title":"metric feedback request","type":"object"},"MetricFeedbackResponse":{"additionalProperties":false,"properties":{"id":{"description":"Identifier of the recorded feedback event.","format":"uuid","title":"id","type":"string"}},"required":["id"],"title":"metric feedback response","type":"object"},"ViewDecoration":{"additionalProperties":false,"properties":{"emoji":{"description":"Emoji displayed before the view's name.","examples":["🙏"],"title":"emoji","type":"string"}},"title":"view decoration","type":"object"},"ViewField":{"enum":["id","details","tags","customer","last_message","name","email","created","updated","assignee","assignee_team","channel","closed","language","last_received_message","integrations","snooze","status","subject","priority"],"title":"view field","type":"string"},"ViewType":{"enum":["ticket-list","customer-list"],"title":"view type","type":"string"},"ViewVisibility":{"enum":["public","shared","private"],"title":"view visibility","type":"string"},"ViewCreate":{"additionalProperties":false,"properties":{"decoration":{"description":"Object describing how the view appears in our applications. Currently only supports `emoji` field that shows before the view's name.","examples":[{"emoji":"🙏"}],"$ref":"#/components/schemas/ViewDecoration"},"fields":{"default":[],"description":"List of object's attributes to be displayed in the UI of our applications.","examples":[["id","details","tags"]],"items":{"$ref":"#/components/schemas/ViewField"},"title":"fields","type":"array"},"filters":{"description":"The logic used to filter the items to be displayed in the view (as JavaScript code).","examples":["eq(ticket.assignee_user.id, '{{current_user.id}}') && eq(ticket.status, 'open')"],"title":"filters","type":"string"},"name":{"default":"","description":"The name of the view.","examples":["My view"],"title":"name","type":"string"},"order_by":{"default":"updated_datetime","description":"Name of the object's attribute used to sort the items of the view.","examples":["updated_datetime"],"title":"order  by","type":"string"},"order_dir":{"default":"desc","description":"Sort direction of the items displayed in the view. Options: `asc` or `desc`.","examples":["desc"],"title":"order  dir","enum":["asc","desc"],"type":"string"},"shared_with_teams":{"default":[],"description":"IDs of teams this view is shared with.","examples":[[1,2]],"items":{"type":"integer"},"maxItems":100,"title":"shared  with  teams","type":"array"},"shared_with_users":{"default":[],"description":"IDs of users this view is shared with.","examples":[[1,2]],"items":{"type":"integer"},"maxItems":100,"title":"shared  with  users","type":"array"},"slug":{"description":"DEPRECATED - URL-compatible name of the view.","examples":["my-tickets"],"title":"slug","type":"string"},"type":{"default":"ticket-list","description":"Type of objects the view is applied on.","enum":["ticket-list"],"examples":["ticket-list"],"$ref":"#/components/schemas/ViewType"},"visibility":{"$ref":"#/components/schemas/ViewVisibility","default":"public","description":"Visibility of the view.\n\nPossible values are:\n\n- `public`: any user of your helpdesk can see it.\n- `shared`: users listed under `shared_with_users` attribute and teams listed under `shared_with_teams` attribute can see it. All admins and lead agents will see it as well, even if they are not explicitly listed in the `shared_with_users` attribute.\n- `private`: only the single user listed under `shared_with_users` attribute can see it.\n","examples":["public"]}},"required":["slug"],"title":"view create","type":"object"},"ViewSharedWithTeam":{"additionalProperties":false,"properties":{"id":{"description":"ID of the team.","examples":[123],"title":"id","type":"integer"},"name":{"description":"Name of the team.","examples":["Warehouse team"],"title":"name","type":"string"},"decoration":{"default":{},"description":"Object describing how the team appears on the webpage. Currently only supports `emoji` field that shows before the team's name.","title":"decoration","type":"object"}},"required":["id","name"],"title":"view shared with team","type":"object"},"ViewSharedWithUser":{"additionalProperties":false,"properties":{"id":{"description":"ID of the user.","examples":[1],"title":"id","type":"integer"},"name":{"description":"Name of the user.","examples":["John Smith"],"title":"name","type":"string"},"meta":{"description":"User defined JSON field with additional info about the user.","examples":[{"profile_picture_url":null}],"title":"meta","type":"object"}},"required":["id","name"],"title":"view shared with user","type":"object"},"View":{"additionalProperties":false,"description":"A view allows you to filter and sort the tickets of your account according to one or more criteria. For example, you can have a view that displays tickets having the tag `urgent`, or a view that display closed tickets, etc...\n Views are not like inboxes because a ticket can be present in 1 or more views if this one matches criterias of these views.","properties":{"id":{"description":"ID of the view.","examples":[123],"title":"id","type":"integer"},"category":{"default":"user","description":"Category is an internal, read-only field used to identify system and user views.Example of system views: Trash or Spam. System views cannot be deleted.","examples":["user"],"title":"category","type":"string"},"created_datetime":{"description":"When the view was created.","examples":["2019-11-23T15:59:41.966927"],"title":"created  datetime","format":"date-time","type":"string"},"deactivated_datetime":{"description":"When the view was deactivated.","examples":["2020-01-30T11:04:34.345123"],"readOnly":true,"title":"deactivated  datetime","format":"date-time","type":"string"},"decoration":{"description":"Object describing how the view appears in our applications. Currently only supports `emoji` field that shows before the view's name.","$ref":"#/components/schemas/ViewDecoration"},"fields":{"description":"List of object's attributes to be displayed in the UI of our applications.","examples":[["id","details","tags"]],"title":"fields","items":{"$ref":"#/components/schemas/ViewField"},"type":"array"},"filters":{"description":"The logic used to filter the items to be displayed in the view (as JavaScript code).","examples":["eq(ticket.assignee_user.id, '{{current_user.id}}') && eq(ticket.status, 'open')"],"title":"filters","type":"string"},"name":{"default":"","description":"The name of the view.","examples":["My view"],"title":"name","type":"string"},"order_by":{"default":"updated_datetime","description":"Name of the object's attribute used to sort the items of the view.","examples":["updated_datetime"],"title":"order  by","type":"string"},"order_dir":{"default":"desc","description":"Sort direction of the items displayed in the view. Options: `asc` or `desc`.","examples":["desc"],"title":"order  dir","enum":["asc","desc"],"type":"string"},"search":{"description":"Text used to search for items matching the query.","examples":["where is my order?"],"title":"search","type":"string"},"shared_with_teams":{"default":[],"description":"Teams this view is shared with.","items":{"$ref":"#/components/schemas/ViewSharedWithTeam"},"maxItems":100,"title":"shared  with  teams","type":"array"},"shared_with_users":{"default":[],"description":"Users this view is shared with.","items":{"$ref":"#/components/schemas/ViewSharedWithUser"},"maxItems":100,"title":"shared  with  users","type":"array"},"slug":{"description":"DEPRECATED - URL-compatible name of the view.","examples":["my-tickets"],"title":"slug","type":"string"},"type":{"default":"ticket-list","description":"Type of objects the view is applied on.","enum":["ticket-list"],"examples":["ticket-list"],"$ref":"#/components/schemas/ViewType"},"uri":{"description":"URI of the object (auto-generated)","examples":["/api/views/123/"],"read