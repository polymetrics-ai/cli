on":"The country where the address is located.","example":"USA"},"zip_code":{"type":"string","description":"The zip code of the address.","example":"123456"},"first_name":{"type":"string","description":"The first name for the contact person.","example":"Jane"},"last_name":{"type":"string","description":"The last name for the contact person.","example":"Doe"},"phone_number":{"type":["string","null"],"description":"The phone number for the contact person.","example":"+1 123 456 7890"},"created_datetime":{"type":"string","format":"date-time","description":"When the address was created.","example":"2023-07-15T00:00:00.000000+00:00"},"updated_datetime":{"type":["string","null"],"format":"date-time","description":"When the address was updated.","example":"2023-07-15T00:00:00.000000+00:00"},"deleted_datetime":{"type":["string","null"],"format":"date-time","description":"When the address was deleted.","example":"2023-07-15T00:00:00.000000+00:00"}}}}}}}}}}}}},"tags":["Customers"]}},"/api/customers/{customer_id}/data":{"put":{"summary":"Set customer data","operationId":"update-customer-data","description":"Set a customer's data.","parameters":[{"in":"path","name":"customer_id","schema":{"type":"integer"},"description":"The ID of the customer to update.","required":true}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"version":{"type":["string","null"],"description":"The date of the customer data. If we already have a more recent version, the request will be ignored.","example":"2022-05-13T12:34:21.918927"},"data":{"description":"The customer data.","example":{"key":"value"}}},"required":["data"]}}}},"responses":{"202":{"description":"An empty response."},"301":{"description":"Customer was merged with another one."}},"tags":["Customers"]}},"/api/customers/{customer_id}/custom-fields/{id}":{"delete":{"summary":"Delete customer field value","operationId":"delete-customer-custom-field-value","description":"Delete a customer'