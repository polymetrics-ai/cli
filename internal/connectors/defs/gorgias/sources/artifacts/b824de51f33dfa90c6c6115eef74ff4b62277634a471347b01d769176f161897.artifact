","description":"Maximum number of items to return.","schema":{"type":"integer","default":30,"minimum":1,"maximum":100},"required":false}],"responses":{"200":{"description":"List of custom fields according to the given criteria.","content":{"application/json":{"schema":{"additionalProperties":false,"properties":{"object":{"title":"object","type":"string"},"uri":{"title":"uri","type":"string"},"data":{"items":{"$ref":"#/components/schemas/CustomField"},"title":"data","type":"array"},"meta":{"$ref":"#/components/schemas/CursorPaginationMeta"}},"required":["object","uri","data","meta"],"title":"paginated data","type":"object"}}}}},"tags":["Custom Fields"]},"put":{"summary":"Bulk update a list of custom fields","operationId":"update-custom-fields","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateCustomFieldList"}}}},"responses":{"202":{"description":"The updated custom fields.","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/CustomField"}}}}}},"tags":["Custom Fields"]}},"/api/custom-fields/{id}":{"get":{"summary":"Retrieve a custom field","operationId":"get-custom-field","parameters":[{"in":"path","name":"id","description":"The ID of the custom field to retrieve.","required":true,"schema":{"type":"integer"}}],"responses":{"200":{"description":"The requested custom field.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CustomField"}}}}},"tags":["Custom Fields"]},"put":{"summary":"Update a custom field","operationId":"update-custom-field","parameters":[{"in":"path","name":"id","description":"The ID of the custom field to update.","required":true,"schema":{"type":"integer"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateCustomField"}}}},"responses":{"202":{"description":"The updated custom field.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CustomField"}}}}},"tags":["Custom Fields"]}},"/api/events/{id}":{"get":{"summary":"Retrieve an event","operationId":"get-event","parameters":[{"in":"path","name":"id","schema":{"type":"integer"},"required":true,"description":"The ID of the event to retrieve."}],"responses":{"200":{"description":"The requested event.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Event"},"examples":{"responses":{"value":{"id":1234,"context":"dd4ff312-69df-494a-be96-1a58b3d8b8e0","created_datetime":"2019-11-16T15:59:41.966927","data":null,"object_id":123,"object_type":"Ticket","type":"ticket-closed","user_id":123,"uri":"/api/events/1234/"}}}}}}},"tags":["Events"]}},"/api/events":{"get":{"summary":"List events","operationId":"list-events","description":"List events, paginated, and ordered by their creation date, with the most recently created first.","parameters":[{"in":"query","name":"created_datetime","description":"Comparators used to filter events on their creation date.","schema":{"type":"object","properties":{"lt":{"type":"string","format":"date-time","description":"Less than the given value."},"lte":{"type":"string","format":"date-time","description":"Less than or equal to the given value."},"gt":{"type":"string","format":"date-time","description":"Greater than then given value."},"gte":{"type":"string","format":"date-time","description":"Greater than or equal to the given value."}}},"required":false,"style":"deepObject","explode":true},{"in":"query","name":"cursor","description":"Value indicating your position in the list of all events. If omitted, the first events of the list will be returned.","schema":{"type":"string","example":"cHJldl9fNl9fMjAyMS0wMy0wMyAwNjowMDowMA=="},"required":false},{"in":"query","name":"limit","description":"Maximum number of events to return.","schema":{"type":"integer","default":30,"minimum":1,"maximum":100},"required":false},{"in":"query","name":"object_id","description":"ID of the object associated with the events to return.","schema":{"type":"integer"},"required":false},{"in":"query","name":"object_type","description":"Type of the object associated with the events to return.","schema":{"type":"string","enum":["Account","AccountSetting","Macro","Tag","Customer","Team","View","Widget","CustomField","CustomFieldCondition","User","TicketMessage","Ticket","Rule","Integration","SatisfactionSurvey"]},"required":false},{"in":"query","name":"order_by","description":"Attribute used to order events.<br>Value of <span style={{color: 'red'}}>`created_datetime` has been deprecated</span>, use `created_datetime:asc` or `created_datetime:desc` instead.","schema":{"type":"string","default":"created_datetime:desc","enum":["created_datetime","created_datetime:asc","created_datetime:desc"]},"required":false},{"in":"query","name":"types","description":"Types of the events to return.","schema":{"type":"array","items":{"type":"string","enum":["account-created","account-deactivated","account-setting-updated","account-updated","action-executed","custom-field-condition-created","custom-field-condition-deleted","custom-field-condition-disabled","custom-field-condition-enabled","custom-field-condition-updated","custom-field-created","custom-field-updated","customer-created","customer-deleted","customer-merged","customer-updated","integration-created","integration-deactivated","integration-deleted","integration-reactivated","integration-updated","macro-created","macro-deleted","macro-updated","rule-created","rule-deleted","rule-executed","rule-priority-updated","rule-updated","satisfaction-survey-responded","satisfaction-survey-sent","tag-created","tag-deleted","tag-merged","tag-renamed","tag-updated","team-created","team-deleted","team-updated","ticket-assigned","ticket-closed","ticket-created","ticket-customer-updated","ticket-deleted","ticket-excluded-from-auto-merge","ticket-excluded-from-csat","ticket-marked-spam","ticket-merged","ticket-message-created","ticket-message-deleted","ticket-message-failed","ticket-message-summary-created","ticket-message-updated","ticket-reopened","ticket-satisfaction-survey-skipped","ticket-self-unsnoozed","ticket-sla-policy-assigned","ticket-snoozed","ticket-split","ticket-subject-updated","ticket-tags-added","ticket-tags-removed","ticket-team-assigned","ticket-team-unassigned","ticket-trashed","ticket-unassigned","ticket-unmarked-spam","ticket-untrashed","ticket-updated","user-2fa-changed","user-created","user-deleted","user-impersonated","user-invited","user-logged-in","user-logged-out","user-password-changed","user-password-reset","user-updated","view-created","view-deactivated","view-deleted","view-updated","widget-created","widget-deleted","widget-updated"]}},"required":false,"explode":true,"style":"form"},{"in":"query","name":"user_ids","description":"IDs of the users who triggered the events to return.","schema":{"type":"array","maxItems":1,"items":{"type":"integer"}},"required":false,"explode":true,"style":"form"}],"responses":{"200":{"description":"A list of events.","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Event"}},"examples":{"responses":{"value":[{"id":1234,"context":"dd4ff312-69df-494a-be96-1a58b3d8b8e0","created_datetime":"2019-11-16T15:59:41.966927","data":null,"object_id":123,"object_type":"Ticket","type":"ticket-closed","user_id":123,"uri":"/api/events/1234/"}]}}}}}},"tags":["Events"]}},"/api/upload":{"post":{"summary":"Upload files","description":"You can upload several files at a time by adding parameters to the root of the request body. The name of each parameter will be used as the label of the file once uploaded. E.g:\n  - parameter name: `package-damaged.png`\n  - parameter value: Content of the file.\n","parameters":[{"in":"query","name":"type","description":"The type of file to upload. If not specified, the file will be uploaded as a private attachment.","schema":{"type":"string","default":"attachment","enum":["public_attachment","attachment","profile_picture","widget_picture"],"example":"attachment"},"required":false}],"requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"type":"object","properties":{"file":{"description":"A file to upload. The name of this parameter can be replaced with the label of the file you want to have once uploaded. E.g: `package-damaged.png`.\n","type":"string","format":"binary"}}}}}},"responses":{"201":{"description":"A list of files","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/File"}},"examples":{"responses":{"value":[{"content_type":"image/png","name":"package-damaged.png","size":"784554","url":"https://gorgias.io/attachments/package-damaged.png"}]}}}}}},"tags":["Files"]}},"/api/{file_type}/download/{domain_hash}/{resource_name}":{"get":{"summary":"Download a file","operationId":"download-file","description":"Download a private file given its resource identifier. The identifier can be extracted from the URL of an attachment by removing the domain part and keeping the rest.","parameters":[{"in":"path","name":"file_type","description":"The type of file to download","required":true,"schema":{"type":"string","example":"attachment"}},{"in":"path","name":"domain_hash","description":"The domain identifier of the account that owns the resource","required":true,"schema":{"type":"string","example":"Hna8kldnmlal"}},{"in":"path","name":"resource_name","description":"The resource identifier of the attachment you are trying to retrieve","required":true,"schema":{"type":"string","example":"image-test-c9f158fc-062d-4b00-a826-e29b36852c9b.png"}}],"responses":{"307":{"description":"Redirect to a signed URL that allows timed access to the requested attachment."}},"tags":["Files"]}},"/api/integrations":{"post":{"summary":"Create an integration","operationId":"create-integration","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"deactivated_datetime":{"type":["string","null"],"format":"date-time","description":"When the integration was deactivated."},"description":{"type":["string","null"],"nullable":true,"description":"Description about the integration."},"http":{"type":"object","description":"Only available for HTTP integrations, defines the configuration of the integration.","example":{"id":987,"url":"https://company.com/api/customers?email={{ticket.customer.email}}","method":"GET","headers":{"x-api-key":"abcdef12345"},"form":{"hello":"world","ticket_id":"{{ticket.id}}"},"triggers":{"ticket_created":true,"ticket_updated":true,"ticket_message_created":true,"ticket_self_unsnoozed":true,"ticket_message_failed":true,"ticket_assignee_updated":true,"ticket_status_updated":true,"ticket_handed_over":true},"request_content_type":"application/json","response_content_type":"application/json"},"properties":{"form":{"default":{},"type":["null"],"description":"Data to send to the external service. It can either be a raw JSON object (if `request_content_type` is `application/json`) or a key-value object representing form data (if `request_content_type` is `application/x-www-form-urlencoded`). You can use variables like {{ticket.customer.email}} as values for the request. Check all properties from a [customer](#the-customer-object), or review the list of [Gorgias variables](https://docs.gorgias.com/macros/macro-variables#gorgias_variables) for inspiration.","example":{"hello":"world","ticket_id":"{{ticket.id}}"}},"headers":{"default":{},"type":["null"],"description":"HTTP headers expected by the external service.","example":{"x-api-key":"abcdef12345"}},"hmac_secret":{"type":"string","description":"The HMAC secret to use to sign HTTP calls to the external service."},"method":{"type":"string","default":"GET","enum":["GET","POST","PUT","DELETE","HEAD","PATCH"],"description":"HTTP method expected by the external service.","example":"GET"},"request_content_type":{"type":"string","default":"application/json","enum":["application/json","application/x-www-form-urlencoded"],"description":"Content type of the outgoing request to the external service.","example":"application/json"},"response_content_type":{"type":"string","default":"application/json","enum":["application/json"],"description":"Content type of the incoming response from the external service.","example":"application/json"},"triggers":{"description":"Events that will trigger the request to the external service.","example":{"ticket_created":true,"ticket_updated":true,"ticket_message_created":true,"ticket_self_unsnoozed":true,"ticket_message_failed":true,"ticket_assignee_updated":true,"ticket_status_updated":true,"ticket_handed_over":true},"type":"object","properties":{"ticket-created":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when a ticket is created.","example":true},"ticket-updated":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when a ticket is updated.","example":true},"ticket-message-created":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when a new message is created in a ticket.","example":true},"ticket-self-unsnoozed":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when the snooze delay ends.","example":true},"ticket-message-failed":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when the message fails to send.","example":true},"ticket-assignment-updated":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when the ticket assignee is changed.","example":true},"ticket-status-updated":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when the ticket status is updated.","example":true},"ticket-handed-over":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when a ticket is handed over to another user. Further configuration is required.","example":true}}},"url":{"type":"string","description":"URL of the external service. You can use variables like {{ticket.customer.email}} to pass customer data to the integration. Check all properties from a [customer](#the-customer-object), or review the list of [Gorgias variables](https://docs.gorgias.com/macros/macro-variables#gorgias_variables) for inspiration.","example":"https://company.com/api/customers?email={{ticket.customer.email}}"}},"required":["method","request_content_type","response_content_type","url"]},"name":{"type":"string","description":"Name of the integration. Usually the email address, Facebook page name, etc.","example":"My HTTP integration"},"type":{"type":"string","enum":["http"],"description":"Type of integration.","example":"http"},"managed":{"type":"boolean","default":false,"description":"Whether integration is managed by Gorgias."}},"required":["name","type"]}}}},"responses":{"201":{"description":"The created integration.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Integration"},"examples":{"responses":{"value":{"id":123,"created_datetime":"2021-01-07T13:00:00.123456","http":{"id":987,"url":"https://company.com/api/customers?email={{ticket.customer.email}}","method":"GET","form":{"hello":"world","ticket_id":"{{ticket.id}}"},"triggers":{"ticket_created":true,"ticket_updated":true,"ticket_message_created":true,"ticket_self_unsnoozed":true,"ticket_message_failed":true,"ticket_assignee_updated":true,"ticket_status_updated":true,"ticket_handed_over":true},"request_content_type":"application/json","response_content_type":"application/json"},"name":"My HTTP integration","type":"http","updated_datetime":"2021-01-07T13:00:00.123456","uri":"/api/integrations/123/"}}}}}}},"tags":["Integrations"]},"get":{"summary":"List integrations","operationId":"list-integrations","description":"List integrations matching the given parameters, paginated.","parameters":[{"in":"query","name":"cursor","description":"Value indicating your position in the list of all integrations. If omitted, the first integrations of the list will be returned.","schema":{"type":"string","example":"WyJuZXh0IiwgIjIwMjItMDEtMDFUMDE6MDA6MDAiLCAxMjNd"},"required":false},{"in":"query","name":"limit","description":"Maximum number of integrations to return.","schema":{"type":"integer","default":30,"minimum":1,"maximum":100},"required":false},{"in":"query","name":"order_by","description":"Attribute used to order integrations.","schema":{"type":"string","default":"created_datetime:desc","enum":["created_datetime:asc","created_datetime:desc"]},"required":false},{"in":"query","name":"type","description":"Type of integration.","schema":{"type":"string","enum":["email","gmail","outlook","app","aircall","facebook","gorgias_chat","phone","sms","twitter","yotpo","whatsapp","http","shopify","recharge","smile","smooch_inside","smooch","magento2","zendesk","klaviyo","bigcommerce","alloy","ecom"],"example":"http"},"required":false}],"responses":{"200":{"description":"List of integrations according to the given criteria.","content":{"application/json":{"schema":{"type":"object","properties":{"meta":{"description":"Pagination metadata for the list.","type":"object","properties":{"next_cursor":{"type":["string","null"],"description":"Value indicating a cursor for the next page.","example":"WyJuZXh0IiwgIjIwMjEtMDEtMDFUMDE6MDA6MDAiLCA1MV0="},"prev_cursor":{"type":["string","null"],"description":"Value indicating a cursor for the previous page.","example":"WyJuZXh0IiwgIjIwMjEtMDEtMDFUMDE6MDA6MDAiLCA1MV0="}},"required":["next_cursor","prev_cursor"]},"object":{"default":"list","description":"Describes the object type of the payload.","example":"list"},"uri":{"type":"string","format":"url","description":"Contains the URI of the fetched resource list.","example":"/api/integrations?limit=100"},"data":{"type":"array","items":{"$ref":"#/components/schemas/Integration"}}},"required":["data","meta","object","uri"]}}}}},"tags":["Integrations"]}},"/api/integrations/{id}":{"delete":{"summary":"Delete an integration","operationId":"delete-integration","description":"Delete an integration. Any views that use this integration will be deactivated. Integrations currently used in rules and/or other integrations cannot be deleted.\n","parameters":[{"in":"path","name":"id","description":"The ID of the integration to delete.","required":true,"schema":{"type":"integer"}}],"responses":{"204":{"description":"No content."}},"tags":["Integrations"]},"get":{"summary":"Retrieve an integration","operationId":"get-integration","parameters":[{"in":"path","name":"id","description":"The ID of the integration to retrieve.","required":true,"schema":{"type":"integer"}}],"responses":{"200":{"description":"The requested integration.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Integration"},"examples":{"responses":{"value":{"id":123,"created_datetime":"2021-01-07T13:00:00.123456","http":{"id":987,"url":"https://company.com/api/customers?email={{ticket.customer.email}}","method":"GET","form":{"hello":"world","ticket_id":"{{ticket.id}}"},"triggers":{"ticket_created":true,"ticket_updated":true,"ticket_message_created":true,"ticket_self_unsnoozed":true,"ticket_message_failed":true,"ticket_assignee_updated":true,"ticket_status_updated":true,"ticket_handed_over":true},"request_content_type":"application/json","response_content_type":"application/json"},"name":"My HTTP integration","type":"http","updated_datetime":"2021-01-07T13:00:00.123456","uri":"/api/integrations/123/"}}}}}}},"tags":["Integrations"]},"put":{"summary":"Update an integration","operationId":"update-integration","parameters":[{"in":"path","name":"id","description":"The ID of the integration to update.","required":true,"schema":{"type":"integer"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"deactivated_datetime":{"type":["string","null"],"format":"date-time","description":"When the integration was deactivated."},"description":{"type":["string","null"],"nullable":true,"description":"Description about the integration."},"http":{"type":"object","description":"Only available for HTTP integrations, defines the configuration of the integration.","example":{"id":987,"url":"https://company.com/api/customers?email={{ticket.customer.email}}","method":"GET","headers":{"x-api-key":"abcdef12345"},"form":{"hello":"world","ticket_id":"{{ticket.id}}"},"triggers":{"ticket_created":true,"ticket_updated":true,"ticket_message_created":true,"ticket_self_unsnoozed":true,"ticket_message_failed":true,"ticket_assignee_updated":true,"ticket_status_updated":true,"ticket_handed_over":true},"request_content_type":"application/json","response_content_type":"application/json"},"properties":{"form":{"default":{},"type":["null"],"description":"Data to send to the external service. It can either be a raw JSON object (if `request_content_type` is `application/json`) or a key-value object representing form data (if `request_content_type` is `application/x-www-form-urlencoded`). You can use variables like {{ticket.customer.email}} as values for the request. Check all properties from a [customer](#the-customer-object), or review the list of [Gorgias variables](https://docs.gorgias.com/macros/macro-variables#gorgias_variables) for inspiration.","example":{"hello":"world","ticket_id":"{{ticket.id}}"}},"headers":{"default":{},"type":["null"],"description":"HTTP headers expected by the external service.","example":{"x-api-key":"abcdef12345"}},"hmac_secret":{"type":"string","description":"The HMAC secret to use to sign HTTP calls to the external service."},"method":{"type":"string","default":"GET","enum":["GET","POST","PUT","DELETE","HEAD","PATCH"],"description":"HTTP method expected by the external service.","example":"GET"},"request_content_type":{"type":"string","default":"application/json","enum":["application/json","application/x-www-form-urlencoded"],"description":"Content type of the outgoing request to the external service.","example":"application/json"},"response_content_type":{"type":"string","default":"application/json","enum":["application/json"],"description":"Content type of the incoming response from the external service.","example":"application/json"},"triggers":{"description":"Events that will trigger the request to the external service.","example":{"ticket_created":true,"ticket_updated":true,"ticket_message_created":true,"ticket_self_unsnoozed":true,"ticket_message_failed":true,"ticket_assignee_updated":true,"ticket_status_updated":true,"ticket_handed_over":true},"type":"object","properties":{"ticket-created":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when a ticket is created.","example":true},"ticket-updated":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when a ticket is updated.","example":true},"ticket-message-created":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when a new message is created in a ticket.","example":true},"ticket-self-unsnoozed":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when the snooze delay ends.","example":true},"ticket-message-failed":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when the message fails to send.","example":true},"ticket-assignment-updated":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when the ticket assignee is changed.","example":true},"ticket-status-updated":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when the ticket status is updated.","example":true},"ticket-handed-over":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when a ticket is handed over to another user. Further configuration is required.","example":true}}},"url":{"type":"string","description":"URL of the external service. You can use variables like {{ticket.customer.email}} to pass customer data to the integration. Check all properties from a [customer](#the-customer-object), or review the list of [Gorgias variables](https://docs.gorgias.com/macros/macro-variables#gorgias_variables) for inspiration.","example":"https://company.com/api/customers?email={{ticket.customer.email}}"}},"required":["url"]},"name":{"type":"string","description":"Name of the integration. Usually the email address, Facebook page name, etc.","example":"My HTTP integration"}},"required":["name"]}}}},"responses":{"202":{"description":"The updated integration.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Integration"},"examples":{"responses":{"value":{"id":123,"created_datetime":"2021-01-07T13:00:00.123456","http":{"id":987,"url":"https://company.com/api/customers?email={{ticket.customer.email}}","method":"GET","form":{"hello":"world","ticket_id":"{{ticket.id}}"},"triggers":{"ticket_created":true,"ticket_updated":true,"ticket_message_created":true,"ticket_self_unsnoozed":true,"ticket_message_failed":true,"ticket_assignee_updated":true,"ticket_status_updated":true,"ticket_handed_over":true},"request_content_type":"application/json","response_content_type":"application/json"},"name":"My HTTP integration","type":"http","updated_datetime":"2021-01-07T13:00:00.123456","uri":"/api/integrations/123/"}}}}}}},"tags":["Integrations"]}},"/api/jobs":{"post":{"summary":"Create a job","operationId":"create-job","description":"Create a job and schedule its execution. Jobs are processed asynchronously, meaning that once a job is created, it will run in background on Gorgias's servers. According to the type and size of the task, a job can take a few minutes or several hours to be executed. You can use our API to check the status of the job.\n","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"meta":{"type":["object","null"],"description":"Metadata associated with the job. You can use this parameter to store structured information (key-value data) about the job. This field is not used by Gorgias.","example":{"description":"This job closes all tickets created in 2018"}},"params":{"example":{"ticket_ids":[1,2,3],"updates":{"status":"open"}},"description":"The parameters of the job.","type":"object","properties":{"apply_and_close":{"type":"boolean","description":"Whether the ticket should be closed once the macro is applied on it. Only applies to `applyMacro` jobs.","example":true},"end_datetime":{"type":["string","null"],"description":"End of the interval from which to select tickets when the parameter `view` is used.","example":"2019-11-24T15:59:41.966927"},"macro_id":{"type":"integer","description":"The ID of the macro to apply on the selected tickets. Only applies to `applyMacro` jobs.","example":47},"start_datetime":{"type":["string","null"],"description":"Beginning of the interval from which to select tickets when the parameter `view` is used.","example":"2019-11-23T15:59:41.966927"},"ticket_ids":{"type":"array","description":"A list of ticket IDs to be processed by the job.","example":[1,2,3],"items":{"type":"integer"}},"url":{"type":"string","description":"The path to the file to import.","example":"https://example.com/file.csv"},"updates":{"type":"object","description":"Object (key-value) containing all the changes to apply on the selected tickets. Only applies to `updateTicket` jobs.","example":{"status":"open"}},"view":{"type":"object","description":"A [view](#the-view-object)-like object used to select the tickets to be processed by the job.","example":{"filters":"eq(ticket.status, \"open\")"}},"view_id":{"type":"integer","description":"The ID of an existing [view](#the-view-object) used to select the tickets to be processed by the job.","example":123},"context":{"type":"object","description":"Object (key-value) containing extra context for the job","example":{"channel_connection_external_ids":["12","34"]}}}},"scheduled_datetime":{"type":["string","null"],"format":"date-time","description":"When the job was scheduled to be started. A job cannot be scheduled more than 60 minutes in the future. If unspecified, the job is queued for execution immediately after creation.","example":"2019-11-23T16:30:00.966927"},"type":{"type":"string","enum":["applyMacro","deleteTicket","exportTicket","importMacro","exportMacro","updateTicket","exportTicketDrilldown","exportConvertCampaignSalesDrilldown"],"description":"The type of the job. Options: applyMacro, deleteTicket, exportTicket, importMacro, exportMacro, updateTicket, exportTicketDrilldown, exportConvertCampaignSalesDrilldown","example":"updateTicket"}},"required":["params","type"]}}}},"responses":{"201":{"description":"The created job.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"},"examples":{"responses":{"value":{"id":1234,"cancel_requested_datetime":"2019-11-23T16:31:00.966927","cancelled_datetime":"2019-11-23T16:32:00.966927","created_datetime":"2019-11-23T16:00:00.966927","ended_datetime":"2019-11-23T16:32:00.966927","failed_datetime":"2019-11-23T15:59:41.966927","info":{"progress_count":123},"locked_datetime":"2019-11-23T16:30:01.966927","meta":{"description":"This job closes all tickets created in 2018"},"params":{"ticket_ids":[1,2,3],"updates":{"status":"open"}},"scheduled_datetime":"2019-11-23T16:30:00.966927","started_datetime":"2019-11-23T16:30:01.966927","status":"canceled","type":"updateTicket","user_id":42,"uri":"/api/jobs/1234/"}}}}}}},"tags":["Jobs"]},"get":{"summary":"List jobs","operationId":"list-jobs","description":"List jobs, paginated and ordered by their creation date, with the most recent ones first.\n","parameters":[{"in":"query","name":"cursor","description":"Value indicating your position in the list of all jobs. If omitted, the first jobs of the list will be returned.","schema":{"type":"string","example":"WyJuZXh0IiwgIjIwMjEtMDEtMDFUMDE6MDA6MDAiLCA1MV0="},"required":false},{"in":"query","name":"limit","description":"Maximum number of jobs to return.","schema":{"type":"integer","default":30,"minimum":1,"maximum":100},"required":false},{"in":"query","name":"order_by","description":"Attribute used to order jobs.","schema":{"type":"string","default":"created_datetime:desc","enum":["created_datetime:asc","created_datetime:desc"]},"required":false},{"in":"query","name":"status","description":"Filter jobs by status.","schema":{"type":["string","null"],"default":null,"enum":["cancel_requested","canceled","done","errored","fatal_errored","pending","running","scheduled"],"example":"cancel_requested"},"required":false},{"in":"query","name":"type","description":"Filter jobs by job type.","schema":{"type":["string","null"],"default":null,"enum":["applyMacro","deleteTicket","exportTicket","importMacro","exportMacro","updateTicket","exportTicketDrilldown","exportConvertCampaignSalesDrilldown"],"example":"applyMacro"},"required":false}],"responses":{"200":{"description":"A list of jobs.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Job"}},"meta":{"type":"object","properties":{"next_cursor":{"type":"string","description":"Value indicating a cursor for the next page.","example":"WyJuZXh0IiwgIjIwMjEtMDEtMDFUMDE6MDA6MDAiLCA1MV0="},"prev_cursor":{"type":"string","description":"Value indicating a cursor for the previous page.","example":"WyJuZXh0IiwgIjIwMjEtMDEtMDFUMDE6MDA6MDAiLCA1MV0="}}}},"required":["data","meta"]}}}}},"tags":["Jobs"]}},"/api/jobs/{id}":{"delete":{"summary":"Cancel a job","operationId":"cancel-job","description":"Jobs can be canceled at any time but be aware that if a job already started, changes done by this one won't be reverted. For example, if you created a job to close 10k tickets and you cancel it at some point, these closed tickets won't be reopened.\n","parameters":[{"in":"path","name":"id","schema":{"type":"integer"},"required":true,"descripti