me":{"type":"string","format":"date-time","description":"When the address was created.","example":"2023-07-15T00:00:00.000000+00:00"},"updated_datetime":{"type":["string","null"],"format":"date-time","description":"When the address was updated.","example":"2023-07-15T00:00:00.000000+00:00"},"deleted_datetime":{"type":["string","null"],"format":"date-time","description":"When the address was deleted.","example":"2023-07-15T00:00:00.000000+00:00"}}},"line_items":{"type":"array","description":"The line items for the order.","items":{"type":"object","properties":{"id":{"type":"integer","description":"ID of the address.","example":123456},"title":{"type":"string","description":"The custom title of the product for the current order.","example":"My Awesome Product"},"taxable":{"type":["boolean","null"],"description":"Whether item is taxable or not.","example":true},"requires_shipping":{"type":["boolean","null"],"description":"Whether item requires shipping or not.","example":true},"unit_price":{"type":"number","description":"The price for a single unit.","example":"123456"},"discount_amount":{"type":["number","null"],"description":"The discount amount.","example":"20"},"discount_type":{"type":"string","description":"Type of discount.","example":"percentage","enum":["percentage","fixed_amount"]},"discount_reason":{"type":["string","null"],"description":"The reason for granting a discount.","example":"Refurbished product"},"quantity":{"type":"integer","description":"The number of products of this kind in the current order.","example":5},"total_amount":{"type":"number","description":"The total amount for the quantity of products.","example":"5"},"product_options":{"type":["object","null"],"description":"Additional information for the product in current order.","example":{"size":10}},"fulfilled_quantity":{"type":["integer","null"],"description":"The number of products of this kind that have been fulfilled.","example":5},"created_datetime":{"type":"string","format":"date-time",