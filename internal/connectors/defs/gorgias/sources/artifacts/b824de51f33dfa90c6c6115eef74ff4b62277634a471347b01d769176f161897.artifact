ng"},"closed_datetime":{"description":"When the ticket was closed.","examples":[null],"title":"closed  datetime","format":"date-time","type":"string"},"snooze_datetime":{"description":"When the ticket will be re-opened.","examples":[null],"title":"snooze  datetime","format":"date-time","type":"string"},"custom_fields":{"description":"The custom fields associated with the ticket.","examples":[{"301":{"id":301,"value":"VIP"}}],"title":"custom  fields","additionalProperties":{"$ref":"#/components/schemas/TicketCustomFieldValueHttpIntegration"},"type":"object"},"tags":{"description":"Tags linked to the ticket.","examples":[[{"id":1,"name":"urgent"}]],"items":{"$ref":"#/components/schemas/TicketTagHttpIntegration"},"title":"tags","type":"array"}},"required":["id","external_id","channel","via","spam","from_agent","customer_id","assignee_user_id","assignee_team_id","subject","meta","language","created_datetime","opened_datetime","trashed_datetime","last_message_datetime","last_received_message_datetime","updated_datetime","closed_datetime","snooze_datetime","tags"],"title":"ticket http integration","type":"object"},"Account":{"type":"object","properties":{"created_datetime":{"type":"string","format":"date-time","description":"When the account was created.","example":"2017-11-23T15:59:41.966927"},"deactivated_datetime":{"type":["string","null"],"format":"date-time","description":"When the account was deactivated.","example":null},"domain":{"type":"string","description":"Gorgias domain of the account.","example":"company_name"},"settings":{"readOnly":true,"description":"Account-wide settings. E.g: business hours, satisfaction survey, etc...","example":[{"id":987,"type":"business-hours","data":{"timezone":"UTC","business_hours":{"days":"1,2,3,4,5","from_time":"09:00","to_time":"22:00"}}}],"type":"array","items":{"type":"object","properties":{"id":{"type":"integer","description":"ID of the setting.","example":987},"data":{"example":{"timezone":"UTC","business_hours":{"days":"1