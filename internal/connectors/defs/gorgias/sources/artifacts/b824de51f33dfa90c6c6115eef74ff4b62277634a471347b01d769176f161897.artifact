,"example":1234},"body_text":{"type":["string","null"],"maxLength":1000,"description":"The comment sent by the customer.","example":"Such speed, much pertinent."},"created_datetime":{"type":["string","null"],"format":"date-time","description":"When the survey was created.","example":"2019-11-16T15:59:41.966927"},"customer_id":{"type":"integer","description":"The ID of the customer who filled the survey.","example":120},"meta":{"type":["object","null"],"description":"Data associated with the satisfaction survey. You can use this parameter to store structured information (key-value data) about the satisfaction survey. This field is not used by Gorgias.","example":{"externalData":{"id":1234}}},"score":{"type":["integer","null"],"minimum":1,"maximum":5,"description":"The level of satisfaction. Scores range from 1 to 5.","example":2},"scored_datetime":{"type":["string","null"],"format":"date-time","description":"When the survey was filled by the customer.","example":"2019-11-25T15:59:41.966927"},"sent_datetime":{"type":["string","null"],"format":"date-time","description":"When the survey was sent. If is not set it means that it was not sent yet.","example":"2019-11-23T15:59:41.966927"},"should_send_datetime":{"type":["string","null"],"format":"date-time","description":"When the survey should be sent. If not set then the survey will not be sent by Gorgias.","example":"2019-11-23T15:59:41.966927"},"ticket_id":{"type":"integer","description":"The ID of the ticket the survey is associated with.","example":12},"uri":{"type":"string","readOnly":true,"description":"URI of the survey."}},"description":"Satisfaction surveys are one of the best ways to determine how well your team is supporting your customers. Find out more about how to use them here: https://docs.gorgias.com/survey/customer-satisfaction-survey\n\nCurrently there can be only one satisfaction survey per ticket."},"User":{"type":"object","properties":{"id":{"type":"integer","description":"ID of the user.","example":