a":{"description":"Ecommerce data associated with the customer.","title":"ecommerce  data","additionalProperties":{"$ref":"#/components/schemas/ShopperEcommerceData"},"type":"object"}},"required":["id","email","name","firstname","lastname","meta","channels","data","customer","integrations","external_id","note"],"title":"ticket customer","type":"object"},"TicketCustomerChannel":{"additionalProperties":false,"properties":{"id":{"description":"ID of the object","title":"id","type":"integer"},"type":{"description":"Either the slug of a non-legacy channel or one of email,phone,chat,twitter,facebook,instagram,instagram-direct-message,whatsapp,whatsapp-bsuid","examples":["email"],"title":"type","type":"string"},"address":{"description":"Address can be email, phone, facebook id, etc...","examples":["marie@gorgias.io"],"title":"address","type":"string"},"preferred":{"default":false,"description":"Is this the preferred or (primary) channel to contact this user.","title":"preferred","type":"boolean"},"created_datetime":{"description":"When the user channel was created.","format":"date-time","title":"created  datetime","type":"string"},"updated_datetime":{"description":"When the user channel was last updated.","title":"updated  datetime","format":"date-time","type":"string"},"deleted_datetime":{"description":"When the user channel was deleted.","title":"deleted  datetime","format":"date-time","type":"string"},"user":{"$ref":"#/components/schemas/TicketCustomerChannelCustomer"},"customer":{"$ref":"#/components/schemas/TicketCustomerChannelCustomer"}},"required":["id","type","address","created_datetime","updated_datetime","deleted_datetime","user","customer"],"title":"ticket customer channel","type":"object"},"TicketCustomerChannelCustomer":{"additionalProperties":false,"properties":{"id":{"description":"ID of the object","title":"id","type":"integer"},"name":{"description":"Full name of the customer","examples":["John Smith"],"title":"name","type":"string"}},"required":["id","name"],"title":"ticket customer channel customer","type":"object"},"TicketEvent":{"additionalProperties":false,"properties":{"id":{"description":"ID of the event.","examples":[1234],"title":"id","type":"integer"},"type":{"description":"Type of the event. Event types are used to discriminate between events. List of event types: `account-created`, `account-deactivated`, `account-setting-created`, `account-setting-updated`, `account-updated`, `account-renamed`, `action-executed`, `facebook-comment-created`, `facebook-comment-deleted`, `facebook-comment-edited`, `facebook-comment-hidden`, `facebook-comment-unhidden`, `facebook-comment-liked`, `facebook-comment-unliked`, `facebook-message-created`, `facebook-message-deleted`, `facebook-message-edited`, `facebook-post-created`, `facebook-post-deleted`, `facebook-post-edited`, `facebook-review-deleted`, `integration-created`, `integration-deleted`, `integration-updated`, `integration-deactivated`, `integration-reactivation-started`, `integration-reactivated`, `integration-data-item-created`, `integration-data-item-deleted`, `macro-created`, `macro-deleted`, `macro-updated`, `macro-applied`, `macro-params-updated`, `macro-archived`, `macro-unarchived`, `rule-created`, `rule-priority-updated`, `rule-deleted`, `rule-executed`, `rule-updated`, `rule-deactivated`, `rule-reactivated`, `rules-pipeline-executed`, `subscription-created`, `subscription-updated`, `subscription-self-serve-changed`, `tag-created`, `tag-deleted`, `tag-merged`, `tag-updated`, `tag-renamed`, `team-created`, `team-deleted`, `team-updated`, `team-member-created`, `team-member-deleted`, `ticket-assigned`, `ticket-chat-updated`, `ticket-closed`, `ticket-created`, `ticket-customer-updated`, `ticket-deleted`, `ticket-excluded-from-auto-merge`, `ticket-excluded-from-csat`, `ticket-marked-spam`, `ticket-merged`, `ticket-read-status-updated`, `ticket-reopened`, `ticket-satisfaction-survey-skipped`, `ticket-self-unsnoozed`, `ticket-sla-policy-assigned`, `ticket-snoozed`, `ticket-split`, `ticket-subject-updated`, `ticket-tags-added`, `ticket-tags-removed`, `ticket-team-assigned`, `ticket-team-unassigned`, `ticket-trashed`, `ticket-typing-activity-shopper-started`, `ticket-unassigned`, `ticket-unmarked-spam`, `ticket-untrashed`, `ticket-updated`, `ticket-viewed`, `ticket-handed-over`, `ticket-message-chat-created`, `ticket-message-created`, `ticket-message-deleted`, `ticket-message-failed`, `ticket-message-summary-created`, `ticket-message-updated`, `customer-created`, `customer-updated`, `customer-merged`, `customer-deleted`, `customer-external-data-updated`, `custom-field-created`, `custom-field-updated`, `custom-field-condition-created`, `custom-field-condition-updated`, `custom-field-condition-enabled`, `custom-field-condition-disabled`, `custom-field-condition-deleted`, `custom-fields-ticket-values-updated`, `self-service-configurations-updated`, `self-service-configurations-update-started`, `user-created`, `user-invited`, `user-updated`, `user-mentioned`, `user-deleted`, `user-logged-in`, `user-logged-out`, `user-impersonated`, `user-password-changed`, `user-password-reset`, `user-2fa-changed`, `user-status-changed`, `user-setting-created`, `user-setting-updated`, `custom-availability-status-created`, `custom-availability-status-updated`, `custom-availability-status-deleted`, `views-count-updated`, `view-deactivated`, `view-created`, `view-deleted`, `view-updated`, `view-section-created`, `view-section-updated`, `view-section-deleted`, `widget-created`, `widget-deleted`, `widget-updated`, `satisfaction-survey-sent`, `satisfaction-survey-updated`, `satisfaction-survey-responded`.","examples":["ticket-closed"],"title":"type","type":"string"},"user":{"description":"The user who triggered the event if any.","examples":[{"email":"steve@company.com","firstname":"Steve","id":3924,"lastname":"Frazeli","name":"Steve Frazelli"}],"$ref":"#/components/schemas/TicketEventUser"},"data":{"description":"Data associated with the event (key-value data).","examples":[null],"title":"data","type":"object"},"created_datetime":{"description":"When the event was created.","examples":["2019-11-16T15:59:41.966927"],"format":"date-time","title":"created  datetime","type":"string"}},"required":["id","type","user","data","created_datetime"],"title":"ticket event","type":"object"},"TicketEventUser":{"additionalProperties":false,"properties":{"id":{"description":"ID of the user.","examples":[3924],"title":"id","type":"integer"},"firstname":{"description":"First name of the user.","examples":["Steve"],"title":"firstname","type":"string"},"lastname":{"description":"Last name of the user.","examples":["Frazeli"],"title":"lastname","type":"string"},"name":{"description":"Full name of the user.","examples":["Steve Frazelli"],"title":"name","type":"string"},"email":{"description":"Email address of the user. `password_confirmation` field must be provided to change the email.","examples":["steve@company.com"],"title":"email","type":"string"}},"required":["id","firstname","lastname","name","email"],"title":"ticket event user","type":"object"},"TicketMessage":{"additionalProperties":false,"description":"A ticket-message represents a message (an email, an SMS, a Facebook comment, chat message, etc..) under a normalized format.\nThere are 3 types of messages:\n  - Outgoing messages: messages sent by your company (by rules or support agents) to your customers.\n  - Incoming messages: messages sent by your [customers](#the-customer-object) to your company.\n  - Internal notes: internal messages sent between support agents ([users](#the-user-object)). Internal notes are not sent/shared with your customers.\n\nA ticket-message is associated with only one ticket.","properties":{"id":{"description":"ID of the message.","examples":[924712],"title":"id","type":"integer"},"uri":{"description":"URI of the message.","title":"uri","type":"string"},"message_id":{"description":"ID of the message on the service that sent the message.It can be the ID of an email, a Messenger message, a Facebook comment, etc...","examples":["<123345676453.2445.234@web>"],"title":"message  id","type":"string"},"ticket_id":{"description":"The ID of the ticket the message is associated with.","examples":[12],"title":"ticket  id","type":"integer"},"external_id":{"description":"ID of the message in a foreign system (Aircall, Zendesk, etc...). This field is not used by Gorgias, feel free to set it as you wish.","examples":["MSG-78545"],"title":"external  id","type":"string"},"public":{"default":true,"description":"Whether the message was sent/receive by a customer. Internal notes are not public.","examples":[true],"title":"public","type":"boolean"},"channel":{"anyOf":[{"$ref":"#/components/schemas/LegacyChannelSlug"},{"type":"string"}],"description":"The channel used to send the message.","examples":["email"],"title":"channel"},"via":{"$ref":"#/components/schemas/TicketVia","description":"How the message has been received, or sent from Gorgias.","examples":["api"]},"source":{"description":"Information used to route the message. It contains the names and the addresses of the sender and receivers.","examples":[{"from":{"address":"sender@gorgias.io","id":7,"name":"Sender Doe"},"to":[{"address":"receiver@gorgias.io","id":8,"name":"Receiver Doe"}],"type":"email"}],"$ref":"#/components/schemas/TicketMessageSource"},"sender":{"$ref":"#/components/schemas/TicketMessageUserOrCustomer","description":"The person who sent the message. It can be a user or a customer.","examples":[{"id":93}]},"auth_customer_identity":{"description":"Identity of the authenticated customer, if any, in the context of a message sent on a channel that does not require authentication such as email, SMS or Gorgias chat.This attribute is used to differentiate messages sent by unauthenticated and authenticated customers.","$ref":"#/components/schemas/TicketMessageAuthCustomerIdentity"},"integration_id":{"description":"ID of the integration that either received or sent the message.","examples":[28643],"title":"integration  id","type":"integer"},"intents":{"items":{"$ref":"#/components/schemas/TicketMessageIntent"},"title":"intents","type":"array"},"rule_id":{"description":"ID of the rule which sent the message, if any.","examples":[89465],"title":"rule  id","type":"integer"},"from_agent":{"description":"Whether the message was sent by your company to a customer, or the opposite.","examples":[true],"title":"from  agent","type":"boolean"},"receiver":{"description":"The primary receiver of the message. It can be a user or a customer. Optional when the source type is \"internal-note\".","examples":[{"id":8}],"$ref":"#/components/schemas/TicketMessageUserOrCustomer"},"subject":{"description":"The subject of the message.","examples":["Re:Refund request"],"title":"subject","type":"string"},"body_text":{"description":"The full text version of the body of the message, if any.","examples":["Hello,\n\n        I can't place an order on your site, it says: I don't have enough credit.\n        How can I add some credits?\n\n        Cheers,\n        John Doe\n        "],"title":"body  text","type":"string"},"body_html":{"description":"The full HTML version of the body of the message, if any.","examples":["Hello,<br><br>\n\n            I can't place an order on your site, it says: I don't have enough credit.<br>\n            How can I add some credits?<br><br>\n\n            Cheers,<br>\n            John Doe\n            "],"title":"body  html","type":"string"},"stripped_text":{"description":"The text version of the body of the message without email signatures and previous replies.","examples":[null],"title":"stripped  text","type":"string"},"stripped_html":{"description":"The HTML version of the body of the message without email signatures and previous replies.","examples":[null],"title":"stripped  html","type":"string"},"stripped_signature":{"title":"stripped  signature","type":"string"},"attachments":{"description":"A list of files attached to the message.","examples":[[]],"title":"attachments","items":{"$ref":"#/components/schemas/TicketMessageAttachment"},"type":"array"},"macros":{"description":"A list of macros.","examples":[[]],"title":"macros","items":{"$ref":"#/components/schemas/TicketMessageMacro"},"type":"array"},"actions":{"description":"A list of actions executed before the message was sent. These actions are set by macros.","examples":[[]],"title":"actions","items":{"type":"object"},"type":"array"},"headers":{"description":"Message headers. Used for email messages.","examples":[{"My-Header":"foo"}],"title":"headers","type":"object"},"imported":{"description":"Whether the message was created by a historical import.","examples":[false],"title":"imported","type":"boolean"},"meta":{"description":"Metadata associated with the message.\n\nYou can use this field to store structured information (key-value data) about the message.\n\nReserved keys:\n\n- `current_page`: The page from where the user is currently chatting.\n- `relevant_content_indexes`: Indexes containing relevant text of the message.\n- `is_quick_reply`: Whether the message is a \"quick reply\".\n- `campaigns`: ID of the chat campaign the message is replying to.\n- `campaigns_id`: ID of the chat campaign that sent this message.\n- `self_service_flow`: An object containing metadata of the self-service flow associated to the message.\n","examples":[{}],"title":"meta"},"created_datetime":{"description":"When the message was created.","examples":["2020-01-27T10:42:21.468912"],"format":"date-time","title":"created  datetime","type":"string"},"processed_datetime":{"description":"When the message was processed by Gorgias. Differs from `created_datetime` which refers to the external service.","examples":["2020-01-27T10:42:21.468912"],"title":"processed  datetime","format":"date-time","type":"string"},"deleted_datetime":{"description":"When the message was deleted.","examples":["2020-01-27T10:42:21.468912"],"title":"deleted  datetime","format":"date-time","type":"string"},"sent_datetime":{"description":"When the message was sent. If omitted, the message will be sent by Gorgias.","title":"sent  datetime","format":"date-time","type":"string"},"failed_datetime":{"description":"When the message failed to be sent. Messages that couldn't be sent can be resend.","examples":[null],"title":"failed  datetime","format":"date-time","type":"string"},"opened_datetime":{"description":"When the message was opened by the primary receiver.","examples":["2019-07-05T15:22:46.472436"],"title":"opened  datetime","format":"date-time","type":"string"},"last_sending_error":{"description":"Details of the last error encountered when Gorgias attempted to send the message.","examples":[null],"$ref":"#/components/schemas/TicketMessageSendingError"},"is_retriable":{"description":"It determines if the message can be retried or not.","title":"is  retriable","type":"boolean"},"replied_by":{"description":"The message designated as a response to the current message. This field is temporary and only provided to the web app.","title":"replied  by","$ref":"#/components/schemas/TicketMessageRepliedByOrTo"},"replied_to":{"description":"The message designated as replied by the current message. This field is temporary and only provided to the web app.","title":"replied  to","$ref":"#/components/schemas/TicketMessageRepliedByOrTo"}},"required":["id","uri","message_id","ticket_id","external_id","channel","via","source","sender","auth_customer_identity","integration_id","intents","rule_id","from_agent","receiver","subject","body_text","body_html","stripped_text","stripped_html","stripped_signature","attachments","actions","imported","meta","created_datetime","processed_datetime","sent_datetime","failed_datetime","opened_datetime","last_sending_error","is_retriable"],"title":"ticket message","type":"object"},"TicketMessageAttachment":{"properties":{"url":{"description":"The URL to access to the attached file.","examples":["https://gorgias.io/attachments/file.pdf"],"title":"url","type":"string"},"name":{"description":"The name of the file.","examples":["file.pdf"],"title":"name","type":"string"},"size":{"description":"The size of the file, in bytes.","examples":[784554],"title":"size","type":"integer"},"content_type":{"description":"The MIME type of the file.","examples":["application/pdf"],"title":"content  type","type":"string"},"public":{"description":"Whether or not the attachment can be accessed.","examples":[true],"title":"public","type":"boolean"},"extra":{"description":"Extra information for custom content type attachment","examples":[{}],"title":"extra"}},"required":["url","content_type"],"title":"ticket message attachment","type":"object"},"TicketMessageAuthCustomerIdentity":{"additionalProperties":false,"properties":{"service":{"$ref":"#/components/schemas/TicketMessageAuthCustomerIdentityService","description":"The service/channel used to authenticate the customer. E.g.: email, phone, shopify"},"identifier":{"description":"The ID of the customer related to the service. E.g.: email address, phone number, Shopify customer ID, etc.","title":"identifier","type":"string"}},"required":["service","identifier"],"title":"ticket message auth customer identity","type":"object"},"TicketMessageAuthCustomerIdentityService":{"additionalProperties":false,"properties":{"id":{"description":"The ID of the service the identity belongs to.","title":"id","type":"string"},"name":{"description":"The name of the service the identity belongs to.","title":"name","type":"string"}},"required":["id","name"],"title":"ticket message auth customer identity service","type":"object"},"TicketMessageIntent":{"additionalProperties":false,"properties":{"name":{"description":"The intention the message probably has, example: discount/request","examples":["discount/request"],"title":"name","type":"string"},"rejected":{"description":"Whether or not the intent was rejected","title":"rejected","type":"boolean"},"is_user_feedback":{"description":"Whether or not the intent comes from a user feedback","title":"is  user  feedback","type":"boolean"}},"required":["name","rejected","is_user_feedback"],"title":"ticket message intent","type":"object"},"TicketMessageMacro":{"additionalProperties":false,"properties":{"id":{"exclusiveMinimum":0,"title":"id","type":"integer"}},"required":["id"],"title":"ticket message macro","type":"object"},"TicketMessageRepliedByOrTo":{"additionalProperties":false,"properties":{"integration_id":{"description":"ID of the integration which created the message.","examples":[28643],"title":"integration  id","type":"integer"},"message_id":{"description":"ID of the message in Gorgias.","examples":[1234],"title":"message  id","type":"string"},"created_datetime":{"description":"When the message was created.","examples":["2020-01-27T10:42:21.468912"],"format":"date-time","title":"created  datetime","type":"string"},"body_text":{"description":"The full text version of the body of the message, if any.","examples":["Hello,\n\n        I can't place an order on your site, it says: I don't have enough credit.\n        How can I add some credits?\n\n        Cheers,\n        John Doe\n        "],"title":"body  text","type":"string"},"source":{"description":"Information used to route the message. It contains the names and the addresses of the sender and receivers.","examples":[{"from":{"address":"sender@gorgias.io","id":7,"name":"Sender Doe"},"to":[{"address":"receiver@gorgias.io","id":8,"name":"Receiver Doe"}],"type":"email"}],"$ref":"#/components/schemas/TicketMessageSource"},"customer":{"description":"The customer who sent the message.","examples":[{"id":93}],"$ref":"#/components/schemas/TicketMessageUserOrCustomer"},"user":{"description":"The agent who sent the message.","examples":[{"id":95}],"$ref":"#/components/schemas/TicketMessageUserOrCustomer"}},"required":["integration_id","message_id","created_datetime","body_text","source","customer","user"],"title":"ticket message replied by or to","type":"object"},"TicketMessageSendingError":{"additionalProperties":false,"properties":{"error":{"title":"error","type":"string"}},"required":["error"],"title":"ticket message sending error","type":"object"},"TicketMessageSourceAddress":{"properties":{"name":{"title":"name","type":"string"},"address":{"title":"address","type":"string"}},"title":"ticket message source address","type":"object"},"TicketMessageSource":{"properties":{"type":{"description":"Describes a more detailed channel information of how the message was sent/received. Either the slug of a non-legacy channel or one of aircall,api,app,chat,chat-contact-form,chat-offline-capture,contact-form,email,facebook-comment,facebook-message,facebook-messenger,facebook-post,facebook-mention-post,facebook-mention-comment,facebook,facebook-review,facebook-review-comment,form,help-center,helpdesk,instagram-ad-comment,instagram-ad-media,instagram-comment,instagram-mention-comment,instagram-media,instagram-mention-media,instagram,instagram-direct-message,internal-note,ottspott-call,phone,rule,self_service,shopify,sms,system-message,twilio,yotpo-review,yotpo-review-public-comment,yotpo-review-private-comment,twitter-tweet,twitter-quoted-tweet,twitter-mention-tweet,twitter-direct-message,help-center-contact-form,whatsapp-message.","title":"type","type":"string"},"to":{"description":"A list of To addresses. To and From are usually present for most channel types.","title":"to","items":{"$ref":"#/components/schemas/TicketMessageSourceAddress"},"type":"array"},"cc":{"description":"A list of CC addresses. Only present in an email context.","title":"cc","items":{"$ref":"#/components/schemas/TicketMessageSourceAddress"},"type":"array"},"bcc":{"description":"A list of BCC addresses. Only present in an email context.","title":"bcc","items":{"$ref":"#/components/schemas/TicketMessageSourceAddress"},"type":"array"},"from":{"description":"A single From address. To and From are usually present for most channel types.","$ref":"#/components/schemas/TicketMessageSourceAddress"},"extra":{"title":"extra"}},"required":["type"],"title":"ticket message source","type":"object"},"TicketMessageUserOrCustomer":{"additionalProperties":false,"properties":{"id":{"title":"id","type":"integer"},"email":{"title":"email","type":"string"},"name":{"title":"name","type":"string"},"firstname":{"title":"firstname","type":"string"},"lastname":{"title":"lastname","type":"string"},"meta":{"title":"meta"}},"required":["id","email","name","firstname","lastname","meta"],"title":"ticket message user or customer","type":"object"},"TicketMeta":{"title":"ticket meta"},"TicketReplyOption":{"additionalProperties":false,"properties":{"answerable":{"title":"answerable","type":"boolean"},"reason":{"title":"reason","type":"string"},"integrations":{"title":"integrations","items":{"$ref":"#/components/schemas/TicketReplyOptionIntegration"},"type":"array"}},"required":["answerable"],"title":"ticket reply option","type":"object"},"TicketReplyOptionIntegration":{"additionalProperties":false,"properties":{"id":{"title":"id","type":"integer"},"name":{"title":"name","type":"string"},"address":{"title":"address","type":"string"}},"required":["id","name","address"],"title":"ticket reply option integration","type":"object"},"TicketSatisfactionSurvey":{"additionalProperties":false,"properties":{"id":{"description":"ID of the survey.","examples":[1234],"title":"id","type":"integer"},"customer_id":{"description":"The ID of the customer who filled the survey.","examples":[120],"title":"customer  id","type":"integer"},"ticket_id":{"description":"The ID of the ticket the survey is associated with.","examples":[12],"title":"ticket  id","type":"integer"},"sent_datetime":{"description":"When the survey was sent. If is not set it means that it was not sent yet.","examples":["2019-11-23T15:59:41.966927"],"title":"sent  datetime","format":"date-time","type":"string"},"scored_datetime":{"description":"When the survey was filled by the customer.","examples":[