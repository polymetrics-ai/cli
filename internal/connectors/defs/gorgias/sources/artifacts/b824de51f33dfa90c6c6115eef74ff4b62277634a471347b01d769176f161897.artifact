","format":"date-time","description":"When the tag was created.","example":"2020-07-1300:00:00-05:00"},"decoration":{"description":"Information related to the style of the tag.","example":{"color":"#F58D86"},"type":"object","properties":{"color":{"type":"string","description":"The color of the tag (Hex color code).","example":"#F58D86"}},"required":["color"]},"deleted_datetime":{"type":"string","format":"date-time","description":"When the tag was deleted.","example":"2020-07-1500:00:00-05:00"},"description":{"type":"string","description":"Short description of the tag.","example":"Mark a ticket as urgent"},"name":{"type":"string","description":"Name of the tag. Tags' names are case sensitive.","example":"urgent"},"usage":{"type":"integer","default":0,"description":"Number of tickets this tag is associated with.","example":123},"uri":{"type":"string","description":"URI of the tag"}}}}}}}},"tags":["Tickets"]},"put":{"summary":"Set ticket tags","operationId":"update-ticket-tags","description":"Set a ticket's tags.","parameters":[{"in":"path","name":"ticket_id","description":"The ID of the ticket.","required":true,"schema":{"type":"integer"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"names":{"type":"array","description":"The names of the tags.","example":["refund","billing"],"items":{"type":"string"}},"ids":{"type":"array","description":"The IDs of the tags.","example":[12,34],"items":{"type":"integer"}}}}}}},"responses":{"202":{"description":"No content."}},"tags":["Tickets"]}},"/api/tickets/{ticket_id}/custom-fields/{id}":{"delete":{"summary":"Delete ticket field value","operationId":"delete-ticket-custom-field","description":"Delete a custom field value from a ticket.\n\nSystem-managed fields (e.g. *AI Agent Outcome*, *AI Intent*) can\nonly be deleted by Gorgias internal apps.\n","parameters":[{"in":"path","name":"ticket_id","description":"The ID of the ticket.","required":true,"schema":{"type":"integer"}},{"in":"path","name":"id","description":"The ID of the custom field.","required":true,"schema":{"type":"integer"}}],"responses":{"204":{"description":"No content."}},"tags":["Tickets"]},"put":{"summary":"Update ticket field value","operationId":"update-ticket-custom-field","description":"Update a ticket's custom field value.","parameters":[{"in":"path","name":"ticket_id","description":"The ID of the ticket.","required":true,"schema":{"type":"integer"}},{"in":"path","name":"id","description":"The ID of the custom field.","required":true,"schema":{"type":"integer"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"oneOf":[{"type":"string"},{"type":"integer"},{"type":"boolean"}]}}}},"responses":{"200":{"description":"Ticket's updated custom fields value.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TicketCustomFieldValue"}}}}},"tags":["Tickets"]}},"/api/tickets/{ticket_id}/custom-fields":{"get":{"summary":"List ticket field values","operationId":"list-ticket-custom-fields","description":"List all custom fields for a ticket.","parameters":[{"in":"path","name":"ticket_id","description":"The ID of the ticket.","required":true,"schema":{"type":"integer"}}],"responses":{"200":{"description":"List of custom field values.","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/TicketCustomFieldValue"}}}}}},"tags":["Tickets"]},"put":{"summary":"Update ticket fields values","operationId":"update-ticket-custom-fields","description":"Replace the custom field values for a ticket.\n\n**Important — replace-all semantics:** The request body must contain\n*all* custom field values you want the ticket to have. Any field that\ncurrently has a value on the ticket but is **not included** in the\nrequest body will be deleted.\n\nSome system-managed fields (e.g. *AI Agent Outcome*, *AI Intent*)\ncan only be deleted by Gorgias internal apps.\n\n**Safe pattern:** fetch the current values with\n`GET /api/tickets/{ticket_id}/custom-fields`, merge your changes, and\nsend the full list back.\n","parameters":[{"in":"path","name":"ticket_id","description":"The ID of the ticket.","required":true,"schema":{"type":"integer"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateTicketCustomFieldValues"}}}},"responses":{"200":{"description":"List of ticket's updated custom fields values.","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/TicketCustomFieldValue"}}}}}},"tags":["Tickets"]}},"/api/messages":{"get":{"summary":"List messages","operationId":"list-messages","description":"List messages matching the given parameters, paginated.","parameters":[{"in":"query","name":"cursor","description":"Value indicating your position in the list of all messages. If omitted, the first messages of the list will be returned.","schema":{"type":["string","null"],"example":"cHJldl9fNl9fMjAyMS0wMy0wMyAwNjowMDowMA=="},"required":false},{"in":"query","name":"limit","description":"Maximum number of messages to return.","schema":{"type":"integer","default":30,"minimum":1,"maximum":100},"required":false},{"in":"query","name":"order_by","description":"Attribute used to order messages.","schema":{"type":"string","default":"created_datetime:desc","enum":["created_datetime:asc","created_datetime:desc"]},"required":false},{"in":"query","name":"ticket_id","description":"The ID of the ticket the messages are associated with.","schema":{"type":["integer","null"],"default":null,"example":1},"required":false}],"responses":{"200":{"description":"A list of messages.","content":{"application/json":{"schema":{"additionalProperties":false,"properties":{"object":{"title":"object","type":"string"},"uri":{"title":"uri","type":"string"},"data":{"items":{"$ref":"#/components/schemas/TicketMessage"},"title":"data","type":"array"},"meta":{"$ref":"#/components/schemas/CursorPaginationMeta"}},"required":["object","uri","da