],"title":"deactivated  datetime","format":"date-time","type":"string"},"id":{"title":"id","type":"integer"}},"required":["id"],"title":"custom field item","type":"object"},"UpdateCustomFieldList":{"items":{"$ref":"#/components/schemas/UpdateCustomFieldItem"},"title":"custom field list","type":"array"},"Event":{"type":"object","properties":{"id":{"type":"integer","description":"ID of the event.","example":1234},"context":{"type":["string","null"],"description":"An uuid4 used to group a sequence of related events together, meaning that an event triggered another event and so on.","format":"uuid","example":"dd4ff312-69df-494a-be96-1a58b3d8b8e0"},"created_datetime":{"type":"string","format":"date-time","readOnly":true,"description":"When the event was created.","example":"2019-11-16T15:59:41.966927"},"data":{"type":"object","description":"Data associated with the event (key-value data).","example":null},"object_id":{"type":"integer","description":"The ID of the Gorgias object associated with the event.","example":123},"object_type":{"type":"string","enum":["Account","AccountSetting","Customer","CustomField","CustomFieldCondition","CustomUserAvailabilityStatus","CustomerExternalData","Integration","Macro","Order","Role","Rule","SatisfactionSurvey","Shopper","ShopperAddress","Subscription","Tag","Team","TicketMessage","Ticket","User","UserSetting","View","Widget"],"description":"The type of the existing Gorgias object associated with the event.","example":"Ticket"},"type":{"type":"string","description":"Type of the event. Event types are used to discriminate between events. List of event types: `account-created`, `account-deactivated`, `account-setting-created`, `account-setting-updated`, `account-updated`, `account-renamed`, `action-executed`, `facebook-comment-created`, `facebook-comment-deleted`, `facebook-comment-edited`, `facebook-comment-hidden`, `facebook-comment-unhidden`, `facebook-comment-liked`, `facebook-comment-unliked`, `facebook-message-created`, `facebook-message-deleted`, `facebook-message-edited`, `facebook-post-created`, `facebook-post-deleted`, `facebook-post-edited`, `facebook-review-deleted`, `integration-created`, `integration-deleted`, `integration-updated`, `integration-deactivated`, `integration-reactivation-started`, `integration-reactivated`, `integration-data-item-created`, `integration-data-item-deleted`, `macro-created`, `macro-deleted`, `macro-updated`, `macro-applied`, `macro-params-updated`, `macro-archived`, `macro-unarchived`, `rule-created`, `rule-priority-updated`, `rule-deleted`, `rule-executed`, `rule-updated`, `rule-deactivated`, `rule-reactivated`, `rules-pipeline-executed`, `subscription-created`, `subscription-updated`, `subscription-self-serve-changed`, `tag-created`, `tag-deleted`, `tag-merged`, `tag-updated`, `tag-renamed`, `team-created`, `team-deleted`, `team-updated`, `team-member-created`, `team-member-deleted`, `ticket-assigned`, `ticket-chat-updated`, `ticket-closed`, `ticket-created`, `ticket-customer-updated`, `ticket-deleted`, `ticket-excluded-from-auto-merge`, `ticket-excluded-from-csat`, `ticket-marked-spam`, `ticket-merged`, `ticket-read-status-updated`, `ticket-reopened`, `ticket-satisfaction-survey-skipped`, `ticket-self-unsnoozed`, `ticket-sla-policy-assigned`, `ticket-snoozed`, `ticket-split`, `ticket-subject-updated`, `ticket-tags-added`, `ticket-tags-removed`, `ticket-team-assigned`, `ticket-team-unassigned`, `ticket-trashed`, `ticket-typing-activity-shopper-started`, `ticket-unassigned`, `ticket-unmarked-spam`, `ticket-untrashed`, `ticket-updated`, `ticket-viewed`, `ticket-handed-over`, `ticket-message-chat-created`, `ticket-message-created`, `ticket-message-deleted`, `ticket-message-failed`, `ticket-message-summary-created`, `ticket-message-updated`, `customer-created`, `customer-updated`, `customer-merged`, `customer-deleted`, `customer-external-data-updated`, `custom-field-created`, `custom-field-updated`, `custom-field-condition-created`, `custom-field-condition-updated`, `custom-field-condition-enabled`, `custom-field-condition-disabled`, `custom-field-condition-deleted`, `custom-fields-ticket-values-updated`, `self-service-configurations-updated`, `self-service-configurations-update-started`, `user-created`, `user-invited`, `user-updated`, `user-mentioned`, `user-deleted`, `user-logged-in`, `user-logged-out`, `user-impersonated`, `user-password-changed`, `user-password-reset`, `user-2fa-changed`, `user-status-changed`, `user-setting-created`, `user-setting-updated`, `custom-availability-status-created`, `custom-availability-status-updated`, `custom-availability-status-deleted`, `views-count-updated`, `view-deactivated`, `view-created`, `view-deleted`, `view-updated`, `view-section-created`, `view-section-updated`, `view-section-deleted`, `widget-created`, `widget-deleted`, `widget-updated`, `satisfaction-survey-sent`, `satisfaction-survey-updated`, `satisfaction-survey-responded`.","example":"ticket-closed"},"user_id":{"type":"integer","description":"ID of the user who triggered the event. If empty, the event has been triggered automatically (E.g: by a rule).","example":123},"uri":{"type":"string","readOnly":true,"description":"URI of the event."}},"description":"Events are our way of letting you know when something interesting happens in your account. For example, when a ticket is created we create a `ticket-created` event; When a user is updated we create a `user-updated` event."},"File":{"type":"object","properties":{"content_type":{"type":"string","description":"The content type of the file.","example":"image/png"},"name":{"type":"string","description":"The name of the file.","example":"package-damaged.png"},"size":{"type":"integer","description":"The size of the file (in bytes).","example":"784554"},"url":{"type":"string","format":"url","description":"The URL of the file.","example":"https://gorgias.io/attachments/package-damaged.png"}},"description":"A file object represents a file hosted on Gorgias's servers. You can upload files to attach them to messages."},"Integration":{"type":"object","properties":{"id":{"type":"integer","description":"ID of the integration.","example":123},"created_datetime":{"type":["string","null"],"format":"date-time","description":"When the integration was created.","example":"2021-01-07T13:00:00.123456"},"deactivated_datetime":{"type":["string","null"],"format":"date-time","description":"When the integration was deactivated."},"description":{"type":["string","null"],"nullable":true,"description":"Description about the integration."},"http":{"type":"object","description":"Only available for HTTP integrations, defines the configuration of the integration.","example":{"id":987,"url":"https://company.com/api/customers?email={{ticket.customer.email}}","method":"GET","form":{"hello":"world","ticket_id":"{{ticket.id}}"},"triggers":{"ticket_created":true,"ticket_updated":true,"ticket_message_created":true,"ticket_self_unsnoozed":true,"ticket_message_failed":true,"ticket_assignee_updated":true,"ticket_status_updated":true,"ticket_handed_over":true},"request_content_type":"application/json","response_content_type":"application/json"},"properties":{"form":{"default":{},"type":["null"],"description":"Data to send to the external service. It can either be a raw JSON object (if `request_content_type` is `application/json`) or a key-value object representing form data (if `request_content_type` is `application/x-www-form-urlencoded`). You can use variables like {{ticket.customer.email}} as values for the request. Check all properties from a [customer](#the-customer-object), or review the list of [Gorgias variables](https://docs.gorgias.com/macros/macro-variables#gorgias_variables) for inspiration.","example":{"hello":"world","ticket_id":"{{ticket.id}}"}},"method":{"type":"string","default":"GET","enum":["GET","POST","PUT","DELETE","HEAD","PATCH"],"description":"HTTP method expected by the external service.","example":"GET"},"request_content_type":{"type":"string","default":"application/json","enum":["application/json","application/x-www-form-urlencoded"],"description":"Content type of the outgoing request to the external service.","example":"application/json"},"response_content_type":{"type":"string","default":"application/json","enum":["application/json"],"description":"Content type of the incoming response from the external service.","example":"application/json"},"triggers":{"description":"Events that will trigger the request to the external service.","example":{"ticket_created":true,"ticket_updated":true,"ticket_message_created":true,"ticket_self_unsnoozed":true,"ticket_message_failed":true,"ticket_assignee_updated":true,"ticket_status_updated":true,"ticket_handed_over":true},"type":"object","properties":{"ticket-created":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when a ticket is created.","example":true},"ticket-updated":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when a ticket is updated.","example":true},"ticket-message-created":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when a new message is created in a ticket.","example":true},"ticket-self-unsnoozed":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when the snooze delay ends.","example":true},"ticket-message-failed":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when the message fails to send.","example":true},"ticket-assignment-updated":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when the ticket assignee is changed.","example":true},"ticket-status-updated":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when the ticket status is updated.","example":true},"ticket-handed-over":{"type":"boolean","default":false,"description":"Whether to trigger the HTTP integration when a ticket is handed over to another user. Further configuration is required.","example":true}}},"url":{"type":"string","description":"URL of the external service. You can use variables like {{ticket.customer.email}} to pass customer data to the integration. Check all properties from a [customer](#the-customer-object), or review the list of [Gorgias variables](https://docs.gorgias.com/macros/macro-variables#gorgias_variables) for inspiration.","example":"https://company.com/api/customers?email={{ticket.customer.email}}"},"oauth2":{"readOnly":true,"type":["null"],"description":"OAuth2 settings."}},"required":["url"]},"name":{"type":"string","description":"Name of the integration. Usually the email address, Facebook page name, etc.","example":"My HTTP integration"},"type":{"type":"string","enum":["http"],"description":"Type of integration.","example":"http"},"updated_datetime":{"type":["string","null"],"format":"date-time","description":"When the integration was last updated.","example":"2021-01-07T13:00:00.123456"},"user":{"description":"User which created this integration.","type":"object","properties":{"id":{"type":"integer","description":"ID of the object"}}},"uri":{"type":"string","readOnly":true,"description":"URI of the integration."},"application_id":{"type":["string","null"],"readOnly":true,"description":"ID of the related application."},"managed":{"type":"boolean","default":false,"description":"Whether integration is managed by Gorgias."},"business_hours_id":{"type":["integer","null"],"description":"The ID of the business hour the phone integration is associated with. If null, the integration will use the default business hours."}},"required":["name"],"description":"Integrations connect Gorgias with external services (e.g. Gmail, Shopify, chat systems).\n\nThere are official Gorgias integrations that can be found in the Integrations page in the helpdesk and there are custom HTTP integrations.\n\nMost integrations use HTTP APIs."},"Job":{"type":"object","properties":{"id":{"type":"integer","description":"ID of the job.","example":1234},"cancel_requested_datetime":{"type":["string","null"],"format":"date-time","description":"When the job cancellation was requested.","example":"2019-11-23T16:31:00.966927"},"cancelled_datetime":{"type":["string","null"],"format":"date-time","description":"When the job was canceled.","example":"2019-11-23T16:32:00.966927"},"created_datetime":{"type":["string","null"],"format":"date-time","description":"When the job was created.","example":"2019-11-23T16:00:00.966927"},"ended_datetime":{"type":["string","null"],"format":"date-time","description":"When the job ended.","example":"2019-11-23T16:32:00.966927"},"failed_datetime":{"type":["string","null"],"format":"date-time","description":"When the job failed.","example":"2019-11-23T15:59:41.966927"},"info":{"type":"object","description":"Data concerning the progress of the job. E.g: how many objects the job has already processed.","example":{"progress_count":123}},"locked_datetime":{"type":["string","null"],"format":"date-time","description":"When the job was locked. A job is only locked while it's actively running.","example":"2019-11-23T16:30:01.966927"},"meta":{"type":["object","null"],"description":"Metadata associated with the job. You can use this parameter to store structured information (key-value data) about the job. This field is not used by Gorgias.","example":{"description":"This job closes all tickets created in 2018"}},"params":{"example":{"ticket_ids":[1,2,3],"updates":{"status":"open"}},"description":"The parameters of the job.","type":"object","properties":{"apply_and_close":{"type":"boolean","description":"Whether the ticket should be closed once the macro is applied on it. Only applies to `applyMacro` jobs.","example":true},"end_datetime":{"type":["string","null"],"description":"End of the interval from which to select tickets when the parameter `view` is used.","example":"2019-11-24T15:59:41.966927"},"macro_id":{"type":"integer","description":"The ID of the macro to apply on the selected tickets. Only applies to `applyMacro` jobs.","example":47},"start_datetime":{"type":["string","null"],"description":"Beginning of the interval from which to select tickets when the parameter `view` is used.","example":"2019-11-23T15:59:41.966927"},"ticket_ids":{"type":"array","description":"A list of ticket IDs to be processed by the job.","example":[1,2,3],"items":{"type":"integer"}},"url":{"type":"string","description":"The path to the file to import.","example":"https://example.com/file.csv"},"updates":{"type":"object","description":"Object (key-value) containing all the changes to apply on the selected tickets. Only applies to `updateTicket` jobs.","example":{"status":"open"}},"view":{"type":"object","description":"A [view](#the-view-object)-like object used to select the tickets to be processed by the job.","example":{"filters":"eq(ticket.status, \"open\")"}},"view_id":{"type":"integer","description":"The ID of an existing [view](#the-view-object) used to select the tickets to be processed by the job.","example":123},"context":{"type":"object","description":"Object (key-value) containing extra context for the job","example":{"channel_connection_external_ids":["12","34"]}}}},"scheduled_datetime":{"type":["string","null"],"format":"date-time","description":"When the job was scheduled to be started. A job cannot be scheduled more than 60 minutes in the future. If unspecified, the job is queued for execution immediately after creation.","example":"2019-11-23T16:30:00.966927"},"started_datetime":{"type":["string","null"],"format":"date-time","description":"When the job started.","example":"2019-11-23T16:30:01.966927"},"status":{"type":"string","enum":["cancel_requested","canceled","done","errored","fatal_errored","pending","running","scheduled"],"description":"The status of the job. Options: cancel_requested, canceled, done, errored, fatal_errored, pending, running, scheduled","example":"canceled"},"type":{"type":"string","enum":["applyMacro","deleteTicket","exportTicket","importMacro","exportMacro","updateTicket","exportTicketDrilldown","exportConvertCampaignSalesDrilldown"],"description":"The type of the job. Options: applyMacro, deleteTicket, exportTicket, importMacro, exportMacro, updateTicket, exportTicketDrilldown, exportConvertCampaignSalesDrilldown","example":"updateTicket"},"user_id":{"type":"integer","description":"The ID of the user who created this job.","example":42},"uri":{"type":"string","readOnly":true,"description":"URI of the job."}},"description":"A job is an object used to perform long-running tasks. For example, closing 10k tickets, exporting 500k tickets, and more. \n\nJobs are processed asynchronously, meaning that once a job is created, it will run in background on Gorgias's servers. According to the type and size of the task, a job can take a few minutes or several hours to be executed. You can use our API to check the status of the job.\n\nJobs can be canceled at any time but be aware that if a job already started, changes done by this one won't be reverted. For example, if you created a job to close 10k tickets and you cancel it at some point, the already closed tickets won't be reopened."},"MacroAction":{"type":"object","properties":{"arguments":{"type":"object","description":"Parameters of the action. These parameters vary according to the name of the action.","example":{"tags":"question, order-status"}},"description":{"type":["string","null"],"description":"Description of what the action does.","nullable":true},"name":{"type":"string","description":"The name of the action.","example":"addTags"},"title":{"type":"string","description":"The title of the action.","example":"Add tags"},"type":{"type":"string","enum":["system","user"],"description":"The type of action.","example":"user"}},"required":["arguments","name","title"],"description":"A `MacroAction` is a single operation that can be applied to a ticket. An action can only be part of a [macro](#the-macro-object)."},"Macro":{"type":"object","properties":{"id":{"type":"integer","description":"ID of the macro.","example":23453},"external_id":{"type":["string","null"],"description":"External ID of the macro in a foreign system. This field is not used by Gorgias, feel free to set it to your own value.","example":"CUS-324512"},"name":{"type":"string","description":"The name of the Macro. Tips: choose a name that can be easily searched.","example":"Order status inquiry"},"intent":{"type":["string","null"],"description":"The intention of the macro should be used for.","example":"discount/request","enum":["discount/request","exchange/request","exchange/status","feedback","order/damaged","order/cancel","order/change","order/wrong","other/no_reply","other/question","other/thanks","product/recommendation","product/question","refund/request","refund/status","return/request","return/status","shipping/change","shipping/delivery-issue","shipping/policy","shipping/status","stock/request","subscription/cancel","subscription/change"]},"language":{"type":["string","null"],"description":"The language of the macro in ISO 639-1 format.","example":"en"},"usage":{"type":"integer","default":0,"readOnly":true,"description":"How many times the macro was applied on a ticket.","example":58392},"actions":{"default":[],"description":"A list of [actions](#the-macroaction-object) to be applied on tickets.","example":[{"arguments":{"tags":"question, order-status"},"name":"addTags","title":"add tags","type":"user"},{"arguments":{"body_html":"<div>Hi {{ticket.customer.firstname}},</div><br><div>Your order has been delivered.</div>","body_text":"Hi {{ticket.customer.firstname}},\n\nYour order has been delivered."},"name":"setResponseText","title":"add tags","type":"user"}],"type":"array","items":{"$ref":"#/components/schemas/MacroAction"}},"created_datetime":{"type":["string","null"],"format":"date-time","description":"When the macro was created.","example":"2019-11-23T15:59:41.966927"},"updated_datetime":{"type":["string","null"],"format":"date-time","description":"When the macro was last updated.","example":"2020-01-30T11:04:34.345123"},"archived_datetime":{"type":["string","null"],"format":"date-time","description":"When the macro was archived.","example":"2019-11-23T15:59:41.966927"},"uri":{"type":"string","readOnly":true,"description":"URI of the macro"}},"description":"A macro (canned response) is a list of [actions](#the-macroaction-object) that can be applied to tickets to modify them, and/or reply to them.Macros can be applied manually by agents or automatically by rules.\nFor example, a single macro can add a tag to the ticket, assign an agent to it and send a pre-defined response."},"ArchiveMacrosAsUser":{"additionalProperties":false,"properties":{"ids":{"description":"List of macro ids to be archived","items":{"type":"integer"},"maxItems":30,"minItems":1,"title":"ids","type":"array"}},"required":["ids"],"title":"archive macros as user","type":"object"},"ArchiveMacroAsUserResult":{"additionalProperties":false,"properties":{"id":{"title":"id","type":"integer"},"status":{"$ref":"#/components/schemas/ArchiveMacroAsUserStatusEnum"},"error":{"$ref":"#/components/schemas/MacroUsageError"}},"required":["id","status"],"title":"archive macro as user result","type":"object"},"ArchiveMacroAsUserStatusEnum":{"enum":["archived","not_found","already_archived","macro_used"],"title":"archive macro as user status enum","type":"string"},"MacroUsageError":{"additionalProperties":false,"properties":{"data":{"$ref":"#/components/schemas/MacroUsageErrorData"},"msg":{"title":"msg","type":"string"}},"required":["data","msg"],"title":"macro usage error","type":"object"},"MacroUsageErrorData":{"additionalProperties":false,"properties":{"rules":{"items":{"type":"string"},"title":"rules","type":"array"}},"required":["rules"],"title":"macro usage error data","type":"object"},"ArchiveMacrosAsUserResult":{"additionalProperties":false,"properties":{"data":{"it