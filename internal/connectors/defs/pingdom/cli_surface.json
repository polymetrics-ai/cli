    {
      "path": "create check apply",
      "summary": "Plan and execute the create check reverse-ETL action",
      "intent": "reverse_etl",
      "availability": "implemented",
      "write": "create_check",
      "source_url": "https://docs.pingdom.com/api/API_3.1.yaml",
      "flags": [
        {
          "name": "host",
          "type": "string",
          "summary": "Required host record field.",
          "maps_to": "record.host",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "summary": "Required name record field.",
          "maps_to": "record.name",
          "required": true
        },
        {
          "name": "type",
          "type": "string",
          "summary": "Required type record field.",
          "maps_to": "record.type",
          "required": true
        }
      ],
      "examples": [
        "pm pingdom create check apply --plan \u003cplan-name\u003e"
      ],
      "api_surface": [
        {
          "method": "POST",
          "path": "/checks"
        }
      ],
      "risk": "creates a new Pingdom uptime check (this action models the common HTTP-type check shape; Pingdom's other 8 check types share the same name/host/type/paused/resolution/notification fields plus type-specific attributes not modeled here, see docs.md Known limits); low-risk external mutation, no approval required",
      "approval": "requires plan, preview, approval, and execute"
    },
