    {
      "id": "read",
      "title": "Read streams",
      "commands": [
        "actions list",
        "alerting contacts list",
        "alerting teams list",
        "checks list",
        "credits list",
        "maintenance list",
        "maintenance occurrences list",
        "probes list",
        "reference list",
        "tms checks list"
      ]
    },
    {
      "id": "write",
      "title": "Reverse ETL writes",
      "commands": [
        "create check apply",
        "create contact apply",
        "create maintenance apply",
        "create team apply",
        "delete check apply",
        "delete contact apply",
        "delete maintenance apply",
        "delete team apply",
        "update check apply",
        "update contact apply",
        "update team apply"
      ]
    }
  ],
