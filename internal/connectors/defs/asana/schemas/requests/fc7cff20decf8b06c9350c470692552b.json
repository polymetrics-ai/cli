{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "assignee": {
          "type": "string"
        },
        "assignee_section": {
          "type": "string"
        },
        "completed": {
          "type": "boolean"
        },
        "custom_fields": {
          "additionalProperties": true,
          "type": "object"
        },
        "due_at": {
          "type": "string"
        },
        "due_on": {
          "type": "string"
        },
        "followers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "html_notes": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "parent": {
          "type": "string"
        },
        "projects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "start_on": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "workspace"
      ],
      "type": "object"
    }
  },
  "required": [
    "data"
  ],
  "type": "object"
}
