{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "budget_gid": {
      "maxLength": 8192,
      "type": "string"
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "additionalProperties": false,
          "properties": {
            "billable_status_filter": {
              "enum": [
                "billable",
                "non_billable",
                "any"
              ],
              "maxLength": 8192,
              "type": "string"
            }
          },
          "type": "object"
        },
        "budget_type": {
          "enum": [
            "cost",
            "time"
          ],
          "maxLength": 8192,
          "type": "string"
        },
        "estimate": {
          "additionalProperties": false,
          "properties": {
            "billable_status_filter": {
              "enum": [
                "billable",
                "non_billable",
                "any"
              ],
              "maxLength": 8192,
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            },
            "source": {
              "enum": [
                "none",
                "tasks",
                "capacity_plans"
              ],
              "maxLength": 8192,
              "type": "string"
            }
          },
          "type": "object"
        },
        "parent": {
          "maxLength": 8192,
          "type": "string"
        },
        "total": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "value": {
              "type": "number"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "opt_fields": {
      "items": {
        "enum": [
          "actual",
          "actual.billable_status_filter",
          "actual.units",
          "actual.value",
          "budget_type",
          "estimate",
          "estimate.billable_status_filter",
          "estimate.enabled",
          "estimate.source",
          "estimate.units",
          "estimate.value",
          "parent",
          "parent.name",
          "total",
          "total.enabled",
          "total.units",
          "total.value"
        ],
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "opt_pretty": {
      "type": "boolean"
    }
  },
  "required": [
    "budget_gid",
    "data"
  ],
  "type": "object"
}
