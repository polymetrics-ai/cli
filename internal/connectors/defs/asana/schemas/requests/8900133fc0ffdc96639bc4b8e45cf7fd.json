      "properties": {
        "base_role_type": {
          "enum": [
            "guest",
            "member",
            "admin",
            "super_admin"
          ],
          "maxLength": 8192,
          "type": "string"
        },
        "description": {
          "maxLength": 8192,
          "type": "string"
        },
        "is_standard_role": {
          "type": "boolean"
        },
        "name": {
          "maxLength": 8192,
          "type": "string"
        },
        "permissions": {
          "additionalProperties": false,
          "properties": {
            "allowed_guest_invites": {
              "enum": [
                "all",
                "none"
              ],
              "maxLength": 8192,
              "type": "string"
            },
            "assign_roles": {
              "type": "boolean"
            },
            "create_and_edit_ai_automations": {
              "type": "boolean"
            },
            "create_and_edit_ai_teammates": {
              "type": "boolean"
            },
            "create_app_authorization": {
              "type": "boolean"
            },
            "create_global_custom_fields": {
              "type": "boolean"
            },
            "create_goal": {
              "type": "boolean"
            },
            "create_pat_authorization": {
              "type": "boolean"
            },
            "create_portfolio": {
              "type": "boolean"
            },
            "create_project": {
              "type": "boolean"
            },
            "create_read_only_link": {
              "type": "boolean"
            },
            "create_team": {
              "type": "boolean"
            },
            "download_mobile_attachments": {
              "type": "boolean"
            },
            "export_project_data": {
              "type": "boolean"
            },
            "import_data": {
              "type": "boolean"
            },
            "manage_roles": {
              "type": "boolean"
            },
            "proactive_ai": {
              "type": "boolean"
            },
            "share_goal_with_domain": {
              "type": "boolean"
            },
            "share_portfolios_with_org": {
              "type": "boolean"
            },
            "share_teams_with_org": {
              "type": "boolean"
            },
            "standard_ai": {
              "type": "boolean"
            },
            "task_deletion_policy": {
              "enum": [
                "all",
                "owned",
                "none"
              ],
              "maxLength": 8192,
              "type": "string"
            },
            "upload_attachments": {
              "type": "boolean"
