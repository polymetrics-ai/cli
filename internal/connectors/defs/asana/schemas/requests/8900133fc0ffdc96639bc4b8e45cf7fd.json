          "permissions.upload_attachments",
          "permissions.view_public_teams",
          "permissions.view_shared_with_org_portfolios",
          "permissions.view_shared_with_org_projects",
          "permissions.view_shared_with_org_tasks",
          "workspace",
          "workspace.name"
