{
  "$schema": "event_source_contract.schema.json",
  "schema_version": 1,
  "definition_binding": {
    "sync_transport": "sync_transport.json",
    "executor": {
      "family": "declarative_api",
      "id": "asana_event_token_source"
    },
    "conformance": {
      "suite": "asana_event_token_source",
      "run_id": "source_lock_contract_v1"
    }
  },
  "source_lock": {
    "path": "sources/asana-operation-source-lock.json",
    "file_sha256": "9a0b0ca33fceb15e9091e4fa11d3934bef41c5c2066f7d2db0e6ac5f3542103d",
    "schema_version": 2,
    "connector": "asana",
    "rest_sha256": "cb3b90f4e0af56035eab0c648974f625b942a28a7144aa6c2326e38ca0bb3d56"
  },
  "provider_contract": {
    "eligible_stream": "tasks",
    "event_scope": {
      "operation_id": "asana.rest.getEvents",
      "source_location": "paths[\"/events\"].get",
      "method": "GET",
      "path": "/events",
      "resource_parameter": "resource",
      "resource_kind": "project",
      "emitted_resource_type": "task",
      "sync_parameter": "sync",
      "initial_sync": "omit",
      "initial_status": 412,
      "expired_status": 412,
      "records_pointer": "$.data",
      "next_token_pointer": "$.sync",
      "has_more_pointer": "$.has_more",
      "event_total_order": "not_documented"
    },
    "event_record": {
      "schema": "EventResponse",
      "action_pointer": "$.action",
      "resource_gid_pointer": "$.resource.gid",
      "resource_type_pointer": "$.resource.resource_type",
      "actions": [
        "changed",
        "added",
        "removed",
        "deleted",
        "undeleted"
      ],
      "tombstone_action": "deleted",
      "scope_change_action": "removed"
    },
    "hydration": {
      "operation_id": "asana.rest.getTask",
      "source_location": "paths[\"/tasks/{task_gid}\"].get",
      "method": "GET",
      "path": "/tasks/{task_gid}",
      "path_parameter": "task_gid",
      "response_pointer": "$.data"
    },
    "snapshot": {
      "operation_id": "asana.rest.getTasks",
      "source_location": "paths[\"/tasks\"].get",
      "method": "GET",
      "path": "/tasks",
      "scope_query_parameter": "project",
      "records_pointer": "$.data",
      "continuation_pointer": "$.next_page.uri"
    },
    "security": {
      "event_operation": [
        "personalAccessToken",
        "oauth2"
      ],
      "task_read_operation": [
        "personalAccessToken",
        "oauth2:tasks:read"
      ]
    }
  }
}
