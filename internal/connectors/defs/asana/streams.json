{
  "base": {
    "auth": [
      {
        "mode": "bearer",
        "token": "{{ secrets.access_token }}"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/users/me"
    },
    "error_map": [
      {
        "hint": "asana access token is missing or invalid; re-run pm credentials add asana",
        "status": 401
      },
      {
        "hint": "asana account lacks access for this request",
        "status": 403
      },
      {
        "class": "rate_limited",
        "hint": "asana rate limit exceeded; the connector will retry with backoff",
        "status": 429
      }
    ],
    "pagination": {
      "limit_param": "limit",
      "next_url_path": "next_page.uri",
      "offset_param": "offset",
      "page_size": 100,
      "size_param": "limit",
      "type": "next_url"
    },
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "name": "workspaces",
      "path": "/workspaces",
      "query": {
        "limit": "100",
        "opt_fields": "gid,name,resource_type"
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/workspaces.json"
    },
    {
      "name": "projects",
      "path": "/projects",
      "query": {
        "limit": "100",
        "opt_fields": "gid,name,resource_type,created_at,modified_at",
        "workspace": {
          "omit_when_absent": true,
          "template": "{{ config.workspace_id }}"
        }
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/projects.json"
    },
    {
      "name": "tasks",
      "path": "/tasks",
      "query": {
        "assignee": {
          "omit_when_absent": true,
          "template": "{{ config.assignee }}"
        },
        "limit": "100",
        "opt_fields": "gid,name,resource_type,created_at,modified_at,completed",
        "project": {
          "omit_when_absent": true,
          "template": "{{ config.project_id }}"
        },
        "workspace": {
          "omit_when_absent": true,
          "template": "{{ config.workspace_id }}"
        }
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/tasks.json"
    },
    {
      "name": "users",
      "path": "/users",
      "query": {
        "opt_fields": "gid,name,resource_type,email",
        "workspace": {
          "omit_when_absent": true,
          "template": "{{ config.workspace_id }}"
        }
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/users.json"
    },
    {
      "name": "teams",
      "path": "/workspaces/{{ config.workspace_id }}/teams",
      "query": {
        "opt_fields": "gid,name,resource_type,description,visibility"
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/teams.json"
    },
    {
      "name": "tags",
      "path": "/tags",
      "query": {
        "opt_fields": "gid,name,resource_type,color,notes,created_at",
        "workspace": {
          "omit_when_absent": true,
          "template": "{{ config.workspace_id }}"
        }
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/tags.json"
    },
    {
      "fan_out": {
        "ids_from": {
          "request": {
            "id_field": "gid",
            "path": "/projects",
            "records_path": "data"
          }
        },
        "into": {
          "path_var": "project_gid"
        },
        "stamp_field": "project_gid"
      },
      "name": "sections",
      "path": "/projects/{{ fanout.id }}/sections",
      "query": {
        "opt_fields": "gid,name,resource_type,created_at"
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/sections.json"
    },
    {
      "fan_out": {
        "ids_from": {
          "request": {
            "id_field": "gid",
            "path": "/tasks",
            "records_path": "data"
          }
        },
        "into": {
          "path_var": "task_gid"
        },
        "stamp_field": "task_gid"
      },
      "name": "stories",
      "path": "/tasks/{{ fanout.id }}/stories",
      "query": {
        "opt_fields": "gid,resource_type,created_at,resource_subtype,text,type,created_by.gid,created_by.name"
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/stories.json"
    },
    {
      "name": "custom_fields",
      "path": "/workspaces/{{ config.workspace_id }}/custom_fields",
      "query": {
        "opt_fields": "gid,name,resource_type,type,enabled,description"
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/custom_fields.json"
    },
    {
      "fan_out": {
        "ids_from": {
          "request": {
            "id_field": "gid",
            "path": "/projects",
            "records_path": "data"
          }
        },
        "into": {
          "path_var": "project_gid"
        },
        "stamp_field": "project_gid"
      },
      "name": "project_statuses",
      "path": "/projects/{{ fanout.id }}/project_statuses",
      "query": {
        "opt_fields": "gid,resource_type,title,text,color,created_at,modified_at"
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/project_statuses.json"
    },
    {
      "name": "team_memberships",
      "path": "/team_memberships",
      "query": {
        "opt_fields": "gid,resource_type,is_guest,is_admin,is_limited_access,user.gid,user.name,team.gid,team.name",
        "team": {
          "omit_when_absent": true,
          "template": "{{ config.team_id }}"
        },
        "workspace": {
          "omit_when_absent": true,
          "template": "{{ config.workspace_id }}"
        }
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/team_memberships.json"
    },
    {
      "name": "workspace_memberships",
