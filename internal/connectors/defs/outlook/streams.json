{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "auth": [
      {
        "mode": "custom",
        "hook": "outlook",
        "token_url": "{{ config.token_url }}",
        "client_id": "{{ secrets.client_id }}",
        "client_secret": "{{ secrets.client_secret }}",
        "token": "{{ secrets.refresh_token }}",
        "scopes": "{{ config.scope }}"
      }
    ],
    "pagination": {
      "type": "none"
    },
    "check": {
      "method": "GET",
      "path": "/me/messages"
    },
    "error_map": [
      {
        "status": 401,
        "hint": "outlook refresh-token exchange failed or access token expired; re-run pm credentials add outlook"
      },
      {
        "status": 403,
        "hint": "outlook application lacks the Graph API permission/scope for this mailbox resource"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "microsoft graph rate limit exceeded; the connector will retry with backoff"
      }
    ]
  },
  "streams": [
    {
      "name": "messages",
      "path": "/me/messages",
      "records": {
        "path": "value"
      },
      "schema": "schemas/messages.json"
    },
    {
      "name": "mail_folders",
      "path": "/me/mailFolders",
      "records": {
        "path": "value"
      },
      "schema": "schemas/mail_folders.json"
    },
    {
      "name": "events",
      "path": "/me/events",
      "records": {
        "path": "value"
      },
      "schema": "schemas/events.json"
    }
  ]
}
