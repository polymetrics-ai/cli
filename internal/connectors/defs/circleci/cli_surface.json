      "path": "add environment variable to context apply",
      "summary": "Plan and execute the add environment variable to context reverse-ETL action",
      "intent": "reverse_etl",
      "availability": "implemented",
      "write": "add_environment_variable_to_context",
      "source_url": "https://circleci.com/api/v2/openapi.json",
      "flags": [
        {
          "name": "context-id",
          "summary": "Required context id record field.",
          "type": "string",
          "maps_to": "record.context_id",
          "required": true,
          "max_bytes": 32768
        },
        {
          "name": "env-var-name",
          "summary": "Required env var name record field.",
          "type": "string",
          "maps_to": "record.env_var_name",
          "required": true,
          "max_bytes": 32768
        },
        {
          "name": "value",
          "summary": "Required value record field.",
          "type": "string",
          "maps_to": "record.value",
          "required": true,
          "max_bytes": 32768
        }
      ],
      "examples": [
        "pm circleci add environment variable to context apply --plan <plan-name>"
      ],
      "api_surface": [
        {
          "method": "PUT",
          "path": "/context/{context_id}/environment-variable/{env_var_name}"
