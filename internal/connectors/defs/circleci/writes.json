                  "type": "string"
                },
                "maxItems": 256,
                "type": "array"
              },
              "set_github_status": {
                "type": "boolean"
              },
              "setup_workflows": {
                "type": "boolean"
              },
              "write_settings_requires_admin": {
                "type": "boolean"
              }
            },
            "type": "object"
          },
          "organization": {
            "maxLength": 8192,
            "type": "string"
          },
          "project": {
            "maxLength": 8192,
            "type": "string"
          },
          "provider": {
            "enum": [
              "github",
              "gh",
              "bitbucket",
              "bb",
              "circleci"
            ],
            "maxLength": 8192,
            "type": "string"
          }
        }
      },
      "path_fields": [
        "organization",
        "project",
        "provider"
      ],
      "body_type": "json",
      "body_fields": [
        "advanced"
      ]
