      "record_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "organization",
          "project",
          "provider"
        ],
        "properties": {
          "advanced": {
            "additionalProperties": false,
            "properties": {
              "autocancel_builds": {
                "type": "boolean"
              },
              "build_fork_prs": {
                "type": "boolean"
              },
              "build_prs_only": {
