{
  "schema_version": 1,
  "source_transport": {
    "executor": {
      "family": "declarative_api",
      "id": "declarative_stream_source"
    },
    "eligible_streams": [
      "projects",
      "pipelines",
      "workflows",
      "jobs",
      "contexts",
      "schedules",
      "checkout_keys",
      "environment_variables",
      "insights_workflow_summary"
    ],
    "modes": [
      "full_overwrite",
      "full_append",
      "incremental_upsert",
      "incremental_dedupe",
      "incremental_dedupe_history"
    ],
    "delivery": {
      "idempotency": "at_least_once",
      "ordering": "source_ordered",
      "deletes": "not_available"
    },
    "conformance": {
      "suite": "batch1_declarative_stream_transport",
      "run_id": "circleci_all_executable_streams_v1"
    }
  },
  "destination_transport": {
    "executor": {
      "family": "declarative_api",
      "id": "declarative_typed_destination"
    },
    "eligible_actions": [
      "update_schedule"
    ],
    "modes": [
      "incremental_upsert"
    ],
    "delivery": {
      "idempotency": "keyed",
      "ordering": "source_ordered",
      "deletes": "not_available"
    },
    "conformance": {
      "suite": "connector_fixture_mapping",
      "run_id": "circleci_schedules_update_schedule_v1"
    },
    "acknowledgement": "durable_warehouse",
    "apply_strategies": [
      {
        "mode": "incremental_upsert",
        "strategy": "merge",
        "action": "update_schedule"
      }
    ],
    "source_bindings": [
      {
        "executor": {
          "family": "declarative_api",
          "id": "declarative_stream_source"
        },
        "eligible_streams": [
          "schedules"
        ],
        "record_mapping": {
          "kind": "input_fields",
          "inputs": [
            {
              "input": "id",
              "field": "id"
            },
            {
              "input": "name",
              "field": "name"
            },
            {
              "input": "description",
              "field": "description"
            },
            {
              "input": "timetable",
              "field": "timetable"
            },
            {
              "input": "parameters",
              "field": "parameters"
            }
          ]
        }
      }
    ]
  }
}
