{
  "schema_version": 1,
  "source_transport": {
    "executor": {"family": "declarative_api", "id": "declarative_stream_source"},
    "eligible_streams": [
      "campaigns", "newsletters", "segments", "broadcasts", "activities", "messages",
      "exports", "transactional", "object_types", "reporting_webhooks", "sender_identities",
      "snippets", "subscription_channels", "subscription_topics", "workspaces", "collections"
    ],
    "modes": ["full_overwrite", "full_append", "incremental_upsert"],
    "delivery": {"idempotency": "keyed", "ordering": "source_ordered", "deletes": "not_available"},
