      {"mode": "incremental_upsert", "strategy": "merge", "action": "update_snippet"}
    ],
    "source_bindings": [{
      "executor": {"family": "declarative_api", "id": "declarative_stream_source"},
      "eligible_streams": ["snippets"],
      "record_mapping": {"kind": "input_fields", "inputs": [
        {"input": "name", "field": "name"},
        {"input": "value", "field": "value"}
      ]}
    }]
  }
}
