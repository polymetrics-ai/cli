{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "apikey": {
      "description": "Bunny GraphQL API key.",
      "type": "string",
      "x-secret": true
    },
    "subdomain": {
      "description": "Bunny tenant subdomain.",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "type": "string"
    }
  },
  "required": [
    "subdomain",
    "apikey"
  ],
  "title": "Bunny Connection Specification",
  "type": "object",
  "x-reject-unknown-config": true
}
