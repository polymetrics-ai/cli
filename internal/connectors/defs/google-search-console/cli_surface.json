{
  "tagline": "Run Google Search Console's declared streams and reverse-ETL actions.",
  "usage": "pm google-search-console \u003ccommand\u003e [flags]",
  "groups": [
    {
      "id": "read",
      "title": "Read streams",
      "commands": [
        "direct mobile-friendly-test run",
        "direct url-inspection inspect",
        "search analytics by country list",
        "search analytics by date list",
        "search analytics by device list",
        "search analytics by page list",
        "search analytics by query list",
        "site details list",
        "sitemap details list",
        "sitemaps list",
        "sites list"
      ]
    },
    {
      "id": "write",
      "title": "Reverse ETL writes",
      "commands": [
        "add site apply",
        "delete site apply",
        "delete sitemap apply",
        "submit sitemap apply"
      ]
    }
  ],
  "commands": [
    {
      "path": "add site apply",
      "summary": "Plan and execute the add site reverse-ETL action",
      "intent": "reverse_etl",
      "availability": "implemented",
      "write": "add_site",
      "source_url": "https://searchconsole.googleapis.com/$discovery/rest?version=v1",
      "flags": [
        {
          "name": "site_url",
          "type": "string",
          "summary": "Required site url record field.",
          "maps_to": "record.site_url",
          "required": true
        }
      ],
      "examples": [
        "pm google-search-console add site apply --plan \u003cplan-name\u003e"
      ],
      "api_surface": [
        {
          "method": "PUT",
          "path": "/webmasters/v3/sites/{siteUrl}"
        }
      ],
      "risk": "adds a site property to the authenticated Search Console account",
      "approval": "requires plan, preview, approval, and execute"
    },
    {
      "path": "delete site apply",
      "summary": "Plan and execute the delete site reverse-ETL action",
      "intent": "reverse_etl",
      "availability": "implemented",
      "write": "delete_site",
      "source_url": "https://searchconsole.googleapis.com/$discovery/rest?version=v1",
      "flags": [
        {
          "name": "site_url",
          "type": "string",
          "summary": "Required site url record field.",
          "maps_to": "record.site_url",
          "required": true
        }
      ],
      "examples": [
        "pm google-search-console delete site apply --plan \u003cplan-name\u003e"
      ],
      "api_surface": [
        {
          "method": "DELETE",
          "path": "/webmasters/v3/sites/{siteUrl}"
        }
      ],
      "risk": "removes a site property from the authenticated Search Console account",
      "approval": "requires plan, preview, approval, and execute"
    },
    {
      "path": "delete sitemap apply",
      "summary": "Plan and execute the delete sitemap reverse-ETL action",
      "intent": "reverse_etl",
      "availability": "implemented",
      "write": "delete_sitemap",
      "source_url": "https://searchconsole.googleapis.com/$discovery/rest?version=v1",
      "flags": [
        {
          "name": "feedpath",
          "type": "string",
          "summary": "Required feedpath record field.",
          "maps_to": "record.feedpath",
          "required": true
        },
        {
          "name": "site_url",
          "type": "string",
          "summary": "Required site url record field.",
          "maps_to": "record.site_url",
          "required": true
        }
      ],
      "examples": [
        "pm google-search-console delete sitemap apply --plan \u003cplan-name\u003e"
      ],
      "api_surface": [
        {
          "method": "DELETE",
          "path": "/webmasters/v3/sites/{siteUrl}/sitemaps/{feedpath}"
        }
      ],
      "risk": "deletes a sitemap from a Search Console site property",
      "approval": "requires plan, preview, approval, and execute"
    },
    {
      "path": "direct mobile-friendly-test run",
      "summary": "Run the official Mobile Friendly Test operation as a typed bounded direct read.",
      "intent": "direct_read",
      "availability": "implemented",
      "source_url": "https://www.googleapis.com/discovery/v1/apis/searchconsole/v1/rest",
      "flags": [
        {
          "name": "url",
          "type": "string",
          "summary": "Fully-qualified URL to test.",
          "maps_to": "body.url",
          "allow_empty": false,
          "required": true
        },
        {
          "name": "request-screenshot",
          "type": "boolean",
          "summary": "Request a screenshot in the provider response.",
          "maps_to": "body.requestScreenshot"
        }
      ],
      "examples": [
        "pm google-search-console direct mobile-friendly-test run --credential gsc-prod --url https://example.com/page --request-screenshot false --json"
      ],
      "api_surface": [
        {
          "method": "POST",
          "path": "/v1/urlTestingTools/mobileFriendlyTest:run"
        }
      ],
      "output_policy": "json_redacted",
      "redact_fields": [
        "url",
        "screenshot"
      ],
      "operation": "google-search-console.mobile_friendly_test_run",
      "risk": "low: bounded Search Console JSON read; fixed endpoint, closed request body schema, 1 MiB response cap, and redacted URL/screenshot-shaped fields"
    },
    {
      "path": "direct url-inspection inspect",
      "summary": "Run the official URL Inspection operation as a typed bounded direct read.",
      "intent": "direct_read",
      "availability": "implemented",
      "source_url": "https://developers.google.com/webmaster-tools/v1/urlInspection.index/inspect",
      "flags": [
        {
          "name": "inspection-url",
          "type": "string",
          "summary": "Fully-qualified URL to inspect.",
          "maps_to": "body.inspectionUrl",
          "allow_empty": false,
          "required": true
        },
        {
          "name": "site-url",
          "type": "string",
          "summary": "Search Console site property URL or sc-domain property.",
          "maps_to": "body.siteUrl",
          "allow_empty": false,
          "required": true
        },
        {
          "name": "language-code",
          "type": "string",
          "summary": "Optional BCP-47 language code for localized inspection messages.",
          "maps_to": "body.languageCode"
        }
      ],
      "examples": [
        "pm google-search-console direct url-inspection inspect --credential gsc-prod --inspection-url https://example.com/page --site-url https://example.com/ --json"
      ],
      "api_surface": [
        {
          "method": "POST",
          "path": "/v1/urlInspection/index:inspect"
        }
      ],
      "output_policy": "json_redacted",
      "redact_fields": [
        "inspectionUrl",
        "siteUrl"
      ],
      "operation": "google-search-console.urlinspection_index_inspect",
      "risk": "low: bounded Search Console JSON read; fixed endpoint, closed request body schema, 1 MiB response cap, and redacted URL-shaped fields"
    },
