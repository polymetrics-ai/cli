{
  "api": "Google Search Console API (Search Console v3 + searchconsole v1)",
  "docs": "https://developers.google.com/webmaster-tools/v1/api_reference_index",
  "reviewed_at": "2026-08-05",
  "operation_ledger_version": 1,
  "scope": "Google's current Discovery document has 11 unique published operations: five read operations reach ETL streams, four record-shaped mutations reach typed reverse-ETL writes, and URL Inspection plus Mobile-Friendly Test reach typed bounded direct reads. Search Analytics reaches five ETL stream conveniences over its single documented POST: by-date groups on date, while country/device/page/query group on date plus the named dimension and preserve date as the cursor. There are no binary, CDC, generic raw HTTP/body/query, excluded, or planned operations.",
  "endpoints": [
    {
      "method": "GET",
      "path": "/webmasters/v3/sites",
      "covered_by": {
        "stream": "sites"
      }
    },
    {
      "method": "GET",
      "path": "/webmasters/v3/sites/{siteUrl}",
      "covered_by": {
        "stream": "site_details"
      }
    },
    {
      "method": "GET",
      "path": "/webmasters/v3/sites/{siteUrl}/sitemaps",
      "covered_by": {
        "stream": "sitemaps"
      }
    },
    {
      "method": "GET",
      "path": "/webmasters/v3/sites/{siteUrl}/sitemaps/{feedpath}",
      "covered_by": {
        "stream": "sitemap_details"
      }
    },
    {
      "method": "POST",
      "path": "/webmasters/v3/sites/{siteUrl}/searchAnalytics/query",
      "covered_by": {
        "stream": "search_analytics_by_date"
      }
    },
    {
      "method": "POST",
      "path": "/webmasters/v3/sites/{siteUrl}/searchAnalytics/query",
      "covered_by": {
        "stream": "search_analytics_by_country"
      }
    },
    {
      "method": "POST",
      "path": "/webmasters/v3/sites/{siteUrl}/searchAnalytics/query",
      "covered_by": {
        "stream": "search_analytics_by_device"
      }
    },
    {
      "method": "POST",
      "path": "/webmasters/v3/sites/{siteUrl}/searchAnalytics/query",
      "covered_by": {
        "stream": "search_analytics_by_page"
      }
    },
    {
      "method": "POST",
      "path": "/webmasters/v3/sites/{siteUrl}/searchAnalytics/query",
      "covered_by": {
        "stream": "search_analytics_by_query"
      }
    },
    {
      "method": "PUT",
      "path": "/webmasters/v3/sites/{siteUrl}",
      "covered_by": {
        "write": "add_site"
      }
    },
    {
      "method": "DELETE",
      "path": "/webmasters/v3/sites/{siteUrl}",
      "covered_by": {
        "write": "delete_site"
      }
    },
    {
      "method": "PUT",
      "path": "/webmasters/v3/sites/{siteUrl}/sitemaps/{feedpath}",
      "covered_by": {
        "write": "submit_sitemap"
      }
    },
    {
      "method": "DELETE",
      "path": "/webmasters/v3/sites/{siteUrl}/sitemaps/{feedpath}",
      "covered_by": {
        "write": "delete_sitemap"
      }
    },
    {
      "method": "POST",
      "path": "/v1/urlInspection/index:inspect",
      "covered_by": {
        "direct_read": "direct url-inspection inspect"
      }
    },
    {
      "method": "POST",
      "path": "/v1/urlTestingTools/mobileFriendlyTest:run",
      "covered_by": {
        "direct_read": "direct mobile-friendly-test run"
      }
    }
  ]
}
