{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "headers": {
      "API-Version": "{{ config.api_version }}"
    },
    "auth": [
      {
        "mode": "api_key_header",
        "header": "Authorization",
        "value": "{{ secrets.api_token }}",
        "prefix": "",
        "when": "{{ secrets.api_token }}"
      },
      {
        "mode": "api_key_header",
        "header": "Authorization",
        "value": "{{ secrets.access_token }}",
        "prefix": "",
        "when": "{{ secrets.access_token }}"
      },
      {
        "mode": "none"
      }
    ],
    "pagination": {
      "type": "none"
    },
    "check": {
      "method": "POST",
      "path": ""
    },
    "error_map": [
      {
        "status": 401,
        "hint": "monday api_token/access_token is missing or invalid; re-run pm credentials add monday"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "monday complexity-based rate limit exceeded; the connector will retry with backoff"
      }
    ]
  },
  "streams": [
    {
      "name": "boards",
      "method": "POST",
      "path": "",
      "records": {
        "path": "data.boards"
      },
      "incremental": {
        "cursor_field": "updated_at",
        "param_format": "rfc3339"
      },
      "schema": "schemas/boards.json"
    },
    {
      "name": "items",
      "method": "POST",
      "path": "",
      "records": {
        "path": "data.next_items_page.items"
      },
      "incremental": {
        "cursor_field": "updated_at",
        "param_format": "rfc3339"
      },
      "schema": "schemas/items.json"
    },
    {
      "name": "users",
      "method": "POST",
      "path": "",
      "records": {
        "path": "data.users"
      },
      "schema": "schemas/users.json"
    },
    {
      "name": "teams",
      "method": "POST",
      "path": "",
      "records": {
        "path": "data.teams"
      },
      "schema": "schemas/teams.json"
    },
    {
      "name": "tags",
      "method": "POST",
      "path": "",
      "records": {
        "path": "data.tags"
      },
      "schema": "schemas/tags.json"
    }
  ]
}
