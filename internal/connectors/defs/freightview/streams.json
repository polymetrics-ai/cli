{
  "base": {
    "auth": [
      {
        "client_id": "{{ secrets.client_id }}",
        "client_secret": "{{ secrets.client_secret }}",
        "mode": "oauth2_client_credentials",
        "token_url": "https://api.freightview.com/v2.0/auth/token"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/shipments",
      "query": {
        "limit": "1"
      }
    },
    "error_map": [],
    "pagination": {
      "cursor_param": "continuationToken",
      "max_pages": 100,
      "token_path": "continuationToken",
      "type": "cursor"
    },
    "url": "https://api.freightview.com/v2.0",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "method": "GET",
      "name": "shipments",
      "path": "/shipments",
      "projection": "passthrough",
      "records": {
        "path": "shipments"
      },
      "schema": "schemas/shipments.json"
    },
    {
      "fan_out": {
        "ids_from": {
          "request": {
            "id_field": "shipmentId",
            "path": "/shipments",
            "records_path": "shipments"
          }
        },
        "into": {
          "path_var": "shipment_id"
        },
        "stamp_field": "shipment_id"
      },
      "method": "GET",
      "name": "quotes",
      "path": "/shipments/{{ fanout.id }}/quotes",
      "projection": "passthrough",
      "records": {
        "path": "quotes"
      },
      "schema": "schemas/quotes.json"
    },
    {
      "fan_out": {
        "ids_from": {
          "request": {
            "id_field": "shipmentId",
            "path": "/shipments",
            "records_path": "shipments"
          }
        },
        "into": {
          "path_var": "shipment_id"
        },
        "stamp_field": "shipment_id"
      },
      "method": "GET",
      "name": "tracking",
      "path": "/shipments/{{ fanout.id }}/tracking",
      "projection": "passthrough",
      "records": {
        "path": "."
      },
      "schema": "schemas/tracking.json"
    }
  ]
}
