        "dexs list",
        "fees list",
        "historical chain tvl list",
        "open interest list",
        "options list",
        "pools list",
        "protocols list",
        "stablecoin chains list",
        "stablecoins list"
      ]
    }
  ],
  "commands": [
    {
      "path": "chains list",
      "summary": "Run the chains ETL stream",
      "intent": "etl",
      "availability": "implemented",
      "stream": "chains",
      "source_url": "https://raw.githubusercontent.com/DefiLlama/api-docs/main/defillama-openapi-free.json",
      "examples": [
        "pm defillama chains list --json"
      ],
      "api_surface": [
        {
          "method": "GET",
          "path": "/v2/chains"
        }
