{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "check": {
      "method": "GET",
      "path": "/protocols",
      "query": {
        "limit": "1"
      }
    },
    "error_map": [
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "defillama rate limit exceeded; the connector will retry with backoff"
      }
    ]
  },
  "streams": [
    {
      "name": "protocols",
      "path": "/protocols",
      "records": {
        "path": "."
      },
      "pagination": {
        "type": "offset_limit",
        "limit_param": "limit",
        "offset_param": "offset",
        "page_size": 1000
      },
      "schema": "schemas/protocols.json"
    },
    {
      "name": "chains",
      "path": "/v2/chains",
      "records": {
        "path": "."
      },
      "pagination": {
        "type": "offset_limit",
        "limit_param": "limit",
        "offset_param": "offset",
        "page_size": 1000
      },
      "schema": "schemas/chains.json"
    },
    {
      "name": "stablecoins",
      "path": "https://stablecoins.llama.fi/stablecoins",
      "query": {
        "includePrices": "true"
      },
      "records": {
        "path": "peggedAssets"
      },
      "schema": "schemas/stablecoins.json"
    },
    {
      "name": "dexs",
      "path": "/overview/dexs",
      "query": {
        "excludeTotalDataChart": "true",
        "excludeTotalDataChartBreakdown": "true"
      },
      "records": {
        "path": "protocols"
      },
      "schema": "schemas/dexs.json"
    },
    {
      "name": "fees",
      "path": "/overview/fees",
      "query": {
        "excludeTotalDataChart": "true",
        "excludeTotalDataChartBreakdown": "true"
      },
      "records": {
        "path": "protocols"
      },
      "schema": "schemas/fees.json"
    },
    {
      "name": "options",
      "path": "/overview/options",
      "query": {
        "excludeTotalDataChart": "true",
        "excludeTotalDataChartBreakdown": "true"
      },
      "records": {
        "path": "protocols"
      },
      "schema": "schemas/options.json"
    },
    {
      "name": "open_interest",
      "path": "/overview/open-interest",
      "query": {
        "excludeTotalDataChart": "true",
        "excludeTotalDataChartBreakdown": "true"
      },
      "records": {
        "path": "protocols"
      },
      "schema": "schemas/open_interest.json"
    },
    {
      "name": "pools",
      "path": "https://yields.llama.fi/pools",
      "records": {
        "path": "data"
      },
      "schema": "schemas/pools.json"
    },
    {
      "name": "stablecoin_chains",
      "path": "https://stablecoins.llama.fi/stablecoinchains",
      "records": {
        "path": "."
      },
      "schema": "schemas/stablecoin_chains.json"
    },
    {
      "name": "historical_chain_tvl",
      "path": "/v2/historicalChainTvl",
      "records": {
        "path": "."
      },
      "schema": "schemas/historical_chain_tvl.json"
    }
  ]
}
