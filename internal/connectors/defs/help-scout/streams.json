{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "auth": [
      {
        "mode": "oauth2_client_credentials",
        "token_url": "{{ config.token_url }}",
        "client_id": "{{ secrets.client_id }}",
        "client_secret": "{{ secrets.client_secret }}"
      }
    ],
    "pagination": {
      "type": "page_number",
      "page_param": "page",
      "size_param": "size",
      "start_page": 1,
      "page_size": 50,
      "max_pages": 20
    },
    "check": {
      "method": "GET",
      "path": "/v2/mailboxes"
    },
    "error_map": [
      {
        "status": 401,
        "hint": "Help Scout client_id/client_secret is missing or invalid; re-run pm credentials add help-scout"
      },
      {
        "status": 403,
        "hint": "Help Scout credential lacks access to the requested Inbox API resource"
      },
      {
        "status": 404,
        "hint": "Help Scout resource not found or the credential lacks access"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "Help Scout rate limit exceeded; retry later with bounded pages/batches"
      }
    ]
  },
  "streams": [
    {
      "name": "get_conversation_v3",
      "path": "/v3/conversations/{{ config.conversation_id }}",
      "records": {
        "path": ".",
        "single_object": true
      },
      "schema": "schemas/get_conversation_v3.json",
      "projection": "passthrough"
    },
    {
      "name": "get_conversation",
      "path": "/v2/conversations/{{ config.conversation_id }}",
      "records": {
        "path": ".",
        "single_object": true
      },
      "schema": "schemas/get_conversation.json",
      "projection": "passthrough"
    },
    {
      "name": "conversations",
      "path": "/v2/conversations",
      "records": {
        "path": "_embedded.conversations"
      },
      "schema": "schemas/conversations.json",
      "projection": "passthrough",
      "query": {
        "sortField": "modifiedAt",
        "sortOrder": "asc",
        "modifiedSince": {
          "template": "{{ config.start_date }}",
          "omit_when_absent": true
        }
      }
    },
    {
      "name": "list_threads_v3",
      "path": "/v3/conversations/{{ config.conversation_id }}/threads",
      "records": {
        "path": "_embedded.threads"
      },
      "schema": "schemas/list_threads_v3.json",
      "projection": "passthrough"
    },
    {
      "name": "list_threads",
      "path": "/v2/conversations/{{ config.conversation_id }}/threads",
      "records": {
        "path": "_embedded.threads"
      },
      "schema": "schemas/list_threads.json",
      "projection": "passthrough"
    },
    {
      "name": "get_thread_original_source",
      "path": "/v2/conversations/{{ config.conversation_id }}/threads/{{ config.thread_id }}/original-source",
      "records": {
        "path": "_embedded.original_source"
      },
      "schema": "schemas/get_thread_original_source.json",
      "projection": "passthrough"
    },
    {
      "name": "get_address",
      "path": "/v2/customers/{{ config.customer_id }}/address",
