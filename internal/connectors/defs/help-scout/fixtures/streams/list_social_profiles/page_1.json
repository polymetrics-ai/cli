{
  "request": {
    "method": "GET",
    "path": "/v2/customers/{{ config.customer_id }}/social-profiles",
    "query": {
      "page": "1",
      "size": "50"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "_embedded": {
        "social-profiles": [
          {
            "_links": {
              "self": {
                "href": "https://api.helpscout.net/v2/customers/100/social-profiles/1"
              }
            },
            "id": 1,
            "value": "https://social.example.com/helpscout",
            "type": "twitter"
          },
          {
            "_links": {
              "self": {
                "href": "https://api.helpscout.net/v2/customers/100/social-profiles/2"
              }
            },
            "id": 2,
            "value": "https://social.example.com/helpscout-plus",
            "type": "googleplus"
          }
        ]
      },
      "_links": {
        "self": {
          "href": "https://api.helpscout.net/v2/customers/100/social-profiles"
        }
      }
    }
  }
}
