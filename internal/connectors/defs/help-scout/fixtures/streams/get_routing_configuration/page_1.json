{
  "request": {
    "method": "GET",
    "path": "/v2/mailboxes/{{ config.mailbox_id }}/routing",
    "query": {
      "page": "1",
      "size": "50"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "_links": {
        "self": {
          "href": "https://api.helpscout.net/v2/mailboxes/100/routing"
        }
      },
      "state": "enabled",
      "assignmentLimit": 10,
      "assignmentMethod": "round_robin",
      "userIds": [
        1,
        2,
        3
      ],
      "rotation": [
        {
          "userId": 1,
          "conversationsCount": 0,
          "eligible": true
        },
        {
          "userId": 2,
          "conversationsCount": 2,
          "eligible": false,
          "reason": "away"
        },
        {
          "userId": 3,
          "conversationsCount": 10,
          "eligible": false,
          "reason": "at_capacity"
        }
      ]
    }
  }
}
