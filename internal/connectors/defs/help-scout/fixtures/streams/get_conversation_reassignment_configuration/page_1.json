{
  "request": {
    "method": "GET",
    "path": "/v2/users/{{ config.user_id }}/conversation-reassignment",
    "query": {
      "page": "1",
      "size": "50"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "_links": {
        "self": {
          "href": "https://api.helpscout.net/v2/users/4/conversation-reassignment"
        }
      },
      "enabled": true,
      "awayDuration": {
        "hours": 2,
        "minutes": 30
      }
    }
  }
}
