    {
      "id": "help-scout.attachment_download",
      "kind": "binary_download",
      "summary": "Download a conversation attachment to a bounded destination.",
      "description": "Help Scout streams the attachment bytes with Content-Disposition and the file's own Content-Type. The sibling .../data endpoint returns base64 inside JSON and is an ordinary read, not a download.",
      "source_url": "https://developer.helpscout.com/mailbox-api/endpoints/conversations/attachments/get-attachment-file/",
      "risk": "medium",
      "approval": "filesystem writes require an explicit destination policy",
      "output_policy": "binary_file_bounded",
      "binary": {
        "method": "GET",
        "path": "/v2/conversations/{conversationId}/attachments/{attachmentId}/file",
        "max_bytes": 26214400,
        "content_types": [
          "application/*",
          "audio/*",
          "font/*",
          "image/*",
          "text/*",
          "video/*"
        ],
        "response": {
          "success_statuses": [
            "200"
          ]
        },
        "allow_overwrite": false,
        "extract_archives": false
      }
    }
  ]
