{
  "base": {
    "auth": [
      {
        "mode": "bearer",
        "token": "{{ secrets.access_token }}"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/audits",
      "query": {
        "page": "1",
        "page_size": "1"
      }
    },
    "error_map": [],
    "pagination": {
      "max_pages": 100,
      "next_url_path": "links.next",
      "type": "next_url"
    },
    "url": "https://api.safetyculture.io",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "method": "GET",
      "name": "audits",
      "path": "/audits",
      "query": {
        "page": "1",
        "page_size": "100"
      },
      "records": {
        "path": "audits"
      },
      "schema": "schemas/audits.json"
    },
    {
      "method": "GET",
      "name": "templates",
      "path": "/templates",
      "query": {
        "page": "1",
        "page_size": "100"
      },
      "records": {
        "path": "templates"
      },
      "schema": "schemas/templates.json"
    },
    {
      "method": "GET",
      "name": "users",
      "path": "/users",
      "query": {
        "page": "1",
        "page_size": "100"
      },
      "records": {
        "path": "users"
      },
      "schema": "schemas/users.json"
    }
  ]
}
