{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "auth": [
      {
        "mode": "bearer",
        "token": "{{ secrets.api_token }}"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/"
    },
    "error_map": [
      {
        "status": 401,
        "hint": "segment API token is missing or invalid; re-run pm credentials add segment with a token from env or stdin"
      },
      {
        "status": 403,
        "class": "forbidden",
        "hint": "segment API token lacks the workspace permission required for this fixed operation"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "segment rate limit exceeded; retry later or lower batch size/page count"
      }
    ],
    "rate_limit": {
      "requests_per_minute": 120
    }
  },
