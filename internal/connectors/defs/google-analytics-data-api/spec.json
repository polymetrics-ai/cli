{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "access_token": {
      "description": "Google Analytics OAuth2 access token.",
      "type": "string",
      "x-secret": true
    },
    "end_date": {
      "default": "today",
      "description": "GA4 report end date or relative date token.",
      "type": "string"
    },
    "property_ids": {
      "description": "One numeric Google Analytics property ID.",
      "pattern": "^[0-9]+$",
      "type": "string"
    },
    "start_date": {
      "default": "30daysAgo",
      "description": "GA4 report start date or relative date token.",
      "type": "string"
    }
  },
  "required": [
    "property_ids",
    "access_token"
  ],
  "title": "Google Analytics 4 (GA4) Connection Specification",
  "type": "object",
  "x-reject-unknown-config": true
}
