{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json"
    },
    "auth": [
      {
        "mode": "bearer",
        "token": "{{ secrets.access_token }}",
        "when": "{{ secrets.access_token }}"
      },
      {
        "mode": "bearer",
        "token": "{{ secrets.credentials }}",
        "when": "{{ secrets.credentials }}"
      }
    ],
    "pagination": {
      "type": "none"
    },
    "check": {
      "method": "GET",
      "path": "/v1beta/properties/{{ config.property_id }}/metadata"
    },
    "error_map": [
      {
        "status": 401,
        "hint": "OAuth2 access token is missing or expired; add credentials from an environment variable or stdin"
      },
      {
        "status": 403,
        "hint": "token lacks Analytics Data API scope or property access"
      },
      {
        "status": 404,
        "hint": "GA4 property or audience export was not found"
      }
    ]
  },
  "streams": [
    {
      "name": "daily_active_users",
      "method": "POST",
      "path": "/v1beta/properties/{{ config.property_id }}:runReport",
      "records": {
        "path": "data"
      },
      "schema": "schemas/daily_active_users.json",
      "incremental": {
        "cursor_field": "date",
        "client_filtered": true
      },
      "conformance": {
        "skip_dynamic": true,
        "reason": "native runReport hook builds POST bodies and fixture responses; covered by native tests and stream fixtures"
      }
    },
    {
      "name": "website_overview",
      "method": "POST",
      "path": "/v1beta/properties/{{ config.property_id }}:runReport",
      "records": {
        "path": "data"
      },
      "schema": "schemas/website_overview.json",
      "incremental": {
        "cursor_field": "date",
        "client_filtered": true
      },
      "conformance": {
        "skip_dynamic": true,
        "reason": "native runReport hook builds POST bodies and fixture responses; covered by native tests and stream fixtures"
      }
    },
    {
      "name": "traffic_sources",
      "method": "POST",
      "path": "/v1beta/properties/{{ config.property_id }}:runReport",
      "records": {
        "path": "data"
      },
      "schema": "schemas/traffic_sources.json",
      "incremental": {
        "cursor_field": "date",
        "client_filtered": true
      },
      "conformance": {
        "skip_dynamic": true,
        "reason": "native runReport hook builds POST bodies and fixture responses; covered by native tests and stream fixtures"
      }
    },
    {
      "name": "devices",
      "method": "POST",
      "path": "/v1beta/properties/{{ config.property_id }}:runReport",
      "records": {
        "path": "data"
      },
      "schema": "schemas/devices.json",
      "incremental": {
        "cursor_field": "date",
        "client_filtered": true
      },
      "conformance": {
        "skip_dynamic": true,
        "reason": "native runReport hook builds POST bodies and fixture responses; covered by native tests and stream fixtures"
      }
    },
    {
      "name": "pages",
      "method": "POST",
      "path": "/v1beta/properties/{{ config.property_id }}:runReport",
      "records": {
        "path": "data"
      },
      "schema": "schemas/pages.json",
      "incremental": {
        "cursor_field": "date",
        "client_filtered": true
      },
      "conformance": {
        "skip_dynamic": true,
        "reason": "native runReport hook builds POST bodies and fixture responses; covered by native tests and stream fixtures"
      }
    }
  ]
}
