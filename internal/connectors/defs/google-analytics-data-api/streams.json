          {
            "name": "activeUsers"
          },
          {
            "name": "newUsers"
          },
          {
            "name": "sessions"
          }
        ],
        "offset": "0"
      },
      "method": "POST",
      "path": "/v1beta/properties/{{ config.property_ids }}:runReport"
    },
    "error_map": [],
