    {"id": "freeagent.bills", "source": {"operation": "GET /v2/bills", "method": "GET", "path": "/v2/bills", "url": "https://dev.freeagent.com/"}, "schema_refs": {"record": "schemas/bills.json"}, "stream_order": 3, "stream": {"name": "bills", "method": "GET", "path": "/bills", "records": {"path": "bills"}, "schema": "schemas/bills.json", "projection": "passthrough", "incremental": {"cursor_field": "updated_at", "request_param": "updated_since"}}},
    {"id": "freeagent.projects", "source": {"operation": "GET /v2/projects", "method": "GET", "path": "/v2/projects", "url": "https://dev.freeagent.com/"}, "schema_refs": {"record": "schemas/projects.json"}, "stream_order": 4, "stream": {"name": "projects", "method": "GET", "path": "/projects", "records": {"path": "projects"}, "schema": "schemas/projects.json", "projection": "passthrough", "incremental": {"cursor_field": "updated_at", "request_param": "updated_since"}}},
    {"id": "freeagent.tasks", "source": {"operation": "GET /v2/tasks", "method": "GET", "path": "/v2/tasks", "url": "https://dev.freeagent.com/"}, "schema_refs": {"record": "schemas/tasks.json"}, "stream_order": 5, "stream": {"name": "tasks", "method": "GET", "path": "/tasks", "records": {"path": "tasks"}, "schema": "schemas/tasks.json", "projection": "passthrough", "incremental": {"cursor_field": "updated_at", "request_param": "updated_since"}}}
