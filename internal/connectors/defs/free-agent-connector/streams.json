{
  "base": {
    "auth": [
      {
        "client_authentication": "basic",
        "client_id": "{{ secrets.client_id }}",
        "client_secret": "{{ secrets.client_secret }}",
        "mode": "oauth2_refresh_token",
        "refresh_token": "{{ secrets.client_refresh_token_2 }}",
        "token_url": "https://api.freeagent.com/v2/token_endpoint"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/contacts",
      "query": {
        "per_page": "1"
      }
    },
    "error_map": [],
    "pagination": {
      "max_pages": 100,
      "page_param": "page",
      "page_size": 100,
      "size_param": "per_page",
      "start_page": 1,
      "type": "page_number"
    },
    "url": "https://api.freeagent.com/v2",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "incremental": {
        "cursor_field": "updated_at",
        "request_param": "updated_since"
      },
      "method": "GET",
      "name": "contacts",
      "path": "/contacts",
      "projection": "passthrough",
      "records": {
        "path": "contacts"
      },
      "schema": "schemas/contacts.json"
    },
    {
      "incremental": {
        "cursor_field": "updated_at",
        "request_param": "updated_since"
      },
      "method": "GET",
      "name": "invoices",
      "path": "/invoices",
      "projection": "passthrough",
      "records": {
        "path": "invoices"
      },
      "schema": "schemas/invoices.json"
    },
    {
      "incremental": {
        "cursor_field": "updated_at",
        "request_param": "updated_since"
      },
      "method": "GET",
      "name": "bills",
      "path": "/bills",
      "projection": "passthrough",
      "records": {
        "path": "bills"
      },
      "schema": "schemas/bills.json"
    },
    {
      "incremental": {
        "cursor_field": "updated_at",
        "request_param": "updated_since"
      },
      "method": "GET",
      "name": "projects",
      "path": "/projects",
      "projection": "passthrough",
      "records": {
        "path": "projects"
      },
      "schema": "schemas/projects.json"
    },
    {
      "incremental": {
        "cursor_field": "updated_at",
        "request_param": "updated_since"
      },
      "method": "GET",
      "name": "tasks",
      "path": "/tasks",
      "projection": "passthrough",
      "records": {
        "path": "tasks"
      },
      "schema": "schemas/tasks.json"
    }
  ]
}
