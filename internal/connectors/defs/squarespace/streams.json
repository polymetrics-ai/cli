{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "auth": [
      {
        "mode": "bearer",
        "token": "{{ secrets.api_key }}"
      }
    ],
    "pagination": {
      "type": "cursor",
      "cursor_param": "cursor",
      "token_path": "pagination.nextPageCursor"
    },
    "check": {
      "method": "GET",
      "path": "/commerce/orders",
      "query": {
        "limit": "1"
      }
    },
    "error_map": [
      {
        "status": 401,
        "hint": "squarespace api_key is missing or invalid; re-run pm credentials add squarespace"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "squarespace rate limit exceeded; the connector will retry with backoff"
      }
    ]
  },
  "streams": [
    {
      "name": "orders",
      "path": "/commerce/orders",
      "query": {
        "limit": "100"
      },
      "records": {
        "path": "result"
      },
      "schema": "schemas/orders.json"
    },
    {
      "name": "products",
      "path": "/commerce/products",
      "query": {
        "limit": "100"
      },
      "records": {
        "path": "result"
      },
      "schema": "schemas/products.json"
    },
    {
      "name": "inventory",
      "path": "/commerce/inventory",
      "query": {
        "limit": "100"
      },
      "records": {
        "path": "result"
      },
      "schema": "schemas/inventory.json"
    },
    {
      "name": "profiles",
      "path": "/profiles",
      "query": {
        "limit": "100"
      },
      "records": {
        "path": "profiles"
      },
      "schema": "schemas/profiles.json"
    },
    {
      "name": "transactions",
      "path": "/commerce/transactions",
      "records": {
        "path": "documents"
      },
      "schema": "schemas/transactions.json"
    },
    {
      "name": "store_pages",
      "path": "/commerce/store_pages",
      "records": {
        "path": "storePages"
      },
      "schema": "schemas/store_pages.json"
    },
    {
      "name": "webhook_subscriptions",
      "path": "/webhook_subscriptions",
      "pagination": {
        "type": "none"
      },
      "records": {
        "path": "webhookSubscriptions"
      },
      "schema": "schemas/webhook_subscriptions.json"
    },
    {
      "name": "contacts",
      "path": "https://api.squarespace.com/v1/contacts",
      "query": {
        "pageSize": "100"
      },
      "records": {
        "path": "contacts"
      },
      "schema": "schemas/contacts.json"
    }
  ]
}
