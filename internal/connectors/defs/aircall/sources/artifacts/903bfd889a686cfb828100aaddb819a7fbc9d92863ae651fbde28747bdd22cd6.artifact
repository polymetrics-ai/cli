    // the Conversation Intelligence object
  }
}</code></pre>
      </div>
    
        </div>
      </div>
    
      
      <div class="api-references--content-area">
        <div class="api-references--content-area--title"><h3 id="call_evaluation-created"><code>call_evaluation.created</code></h3></div>
        <div class="api-references--content-area--desc">
          <div class="api-references--content-area--desc-copy">
            

<p>Sent after a call evaluation is created.</p>

<p><q class="info">
  This event is only generated when a user has purchased a license for <a href="https://aircall.io/products/ai" target="_blank">AI Assist or AI Assist Pro</a>
</q></p>

<p><q class="notice">
  The <code>data</code> field contains a subset of the <a href="#call-evaluations">Call Evaluations Object</a>. To retrieve the full evaluation details including scorecard, categories, and questions, use the <a href="#retrieve-call-evaluations">Retrieve call evaluations</a> endpoint.
</q></p>
<!-- Webhook payload -->

      
    
          </div>
          
      <div class="api-references--content-area--desc-example">
        <pre class="code-block"><div class="code-header"><div>Payload</div></div><code class="prettyprint webhook-payload">{
  "event": "call_evaluation.created",
  "resource": "conversation_intelligence",
  "timestamp": 1585001000,
  "token": "45XXYYZZa08",
  "data": {
    "call_id": 123,
    "created_at": "2025-11-18T10:00:00Z",
    "updated_at": "2025-11-18T10:00:00Z",
    "created_by": 101,
    "updated_by": null,
    "scorecard_name": "some name",
    "ai_generated": true,
    "reviewee_id": 123,
    "reviewer_id": null
  }
}</code></pre>
      </div>
    
        </div>
      </div>
    
      
      <div class="api-references--content-area">
        <div class="api-references--content-area--title"><h3 id="call_evaluation-updated"><code>call_evaluation.updated</code></h3></div>
        <div class="api-references--content-area--desc">
          <div class="api-references--content-area--desc-copy">
            

<p>Sent after a call evaluation is updated.</p>

<p><q class="info">
  This event is only generated when a user has purchased a license for <a href="https://aircall.io/products/ai" target="_blank">AI Assist or AI Assist Pro</a>
</q></p>

<p><q class="notice">
  The <code>data</code> field contains a subset of the <a href="#call-evaluations">Call Evaluations Object</a>. To retrieve the full evaluation details including scorecard, categories, and questions, use the <a href="#retrieve-call-evaluations">Retrieve call evaluations</a> endpoint.
</q></p>
<!-- Webhook payload -->

      
    
          </div>
          
      <div class="api-references--content-area--desc-example">
