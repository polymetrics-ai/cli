          <div class="attributes-table--title">
            <div class="attributes-table--title-field">name</div>
            <div class="attributes-table--title-type">String</div>
          </div>
          <div class="attributes-table--description">Can't be blank if defined.</div>
          <div class="attributes-table--possible-values">Mandatory field.The name must be unique.</div>
        </li>
      
        <li>
          <div class="attributes-table--title">
            <div class="attributes-table--title-field">color</div>
            <div class="attributes-table--title-type">String</div>
          </div>
          <div class="attributes-table--description">Can't be blank and must be formatted in hexadecimal</div>
          <div class="attributes-table--possible-values">Mandatory field.</div>
        </li>
      
      </ul>
    <!-- HTTP Codes table -->
<table>
<tr>
<th>code</th>
<th>description</th>
</tr>
<tr>
<td>201</td>
<td>Success.</td>
</tr>
<tr>
<td>400</td>
<td>Invalid payload/Bad Request.</td>
</tr>
<tr>
<td>403</td>
<td>Forbidden. Invalid API key or Bearer access token</td>
</tr>
</table>
          </div>
          
      <div class="api-references--content-area--desc-example">
        <pre class="code-block"><div class="code-header"><div>Request</div></div><code class="nocode api-request"><span class="http-method http-method-POST">POST</span> /v1/tags

{
  "name": "VIP Customer",
  "color": "#00B388"
}</code></pre>
<pre class="code-block"><div class="code-header"><div>Response</div></div><code class="prettyprint api-response">Status: 201 Created

{
  "tag": {
    "id": 681,
    "name": "VIP Customer",
    "color": "#00B388",
    "description": null
  }
}</code></pre>
      </div>
    
        </div>
      </div>
    
      
      <div class="api-references--content-area">
        <div class="api-references--content-area--title"><h3 id="update-a-tag">Update a Tag</h3></div>
