        </li>
      
      </ul>
    <!-- HTTP Codes table -->
<table>
<tr>
<th>code</th>
<th>description</th>
</tr>
<tr>
<td>200</td>
<td>Success.</td>
</tr>
<tr>
<td>403</td>
<td>Forbidden. Invalid API key or Bearer access token</td>
</tr>
<tr>
<td>404</td>
<td>Not found. Id does not exist</td>
</tr>
</table>
          </div>
          
      <div class="api-references--content-area--desc-example">
        <pre class="code-block"><div class="code-header"><div>Request</div></div><code class="nocode api-request"><span class="http-method http-method-GET">GET</span> /v1/tags/:id</code></pre>
<pre class="code-block"><div class="code-header"><div>Response</div></div><code class="prettyprint api-response">Status: 200 OK

{
  "tag": {
    "id": 678,
