      <div class="api-references--content-area">
        <div class="api-references--content-area--title"><h3 id="retrieve-a-contact">Retrieve a Contact</h3></div>
        <div class="api-references--content-area--desc">
          <div class="api-references--content-area--desc-copy">
            
<!-- Description -->

<p>Retrieve details of a specific Contact.</p>

<p>Only shared contacts can be found.</p>
<!-- URL -->

      
    <!-- Response -->

      
    <!-- Path fields table -->

      <ul class="attributes-table">
        <strong>Path params</strong>
        
        <li>
          <div class="attributes-table--title">
            <div class="attributes-table--title-field">id</div>
            <div class="attributes-table--title-type">Integer</div>
          </div>
          <div class="attributes-table--description">Unique identifier for the Contact.</div>
          
        </li>
      
      </ul>
    
          </div>
          
      <div class="api-references--content-area--desc-example">
        <pre class="code-block"><div class="code-header"><div>Request</div></div><code class="nocode api-request"><span class="http-method http-method-GET">GET</span> /v1/contacts/:id</code></pre>
<pre class="code-block"><div class="code-header"><div>Response</div></div><code class="prettyprint api-response">Status: 200 OK

{
  "contact": {
    "id": 710,
