            <div class="attributes-table--title-field">value</div>
            <div class="attributes-table--title-type">String</div>
          </div>
          <div class="attributes-table--description">Aircall stores any phone number format. The number needs to be valid, if not, agents won't be able to dial the contact</div>
          <div class="attributes-table--possible-values">Mandatory field.</div>
        </li>
      
      </ul>
    
