    // the Conversation Intelligence object
  }
}</code></pre>
      </div>
    
        </div>
      </div>
    
      
      <div class="api-references--content-area">
        <div class="api-references--content-area--title"><h3 id="custom_summary-result_updated"><code>custom_summary.result_updated</code></h3></div>
        <div class="api-references--content-area--desc">
          <div class="api-references--content-area--desc-copy">
            

<p>Sent after custom summary is updated for a Call.</p>

<p><q class="info">
  This event is only generated when a user has purchased a license for <a href="https://aircall.io/products/ai" target="_blank">AI Assist Pro</a>
</q></p>
<!-- Webhook payload -->

      
    
          </div>
          
      <div class="api-references--content-area--desc-example">
