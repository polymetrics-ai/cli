</table>
          </div>
          
      <div class="api-references--content-area--desc-example">
        <pre class="code-block"><div class="code-header"><div>Request</div></div><code class="nocode api-request"><span class="http-method http-method-GET">GET</span> /v1/teams/:id</code></pre>
