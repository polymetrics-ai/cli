{
  "tagline": "Read DriveHOS/Lucid ELD Partner API v2 company, driver, vehicle, status, and vehicle-location data.",
  "usage": "pm lucid-eld <command> [flags]",
  "source_cli": {
    "name": "DriveHOS/Lucid ELD Partner API v2",
    "docs": "https://api.drivehos.app/partner/swagger/doc.json",
    "reference": "OpenAPI 2.0 fetched 2026-07-30",
    "source": "provider_api"
  },
  "groups": [
    {
      "id": "company",
      "title": "Company",
      "commands": [
        "company"
      ]
    },
    {
      "id": "drivers",
      "title": "Drivers",
      "commands": [
        "drivers"
      ]
    },
    {
      "id": "vehicles",
      "title": "Vehicles",
      "commands": [
        "vehicles"
      ]
    },
    {
      "id": "vehicle-location-history",
      "title": "Vehicle location history",
      "commands": [
        "vehicle-location-history"
      ]
    },
    {
      "id": "latest-status",
      "title": "Latest status",
      "commands": [
        "latest"
      ]
    }
  ],
  "global_flags": [
    {
      "name": "credential",
      "type": "string",
      "summary": "Credential name to use for the Lucid ELD request."
    },
    {
      "name": "connection",
      "type": "string",
      "summary": "Alias for --credential."
    },
    {
      "name": "config",
      "type": "string_array",
      "summary": "Connector config override as key=value, including vehicle_id/start_date/end_date for vehicle location history."
    },
    {
      "name": "json",
      "type": "boolean",
      "summary": "Emit machine-readable JSON output."
    },
    {
      "name": "limit",
      "type": "integer",
      "summary": "Maximum ETL records to emit for stream commands."
    },
    {
      "name": "max-bytes",
      "type": "integer",
      "summary": "Maximum direct-read response bytes; typed operations declare their own lower cap."
    }
  ],
  "commands": [
    {
      "path": "drivers list",
      "summary": "List Lucid ELD drivers as passthrough ETL records.",
      "intent": "etl",
      "availability": "implemented",
      "stream": "drivers",
      "flags": [
        {
          "name": "limit",
          "type": "integer",
          "summary": "Records per provider page; official default 100, max 1000.",
          "maps_to": "query.limit"
        },
        {
          "name": "page",
          "type": "integer",
          "summary": "Provider page number; official default 1.",
          "maps_to": "query.page"
        }
      ],
      "api_surface": [
        {
          "method": "GET",
          "path": "/v2/drivers"
        }
      ],
      "examples": [
        "pm lucid-eld drivers list --json --limit 25"
      ],
      "notes": "The stream schema is passthrough because the official OpenAPI response envelope leaves data untyped."
    },
    {
      "path": "vehicles list",
      "summary": "List Lucid ELD vehicles as passthrough ETL records.",
      "intent": "etl",
      "availability": "implemented",
      "stream": "vehicles",
      "flags": [
        {
          "name": "status",
          "type": "enum",
          "summary": "Optional provider status filter.",
          "values": [
            "active",
            "inactive"
          ],
          "maps_to": "query.status"
        },
        {
          "name": "limit",
          "type": "integer",
          "summary": "Records per provider page; official default 100, max 1000.",
          "maps_to": "query.limit"
        },
        {
          "name": "page",
          "type": "integer",
          "summary": "Provider page number; official default 1.",
          "maps_to": "query.page"
        }
      ],
      "api_surface": [
        {
          "method": "GET",
          "path": "/v2/vehicles"
        }
      ],
      "examples": [
        "pm lucid-eld vehicles list --json --status active --limit 25"
      ],
      "notes": "The stream schema is passthrough because the official OpenAPI response envelope leaves data untyped."
    },
    {
      "path": "vehicle-location-history list",
      "summary": "List vehicle location history for the configured vehicle_id and MM-DD-YYYY date window.",
      "intent": "etl",
      "availability": "implemented",
      "stream": "vehicle_location_history",
      "flags": [
        {
          "name": "start-date",
          "type": "string",
          "summary": "Start date in the official wire format MM-DD-YYYY.",
          "maps_to": "query.start_date",
          "allow_empty": false
        },
        {
          "name": "end-date",
          "type": "string",
          "summary": "End date in the official wire format MM-DD-YYYY.",
          "maps_to": "query.end_date",
          "allow_empty": false
        },
        {
          "name": "limit",
          "type": "integer",
          "summary": "Records per provider page; official default 100, max 1000.",
          "maps_to": "query.limit"
        }
      ],
      "api_surface": [
        {
          "method": "GET",
          "path": "/v2/vehicle-location-history/{vehicle_id}"
        }
      ],
      "examples": [
        "pm lucid-eld vehicle-location-history list --json --config vehicle_id=vehicle_fixture_001 --start-date 01-01-2026 --end-date 01-02-2026"
      ],
      "notes": "vehicle_id is a connector config value for this stream path; start-date/end-date flags override the configured date window for the request query."
    },
    {
      "path": "company info get",
      "summary": "Retrieve Lucid ELD company info.",
      "intent": "direct_read",
      "availability": "implemented",
      "operation": "lucid-eld.company_info_get",
      "api_surface": [
        {
          "method": "GET",
          "path": "/v2/company-info"
        }
      ],
      "output_policy": "json_redacted",
      "risk": "bounded read-only DriveHOS/Lucid ELD JSON read; secret-shaped fields are redacted.",
      "approval": "none: read-only bounded GET",
      "examples": [
        "pm lucid-eld company info get --json"
      ]
    },
    {
      "path": "drivers get",
