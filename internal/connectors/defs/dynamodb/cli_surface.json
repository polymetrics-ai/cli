{
  "tagline": "Typed, bounded DynamoDB provider commands",
  "usage": "pm connectors run dynamodb <command> [flags]",
  "source_cli": {
    "name": "AWS CLI dynamodb",
    "docs": "https://docs.aws.amazon.com/cli/latest/reference/dynamodb/",
    "reference": "AWS CLI DynamoDB command reference"
  },
  "groups": [
    {
      "id": "direct",
      "title": "Direct reads",
      "commands": [
        "get-item",
        "batch-get-item",
        "transact-get-items"
      ]
    }
  ],
  "global_flags": [
    {
      "name": "max-bytes",
      "type": "integer",
      "summary": "Maximum response bytes for direct reads; capped by the CLI runtime"
    }
  ],
  "commands": [
    {
      "path": "get-item",
      "summary": "Get one DynamoDB item by typed partition and optional sort key attributes",
      "intent": "direct_read",
      "availability": "implemented",
      "operation": "get_item",
      "flags": [
        {
          "name": "table-name",
          "type": "string",
          "summary": "DynamoDB table name",
          "maps_to": "body.table_name",
          "allow_empty": false
        },
        {
          "name": "partition-key-name",
          "type": "string",
          "summary": "Partition key attribute name",
          "maps_to": "body.partition_key_name",
          "allow_empty": false
        },
        {
          "name": "partition-key-type",
          "type": "enum",
          "values": ["S", "N", "B"],
          "summary": "DynamoDB AttributeValue scalar type for --partition-key-value",
          "maps_to": "body.partition_key_type"
        },
        {
          "name": "partition-key-value",
          "type": "string",
          "summary": "Partition key scalar value",
          "maps_to": "body.partition_key_value",
          "allow_empty": false
        },
        {
          "name": "sort-key-name",
          "type": "string",
          "summary": "Optional sort key attribute name for composite-key tables",
          "maps_to": "body.sort_key_name"
        },
        {
          "name": "sort-key-type",
          "type": "enum",
          "values": ["S", "N", "B"],
          "summary": "DynamoDB AttributeValue scalar type for --sort-key-value",
          "maps_to": "body.sort_key_type"
        },
        {
          "name": "sort-key-value",
          "type": "string",
          "summary": "Optional sort key scalar value for composite-key tables",
          "maps_to": "body.sort_key_value"
        },
        {
          "name": "consistent-read",
          "type": "boolean",
          "summary": "Request strongly consistent reads where DynamoDB supports it",
          "maps_to": "body.consistent_read"
        }
      ],
      "api_surface": [
        {
          "method": "POST",
          "path": "DynamoDB_20120810.GetItem"
        }
      ],
      "output_policy": "json_redacted",
      "redact_fields": [
        "partition_key_value",
        "sort_key_value",
        "key_value"
      ],
      "risk": "Reads one item by closed typed scalar key attributes; key values are redacted from errors/output surfaces."
    },
    {
      "path": "batch-get-item",
      "summary": "Read multiple DynamoDB items by typed partition and optional sort key lists",
      "intent": "direct_read",
      "availability": "implemented",
      "operation": "batch_get_item",
      "flags": [
        {
          "name": "table-name",
          "type": "string",
          "summary": "DynamoDB table name",
          "maps_to": "body.table_name",
          "allow_empty": false
        },
        {
          "name": "partition-key-name",
          "type": "string",
          "summary": "Partition key attribute name",
          "maps_to": "body.partition_key_name",
          "allow_empty": false
        },
        {
          "name": "partition-key-type",
          "type": "enum",
          "values": ["S", "N", "B"],
          "summary": "DynamoDB AttributeValue scalar type for --partition-key-values",
          "maps_to": "body.partition_key_type"
        },
        {
          "name": "partition-key-values",
          "type": "string_array",
          "summary": "Comma-separated/repeated partition key scalar values",
          "maps_to": "body.partition_key_values",
          "allow_empty": false
        },
        {
          "name": "sort-key-name",
          "type": "string",
          "summary": "Optional sort key attribute name for composite-key tables",
          "maps_to": "body.sort_key_name"
        },
        {
          "name": "sort-key-type",
          "type": "enum",
          "values": ["S", "N", "B"],
          "summary": "DynamoDB AttributeValue scalar type for --sort-key-values",
          "maps_to": "body.sort_key_type"
        },
        {
          "name": "sort-key-values",
          "type": "string_array",
          "summary": "Comma-separated/repeated sort key scalar values aligned with --partition-key-values",
          "maps_to": "body.sort_key_values"
        },
        {
          "name": "consistent-read",
          "type": "boolean",
          "summary": "Request strongly consistent reads where DynamoDB supports it",
          "maps_to": "body.consistent_read"
        }
      ],
      "api_surface": [
        {
          "method": "POST",
          "path": "DynamoDB_20120810.BatchGetItem"
        }
      ],
      "output_policy": "json_redacted",
      "redact_fields": [
        "partition_key_values",
        "sort_key_values",
        "key_values"
      ],
      "risk": "Reads bounded keyed items by closed typed scalar key attributes; key values are redacted from errors/output surfaces."
    },
    {
