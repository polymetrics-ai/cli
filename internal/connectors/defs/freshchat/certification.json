{
  "schema_version": 1,
  "source": {
    "default_stream": "agents",
    "source_credential_defaults": {
      "base_url": "https://fixture.freshchat.example/v2",
      "mode": "fixture"
    },
    "live_unavailable": [
      {
        "kind": "Error",
        "contains": [
          "http 401",
          "http 403",
          "http 404",
          "status 401",
          "status 403",
          "status 404",
          "freshchat api_key is missing or invalid",
          "interpolate: unresolved key",
          "rate limit"
        ]
      }
    ]
  }
}
