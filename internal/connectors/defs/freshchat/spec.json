{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Freshchat Connection Specification",
  "type": "object",
  "required": [
    "api_key",
    "base_url"
  ],
  "properties": {
    "api_key": {
      "type": "string",
      "x-secret": true,
      "description": "Freshchat API key. Sent as Authorization: Bearer <api_key>; never logged."
    },
    "base_url": {
      "type": "string",
      "format": "uri",
      "description": "Freshchat API base URL, e.g. https://<account_name>.freshchat.com/v2. This bundle requires the full base URL directly: legacy derives it from an account_name config value (https://<account_name>.freshchat.com/v2), but that cross-key derivation has no engine mechanism today (see docs.md Known limits) \u2014 spec.json's default materialization only supports a fixed literal, never one derived from another config value."
    },
    "user_id": {
      "type": "string",
      "description": "Freshchat user id for user_details and user_conversations streams."
    },
    "conversation_id": {
      "type": "string",
      "description": "Freshchat conversation id for conversation_detail and conversation_messages streams."
    },
    "agent_id": {
      "type": "string",
      "description": "Freshchat agent id for agent_details."
    },
    "report_id": {
      "type": "string",
      "description": "Freshchat report id for report_status."
    },
    "report_status": {
      "type": "string",
      "description": "Optional status filter for report_status."
    },
    "business_hours_group_id": {
      "type": "string",
      "description": "Freshchat group id for business_hours_status."
    },
    "outbound_request_id": {
      "type": "string",
      "description": "Optional request id filter for outbound_messages."
    },
    "metrics_metric": {
      "type": "string",
      "description": "Metric name for Freshchat historical_metrics and instant_metrics streams."
    },
    "metrics_start": {
      "type": "string",
      "description": "Historical metrics start timestamp."
    },
    "metrics_end": {
      "type": "string",
      "description": "Historical metrics end timestamp."
    },
    "metrics_group_by": {
      "type": "string",
      "description": "Optional metrics group_by query value."
    },
    "metrics_filter_by": {
      "type": "string",
      "description": "Optional metrics filter_by query value."
    },
    "metrics_aggregator": {
      "type": "string",
      "description": "Optional historical metrics aggregator query value."
    },
    "metrics_interval": {
      "type": "string",
      "description": "Optional historical metrics interval query value."
    },
    "metrics_summary": {
      "type": "string",
      "description": "Optional instant metrics summary query value."
    },
    "agents_is_deactivated": {
      "type": "string",
      "enum": [
        "true",
        "false"
      ],
      "description": "Optional /agents filter for is_deactivated; values true or false."
    },
    "agents_groups": {
      "type": "string",
      "description": "Optional /agents filter for a Freshchat group id."
    },
    "agents_availability_status": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "UNAVAILABLE"
      ],
      "description": "Optional /agents filter for availability_status."
    },
    "agents_sort_order": {
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ],
      "description": "Optional /agents pagination sort_order value."
    },
    "agents_sort_by": {
      "type": "string",
      "description": "Optional /agents sort_by value."
    },
    "users_first_name": {
      "type": "string",
      "description": "Optional /users first_name filter. Freshchat requires at least one user filter for live list responses."
    },
    "users_last_name": {
      "type": "string",
      "description": "Optional /users last_name filter."
    },
    "users_email": {
      "type": "string",
      "description": "Optional /users email filter."
    },
    "users_reference_id": {
      "type": "string",
      "description": "Optional /users reference_id filter."
    },
    "users_phone_no": {
      "type": "string",
      "description": "Optional /users phone_no filter."
    },
    "users_created_from": {
      "type": "string",
      "format": "date-time",
      "description": "Optional /users created_from UTC timestamp filter."
    },
    "users_created_to": {
      "type": "string",
      "format": "date-time",
      "description": "Optional /users created_to UTC timestamp filter."
    },
    "users_updated_from": {
      "type": "string",
      "format": "date-time",
      "description": "Optional /users updated_from UTC timestamp filter."
    },
    "users_updated_to": {
      "type": "string",
      "format": "date-time",
      "description": "Optional /users updated_to UTC timestamp filter."
    },
    "conversation_messages_from_time": {
      "type": "string",
      "format": "date-time",
      "description": "Optional /conversations/{conversation_id}/messages from_time UTC timestamp filter."
    },
    "groups_sort_order": {
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ],
      "description": "Optional /groups sort_order value."
    },
    "groups_sort_by": {
      "type": "string",
      "description": "Optional /groups sort_by value."
    },
    "channels_locale": {
      "type": "string",
      "description": "Optional /channels locale filter in ISO-639 format."
    },
    "mode": {
      "type": "string",
      "description": "Runtime mode: live (default) or fixture for credential-free conformance."
    }
  }
}
