  "global_flags": [
    {
      "name": "credential",
      "type": "string",
      "summary": "Credential profile name; never pass secret values as flags.",
      "maps_to": "config.credential",
      "allow_empty": false
    },
    {
      "name": "config",
      "type": "string_array",
      "summary": "Connector config override as key=value; never pass secret values here."
    },
    {
      "name": "json",
      "type": "boolean",
      "summary": "Render machine-readable JSON output."
    },
    {
      "name": "limit",
      "type": "integer",
      "summary": "Maximum records to emit from stream-backed commands."
    },
    {
      "name": "preview",
      "type": "boolean",
      "summary": "Preview a reverse-ETL write without making a network mutation."
    },
    {
      "name": "plan",
      "type": "string",
      "summary": "Execute an approved reverse-ETL plan by id."
    },
    {
      "name": "approval-token-stdin",
      "type": "boolean",
      "summary": "Read the approval token as one bounded line from standard input."
    },
    {
      "name": "confirm",
      "type": "string",
      "summary": "Typed confirmation challenge for destructive/admin reverse-ETL writes."
    }
  ],
  "commands": [
    {
      "path": "account configuration",
      "summary": "Read Freshchat account configuration.",
      "intent": "etl",
      "availability": "implemented",
      "stream": "account_configuration",
      "api_surface": [
        {
          "method": "GET",
          "path": "/accounts/configuration"
        }
      ],
      "examples": [
        "pm freshchat account configuration --credential freshchat-prod --json"
      ]
    },
    {
      "path": "agents list",
      "summary": "List Freshchat agents with optional documented filters.",
      "intent": "etl",
      "availability": "implemented",
      "stream": "agents",
      "api_surface": [
        {
          "method": "GET",
          "path": "/agents"
        }
      ],
      "flags": [
        {
          "name": "is-deactivated",
          "type": "enum",
          "summary": "Filter by deactivation state.",
          "maps_to": "config.agents_is_deactivated",
          "values": [
            "true",
            "false"
          ]
        },
        {
          "name": "groups",
          "type": "string",
          "summary": "Filter by group id.",
          "maps_to": "config.agents_groups",
          "allow_empty": false
        },
        {
          "name": "availability-status",
          "type": "enum",
          "summary": "Filter by availability status.",
          "maps_to": "config.agents_availability_status",
          "values": [
            "AVAILABLE",
            "UNAVAILABLE"
          ]
        },
        {
          "name": "sort-order",
          "type": "enum",
          "summary": "Freshchat sort order.",
          "maps_to": "config.agents_sort_order",
          "values": [
            "asc",
            "desc"
          ]
        },
        {
          "name": "sort-by",
          "type": "string",
          "summary": "Freshchat sort field.",
          "maps_to": "config.agents_sort_by",
          "allow_empty": false
        }
      ],
      "examples": [
        "pm freshchat agents list --availability-status AVAILABLE --json"
      ]
    },
    {
