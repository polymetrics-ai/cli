{
  "tagline": "Run Freshchat's declared streams and reverse-ETL actions.",
  "usage": "pm freshchat \u003ccommand\u003e [flags]",
  "groups": [
    {
      "id": "read",
      "title": "Read streams",
      "commands": [
        "account configuration",
        "agents list",
        "agents statuses",
        "agents view",
        "api post users fetch",
        "business-hours status",
        "channels list",
        "conversations fields",
        "conversations messages",
        "conversations view",
        "groups list",
        "metrics historical",
        "metrics instant",
        "outbound messages list",
        "reports status",
        "roles list",
        "users conversations",
        "users list",
        "users view"
      ]
    },
    {
      "id": "write",
      "title": "Reverse ETL writes",
      "commands": [
        "agents create",
        "agents delete",
        "agents status update",
        "agents update",
        "api post files upload",
        "api post images upload",
        "conversations create",
        "conversations message send",
        "conversations update",
        "csat create",
        "outbound whatsapp send",
        "reports extract",
        "users create",
        "users delete",
        "users update"
      ]
    }
  ],
  "global_flags": [
    {
      "name": "credential",
      "type": "string",
      "summary": "Credential profile name; never pass secret values as flags.",
      "maps_to": "config.credential",
      "allow_empty": false
    },
    {
      "name": "config",
      "type": "string_array",
      "summary": "Connector config override as key=value; never pass secret values here."
    },
    {
      "name": "json",
      "type": "boolean",
      "summary": "Render machine-readable JSON output."
    },
    {
      "name": "limit",
      "type": "integer",
      "summary": "Maximum records to emit from stream-backed commands."
    },
    {
      "name": "preview",
      "type": "boolean",
      "summary": "Preview a reverse-ETL write without making a network mutation."
    },
    {
      "name": "plan",
      "type": "string",
      "summary": "Execute an approved reverse-ETL plan by id."
    },
    {
      "name": "approve",
      "type": "string",
      "summary": "Approval token required to execute a reverse-ETL plan."
    },
    {
      "name": "confirm",
      "type": "string",
      "summary": "Typed confirmation challenge for destructive/admin reverse-ETL writes."
    }
  ],
