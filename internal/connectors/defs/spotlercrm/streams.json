{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "auth": [
      {
        "mode": "bearer",
        "token": "{{ secrets.access_token }}",
        "when": "{{ secrets.access_token }}"
      },
      {
        "mode": "api_key_header",
        "header": "X-API-Key",
        "value": "{{ secrets.api_key }}",
        "prefix": "",
        "when": "{{ secrets.api_key }}"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/contacts",
      "query": {
        "limit": "1"
      }
    },
    "error_map": [
      {
        "status": 401,
        "hint": "spotlercrm API key is missing or invalid; re-run pm credentials add spotlercrm"
      },
      {
        "status": 403,
        "hint": "spotlercrm account lacks access for this request"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "spotlercrm rate limit exceeded; the connector will retry with backoff"
      }
    ]
  },
  "streams": [
    {
      "name": "contacts",
      "path": "/contacts",
      "pagination": {
        "type": "page_number",
        "page_param": "page",
        "size_param": "limit",
        "start_page": 1,
        "page_size": 100
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/contacts.json"
    },
    {
      "name": "accounts",
      "path": "/accounts",
      "pagination": {
        "type": "page_number",
        "page_param": "page",
        "size_param": "limit",
        "start_page": 1,
        "page_size": 100
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/accounts.json"
    },
    {
      "name": "opportunities",
      "path": "/opportunities",
      "pagination": {
        "type": "page_number",
        "page_param": "page",
        "size_param": "limit",
        "start_page": 1,
        "page_size": 100
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/opportunities.json"
    },
    {
      "name": "tasks",
      "path": "/tasks",
      "pagination": {
        "type": "page_number",
        "page_param": "page",
        "size_param": "limit",
        "start_page": 1,
        "page_size": 100
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/tasks.json"
    },
    {
      "name": "activities",
      "path": "https://apiv4.reallysimplesystems.com/activities",
      "pagination": {
        "type": "page_number",
        "page_param": "page",
        "size_param": "limit",
        "start_page": 1,
        "page_size": 10
      },
      "records": {
        "path": "list"
      },
      "computed_fields": {
        "id": "{{ record.record.id }}",
        "ownerid": "{{ record.record.ownerid }}",
        "createddate": "{{ record.record.createddate }}",
        "modifieddate": "{{ record.record.modifieddate }}"
      },
      "schema": "schemas/activities.json"
    },
    {
      "name": "campaigns",
      "path": "https://apiv4.reallysimplesystems.com/campaigns",
      "pagination": {
        "type": "page_number",
        "page_param": "page",
        "size_param": "limit",
        "start_page": 1,
        "page_size": 10
      },
      "records": {
        "path": "list"
      },
      "computed_fields": {
        "id": "{{ record.record.id }}",
        "name": "{{ record.record.name }}",
        "ownerid": "{{ record.record.ownerid }}",
        "createddate": "{{ record.record.createddate }}",
        "modifieddate": "{{ record.record.modifieddate }}"
      },
      "schema": "schemas/campaigns.json"
    },
    {
      "name": "cases",
      "path": "https://apiv4.reallysimplesystems.com/cases",
      "pagination": {
        "type": "page_number",
        "page_param": "page",
        "size_param": "limit",
        "start_page": 1,
        "page_size": 10
      },
      "records": {
        "path": "list"
      },
      "computed_fields": {
        "id": "{{ record.record.id }}",
        "ownerid": "{{ record.record.ownerid }}",
        "createddate": "{{ record.record.createddate }}",
        "modifieddate": "{{ record.record.modifieddate }}"
      },
      "schema": "schemas/cases.json"
    }
  ]
}
