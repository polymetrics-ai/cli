{
  "base": {
    "auth": [
      {
        "mode": "declared_password_token",
        "password": "{{ secrets.password }}",
        "token_url": "https://api2.myhours.com/api/tokens/login",
        "username": "{{ config.email }}"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/Clients"
    },
    "error_map": [],
    "headers": {
      "api-version": "1.0"
    },
    "pagination": {
      "type": "none"
    },
    "url": "https://api2.myhours.com/api",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "method": "GET",
      "name": "clients",
      "path": "/Clients",
      "records": {
        "path": ""
      },
      "schema": "schemas/clients.json"
    },
    {
      "method": "GET",
      "name": "projects",
      "path": "/Projects/getAll",
      "records": {
        "path": ""
      },
      "schema": "schemas/projects.json"
    },
    {
      "method": "GET",
      "name": "users",
      "path": "/Users/getAll",
      "records": {
        "path": ""
      },
      "schema": "schemas/users.json"
    },
    {
      "method": "GET",
      "name": "tags",
      "path": "/Tags",
      "records": {
        "path": ""
      },
      "schema": "schemas/tags.json"
    },
    {
      "date_window_fan_out": {
        "batch_size_config_key": "logs_batch_size",
        "date_from_query_param": "DateFrom",
        "date_to_query_param": "DateTo",
        "end_date_config_key": "end_date",
        "max_batch_days": 365,
        "max_windows": 600,
        "start_date_config_key": "start_date"
      },
      "method": "GET",
      "name": "time_logs",
      "path": "/Reports/activity",
      "records": {
        "path": ""
      },
      "schema": "schemas/time_logs.json"
    }
  ]
}
