{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "email": {
      "description": "My Hours login email.",
      "type": "string"
    },
    "end_date": {
      "description": "UTC date window terminal date, YYYY-MM-DD.",
      "type": "string"
    },
    "logs_batch_size": {
      "default": "30",
      "description": "Declared time-log window width in days, 1 through 365.",
      "type": "string"
    },
    "password": {
      "description": "My Hours login password.",
      "type": "string",
      "x-secret": true
    },
    "start_date": {
      "description": "UTC date window start, YYYY-MM-DD.",
      "type": "string"
    }
  },
  "required": [
    "email",
    "password",
    "start_date",
    "end_date"
  ],
  "title": "My Hours Connection Specification",
  "type": "object",
  "x-reject-unknown-config": true
}
