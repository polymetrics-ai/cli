{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "auth": [
      {
        "mode": "bearer",
        "token": "{{ secrets.access_token }}",
        "when": "{{ secrets.access_token }}"
      },
      {
        "mode": "basic",
        "username": "{{ secrets.api_key }}",
        "password": "",
        "when": "{{ secrets.api_key }}"
      }
    ],
    "pagination": {
      "type": "cursor",
      "cursor_param": "offset",
      "token_path": "next",
      "stop_path": "hasNext",
      "page_size": 100
    },
    "check": {
      "method": "GET",
      "path": "/postings",
      "query": {
        "limit": "1"
      }
    },
    "error_map": [
      {
        "status": 401,
        "hint": "lever-hiring credentials are missing or invalid; re-run pm credentials add lever-hiring"
      },
      {
        "status": 403,
        "hint": "lever-hiring account lacks access for this request"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "lever-hiring rate limit exceeded; the connector will retry with backoff"
      }
    ]
  },
  "streams": [
    {
      "name": "opportunities",
      "path": "/opportunities",
      "query": {
        "limit": "100"
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/opportunities.json"
    },
    {
      "name": "postings",
      "path": "/postings",
      "query": {
        "limit": "100"
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/postings.json"
    },
    {
      "name": "users",
      "path": "/users",
      "query": {
        "limit": "100"
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/users.json"
    },
    {
      "name": "requisitions",
      "path": "/requisitions",
      "query": {
        "limit": "100"
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/requisitions.json"
    },
    {
      "name": "stages",
      "path": "/stages",
      "query": {
        "limit": "100"
      },
      "records": {
        "path": "data"
      },
      "schema": "schemas/stages.json"
    },
    {
      "name": "deleted_applications",
      "path": "/applications/deleted",
      "query": {
        "limit": "100"
      },
      "records": {
        "path": "data"
      },
      "projection": "passthrough",
      "schema": "schemas/deleted_applications.json"
    },
    {
      "name": "archive_reasons",
      "path": "/archive_reasons",
      "query": {
        "limit": "100"
      },
      "records": {
        "path": "data"
      },
      "projection": "passthrough",
      "schema": "schemas/archive_reasons.json"
    },
    {
      "name": "audit_events",
      "path": "/audit_events",
      "query": {
        "limit": "100"
      },
      "records": {
        "path": "data"
      },
      "projection": "passthrough",
      "schema": "schemas/audit_events.json"
    },
    {
      "name": "disposition_stages",
      "path": "/disposition_stages",
      "query": {
        "limit": "100"
      },
      "records": {
        "path": "data"
      },
      "projection": "passthrough",
      "schema": "schemas/disposition_stages.json"
    },
    {
      "name": "feedback_templates",
