      "projection": "passthrough",
      "schema": "schemas/sources.json"
    },
    {
      "name": "applications",
      "path": "/opportunities/{{ fanout.id }}/applications",
      "query": {
        "limit": "100"
      },
      "records": {
        "path": "data"
      },
      "projection": "passthrough",
      "fan_out": {
        "ids_from": {
          "request": {
            "path": "/opportunities",
            "records_path": "data",
            "id_field": "id"
          }
        },
        "into": {
          "path_var": "id"
        },
        "stamp_field": "opportunity_id"
      },
      "schema": "schemas/applications.json"
