      "query": {
        "limit": "100"
      },
      "records": {
        "path": "data"
      },
      "projection": "passthrough",
      "schema": "schemas/feedback_templates.json"
    },
    {
      "name": "deleted_opportunities",
      "path": "/opportunities/deleted",
      "query": {
        "limit": "100"
      },
      "records": {
        "path": "data"
      },
      "projection": "passthrough",
      "schema": "schemas/deleted_opportunities.json"
