{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "access_token": {
      "type": "string",
      "x-secret": true
    },
    "consumer_key": {
      "type": "string",
      "x-secret": true
    },
    "contentType": {
      "type": "string"
    },
    "detail_type": {
      "default": "complete",
      "type": "string"
    },
    "favorite": {
      "type": "string"
    },
    "since": {
      "type": "string"
    },
    "sort": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    }
  },
  "required": [
    "access_token",
    "consumer_key"
  ],
  "title": "Pocket Connection Specification",
  "type": "object",
  "x-reject-unknown-config": true
}
