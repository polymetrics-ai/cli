{
  "base": {
    "auth": [
      {
        "mode": "none"
      }
    ],
    "check": {
      "body": {
        "access_token": "{{ secrets.access_token }}",
        "consumer_key": "{{ secrets.consumer_key }}",
        "count": 1,
        "detailType": "{{ config.detail_type }}",
        "offset": 0
      },
      "method": "POST",
      "path": "/get"
    },
    "error_map": [],
    "pagination": {
      "body_offset_field": "offset",
      "limit_param": "count",
      "max_pages": 3,
      "offset_param": "offset",
      "page_size": 100,
      "type": "offset_limit"
    },
    "url": "https://getpocket.com/v3",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "body": {
        "access_token": "{{ secrets.access_token }}",
        "consumer_key": "{{ secrets.consumer_key }}",
        "count": 100,
        "detailType": "{{ config.detail_type }}",
        "offset": 0
      },
      "computed_fields": {
        "title": "{{ coalesce record.resolved_title record.given_title }}",
        "updated_at": "{{ coalesce record.time_updated record.time_added }}",
        "url": "{{ coalesce record.resolved_url record.given_url }}"
      },
      "method": "POST",
      "name": "items",
      "path": "/get",
      "records": {
        "key_field": "item_id",
        "keyed_object": true,
        "path": "list"
      },
      "schema": "schemas/items.json"
    }
  ]
}
