    },
    {
      "name": "limit",
      "type": "integer",
      "summary": "Maximum ETL records to read for stream-backed commands.",
      "maps_to": "limit"
    },
    {
      "name": "max-bytes",
      "type": "integer",
      "summary": "Maximum direct-read response bytes.",
      "maps_to": "max_bytes"
    },
    {
      "name": "plan",
      "type": "boolean",
      "summary": "Build a reverse-ETL write plan without executing.",
      "maps_to": "plan"
    },
    {
      "name": "preview",
