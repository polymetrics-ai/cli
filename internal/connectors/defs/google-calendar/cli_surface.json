    {
      "path": "freebusy query",
      "summary": "Run a bounded typed free/busy query for one calendar and time range.",
      "intent": "direct_read",
      "availability": "implemented",
      "operation": "google-calendar.freebusy.query",
      "flags": [
        {
          "name": "calendar",
          "type": "string",
          "summary": "Calendar ID to query.",
          "maps_to": "body.items.0.id",
          "allow_empty": false
        },
        {
          "name": "time-min",
          "type": "string",
          "summary": "RFC3339 lower time bound.",
          "maps_to": "body.timeMin",
          "format": "date-time",
          "allow_empty": false
        },
        {
          "name": "time-max",
          "type": "string",
          "summary": "RFC3339 upper time bound.",
          "maps_to": "body.timeMax",
          "format": "date-time",
          "allow_empty": false
        },
        {
          "name": "time-zone",
          "type": "string",
          "summary": "Optional response timezone.",
          "maps_to": "body.timeZone",
          "allow_empty": false
        }
      ],
      "constraints": [
        {
          "kind": "order",
          "left": "body.timeMin",
          "right": "body.timeMax",
          "op": "lt",
          "value_type": "date-time",
          "message": "time-min must be earlier than time-max"
        }
      ],
      "api_surface": [
        {
          "method": "POST",
          "path": "/calendar/v3/freeBusy"
        }
      ],
      "output_policy": "json_redacted",
      "redact_fields": [
        "items.0.id"
      ],
      "risk": "medium",
      "approval": "No write approval required; bounded direct read validates typed inputs.",
      "examples": [
        "pm google-calendar freebusy query --calendar primary --time-min 2020-01-01T00:00:00Z --time-max 2020-01-02T00:00:00Z --json"
      ]
    },
