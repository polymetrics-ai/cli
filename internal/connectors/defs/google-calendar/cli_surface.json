{
  "tagline": "Read Google Calendar data and run a bounded typed free/busy query.",
  "usage": "pm google-calendar <command> [flags]",
  "source_cli": {
    "name": "Google Calendar API v3",
    "docs": "https://developers.google.com/workspace/calendar/api/v3/reference",
    "reference": "https://www.googleapis.com/discovery/v1/apis/calendar/v3/rest",
    "source": "google-calendar-discovery"
  },
  "groups": [
    {
      "id": "read",
      "title": "Read streams",
      "commands": [
        "calendar-list",
        "calendars",
        "colors",
        "events",
        "settings",
        "acl"
      ]
    },
    {
      "id": "direct",
      "title": "Typed direct reads",
      "commands": [
        "freebusy"
      ]
    }
  ],
  "global_flags": [
    {
      "name": "json",
      "type": "boolean",
      "summary": "Write machine-readable JSON output."
    },
    {
      "name": "connection",
      "type": "string",
      "summary": "Use a saved Google Calendar connector credential.",
      "maps_to": "connection"
    },
    {
      "name": "credential",
      "type": "string",
      "summary": "Alias for selecting a saved connector credential.",
      "maps_to": "credential"
    },
    {
      "name": "config",
      "type": "string",
      "summary": "Inline key=value connector configuration override; do not use for secrets.",
      "maps_to": "config"
    },
    {
      "name": "limit",
      "type": "integer",
      "summary": "Maximum ETL records to read for stream-backed commands.",
      "maps_to": "limit"
    },
    {
      "name": "max-bytes",
      "type": "integer",
      "summary": "Maximum direct-read response bytes.",
      "maps_to": "max_bytes"
    }
  ],
  "commands": [
    {
      "path": "calendar-list list",
      "summary": "List calendars visible in the authenticated user calendar list.",
      "intent": "etl",
      "availability": "implemented",
      "stream": "calendar_list",
      "examples": ["pm google-calendar calendar-list list --json"]
    },
    {
      "path": "calendar-list get",
      "summary": "Read one calendar-list entry using config.calendarid.",
      "intent": "etl",
      "availability": "implemented",
      "stream": "calendar_list_entry",
      "examples": ["pm google-calendar calendar-list get --json"]
    },
    {
      "path": "calendars get",
      "summary": "Read configured calendar metadata.",
      "intent": "etl",
      "availability": "implemented",
      "stream": "calendar",
      "examples": ["pm google-calendar calendars get --json"]
    },
    {
      "path": "colors get",
      "summary": "Read color palettes for calendars and events.",
      "intent": "etl",
      "availability": "implemented",
      "stream": "colors",
      "examples": ["pm google-calendar colors get --json"]
    },
    {
      "path": "events list",
      "summary": "List events with updatedMin incremental support.",
      "intent": "etl",
      "availability": "implemented",
      "stream": "events",
      "examples": ["pm google-calendar events list --json"]
    },
    {
      "path": "events get",
      "summary": "Read one event using config.calendarid and config.event_id.",
      "intent": "etl",
      "availability": "implemented",
      "stream": "event",
      "examples": ["pm google-calendar events get --config event_id=event123 --json"]
    },
    {
      "path": "events instances",
      "summary": "List recurring-event instances for config.event_id.",
      "intent": "etl",
      "availability": "implemented",
      "stream": "event_instances",
      "examples": ["pm google-calendar events instances --config event_id=event123 --json"]
    },
    {
      "path": "settings list",
      "summary": "List user Calendar settings.",
      "intent": "etl",
      "availability": "implemented",
      "stream": "settings",
      "examples": ["pm google-calendar settings list --json"]
    },
    {
      "path": "settings get",
      "summary": "Read one user Calendar setting.",
      "intent": "etl",
      "availability": "implemented",
      "stream": "setting",
      "examples": ["pm google-calendar settings get --config setting=timezone --json"]
    },
    {
      "path": "acl list",
      "summary": "List ACL rules for config.calendarid.",
      "intent": "etl",
      "availability": "implemented",
      "stream": "acl",
      "examples": ["pm google-calendar acl list --json"]
    },
    {
      "path": "acl get",
      "summary": "Read one ACL rule for config.rule_id.",
      "intent": "etl",
      "availability": "implemented",
      "stream": "acl_rule",
      "examples": ["pm google-calendar acl get --config rule_id=default --json"]
    },
    {
      "path": "freebusy query",
      "summary": "Run a bounded typed free/busy query for one calendar and time range.",
      "intent": "direct_read",
      "availability": "implemented",
      "operation": "google-calendar.freebusy.query",
      "flags": [
        {
          "name": "calendar",
          "type": "string",
          "summary": "Calendar ID to query.",
          "maps_to": "body.items.0.id",
          "required": true,
          "allow_empty": false
        },
        {
          "name": "time-min",
          "type": "string",
          "summary": "RFC3339 lower time bound.",
          "maps_to": "body.timeMin",
          "format": "date-time",
          "required": true,
          "allow_empty": false
        },
        {
          "name": "time-max",
          "type": "string",
          "summary": "RFC3339 upper time bound.",
          "maps_to": "body.timeMax",
          "format": "date-time",
          "required": true,
          "allow_empty": false
        },
        {
          "name": "time-zone",
          "type": "string",
          "summary": "Optional response timezone.",
          "maps_to": "body.timeZone",
          "allow_empty": false
        }
      ],
      "constraints": [
        {
          "kind": "order",
          "left": "body.timeMin",
          "right": "body.timeMax",
          "op": "lt",
          "value_type": "date-time",
          "message": "time-min must be earlier than time-max"
        }
      ],
      "api_surface": [
        {"method": "POST", "path": "/calendar/v3/freeBusy"}
      ],
      "output_policy": "json_redacted",
      "redact_fields": ["items.0.id"],
      "risk": "medium",
      "approval": "No write approval required; bounded direct read validates typed inputs.",
      "examples": [
        "pm google-calendar freebusy query --calendar primary --time-min 2020-01-01T00:00:00Z --time-max 2020-01-02T00:00:00Z --json"
      ]
    }
  ]
}
