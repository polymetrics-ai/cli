{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "auth": [
      {
        "mode": "custom",
        "hook": "query_auth"
      }
    ],
    "pagination": {
      "type": "none"
    },
    "check": {
      "method": "GET",
      "path": "/members/me",
      "query": {
        "token": "{{ secrets.token }}"
      }
    },
    "error_map": [
      {
        "status": 401,
        "hint": "trello key/token is missing or invalid; re-run pm credentials add trello"
      },
      {
        "status": 403,
        "hint": "trello token lacks access to the requested board, member, organization, or workspace"
      },
      {
        "status": 404,
        "hint": "trello resource not found or not visible to the configured credentials"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "trello rate limit exceeded; retry later or reduce batch size"
      }
    ]
  },
  "streams": [
    {
      "name": "checklists",
      "path": "/boards/{{ config.id }}/checklists",
      "query": {
        "token": "{{ secrets.token }}"
      },
      "records": {
        "path": "."
      },
      "projection": "passthrough",
      "schema": "schemas/trello_record.json"
    },
    {
      "name": "lists",
      "path": "/boards/{{ config.id }}/lists",
      "query": {
        "token": "{{ secrets.token }}"
      },
      "records": {
        "path": "."
      },
      "projection": "passthrough",
      "schema": "schemas/trello_record.json"
    },
    {
      "name": "boards",
      "path": "/members/me/boards",
      "query": {
        "token": "{{ secrets.token }}"
      },
      "records": {
        "path": "."
      },
      "projection": "passthrough",
      "schema": "schemas/trello_record.json"
    }
  ]
}
