{
  "operations": [
    {
      "id": "front.create_analytics_export",
      "kind": "rest_read",
      "summary": "Create a new analytics export",
      "description": "Create a new analytics export of messages or events (activities) over a specific time span.\nThe export will be executed asynchronously. The response will include a link that can be used to retrieve the export status & result. Refer to the [Analytics](https://dev.frontapp.com/reference/analytics) topic for details about specific metrics.\n\n\nRequired scope: `analytics:read`",
      "source_url": "https://dev.frontapp.com/reference/create-analytics-export.md",
      "risk": "high",
      "approval": "none: fixed Front provider read/query endpoint with bounded JSON output",
      "output_policy": "json_redacted",
      "mutation_class": "none",
      "rest": {
        "method": "POST",
        "path": "/analytics/exports",
        "max_bytes": 1048576,
        "content_type": "application/json",
        "body_schema": {
          "type": "object",
          "properties": {
            "columns": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Message ID",
                  "Segment ID",
                  "Conversation ID",
                  "Ticket IDs",
                  "Segment",
                  "Direction",
                  "Status",
                  "Inbox",
                  "Inbox API ID",
                  "Inbox at activity time",
                  "Inbox API IDs at activity time",
                  "Message date",
                  "Autoreply",
                  "Reaction time",
                  "Total reply time",
                  "Handle time",
                  "Response time",
                  "Attributed to",
                  "Assignee",
                  "Author",
                  "Contact name",
                  "Contact handle",
                  "Account names",
                  "From",
                  "To",
                  "Cc",
                  "Bcc",
                  "Extract",
                  "Tags",
                  "Tag API IDs",
                  "Message API ID",
                  "Conversation API ID",
                  "New Conversation",
                  "First response",
                  "Business hours",
                  "Subject",
                  "Segment start",
                  "Segment end",
                  "Segment closed",
                  "Last segment activity",
                  "Segment cumulative teammates",
                  "Ticket status name",
                  "Ticket status category",
                  "Custom Field"
                ]
              }
            }
          },
          "required": [
            "columns"
          ],
          "additionalProperties": true
        }
      }
    },
