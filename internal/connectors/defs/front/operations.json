      "source_url": "https://dev.frontapp.com/reference/search-conversations.md",
      "risk": "medium",
      "approval": "none: fixed Front provider read/query endpoint with bounded JSON output",
      "output_policy": "json_redacted",
      "mutation_class": "none",
      "rest": {
        "method": "GET",
        "path": "/conversations/search/{query}",
        "max_bytes": 1048576
      }
    },
