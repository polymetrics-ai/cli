              "external_url"
            ]
          }
        }
      ]
    },
    "create_conversation": {
      "type": "object",
      "required": [
        "type",
        "subject"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "discussion",
            "task"
          ]
        },
        "inbox_id": {
          "type": "string"
        },
        "teammate_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "subject": {
          "type": "string"
        },
        "comment": {
          "type": "object",
          "required": [
            "body"
          ],
          "additionalProperties": false,
          "properties": {
            "author_id": {
              "type": "string"
            },
            "body": {
              "type": "string"
            }
          }
        },
        "description": {
          "type": "string",
          "maxLength": 65535
        },
        "due_at": {
          "type": "number"
        },
        "custom_fields": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "inbox_id"
              ],
              "not": {
                "required": [
                  "teammate_ids"
                ]
              }
            },
            {
              "required": [
                "teammate_ids"
              ],
              "not": {
                "required": [
                  "inbox_id"
                ]
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "discussion"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "comment"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "description"
                  ]
                },
                {
                  "required": [
                    "due_at"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "update_conversation": {
      "type": "object",
      "required": [
        "conversation_id"
      ],
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "assignee_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "inbox_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "archived",
            "open",
            "deleted",
            "spam"
          ]
        },
        "status_id": {
          "type": "string"
        },
        "tag_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 65535
        },
        "due_at": {
          "type": [
            "number",
            "null"
          ]
        },
        "custom_fields": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "not": {
        "required": [
          "status",
          "status_id"
        ]
      }
    },
    "create_a_channel": {
      "type": "object",
      "required": [
        "inbox_id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "inbox_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "undo_send_time": {
              "type": "integer",
              "enum": [
                0,
                5,
                10,
                15,
                30,
                60
              ]
            },
            "all_teammates_can_reply": {
              "type": "boolean"
            },
            "webhook_url": {
              "type": "string"
            },
            "sid": {
              "type": "string"
            },
            "auth_token": {
              "type": "string"
            }
          }
        },
        "type": {
          "enum": [
            "custom",
            "smtp",
            "twilio"
          ]
        },
        "send_as": {
          "type": "string"
        },
        "application_uid": {
          "type": "string"
        },
        "credentials": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "oneOf": [
        {
          "properties": {
            "settings": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "sid"
                    ]
                  },
                  {
                    "required": [
                      "auth_token"
                    ]
                  }
                ]
              }
            },
            "type": {
              "enum": [
                "custom"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "credentials"
                ]
              },
              "then": {
                "required": [
                  "application_uid"
                ]
              }
            },
            {
              "if": {
                "required": [
                  "application_uid"
                ]
              },
              "then": {
                "properties": {
                  "type": {
                    "enum": [
                      "custom"
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "properties": {
            "type": {
              "enum": [
                "smtp"
              ]
            },
            "settings": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "webhook_url"
                    ]
                  },
                  {
                    "required": [
                      "sid"
                    ]
                  },
                  {
                    "required": [
                      "auth_token"
                    ]
                  }
                ]
              }
            }
          },
          "required": [
            "send_as"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "application_uid"
                ]
              },
              {
                "required": [
                  "credentials"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "type": {
              "enum": [
                "twilio"
              ]
            },
            "settings": {
              "not": {
                "required": [
                  "webhook_url"
                ]
              }
            }
          },
          "required": [
            "send_as"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "application_uid"
                ]
              },
              {
                "required": [
                  "credentials"
                ]
              }
            ]
          }
        }
      ]
    },
