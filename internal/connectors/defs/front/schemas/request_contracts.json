    "add_conversation_link": {
      "type": "object",
      "required": [
        "conversation_id"
      ],
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "link_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string"
          }
        },
        "link_external_urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "link_ids"
          ],
          "not": {
            "required": [
              "link_external_urls"
            ]
          }
        },
        {
          "required": [
            "link_external_urls"
          ],
          "not": {
            "required": [
              "link_ids"
            ]
          }
        }
      ]
    },
    "create_link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
