{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "auth": [
      {
        "mode": "bearer",
        "token": "{{ secrets.api_key }}"
      }
    ],
    "pagination": {
      "type": "next_url",
      "next_url_path": "_pagination.next"
    },
    "check": {
      "method": "GET",
      "path": "/inboxes"
    },
    "error_map": [
      {
        "status": 401,
        "hint": "front api key is missing or invalid; re-run pm credentials add front"
      },
      {
        "status": 403,
        "hint": "front account lacks access for this request"
      },
      {
        "status": 404,
        "hint": "front resource not found or token lacks access"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "front rate limit exceeded; the connector will retry with backoff"
      }
    ]
  },
