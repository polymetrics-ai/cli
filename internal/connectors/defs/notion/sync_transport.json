{
  "schema_version": 1,
  "source_transport": {
    "executor": {
      "family": "declarative_api",
      "id": "declarative_stream_source"
    },
    "eligible_streams": [
      "databases",
      "pages",
      "users",
      "custom_emojis",
      "file_uploads",
      "views"
    ],
    "modes": [
      "full_overwrite",
      "full_append",
      "incremental_upsert",
      "incremental_dedupe",
      "incremental_dedupe_history"
    ],
    "delivery": {
      "idempotency": "at_least_once",
      "ordering": "source_ordered",
      "deletes": "not_available"
    },
    "conformance": {
      "suite": "batch1_declarative_stream_transport",
      "run_id": "notion_all_executable_streams_v1"
    }
  },
  "destination_transport": {
    "executor": {
      "family": "declarative_api",
      "id": "declarative_typed_destination"
    },
    "eligible_actions": [
      "update_view"
    ],
    "modes": [
      "incremental_upsert"
    ],
    "delivery": {
      "idempotency": "keyed",
      "ordering": "source_ordered",
      "deletes": "not_available"
    },
    "conformance": {
      "suite": "connector_fixture_mapping",
      "run_id": "notion_views_update_view_v1"
    },
    "acknowledgement": "durable_warehouse",
    "apply_strategies": [
      {
        "mode": "incremental_upsert",
        "strategy": "merge",
        "action": "update_view"
      }
    ],
    "source_bindings": [
      {
        "executor": {
          "family": "declarative_api",
          "id": "declarative_stream_source"
        },
        "eligible_streams": [
          "views"
        ],
        "record_mapping": {
          "kind": "input_fields",
          "inputs": [
            {
              "input": "view_id",
              "field": "id"
            },
            {
              "input": "name",
              "field": "name"
            }
          ]
        }
      }
    ]
  }
}
