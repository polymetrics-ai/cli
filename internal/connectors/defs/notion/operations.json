    {
      "id": "notion.query_data_source",
      "kind": "rest_read",
      "summary": "Query a data source",
      "description": "Bounded Notion read for POST /v1/data_sources/{data_source_id}/query.",
      "source_url": "https://developers.notion.com/reference/post-database-query",
      "risk": "low",
      "approval": "none",
      "output_policy": "json_redacted",
      "rest": {
        "method": "POST",
        "path": "/v1/data_sources/{data_source_id}/query",
        "max_bytes": 1048576,
        "content_type": "application/json",
        "body_schema": {
          "type": "object",
          "properties": {
            "sorts": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "filter": {
              "type": "object"
            },
            "start_cursor": {
              "type": "string"
            },
            "page_size": {
              "type": "number"
            },
            "is_archived": {
              "type": "boolean",
              "description": "Whether to return archived pages. When omitted or false, returns non-archived pages. When true, returns archived pages."
            },
            "result_type": {
              "type": "string",
              "description": "Optionally filter the results to only include pages or data sources. Regular, non-wiki databases only support page children. The default behavior is no result type filtering, in other words, returning both pages and data sources for wikis.",
              "enum": [
                "page",
                "data_source"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "id": "notion.query_meeting_notes",
      "kind": "rest_read",
      "summary": "Query meeting notes",
      "description": "Bounded Notion read for POST /v1/blocks/meeting_notes/query.",
      "source_url": "https://developers.notion.com/reference/query-meeting-notes",
      "risk": "low",
      "approval": "none",
      "output_policy": "json_redacted",
      "rest": {
        "method": "POST",
        "path": "/v1/blocks/meeting_notes/query",
        "max_bytes": 1048576,
        "content_type": "application/json",
        "body_schema": {
          "type": "object",
          "properties": {
            "filter": {
              "type": "object",
              "description": "Optional filter for querying meeting notes. Supports combinator (and/or) and property filters on title, attendees, created_time, created_by, last_edited_time, last_edited_by."
            },
            "sort": {
              "type": "array",
              "description": "Optional sort order for the results. Each entry specifies a property name and direction.",
              "items": {
                "type": "object"
              }
            },
            "limit": {
              "type": "integer",
              "description": "Maximum number of results to return. Defaults to 50."
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "id": "notion.send_file_upload",
      "kind": "file_upload",
      "summary": "Upload a file",
      "description": "Bounded Notion multipart upload for POST /v1/file_uploads/{file_upload_id}/send. Execution is blocked until the shared file upload runner can bind provider paths to approved payload digests.",
      "source_url": "https://developers.notion.com/reference/upload-file",
      "risk": "high",
      "approval": "file uploads require plan, preview, explicit approval, and payload digest approval before execution",
      "output_policy": "file_manifest",
      "mutation_class": "create",
      "file": {
        "direction": "upload",
        "max_bytes": 20971520
      }
    }
  ]
