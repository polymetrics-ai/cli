    {
      "id": "notion.query_data_source",
      "kind": "rest_read",
      "summary": "Query a data source",
      "description": "Bounded Notion read for POST /v1/data_sources/{data_source_id}/query.",
      "source_url": "https://developers.notion.com/reference/post-database-query",
      "risk": "low",
      "approval": "none",
      "output_policy": "json_redacted",
      "rest": {
        "method": "POST",
        "path": "/v1/data_sources/{data_source_id}/query",
        "content_type": "application/json",
        "max_bytes": 1048576,
        "body_schema": {
          "type": "object",
          "properties": {
            "sorts": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "filter": {
              "type": "object"
            },
            "start_cursor": {
              "type": "string"
            },
            "page_size": {
              "type": "number"
            },
            "is_archived": {
              "type": "boolean",
              "description": "Whether to return archived pages. When omitted or false, returns non-archived pages. When true, returns archived pages."
            },
            "result_type": {
              "type": "string",
              "description": "Optionally filter the results to only include pages or data sources. Regular, non-wiki databases only support page children. The default behavior is no result type filtering, in other words, returning both pages and data sources for wikis.",
              "enum": [
                "page",
                "data_source"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
