{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "headers": {
      "Notion-Version": "2022-06-28"
    },
    "auth": [
      {
        "mode": "bearer",
        "token": "{{ secrets.token }}"
      }
    ],
    "pagination": {
      "type": "cursor",
      "cursor_param": "start_cursor",
      "token_path": "next_cursor",
      "stop_path": "has_more",
      "size_param": "page_size",
      "page_size": 100,
      "max_pages": 1000
    },
    "check": {
      "method": "GET",
      "path": "/users"
    },
    "error_map": [
      {
        "status": 401,
        "hint": "notion access token is missing or invalid; re-run pm credentials add notion"
      },
      {
        "status": 403,
        "hint": "notion integration lacks access to this resource; share the database/page with the integration"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "notion rate limit exceeded; the connector will retry with backoff"
      }
    ]
  },
  "streams": [
    {
      "name": "databases",
      "path": "/search",
      "records": {
        "path": "results"
      },
      "schema": "schemas/databases.json",
      "incremental": {
        "cursor_field": "last_edited_time"
      }
    },
    {
      "name": "pages",
      "path": "/search",
      "records": {
        "path": "results"
      },
      "schema": "schemas/pages.json",
      "incremental": {
        "cursor_field": "last_edited_time"
      }
    },
    {
      "name": "users",
      "path": "/users",
      "records": {
        "path": "results"
      },
      "schema": "schemas/users.json"
    },
    {
      "name": "custom_emojis",
      "path": "/v1/custom_emojis",
      "records": {
        "path": "results"
      },
      "projection": "schema",
      "schema": "schemas/custom_emojis.json"
    },
    {
      "name": "file_uploads",
      "path": "/v1/file_uploads",
      "records": {
        "path": "results"
      },
      "projection": "schema",
      "schema": "schemas/file_uploads.json"
    },
    {
      "name": "views",
      "path": "/v1/views",
      "records": {
        "path": "results"
      },
      "projection": "schema",
      "schema": "schemas/views.json"
    }
  ]
}
