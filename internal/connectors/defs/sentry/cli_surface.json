      "path": "events list",
      "summary": "Run the events ETL stream",
      "intent": "etl",
      "availability": "implemented",
      "stream": "events",
      "source_url": "https://raw.githubusercontent.com/getsentry/sentry-api-schema/main/openapi-derefed.json",
      "examples": [
        "pm sentry events list --json"
      ],
      "api_surface": [
        {
          "method": "GET",
          "path": "/api/0/projects/{organization_id_or_slug}/{project_id_or_slug}/events/"
