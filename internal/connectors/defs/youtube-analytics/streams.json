{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "auth": [
      {
        "mode": "custom",
        "hook": "youtube-analytics",
        "token_url": "{{ config.token_url }}",
        "client_id": "{{ secrets.client_id }}",
        "client_secret": "{{ secrets.client_secret }}",
        "token": "{{ secrets.refresh_token }}",
        "scopes": "{{ config.scopes }}"
      }
    ],
    "pagination": {
      "type": "cursor",
      "cursor_param": "pageToken",
      "token_path": "nextPageToken"
    },
    "check": { "method": "GET", "path": "/reportTypes" },
    "error_map": [
      { "status": 401, "hint": "youtube-analytics OAuth refresh grant failed or access token expired; re-run pm credentials add youtube-analytics" },
      { "status": 403, "hint": "youtube-analytics account lacks access for this request/scope" },
      { "status": 429, "class": "rate_limited", "hint": "youtube-analytics API rate limit exceeded; the connector will retry with backoff" }
    ]
  },
  "streams": [
    {
      "name": "jobs",
      "path": "/jobs",
      "query": {
        "pageSize": "{{ config.page_size }}",
        "includeSystemManaged": { "template": "{{ config.include_system_managed }}", "omit_when_absent": true },
        "onBehalfOfContentOwner": { "template": "{{ config.content_owner_id }}", "omit_when_absent": true }
      },
      "records": { "path": "jobs" },
      "computed_fields": {
        "report_type_id": "{{ record.reportTypeId }}",
        "create_time": "{{ record.createTime }}",
        "expire_time": "{{ record.expireTime }}",
        "system_managed": "{{ record.systemManaged }}"
      },
      "schema": "schemas/jobs.json"
    },
    {
      "name": "job",
      "path": "/jobs/{{ config.job_id }}",
      "query": {
        "onBehalfOfContentOwner": { "template": "{{ config.content_owner_id }}", "omit_when_absent": true }
      },
      "records": { "path": ".", "single_object": true },
      "pagination": { "type": "none" },
      "computed_fields": {
        "report_type_id": "{{ record.reportTypeId }}",
        "create_time": "{{ record.createTime }}",
        "expire_time": "{{ record.expireTime }}",
        "system_managed": "{{ record.systemManaged }}"
      },
      "schema": "schemas/job.json"
    },
    {
      "name": "report_types",
      "path": "/reportTypes",
      "query": {
        "pageSize": "{{ config.page_size }}",
        "includeSystemManaged": { "template": "{{ config.include_system_managed }}", "omit_when_absent": true },
        "onBehalfOfContentOwner": { "template": "{{ config.content_owner_id }}", "omit_when_absent": true }
      },
      "records": { "path": "reportTypes" },
      "computed_fields": {
        "deprecate_time": "{{ record.deprecateTime }}",
        "system_managed": "{{ record.systemManaged }}"
      },
      "schema": "schemas/report_types.json"
    },
    {
      "name": "reports",
      "path": "/jobs/{{ config.job_id }}/reports",
      "query": {
        "pageSize": "{{ config.page_size }}",
        "createdAfter": { "template": "{{ config.created_after }}", "omit_when_absent": true },
        "startTimeAtOrAfter": { "template": "{{ config.start_time_at_or_after }}", "omit_when_absent": true },
        "startTimeBefore": { "template": "{{ config.start_time_before }}", "omit_when_absent": true },
        "onBehalfOfContentOwner": { "template": "{{ config.content_owner_id }}", "omit_when_absent": true }
      },
      "records": { "path": "reports" },
      "computed_fields": {
        "job_id": "{{ record.jobId }}",
        "start_time": "{{ record.startTime }}",
        "end_time": "{{ record.endTime }}",
        "create_time": "{{ record.createTime }}",
        "job_expire_time": "{{ record.jobExpireTime }}",
        "download_url": "{{ record.downloadUrl }}"
      },
      "schema": "schemas/reports.json"
    },
    {
      "name": "report",
      "path": "/jobs/{{ config.job_id }}/reports/{{ config.report_id }}",
      "query": {
        "onBehalfOfContentOwner": { "template": "{{ config.content_owner_id }}", "omit_when_absent": true }
      },
      "records": { "path": ".", "single_object": true },
      "pagination": { "type": "none" },
      "computed_fields": {
        "job_id": "{{ record.jobId }}",
        "start_time": "{{ record.startTime }}",
        "end_time": "{{ record.endTime }}",
        "create_time": "{{ record.createTime }}",
        "job_expire_time": "{{ record.jobExpireTime }}",
        "download_url": "{{ record.downloadUrl }}"
      },
      "schema": "schemas/report.json"
    },
    {
      "name": "groups",
      "path": "https://youtubeanalytics.googleapis.com/v2/groups",
      "query": {
        "mine": "{{ query.mine }}",
        "onBehalfOfContentOwner": { "template": "{{ config.content_owner_id }}", "omit_when_absent": true }
      },
      "records": { "path": "items" },
      "computed_fields": {
        "title": "{{ record.snippet.title }}",
        "published_at": "{{ record.snippet.publishedAt }}",
        "item_count": "{{ record.contentDetails.itemCount }}",
        "item_type": "{{ record.contentDetails.itemType }}"
      },
      "schema": "schemas/groups.json"
    },
    {
      "name": "group_items",
      "path": "https://youtubeanalytics.googleapis.com/v2/groupItems",
      "query": {
        "groupId": "{{ query.groupId }}",
        "onBehalfOfContentOwner": { "template": "{{ config.content_owner_id }}", "omit_when_absent": true }
      },
      "records": { "path": "items" },
      "pagination": { "type": "none" },
      "computed_fields": {
        "group_id": "{{ record.groupId }}",
        "resource_kind": "{{ record.resource.kind }}",
        "resource_id": "{{ record.resource.id }}"
      },
      "schema": "schemas/group_items.json"
    }
  ]
}
