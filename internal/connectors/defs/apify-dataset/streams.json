{
  "base": {
    "auth": [
      {
        "mode": "bearer",
        "token": "{{ secrets.token }}"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/datasets",
      "query": {
        "limit": "1"
      }
    },
    "error_map": [],
    "pagination": {
      "limit_param": "limit",
      "max_pages": 100,
      "offset_param": "offset",
      "page_size": 1000,
      "type": "offset_limit"
    },
    "url": "https://api.apify.com/v2",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "method": "GET",
      "name": "item_collection",
      "path": "/datasets/{{ config.dataset_id }}/items",
      "projection": "passthrough",
      "records": {
        "path": ".",
        "wrap_field": "data"
      },
      "schema": "schemas/item_collection.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "createdAt"
      },
      "method": "GET",
      "name": "dataset_collection",
      "path": "/datasets",
      "records": {
        "path": "data.items"
      },
      "schema": "schemas/dataset_collection.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "modifiedAt"
      },
      "method": "GET",
      "name": "dataset",
      "path": "/datasets/{{ config.dataset_id }}",
      "records": {
        "path": "data",
        "single_object": true
      },
      "schema": "schemas/dataset.json"
    }
  ]
}
