    "branch": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "commit_message": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "commit_sha": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "maxLength": 8192,
      "type": "string"
    },
    "submodule": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
