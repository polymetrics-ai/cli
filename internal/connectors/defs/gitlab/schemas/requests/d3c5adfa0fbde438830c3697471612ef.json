{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "context": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "maxLength": 600000,
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "maxLength": 255,
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "enum": [
              "file",
              "snippet"
            ],
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "type",
          "name",
          "content"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": [
        "array",
        "null"
      ]
    },
    "current_file": {
      "additionalProperties": false,
      "properties": {
        "content_above_cursor": {
          "maxLength": 400000,
          "type": [
            "string",
            "null"
          ]
        },
        "content_below_cursor": {
          "maxLength": 400000,
          "type": [
            "string",
            "null"
          ]
        },
        "file_name": {
          "maxLength": 255,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "file_name",
        "content_above_cursor"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "generation_type": {
      "enum": [
        "comment",
        "empty_function",
        "small_file"
      ],
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "intent": {
      "enum": [
        "completion",
        "generation"
      ],
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "project_path": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "stream": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "user_instruction": {
      "maxLength": 600000,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "current_file"
  ],
  "type": "object"
}
