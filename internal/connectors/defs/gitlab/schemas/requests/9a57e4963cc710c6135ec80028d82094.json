{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "description": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "due_date": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "maxLength": 8192,
      "type": "string"
    },
    "milestone_id": {
      "type": "integer"
    },
    "start_date": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "state_event": {
      "enum": [
        "close",
        "activate"
      ],
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "milestone_id"
  ],
  "type": "object"
}
