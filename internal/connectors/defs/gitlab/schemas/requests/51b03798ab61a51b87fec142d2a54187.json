{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "maxLength": 255,
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "maxLength": 2000,
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "items": {
            "type": "integer"
          },
          "maxItems": 256,
          "type": [
            "array",
            "null"
          ]
        },
        "service": {
          "maxLength": 255,
          "type": [
            "string",
            "null"
          ]
        },
        "stage_name": {
          "maxLength": 255,
          "type": [
            "string",
            "null"
          ]
        },
        "step_type": {
          "maxLength": 255,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "id": {
      "type": "integer"
    },
    "topic": {
      "enum": [
        "com.gitlab.cd.deployment"
      ],
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "maxLength": 255,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "data",
    "id",
    "topic",
    "type"
  ],
  "type": "object"
}
