{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "resource_name": {
      "enum": [
        "settings",
        "extensions",
        "globalState",
        "machines",
        "keybindings",
        "snippets",
        "tasks",
        "profiles"
      ],
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
    },
    "settings_context_hash": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "resource_name",
    "settings_context_hash"
  ],
  "type": "object"
}
