      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "user_id": {
      "type": "integer"
    },
    "username": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "user_id"
  ],
  "type": "object"
}
