  "properties": {
    "cluster_id": {
      "type": "integer"
    },
    "domain": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "enabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "environment_scope": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "managed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "management_project_id": {
      "type": [
        "integer",
        "null"
      ]
    },
