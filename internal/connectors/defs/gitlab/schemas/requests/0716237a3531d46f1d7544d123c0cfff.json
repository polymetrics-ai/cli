{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "apns_environment": {
      "enum": [
        "production",
        "sandbox"
      ],
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "app_version": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "bundle_id": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "device_name": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "device_token": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "locale": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "payload_mode": {
      "enum": [
        "full",
        "id_only"
      ],
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "platform": {
      "enum": [
        "ios"
      ],
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "device_token"
  ],
  "type": "object"
}
