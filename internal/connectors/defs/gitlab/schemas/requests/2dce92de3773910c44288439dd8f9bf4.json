{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "content": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "file_name": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "files": {
