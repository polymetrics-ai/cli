          },
          "content": {
            "maxLength": 8192,
            "type": [
              "string",
              "null"
            ]
          },
          "file_path": {
            "maxLength": 8192,
            "type": [
              "string",
              "null"
            ]
          },
          "previous_path": {
            "maxLength": 8192,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": [
        "array",
        "null"
      ]
    },
    "id": {
      "type": "integer"
    },
    "title": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "visibility": {
