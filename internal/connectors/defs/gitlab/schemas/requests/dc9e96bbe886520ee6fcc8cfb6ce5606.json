{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 8192,
      "type": "string"
    },
    "internal": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "merge_request_iid": {
      "type": "integer"
    },
    "note": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "reviewer_state": {
      "enum": [
        "requested_changes",
        "reviewed"
      ],
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "merge_request_iid"
  ],
  "type": "object"
}
