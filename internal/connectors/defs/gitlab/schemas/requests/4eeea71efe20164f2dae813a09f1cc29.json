{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "maxLength": 8192,
      "pattern": "(?:^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$)",
      "type": [
        "string",
        "null"
      ]
    },
    "event_type": {
      "enum": [
        "pause",
        "resume",
        "stop",
        "message",
        "response",
        "require_input"
      ],
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "message": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "event_type",
    "id",
    "message"
  ],
  "type": "object"
}
