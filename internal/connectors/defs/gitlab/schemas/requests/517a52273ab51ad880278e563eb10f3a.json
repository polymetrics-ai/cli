{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "description": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "expires_at": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "scopes": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "user_id": {
      "type": "integer"
    }
  },
  "required": [
    "name",
    "scopes",
    "user_id"
  ],
  "type": "object"
}
