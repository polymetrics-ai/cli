{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "access_level": {
      "enum": [
        10,
        15,
        20,
        25,
        30,
        40,
        50
      ],
      "type": [
        "integer",
        "null"
      ]
    },
    "description": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "expires_at": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "maxLength": 8192,
      "type": "string"
    },
    "name": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "scopes": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "scopes"
  ],
  "type": "object"
}
