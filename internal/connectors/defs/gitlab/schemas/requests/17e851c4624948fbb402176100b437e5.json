{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "access_level": {
      "enum": [
        "not_protected",
        "ref_protected"
      ],
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "active": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "description": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "info": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "maxLength": 8192,
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "maxLength": 8192,
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "maxLength": 8192,
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "maxLength": 8192,
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "maxLength": 8192,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "locked": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "maintainer_note": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "maintenance_note": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "maximum_timeout": {
      "type": [
        "integer",
        "null"
      ]
    },
    "paused": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "run_untagged": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "tag_list": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 256,
      "type": [
        "array",
        "null"
      ]
    },
    "token": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "token"
  ],
  "type": "object"
}
