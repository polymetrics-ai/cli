{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "broadcast_type": {
      "enum": [
        "banner",
        "notification"
      ],
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "color": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "dismissable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "ends_at": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "font": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "starts_at": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "target_access_levels": {
      "items": {
        "type": "integer"
      },
      "maxItems": 256,
      "type": [
        "array",
        "null"
      ]
    },
    "target_path": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "theme": {
      "enum": [
        "indigo",
        "light-indigo",
        "blue",
        "light-blue",
        "green",
        "light-green",
        "red",
        "light-red",
        "dark",
        "light"
      ],
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "message"
  ],
  "type": "object"
}
