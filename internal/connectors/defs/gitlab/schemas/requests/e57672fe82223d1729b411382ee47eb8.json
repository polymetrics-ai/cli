{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "percentage": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "plan": {
      "enum": [
        "bronze",
        "silver",
        "premium",
        "gold",
        "ultimate",
        "ultimate_trial",
        "ultimate_trial_paid_customer",
        "premium_trial",
        "opensource"
      ],
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "percentage",
    "plan"
  ],
  "type": "object"
}
