            "type": [
              "string",
              "null"
            ]
          },
          "data": {
            "maxLength": 8192,
            "type": [
              "string",
              "null"
            ]
          },
          "idx": {
            "type": [
              "integer",
              "null"
            ]
          },
          "task": {
            "maxLength": 8192,
            "type": [
              "string",
              "null"
            ]
          },
