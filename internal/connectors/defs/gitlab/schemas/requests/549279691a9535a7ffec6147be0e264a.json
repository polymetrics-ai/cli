{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "expires_at": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "key": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "usage_type": {
      "enum": [
        "auth_and_signing",
        "auth",
        "signing"
      ],
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "user_id": {
      "type": "integer"
    }
  },
  "required": [
    "key",
    "title",
    "user_id"
  ],
  "type": "object"
}
