{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "github_hostname": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "new_name": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "optional_stages": {
      "additionalProperties": false,
      "properties": {},
      "type": [
        "object",
        "null"
      ]
    },
    "pagination_limit": {
      "type": [
        "integer",
        "null"
      ]
    },
    "personal_access_token": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "repo_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "target_namespace": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "timeout_strategy": {
      "enum": [
        "optimistic",
        "pessimistic"
      ],
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "personal_access_token",
    "repo_id",
    "target_namespace"
  ],
  "type": "object"
}
