{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "connection_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "namespace_id": {
      "maxLength": 1048576,
      "type": [
        "integer",
        "null",
        "string"
      ]
    },
    "state": {
      "enum": [
        "pending",
        "ready"
      ],
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "namespace_id",
    "state"
  ],
  "type": "object"
}
