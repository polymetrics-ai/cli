{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "access_level": {
      "enum": [
        10,
        15,
        20,
        25,
        30,
        40,
        50,
        5
      ],
      "type": "integer"
    },
    "email": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 256,
      "type": [
        "array",
        "null"
      ]
    },
    "expires_at": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "maxLength": 8192,
      "type": "string"
    },
    "invite_source": {
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "member_role_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "user_id": {
      "items": {
        "maxLength": 8192,
        "type": "string"
      },
      "maxItems": 256,
      "type": [
        "array",
        "null"
      ]
    }
  },
  "required": [
    "access_level",
    "id"
  ],
  "type": "object"
}
