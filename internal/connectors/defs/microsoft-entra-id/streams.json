{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "auth": [
      {
        "mode": "oauth2_client_credentials",
        "token_url": "{{ config.token_url }}",
        "client_id": "{{ secrets.client_id }}",
        "client_secret": "{{ secrets.client_secret }}",
        "scopes": "{{ config.scope }}",
        "when": "{{ config.token_url }}"
      },
      {
        "mode": "oauth2_client_credentials",
        "token_url": "{{ config.login_base_url }}/{{ secrets.tenant_id }}/oauth2/v2.0/token",
        "client_id": "{{ secrets.client_id }}",
        "client_secret": "{{ secrets.client_secret }}",
        "scopes": "{{ config.scope }}"
      }
    ],
    "pagination": {
      "type": "none"
    },
    "check": {
      "method": "GET",
      "path": "/users",
      "query": {
        "$top": "1"
      }
    },
    "error_map": [
      {
        "status": 401,
        "hint": "microsoft-entra-id client_id/client_secret/tenant_id are missing or invalid; re-run pm credentials add microsoft-entra-id"
      },
      {
        "status": 403,
        "hint": "microsoft-entra-id application lacks Graph API directory permissions for this request"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "microsoft-entra-id rate limit exceeded; the connector will retry with backoff"
      }
    ]
  },
  "streams": [
    {
      "name": "users",
      "path": "/users",
      "records": {
        "path": "value"
      },
      "schema": "schemas/users.json"
    },
    {
      "name": "groups",
      "path": "/groups",
      "records": {
        "path": "value"
      },
      "schema": "schemas/groups.json"
    },
    {
      "name": "applications",
      "path": "/applications",
      "records": {
        "path": "value"
      },
      "schema": "schemas/applications.json"
    },
    {
      "name": "serviceprincipals",
      "path": "/servicePrincipals",
      "records": {
        "path": "value"
      },
      "schema": "schemas/serviceprincipals.json"
    },
    {
      "name": "directoryroles",
      "path": "/directoryRoles",
      "records": {
        "path": "value"
      },
      "schema": "schemas/directoryroles.json"
    }
  ]
}
