{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "headers": {
      "developer-token": "{{ secrets.developer_token }}",
      "login-customer-id": "{{ config.login_customer_id }}"
    },
    "auth": [
      {
        "mode": "bearer",
        "token": "{{ secrets.access_token }}"
      }
    ],
    "pagination": {
      "type": "none"
    },
    "check": {
      "method": "GET",
      "path": "v22/customers:listAccessibleCustomers"
    },
    "error_map": [
      {
        "status": 401,
        "hint": "google-ads access_token is missing, expired, or invalid; re-run pm credentials add google-ads"
      },
      {
        "status": 403,
        "hint": "google-ads developer_token/account lacks access for this request"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "google-ads rate limit exceeded; the connector will retry with backoff"
      }
    ]
  },
  "streams": [
    {
      "name": "accessible_customers",
      "method": "GET",
      "path": "v22/customers:listAccessibleCustomers",
      "records": {
        "path": "resourceNames"
      },
      "schema": "schemas/accessible_customers.json"
    },
    {
      "name": "campaigns",
      "method": "POST",
      "path": "v22/customers/{{ config.customer_id }}/googleAds:search",
      "records": {
        "path": "results"
      },
      "schema": "schemas/campaigns.json"
    },
    {
      "name": "ad_groups",
      "method": "POST",
      "path": "v22/customers/{{ config.customer_id }}/googleAds:search",
      "records": {
        "path": "results"
      },
      "schema": "schemas/ad_groups.json"
    }
  ]
}
