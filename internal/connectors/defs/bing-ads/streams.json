{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "auth": [
      {
        "mode": "none"
      }
    ],
    "pagination": {
      "type": "none"
    },
    "check": {
      "method": "POST",
      "path": "/AccountsInfo/Query"
    },
    "error_map": [
      {
        "status": 401,
        "hint": "bing-ads OAuth refresh grant failed, access token expired, or DeveloperToken is invalid; re-run pm credentials add bing-ads"
      },
      {
        "status": 403,
        "hint": "bing-ads account lacks access for this CustomerId/CustomerAccountId scope"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "Microsoft Advertising API rate limit exceeded; the connector will retry with backoff"
      }
    ]
  },
  "streams": [
    {
      "name": "accounts",
      "method": "POST",
      "path": "/AccountsInfo/Query",
      "records": {
        "path": "AccountsInfo"
      },
      "schema": "schemas/accounts.json"
    },
    {
      "name": "users",
      "method": "POST",
      "path": "/User/Query",
      "records": {
        "path": "User"
      },
      "schema": "schemas/users.json"
    },
    {
      "name": "campaigns",
      "method": "POST",
      "path": "/Campaigns/QueryByAccountId",
      "records": {
        "path": "Campaigns"
      },
      "schema": "schemas/campaigns.json"
    },
    {
      "name": "ad_groups",
      "method": "POST",
      "path": "/AdGroups/QueryByCampaignId",
      "records": {
        "path": "AdGroups"
      },
      "schema": "schemas/ad_groups.json"
    },
    {
      "name": "ads",
      "method": "POST",
      "path": "/Ads/QueryByAdGroupId",
      "records": {
        "path": "Ads"
      },
      "schema": "schemas/ads.json"
    }
  ]
}
