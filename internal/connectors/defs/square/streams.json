        "path": "payments"
      },
      "schema": "schemas/payments.json",
      "query": {
        "limit": "100",
        "updated_at_begin_time": {
          "template": "{{ incremental.lower_bound }}",
          "omit_when_absent": true
        }
      },
      "incremental": {
        "cursor_field": "updated_at",
        "request_param": "updated_at_begin_time",
        "param_format": "rfc3339",
        "start_config_key": "start_date"
      }
    },
    {
