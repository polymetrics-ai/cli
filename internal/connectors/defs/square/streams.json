{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "headers": {
      "Square-Version": "2026-07-15"
    },
    "auth": [
      {
        "mode": "bearer",
        "token": "{{ secrets.api_key }}"
      }
    ],
    "pagination": {
      "type": "cursor",
      "cursor_param": "cursor",
      "token_path": "cursor",
      "page_size": 100,
      "max_pages": 10
    },
    "check": {
      "method": "GET",
      "path": "/v2/locations"
    },
    "error_map": [
      {
        "status": 401,
        "hint": "square access token is missing or invalid; re-run pm credentials add square"
      },
      {
        "status": 403,
        "hint": "square account lacks access for this request"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "square rate limit exceeded; the connector will retry with backoff"
      }
    ]
  },
