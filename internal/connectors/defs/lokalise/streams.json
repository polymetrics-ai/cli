{
  "base": {
    "auth": [
      {
        "header": "X-Api-Token",
        "mode": "api_key_header",
        "value": "{{ secrets.api_key }}"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/projects/{{ config.project_id }}/languages",
      "query": {
        "limit": "1"
      }
    },
    "error_map": [],
    "pagination": {
      "max_pages": 10000,
      "page_param": "page",
      "page_size": 100,
      "size_param": "limit",
      "start_page": 1,
      "type": "page_number"
    },
    "url": "https://api.lokalise.com/api2",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "modified_at_timestamp"
      },
      "method": "GET",
      "name": "keys",
      "path": "/projects/{{ config.project_id }}/keys",
      "records": {
        "path": "keys"
      },
      "schema": "schemas/keys.json"
    },
    {
      "method": "GET",
      "name": "languages",
      "path": "/projects/{{ config.project_id }}/languages",
      "records": {
        "path": "languages"
      },
      "schema": "schemas/languages.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "modified_at_timestamp"
      },
      "method": "GET",
      "name": "translations",
      "path": "/projects/{{ config.project_id }}/translations",
      "records": {
        "path": "translations"
      },
      "schema": "schemas/translations.json"
    },
    {
      "method": "GET",
      "name": "contributors",
      "path": "/projects/{{ config.project_id }}/contributors",
      "records": {
        "path": "contributors"
      },
      "schema": "schemas/contributors.json"
    },
    {
      "method": "GET",
      "name": "comments",
      "path": "/projects/{{ config.project_id }}/comments",
      "records": {
        "path": "comments"
      },
      "schema": "schemas/comments.json"
    }
  ]
}
