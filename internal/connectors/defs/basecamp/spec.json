{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "access_token": {
      "description": "Basecamp bearer access token.",
      "type": "string",
      "x-secret": true
    },
    "account_id": {
      "description": "Basecamp account ID.",
      "type": "string"
    },
    "client_id": {
      "description": "OAuth client ID.",
      "type": "string",
      "x-secret": true
    },
    "client_secret": {
      "description": "OAuth client secret.",
      "type": "string",
      "x-secret": true
    },
    "refresh_token": {
      "description": "OAuth refresh token.",
      "type": "string",
      "x-secret": true
    }
  },
  "required": [
    "account_id"
  ],
  "title": "Basecamp Connection Specification",
  "type": "object",
  "x-reject-unknown-config": true
}
