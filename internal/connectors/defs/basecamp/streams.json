{
  "base": {
    "auth": [
      {
        "mode": "bearer",
        "token": "{{ secrets.access_token }}",
        "when": "{{ secrets.access_token }}"
      },
      {
        "client_id": "{{ secrets.client_id }}",
        "client_secret": "{{ secrets.client_secret }}",
        "mode": "oauth2_refresh_token",
        "refresh_token": "{{ secrets.refresh_token }}",
        "token_url": "https://launchpad.37signals.com/authorization/token"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/projects.json"
    },
    "error_map": [],
    "pagination": {
      "max_pages": 100,
      "type": "link_header"
    },
    "url": "https://3.basecampapi.com/{{ config.account_id }}",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "updated_at"
      },
      "method": "GET",
      "name": "projects",
      "path": "/projects.json",
      "projection": "passthrough",
      "records": {
        "path": "."
      },
      "schema": "schemas/projects.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "updated_at"
      },
      "method": "GET",
      "name": "people",
      "path": "/people.json",
      "projection": "passthrough",
      "records": {
        "path": "."
      },
      "schema": "schemas/people.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "created_at"
      },
      "method": "GET",
      "name": "events",
      "path": "/events.json",
      "projection": "passthrough",
      "records": {
        "path": "."
      },
      "schema": "schemas/events.json"
    }
  ]
}
