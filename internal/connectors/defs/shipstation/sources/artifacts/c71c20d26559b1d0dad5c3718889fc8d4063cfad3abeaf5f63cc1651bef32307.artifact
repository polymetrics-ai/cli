                    "type": "string",
                    "example": ""
                  },
                  "publicEmail": {
                    "type": "string",
                    "example": ""
                  },
                  "website": {
                    "type": "string",
                    "example": ""
                  },
                  "autoRefresh": {
                    "type": "boolean",
                    "example": true
                  },
