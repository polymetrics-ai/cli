{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "adjusted": {
      "default": "false",
      "description": "Intraday adjusted-series selector.",
      "type": "string"
    },
    "api_key": {
      "description": "Alpha Vantage API key.",
      "type": "string",
      "x-secret": true
    },
    "interval": {
      "default": "1min",
      "description": "Intraday interval.",
      "type": "string"
    },
    "outputsize": {
      "default": "compact",
      "description": "Time-series response window.",
      "type": "string"
    },
    "symbol": {
      "description": "Stock symbol with exchange code.",
      "type": "string"
    }
  },
  "required": [
    "api_key",
    "symbol"
  ],
  "title": "Alpha Vantage Connection Specification",
  "type": "object",
  "x-reject-unknown-config": true
}
