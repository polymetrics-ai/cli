{
  "base": {
    "auth": [
      {
        "mode": "basic",
        "password": "{{ secrets.api_secret }}",
        "username": "{{ secrets.api_token }}"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/{{ config.workspace }}/spaces"
    },
    "error_map": [],
    "headers": {
      "Accept": "application/hal+json"
    },
    "pagination": {
      "max_pages": 1000,
      "next_url_path": "_links.next.href",
      "type": "next_url"
    },
    "url": "https://app.mode.com/api",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "updated_at"
      },
      "method": "GET",
      "name": "spaces",
      "path": "/{{ config.workspace }}/spaces",
      "records": {
        "path": "_embedded.spaces"
      },
      "schema": "schemas/spaces.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "updated_at"
      },
      "method": "GET",
      "name": "reports",
      "path": "/{{ config.workspace }}/reports",
      "records": {
        "path": "_embedded.reports"
      },
      "schema": "schemas/reports.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "updated_at"
      },
      "method": "GET",
      "name": "data_sources",
      "path": "/{{ config.workspace }}/data_sources",
      "records": {
        "path": "_embedded.data_sources"
      },
      "schema": "schemas/data_sources.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "updated_at"
      },
      "method": "GET",
      "name": "groups",
      "path": "/{{ config.workspace }}/groups",
      "records": {
        "path": "_embedded.groups"
      },
      "schema": "schemas/groups.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "created_at"
      },
      "method": "GET",
      "name": "memberships",
      "path": "/{{ config.workspace }}/memberships",
      "records": {
        "path": "_embedded.memberships"
      },
      "schema": "schemas/memberships.json"
    }
  ]
}
