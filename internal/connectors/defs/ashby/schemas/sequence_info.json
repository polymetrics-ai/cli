{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "applicationId": {
      "type": "string"
    },
    "candidateId": {
      "description": "The candidate enrolled in the sequence",
      "type": "string"
    },
    "createdAt": {
      "description": "When the sequence enrollment was created",
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "description": "The unique identifier for this candidate's sequence enrollment",
      "type": "string"
    },
    "sequenceTemplateId": {
      "description": "The reusable sequence template used for enrollment",
      "type": "string"
    },
    "stages": {
      "description": "The stages in sequence order",
      "items": {
        "properties": {
          "bodyHtml": {
            "description": "The editable HTML body for a not-started email stage. Ashby token markers must be preserved when editing.",
            "type": "string"
          },
          "from": {
            "properties": {
              "displayName": {
                "type": "string"
              },
              "email": {
                "description": "The address used to send this stage",
                "format": "email",
                "type": "string"
              }
            },
            "required": [
              "email",
              "displayName"
            ],
            "type": "object"
          },
          "id": {
            "description": "The unique identifier for this sequence stage",
            "type": "string"
          },
          "sendAfter": {
            "properties": {
              "kind": {
                "enum": [
                  "NoDelay"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "subject": {
            "description": "The resolved subject for an editable, not-started email stage",
            "type": "string"
          },
          "type": {
            "enum": [
              "Email",
              "InMail",
              "LinkedInConnection"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "sendAfter"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "NotStarted",
        "Running",
        "Paused",
        "Completed",
        "Cancelled",
        "Unsubscribed"
      ],
      "type": "string"
    }
  },
  "title": "sequence_info",
  "type": "object",
  "x-primary-key": [
    "id"
  ]
}
