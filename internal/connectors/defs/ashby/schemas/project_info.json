{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "authorId": {
      "description": "The unique identifier for the user who created the project",
      "type": "string"
    },
    "confidential": {
      "description": "Whether the project is confidential",
      "type": "boolean"
    },
    "createdAt": {
      "description": "The date and time when the project was created",
      "format": "date-time",
      "type": "string"
    },
    "customFieldEntries": {
      "items": {
        "properties": {
          "id": {
            "description": "The unique identifier for the custom field",
            "type": "string"
          },
          "isPrivate": {
            "description": "Whether the custom field is private",
            "type": "boolean"
          },
          "title": {
            "description": "The custom field's title",
            "type": "string"
          },
          "value": {
            "properties": {
              "currencyCode": {
                "description": "The ISO currency code",
                "type": "string"
              },
              "value": {
                "description": "The currency amount",
                "type": "number"
              }
            },
            "required": [
              "value",
              "currencyCode"
            ],
            "type": "object"
          },
          "valueLabel": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "isPrivate",
          "title",
          "value"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "description": {
      "type": "string"
    },
    "id": {
      "description": "The unique identifier for the project",
      "type": "string"
    },
    "isArchived": {
      "description": "Whether the project is archived",
      "type": "boolean"
    },
    "title": {
      "description": "The project's title",
      "type": "string"
    }
  },
  "title": "project_info",
  "type": "object",
  "x-primary-key": [
    "id"
  ]
}
