{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "candidates",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The unique identifier for the candidate"
    },
    "createdAt": {
      "type": "string",
      "description": "The timestamp when the candidate was created"
    },
    "updatedAt": {
      "type": "string",
      "description": "The timestamp when the candidate was last updated"
    },
    "name": {
      "type": "string",
      "description": "The candidate's name"
    },
    "primaryEmailAddress": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "description": "The email address or phone number of the candidate"
        },
        "type": {
          "type": "string",
          "description": "The type of the contact info",
          "enum": [
            "Personal",
            "Work",
            "Other"
          ]
        },
        "isPrimary": {
          "type": "boolean",
          "description": "Whether the contact info is the primary email or phone number"
        }
      },
      "required": [
        "value",
        "type",
        "isPrimary"
      ]
    },
    "emailAddresses": {
      "type": "array",
      "description": "The candidate's email addresses",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "The email address or phone number of the candidate"
          },
          "type": {
            "type": "string",
            "description": "The type of the contact info",
            "enum": [
              "Personal",
              "Work",
              "Other"
            ]
          },
          "isPrimary": {
            "type": "boolean",
            "description": "Whether the contact info is the primary email or phone number"
          }
        },
        "required": [
          "value",
          "type",
          "isPrimary"
        ]
      }
    },
    "primaryPhoneNumber": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "description": "The email address or phone number of the candidate"
        },
        "type": {
          "type": "string",
          "description": "The type of the contact info",
          "enum": [
            "Personal",
            "Work",
            "Other"
          ]
        },
        "isPrimary": {
          "type": "boolean",
          "description": "Whether the contact info is the primary email or phone number"
        }
      },
      "required": [
        "value",
        "type",
        "isPrimary"
      ]
    },
    "phoneNumbers": {
      "type": "array",
      "description": "The candidate's phone numbers",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "The email address or phone number of the candidate"
          },
          "type": {
            "type": "string",
            "description": "The type of the contact info",
            "enum": [
              "Personal",
              "Work",
              "Other"
            ]
          },
          "isPrimary": {
            "type": "boolean",
            "description": "Whether the contact info is the primary email or phone number"
          }
        },
        "required": [
          "value",
          "type",
          "isPrimary"
        ]
      }
    },
    "socialLinks": {
      "type": "array",
      "description": "The candidate's social links",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "The type of social link",
            "enum": [
              "LinkedIn",
              "GitHub",
              "Twitter",
              "Medium",
              "StackOverflow",
              "Website",
              "YouTube",
              "CodePen"
            ]
          },
          "url": {
            "type": "string",
            "description": "The URL of the social profile"
          }
        },
        "required": [
          "type",
          "url"
        ]
      }
    },
    "tags": {
      "type": "array",
      "description": "The candidate's tags",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The candidate tag's unique identifier"
          },
          "title": {
            "type": "string",
            "description": "The tag's title"
          },
          "isArchived": {
            "type": "boolean",
            "description": "Whether the tag has been archived"
          }
        },
        "required": [
          "id",
          "title",
          "isArchived"
        ]
      }
    },
    "position": {
      "type": "string",
      "description": "The candidate's current position"
    },
    "company": {
      "type": "string",
      "description": "The candidate's current company"
    },
    "school": {
      "type": "string",
      "description": "The candidate's school"
    },
    "applicationIds": {
      "type": "array",
      "description": "The unique identifiers of the candidate's applications",
      "items": {
        "type": "string"
      }
    },
    "resumeFileHandle": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier for the file"
        },
        "name": {
          "type": "string",
          "description": "The file name"
        },
        "handle": {
          "type": "string",
          "description": "The file handle, which can be used with the file.info endpoint"
        }
      },
      "required": [
        "id",
        "name",
        "handle"
      ]
    },
    "fileHandles": {
      "type": "array",
      "description": "The file handles associated with the candidate",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier for the file"
          },
          "name": {
            "type": "string",
            "description": "The file name"
          },
          "handle": {
            "type": "string",
            "description": "The file handle, which can be used with the file.info endpoint"
          }
        },
        "required": [
          "id",
          "name",
          "handle"
        ]
      }
    },
    "customFields": {
      "type": "array",
      "description": "The custom field values associated with the candidate",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier for the custom field definition"
          },
          "isPrivate": {
            "type": "boolean",
            "description": "Whether the custom field is private"
          },
          "title": {
            "type": "string",
            "description": "The title of the custom field"
          },
          "value": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "description": "The currency amount"
              },
              "currencyCode": {
                "type": "string",
                "description": "The currency code"
              }
            },
            "required": [
              "value",
              "currencyCode"
            ]
          },
          "valueLabel": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "isPrivate",
          "title",
          "value"
        ]
      }
    },
    "profileUrl": {
      "type": "string",
      "description": "The URL of the candidate's profile in Ashby"
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The source's unique identifier"
        },
        "title": {
          "type": "string",
          "description": "The title of the source"
        },
        "isArchived": {
          "type": "boolean",
          "description": "Whether the source has been archived"
        },
        "sourceType": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The source type's unique identifier"
            },
            "title": {
              "type": "string",
              "description": "The title of the source type"
            },
            "isArchived": {
              "type": "boolean",
              "description": "Whether the source type has been archived"
            }
          },
          "required": [
            "id",
            "title",
            "isArchived"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "isArchived",
        "sourceType"
      ]
    },
    "creditedToUser": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier for the user"
        },
        "firstName": {
          "type": "string",
          "description": "The user's first name"
        },
        "lastName": {
          "type": "string",
          "description": "The user's last name"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "globalRole": {
          "type": "string",
          "description": "The user's global role in the organization",
          "enum": [
            "Organization Admin",
            "Elevated Access",
            "Limited Access",
            "External Recruiter"
          ]
        },
        "isEnabled": {
          "type": "boolean",
          "description": "Whether the user is enabled (not deactivated)"
        },
        "updatedAt": {
          "type": "string",
          "description": "The timestamp when the user was last updated (ISO 8601 format)"
        },
        "managerId": {
          "type": "string",
          "description": "The unique identifier for the user's manager"
        },
        "customFields": {
          "type": "array",
          "description": "Custom fields associated with the user (only included when requested)",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The unique identifier for the custom field definition"
              },
              "isPrivate": {
                "type": "boolean",
                "description": "Whether the custom field is private"
              },
              "title": {
                "type": "string",
                "description": "The title of the custom field"
              },
              "value": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "description": "The currency amount"
                  },
                  "currencyCode": {
                    "type": "string",
                    "description": "The currency code"
                  }
                },
                "required": [
                  "value",
                  "currencyCode"
                ]
              },
              "valueLabel": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "isPrivate",
              "title",
              "value"
            ]
          }
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "globalRole",
        "isEnabled",
        "updatedAt"
      ]
    },
    "timezone": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier for the location"
        },
        "locationSummary": {
          "type": "string"
        },
        "locationComponents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "The type of the location component"
              },
              "name": {
                "type": "string",
                "description": "The name of the location component"
              }
            },
            "required": [
              "type",
              "name"
            ]
          }
        }
      },
      "required": [
        "id",
        "locationSummary",
        "locationComponents"
      ]
    },
    "fraudStatus": {
      "type": "string",
      "enum": [
        "Fraudulent",
        "NotFraudulent",
        "Unsure",
        "Unreviewed",
        "PassedFraudCheck"
      ]
    }
  },
  "x-primary-key": [
    "id"
  ]
}
