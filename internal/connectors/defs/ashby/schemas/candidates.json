{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "applicationIds": {
      "description": "The unique identifiers of the candidate's applications",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "company": {
      "description": "The candidate's current company",
      "type": "string"
    },
    "createdAt": {
      "description": "The timestamp when the candidate was created",
      "type": "string"
    },
    "creditedToUser": {
      "properties": {
        "customFields": {
          "description": "Custom fields associated with the user (only included when requested)",
          "items": {
            "properties": {
              "id": {
                "description": "The unique identifier for the custom field definition",
                "type": "string"
              },
              "isPrivate": {
                "description": "Whether the custom field is private",
                "type": "boolean"
              },
              "title": {
                "description": "The title of the custom field",
                "type": "string"
              },
              "value": {
                "properties": {
                  "currencyCode": {
                    "description": "The currency code",
                    "type": "string"
                  },
                  "value": {
                    "description": "The currency amount",
                    "type": "number"
                  }
                },
                "required": [
                  "value",
                  "currencyCode"
                ],
                "type": "object"
              },
              "valueLabel": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "isPrivate",
              "title",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "email": {
          "format": "email",
          "type": "string"
        },
        "firstName": {
          "description": "The user's first name",
          "type": "string"
        },
        "globalRole": {
          "description": "The user's global role in the organization",
          "enum": [
            "Organization Admin",
            "Elevated Access",
            "Limited Access",
            "External Recruiter"
          ],
          "type": "string"
        },
        "id": {
          "description": "The unique identifier for the user",
          "type": "string"
        },
        "isEnabled": {
          "description": "Whether the user is enabled (not deactivated)",
          "type": "boolean"
        },
        "lastName": {
          "description": "The user's last name",
          "type": "string"
        },
        "managerId": {
          "description": "The unique identifier for the user's manager",
          "type": "string"
        },
        "updatedAt": {
          "description": "The timestamp when the user was last updated (ISO 8601 format)",
          "type": "string"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "globalRole",
        "isEnabled",
        "updatedAt"
      ],
      "type": "object"
    },
    "customFields": {
      "description": "The custom field values associated with the candidate",
      "items": {
        "properties": {
          "id": {
            "description": "The unique identifier for the custom field definition",
            "type": "string"
          },
          "isPrivate": {
            "description": "Whether the custom field is private",
            "type": "boolean"
          },
          "title": {
            "description": "The title of the custom field",
            "type": "string"
          },
          "value": {
            "properties": {
              "currencyCode": {
                "description": "The currency code",
                "type": "string"
              },
              "value": {
                "description": "The currency amount",
                "type": "number"
              }
            },
            "required": [
              "value",
              "currencyCode"
            ],
            "type": "object"
          },
          "valueLabel": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "isPrivate",
          "title",
          "value"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "emailAddresses": {
      "description": "The candidate's email addresses",
      "items": {
        "properties": {
          "isPrimary": {
            "description": "Whether the contact info is the primary email or phone number",
            "type": "boolean"
          },
          "type": {
            "description": "The type of the contact info",
            "enum": [
              "Personal",
              "Work",
              "Other"
            ],
            "type": "string"
          },
          "value": {
            "description": "The email address or phone number of the candidate",
            "type": "string"
          }
        },
        "required": [
          "value",
          "type",
          "isPrimary"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "fileHandles": {
      "description": "The file handles associated with the candidate",
      "items": {
        "properties": {
          "handle": {
            "description": "The file handle, which can be used with the file.info endpoint",
            "type": "string"
          },
          "id": {
            "description": "The unique identifier for the file",
            "type": "string"
          },
          "name": {
            "description": "The file name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "handle"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "fraudStatus": {
      "enum": [
        "Fraudulent",
        "NotFraudulent",
        "Unsure",
        "Unreviewed",
        "PassedFraudCheck"
      ],
      "type": "string"
    },
    "id": {
      "description": "The unique identifier for the candidate",
      "type": "string"
    },
    "location": {
      "properties": {
        "id": {
          "description": "The unique identifier for the location",
          "type": "string"
        },
        "locationComponents": {
          "items": {
            "properties": {
              "name": {
                "description": "The name of the location component",
                "type": "string"
              },
              "type": {
                "description": "The type of the location component",
                "type": "string"
              }
            },
            "required": [
              "type",
              "name"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "locationSummary": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "locationSummary",
        "locationComponents"
      ],
      "type": "object"
    },
    "name": {
      "description": "The candidate's name",
      "type": "string"
    },
    "phoneNumbers": {
      "description": "The candidate's phone numbers",
      "items": {
        "properties": {
          "isPrimary": {
            "description": "Whether the contact info is the primary email or phone number",
            "type": "boolean"
          },
          "type": {
            "description": "The type of the contact info",
            "enum": [
              "Personal",
              "Work",
              "Other"
            ],
            "type": "string"
          },
          "value": {
            "description": "The email address or phone number of the candidate",
            "type": "string"
          }
        },
        "required": [
          "value",
          "type",
          "isPrimary"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "position": {
      "description": "The candidate's current position",
      "type": "string"
    },
    "primaryEmailAddress": {
      "properties": {
        "isPrimary": {
          "description": "Whether the contact info is the primary email or phone number",
          "type": "boolean"
        },
        "type": {
          "description": "The type of the contact info",
          "enum": [
            "Personal",
            "Work",
            "Other"
          ],
          "type": "string"
        },
        "value": {
          "description": "The email address or phone number of the candidate",
          "type": "string"
        }
      },
      "required": [
        "value",
        "type",
        "isPrimary"
      ],
      "type": "object"
    },
    "primaryPhoneNumber": {
      "properties": {
        "isPrimary": {
          "description": "Whether the contact info is the primary email or phone number",
          "type": "boolean"
        },
        "type": {
          "description": "The type of the contact info",
          "enum": [
            "Personal",
            "Work",
            "Other"
          ],
          "type": "string"
        },
        "value": {
          "description": "The email address or phone number of the candidate",
          "type": "string"
        }
      },
      "required": [
        "value",
        "type",
        "isPrimary"
      ],
      "type": "object"
    },
    "profileUrl": {
      "description": "The URL of the candidate's profile in Ashby",
      "type": "string"
    },
    "resumeFileHandle": {
      "properties": {
        "handle": {
          "description": "The file handle, which can be used with the file.info endpoint",
          "type": "string"
        },
        "id": {
          "description": "The unique identifier for the file",
          "type": "string"
        },
        "name": {
          "description": "The file name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "handle"
      ],
      "type": "object"
    },
    "school": {
      "description": "The candidate's school",
      "type": "string"
    },
    "socialLinks": {
      "description": "The candidate's social links",
      "items": {
        "properties": {
          "type": {
            "description": "The type of social link",
            "enum": [
              "LinkedIn",
              "GitHub",
              "Twitter",
              "Medium",
              "StackOverflow",
              "Website",
              "YouTube",
              "CodePen"
            ],
            "type": "string"
          },
          "url": {
            "description": "The URL of the social profile",
            "type": "string"
          }
        },
        "required": [
          "type",
          "url"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "source": {
      "properties": {
        "id": {
          "description": "The source's unique identifier",
          "type": "string"
        },
        "isArchived": {
          "description": "Whether the source has been archived",
          "type": "boolean"
        },
        "sourceType": {
          "properties": {
            "id": {
              "description": "The source type's unique identifier",
              "type": "string"
            },
            "isArchived": {
              "description": "Whether the source type has been archived",
              "type": "boolean"
            },
            "title": {
              "description": "The title of the source type",
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "isArchived"
          ],
          "type": "object"
        },
        "title": {
          "description": "The title of the source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "isArchived",
        "sourceType"
      ],
      "type": "object"
    },
    "tags": {
      "description": "The candidate's tags",
      "items": {
        "properties": {
          "id": {
            "description": "The candidate tag's unique identifier",
            "type": "string"
          },
          "isArchived": {
            "description": "Whether the tag has been archived",
            "type": "boolean"
          },
          "title": {
            "description": "The tag's title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "isArchived"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "timezone": {
      "type": "string"
    },
    "updatedAt": {
      "description": "The timestamp when the candidate was last updated",
      "type": "string"
    }
  },
  "title": "candidates",
  "type": "object",
  "x-primary-key": [
    "id"
  ]
}
