{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "candidate_tag_list",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The candidate tag's unique identifier"
    },
    "title": {
      "type": "string",
      "description": "The tag's title"
    },
    "isArchived": {
      "type": "boolean",
      "description": "Whether the tag has been archived"
    }
  },
  "x-primary-key": [
    "id"
  ]
}
