      "type": "string"
    },
    "employmentType": {
      "description": "The employment type for the job posting",
      "type": "string"
    },
    "externalLink": {
      "format": "uri",
      "type": "string"
    },
    "id": {
      "description": "The job posting's id",
      "type": "string"
    },
    "isListed": {
      "description": "Whether or not the job posting is listed",
      "type": "boolean"
    },
    "isRemote": {
      "type": "boolean"
    },
    "job": {
      "properties": {},
      "type": "object"
    },
    "jobId": {
      "description": "The id of the job associated with the job posting",
      "type": "string"
    },
    "linkedData": {
      "properties": {
        "@context": {
          "description": "The JSON-LD context",
          "type": "string"
        },
        "@type": {
          "description": "The JSON-LD type",
          "type": "string"
        },
        "datePosted": {
          "description": "The date the job posting was published",
          "type": "string"
        },
        "description": {
          "description": "The job posting's description",
          "type": "string"
        },
        "employmentType": {
          "description": "The employment type for the job posting",
          "type": "string"
        },
        "hiringOrganization": {
          "description": "The organization hiring for the job posting",
          "properties": {
            "@type": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "sameAs": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "identifier": {
          "description": "The job posting's identifier",
          "properties": {
            "@type": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "jobLocation": {
          "description": "The location of the job posting",
          "properties": {
            "@type": {
              "type": "string"
            },
            "address": {
              "properties": {
                "@type": {
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "title": {
          "description": "The job posting's title",
          "type": "string"
        }
      },
      "type": "object"
