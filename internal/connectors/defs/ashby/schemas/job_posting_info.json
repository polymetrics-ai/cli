    "applicationLimitCalloutHtml": {
      "type": "string"
    },
    "applyLink": {
      "description": "The link to apply to the job posting",
      "format": "uri",
      "type": "string"
    },
    "compensation": {
      "properties": {
        "compensationTierSummary": {
          "type": "string"
        },
        "compensationTiers": {
          "description": "The compensation ranges that can be offered to applicants for this posting",
          "items": {
            "properties": {
              "additionalInformation": {
                "type": "string"
              },
              "components": {
                "description": "The compensation components in this tier",
                "items": {
                  "properties": {
                    "compensationType": {
                      "description": "The type of compensation",
                      "type": "string"
                    },
                    "currencyCode": {
                      "type": "string"
                    },
                    "id": {
                      "description": "The component id",
                      "type": "string"
                    },
                    "interval": {
                      "description": "The compensation interval",
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "maxValue": {
                      "type": "number"
                    },
                    "minValue": {
                      "type": "number"
                    },
                    "summary": {
