            "required": [
              "id",
              "tierSummary",
              "title",
              "additionalInformation",
              "components"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "shouldDisplayCompensation": {
          "description": "Whether compensation should be shown to applicants for this job posting",
          "type": "boolean"
        },
        "summaryComponents": {
          "description": "The summary compensation components for the job posting",
          "items": {
            "properties": {
              "compensationType": {
                "description": "The type of compensation",
                "type": "string"
              },
              "currencyCode": {
                "type": "string"
              },
              "interval": {
                "description": "The compensation interval",
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "maxValue": {
                "type": "number"
              },
              "minValue": {
                "type": "number"
              },
              "summary": {
                "description": "A human-readable summary of the compensation component",
                "type": "string"
              }
