{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "job_posting_info",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The job posting's id"
    },
    "title": {
      "type": "string",
      "description": "The job posting's title"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Published"
      ]
    },
    "descriptionPlain": {
      "type": "string",
      "description": "A plaintext version of the job posting's description"
    },
    "descriptionHtml": {
      "type": "string",
      "description": "An HTML version of the job posting's description"
    },
    "descriptionSocial": {
      "type": "string"
    },
    "descriptionParts": {
      "type": "object",
      "properties": {
        "descriptionOpening": {
          "type": "object",
          "properties": {
            "html": {
              "type": "string"
            },
            "plain": {
              "type": "string"
            }
          },
          "required": [
            "html",
            "plain"
          ]
        },
        "descriptionBody": {
          "type": "object",
          "properties": {
            "html": {
              "type": "string"
            },
            "plain": {
              "type": "string"
            }
          },
          "required": [
            "html",
            "plain"
          ]
        },
        "descriptionClosing": {
          "type": "object",
          "properties": {
            "html": {
              "type": "string"
            },
            "plain": {
              "type": "string"
            }
          },
          "required": [
            "html",
            "plain"
          ]
        }
      },
      "required": [
        "descriptionOpening",
        "descriptionBody",
        "descriptionClosing"
      ]
    },
    "departmentName": {
      "type": "string",
      "description": "The name of the department associated with the job posting"
    },
    "teamName": {
      "type": "string",
      "description": "The name of the team associated with the job posting"
    },
    "teamNameHierarchy": {
      "type": "array",
      "description": "The hierarchy of team names associated with the job posting",
      "items": {
        "type": "string"
      }
    },
    "jobId": {
      "type": "string",
      "description": "The id of the job associated with the job posting"
    },
    "locationName": {
      "type": "string",
      "description": "The name of the primary location associated with the job posting"
    },
    "locationAddress": {
      "type": "string"
    },
    "locationIds": {
      "type": "object",
      "properties": {
        "primaryLocationId": {
          "type": "string"
        },
        "secondaryLocationIds": {
          "type": "array",
          "description": "The secondary location ids for the job posting",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "primaryLocationId",
        "secondaryLocationIds"
      ]
    },
    "linkedData": {
      "type": "object",
      "properties": {
        "@context": {
          "type": "string",
          "description": "The JSON-LD context"
        },
        "@type": {
          "type": "string",
          "description": "The JSON-LD type"
        },
        "title": {
          "type": "string",
          "description": "The job posting's title"
        },
        "description": {
          "type": "string",
          "description": "The job posting's description"
        },
        "datePosted": {
          "type": "string",
          "description": "The date the job posting was published"
        },
        "employmentType": {
          "type": "string",
          "description": "The employment type for the job posting"
        },
        "hiringOrganization": {
          "type": "object",
          "description": "The organization hiring for the job posting",
          "properties": {
            "@type": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "sameAs": {
              "type": "string"
            }
          }
        },
        "identifier": {
          "type": "object",
          "description": "The job posting's identifier",
          "properties": {
            "@type": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        "jobLocation": {
          "type": "object",
          "description": "The location of the job posting",
          "properties": {
            "@type": {
              "type": "string"
            },
            "address": {
              "type": "object",
              "properties": {
                "@type": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "publishedDate": {
      "type": "string",
      "format": "date"
    },
    "applicationDeadline": {
      "type": "string",
      "format": "date-time"
    },
    "address": {
      "type": "object",
      "properties": {
        "postalAddress": {
          "type": "object",
          "description": "The postal address of the job posting",
          "properties": {
            "addressCountry": {
              "type": "string"
            },
            "addressRegion": {
              "type": "string"
            },
            "addressLocality": {
              "type": "string"
            },
            "postalCode": {
              "type": "string"
            },
            "streetAddress": {
              "type": "string"
            }
          }
        }
      }
    },
    "isRemote": {
      "type": "boolean"
    },
    "workplaceType": {
      "type": "string",
      "enum": [
        "OnSite",
        "Hybrid",
        "Remote"
      ]
    },
    "employmentType": {
      "type": "string",
      "description": "The employment type for the job posting"
    },
    "applicationFormDefinition": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "array",
          "description": "The sections in the form definition",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "descriptionHtml": {
                "type": "string"
              },
              "descriptionPlain": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "description": "The fields in this form section",
                "items": {
                  "type": "object",
                  "properties": {
                    "isRequired": {
                      "type": "boolean",
                      "description": "Whether this form field is required"
                    },
                    "descriptionHtml": {
                      "type": "string"
                    },
                    "descriptionPlain": {
                      "type": "string"
                    },
                    "field": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "The unique identifier for the form definition field"
                        },
                        "type": {
                          "type": "string",
                          "description": "The type of the form definition field"
                        },
                        "path": {
                          "type": "string",
                          "description": "The path used to submit values for this field"
                        },
                        "humanReadablePath": {
                          "type": "string",
                          "description": "The human-readable path for the form field"
                        },
                        "title": {
                          "type": "string",
                          "description": "The display title for the form field"
                        },
                        "isNullable": {
                          "type": "boolean",
                          "description": "Whether the form field accepts null values"
                        },
                        "selectableValues": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "label": {
                                "type": "string",
                                "description": "The display label for the selectable value"
                              },
                              "value": {
                                "type": "string",
                                "description": "The submitted value for the selectable option"
                              }
                            },
                            "required": [
                              "label",
                              "value"
                            ]
                          }
                        }
                      },
                      "required": [
                        "id",
                        "type",
                        "path",
                        "humanReadablePath",
                        "title",
                        "isNullable"
                      ]
                    }
                  },
                  "required": [
                    "isRequired",
                    "field"
                  ]
                }
              }
            },
            "required": [
              "fields"
            ]
          }
        }
      },
      "required": [
        "sections"
      ]
    },
    "surveyFormDefinitions": {
      "type": "array",
      "description": "Additional survey forms collected alongside the application form",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier for the survey form definition"
          },
          "title": {
            "type": "string",
            "description": "The title of the survey form definition"
          },
          "isArchived": {
            "type": "boolean",
            "description": "Whether the survey form definition is archived"
          },
          "formDefinition": {
            "type": "object",
            "properties": {
              "sections": {
                "type": "array",
                "description": "The sections in the form definition",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "descriptionHtml": {
                      "type": "string"
                    },
                    "descriptionPlain": {
                      "type": "string"
                    },
                    "fields": {
                      "type": "array",
                      "description": "The fields in this form section",
                      "items": {
                        "type": "object",
                        "properties": {
                          "isRequired": {
                            "type": "boolean",
                            "description": "Whether this form field is required"
                          },
                          "descriptionHtml": {
                            "type": "string"
                          },
                          "descriptionPlain": {
                            "type": "string"
                          },
                          "field": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "description": "The unique identifier for the form definition field"
                              },
                              "type": {
                                "type": "string",
                                "description": "The type of the form definition field"
                              },
                              "path": {
                                "type": "string",
                                "description": "The path used to submit values for this field"
                              },
                              "humanReadablePath": {
                                "type": "string",
                                "description": "The human-readable path for the form field"
                              },
                              "title": {
                                "type": "string",
                                "description": "The display title for the form field"
                              },
                              "isNullable": {
                                "type": "boolean",
                                "description": "Whether the form field accepts null values"
                              },
                              "selectableValues": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "label": {
                                      "type": "string",
                                      "description": "The display label for the selectable value"
                                    },
                                    "value": {
                                      "type": "string",
                                      "description": "The submitted value for the selectable option"
                                    }
                                  },
                                  "required": [
                                    "label",
                                    "value"
                                  ]
                                }
                              }
                            },
                            "required": [
                              "id",
                              "type",
                              "path",
                              "humanReadablePath",
                              "title",
                              "isNullable"
                            ]
                          }
                        },
                        "required": [
                          "isRequired",
                          "field"
                        ]
                      }
                    }
                  },
                  "required": [
                    "fields"
                  ]
                }
              }
            },
            "required": [
              "sections"
            ]
          },
          "surveyType": {
            "type": "string",
            "description": "The type of survey",
            "enum": [
              "EEOC",
              "Diversity",
              "CandidateExperience",
              "CandidateDataConsent",
              "Questionnaire",
              "QualityOfHire",
              "HiringManagerExperience"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "isArchived",
          "formDefinition",
          "surveyType"
        ]
      }
    },
    "isListed": {
      "type": "boolean",
      "description": "Whether or not the job posting is listed"
    },
    "suppressDescriptionOpening": {
      "type": "boolean",
      "description": "Whether the job description opening from the brand is suppressed"
    },
    "suppressDescriptionClosing": {
      "type": "boolean",
      "description": "Whether the job description closing from the brand is suppressed"
    },
    "externalLink": {
      "type": "string",
      "format": "uri"
    },
    "applyLink": {
      "type": "string",
      "description": "The link to apply to the job posting",
      "format": "uri"
    },
    "compensation": {
      "type": "object",
      "properties": {
        "compensationTierSummary": {
          "type": "string"
        },
        "summaryComponents": {
          "type": "array",
          "description": "The summary compensation components for the job posting",
          "items": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string",
                "description": "A human-readable summary of the compensation component"
              },
              "label": {
                "type": "string"
              },
              "compensationType": {
                "type": "string",
                "description": "The type of compensation"
              },
              "interval": {
                "type": "string",
                "description": "The compensation interval"
              },
              "currencyCode": {
                "type": "string"
              },
              "minValue": {
                "type": "number"
              },
              "maxValue": {
                "type": "number"
              }
            },
            "required": [
              "summary",
              "compensationType",
              "interval",
              "currencyCode",
              "minValue",
              "maxValue"
            ]
          }
        },
        "compensationTiers": {
          "type": "array",
          "description": "The compensation ranges that can be offered to applicants for this posting",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The unique identifier for the compensation tier"
              },
              "tierSummary": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "additionalInformation": {
                "type": "string"
              },
              "components": {
                "type": "array",
                "description": "The compensation components in this tier",
                "items": {
                  "type": "object",
                  "properties": {
                    "summary": {
                      "type": "string",
                      "description": "A human-readable summary of the compensation component"
                    },
                    "label": {
                      "type": "string"
                    },
                    "compensationType": {
                      "type": "string",
                      "description": "The type of compensation"
                    },
                    "interval": {
                      "type": "string",
                      "description": "The compensation interval"
                    },
                    "currencyCode": {
                      "type": "string"
                    },
                    "minValue": {
                      "type": "number"
                    },
                    "maxValue": {
                      "type": "number"
                    },
                    "id": {
                      "type": "string",
                      "description": "The component id"
                    }
                  },
                  "required": [
                    "summary",
                    "compensationType",
                    "interval",
                    "currencyCode",
                    "minValue",
                    "maxValue",
                    "id"
                  ]
                }
              }
            },
            "required": [
              "id",
              "tierSummary",
              "title",
              "additionalInformation",
              "components"
            ]
          }
        },
        "shouldDisplayCompensation": {
          "type": "boolean",
          "description": "Whether compensation should be shown to applicants for this job posting"
        }
      },
      "required": [
        "compensationTierSummary",
        "summaryComponents",
        "compensationTiers",
        "shouldDisplayCompensation"
      ]
    },
    "updatedAt": {
      "type": "string",
      "description": "The date and time when the job posting was last updated",
      "format": "date-time"
    },
    "applicationLimitCalloutHtml": {
      "type": "string"
    },
    "applicationConfirmationEmailTemplateId": {
      "type": "string"
    },
    "job": {
      "type": "object",
      "properties": {}
    }
  },
  "x-primary-key": [
    "id"
  ]
}
