{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "address": {
      "properties": {
        "postalAddress": {
          "description": "The postal address of the job posting",
          "properties": {
            "addressCountry": {
              "type": "string"
            },
            "addressLocality": {
              "type": "string"
            },
            "addressRegion": {
              "type": "string"
            },
            "postalCode": {
              "type": "string"
            },
            "streetAddress": {
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "applicationConfirmationEmailTemplateId": {
      "type": "string"
    },
    "applicationDeadline": {
      "format": "date-time",
      "type": "string"
    },
    "applicationFormDefinition": {
      "properties": {
        "sections": {
          "description": "The sections in the form definition",
          "items": {
            "properties": {
              "descriptionHtml": {
                "type": "string"
              },
              "descriptionPlain": {
                "type": "string"
              },
              "fields": {
                "description": "The fields in this form section",
                "items": {
                  "properties": {
                    "descriptionHtml": {
                      "type": "string"
                    },
                    "descriptionPlain": {
                      "type": "string"
                    },
                    "field": {
                      "properties": {
                        "humanReadablePath": {
                          "description": "The human-readable path for the form field",
                          "type": "string"
                        },
                        "id": {
                          "description": "The unique identifier for the form definition field",
                          "type": "string"
                        },
                        "isNullable": {
                          "description": "Whether the form field accepts null values",
                          "type": "boolean"
                        },
                        "path": {
                          "description": "The path used to submit values for this field",
                          "type": "string"
                        },
                        "selectableValues": {
                          "items": {
                            "properties": {
                              "label": {
                                "description": "The display label for the selectable value",
                                "type": "string"
                              },
                              "value": {
                                "description": "The submitted value for the selectable option",
                                "type": "string"
                              }
                            },
                            "required": [
                              "label",
                              "value"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "title": {
                          "description": "The display title for the form field",
                          "type": "string"
                        },
                        "type": {
                          "description": "The type of the form definition field",
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "type",
                        "path",
                        "humanReadablePath",
                        "title",
                        "isNullable"
                      ],
                      "type": "object"
                    },
                    "isRequired": {
                      "description": "Whether this form field is required",
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "isRequired",
                    "field"
                  ],
                  "type": "object"
