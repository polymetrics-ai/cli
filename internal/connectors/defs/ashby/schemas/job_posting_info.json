    "teamName": {
      "description": "The name of the team associated with the job posting",
      "type": "string"
    },
    "teamNameHierarchy": {
      "description": "The hierarchy of team names associated with the job posting",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "description": "The job posting's title",
      "type": "string"
    },
    "updatedAt": {
      "description": "The date and time when the job posting was last updated",
      "format": "date-time",
      "type": "string"
    },
    "workplaceType": {
      "enum": [
        "OnSite",
        "Hybrid",
        "Remote"
      ],
      "type": "string"
    }
