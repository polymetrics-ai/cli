          "required": [
            "html",
            "plain"
          ],
          "type": "object"
        },
        "descriptionClosing": {
          "properties": {
            "html": {
              "type": "string"
            },
            "plain": {
              "type": "string"
            }
          },
          "required": [
            "html",
            "plain"
          ],
          "type": "object"
        },
        "descriptionOpening": {
          "properties": {
            "html": {
              "type": "string"
            },
            "plain": {
              "type": "string"
            }
          },
          "required": [
            "html",
            "plain"
          ],
          "type": "object"
        }
      },
      "required": [
        "descriptionOpening",
        "descriptionBody",
        "descriptionClosing"
      ],
      "type": "object"
