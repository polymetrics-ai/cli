      "description": "The name of the primary location associated with the job posting",
      "type": "string"
    },
    "publishedDate": {
      "format": "date",
      "type": "string"
    },
    "status": {
      "enum": [
        "Draft",
        "Published"
      ],
      "type": "string"
    },
    "suppressDescriptionClosing": {
      "description": "Whether the job description closing from the brand is suppressed",
      "type": "boolean"
    },
    "suppressDescriptionOpening": {
      "description": "Whether the job description opening from the brand is suppressed",
      "type": "boolean"
    },
