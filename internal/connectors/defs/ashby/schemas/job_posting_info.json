        "properties": {
          "formDefinition": {
            "properties": {
              "sections": {
                "description": "The sections in the form definition",
                "items": {
                  "properties": {
                    "descriptionHtml": {
                      "type": "string"
                    },
                    "descriptionPlain": {
                      "type": "string"
