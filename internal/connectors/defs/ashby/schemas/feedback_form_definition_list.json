{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "formDefinition": {
      "properties": {
        "sections": {
          "description": "The sections in the form definition",
          "items": {
            "properties": {
              "descriptionHtml": {
                "type": "string"
              },
              "descriptionPlain": {
                "type": "string"
              },
              "fields": {
                "description": "The fields in this form section",
                "items": {
                  "properties": {
                    "descriptionHtml": {
                      "type": "string"
                    },
                    "descriptionPlain": {
                      "type": "string"
                    },
                    "field": {
                      "properties": {
                        "humanReadablePath": {
                          "description": "The human-readable path for the form field",
                          "type": "string"
                        },
                        "id": {
                          "description": "The unique identifier for the form definition field",
                          "type": "string"
                        },
                        "isNullable": {
                          "description": "Whether the form field accepts null values",
                          "type": "boolean"
                        },
                        "path": {
                          "description": "The path used to submit values for this field",
                          "type": "string"
                        },
                        "selectableValues": {
                          "items": {
                            "properties": {
                              "label": {
                                "description": "The display label for the selectable value",
                                "type": "string"
                              },
                              "value": {
                                "description": "The submitted value for the selectable option",
                                "type": "string"
                              }
                            },
                            "required": [
                              "label",
                              "value"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "title": {
                          "description": "The display title for the form field",
                          "type": "string"
                        },
                        "type": {
                          "description": "The type of the form definition field",
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "type",
                        "path",
                        "humanReadablePath",
                        "title",
                        "isNullable"
                      ],
                      "type": "object"
                    },
                    "isRequired": {
                      "description": "Whether this form field is required",
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "isRequired",
                    "field"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "fields"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "sections"
      ],
      "type": "object"
    },
    "id": {
      "description": "The unique identifier for the feedback form definition",
      "type": "string"
    },
    "interviewId": {
      "type": "string"
    },
    "isArchived": {
      "description": "Whether the feedback form definition is archived",
      "type": "boolean"
    },
    "isDefaultForm": {
      "description": "Whether this is the organization's default feedback form definition",
      "type": "boolean"
    },
    "organizationId": {
      "description": "The unique identifier for the organization",
      "type": "string"
    },
    "title": {
      "description": "The title of the feedback form definition",
      "type": "string"
    }
  },
  "title": "feedback_form_definition_list",
  "type": "object",
  "x-primary-key": [
    "id"
  ]
}
