{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "report_synchronous",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "description": "Unique identifier for this report generation request"
    },
    "status": {
      "type": "string",
      "description": "Current status of the report generation",
      "enum": [
        "requested",
        "in_progress",
        "complete",
        "failed"
      ]
    },
    "reportData": {
      "type": "object"
    },
    "failureReason": {
      "type": "string"
    }
  },
  "x-primary-key": [
    "requestId"
  ]
}
