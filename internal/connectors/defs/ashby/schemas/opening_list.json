{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "archivedAt": {
      "format": "date-time",
      "type": "string"
    },
    "closeReasonId": {
      "type": "string"
    },
    "closedAt": {
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "description": "The unique identifier for the opening",
      "type": "string"
    },
    "isArchived": {
      "description": "Whether the opening is archived",
      "type": "boolean"
    },
    "latestVersion": {
      "properties": {
        "authorId": {
          "type": "string"
        },
        "createdAt": {
          "description": "The timestamp when the opening version was created",
          "format": "date-time",
          "type": "string"
        },
        "customFields": {
          "description": "Custom fields associated with the opening",
          "items": {
            "properties": {
              "id": {
                "description": "The unique identifier for the custom field definition",
                "type": "string"
              },
              "isPrivate": {
                "description": "Whether the custom field is private and requires additional permissions",
                "type": "boolean"
              },
              "title": {
                "description": "The title of the custom field",
                "type": "string"
              },
              "value": {
                "properties": {
                  "currencyCode": {
                    "description": "The ISO currency code",
                    "type": "string"
                  },
                  "value": {
                    "description": "The currency amount",
                    "type": "number"
                  }
                },
                "required": [
                  "value",
                  "currencyCode"
                ],
                "type": "object"
              },
              "valueLabel": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "employmentType": {
          "description": "The employment type for the opening",
          "enum": [
            "FullTime",
            "PartTime",
            "Intern",
            "Contract",
            "Temporary"
          ],
          "type": "string"
        },
        "hiringTeam": {
          "description": "The hiring team roles assigned to the opening",
          "items": {
            "properties": {
              "email": {
                "description": "The user's email address",
                "format": "email",
                "type": "string"
              },
              "firstName": {
                "description": "The user's first name",
                "type": "string"
              },
              "lastName": {
                "description": "The user's last name",
                "type": "string"
              },
              "role": {
                "description": "The user's role on the opening hiring team",
                "type": "string"
              },
              "userId": {
                "description": "The unique identifier for the user",
                "type": "string"
              }
            },
            "required": [
              "userId",
              "firstName",
              "lastName",
              "email",
              "role"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "id": {
          "description": "The unique identifier for the opening version",
          "type": "string"
        },
        "identifier": {
          "description": "The human-readable opening identifier",
          "type": "string"
        },
        "isBackfill": {
          "description": "Whether the opening is a backfill",
          "type": "boolean"
        },
        "jobIds": {
          "description": "The unique identifiers for jobs linked to the opening",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "locationIds": {
          "description": "The unique identifiers for locations linked to the opening",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "targetHireDate": {
          "type": "string"
        },
        "targetStartDate": {
          "type": "string"
        },
        "teamId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "identifier",
        "description",
        "authorId",
        "createdAt",
        "targetHireDate",
        "targetStartDate",
        "isBackfill",
        "employmentType",
        "teamId",
        "jobIds",
        "locationIds",
        "hiringTeam",
        "customFields"
      ],
      "type": "object"
    },
    "openedAt": {
      "format": "date-time",
      "type": "string"
    },
    "openingState": {
      "description": "The current state of the opening",
      "enum": [
        "Draft",
        "Approved",
        "Open",
        "Closed",
        "Filled"
      ],
      "type": "string"
    }
  },
  "title": "opening_list",
  "type": "object",
  "x-primary-key": [
    "id"
  ]
}
