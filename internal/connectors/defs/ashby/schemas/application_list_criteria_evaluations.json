{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "criterion": {
      "description": "The criterion that was evaluated.",
      "properties": {
        "applicationFormDefinitionId": {
          "type": "string"
        },
        "applicationFormFieldPath": {
          "type": "string"
        },
        "id": {
          "description": "The id of the criterion version.",
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "title": {
          "description": "The title of the criterion.",
          "type": "string"
        },
        "type": {
          "description": "The type of criterion evaluation.",
          "enum": [
            "ResumePrompt",
            "DidAnswerApplicationFormQuestion",
            "SimilarityToAiGeneratedAnswer"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "type"
      ],
      "type": "object"
    },
    "evaluatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "description": "The id of the criteria evaluation.",
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "outcomeNumber": {
      "type": "number"
    },
    "reasoning": {
      "type": "string"
    },
    "skipReason": {
      "type": "string"
    },
    "status": {
      "description": "The status of the evaluation.",
      "enum": [
        "Pending",
        "Completed",
        "Failed",
        "Skipped"
      ],
      "type": "string"
    }
  },
  "title": "application_list_criteria_evaluations",
  "type": "object",
  "x-primary-key": [
    "id"
  ]
}
