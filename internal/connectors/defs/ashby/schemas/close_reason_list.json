{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "close_reason_list",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The reason's unique id"
    },
    "reasonText": {
      "type": "string",
