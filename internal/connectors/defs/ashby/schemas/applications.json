{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "appliedViaJobPostingId": {
      "type": "string"
    },
    "archiveReason": {
      "description": "Details about the archive reason for this application, if archived",
      "properties": {
        "customFields": {
          "description": "Archive detail custom field values",
          "items": {
            "description": "A custom field value attached to the application",
            "properties": {
              "id": {
                "description": "The unique identifier for the custom field definition",
                "type": "string"
              },
              "isPrivate": {
                "description": "Whether the custom field is private",
                "type": "boolean"
              },
              "title": {
                "description": "The title of the custom field",
                "type": "string"
              },
              "value": {
                "properties": {
                  "currencyCode": {
                    "description": "The ISO currency code",
                    "type": "string"
                  },
                  "value": {
                    "description": "The currency amount",
                    "type": "number"
                  }
                },
                "required": [
                  "value",
                  "currencyCode"
                ],
                "type": "object"
              },
              "valueLabel": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "id": {
          "description": "The unique identifier for the archive reason",
          "type": "string"
        },
        "isArchived": {
          "description": "Whether the archive reason is archived",
          "type": "boolean"
        },
        "reasonType": {
          "description": "The category of archive reason",
          "enum": [
            "RejectedByCandidate",
            "RejectedByOrg",
            "Other"
          ],
          "type": "string"
        },
        "text": {
          "description": "The display text for the archive reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "reasonType",
        "isArchived",
        "customFields"
      ],
      "type": "object"
    },
    "archivedAt": {
      "format": "date-time",
      "type": "string"
    },
    "candidate": {
      "description": "The candidate associated with the application",
      "properties": {
        "id": {
          "description": "The unique identifier for the candidate",
          "type": "string"
        },
        "name": {
          "description": "The candidate's name",
          "type": "string"
        },
        "primaryEmailAddress": {
          "properties": {
            "isPrimary": {
              "description": "Whether the contact info is the primary email or phone number",
              "type": "boolean"
            },
            "type": {
              "description": "The type of the contact info",
              "enum": [
                "Personal",
                "Work",
                "Other"
              ],
              "type": "string"
            },
            "value": {
              "description": "The email address or phone number of the candidate",
              "type": "string"
            }
          },
          "required": [
            "value",
            "type",
            "isPrimary"
          ],
          "type": "object"
        },
        "primaryPhoneNumber": {
          "properties": {
            "isPrimary": {
              "description": "Whether the contact info is the primary email or phone number",
              "type": "boolean"
            },
            "type": {
              "description": "The type of the contact info",
              "enum": [
                "Personal",
                "Work",
                "Other"
              ],
              "type": "string"
            },
            "value": {
              "description": "The email address or phone number of the candidate",
              "type": "string"
            }
          },
          "required": [
            "value",
            "type",
            "isPrimary"
          ],
          "type": "object"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "createdAt": {
      "description": "The timestamp when the application was created",
      "format": "date-time",
      "type": "string"
    },
    "creditedToUser": {
      "properties": {
        "customFields": {
          "description": "Custom fields associated with the user (only included when requested)",
          "items": {
            "properties": {
              "id": {
                "description": "The unique identifier for the custom field definition",
                "type": "string"
              },
              "isPrivate": {
                "description": "Whether the custom field is private",
                "type": "boolean"
              },
              "title": {
                "description": "The title of the custom field",
                "type": "string"
              },
              "value": {
                "properties": {
                  "currencyCode": {
                    "description": "The currency code",
                    "type": "string"
                  },
                  "value": {
                    "description": "The currency amount",
                    "type": "number"
                  }
                },
                "required": [
                  "value",
                  "currencyCode"
                ],
                "type": "object"
              },
              "valueLabel": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "isPrivate",
              "title",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "email": {
          "format": "email",
          "type": "string"
        },
        "firstName": {
          "description": "The user's first name",
          "type": "string"
        },
        "globalRole": {
          "description": "The user's global role in the organization",
          "enum": [
            "Organization Admin",
            "Elevated Access",
            "Limited Access",
            "External Recruiter"
          ],
          "type": "string"
        },
        "id": {
          "description": "The unique identifier for the user",
          "type": "string"
        },
        "isEnabled": {
          "description": "Whether the user is enabled (not deactivated)",
          "type": "boolean"
        },
        "lastName": {
          "description": "The user's last name",
          "type": "string"
        },
        "managerId": {
          "description": "The unique identifier for the user's manager",
          "type": "string"
        },
        "updatedAt": {
          "description": "The timestamp when the user was last updated (ISO 8601 format)",
          "type": "string"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "globalRole",
        "isEnabled",
        "updatedAt"
      ],
      "type": "object"
    },
    "currentInterviewStage": {
      "description": "The current interview stage for the application",
      "properties": {
        "id": {
          "description": "The unique identifier for the interview stage",
          "type": "string"
        },
        "interviewPlanId": {
          "description": "The id of the interview plan the stage belongs to",
          "type": "string"
        },
        "interviewStageGroupId": {
          "type": "string"
        },
        "orderInInterviewPlan": {
          "description": "The stage's order within its interview plan",
          "type": "integer"
        },
        "title": {
          "description": "The interview stage title",
          "type": "string"
        },
        "type": {
          "description": "The interview stage type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "type",
        "orderInInterviewPlan",
        "interviewPlanId"
      ],
      "type": "object"
    },
    "customFields": {
      "items": {
        "description": "A custom field value attached to the application",
        "properties": {
          "id": {
            "description": "The unique identifier for the custom field definition",
            "type": "string"
          },
          "isPrivate": {
            "description": "Whether the custom field is private",
            "type": "boolean"
          },
          "title": {
            "description": "The title of the custom field",
            "type": "string"
          },
          "value": {
            "properties": {
              "currencyCode": {
                "description": "The ISO currency code",
                "type": "string"
              },
              "value": {
                "description": "The currency amount",
                "type": "number"
              }
            },
            "required": [
              "value",
              "currencyCode"
            ],
            "type": "object"
          },
          "valueLabel": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "value"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "hiringTeam": {
      "description": "The hiring team for the application",
      "items": {
        "properties": {
          "email": {
            "description": "The primary email address of the hiring team member",
            "format": "email",
            "type": "string"
          },
          "firstName": {
            "description": "The first name of the hiring team member",
            "type": "string"
          },
          "lastName": {
            "description": "The last name of the hiring team member",
            "type": "string"
          },
          "role": {
            "description": "The hiring team role assigned to the member",
            "type": "string"
          },
          "userId": {
            "description": "The unique identifier of the hiring team member",
            "type": "string"
          }
        },
        "required": [
          "userId",
          "firstName",
          "lastName",
          "email",
          "role"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "id": {
      "description": "The unique identifier for the application",
      "type": "string"
    },
    "job": {
      "description": "The job the application is for",
      "properties": {
        "departmentId": {
          "type": "string"
        },
        "id": {
          "description": "The unique identifier for the job",
          "type": "string"
        },
        "locationId": {
          "type": "string"
        },
        "title": {
          "description": "The job title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "type": "object"
    },
    "openings": {
      "items": {
        "description": "An opening linked to the application via `expand: ['openings']`",
        "properties": {
          "archivedAt": {
            "format": "date-time",
            "type": "string"
          },
          "closeReasonId": {
            "type": "string"
          },
          "closedAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "The unique identifier for the opening",
            "type": "string"
          },
          "isArchived": {
            "description": "Whether the opening is archived",
            "type": "boolean"
          },
          "latestVersion": {
            "description": "The latest version of the opening",
            "properties": {
              "authorId": {
                "type": "string"
              },
              "createdAt": {
                "description": "The timestamp when the opening version was created",
                "format": "date-time",
                "type": "string"
              },
              "customFields": {
                "description": "Custom fields attached to the opening",
                "items": {
                  "description": "A custom field value attached to the application",
                  "properties": {
                    "id": {
                      "description": "The unique identifier for the custom field definition",
                      "type": "string"
                    },
                    "isPrivate": {
                      "description": "Whether the custom field is private",
                      "type": "boolean"
                    },
                    "title": {
                      "description": "The title of the custom field",
                      "type": "string"
                    },
                    "value": {
                      "properties": {
                        "currencyCode": {
                          "description": "The ISO currency code",
                          "type": "string"
                        },
                        "value": {
                          "description": "The currency amount",
                          "type": "number"
                        }
                      },
                      "required": [
                        "value",
                        "currencyCode"
                      ],
                      "type": "object"
                    },
                    "valueLabel": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "value"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "description": {
                "type": "string"
              },
              "employmentType": {
                "description": "The employment type",
                "type": "string"
              },
              "hiringTeam": {
                "description": "Hiring team for the opening",
                "items": {
                  "properties": {
                    "email": {
                      "description": "The email",
                      "format": "email",
                      "type": "string"
                    },
                    "firstName": {
                      "description": "The first name",
                      "type": "string"
                    },
                    "lastName": {
                      "description": "The last name",
                      "type": "string"
                    },
                    "role": {
                      "description": "The role",
                      "type": "string"
                    },
                    "userId": {
                      "description": "The user id",
                      "type": "string"
                    }
                  },
                  "required": [
                    "userId",
                    "firstName",
                    "lastName",
                    "email",
                    "role"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "id": {
                "description": "The unique identifier for the opening version",
                "type": "string"
              },
              "identifier": {
                "description": "The human-readable opening identifier",
                "type": "string"
              },
              "isBackfill": {
                "description": "Whether the opening is a backfill",
                "type": "boolean"
              },
              "jobIds": {
                "description": "The unique identifiers for jobs linked to the opening",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "locationIds": {
                "description": "The location ids",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "targetHireDate": {
                "type": "string"
              },
              "targetStartDate": {
                "type": "string"
              },
              "teamId": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "identifier",
              "description",
              "authorId",
              "createdAt",
              "jobIds",
              "isBackfill",
              "employmentType",
              "locationIds",
              "hiringTeam",
              "customFields"
            ],
            "type": "object"
          },
          "openedAt": {
            "format": "date-time",
            "type": "string"
          },
          "openingState": {
            "description": "The current state of the opening",
            "enum": [
              "Approved",
              "Closed",
              "Draft",
              "Filled",
              "Open"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "isArchived",
          "openingState"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "source": {
      "description": "The source attributed to this application, if any",
      "properties": {
        "id": {
          "description": "The source's unique identifier",
          "type": "string"
        },
        "isArchived": {
          "description": "Whether the source has been archived",
          "type": "boolean"
        },
        "sourceType": {
          "description": "The source type associated with this source",
          "properties": {
            "id": {
              "description": "The source type's unique identifier",
              "type": "string"
            },
            "isArchived": {
              "description": "Whether the source type has been archived",
              "type": "boolean"
            },
            "title": {
              "description": "The title of the source type",
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "isArchived"
          ],
          "type": "object"
        },
        "title": {
          "description": "The title of the source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "isArchived",
        "sourceType"
      ],
      "type": "object"
    },
    "status": {
      "description": "The status of the application",
      "enum": [
        "Hired",
        "Archived",
        "Active",
        "Lead"
      ],
      "type": "string"
    },
    "submitterClientIp": {
      "type": "string"
    },
    "submitterUserAgent": {
      "type": "string"
    },
    "updatedAt": {
      "description": "The timestamp when the application was last updated",
      "format": "date-time",
      "type": "string"
    }
  },
  "title": "applications",
  "type": "object",
  "x-primary-key": [
    "id"
  ]
}
