{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "applicationHistoryId": {
      "type": "string"
    },
    "applicationId": {
      "description": "The id of the application this feedback was submitted for",
      "type": "string"
    },
    "creditedToUser": {
      "properties": {
        "customFields": {
          "description": "Custom fields associated with the user (only included when requested)",
          "items": {
            "properties": {
              "id": {
                "description": "The unique identifier for the custom field definition",
                "type": "string"
              },
              "isPrivate": {
                "description": "Whether the custom field is private",
                "type": "boolean"
              },
              "title": {
                "description": "The title of the custom field",
                "type": "string"
              },
              "value": {
                "properties": {
                  "currencyCode": {
                    "description": "The currency code",
                    "type": "string"
                  },
                  "value": {
                    "description": "The currency amount",
                    "type": "number"
                  }
                },
                "required": [
                  "value",
                  "currencyCode"
                ],
                "type": "object"
              },
              "valueLabel": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "isPrivate",
              "title",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "email": {
          "format": "email",
          "type": "string"
        },
        "firstName": {
          "description": "The user's first name",
          "type": "string"
        },
        "globalRole": {
          "description": "The user's global role in the organization",
          "enum": [
            "Organization Admin",
            "Elevated Access",
            "Limited Access",
            "External Recruiter"
          ],
          "type": "string"
        },
        "id": {
          "description": "The unique identifier for the user",
          "type": "string"
        },
        "isEnabled": {
          "description": "Whether the user is enabled (not deactivated)",
          "type": "boolean"
        },
        "lastName": {
          "description": "The user's last name",
          "type": "string"
        },
        "managerId": {
          "description": "The unique identifier for the user's manager",
          "type": "string"
        },
        "updatedAt": {
          "description": "The timestamp when the user was last updated (ISO 8601 format)",
          "type": "string"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "globalRole",
        "isEnabled",
        "updatedAt"
      ],
      "type": "object"
    },
    "feedbackFormDefinitionId": {
      "type": "string"
    },
    "formDefinition": {
      "properties": {
        "sections": {
          "description": "The sections in the form definition",
          "items": {
            "properties": {
              "descriptionHtml": {
                "type": "string"
              },
              "descriptionPlain": {
                "type": "string"
              },
              "fields": {
                "description": "The fields in this form section",
                "items": {
                  "properties": {
                    "descriptionHtml": {
                      "type": "string"
                    },
                    "descriptionPlain": {
                      "type": "string"
                    },
                    "field": {
                      "properties": {
                        "humanReadablePath": {
                          "description": "The human-readable path for the form field",
                          "type": "string"
                        },
                        "id": {
                          "description": "The unique identifier for the form definition field",
                          "type": "string"
                        },
                        "isNullable": {
                          "description": "Whether the form field accepts null values",
                          "type": "boolean"
                        },
                        "path": {
                          "description": "The path used to submit values for this field",
                          "type": "string"
                        },
                        "selectableValues": {
                          "items": {
                            "properties": {
                              "label": {
                                "description": "The display label for the selectable value",
                                "type": "string"
                              },
                              "value": {
                                "description": "The submitted value for the selectable option",
                                "type": "string"
                              }
                            },
                            "required": [
                              "label",
                              "value"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "title": {
                          "description": "The display title for the form field",
                          "type": "string"
                        },
                        "type": {
                          "description": "The type of the form definition field",
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "type",
                        "path",
                        "humanReadablePath",
                        "title",
                        "isNullable"
                      ],
                      "type": "object"
                    },
                    "isRequired": {
                      "description": "Whether this form field is required",
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "isRequired",
                    "field"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "fields"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "sections"
      ],
      "type": "object"
    },
    "id": {
      "description": "The unique identifier for the application feedback",
      "type": "string"
    },
    "interviewEventId": {
      "type": "string"
    },
    "interviewId": {
      "type": "string"
    },
    "submittedAt": {
      "description": "The time when this feedback was submitted",
      "format": "date-time",
      "type": "string"
    },
    "submittedByUser": {
      "properties": {
        "customFields": {
          "description": "Custom fields associated with the user (only included when requested)",
          "items": {
            "properties": {
              "id": {
                "description": "The unique identifier for the custom field definition",
                "type": "string"
              },
              "isPrivate": {
                "description": "Whether the custom field is private",
                "type": "boolean"
              },
              "title": {
                "description": "The title of the custom field",
                "type": "string"
              },
              "value": {
                "properties": {
                  "currencyCode": {
                    "description": "The currency code",
                    "type": "string"
                  },
                  "value": {
                    "description": "The currency amount",
                    "type": "number"
                  }
                },
                "required": [
                  "value",
                  "currencyCode"
                ],
                "type": "object"
              },
              "valueLabel": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "isPrivate",
              "title",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "email": {
          "format": "email",
          "type": "string"
        },
        "firstName": {
          "description": "The user's first name",
          "type": "string"
        },
        "globalRole": {
          "description": "The user's global role in the organization",
          "enum": [
            "Organization Admin",
            "Elevated Access",
            "Limited Access",
            "External Recruiter"
          ],
          "type": "string"
        },
        "id": {
          "description": "The unique identifier for the user",
          "type": "string"
        },
        "isEnabled": {
          "description": "Whether the user is enabled (not deactivated)",
          "type": "boolean"
        },
        "lastName": {
          "description": "The user's last name",
          "type": "string"
        },
        "managerId": {
          "description": "The unique identifier for the user's manager",
          "type": "string"
        },
        "updatedAt": {
          "description": "The timestamp when the user was last updated (ISO 8601 format)",
          "type": "string"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "globalRole",
        "isEnabled",
        "updatedAt"
      ],
      "type": "object"
    },
    "submittedValues": {
      "description": "Submitted values keyed by the corresponding form field path",
      "type": "object"
    }
  },
  "title": "application_feedback_list",
  "type": "object",
  "x-primary-key": [
    "id"
  ]
}
