{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "location_info",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The unique identifier for the location"
    },
    "name": {
      "type": "string",
      "description": "The name of the location"
    },
    "externalName": {
      "type": "string"
    },
    "isArchived": {
      "type": "boolean",
      "description": "Whether the location is archived"
    },
    "isRemote": {
      "type": "boolean"
    },
    "address": {
      "type": "object",
      "description": "The address for the location",
      "properties": {
        "postalAddress": {
          "type": "object",
          "description": "The postal address for the location",
          "properties": {
            "addressCountry": {
              "type": "string",
              "description": "The country for the location address"
            },
            "addressRegion": {
              "type": "string",
              "description": "The region for the location address"
            },
            "addressLocality": {
              "type": "string",
              "description": "The locality for the location address"
            },
            "postalCode": {
              "type": "string",
              "description": "The postal code for the location address"
            },
            "streetAddress": {
              "type": "string",
              "description": "The street address for the location"
            }
          }
        }
      },
      "required": [
        "postalAddress"
      ]
    },
    "parentLocationId": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "The type of the location component",
      "enum": [
        "Location",
        "LocationHierarchy"
      ]
    },
    "workplaceType": {
      "type": "string",
      "enum": [
        "OnSite",
        "Hybrid",
        "Remote"
      ]
    },
    "extraData": {
      "type": "object"
    }
  },
  "x-primary-key": [
    "id"
  ]
}
