{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "id": {
      "description": "The unique identifier for the sequence template",
      "type": "string"
    },
    "isArchived": {
      "description": "Whether the sequence template is archived",
      "type": "boolean"
    },
    "stages": {
      "description": "The template's stages in sequence order",
      "items": {
        "properties": {
          "id": {
            "description": "The unique identifier for the sequence template stage",
            "type": "string"
          },
          "sendAfter": {
            "properties": {
              "kind": {
                "enum": [
                  "NoDelay"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "type": {
            "enum": [
              "Email",
              "InMail",
              "LinkedInConnection"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "sendAfter"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "title": {
      "description": "The sequence template's title",
      "type": "string"
    },
    "unsubscribeLinkActive": {
      "description": "Whether emails sent from the sequence include an unsubscribe link",
      "type": "boolean"
    },
    "updatedAt": {
      "description": "When the returned template metadata last changed",
      "format": "date-time",
      "type": "string"
    }
  },
  "title": "sequence_template_list",
  "type": "object",
  "x-primary-key": [
    "id"
  ]
}
