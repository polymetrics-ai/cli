{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "archive_reason_list",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The unique identifier for the archive reason"
    },
    "text": {
      "type": "string",
      "description": "The display text for the archive reason"
    },
    "reasonType": {
      "type": "string",
      "description": "The category of archive reason",
      "enum": [
        "RejectedByCandidate",
        "RejectedByOrg",
        "Other"
      ]
    },
    "isArchived": {
      "type": "boolean",
      "description": "Whether the archive reason is archived"
    }
  },
  "x-primary-key": [
    "id"
  ]
}
