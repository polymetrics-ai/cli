{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "jobs",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The job's unique identifier"
    },
    "title": {
      "type": "string",
      "description": "The title of the job"
    },
    "confidential": {
      "type": "boolean",
      "description": "Whether the job is confidential"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Open",
        "Closed",
        "Archived"
      ]
    },
    "employmentType": {
      "type": "string",
      "description": "The employment type for the job",
      "enum": [
        "FullTime",
        "PartTime",
        "Intern",
        "Contract",
        "Temporary"
      ]
    },
    "locationId": {
      "type": "string",
      "description": "The id of the location associated with the job"
    },
    "departmentId": {
      "type": "string",
      "description": "The id of the department or team associated with the job"
    },
    "defaultInterviewPlanId": {
      "type": "string",
      "description": "The id of the default interview plan for this job. A job cannot be opened without a default interview plan."
    },
    "interviewPlanIds": {
      "type": "array",
      "description": "The ids of all interview plans associated with the job",
      "items": {
        "type": "string"
      }
    },
    "jobPostingIds": {
      "type": "array",
      "description": "The ids of all job postings associated with the job",
      "items": {
        "type": "string"
      }
    },
    "customRequisitionId": {
      "type": "string"
    },
    "brandId": {
      "type": "string",
      "description": "The id of the brand to use for this job"
    },
    "hiringTeam": {
      "type": "array",
      "description": "The hiring team for the job",
      "items": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "The unique identifier for the user"
          },
          "firstName": {
            "type": "string",
            "description": "The user's first name"
          },
          "lastName": {
            "type": "string",
            "description": "The user's last name"
          },
          "email": {
            "type": "string",
            "description": "The user's email address",
            "format": "email"
          },
          "role": {
            "type": "string",
            "description": "The user's role on the job's hiring team"
          }
        },
        "required": [
          "userId",
          "firstName",
          "lastName",
          "email",
          "role"
        ]
      }
    },
    "openings": {
      "type": "array",
      "description": "The openings linked to this job. Only included when the `openings` expand parameter is provided.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier for the opening"
          },
          "openedAt": {
            "type": "string",
            "format": "date-time"
          },
          "closedAt": {
            "type": "string",
            "format": "date-time"
          },
          "isArchived": {
            "type": "boolean",
            "description": "Whether the opening is archived"
          },
          "closeReasonId": {
            "type": "string"
          },
          "archivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "openingState": {
            "type": "string",
            "description": "The current state of the opening",
            "enum": [
              "Draft",
              "Approved",
              "Open",
              "Closed",
              "Filled"
            ]
          },
          "latestVersion": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The unique identifier for the opening version"
              },
              "identifier": {
                "type": "string",
                "description": "The human-readable opening identifier"
              },
              "description": {
                "type": "string"
              },
              "authorId": {
                "type": "string"
              },
              "createdAt": {
                "type": "string",
                "description": "The timestamp when the opening version was created",
                "format": "date-time"
              },
              "targetHireDate": {
                "type": "string"
              },
              "targetStartDate": {
                "type": "string"
              },
              "isBackfill": {
                "type": "boolean",
                "description": "Whether the opening is a backfill"
              },
              "employmentType": {
                "type": "string",
                "description": "The employment type for the opening",
                "enum": [
                  "FullTime",
                  "PartTime",
                  "Intern",
                  "Contract",
                  "Temporary"
                ]
              },
              "teamId": {
                "type": "string"
              },
              "jobIds": {
                "type": "array",
                "description": "The unique identifiers for jobs linked to the opening",
                "items": {
                  "type": "string"
                }
              },
              "locationIds": {
                "type": "array",
                "description": "The unique identifiers for locations linked to the opening",
                "items": {
                  "type": "string"
                }
              },
              "hiringTeam": {
                "type": "array",
                "description": "The hiring team roles assigned to the opening",
                "items": {
                  "type": "object",
                  "properties": {
                    "userId": {
                      "type": "string",
                      "description": "The unique identifier for the user"
                    },
                    "firstName": {
                      "type": "string",
                      "description": "The user's first name"
                    },
                    "lastName": {
                      "type": "string",
                      "description": "The user's last name"
                    },
                    "email": {
                      "type": "string",
                      "description": "The user's email address",
                      "format": "email"
                    },
                    "role": {
                      "type": "string",
                      "description": "The user's role on the opening hiring team"
                    }
                  },
                  "required": [
                    "userId",
                    "firstName",
                    "lastName",
                    "email",
                    "role"
                  ]
                }
              },
              "customFields": {
                "type": "array",
                "description": "Custom fields associated with the opening",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The unique identifier for the custom field definition"
                    },
                    "isPrivate": {
                      "type": "boolean",
                      "description": "Whether the custom field is private and requires additional permissions"
                    },
                    "title": {
                      "type": "string",
                      "description": "The title of the custom field"
                    },
                    "valueLabel": {
                      "type": "string"
                    },
                    "value": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number",
                          "description": "The currency amount"
                        },
                        "currencyCode": {
                          "type": "string",
                          "description": "The ISO currency code"
                        }
                      },
                      "required": [
                        "value",
                        "currencyCode"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "value"
                  ]
                }
              }
            },
            "required": [
              "id",
              "identifier",
              "description",
              "authorId",
              "createdAt",
              "targetHireDate",
              "targetStartDate",
              "isBackfill",
              "employmentType",
              "teamId",
              "jobIds",
              "locationIds",
              "hiringTeam",
              "customFields"
            ]
          }
        },
        "required": [
          "id",
          "openedAt",
          "closedAt",
          "isArchived",
          "closeReasonId",
          "archivedAt",
          "openingState",
          "latestVersion"
        ]
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier for the location"
        },
        "name": {
          "type": "string",
          "description": "The name of the location"
        },
        "externalName": {
          "type": "string"
        },
        "isArchived": {
          "type": "boolean",
          "description": "Whether the location is archived"
        },
        "isRemote": {
          "type": "boolean"
        },
        "address": {
          "type": "object",
          "description": "The address for the location",
          "properties": {
            "postalAddress": {
              "type": "object",
              "description": "The postal address for the location",
              "properties": {
                "addressCountry": {
                  "type": "string",
                  "description": "The country for the location address"
                },
                "addressRegion": {
                  "type": "string",
                  "description": "The region for the location address"
                },
                "addressLocality": {
                  "type": "string",
                  "description": "The locality for the location address"
                },
                "postalCode": {
                  "type": "string",
                  "description": "The postal code for the location address"
                },
                "streetAddress": {
                  "type": "string",
                  "description": "The street address for the location"
                }
              }
            }
          },
          "required": [
            "postalAddress"
          ]
        },
        "parentLocationId": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "The type of the location component",
          "enum": [
            "Location",
            "LocationHierarchy"
          ]
        },
        "workplaceType": {
          "type": "string",
          "enum": [
            "OnSite",
            "Hybrid",
            "Remote"
          ]
        },
        "extraData": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "externalName",
        "isArchived",
        "isRemote",
        "address",
        "parentLocationId",
        "type",
        "workplaceType",
        "extraData"
      ]
    },
    "compensation": {
      "type": "object",
      "properties": {
        "compensationTiers": {
          "type": "array",
          "description": "The compensation ranges that can be offered to applicants for this job",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The compensation tier's unique id"
              },
              "title": {
                "type": "string"
              },
              "additionalInformation": {
                "type": "string"
              },
              "components": {
                "type": "array",
                "description": "The individual components that make up this compensation range",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The component's unique id"
                    },
                    "summary": {
                      "type": "string",
                      "description": "The summary of this component as shown on Ashby-hosted job boards"
                    },
                    "compensationType": {
                      "type": "string",
                      "description": "The type of compensation this component represents",
                      "enum": [
                        "Salary",
                        "EquityPercentage",
                        "EquityCashValue",
                        "Bonus",
                        "Commission"
                      ]
                    },
                    "interval": {
                      "type": "string",
                      "description": "The frequency at which this compensation is given",
                      "enum": [
                        "NONE",
                        "1 TIME",
                        "1 HOUR",
                        "1 DAY",
                        "1 WEEK",
                        "2 WEEK",
                        "1 MONTH",
                        "2 MONTH",
                        "1 YEAR",
                        "6 MONTH",
                        "0.5 MONTH",
                        "3 MONTH"
                      ]
                    },
                    "label": {
                      "type": "string"
                    },
                    "currencyCode": {
                      "type": "string"
                    },
                    "minValue": {
                      "type": "number"
                    },
                    "maxValue": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "id",
                    "summary",
                    "compensationType",
                    "interval"
                  ]
                }
              },
              "tierSummary": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "additionalInformation",
              "components",
              "tierSummary"
            ]
          }
        }
      },
      "required": [
        "compensationTiers"
      ]
    },
    "customFields": {
      "type": "array",
      "description": "Custom field values associated with the job",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier for the custom field definition"
          },
          "isPrivate": {
            "type": "boolean",
            "description": "Whether the custom field is private"
          },
          "title": {
            "type": "string",
            "description": "The title of the custom field"
          },
          "value": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "description": "The currency amount"
              },
              "currencyCode": {
                "type": "string",
                "description": "The currency code"
              }
            },
            "required": [
              "value",
              "currencyCode"
            ]
          },
          "valueLabel": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "isPrivate",
          "title",
          "value"
        ]
      }
    },
    "author": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier for the user"
        },
        "firstName": {
          "type": "string",
          "description": "The user's first name"
        },
        "lastName": {
          "type": "string",
          "description": "The user's last name"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "globalRole": {
          "type": "string",
          "description": "The user's global role in the organization",
          "enum": [
            "Organization Admin",
            "Elevated Access",
            "Limited Access",
            "External Recruiter"
          ]
        },
        "isEnabled": {
          "type": "boolean",
          "description": "Whether the user is enabled (not deactivated)"
        },
        "updatedAt": {
          "type": "string",
          "description": "The timestamp when the user was last updated (ISO 8601 format)"
        },
        "managerId": {
          "type": "string",
          "description": "The unique identifier for the user's manager"
        },
        "customFields": {
          "type": "array",
          "description": "Custom fields associated with the user (only included when requested)",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The unique identifier for the custom field definition"
              },
              "isPrivate": {
                "type": "boolean",
                "description": "Whether the custom field is private"
              },
              "title": {
                "type": "string",
                "description": "The title of the custom field"
              },
              "value": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "description": "The currency amount"
                  },
                  "currencyCode": {
                    "type": "string",
                    "description": "The currency code"
                  }
                },
                "required": [
                  "value",
                  "currencyCode"
                ]
              },
              "valueLabel": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "isPrivate",
              "title",
              "value"
            ]
          }
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "globalRole",
        "isEnabled",
        "updatedAt"
      ]
    },
    "createdAt": {
      "type": "string",
      "description": "The timestamp when the job was created"
    },
    "updatedAt": {
      "type": "string",
      "description": "The timestamp when the job was last updated"
    },
    "openedAt": {
      "type": "string"
    },
    "closedAt": {
      "type": "string"
    }
  },
  "x-primary-key": [
    "id"
  ]
}
