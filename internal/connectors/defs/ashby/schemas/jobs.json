{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "author": {
      "properties": {
        "customFields": {
          "description": "Custom fields associated with the user (only included when requested)",
          "items": {
            "properties": {
              "id": {
                "description": "The unique identifier for the custom field definition",
                "type": "string"
              },
              "isPrivate": {
                "description": "Whether the custom field is private",
                "type": "boolean"
              },
              "title": {
                "description": "The title of the custom field",
                "type": "string"
              },
              "value": {
                "properties": {
                  "currencyCode": {
                    "description": "The currency code",
                    "type": "string"
                  },
                  "value": {
                    "description": "The currency amount",
                    "type": "number"
                  }
                },
                "required": [
                  "value",
                  "currencyCode"
                ],
                "type": "object"
              },
              "valueLabel": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "isPrivate",
              "title",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "email": {
          "format": "email",
          "type": "string"
        },
        "firstName": {
          "description": "The user's first name",
          "type": "string"
        },
        "globalRole": {
          "description": "The user's global role in the organization",
          "enum": [
            "Organization Admin",
            "Elevated Access",
            "Limited Access",
            "External Recruiter"
          ],
          "type": "string"
        },
        "id": {
          "description": "The unique identifier for the user",
          "type": "string"
        },
        "isEnabled": {
          "description": "Whether the user is enabled (not deactivated)",
          "type": "boolean"
        },
        "lastName": {
          "description": "The user's last name",
          "type": "string"
        },
        "managerId": {
          "description": "The unique identifier for the user's manager",
          "type": "string"
        },
        "updatedAt": {
          "description": "The timestamp when the user was last updated (ISO 8601 format)",
          "type": "string"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "globalRole",
        "isEnabled",
        "updatedAt"
      ],
      "type": "object"
    },
    "brandId": {
      "description": "The id of the brand to use for this job",
      "type": "string"
    },
    "closedAt": {
      "type": "string"
    },
    "compensation": {
      "properties": {
        "compensationTiers": {
          "description": "The compensation ranges that can be offered to applicants for this job",
          "items": {
            "properties": {
              "additionalInformation": {
                "type": "string"
              },
              "components": {
                "description": "The individual components that make up this compensation range",
                "items": {
                  "properties": {
                    "compensationType": {
                      "description": "The type of compensation this component represents",
                      "enum": [
                        "Salary",
                        "EquityPercentage",
                        "EquityCashValue",
                        "Bonus",
                        "Commission"
                      ],
                      "type": "string"
                    },
                    "currencyCode": {
                      "type": "string"
                    },
                    "id": {
                      "description": "The component's unique id",
                      "type": "string"
                    },
                    "interval": {
                      "description": "The frequency at which this compensation is given",
                      "enum": [
                        "NONE",
                        "1 TIME",
                        "1 HOUR",
                        "1 DAY",
                        "1 WEEK",
                        "2 WEEK",
                        "1 MONTH",
                        "2 MONTH",
                        "1 YEAR",
                        "6 MONTH",
                        "0.5 MONTH",
                        "3 MONTH"
                      ],
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "maxValue": {
                      "type": "number"
                    },
                    "minValue": {
                      "type": "number"
                    },
                    "summary": {
                      "description": "The summary of this component as shown on Ashby-hosted job boards",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "summary",
                    "compensationType",
                    "interval"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "id": {
                "description": "The compensation tier's unique id",
                "type": "string"
              },
              "tierSummary": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "additionalInformation",
              "components",
              "tierSummary"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "compensationTiers"
      ],
      "type": "object"
    },
    "confidential": {
      "description": "Whether the job is confidential",
      "type": "boolean"
    },
    "createdAt": {
      "description": "The timestamp when the job was created",
      "type": "string"
    },
    "customFields": {
      "description": "Custom field values associated with the job",
      "items": {
        "properties": {
          "id": {
            "description": "The unique identifier for the custom field definition",
            "type": "string"
          },
          "isPrivate": {
            "description": "Whether the custom field is private",
            "type": "boolean"
          },
          "title": {
            "description": "The title of the custom field",
            "type": "string"
          },
          "value": {
            "properties": {
              "currencyCode": {
                "description": "The currency code",
                "type": "string"
              },
              "value": {
                "description": "The currency amount",
                "type": "number"
              }
            },
            "required": [
              "value",
              "currencyCode"
            ],
            "type": "object"
          },
          "valueLabel": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "isPrivate",
          "title",
          "value"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "customRequisitionId": {
      "type": "string"
    },
    "defaultInterviewPlanId": {
      "description": "The id of the default interview plan for this job. A job cannot be opened without a default interview plan.",
      "type": "string"
    },
    "departmentId": {
      "description": "The id of the department or team associated with the job",
      "type": "string"
    },
    "employmentType": {
      "description": "The employment type for the job",
      "enum": [
        "FullTime",
        "PartTime",
        "Intern",
        "Contract",
        "Temporary"
      ],
      "type": "string"
    },
    "hiringTeam": {
      "description": "The hiring team for the job",
      "items": {
        "properties": {
          "email": {
            "description": "The user's email address",
            "format": "email",
            "type": "string"
          },
          "firstName": {
            "description": "The user's first name",
            "type": "string"
          },
          "lastName": {
            "description": "The user's last name",
            "type": "string"
          },
          "role": {
            "description": "The user's role on the job's hiring team",
            "type": "string"
          },
          "userId": {
            "description": "The unique identifier for the user",
            "type": "string"
          }
        },
        "required": [
          "userId",
          "firstName",
          "lastName",
          "email",
          "role"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "id": {
      "description": "The job's unique identifier",
      "type": "string"
    },
    "interviewPlanIds": {
      "description": "The ids of all interview plans associated with the job",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "jobPostingIds": {
      "description": "The ids of all job postings associated with the job",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "location": {
      "properties": {
        "address": {
          "description": "The address for the location",
          "properties": {
            "postalAddress": {
              "description": "The postal address for the location",
              "properties": {
                "addressCountry": {
                  "description": "The country for the location address",
                  "type": "string"
                },
                "addressLocality": {
                  "description": "The locality for the location address",
                  "type": "string"
                },
                "addressRegion": {
                  "description": "The region for the location address",
                  "type": "string"
                },
                "postalCode": {
                  "description": "The postal code for the location address",
                  "type": "string"
                },
                "streetAddress": {
                  "description": "The street address for the location",
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "required": [
            "postalAddress"
          ],
          "type": "object"
        },
        "externalName": {
          "type": "string"
        },
        "extraData": {
          "type": "object"
        },
        "id": {
          "description": "The unique identifier for the location",
          "type": "string"
        },
        "isArchived": {
          "description": "Whether the location is archived",
          "type": "boolean"
        },
        "isRemote": {
          "type": "boolean"
        },
        "name": {
          "description": "The name of the location",
          "type": "string"
        },
        "parentLocationId": {
          "type": "string"
        },
        "type": {
          "description": "The type of the location component",
          "enum": [
            "Location",
            "LocationHierarchy"
          ],
          "type": "string"
        },
        "workplaceType": {
          "enum": [
            "OnSite",
            "Hybrid",
            "Remote"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "externalName",
        "isArchived",
        "isRemote",
        "address",
        "parentLocationId",
        "type",
        "workplaceType",
        "extraData"
      ],
      "type": "object"
    },
    "locationId": {
      "description": "The id of the location associated with the job",
      "type": "string"
    },
    "openedAt": {
      "type": "string"
    },
    "openings": {
      "description": "The openings linked to this job. Only included when the `openings` expand parameter is provided.",
      "items": {
        "properties": {
          "archivedAt": {
            "format": "date-time",
            "type": "string"
          },
          "closeReasonId": {
            "type": "string"
          },
          "closedAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "The unique identifier for the opening",
            "type": "string"
          },
          "isArchived": {
            "description": "Whether the opening is archived",
            "type": "boolean"
          },
          "latestVersion": {
            "properties": {
              "authorId": {
                "type": "string"
              },
              "createdAt": {
                "description": "The timestamp when the opening version was created",
                "format": "date-time",
                "type": "string"
              },
              "customFields": {
                "description": "Custom fields associated with the opening",
                "items": {
                  "properties": {
                    "id": {
                      "description": "The unique identifier for the custom field definition",
                      "type": "string"
                    },
                    "isPrivate": {
                      "description": "Whether the custom field is private and requires additional permissions",
                      "type": "boolean"
                    },
                    "title": {
                      "description": "The title of the custom field",
                      "type": "string"
                    },
                    "value": {
                      "properties": {
                        "currencyCode": {
                          "description": "The ISO currency code",
                          "type": "string"
                        },
                        "value": {
                          "description": "The currency amount",
                          "type": "number"
                        }
                      },
                      "required": [
                        "value",
                        "currencyCode"
                      ],
                      "type": "object"
                    },
                    "valueLabel": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "value"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "description": {
                "type": "string"
              },
              "employmentType": {
                "description": "The employment type for the opening",
                "enum": [
                  "FullTime",
                  "PartTime",
                  "Intern",
                  "Contract",
                  "Temporary"
                ],
                "type": "string"
              },
              "hiringTeam": {
                "description": "The hiring team roles assigned to the opening",
                "items": {
                  "properties": {
                    "email": {
                      "description": "The user's email address",
                      "format": "email",
                      "type": "string"
                    },
                    "firstName": {
                      "description": "The user's first name",
                      "type": "string"
                    },
                    "lastName": {
                      "description": "The user's last name",
                      "type": "string"
                    },
                    "role": {
                      "description": "The user's role on the opening hiring team",
                      "type": "string"
                    },
                    "userId": {
                      "description": "The unique identifier for the user",
                      "type": "string"
                    }
                  },
                  "required": [
                    "userId",
                    "firstName",
                    "lastName",
                    "email",
                    "role"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "id": {
                "description": "The unique identifier for the opening version",
                "type": "string"
              },
              "identifier": {
                "description": "The human-readable opening identifier",
                "type": "string"
              },
              "isBackfill": {
                "description": "Whether the opening is a backfill",
                "type": "boolean"
              },
              "jobIds": {
                "description": "The unique identifiers for jobs linked to the opening",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "locationIds": {
                "description": "The unique identifiers for locations linked to the opening",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "targetHireDate": {
                "type": "string"
              },
              "targetStartDate": {
                "type": "string"
              },
              "teamId": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "identifier",
              "description",
              "authorId",
              "createdAt",
              "targetHireDate",
              "targetStartDate",
              "isBackfill",
              "employmentType",
              "teamId",
              "jobIds",
              "locationIds",
              "hiringTeam",
              "customFields"
            ],
            "type": "object"
          },
          "openedAt": {
            "format": "date-time",
            "type": "string"
          },
          "openingState": {
            "description": "The current state of the opening",
            "enum": [
              "Draft",
              "Approved",
              "Open",
              "Closed",
              "Filled"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "openedAt",
          "closedAt",
          "isArchived",
          "closeReasonId",
          "archivedAt",
          "openingState",
          "latestVersion"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "Draft",
        "Open",
        "Closed",
        "Archived"
      ],
      "type": "string"
    },
    "title": {
      "description": "The title of the job",
      "type": "string"
    },
    "updatedAt": {
      "description": "The timestamp when the job was last updated",
      "type": "string"
    }
  },
  "title": "jobs",
  "type": "object",
  "x-primary-key": [
    "id"
  ]
}
