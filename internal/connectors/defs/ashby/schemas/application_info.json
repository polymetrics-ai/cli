{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "application_info",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The unique identifier for the application"
    },
    "createdAt": {
      "type": "string",
      "description": "The timestamp when the application was created",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "description": "The timestamp when the application was last updated",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "description": "The status of the application",
      "enum": [
        "Hired",
        "Archived",
        "Active",
        "Lead"
      ]
    },
    "customFields": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "A custom field value attached to the application",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier for the custom field definition"
          },
          "isPrivate": {
            "type": "boolean",
            "description": "Whether the custom field is private"
          },
          "title": {
            "type": "string",
            "description": "The title of the custom field"
          },
          "valueLabel": {
            "type": "string"
          },
          "value": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "description": "The currency amount"
              },
              "currencyCode": {
                "type": "string",
                "description": "The ISO currency code"
              }
            },
            "required": [
              "value",
              "currencyCode"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "value"
        ]
      }
    },
    "candidate": {
      "type": "object",
      "description": "The candidate associated with the application",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier for the candidate"
        },
        "name": {
          "type": "string",
          "description": "The candidate's name"
        },
        "primaryEmailAddress": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "description": "The email address or phone number of the candidate"
            },
            "type": {
              "type": "string",
              "description": "The type of the contact info",
              "enum": [
                "Personal",
                "Work",
                "Other"
              ]
            },
            "isPrimary": {
              "type": "boolean",
              "description": "Whether the contact info is the primary email or phone number"
            }
          },
          "required": [
            "value",
            "type",
            "isPrimary"
          ]
        },
        "primaryPhoneNumber": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "description": "The email address or phone number of the candidate"
            },
            "type": {
              "type": "string",
              "description": "The type of the contact info",
              "enum": [
                "Personal",
                "Work",
                "Other"
              ]
            },
            "isPrimary": {
              "type": "boolean",
              "description": "Whether the contact info is the primary email or phone number"
            }
          },
          "required": [
            "value",
            "type",
            "isPrimary"
          ]
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "currentInterviewStage": {
      "type": "object",
      "description": "The current interview stage for the application",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier for the interview stage"
        },
        "title": {
          "type": "string",
          "description": "The interview stage title"
        },
        "type": {
          "type": "string",
          "description": "The interview stage type"
        },
        "orderInInterviewPlan": {
          "type": "integer",
          "description": "The stage's order within its interview plan"
        },
        "interviewStageGroupId": {
          "type": "string"
        },
        "interviewPlanId": {
          "type": "string",
          "description": "The id of the interview plan the stage belongs to"
        }
      },
      "required": [
        "id",
        "title",
        "type",
        "orderInInterviewPlan",
        "interviewPlanId"
      ]
    },
    "source": {
      "type": "object",
      "description": "The source attributed to this application, if any",
      "properties": {
        "id": {
          "type": "string",
          "description": "The source's unique identifier"
        },
        "title": {
          "type": "string",
          "description": "The title of the source"
        },
        "isArchived": {
          "type": "boolean",
          "description": "Whether the source has been archived"
        },
        "sourceType": {
          "type": "object",
          "description": "The source type associated with this source",
          "properties": {
            "id": {
              "type": "string",
              "description": "The source type's unique identifier"
            },
            "title": {
              "type": "string",
              "description": "The title of the source type"
            },
            "isArchived": {
              "type": "boolean",
              "description": "Whether the source type has been archived"
            }
          },
          "required": [
            "id",
            "title",
            "isArchived"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "isArchived",
        "sourceType"
      ]
    },
    "archiveReason": {
      "type": "object",
      "description": "Details about the archive reason for this application, if archived",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier for the archive reason"
        },
        "text": {
          "type": "string",
          "description": "The display text for the archive reason"
        },
        "reasonType": {
          "type": "string",
          "description": "The category of archive reason",
          "enum": [
            "RejectedByCandidate",
            "RejectedByOrg",
            "Other"
          ]
        },
        "isArchived": {
          "type": "boolean",
          "description": "Whether the archive reason is archived"
        },
        "customFields": {
          "type": "array",
          "description": "Archive detail custom field values",
          "items": {
            "type": "object",
            "description": "A custom field value attached to the application",
            "properties": {
              "id": {
                "type": "string",
                "description": "The unique identifier for the custom field definition"
              },
              "isPrivate": {
                "type": "boolean",
                "description": "Whether the custom field is private"
              },
              "title": {
                "type": "string",
                "description": "The title of the custom field"
              },
              "valueLabel": {
                "type": "string"
              },
              "value": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "description": "The currency amount"
                  },
                  "currencyCode": {
                    "type": "string",
                    "description": "The ISO currency code"
                  }
                },
                "required": [
                  "value",
                  "currencyCode"
                ]
              }
            },
            "required": [
              "id",
              "title",
              "value"
            ]
          }
        }
      },
      "required": [
        "id",
        "text",
        "reasonType",
        "isArchived",
        "customFields"
      ]
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time"
    },
    "job": {
      "type": "object",
      "description": "The job the application is for",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier for the job"
        },
        "title": {
          "type": "string",
          "description": "The job title"
        },
        "locationId": {
          "type": "string"
        },
        "departmentId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "creditedToUser": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier for the user"
        },
        "firstName": {
          "type": "string",
          "description": "The user's first name"
        },
        "lastName": {
          "type": "string",
          "description": "The user's last name"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "globalRole": {
          "type": "string",
          "description": "The user's global role in the organization",
          "enum": [
            "Organization Admin",
            "Elevated Access",
            "Limited Access",
            "External Recruiter"
          ]
        },
        "isEnabled": {
          "type": "boolean",
          "description": "Whether the user is enabled (not deactivated)"
        },
        "updatedAt": {
          "type": "string",
          "description": "The timestamp when the user was last updated (ISO 8601 format)"
        },
        "managerId": {
          "type": "string",
          "description": "The unique identifier for the user's manager"
        },
        "customFields": {
          "type": "array",
          "description": "Custom fields associated with the user (only included when requested)",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The unique identifier for the custom field definition"
              },
              "isPrivate": {
                "type": "boolean",
                "description": "Whether the custom field is private"
              },
              "title": {
                "type": "string",
                "description": "The title of the custom field"
              },
              "value": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "description": "The currency amount"
                  },
                  "currencyCode": {
                    "type": "string",
                    "description": "The currency code"
                  }
                },
                "required": [
                  "value",
                  "currencyCode"
                ]
              },
              "valueLabel": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "isPrivate",
              "title",
              "value"
            ]
          }
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "globalRole",
        "isEnabled",
        "updatedAt"
      ]
    },
    "hiringTeam": {
      "type": "array",
      "description": "The hiring team for the application",
      "items": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "The unique identifier of the hiring team member"
          },
          "firstName": {
            "type": "string",
            "description": "The first name of the hiring team member"
          },
          "lastName": {
            "type": "string",
            "description": "The last name of the hiring team member"
          },
          "email": {
            "type": "string",
            "description": "The primary email address of the hiring team member",
            "format": "email"
          },
          "role": {
            "type": "string",
            "description": "The hiring team role assigned to the member"
          }
        },
        "required": [
          "userId",
          "firstName",
          "lastName",
          "email",
          "role"
        ]
      }
    },
    "appliedViaJobPostingId": {
      "type": "string"
    },
    "submitterClientIp": {
      "type": "string"
    },
    "submitterUserAgent": {
      "type": "string"
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "An opening linked to the application via `expand: ['openings']`",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier for the opening"
          },
          "openedAt": {
            "type": "string",
            "format": "date-time"
          },
          "closedAt": {
            "type": "string",
            "format": "date-time"
          },
          "isArchived": {
            "type": "boolean",
            "description": "Whether the opening is archived"
          },
          "archivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "closeReasonId": {
            "type": "string"
          },
          "openingState": {
            "type": "string",
            "description": "The current state of the opening",
            "enum": [
              "Approved",
              "Closed",
              "Draft",
              "Filled",
              "Open"
            ]
          },
          "latestVersion": {
            "type": "object",
            "description": "The latest version of the opening",
            "properties": {
              "id": {
                "type": "string",
                "description": "The unique identifier for the opening version"
              },
              "identifier": {
                "type": "string",
                "description": "The human-readable opening identifier"
              },
              "description": {
                "type": "string"
              },
              "authorId": {
                "type": "string"
              },
              "createdAt": {
                "type": "string",
                "description": "The timestamp when the opening version was created",
                "format": "date-time"
              },
              "teamId": {
                "type": "string"
              },
              "jobIds": {
                "type": "array",
                "description": "The unique identifiers for jobs linked to the opening",
                "items": {
                  "type": "string"
                }
              },
              "targetHireDate": {
                "type": "string"
              },
              "targetStartDate": {
                "type": "string"
              },
              "isBackfill": {
                "type": "boolean",
                "description": "Whether the opening is a backfill"
              },
              "employmentType": {
                "type": "string",
                "description": "The employment type"
              },
              "locationIds": {
                "type": "array",
                "description": "The location ids",
                "items": {
                  "type": "string"
                }
              },
              "hiringTeam": {
                "type": "array",
                "description": "Hiring team for the opening",
                "items": {
                  "type": "object",
                  "properties": {
                    "userId": {
                      "type": "string",
                      "description": "The user id"
                    },
                    "firstName": {
                      "type": "string",
                      "description": "The first name"
                    },
                    "lastName": {
                      "type": "string",
                      "description": "The last name"
                    },
                    "email": {
                      "type": "string",
                      "description": "The email",
                      "format": "email"
                    },
                    "role": {
                      "type": "string",
                      "description": "The role"
                    }
                  },
                  "required": [
                    "userId",
                    "firstName",
                    "lastName",
                    "email",
                    "role"
                  ]
                }
              },
              "customFields": {
                "type": "array",
                "description": "Custom fields attached to the opening",
                "items": {
                  "type": "object",
                  "description": "A custom field value attached to the application",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The unique identifier for the custom field definition"
                    },
                    "isPrivate": {
                      "type": "boolean",
                      "description": "Whether the custom field is private"
                    },
                    "title": {
                      "type": "string",
                      "description": "The title of the custom field"
                    },
                    "valueLabel": {
                      "type": "string"
                    },
                    "value": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number",
                          "description": "The currency amount"
                        },
                        "currencyCode": {
                          "type": "string",
                          "description": "The ISO currency code"
                        }
                      },
                      "required": [
                        "value",
                        "currencyCode"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "value"
                  ]
                }
              }
            },
            "required": [
              "id",
              "identifier",
              "description",
              "authorId",
              "createdAt",
              "jobIds",
              "isBackfill",
              "employmentType",
              "locationIds",
              "hiringTeam",
              "customFields"
            ]
          }
        },
        "required": [
          "id",
          "isArchived",
          "openingState"
        ]
      }
    },
    "applicationHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier for the history event"
          },
          "stageId": {
            "type": "string",
            "description": "The id of the interview stage for this event"
          },
          "title": {
            "type": "string",
            "description": "The interview stage title for this event"
          },
          "enteredStageAt": {
            "type": "string",
            "description": "The timestamp the application entered this stage",
            "format": "date-time"
          },
          "leftStageAt": {
            "type": "string",
            "format": "date-time"
          },
          "stageNumber": {
            "type": "integer",
            "description": "The order of the history event in the application's history. 0 is the first event."
          },
          "allowedActions": {
            "type": "array",
            "description": "Actions that can be performed on this history event via `application.updateHistory`.",
            "items": {
              "type": "string",
              "enum": [
                "none",
                "delete",
                "set_entered_at"
              ]
            }
          },
          "actorId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "stageId",
          "title",
          "enteredStageAt",
          "stageNumber",
          "allowedActions"
        ]
      }
    },
    "applicationFormSubmissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier for the application form submission"
          },
          "formDefinition": {
            "type": "object",
            "properties": {
              "sections": {
                "type": "array",
                "description": "The sections in the form definition",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "descriptionHtml": {
                      "type": "string"
                    },
                    "descriptionPlain": {
                      "type": "string"
                    },
                    "fields": {
                      "type": "array",
                      "description": "The fields in this form section",
                      "items": {
                        "type": "object",
                        "properties": {
                          "isRequired": {
                            "type": "boolean",
                            "description": "Whether this form field is required"
                          },
                          "descriptionHtml": {
                            "type": "string"
                          },
                          "descriptionPlain": {
                            "type": "string"
                          },
                          "field": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "description": "The unique identifier for the form definition field"
                              },
                              "type": {
                                "type": "string",
                                "description": "The type of the form definition field"
                              },
                              "path": {
                                "type": "string",
                                "description": "The path used to submit values for this field"
                              },
                              "humanReadablePath": {
                                "type": "string",
                                "description": "The human-readable path for the form field"
                              },
                              "title": {
                                "type": "string",
                                "description": "The display title for the form field"
                              },
                              "isNullable": {
                                "type": "boolean",
                                "description": "Whether the form field accepts null values"
                              },
                              "selectableValues": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "label": {
                                      "type": "string",
                                      "description": "The display label for the selectable value"
                                    },
                                    "value": {
                                      "type": "string",
                                      "description": "The submitted value for the selectable option"
                                    }
                                  },
                                  "required": [
                                    "label",
                                    "value"
                                  ]
                                }
                              }
                            },
                            "required": [
                              "id",
                              "type",
                              "path",
                              "humanReadablePath",
                              "title",
                              "isNullable"
                            ]
                          }
                        },
                        "required": [
                          "isRequired",
                          "field"
                        ]
                      }
                    }
                  },
                  "required": [
                    "fields"
                  ]
                }
              }
            },
            "required": [
              "sections"
            ]
          },
          "submittedValues": {
            "description": "The values submitted for the form, keyed by field path"
          }
        },
        "required": [
          "id",
          "formDefinition",
          "submittedValues"
        ]
      }
    },
    "referrals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The unique identifier for the user"
              },
              "firstName": {
                "type": "string",
                "description": "The user's first name"
              },
              "lastName": {
                "type": "string",
                "description": "The user's last name"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "globalRole": {
                "type": "string",
                "description": "The user's global role in the organization",
                "enum": [
                  "Organization Admin",
                  "Elevated Access",
                  "Limited Access",
                  "External Recruiter"
                ]
              },
              "isEnabled": {
                "type": "boolean",
                "description": "Whether the user is enabled (not deactivated)"
              },
              "updatedAt": {
                "type": "string",
                "description": "The timestamp when the user was last updated (ISO 8601 format)"
              },
              "managerId": {
                "type": "string",
                "description": "The unique identifier for the user's manager"
              },
              "customFields": {
                "type": "array",
                "description": "Custom fields associated with the user (only included when requested)",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The unique identifier for the custom field definition"
                    },
                    "isPrivate": {
                      "type": "boolean",
                      "description": "Whether the custom field is private"
                    },
                    "title": {
                      "type": "string",
                      "description": "The title of the custom field"
                    },
                    "value": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number",
                          "description": "The currency amount"
                        },
                        "currencyCode": {
                          "type": "string",
                          "description": "The currency code"
                        }
                      },
                      "required": [
                        "value",
                        "currencyCode"
                      ]
                    },
                    "valueLabel": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "isPrivate",
                    "title",
                    "value"
                  ]
                }
              }
            },
            "required": [
              "id",
              "firstName",
              "lastName",
              "email",
              "globalRole",
              "isEnabled",
              "updatedAt"
            ]
          },
          "referredAt": {
            "type": "string",
            "description": "The timestamp the referral was created",
            "format": "date-time"
          }
        },
        "required": [
          "user",
          "referredAt"
        ]
      }
    },
    "resumeFileHandle": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier for the file"
        },
        "name": {
          "type": "string",
          "description": "The file name"
        },
        "handle": {
          "type": "string",
          "description": "The file handle, which can be used with the `file.info` endpoint"
        }
      },
      "required": [
        "id",
        "name",
        "handle"
      ]
    }
  },
  "x-primary-key": [
    "id"
  ]
}
