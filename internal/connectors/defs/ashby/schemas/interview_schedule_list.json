{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "applicationId": {
      "description": "The id of the application for this interview schedule",
      "type": "string"
    },
    "createdAt": {
      "description": "The timestamp when the interview schedule was created",
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "description": "The unique identifier for the interview schedule",
      "type": "string"
    },
    "interviewEvents": {
      "description": "The interview events that make up this interview schedule",
      "items": {
        "properties": {
          "createdAt": {
            "description": "The timestamp when the interview event was created",
            "format": "date-time",
            "type": "string"
          },
          "endTime": {
            "description": "The scheduled end time of the interview event",
            "format": "date-time",
            "type": "string"
          },
          "extraData": {
            "type": "object"
          },
          "feedbackLink": {
            "description": "The link interviewers can use to submit feedback",
            "format": "uri",
            "type": "string"
          },
          "hasSubmittedFeedback": {
            "description": "Whether feedback has been submitted for this interview event",
            "type": "boolean"
          },
          "id": {
            "description": "The unique identifier for the interview event",
            "type": "string"
          },
          "interview": {
            "properties": {
              "externalTitle": {
                "description": "The title of the interview shown to candidates",
                "type": "string"
              },
              "feedbackFormDefinitionId": {
                "description": "The unique identifier for the feedback form definition used by this interview",
                "type": "string"
              },
              "id": {
                "description": "The unique identifier for the interview",
                "type": "string"
              },
              "instructionsHtml": {
                "type": "string"
              },
              "instructionsPlain": {
                "type": "string"
              },
              "isArchived": {
                "description": "Whether the interview is archived",
                "type": "boolean"
              },
              "isDebrief": {
                "description": "Whether the interview is a debrief",
                "type": "boolean"
              },
              "isFeedbackRequested": {
                "description": "Whether feedback is requested for this interview",
                "type": "boolean"
              },
              "isFeedbackRequired": {
                "description": "Whether feedback is required for this interview",
                "type": "boolean"
              },
              "jobId": {
                "type": "string"
              },
              "title": {
                "description": "The internal title of the interview",
                "type": "string"
              },
              "type": {
                "description": "The interview definition type, such as Interview, TakeHome, or Debrief",
                "enum": [
                  "Assessment",
                  "Interview",
                  "InterviewWithoutSchedule",
                  "TakeHome",
                  "Debrief"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "externalTitle",
              "type",
              "isArchived",
              "isDebrief",
              "isFeedbackRequired",
              "isFeedbackRequested",
              "feedbackFormDefinitionId"
            ],
            "type": "object"
          },
          "interviewId": {
            "description": "The id of the interview for this event",
            "type": "string"
          },
          "interviewScheduleId": {
            "description": "The id of the interview schedule for this event",
            "type": "string"
          },
          "interviewerCalendarEventId": {
            "type": "string"
          },
          "interviewerUserIds": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "interviewers": {
            "description": "The users interviewing in this event",
            "items": {
              "properties": {
                "customFields": {
                  "description": "Custom fields associated with the user (only included when requested)",
                  "items": {
                    "properties": {
                      "id": {
                        "description": "The unique identifier for the custom field definition",
                        "type": "string"
                      },
                      "isPrivate": {
                        "description": "Whether the custom field is private",
                        "type": "boolean"
                      },
                      "title": {
                        "description": "The title of the custom field",
                        "type": "string"
                      },
                      "value": {
                        "properties": {
                          "currencyCode": {
                            "description": "The currency code",
                            "type": "string"
                          },
                          "value": {
                            "description": "The currency amount",
                            "type": "number"
                          }
                        },
                        "required": [
                          "value",
                          "currencyCode"
                        ],
                        "type": "object"
                      },
                      "valueLabel": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "isPrivate",
                      "title",
                      "value"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "email": {
                  "format": "email",
                  "type": "string"
                },
                "firstName": {
                  "description": "The user's first name",
                  "type": "string"
                },
                "globalRole": {
                  "description": "The user's global role in the organization",
                  "enum": [
                    "Organization Admin",
                    "Elevated Access",
                    "Limited Access",
                    "External Recruiter"
                  ],
                  "type": "string"
                },
                "id": {
                  "description": "The unique identifier for the user",
                  "type": "string"
                },
                "interviewerPool": {
                  "properties": {
                    "id": {
                      "description": "The unique identifier for the interviewer pool",
                      "type": "string"
                    },
                    "isArchived": {
                      "description": "Whether the interviewer pool is archived",
                      "type": "boolean"
                    },
                    "title": {
                      "description": "The title of the interviewer pool",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "isArchived"
                  ],
                  "type": "object"
                },
                "isEnabled": {
                  "description": "Whether the user is enabled (not deactivated)",
                  "type": "boolean"
                },
                "isFeedbackRequired": {
                  "description": "Whether feedback is required from this interviewer",
                  "type": "boolean"
                },
                "lastName": {
                  "description": "The user's last name",
                  "type": "string"
                },
                "managerId": {
                  "description": "The unique identifier for the user's manager",
                  "type": "string"
                },
                "trainingRole": {
                  "type": "string"
                },
                "updatedAt": {
                  "description": "The timestamp when the user was last updated (ISO 8601 format)",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "firstName",
                "lastName",
                "email",
                "globalRole",
                "isEnabled",
                "updatedAt",
                "isFeedbackRequired"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "location": {
            "type": "string"
          },
          "meetingLink": {
            "type": "string"
          },
          "notetakerTranscriptId": {
            "type": "string"
          },
          "startTime": {
            "description": "The scheduled start time of the interview event",
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "description": "The timestamp when the interview event was last updated",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "interviewId",
          "interviewScheduleId",
          "interviewers",
          "createdAt",
          "updatedAt",
          "startTime",
          "endTime",
          "feedbackLink",
          "hasSubmittedFeedback"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "interviewStageId": {
      "description": "The id of the interview stage for this interview schedule",
      "type": "string"
    },
    "scheduledBy": {
      "properties": {
        "customFields": {
          "description": "Custom fields associated with the user (only included when requested)",
          "items": {
            "properties": {
              "id": {
                "description": "The unique identifier for the custom field definition",
                "type": "string"
              },
              "isPrivate": {
                "description": "Whether the custom field is private",
                "type": "boolean"
              },
              "title": {
                "description": "The title of the custom field",
                "type": "string"
              },
              "value": {
                "properties": {
                  "currencyCode": {
                    "description": "The currency code",
                    "type": "string"
                  },
                  "value": {
                    "description": "The currency amount",
                    "type": "number"
                  }
                },
                "required": [
                  "value",
                  "currencyCode"
                ],
                "type": "object"
              },
              "valueLabel": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "isPrivate",
              "title",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "email": {
          "format": "email",
          "type": "string"
        },
        "firstName": {
          "description": "The user's first name",
          "type": "string"
        },
        "globalRole": {
          "description": "The user's global role in the organization",
          "enum": [
            "Organization Admin",
            "Elevated Access",
            "Limited Access",
            "External Recruiter"
          ],
          "type": "string"
        },
        "id": {
          "description": "The unique identifier for the user",
          "type": "string"
        },
        "isEnabled": {
          "description": "Whether the user is enabled (not deactivated)",
          "type": "boolean"
        },
        "lastName": {
          "description": "The user's last name",
          "type": "string"
        },
        "managerId": {
          "description": "The unique identifier for the user's manager",
          "type": "string"
        },
        "updatedAt": {
          "description": "The timestamp when the user was last updated (ISO 8601 format)",
          "type": "string"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "globalRole",
        "isEnabled",
        "updatedAt"
      ],
      "type": "object"
    },
    "status": {
      "description": "The current status of the interview schedule",
      "enum": [
        "NeedsScheduling",
        "SchedulingRequested",
        "WaitingOnCandidateBooking",
        "WaitingOnCandidateAvailability",
        "CandidateAvailabilitySubmitted",
        "Scheduled",
        "WaitingOnFeedback",
        "Complete",
        "Cancelled",
        "OnHold",
        "Unknown"
      ],
      "type": "string"
    },
    "updatedAt": {
      "description": "The timestamp when the interview schedule was last updated",
      "format": "date-time",
      "type": "string"
    }
  },
  "title": "interview_schedule_list",
  "type": "object",
  "x-primary-key": [
    "id"
  ]
}
