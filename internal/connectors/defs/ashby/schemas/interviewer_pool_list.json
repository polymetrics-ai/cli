{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "id": {
      "description": "The pool's id",
      "type": "string"
    },
    "isArchived": {
      "description": "Whether the pool is archived",
      "type": "boolean"
    },
    "title": {
      "description": "The pool's title",
      "type": "string"
    },
    "trainingPath": {
      "properties": {
        "enabled": {
          "description": "Whether the training path is enabled",
          "type": "boolean"
        },
        "id": {
          "description": "The training path's id",
          "type": "string"
        },
        "trainingStages": {
          "description": "The training stages in this path",
          "items": {
            "properties": {
              "approvalRequired": {
                "description": "Whether approval is required for this stage",
                "type": "boolean"
              },
              "approvers": {
                "items": {
                  "properties": {
                    "customFields": {
                      "description": "Custom fields associated with the user (only included when requested)",
                      "items": {
                        "properties": {
                          "id": {
                            "description": "The unique identifier for the custom field definition",
                            "type": "string"
                          },
                          "isPrivate": {
                            "description": "Whether the custom field is private",
                            "type": "boolean"
                          },
                          "title": {
                            "description": "The title of the custom field",
                            "type": "string"
                          },
                          "value": {
                            "properties": {
                              "currencyCode": {
                                "description": "The currency code",
                                "type": "string"
                              },
                              "value": {
                                "description": "The currency amount",
                                "type": "number"
                              }
                            },
                            "required": [
                              "value",
                              "currencyCode"
                            ],
                            "type": "object"
                          },
                          "valueLabel": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "isPrivate",
                          "title",
                          "value"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "email": {
                      "format": "email",
                      "type": "string"
                    },
                    "firstName": {
                      "description": "The user's first name",
                      "type": "string"
                    },
                    "globalRole": {
                      "description": "The user's global role in the organization",
                      "enum": [
                        "Organization Admin",
                        "Elevated Access",
                        "Limited Access",
                        "External Recruiter"
                      ],
                      "type": "string"
                    },
                    "id": {
                      "description": "The unique identifier for the user",
                      "type": "string"
                    },
                    "isEnabled": {
                      "description": "Whether the user is enabled (not deactivated)",
                      "type": "boolean"
                    },
                    "lastName": {
                      "description": "The user's last name",
                      "type": "string"
                    },
                    "managerId": {
                      "description": "The unique identifier for the user's manager",
                      "type": "string"
                    },
                    "updatedAt": {
                      "description": "The timestamp when the user was last updated (ISO 8601 format)",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "firstName",
                    "lastName",
                    "email",
                    "globalRole",
                    "isEnabled",
                    "updatedAt"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "id": {
                "description": "The training stage's id",
                "type": "string"
              },
              "interviewerRole": {
                "description": "The role of the interviewer for this stage",
                "enum": [
                  "Shadow",
                  "ReverseShadow"
                ],
                "type": "string"
              },
              "interviewsRequired": {
                "description": "The number of interviews required for this stage",
                "type": "integer"
              },
              "isArchived": {
                "description": "Whether the training stage is archived",
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "interviewerRole",
              "interviewsRequired",
              "isArchived",
              "approvalRequired",
              "approvers"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "enabled",
        "trainingStages"
      ],
      "type": "object"
    }
  },
  "title": "interviewer_pool_list",
  "type": "object",
  "x-primary-key": [
    "id"
  ]
}
