{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "createdAt": {
      "description": "The timestamp when the job template was created",
      "format": "date-time",
      "type": "string"
    },
    "defaultInterviewPlanId": {
      "description": "The id of the default interview plan for this job template. A job cannot be opened without a default interview plan.",
      "type": "string"
    },
    "departmentId": {
      "description": "The id of the department or team associated with the job template",
      "type": "string"
    },
    "id": {
      "description": "The job template's unique identifier",
      "type": "string"
    },
    "interviewPlanIds": {
      "description": "The ids of all interview plans associated with the job template",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "location": {
      "properties": {
        "address": {
          "description": "The address for the location",
          "properties": {
            "postalAddress": {
              "description": "The postal address for the location",
              "properties": {
                "addressCountry": {
                  "description": "The country for the location address",
                  "type": "string"
                },
                "addressLocality": {
                  "description": "The locality for the location address",
                  "type": "string"
                },
                "addressRegion": {
                  "description": "The region for the location address",
                  "type": "string"
                },
                "postalCode": {
                  "description": "The postal code for the location address",
                  "type": "string"
                },
                "streetAddress": {
                  "description": "The street address for the location",
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "required": [
            "postalAddress"
          ],
          "type": "object"
        },
        "externalName": {
          "type": "string"
        },
        "extraData": {
          "type": "object"
        },
        "id": {
          "description": "The unique identifier for the location",
          "type": "string"
        },
        "isArchived": {
          "description": "Whether the location is archived",
          "type": "boolean"
        },
        "isRemote": {
          "type": "boolean"
        },
        "name": {
          "description": "The name of the location",
          "type": "string"
        },
        "parentLocationId": {
          "type": "string"
        },
        "type": {
          "description": "The type of the location component",
          "enum": [
            "Location",
            "LocationHierarchy"
          ],
          "type": "string"
        },
        "workplaceType": {
          "enum": [
            "OnSite",
            "Hybrid",
            "Remote"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "externalName",
        "isArchived",
        "isRemote",
        "address",
        "parentLocationId",
        "type",
        "workplaceType",
        "extraData"
      ],
      "type": "object"
    },
    "locationId": {
      "description": "The id of the location of the job template",
      "type": "string"
    },
    "status": {
      "enum": [
        "Active",
        "Inactive"
      ],
      "type": "string"
    },
    "title": {
      "description": "The title of the job template",
      "type": "string"
    },
    "updatedAt": {
      "description": "The timestamp when the job template was last updated",
      "format": "date-time",
      "type": "string"
    }
  },
  "title": "job_template_list",
  "type": "object",
  "x-primary-key": [
    "id"
  ]
}
