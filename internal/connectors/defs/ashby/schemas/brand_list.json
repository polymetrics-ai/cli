{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "brand_list",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The unique identifier for the brand"
    },
    "name": {
      "type": "string",
