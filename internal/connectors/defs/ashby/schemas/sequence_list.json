{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sequence_list",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The unique identifier for this candidate's sequence enrollment"
    },
    "candidateId": {
      "type": "string",
      "description": "The candidate enrolled in the sequence"
    },
    "applicationId": {
      "type": "string"
    },
    "sequenceTemplateId": {
      "type": "string",
      "description": "The reusable sequence template used for enrollment"
    },
    "status": {
      "type": "string",
      "enum": [
        "NotStarted",
        "Running",
        "Paused",
        "Completed",
        "Cancelled",
        "Unsubscribed"
      ]
    },
    "createdAt": {
      "type": "string",
      "description": "When the sequence enrollment was created",
      "format": "date-time"
    },
    "stages": {
      "type": "array",
      "description": "The stages in sequence order",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier for this sequence stage"
          },
          "type": {
            "type": "string",
            "enum": [
              "Email",
              "InMail",
              "LinkedInConnection"
            ]
          },
          "from": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "description": "The address used to send this stage",
                "format": "email"
              },
              "displayName": {
                "type": "string"
              }
            },
            "required": [
              "email",
              "displayName"
            ]
          },
          "subject": {
            "type": "string",
            "description": "The resolved subject for an editable, not-started email stage"
          },
          "bodyHtml": {
            "type": "string",
            "description": "The editable HTML body for a not-started email stage. Ashby token markers must be preserved when editing."
          },
          "sendAfter": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "NoDelay"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "id",
          "type",
          "sendAfter"
        ]
      }
    }
  },
  "x-primary-key": [
    "id"
  ]
}
