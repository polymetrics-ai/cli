{
  "actions": [
    {
      "name": "send_text_message",
      "kind": "create",
      "method": "POST",
      "path": "/{{ config.phone_number_id }}/messages",
      "body_type": "json",
      "record_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "required": [
          "messaging_product",
          "to",
          "type",
          "text"
        ],
        "properties": {
          "messaging_product": {
            "type": "string",
            "enum": [
              "whatsapp"
            ],
            "description": "Always 'whatsapp'."
          },
          "to": {
            "type": "string",
            "description": "Recipient WhatsApp number in E.164 (patient PHI; redacted in plans)."
          },
          "type": {
            "type": "string",
            "enum": [
              "text"
            ],
            "description": "Message type."
          },
          "text": {
            "type": "object",
            "description": "Text body object {body, preview_url}.",
            "required": [
              "body"
            ],
            "properties": {
              "body": {
                "type": "string",
                "description": "Message body."
              },
              "preview_url": {
                "type": "boolean",
                "description": "Whether to render link previews."
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "risk": "sends a WhatsApp text message to a patient number (PHI); requires reverse ETL approval and consent",
      "confirm": "destructive",
      "body_fields": [
        "messaging_product",
        "to",
        "type",
        "text"
      ]
    },
