{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "x-primary-key": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Subscribed app ID (from whatsapp_business_api_data)."
    },
    "name": {
      "type": "string",
      "description": "Subscribed app name."
    },
    "link": {
      "type": "string",
      "description": "Subscribed app link."
    }
  }
}
