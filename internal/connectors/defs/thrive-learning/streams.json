{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "auth": [
      {
        "mode": "basic",
        "username": "{{ config.username }}",
        "password": "{{ secrets.password }}"
      }
    ],
    "pagination": {
      "type": "page_number",
      "page_param": "page",
      "size_param": "limit",
      "start_page": 1,
      "page_size": 100
    },
    "check": {
      "method": "GET",
      "path": "/users"
    },
    "error_map": [
      {
        "status": 401,
        "hint": "thrive-learning username/password is missing or invalid; re-run pm credentials add thrive-learning"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "thrive-learning rate limit exceeded; the connector will retry with backoff"
      }
    ]
  },
  "streams": [
    {
      "name": "users",
      "path": "/users",
      "query": {
        "updated_since": {
          "template": "{{ config.start_date }}",
          "omit_when_absent": true
        }
      },
      "records": {
        "path": "items"
      },
      "schema": "schemas/users.json",
      "projection": "passthrough"
    },
    {
      "name": "content",
      "path": "/content",
      "query": {
        "updated_since": {
          "template": "{{ config.start_date }}",
          "omit_when_absent": true
        }
      },
      "records": {
        "path": "items"
      },
      "schema": "schemas/content.json",
      "projection": "passthrough"
    },
    {
      "name": "completions",
      "path": "/completions",
      "query": {
        "updated_since": {
          "template": "{{ config.start_date }}",
          "omit_when_absent": true
        }
      },
      "records": {
        "path": "items"
      },
      "schema": "schemas/completions.json",
      "projection": "passthrough"
    },
    {
      "name": "activities",
      "path": "https://public.api.learn.link/rest/v1/activities",
      "pagination": {
        "type": "page_number",
        "page_param": "page",
        "size_param": "perPage",
        "start_page": 1,
        "page_size": 1000
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/activities.json"
    },
    {
      "name": "contents_v1",
      "path": "https://public.api.learn.link/rest/v1/contents",
      "query": {
        "updatedSince": {
          "template": "{{ config.start_date }}",
          "omit_when_absent": true
        }
      },
      "pagination": {
        "type": "page_number",
        "page_param": "page",
        "size_param": "perPage",
        "start_page": 1,
        "page_size": 1000
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/contents_v1.json"
    },
    {
      "name": "learning_completions",
      "path": "https://public.api.learn.link/rest/v1/learning/completions",
      "pagination": {
        "type": "page_number",
        "page_param": "page",
        "size_param": "perPage",
        "start_page": 1,
        "page_size": 1000
      },
      "records": {
        "path": "."
      },
      "schema": "schemas/learning_completions.json"
    },
    {
      "name": "assignments",
      "path": "https://public.api.learn.link/rest/v1/assignments",
      "pagination": {
        "type": "page_number",
        "page_param": "page",
        "size_param": "perPage",
        "start_page": 1,
        "page_size": 1000
      },
      "records": {
        "path": "."
      },
      "schema": "schemas/assignments.json"
    },
    {
      "name": "assignment_enrolments",
      "path": "https://public.api.learn.link/rest/v1/assignments/{{ fanout.id }}/enrolments",
      "pagination": {
        "type": "page_number",
        "page_param": "page",
        "size_param": "perPage",
        "start_page": 1,
        "page_size": 1000
      },
      "records": {
        "path": "."
      },
      "fan_out": {
        "ids_from": {
          "request": {
            "path": "https://public.api.learn.link/rest/v1/assignments",
            "records_path": ".",
            "id_field": "id"
          }
        },
        "into": {
          "path_var": "assignmentId"
        },
        "stamp_field": "assignment_id"
      },
      "schema": "schemas/assignment_enrolments.json"
    },
    {
      "name": "audiences",
      "path": "https://public.api.learn.link/rest/v1/audiences",
      "pagination": {
        "type": "page_number",
        "page_param": "page",
        "size_param": "perPage",
        "start_page": 1,
        "page_size": 1000
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/audiences.json"
    },
    {
      "name": "audience_members",
      "path": "https://public.api.learn.link/rest/v1/audiences/{{ fanout.id }}/members",
      "pagination": {
        "type": "page_number",
        "page_param": "page",
        "size_param": "perPage",
        "start_page": 1,
        "page_size": 1000
      },
      "records": {
        "path": "results"
      },
      "fan_out": {
        "ids_from": {
          "request": {
            "path": "https://public.api.learn.link/rest/v1/audiences",
            "records_path": "results",
            "id_field": "id"
          }
        },
        "into": {
          "path_var": "audienceId"
        },
        "stamp_field": "audience_id"
      },
      "schema": "schemas/audience_members.json"
    },
    {
      "name": "audience_managers",
      "path": "https://public.api.learn.link/rest/v1/audiences/{{ fanout.id }}/managers",
      "pagination": {
        "type": "none"
      },
      "records": {
        "path": "."
      },
      "fan_out": {
        "ids_from": {
          "request": {
            "path": "https://public.api.learn.link/rest/v1/audiences",
            "records_path": "results",
            "id_field": "id"
          }
        },
        "into": {
          "path_var": "audienceId"
        },
        "stamp_field": "audience_id"
      },
      "schema": "schemas/audience_managers.json"
    },
    {
      "name": "tags",
      "path": "https://public.api.learn.link/rest/v1/tags",
      "pagination": {
        "type": "none"
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/tags.json"
    },
    {
      "name": "cpd_categories",
      "path": "https://public.api.learn.link/rest/v1/cpdCategories",
      "pagination": {
        "type": "page_number",
        "page_param": "page",
        "size_param": "perPage",
        "start_page": 1,
        "page_size": 1000
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/cpd_categories.json"
    },
    {
      "name": "cpd_entries",
      "path": "https://public.api.learn.link/rest/v1/cpdEntries",
      "pagination": {
        "type": "page_number",
        "page_param": "page",
        "size_param": "perPage",
        "start_page": 1,
        "page_size": 1000
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/cpd_entries.json"
    },
    {
      "name": "cpd_requirements",
      "path": "https://public.api.learn.link/rest/v1/cpdRequirementSummaries",
      "pagination": {
        "type": "page_number",
        "page_param": "page",
        "size_param": "perPage",
        "start_page": 1,
        "page_size": 1000
      },
      "records": {
        "path": "results"
      },
      "schema": "schemas/cpd_requirements.json"
    },
    {
      "name": "skill_levels",
      "path": "https://public.api.learn.link/rest/v1/skills/levels",
      "pagination": {
        "type": "none"
      },
      "records": {
        "path": "."
      },
      "schema": "schemas/skill_levels.json"
    }
  ]
}
