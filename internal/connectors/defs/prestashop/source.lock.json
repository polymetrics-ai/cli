{
  "schema_version": 4,
  "connector": "prestashop",
  "lanes": {
    "binary_download": "unsupported",
    "binary_upload": "unsupported",
    "direct_read": "unsupported",
    "direct_write": "unsupported",
    "etl": "implemented",
    "reverse_etl": "unsupported",
    "sync_transport": "unsupported"
  },
  "provider_evidence": {
    "documentation": [
      {
        "role": "provider_reference",
        "url": "https://devdocs.prestashop-project.org/9/webservice/"
      }
    ]
  },
  "metadata": {
    "name": "prestashop",
    "display_name": "PrestaShop",
    "description": "Reads PrestaShop customers, orders, products, addresses, and carts through the PrestaShop Webservice REST API.",
    "integration_type": "api",
    "release_stage": "alpha",
    "capabilities": {
      "check": true,
      "read": true,
      "write": false,
      "query": false,
      "cdc": false,
      "dynamic_schema": false
    },
    "risk": {
      "read": "external PrestaShop Webservice API reads through the declaration-bound tenant origin",
      "write": "unsupported",
      "approval": "none; read-only"
    },
    "docs_url": "https://devdocs.prestashop-project.org/9/webservice/"
  },
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "PrestaShop Connection Specification",
    "type": "object",
    "required": [
      "access_key",
      "url"
    ],
    "properties": {
      "access_key": {
        "type": "string",
        "x-secret": true,
        "description": "Your PrestaShop access key. See <a href=\"https://devdocs.prestashop.com/1.7/webservice/tutorials/creating-access/#create-an-access-key\"> the docs </a> for info on how to obtain this."
      },
      "start_date": {
        "type": "string",
        "description": "The Start date in the format YYYY-MM-DD."
      },
      "url": {
        "type": "string",
        "description": "Required PrestaShop shop HTTPS origin."
      }
    },
    "x-reject-unknown-config": true
  },
  "http": {
    "url": "https://unused.invalid",
    "user_agent": "polymetrics-go-cli",
    "auth": [
      {
        "mode": "basic",
        "username": "{{ secrets.access_key }}",
        "password": ""
      }
    ],
    "pagination": {
      "type": "none"
    },
    "check": {
      "method": "GET",
      "path": "/customers",
      "query": {
        "output_format": "JSON",
        "display": "full",
        "limit": "1"
      }
    },
    "error_map": [],
    "tenant_origin": {
      "config_key": "url",
      "append_path": "/api",
      "allow_loopback_http": true
    }
  },
