{
  "base": {
    "auth": [
      {
        "mode": "basic",
        "password": "",
        "username": "{{ secrets.access_key }}"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/customers",
      "query": {
        "display": "full",
        "limit": "1",
        "output_format": "JSON"
      }
    },
    "error_map": [],
    "pagination": {
      "type": "none"
    },
    "tenant_origin": {
      "allow_loopback_http": true,
      "append_path": "/api",
      "config_key": "url"
    },
    "url": "https://unused.invalid",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "date_upd",
        "start_config_key": "start_date"
      },
      "method": "GET",
      "name": "customers",
      "pagination": {
        "limit_param": "limit",
        "max_pages": 100,
        "offset_param": "offset",
        "page_size": 100,
        "type": "offset_limit"
      },
      "path": "/customers",
      "query": {
        "display": "full",
        "output_format": "JSON"
      },
      "records": {
        "path": "customers.customer"
      },
      "schema": "schemas/customers.json"
    },
