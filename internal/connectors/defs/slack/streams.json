{
  "base": {
    "url": "{{ config.base_url }}",
    "user_agent": "polymetrics-go-cli",
    "auth": [
      {
        "mode": "bearer",
        "token": "{{ secrets.api_token }}",
        "when": "{{ secrets.api_token }}"
      },
      {
        "mode": "bearer",
        "token": "{{ secrets.access_token }}",
        "when": "{{ secrets.access_token }}"
      },
      {
        "mode": "none"
      }
    ],
    "check": {
      "method": "GET",
      "path": "auth.test"
    },
    "error_map": [
      {
        "status": 401,
        "hint": "slack api_token/access_token is missing or invalid; re-run pm credentials add slack"
      },
      {
        "status": 429,
        "class": "rate_limited",
        "hint": "slack API rate limit exceeded; the connector will retry with backoff"
      }
    ]
  },
  "streams": [
    {
      "name": "users",
      "path": "users.list",
      "records": {
        "path": "members"
      },
      "schema": "schemas/users.json"
    },
    {
      "name": "channels",
      "path": "conversations.list",
      "records": {
        "path": "channels"
      },
      "schema": "schemas/channels.json"
    },
    {
      "name": "channel_messages",
      "path": "conversations.history",
      "records": {
        "path": "messages"
      },
      "schema": "schemas/channel_messages.json"
    }
  ]
}
