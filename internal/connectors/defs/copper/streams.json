{
  "base": {
    "auth": [
      {
        "mode": "none"
      }
    ],
    "check": {
      "body": {
        "page_number": 1,
        "page_size": 1
      },
      "method": "POST",
      "path": "/people/search"
    },
    "error_map": [],
    "headers": {
      "X-PW-AccessToken": "{{ secrets.api_key }}",
      "X-PW-Application": "developer_api",
      "X-PW-UserEmail": "{{ config.user_email }}"
    },
    "pagination": {
      "body_page_field": "page_number",
      "max_pages": 100,
      "page_param": "page_number",
      "page_size": 100,
      "type": "page_number"
    },
    "url": "https://api.copper.com/developer_api/v1",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "body": {
        "page_size": 100
      },
      "incremental": {
        "client_filtered": true,
        "cursor_field": "date_modified"
      },
      "method": "POST",
      "name": "people",
      "path": "/people/search",
      "projection": "passthrough",
      "records": {
        "path": "."
      },
      "schema": "schemas/people.json"
    },
    {
      "body": {
        "page_size": 100
      },
      "incremental": {
        "client_filtered": true,
        "cursor_field": "date_modified"
      },
      "method": "POST",
      "name": "companies",
      "path": "/companies/search",
      "projection": "passthrough",
      "records": {
        "path": "."
      },
      "schema": "schemas/companies.json"
    },
    {
      "body": {
        "page_size": 100
      },
      "incremental": {
        "client_filtered": true,
        "cursor_field": "date_modified"
      },
      "method": "POST",
      "name": "opportunities",
      "path": "/opportunities/search",
      "projection": "passthrough",
      "records": {
        "path": "."
      },
      "schema": "schemas/opportunities.json"
    },
    {
      "body": {
        "page_size": 100
      },
      "incremental": {
        "client_filtered": true,
        "cursor_field": "date_modified"
      },
      "method": "POST",
      "name": "leads",
      "path": "/leads/search",
      "projection": "passthrough",
      "records": {
        "path": "."
      },
      "schema": "schemas/leads.json"
    },
    {
      "body": {
        "page_size": 100
      },
      "incremental": {
        "client_filtered": true,
        "cursor_field": "date_modified"
      },
      "method": "POST",
      "name": "tasks",
      "path": "/tasks/search",
      "projection": "passthrough",
      "records": {
        "path": "."
      },
      "schema": "schemas/tasks.json"
    }
  ]
}
