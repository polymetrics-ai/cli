{
  "base": {
    "url": "{{ config.feed_url }}",
    "user_agent": "polymetrics-go-cli",
    "headers": {
      "Accept": "application/rss+xml, application/xml, text/xml, */*"
    },
    "auth": [
      {
        "mode": "none"
      }
    ],
    "pagination": {
      "type": "none"
    },
    "check": {
      "method": "GET",
      "path": ""
    },
    "error_map": []
  },
  "streams": [
    {
      "name": "items",
      "method": "GET",
      "path": "",
      "records": {
        "path": "channel.item"
      },
      "incremental": {
        "cursor_field": "published_at"
      },
      "schema": "schemas/items.json"
    },
    {
      "name": "channel",
      "method": "GET",
      "path": "",
      "records": {
        "path": "channel"
      },
      "schema": "schemas/channel.json"
    }
  ]
}
