{
  "base": {
    "url": "{{ config.queue_url }}",
    "user_agent": "polymetrics-go-cli",
    "pagination": {
      "type": "none"
    }
  },
  "streams": [
    {
      "name": "messages",
      "method": "POST",
      "path": "SQS.ReceiveMessage",
      "records": {
        "path": "Messages"
      },
      "pagination": {
        "type": "none",
        "page_size": 10,
        "max_pages": 1
      },
      "schema": "schemas/messages.json",
      "conformance": {
        "skip_dynamic": true,
        "reason": "messages are read by the Tier-3 native SigV4/XML ReceiveMessage poll loop; native tests replay sanitized XML responses and fixture mode emits deterministic messages"
      }
    }
  ]
}
