{
  "schema_version": 1,
  "source": {
    "default_stream": "messages",
    "source_credential_defaults": {
      "max_polls": "1",
      "max_batch_size": "1",
      "max_wait_time": "0"
    },
    "live_unavailable": [
      {
        "kind": "Error",
        "contains": [
          "requires secrets access_key and secret_key",
          "InvalidClientTokenId",
          "SignatureDoesNotMatch",
          "status 401"
        ]
      },
      {
        "kind": "Error",
        "contains": [
          "AccessDenied",
          "not authorized",
          "status 403"
        ]
      }
    ]
  },
  "write_pairings": []
}
