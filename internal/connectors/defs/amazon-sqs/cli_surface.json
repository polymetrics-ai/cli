{
  "tagline": "Run Amazon SQS's declared streams and reverse-ETL actions.",
  "usage": "pm amazon-sqs \u003ccommand\u003e [flags]",
  "groups": [
    {
      "id": "read",
      "title": "Read streams",
      "commands": [
        "dead-letter-source-queues list",
        "message-move-tasks list",
        "messages receive",
        "queue attributes",
        "queue tags",
        "queue url",
        "queues list"
      ]
    },
    {
      "id": "write",
      "title": "Reverse ETL writes",
      "commands": [
        "message change-visibility",
        "message change-visibility-batch",
        "message delete",
        "message delete-batch",
        "message send",
        "message send-batch",
        "message-move-task cancel",
        "message-move-task start",
        "permission add",
        "permission remove",
        "queue create",
        "queue delete",
        "queue purge",
        "queue set-attributes",
        "queue tag",
        "queue untag"
      ]
    }
  ],
  "commands": [
    {
      "path": "dead-letter-source-queues list",
      "summary": "List queues configured with the current queue as a dead-letter queue.",
      "intent": "direct_read",
      "availability": "implemented",
      "flags": [
        {
          "name": "max-results",
          "type": "integer",
          "summary": "Maximum queue URLs to return (bounded by SQS).",
          "maps_to": "body.max_results"
        }
      ],
      "examples": [
        "pm amazon-sqs dead-letter-source-queues list --credential sqs-prod --max-results 25"
      ],
      "api_surface": [
        {
          "method": "POST",
          "path": "SQS.ListDeadLetterSourceQueues"
        }
      ],
      "output_policy": "json_redacted",
      "redact_fields": [
        "receipt_handle",
        "task_handle",
        "policy"
      ],
      "operation": "list_dead_letter_source_queues"
    },
    {
      "path": "message change-visibility",
      "summary": "Plan a typed Amazon SQS change message visibility operation.",
      "intent": "reverse_etl",
      "availability": "implemented",
      "write": "change_message_visibility",
      "flags": [
        {
          "name": "receipt-handle",
          "type": "string",
          "summary": "Receipt handle from ReceiveMessage.",
          "maps_to": "record.receipt_handle",
          "required": true,
          "allow_empty": false
        },
        {
          "name": "visibility-timeout",
          "type": "integer",
          "summary": "New visibility timeout in seconds.",
          "maps_to": "record.visibility_timeout",
          "required": true
        }
      ],
      "examples": [
        "pm amazon-sqs message change-visibility --credential sqs-prod --receipt-handle receipt-handle-placeholder --visibility-timeout 30 --preview"
      ],
      "risk": "changes the visibility timeout for one in-flight message",
      "approval": "reverse ETL writes require plan -\u003e preview -\u003e explicit approval -\u003e execute",
      "redact_fields": [
        "attributes",
        "message_attributes",
        "message_body",
        "message_system_attributes",
        "receipt_handle",
        "task_handle"
