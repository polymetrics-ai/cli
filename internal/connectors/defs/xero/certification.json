{
  "schema_version": 1,
  "source": {
    "default_stream": "accounts",
    "source_credential_defaults": {
      "base_url": "https://api.xero.com/api.xro/2.0"
    },
    "live_unavailable": [
      {
        "kind": "Error",
        "contains": [
          "http 401",
          "http 403",
          "status 401",
          "status 403",
          "xero access_token",
          "xero tenant_id"
        ]
      }
    ]
  },
  "evidence_import": {
    "provider": "xero_api",
