      {
        "scope": "capability",
        "function_kind": "operation:rest_read",
        "stage_sets": ["direct_read_candidates"]
      }
    ]
  },
  "direct_read_candidates": [
    {
      "stage_name": "direct_read_sweep_reports_list",
      "command": "reports list",
      "args": [
        {
          "connector": true
        },
        {
          "literal": "reports"
        },
        {
          "literal": "list"
        },
        {
          "literal": "--credential"
        },
        {
          "source_credential": true
        },
        {
          "literal": "--json"
        }
      ]
    }
  ],
  "binary_candidates": [],
  "write_pairings": []
}
