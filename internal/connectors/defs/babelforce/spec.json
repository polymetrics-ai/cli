{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "access_key_id": {
      "description": "Babelforce access key ID.",
      "type": "string",
      "x-secret": true
    },
    "access_token": {
      "description": "Babelforce access token.",
      "type": "string",
      "x-secret": true
    },
    "region": {
      "default": "services",
      "description": "Declared Babelforce regional provider host.",
      "enum": [
        "services",
        "us-east",
        "ap-southeast"
      ],
      "type": "string"
    }
  },
  "title": "Babelforce Connection Specification",
  "type": "object",
  "x-reject-unknown-config": true
}
