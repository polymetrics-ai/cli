{
  "base": {
    "auth": [
      {
        "mode": "none"
      }
    ],
    "check": {
      "method": "GET",
      "path": "/calls/reporting/simple",
      "query": {
        "max": "1"
      }
    },
    "error_map": [],
    "headers": {
      "X-Access-Key-ID": "{{ secrets.access_key_id }}",
      "X-Auth-Access-Token": "{{ secrets.access_token }}"
    },
    "pagination": {
      "max_pages": 100,
      "page_param": "page",
      "page_size": 100,
      "size_param": "max",
      "start_page": 1,
      "type": "page_number"
    },
    "url": "https://{{ config.region }}.babelforce.com/api/v2",
    "user_agent": "polymetrics-go-cli"
  },
  "streams": [
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "dateCreated"
      },
      "method": "GET",
      "name": "calls",
      "path": "/calls/reporting/simple",
      "projection": "passthrough",
      "records": {
        "path": "items"
      },
      "schema": "schemas/calls.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "dateCreated"
      },
      "method": "GET",
      "name": "calls_extended",
      "path": "/calls/reporting/extended",
      "projection": "passthrough",
      "records": {
        "path": "items"
      },
      "schema": "schemas/calls.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "dateCreated"
      },
      "method": "GET",
      "name": "recordings",
      "path": "/recordings",
      "projection": "passthrough",
      "records": {
        "path": "items"
      },
      "schema": "schemas/recordings.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "dateCreated"
      },
      "method": "GET",
      "name": "numbers",
      "path": "/numbers",
      "projection": "passthrough",
      "records": {
        "path": "items"
      },
      "schema": "schemas/numbers.json"
    },
    {
      "incremental": {
        "client_filtered": true,
        "cursor_field": "dateCreated"
      },
      "method": "GET",
      "name": "users",
      "path": "/users",
      "projection": "passthrough",
      "records": {
        "path": "items"
      },
      "schema": "schemas/users.json"
    }
  ]
}
