{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sync_transport.json",
  "type": "object",
  "required": ["schema_version"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "source_transport": {
      "type": "object",
      "required": ["executor", "eligible_streams", "modes", "delivery"],
      "additionalProperties": false,
      "properties": {
        "executor": {
          "type": "object", "required": ["family", "id"], "additionalProperties": false,
          "properties": {"family": {"type": "string"}, "id": {"type": "string"}}
        },
        "eligible_streams": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "modes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "ordered_pipeline": {"type": "boolean"},
        "delivery": {
          "type": "object", "required": ["idempotency", "ordering", "deletes"], "additionalProperties": false,
          "properties": {"idempotency": {"type": "string"}, "ordering": {"type": "string"}, "deletes": {"type": "string"}}
        }
      }
    },
    "destination_transport": {
      "type": "object",
      "required": ["executor", "eligible_actions", "modes", "delivery", "acknowledgement", "apply_strategies"],
      "additionalProperties": false,
      "properties": {
        "executor": {
          "type": "object", "required": ["family", "id"], "additionalProperties": false,
          "properties": {"family": {"type": "string"}, "id": {"type": "string"}}
        },
        "eligible_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "modes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "ordered_pipeline": {"type": "boolean"},
        "copy_worker_maximum": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6, 7, 8]},
        "delivery": {
          "type": "object", "required": ["idempotency", "ordering", "deletes"], "additionalProperties": false,
          "properties": {"idempotency": {"type": "string"}, "ordering": {"type": "string"}, "deletes": {"type": "string"}}
        },
        "acknowledgement": {"type": "string", "enum": ["durable_warehouse", "none"]},
        "apply_strategies": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["mode", "strategy", "action"], "additionalProperties": false,
            "properties": {
              "mode": {"type": "string"}, "strategy": {"type": "string"}, "action": {"type": "string"}, "tombstone_action": {"type": "string", "minLength": 1},
              "read_back": {
                "type": "object", "additionalProperties": false,
                "required": ["operation", "identity", "expected", "max_records", "max_attempts", "timeout_milliseconds", "receipt_locator"],
                "properties": {
                  "operation": {"type": "string", "minLength": 1},
                  "identity": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["provider_field", "expected_field"], "properties": {"provider_field": {"type": "string", "minLength": 1}, "expected_field": {"type": "string", "minLength": 1}}}},
                  "expected": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["provider_field", "expected_field"], "properties": {"provider_field": {"type": "string", "minLength": 1}, "expected_field": {"type": "string", "minLength": 1}}}},
                  "max_records": {"type": "integer"}, "max_attempts": {"type": "integer"}, "timeout_milliseconds": {"type": "integer"}, "retry_delay_milliseconds": {"type": "integer"},
                  "receipt_locator": {"type": "object", "required": ["response_index", "body_field", "query_parameter", "max_value_bytes", "max_pages"], "additionalProperties": false, "properties": {"response_index": {"type": "integer"}, "body_field": {"type": "string"}, "query_parameter": {"type": "string"}, "max_value_bytes": {"type": "integer"}, "max_pages": {"type": "integer"}}}
                }
              },
              "tombstone_read_back": {
                "type": "object", "additionalProperties": false,
                "required": ["operation", "identity", "max_records", "max_attempts", "timeout_milliseconds", "receipt_locator"],
                "properties": {
                  "operation": {"type": "string", "minLength": 1},
                  "identity": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["provider_field", "expected_field"], "properties": {"provider_field": {"type": "string", "minLength": 1}, "expected_field": {"type": "string", "minLength": 1}}}},
                  "max_records": {"type": "integer"}, "max_attempts": {"type": "integer"}, "timeout_milliseconds": {"type": "integer"}, "retry_delay_milliseconds": {"type": "integer"},
                  "receipt_locator": {"type": "object", "required": ["response_index", "body_field", "query_parameter", "max_value_bytes", "max_pages"], "additionalProperties": false, "properties": {"response_index": {"type": "integer"}, "body_field": {"type": "string"}, "query_parameter": {"type": "string"}, "max_value_bytes": {"type": "integer"}, "max_pages": {"type": "integer"}}}
                }
              }
            }
          }
        },
        "read_back": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "identity", "expected", "max_records", "max_attempts", "timeout_milliseconds", "receipt_locator"],
          "properties": {
            "operation": {"type": "string", "minLength": 1},
            "identity": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["provider_field", "expected_field"],
                "properties": {"provider_field": {"type": "string", "minLength": 1}, "expected_field": {"type": "string", "minLength": 1}}
              }
            },
            "expected": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["provider_field", "expected_field"],
                "properties": {"provider_field": {"type": "string", "minLength": 1}, "expected_field": {"type": "string", "minLength": 1}}
              }
            },
            "max_records": {"type": "integer"},
            "max_attempts": {"type": "integer"},
            "timeout_milliseconds": {"type": "integer"},
            "retry_delay_milliseconds": {"type": "integer"},
            "receipt_locator": {
              "type": "object",
              "required": ["response_index", "body_field", "query_parameter", "max_value_bytes", "max_pages"],
              "additionalProperties": false,
              "properties": {
                "response_index": {"type": "integer"},
                "body_field": {"type": "string"},
                "query_parameter": {"type": "string"},
                "max_value_bytes": {"type": "integer"},
                "max_pages": {"type": "integer"}
              }
            }
          }
        },
		"tombstone_read_back": {
		  "type": "object",
		  "additionalProperties": false,
		  "required": ["operation", "identity", "max_records", "max_attempts", "timeout_milliseconds", "receipt_locator"],
		  "properties": {
			"operation": {"type": "string", "minLength": 1},
			"identity": {
			  "type": "array", "minItems": 1,
			  "items": {
				"type": "object", "additionalProperties": false,
				"required": ["provider_field", "expected_field"],
				"properties": {"provider_field": {"type": "string", "minLength": 1}, "expected_field": {"type": "string", "minLength": 1}}
			  }
			},
			"max_records": {"type": "integer"},
			"max_attempts": {"type": "integer"},
			"timeout_milliseconds": {"type": "integer"},
			"retry_delay_milliseconds": {"type": "integer"},
			"receipt_locator": {
			  "type": "object",
			  "required": ["response_index", "body_field", "query_parameter", "max_value_bytes", "max_pages"],
			  "additionalProperties": false,
			  "properties": {
				"response_index": {"type": "integer"},
				"body_field": {"type": "string"},
				"query_parameter": {"type": "string"},
				"max_value_bytes": {"type": "integer"},
				"max_pages": {"type": "integer"}
			  }
			}
		  }
		},
        "source_bindings": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["executor", "eligible_streams"], "additionalProperties": false,
            "oneOf": [
              {"required": ["record_mapping"]},
              {"required": ["tombstone_mapping"]}
            ],
            "properties": {
              "action": {"type": "string", "minLength": 1},
              "executor": {
                "type": "object", "required": ["family", "id"], "additionalProperties": false,
                "properties": {"family": {"type": "string"}, "id": {"type": "string"}}
              },
              "eligible_streams": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "batch": {
                "type": "object", "required": ["disposition", "max_records"], "additionalProperties": false,
                "properties": {
                  "disposition": {"type": "string", "enum": ["per_record"]},
                  "max_records": {"type": "integer", "minimum": 1, "maximum": 1000}
                }
              },
              "record_mapping": {
                "type": "object", "required": ["kind"], "additionalProperties": false,
                "properties": {
                  "kind": {"type": "string", "enum": ["config_match", "input_fields"]},
                  "config_key": {"type": "string"},
                  "record_field": {"type": "string"},
                  "inputs": {
                    "type": "array", "minItems": 1,
                    "items": {
                      "type": "object", "required": ["input", "field"], "additionalProperties": false,
                      "properties": {"input": {"type": "string"}, "field": {"type": "string"}}
                    }
                  }
                }
              },
              "tombstone_mapping": {
                "type": "object", "required": ["image", "inputs"], "additionalProperties": false,
                "properties": {
                  "image": {"type": "string", "enum": ["key", "before"]},
                  "inputs": {
                    "type": "array", "minItems": 1,
                    "items": {
                      "type": "object", "required": ["input", "field"], "additionalProperties": false,
                      "properties": {"input": {"type": "string"}, "field": {"type": "string"}}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
