{
  "name": "cli-polymetrics-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbopack",
    "gen:bundles": "node scripts/gen-connector-bundles.mjs",
    "gen:connectors": "node scripts/gen-connectors.mjs",
    "fetch:icons": "node scripts/fetch-simple-icons.mjs",
    "gen:penrose": "node scripts/gen-penrose.mjs",
    "gen:patterns": "node scripts/gen-patterns.mjs",
    "gen:catalog": "node scripts/gen-connector-bundles.mjs && node scripts/gen-connector-catalog.mjs",
    "gen:docs": "node scripts/gen-docs-data.mjs",
    "gen:github-cli-surface": "node scripts/gen-github-cli-surface.mjs",
    "gen:website-data": "node scripts/gen-github-cli-surface.mjs && node scripts/gen-docs-data.mjs && node scripts/gen-connector-bundles.mjs && node scripts/gen-connector-catalog.mjs && node scripts/gen-connectors.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && node --test 'scripts/**/*.test.mjs' && playwright test",
    "test:unit": "vitest run",
    "test:scripts": "node --test 'scripts/**/*.test.mjs'",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "start": "next start",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "^16.15.4",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.15.4",
    "lucide-react": "^1.22.0",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "js-yaml": "5.2.2",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
