#!/usr/bin/env sh
# Keep committed feature work recoverable without making commits wait for a
# network round trip. Every refusal and error path exits successfully.

if [ -n "${PM_NO_AUTOPUSH:-}" ]; then
  exit 0
fi

hook_dir="$(CDPATH='' cd "$(dirname "$0")" 2>/dev/null && pwd)" || exit 0
# shellcheck disable=SC1091
. "$hook_dir/pm-autopush-operation-state" 2>/dev/null || exit 0
scheduled_oid="$(git rev-parse --verify HEAD 2>/dev/null)" || exit 0
worktree_git_dir="$(git rev-parse --path-format=absolute --git-dir 2>/dev/null)" || exit 0
operation_file="$worktree_git_dir/pm-autopush-operation"
if [ -f "$operation_file" ]; then
  operation_parent="$(sed -n '1p' "$operation_file" 2>/dev/null || :)"
  commit_parent="$(git rev-parse --verify HEAD^1 2>/dev/null || :)"
  rm -f "$operation_file" 2>/dev/null || :
  [ "$operation_parent" = "$commit_parent" ] && exit 0
fi

pm_autopush_operation_in_progress && exit 0

branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)" || exit 0
[ "$branch" = "main" ] && exit 0

remote="$(git config --get "branch.$branch.remote" 2>/dev/null || :)"
case "$remote" in
  ""|".")
    remote="$(git config --get remote.pushDefault 2>/dev/null || :)"
    ;;
esac
if [ -z "$remote" ]; then
  if git remote get-url origin >/dev/null 2>&1; then
    remote="origin"
  else
    exit 0
  fi
fi

# `main` is the hard repository default. Skip an already-known alternate
# default before taking the rate-limit lease.
remote_head="$(git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null || :)"
case "$remote_head" in
  "$remote"/*)
    remote_default_branch="${remote_head#"$remote/"}"
    [ "$branch" = "$remote_default_branch" ] && exit 0
    ;;
esac

# Resolve state against Git's common directory, not the configured hook path:
# `core.hooksPath` can itself be a worktree path. Using `--git-path` with the
# common Git directory keeps this git-ignored state shared by linked worktrees.
common_git_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || exit 0
state_file="$(GIT_DIR="$common_git_dir" git rev-parse --git-path "pm-autopush/$branch.last-push" 2>/dev/null)" || exit 0
status_file="$(GIT_DIR="$common_git_dir" git rev-parse --git-path "pm-autopush/$branch.log" 2>/dev/null)" || exit 0
state_dir="$(dirname "$state_file")" || exit 0
umask 077
mkdir -p "$state_dir" 2>/dev/null || exit 0

now="$(date +%s 2>/dev/null)" || exit 0
case "$now" in
  ""|*[!0-9]*) exit 0 ;;
esac

lease_file="$state_file.lock"
lease_owner_file="$state_file.lease.$$.${now}"
if ! (set -C; : > "$lease_owner_file") 2>/dev/null; then
  exit 0
fi
if ! printf '%s %s\n' "$$" "$now" > "$lease_owner_file" 2>/dev/null; then
  rm -f "$lease_owner_file" 2>/dev/null || :
  exit 0
fi
if ! ln "$lease_owner_file" "$lease_file" 2>/dev/null; then
  lease_pid=""
  lease_created=""
  lease_extra=""
  IFS=' ' read -r lease_pid lease_created lease_extra < "$lease_file" 2>/dev/null || :
  lease_valid=1
  case "$lease_pid" in
    ""|0|*[!0-9]*) lease_valid=0 ;;
  esac
  case "$lease_created" in
    ""|*[!0-9]*) lease_valid=0 ;;
  esac
  [ -n "$lease_extra" ] && lease_valid=0
  if [ "$lease_valid" -eq 1 ] &&
    [ "$lease_created" -le "$now" ] &&
    [ $((now - lease_created)) -ge 600 ] &&
    ! kill -0 "$lease_pid" 2>/dev/null; then
    rm -f "$lease_file" 2>/dev/null || :
  fi
  if ! ln "$lease_owner_file" "$lease_file" 2>/dev/null; then
    rm -f "$lease_owner_file" 2>/dev/null || :
    exit 0
  fi
fi
if rm -f "$lease_owner_file" 2>/dev/null; then
  lease_owner_file=""
fi
state_temp=""
trap '
  if [ -n "$state_temp" ]; then
    rm -f "$state_temp" 2>/dev/null || :
  fi
  rm -f "$lease_file" 2>/dev/null || :
  if [ -n "$lease_owner_file" ]; then
    rm -f "$lease_owner_file" 2>/dev/null || :
  fi
' 0
trap 'exit 0' 1 2 15

last_push="$(sed -n '1p' "$state_file" 2>/dev/null || :)"
case "$last_push" in
  ""|*[!0-9]*) ;;
  *)
    if [ "$last_push" -gt "$now" ] || [ $((now - last_push)) -lt 600 ]; then
      exit 0
    fi
    ;;
esac

# Record the attempt before forking so a burst of commits cannot enqueue one
# push per commit. A rejected attempt is still rate-limited deliberately.
state_temp="$state_file.$$.tmp"
printf '%s\n' "$now" > "$state_temp" 2>/dev/null || exit 0
mv -f "$state_temp" "$state_file" 2>/dev/null || exit 0
state_temp=""
if ! rm -f "$lease_file" 2>/dev/null; then
  exit 0
fi
trap - 0 1 2 15

# Never wait for, force, or otherwise make the commit depend on this push.
# The child records one short local line on any rejected/failed push and the
# hook returns successfully even if nohup itself cannot be started.
# shellcheck disable=SC2016 # The child receives its remote, branch, and log path as positional arguments.
nohup sh -c '
  # shellcheck disable=SC1091
  . "$5" 2>/dev/null || exit 0
  if pm_autopush_operation_in_progress; then
    printf "%s\n" "pm autopush: operation in progress for $2 (ignored)" >> "$3"
    exit 0
  fi
  push_urls="$(git remote get-url --push --all "$1" 2>/dev/null)" || {
    printf "%s\n" "pm autopush: remote default unavailable for $2 (ignored)" >> "$3"
    exit 0
  }
  if [ -z "$push_urls" ]; then
    printf "%s\n" "pm autopush: remote default unavailable for $2 (ignored)" >> "$3"
    exit 0
  fi
  while IFS= read -r push_url; do
    [ -n "$push_url" ] || continue
    remote_default_branch="$(
      git ls-remote --symref -- "$push_url" HEAD 2>/dev/null |
        awk "\$1 == \"ref:\" && index(\$2, \"refs/heads/\") == 1 && \$3 == \"HEAD\" { sub(\"^refs/heads/\", \"\", \$2); print \$2; exit }"
    )"
    if [ -z "$remote_default_branch" ]; then
      printf "%s\n" "pm autopush: remote default unavailable for $2 (ignored)" >> "$3"
      exit 0
    fi
    if [ "$remote_default_branch" = "$2" ]; then
      printf "%s\n" "pm autopush: default branch skipped for $2 (ignored)" >> "$3"
      exit 0
    fi
  done <<EOF
$push_urls
EOF
  if pm_autopush_operation_in_progress; then
    printf "%s\n" "pm autopush: operation in progress for $2 (ignored)" >> "$3"
    exit 0
  fi
  current_oid="$(git rev-parse --verify "refs/heads/$2" 2>/dev/null || :)"
  if [ "$current_oid" != "$4" ]; then
    printf "%s\n" "pm autopush: branch changed for $2 (ignored)" >> "$3"
    exit 0
  fi
  if git push -- "$1" "$4:refs/heads/$2" >/dev/null 2>&1; then
    exit 0
  fi
  printf "%s\n" "pm autopush: push failed for $2 (ignored)" >> "$3"
' pm-autopush "$remote" "$branch" "$status_file" "$scheduled_oid" "$hook_dir/pm-autopush-operation-state" </dev/null >/dev/null 2>&1 &

exit 0
